    width: 100% !important;
  }

  /* MOBILE RESPONSIVE PERFECT HEADLINE ALIGNMENT */
  @media screen and (max-width: 991px) {
    .vsw-wcu-section {
      padding: 45px 14px 55px 14px !important;
    }

    .vsw-wcu-header {
      margin-bottom: 22px !important;
