{% comment %}
  =============================================================================
  WHY CHOOSE US - V-I-D-H-Y-U-T S-A-A-T-H-I ACRONYM STEPPER SHOWCASE (SNIPPET)
  =============================================================================
{% endcomment %}

{%- style -%}
  .vsw-wcu-section,
  .vsw-wcu-section * {
    box-sizing: border-box !important;
  }

  .vsw-wcu-section {
    display: block !important;
    width: 100% !important;
    clear: both !important;
    position: relative !important;
    padding: 80px 24px !important;
    background: #FFFFFF !important;
    color: #1A1A1A !important;
    text-align: center !important;
    margin: 0 !important;
    overflow: hidden !important;
  }

  .vsw-wcu-header {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    width: 100% !important;
    max-width: 880px !important;
    margin: 0 auto 40px auto !important;
    float: none !important;
  }

  .vsw-wcu-sub {
    font-size: 0.95rem !important;
    color: #888888 !important;
    margin: 0 0 10px 0 !important;
    font-weight: 500 !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
  }

  .vsw-wcu-main-title {
    font-size: 2.1rem !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
    color: #111111 !important;
    margin: 0 auto !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    float: none !important;
    letter-spacing: -0.2px !important;
  }

  /* 13-LETTER CAPSULE STEPPER BAR */
  .vsw-wcu-nav-wrapper {
    position: relative !important;
    width: 100% !important;
    max-width: 1220px !important;
    margin: 0 auto 45px auto !important;
    padding: 0 10px !important;
    box-sizing: border-box !important;
    display: flex !important;
    justify-content: center !important;
  }

  .vsw-wcu-nav {
    position: relative !important;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    background: #F4F5F7 !important;
    border-radius: 60px !important;
    padding: 10px 18px !important;
    border: 1px solid #E5E7EB !important;
    overflow-x: auto !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch !important;
    gap: 4px !important;
    box-sizing: border-box !important;
    width: 100% !important;
    float: none !important;
  }
  .vsw-wcu-nav::-webkit-scrollbar { display: none !important; }

  .vsw-wcu-item {
    position: relative !important;
    z-index: 3 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    cursor: pointer !important;
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    outline: none !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
    flex: 1 0 auto !important;
    min-width: 76px !important;
    max-width: 88px !important;
    text-decoration: none !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    float: none !important;
  }

  .vsw-wcu-circle {
    width: 52px !important;
    height: 52px !important;
    min-width: 52px !important;
    min-height: 52px !important;
    border-radius: 50% !important;
    background: #FFFFFF !important;
    border: 1.5px solid #D1D5DB !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.1rem !important;
    font-weight: 500 !important;
    color: #333333 !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04) !important;
    transition: all 0.25s ease !important;
    margin: 0 auto !important;
    box-sizing: border-box !important;
  }

  .vsw-wcu-item.active .vsw-wcu-circle {
    background: #EC5C0A !important;
    border-color: #EC5C0A !important;
    color: #FFFFFF !important;
    font-weight: 800 !important;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.45) !important;
    transform: scale(1.05) !important;
  }

  .vsw-wcu-label {
    font-size: 0.62rem !important;
    font-weight: 800 !important;
    color: #1A1A1A !important;
    margin-top: 10px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.2px !important;
    text-align: center !important;
    line-height: 1.25 !important;
    display: block !important;
    transition: all 0.25s ease !important;
  }

  .vsw-wcu-item.active .vsw-wcu-label {
    color: #EC5C0A !important;
    font-weight: 900 !important;
  }

  /* ACTIVE CONTENT DISPLAY BLOCK */
  .vsw-wcu-content-display {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    max-width: 820px !important;
    margin: 35px auto 0 auto !important;
    text-align: center !important;
    padding: 0 20px !important;
    box-sizing: border-box !important;
    float: none !important;
    transition: opacity 0.25s ease, transform 0.25s ease !important;
  }

  .vsw-wcu-active-title {
    font-size: 1.9rem !important;
    font-weight: 800 !important;
    color: #EC5C0A !important;
    text-transform: uppercase !important;
    margin: 0 0 14px 0 !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    letter-spacing: 0.5px !important;
  }

  .vsw-wcu-active-desc {
    font-size: 1.02rem !important;
    font-weight: 500 !important;
    color: #888888 !important;
    line-height: 1.7 !important;
    text-align: center !important;
    margin: 0 auto !important;
    max-width: 780px !important;
    display: block !important;
    width: 100% !important;
  }

  /* MOBILE RESPONSIVE STYLING */
  @media screen and (max-width: 991px) {
    .vsw-wcu-section {
      padding: 45px 16px 55px 16px !important;
    }

    .vsw-wcu-header {
      margin-bottom: 25px !important;
    }

    .vsw-wcu-sub {
      font-size: 0.88rem !important;
      margin-bottom: 6px !important;
    }

    .vsw-wcu-main-title {
      font-size: 1.55rem !important;
      font-weight: 700 !important;
      line-height: 1.3 !important;
    }

    .vsw-wcu-nav {
      padding: 10px 12px !important;
      border-radius: 40px !important;
      gap: 4px !important;
    }

    .vsw-wcu-item {
      min-width: 68px !important;
      max-width: 75px !important;
    }

    .vsw-wcu-circle {
      width: 42px !important;
      height: 42px !important;
      min-width: 42px !important;
      min-height: 42px !important;
      font-size: 0.95rem !important;
    }

    .vsw-wcu-label {
      font-size: 0.58rem !important;
      margin-top: 6px !important;
    }

    .vsw-wcu-active-title {
      font-size: 1.4rem !important;
      font-weight: 800 !important;
      margin-bottom: 10px !important;
    }

    .vsw-wcu-active-desc {
      font-size: 0.9rem !important;
      font-weight: 500 !important;
      color: #888888 !important;
      line-height: 1.6 !important;
    }
  }
{%- endstyle -%}

<section class="vsw-wcu-section" id="vswWcuSection">
  
  <div class="vsw-wcu-header">
    <p class="vsw-wcu-sub">Why Choose us</p>
    <h2 class="vsw-wcu-main-title">“Our uniqueness helps us earn<br> the trust of the Indian community”</h2>
