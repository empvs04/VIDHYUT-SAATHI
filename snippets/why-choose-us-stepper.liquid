  <!-- 13-Letter Acronym Capsule Stepper Nav -->
  <div class="vsw-wcu-nav-wrapper">
    <div class="vsw-wcu-nav" id="vswWcuNav">
      <div class="vsw-wcu-item active" role="button" tabindex="0" data-acronym="0">
        <span class="vsw-wcu-circle">V</span>
        <span class="vsw-wcu-label">VIDHYUT</span>
      </div>

      <div class="vsw-wcu-item" role="button" tabindex="0" data-acronym="1">
        <span class="vsw-wcu-circle">I</span>
