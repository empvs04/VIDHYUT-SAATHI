</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const acronymData = [
      { letter: "V", title: "VIDHYUT", desc: "Vidhyut i.e. electricity is very crucial and is on the verge of extinction. To save vidhyut, we are here with Vidhyut Saathi energy saver card that will help you save 20% to 30% on your electricity bills." },
      { letter: "I", title: "INDUSTRY", desc: "We are the first in the industry to launch this unique US-German Nanotechnology having ability to stop electricity wastage as consequently it will stop money wastage." },
      { letter: "D", title: "DIRECTION", desc: "Sometimes in the absence of proper guidance, we get wrong direction. Vidhyut Saathi Energy Saver Pvt Ltd is here to give you proper direction to save electricity, money, and ozone layer." },
      { letter: "H", title: "HAPPY CUSTOMER", desc: "The feedback we are getting from customers for our energy saving card is priceless. Our motto is to see happy and healthy customers." },
      { letter: "Y", title: "YES TO SAVING", desc: "Say yes to saving with Vidhyut Saathi energy saving card. With very affordable purchasing price, Vidhyut Saathi can add a lot to your savings." },
      { letter: "U", title: "US GERMAN", desc: "We are here in the market with unique US - German Nano-technology working on vibrations to supress electricity spikes and Vidyut Saathi is launching this technology in India." },
      { letter: "T", title: "TERAHERTZ FREQUENCY", desc: "Terahertz card containing Tera Hertz frequency can prevent electricity leakage and stabilizes the electrical spikes produced while consumption of electricity." },
      { letter: "S", title: "SAVING", desc: "Saving is of equal significance as like earning. With Vidhyut Saathi card, you are saving 3 things at a time - Electricity, your hard earned money and our precious Ozone layer." },
      { letter: "A", title: "AFFORDABLE", desc: "This electricity saver card will help you to save thousands and is completely affordable. With nominal spending, you can save up to 30 percent on your current bill." },
      { letter: "A", title: "AUTOMATIC", desc: "Once you purchase the card, it will work for a decade without any maintenance. It will be activated automatically after applying on MCB." },
      { letter: "T", title: "TECHNIQUES", desc: "Based on a unique technique to stop electricity wastage, Vidhyut Saathi card has 20,000 negative ions that work on unique US-German Nanotechnology." },
      { letter: "H", title: "HIGHLY RESISTANT", desc: "The Vidhyut Saathi card is highly resistant to electricity wastage and stops the unwanted leakage of electricity which in turn will help to avoid unnecessary payments." },
      { letter: "I", title: "IONS", desc: "With 20,000 negative ions, Vidhyut Saathi card is having great impact on electricity wastage. It stops the electricity leakage produced while consuming it and saves us from extra payments." }
    ];

    const acronymItems = document.querySelectorAll('.vsw-wcu-item');
    const acronymNav = document.getElementById('vswWcuNav');
    const acronymBadge = document.getElementById('vswWcuBadge');
    const acronymTitle = document.getElementById('vswWcuTitle');
    const acronymDesc = document.getElementById('vswWcuDesc');
    const acronymCard = document.getElementById('vswWcuCard');
    const wcuSection = document.getElementById('vswWcuSection');

    let currentAcronymIndex = 0;
    let acronymAutoTimer = null;

    function activateAcronymStep(index) {
      currentAcronymIndex = index;

      acronymItems.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      if (acronymNav && window.innerWidth <= 991) {
        const activeBtn = acronymItems[index];
        if (activeBtn) {
          const navWidth = acronymNav.clientWidth;
          const btnLeft = activeBtn.offsetLeft;
          const btnWidth = activeBtn.clientWidth;
          const targetScroll = btnLeft - (navWidth / 2) + (btnWidth / 2);
          acronymNav.scrollTo({
            left: targetScroll,
            behavior: 'smooth'
          });
        }
      }

      if (acronymCard) {
        acronymCard.style.opacity = '0.35';
        acronymCard.style.transform = 'translateY(10px)';
      }

      setTimeout(() => {
        if (acronymBadge) acronymBadge.textContent = acronymData[index].letter;
        if (acronymTitle) acronymTitle.textContent = acronymData[index].title;
        if (acronymDesc) acronymDesc.textContent = acronymData[index].desc;

        if (acronymCard) {
          acronymCard.style.opacity = '1';
          acronymCard.style.transform = 'translateY(0)';
        }
      }, 160);
    }

    acronymItems.forEach((item, index) => {
      item.addEventListener('click', function() {
        activateAcronymStep(index);
        resetAcronymAutoTimer();
      });
    });

    function startAcronymAutoTimer() {
      if (acronymAutoTimer) clearInterval(acronymAutoTimer);
      acronymAutoTimer = setInterval(() => {
        let nextIndex = (currentAcronymIndex + 1) % acronymData.length;
        activateAcronymStep(nextIndex);
      }, 4500);
    }

    function stopAcronymAutoTimer() {
      if (acronymAutoTimer) clearInterval(acronymAutoTimer);
    }

    function resetAcronymAutoTimer() {
      stopAcronymAutoTimer();
      startAcronymAutoTimer();
    }

    /* VIEWPORT SCROLL TRIGGER: Start auto-rotation ONLY when user reaches this section */
    if ('IntersectionObserver' in window && wcuSection) {
      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            activateAcronymStep(currentAcronymIndex);
            startAcronymAutoTimer();
          } else {
            stopAcronymAutoTimer();
          }
        });
      }, {
        threshold: 0.15
      });
      observer.observe(wcuSection);
    } else {
      if (acronymItems.length > 0) {
        activateAcronymStep(0);
        startAcronymAutoTimer();
      }
    }
  });
</script>
