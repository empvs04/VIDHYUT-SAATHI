    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.12), 0 5px 15px rgba(0, 0, 0, 0.03) !important;
    transition: opacity 0.3s ease, transform 0.3s ease !important;
  }

  .vsw-wcu-letter-badge {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 58px !important;
    height: 58px !important;
    border-radius: 18px !important;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9a00 100%) !important;
    color: #FFFFFF !important;
    font-size: 1.8rem !important;
    font-weight: 900 !important;
    margin-bottom: 18px !important;
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.35) !important;
  }

  .vsw-wcu-active-title {
    font-size: 1.9rem !important;
    font-weight: 900 !important;
    color: #EC5C0A !important;
    text-transform: uppercase !important;
    margin: 0 0 14px 0 !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    letter-spacing: 0.5px !important;
  }

  .vsw-wcu-active-desc {
    font-size: 1.05rem !important;
