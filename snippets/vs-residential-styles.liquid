  }
  .mcb-card:hover .mcb-zoom-overlay { opacity: 1; }

  .mcb-card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .mcb-card-num {
    font-size: 10px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    color: var(--orange);
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .mcb-card-title {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 4px 0;
    line-height: 1.3;
  }
  .mcb-card-desc {
    font-size: 11.5px;
    color: var(--muted-2);
    margin: 0;
    line-height: 1.45;
  }

  /* SVG Mockup Illustration Styling */
  .mcb-svg-mockup {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #007b3e 100%);
  }

  /* Lightbox Modal */
  .mcb-lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
  }
  .mcb-lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  .mcb-lightbox-box {
    background: #ffffff;
    border-radius: 20px;
    max-width: 720px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: relative;
    border: 1.5px solid var(--orange);
  }
  .mcb-lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    color: #0f172a;
    border: 1.5px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    z-index: 10;
  }
  .mcb-lightbox-img-wrap {
    width: 100%;
    max-height: 420px;
    background: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mcb-lightbox-info {
    padding: 20px;
  }

  /* ---- RESIDENTIAL REQUIREMENT TABLE ---- */
  .vsres-table-wrap {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .vsres-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .vsres-table thead tr {
    background: var(--green-d);
    color: #ffffff;
  }

  .vsres-table th {
    padding: 12px 14px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    text-align: center;
  }
  .vsres-table th:first-child { text-align: left; }

  .vsres-table tbody tr {
    border-bottom: 1px solid var(--line-s);
  }
  .vsres-table tbody tr:nth-child(even) { background: #fbf8f0; }

  .vsres-table td {
    padding: 12px 14px;
    text-align: center;
    color: var(--muted);
  }
  .vsres-table td:first-child {
    text-align: left;
    font-weight: 800;
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
  }
  .vsres-table td.highlight {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 800;
    color: var(--orange);
    font-size: 14.5px;
  }
  .vs-mob-br {
    display: none !important;
  }
  .vs-mob-kw, .vs-mob-cards {
    display: inline !important;
    font-size: inherit !important;
    color: inherit !important;
    font-weight: inherit !important;
  }

  /* ---- RESIDENTIAL CUSTOMER CASE STUDIES SLIDER ---- */
  .vs-cases-slider-wrap {
    width: 100%;
    position: relative;
  }
  .vs-slider-dots-bar {
    display: none;
  }
  .vs-slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cbd5e1;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .vs-slider-dot.active {
    width: 24px;
    border-radius: 50px;
    background: #ec5c0a;
  }

  .vsres-case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .vsres-case-card {
    background: #ffffff;
    border: 2px solid #f1e7db;
    border-radius: 20px;
    padding: 16px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .vsres-case-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a 0%, #ff8800 50%, #007b3e 100%);
    opacity: 0.85;
  }
  .vsres-case-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(236, 92, 10, 0.16);
    border-color: rgba(236, 92, 10, 0.5);
  }
  .vsres-case-img-box {
    position: relative;
    width: 100%;
    height: 215px;
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 14px;
    background: #1e293b;
    border: 1px solid rgba(0,0,0,0.06);
  }
  .vsres-case-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
    display: block;
  }
  .vsres-case-card:hover .vsres-case-cover-img {
    transform: scale(1.05);
  }
  .vsres-case-mcb-inset {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 105px;
    height: 90px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    background: #0f172a;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 3;
  }
  .vsres-case-card:hover .vsres-case-mcb-inset {
    transform: scale(1.06);
    border-color: #ec5c0a;
    box-shadow: 0 10px 28px rgba(236, 92, 10, 0.45);
  }
  .vsres-case-mcb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vsres-case-mcb-lbl {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.95) 100%);
    color: #ffd700;
    font-size: 8.5px;
    font-weight: 800;
    text-align: center;
    padding: 3px 0;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    font-family: 'Baloo 2', sans-serif;
  }
  .vsres-case-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .vsres-case-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid #ec5c0a;
    box-shadow: 0 4px 10px rgba(236, 92, 10, 0.25);
    background: #fff5eb;
  }
  .vsres-case-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vsres-case-name {
    font-size: 15.5px;
    font-weight: 800;
    font-family: 'Baloo 2', sans-serif !important;
    color: #0f172a;
    margin: 0 0 2px 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .vsres-case-location {
    font-size: 12px;
    font-family: 'Nunito', sans-serif;
    color: #64748b;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .vsres-case-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 12px;
  }
  .vsres-stat-col {
    padding: 9px 11px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .vsres-stat-col.old {
    background: #fff1f2;
    border: 1px solid #fecdd3;
  }
  .vsres-stat-col.old .vsres-stat-lbl {
    color: #e11d48;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .vsres-stat-col.old .vsres-stat-val {
    font-family: 'IBM Plex Mono', monospace;
    color: #9f1239;
    font-size: 14px;
    font-weight: 800;
    text-decoration: line-through;
  }
  .vsres-stat-col.new {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
  }
  .vsres-stat-col.new .vsres-stat-lbl {
    color: #059669;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .vsres-stat-col.new .vsres-stat-val {
    font-family: 'IBM Plex Mono', monospace;
    color: #065f46;
    font-size: 14px;
    font-weight: 800;
  }
  .vsres-case-result {
    background: linear-gradient(135deg, #007b3e 0%, #00994d 100%);
    border: 1.5px solid #005a2d;
    padding: 11px 14px;
    border-radius: 12px;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 700;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 14px rgba(0, 123, 62, 0.2);
  }
  .vsres-case-result span {
    color: #a7f3d0;
    font-size: 11.5px;
    font-weight: 700;
  }
  .vsres-case-result strong {
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 800;
  }

  /* ---- FOOTER CTA BAND ---- */
  .vsres-cta-band {
    background: linear-gradient(135deg, #0a4a2c 0%, #007b3e 100%);
    border-radius: 20px;
    color: #ffffff;
    padding: 36px 20px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(10, 74, 44, 0.2);
  }
  @media(min-width: 640px){
    .vsres-cta-band { padding: 48px 36px; }
  }
  .vsres-cta-band h3 {
    font-size: clamp(20px, 4vw, 30px);
    font-weight: 800;
    margin: 0 0 10px 0;
  }
  .vsres-cta-band p {
    color: #d1fae5;
    font-size: 14.5px;
    margin: 0 auto 24px auto;
    max-width: 540px;
  }

  /* ---- SECTION 8 BALOO 2 & NUNITO ULTRA-LUCRATIVE STYLING ---- */
  .vsres-sec8-custom {
    position: relative;
    padding: clamp(34px, 4.5vw, 54px) 0;
    background: radial-gradient(circle at 10% 20%, rgba(236, 92, 10, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 90% 80%, rgba(0, 123, 62, 0.08) 0%, transparent 45%),
                linear-gradient(180deg, #ffffff 0%, #fffdfa 45%, #fff6ea 100%);
    border-top: 2px solid #ecd8c2;
    border-bottom: 2px solid #ecd8c2;
    overflow: hidden;
    font-family: 'Nunito', sans-serif;
  }

  .vsres-sec8-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .vsres-sec8-grid {
      grid-template-columns: 1.12fr 0.88fr;
      gap: 40px;
    }
  }

  .vsres-sec8-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: linear-gradient(135deg, #ffffff 0%, #fff5eb 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.45);
    border-radius: 999px;
    color: #ec5c0a;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    font-family: 'Baloo 2', sans-serif;
    margin-bottom: 10px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.1);
  }

  .vsres-sec8-title {
    font-family: 'Baloo 2', sans-serif !important;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 10px 0;
    letter-spacing: -0.01em;
  }
  .vsres-sec8-title span {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff8800 60%, #c84900 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 8px rgba(236, 92, 10, 0.2));
  }

  .vsres-sec8-lead {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(14px, 1.45vw, 15.5px);
    color: #334155;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  /* 4 Luxury Glass Cards (2x2) */
  .vsres-sec8-pills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 22px;
  }

  .vsres-sec8-pill {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    background: #ffffff;
    border: 1.5px solid #e7dcce;
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vsres-sec8-pill::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
  }
  .vsres-sec8-pill.c1-card::before { background: linear-gradient(90deg, #ec5c0a, #ff9a00); }
  .vsres-sec8-pill.c2-card::before { background: linear-gradient(90deg, #007b3e, #10b981); }
  .vsres-sec8-pill.c3-card::before { background: linear-gradient(90deg, #0284c7, #38bdf8); }
  .vsres-sec8-pill.c4-card::before { background: linear-gradient(90deg, #d97706, #fbbf24); }

  .vsres-sec8-pill:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(236, 92, 10, 0.12);
    border-color: #ec5c0a;
  }

  .vsres-sec8-pill-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.04);
  }
  .vsres-sec8-pill-icon.c1 { background: #ffefe5; color: #ec5c0a; border: 1px solid rgba(236,92,10,0.3); }
  .vsres-sec8-pill-icon.c2 { background: #e6f4ec; color: #007b3e; border: 1px solid rgba(0,123,62,0.3); }
  .vsres-sec8-pill-icon.c3 { background: #eff6ff; color: #0284c7; border: 1px solid rgba(2,132,199,0.3); }
  .vsres-sec8-pill-icon.c4 { background: #fef3c7; color: #b45309; border: 1px solid rgba(180,83,9,0.3); }

  .vsres-sec8-pill-text strong {
    display: block;
    font-family: 'Baloo 2', sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin-bottom: 2px;
  }
  .vsres-sec8-pill-text span {
    font-family: 'Nunito', sans-serif;
    font-size: 11.5px;
    color: #64748b;
    line-height: 1.35;
    display: block;
  }

  /* Right Column Luxury 3D Showcase Frame */
  .vsres-sec8-card-frame {
    background: #ffffff;
    border: 2px solid rgba(236, 92, 10, 0.35);
    border-radius: 24px;
    padding: 10px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.16), 0 4px 18px rgba(0, 0, 0, 0.04);
    position: relative;
    max-width: 400px;
    margin: 0 auto;
    width: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .vsres-sec8-card-frame:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 60px rgba(236, 92, 10, 0.22);
  }

  .vsres-sec8-img-box {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    width: 100%;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  .vsres-sec8-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vsres-sec8-moment-caption {
    padding: 12px 10px 4px 10px;
    text-align: center;
  }
  .vsres-moment-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Baloo 2', sans-serif;
    font-size: 12px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .vsres-moment-quote {
    font-family: 'Nunito', sans-serif;
    font-size: 12px;
    color: #475569;
    line-height: 1.45;
    margin: 0;
  }
  .vsres-moment-quote strong {
    color: #ec5c0a;
  }

  /* ---- MOBILE STYLING & PARAGRAPH ALIGNMENT OVERRIDES (ULTRA-LUCRATIVE) ---- */
  @media (max-width: 767px) {
    .vsres p,
    .vsres .vsres-hero-lead,
    .vsres .vsres-sec-desc,
    .vsres .mcb-card-desc,
    .vsres .vsres-cta-band p {
      text-align: justify !important;
      text-justify: inter-word !important;
      hyphens: auto !important;
    }

    .vsres-hero {
      padding: 24px 0 32px 0;
      background: linear-gradient(180deg, #ffffff 0%, #fff0e5 60%, #fff8ef 100%);
    }
    .vsres-hero h1 {
      font-size: clamp(24px, 7.5vw, 34px);
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .vsres-hero h1 span {
      background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 50%, #c84900 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .vsres-hero-ctas {
      flex-direction: column;
      gap: 10px;
    }
    .vsres-btn-primary, .vsres-btn-secondary {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
      font-size: 15px;
      border-radius: 14px;
    }

    /* Trust Badges mobile grid */
    .vsres-trust-badges {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .vsres-trust-badge-item {
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(255,255,255,0.9);
      border: 1px solid var(--line);
    }
    .vsres-trust-badge-icon {
      width: 28px;
      height: 28px;
      font-size: 12px;
    }

    .vsres-hero-image-box {
      padding: 16px;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.18);
    }

    /* 20 MCB Installation Gallery Mobile WOW */
    .mcb-sec {
      padding: 32px 0;
      background: linear-gradient(180deg, #ffffff 0%, #fff9f2 100%);
    }
    .mcb-filter-bar {
      gap: 6px;
      margin-bottom: 20px;
      overflow-x: auto;
      justify-content: flex-start;
      padding: 4px 2px 8px 2px;
      scrollbar-width: none;
    }
    .mcb-filter-bar::-webkit-scrollbar { display: none; }
    .mcb-filter-btn {
      font-size: 11.5px;
      padding: 7px 16px;
      white-space: nowrap;
      flex-shrink: 0;
      border-radius: 50px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .mcb-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .mcb-card {
      border-radius: 16px;
      border: 1.5px solid #e7dcce;
      border-top: 3.5px solid #ec5c0a;
      box-shadow: 0 6px 18px rgba(0,0,0,0.04);
      background: #ffffff;
    }
    .mcb-card:active {
      transform: scale(0.97);
    }
    .mcb-card-body {
      padding: 10px 12px 12px 12px;
    }
    .mcb-card-title {
      font-size: 12.5px;
      line-height: 1.3;
      margin-bottom: 4px;
      font-weight: 800;
    }
    .mcb-card-desc {
      font-size: 10.5px;
      line-height: 1.4;
      color: var(--muted-2);
    }
    .mcb-card-badge {
      font-size: 8.5px;
      padding: 3px 8px;
      top: 6px;
      left: 6px;
      background: rgba(15, 23, 42, 0.9);
      border-color: rgba(236, 92, 10, 0.6);
    }
    .mcb-card-num {
      font-size: 9.5px;
      letter-spacing: 0.5px;
    }

    /* Calculator Box Mobile Polish */
    .vsres-calc-box {
      padding: 20px 16px;
      border-radius: 18px;
      box-shadow: 0 8px 24px rgba(236, 92, 10, 0.06);
    }
    .vsres-output-card {
      padding: 20px 16px;
      margin-top: 16px;
      border-radius: 16px;
      background: linear-gradient(135deg, #fffaf5 0%, #fff0e5 100%);
    }
    .vsres-res-val {
      font-size: 52px;
    }

    .vsres-table-wrap {
      border-radius: 14px;
      overflow-x: auto;
