{% comment %}
  =============================================================================
  QUALITIES THAT WE ARE PROUD OF - GOLDEN SEALS SHOWCASE (SNIPPET)
  =============================================================================
{% endcomment %}

{%- style -%}
  .vsw-qualities-section,
  .vsw-qualities-section * {
    box-sizing: border-box !important;
  }

  .vsw-qualities-section {
    display: block !important;
    width: 100% !important;
    clear: both !important;
    position: relative !important;
    padding: 95px 24px !important;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF8 60%, #FAFAF7 100%) !important;
    color: #1A1A1A !important;
    overflow: hidden !important;
    border-top: 1px solid rgba(236, 92, 10, 0.12) !important;
  }

  /* Floating Decorative Geometric Squares */
  .vsw-geo-shape {
    position: absolute !important;
    border: 3px solid rgba(245, 158, 11, 0.25) !important;
    border-radius: 12px !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .vsw-geo-1 {
    width: 65px; height: 65px;
    top: 12%; left: 3%;
    transform: rotate(32deg);
    animation: geoFloat 9s ease-in-out infinite;
  }

  .vsw-geo-2 {
    width: 40px; height: 40px;
    top: 8%; left: 8%;
    transform: rotate(18deg);
    border-color: rgba(236, 92, 10, 0.3) !important;
    animation: geoFloat 7s ease-in-out infinite reverse;
  }

  .vsw-geo-3 {
    width: 90px; height: 90px;
    top: 5%; right: 4%;
    transform: rotate(42deg);
    border-color: rgba(245, 158, 11, 0.2) !important;
    animation: geoFloat 12s ease-in-out infinite 1s;
  }

  .vsw-geo-4 {
    width: 25px; height: 25px;
    top: 20%; right: 18%;
    transform: rotate(15deg);
    animation: geoFloat 6s ease-in-out infinite 2s;
  }

  @keyframes geoFloat {
    0%, 100% { transform: translateY(0) rotate(25deg); }
    50% { transform: translateY(-14px) rotate(35deg); }
  }

  .vsw-qualities-container {
    max-width: 1260px !important;
    margin: 0 auto !important;
    position: relative !important;
    z-index: 2 !important;
  }

  /* Header Block */
  .vsw-qualities-header {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    max-width: 780px !important;
    margin-bottom: 55px !important;
  }

  .vsw-qualities-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 6px 18px !important;
    border-radius: 50px !important;
    background: linear-gradient(135deg, #FFF8E7 0%, #FFEFC6 100%) !important;
    border: 1.5px solid rgba(245, 158, 11, 0.4) !important;
    color: #D97706 !important;
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    letter-spacing: 1px !important;
    margin-bottom: 16px !important;
    text-transform: uppercase !important;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.15) !important;
  }

  .vsw-qualities-title {
    font-size: 2.5rem !important;
    font-weight: 900 !important;
    line-height: 1.25 !important;
    color: #0F172A !important;
    margin: 0 0 16px 0 !important;
    letter-spacing: -0.4px !important;
  }

  .vsw-qualities-title span {
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 40%, #EC5C0A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsw-qualities-subtitle {
    font-size: 1.02rem !important;
    font-weight: 500 !important;
    color: #64748B !important;
    line-height: 1.7 !important;
    margin: 0 !important;
  }

  /* 4 Golden Seals Grid Showcase */
  .vsw-seals-grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 28px !important;
    width: 100% !important;
  }

  .vsw-seal-card {
    background: linear-gradient(145deg, #FFFFFF 0%, #FFFCF8 100%) !important;
    border: 2px solid rgba(245, 158, 11, 0.2) !important;
    border-top: 5px solid #F59E0B !important;
    border-radius: 24px !important;
    padding: 36px 24px 32px 24px !important;
    text-align: center !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    box-shadow: 0 16px 45px rgba(245, 158, 11, 0.08), 0 4px 12px rgba(0, 0, 0, 0.03) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .vsw-seal-card:hover {
    transform: translateY(-8px) scale(1.02) !important;
    border-color: #F59E0B !important;
    box-shadow: 0 25px 60px rgba(245, 158, 11, 0.22) !important;
    background: #FFFFFF !important;
  }

  /* Golden Crest Badge Emblem */
  .vsw-seal-emblem-wrap {
    position: relative !important;
    width: 125px !important;
    height: 125px !important;
    margin-bottom: 22px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    filter: drop-shadow(0 10px 20px rgba(245, 158, 11, 0.3)) !important;
    transition: transform 0.4s ease !important;
  }

  .vsw-seal-card:hover .vsw-seal-emblem-wrap {
    transform: scale(1.08) rotate(2deg) !important;
  }

  .vsw-seal-emblem-svg {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }

  .vsw-seal-card-title {
    font-size: 1.18rem !important;
    font-weight: 900 !important;
    color: #0F172A !important;
    margin: 0 0 10px 0 !important;
    line-height: 1.3 !important;
  }

  .vsw-seal-card-desc {
    font-size: 0.88rem !important;
    font-weight: 500 !important;
    color: #64748B !important;
    line-height: 1.6 !important;
    margin: 0 !important;
  }

  /* MOBILE RESPONSIVE STYLING */
  @media screen and (max-width: 991px) {
    .vsw-qualities-section {
      padding: 55px 16px 65px 16px !important;
    }

    .vsw-qualities-header {
      align-items: center !important;
      text-align: center !important;
      margin-bottom: 35px !important;
    }

    .vsw-qualities-title {
      font-size: 1.65rem !important;
      font-weight: 800 !important;
      line-height: 1.3 !important;
    }

    .vsw-qualities-subtitle {
      font-size: 0.9rem !important;
      line-height: 1.6 !important;
      text-align: center !important;
    }

    /* 2x2 COMPACT EQUAL-HEIGHT GRID ON MOBILE */
    .vsw-seals-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 12px !important;
    }

    .vsw-seal-card {
      padding: 24px 14px 20px 14px !important;
      border-radius: 18px !important;
      border-top-width: 4px !important;
    }

    .vsw-seal-emblem-wrap {
      width: 95px !important;
      height: 95px !important;
      margin-bottom: 14px !important;
    }

    .vsw-seal-card-title {
      font-size: 0.98rem !important;
      font-weight: 800 !important;
      margin-bottom: 6px !important;
    }

    .vsw-seal-card-desc {
      font-size: 0.78rem !important;
      line-height: 1.45 !important;
    }
  }

  @media screen and (max-width: 480px) {
    .vsw-seals-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 10px !important;
    }

    .vsw-seal-card {
      padding: 18px 10px !important;
    }

    .vsw-seal-emblem-wrap {
      width: 80px !important;
      height: 80px !important;
      margin-bottom: 10px !important;
    }

    .vsw-seal-card-title {
      font-size: 0.9rem !important;
    }

    .vsw-seal-card-desc {
      font-size: 0.74rem !important;
    }
  }
{%- endstyle -%}

