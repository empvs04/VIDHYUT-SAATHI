  .wvs-pillar-card:nth-child(2) .wvs-pillar-icon { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: #86efac; color: #007b3e; }
  .wvs-pillar-card:nth-child(3) .wvs-pillar-icon { background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-color: #fdba74; color: #ec5c0a; }
  .wvs-pillar-card:nth-child(4) .wvs-pillar-icon { background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); border-color: #c084fc; color: #7c3aed; }
  .wvs-pillar-card:nth-child(5) .wvs-pillar-icon { background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-color: #7dd3fc; color: #0284c7; }
  .wvs-pillar-card:nth-child(6) .wvs-pillar-icon { background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-color: #fed7aa; color: #ea580c; }
  .wvs-pillar-card:nth-child(7) .wvs-pillar-icon { background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-color: #6ee7b7; color: #059669; }
  .wvs-pillar-card:nth-child(8) .wvs-pillar-icon { background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); border-color: #a5b4fc; color: #4f46e5; }

