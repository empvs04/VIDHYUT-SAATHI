  /* 8 Core Pillars Grid - Lucrative Masterpiece Upgrade */
  .wvs-p6-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 50px;
  }

  .wvs-pillar-card {
    background: linear-gradient(160deg, #ffffff 0%, #faf8f5 100%);
    border: 2px solid #e2e8f0;
    border-radius: 28px;
    padding: 34px 24px 28px 24px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    z-index: 1;
  }

  /* Top Gradient Accent Bar for Each Card */
  .wvs-pillar-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #007b3e 0%, #00b853 100%);
    transition: height 0.3s ease;
  }

  .wvs-pillar-card:nth-child(1)::before { background: linear-gradient(90deg, #1d4ed8 0%, #3b82f6 100%); }
  .wvs-pillar-card:nth-child(2)::before { background: linear-gradient(90deg, #007b3e 0%, #00b853 100%); }
  .wvs-pillar-card:nth-child(3)::before { background: linear-gradient(90deg, #ec5c0a 0%, #ff7b00 100%); }
  .wvs-pillar-card:nth-child(4)::before { background: linear-gradient(90deg, #7c3aed 0%, #a855f7 100%); }
  .wvs-pillar-card:nth-child(5)::before { background: linear-gradient(90deg, #0284c7 0%, #38bdf8 100%); }
  .wvs-pillar-card:nth-child(6)::before { background: linear-gradient(90deg, #ea580c 0%, #f97316 100%); }
  .wvs-pillar-card:nth-child(7)::before { background: linear-gradient(90deg, #059669 0%, #10b981 100%); }
  .wvs-pillar-card:nth-child(8)::before { background: linear-gradient(90deg, #4f46e5 0%, #6366f1 100%); }

  /* Ambient Glow Inside Card on Hover */
  .wvs-pillar-card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 50% 20%, rgba(0, 123, 62, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    z-index: -1;
  }

  .wvs-pillar-card:hover {
