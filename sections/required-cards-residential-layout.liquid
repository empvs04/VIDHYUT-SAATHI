  <script>
    if (typeof vsGoPage !== 'function') {
      function vsGoPage(e, handle) {
        if (e) e.preventDefault();
        var mainUrl = '/pages/' + handle;
        var isEditor = (window.Shopify && window.Shopify.designMode) || location.search.indexOf('preview_theme_id') > -1 || location.search.indexOf('view=') > -1;
        
        if (isEditor) {
          var path = location.pathname;
          if (!path || path === '/' || path === '/pages') { path = '/pages/required-cards'; }
          location.href = path + '?view=' + handle;
          return;
        }

        fetch(mainUrl, { method: 'HEAD' }).then(function(res) {
          if (res.ok) {
            location.href = mainUrl;
          } else {
            var path = location.pathname;
            if (!path || path === '/') { path = '/pages/required-cards'; }
            location.href = path + '?view=' + handle;
          }
        }).catch(function() {
          location.href = mainUrl;
        });
      }
    }
  </script>

