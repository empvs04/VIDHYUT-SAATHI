        <button class="mcb-filter-btn" onclick="filterMcb('single', this)"><i class="fa-solid fa-plug"></i> Single-Phase MCB (10)</button>
        <button class="mcb-filter-btn" onclick="filterMcb('three', this)"><i class="fa-solid fa-bolt-lightning"></i> 3-Phase MCB (6)</button>
        <button class="mcb-filter-btn" onclick="filterMcb('panel', this)"><i class="fa-solid fa-server"></i> Main DB Panel (4)</button>
      </div>

      <!-- 20 Installation Cards Grid -->
      <div class="mcb-gallery-grid">
        {% for i in (1..20) %}
          {% capture img_key %}mcb_img_{{ i }}{% endcapture %}
          {% assign custom_img = section.settings[img_key] %}

          {% assign block = nil %}
          {% if section.blocks.size >= i %}
            {% assign block_idx = i | minus: 1 %}
            {% assign block = section.blocks[block_idx] %}
          {% endif %}

          {% assign cat = 'single' %}
          {% assign badge = '16A SINGLE PHASE' %}
          {% assign title = 'Home MCB Board Setup #' | append: i %}
          {% assign desc = 'Connected parallel to main MCB switch board with zero wire cutting.' %}

          {% if i > 10 and i <= 16 %}
            {% assign cat = 'three' %}
            {% assign badge = '32A 3-PHASE MCB' %}
            {% assign title = '3-Phase Submersible MCB #' | append: i %}
          {% elsif i > 16 %}
            {% assign cat = 'panel' %}
            {% assign badge = 'MAIN DB PANEL' %}
            {% assign title = 'Villa Main DB Box Setup #' | append: i %}
          {% endif %}

          {% if block != nil %}
            {% if block.settings.title != blank %}{% assign title = block.settings.title %}{% endif %}
            {% if block.settings.category != blank %}{% assign cat = block.settings.category %}{% endif %}
            {% if block.settings.badge != blank %}{% assign badge = block.settings.badge %}{% endif %}
            {% if block.settings.caption != blank %}{% assign desc = block.settings.caption %}{% endif %}
            {% if block.settings.image != blank %}{% assign custom_img = block.settings.image %}{% endif %}
          {% endif %}

          <div class="mcb-card" data-category="{{ cat }}" onclick="openMcbLightbox('{% if custom_img != blank %}{{ custom_img | image_url: width: 1200 }}{% endif %}', '{{ title | escape }}', '{{ desc | escape }}')">
            <div class="mcb-card-img-wrap">
              {% if custom_img != blank %}
                <img src="{{ custom_img | image_url: width: 600 }}" alt="{{ title }}" loading="lazy">
              {% else %}
                <div class="mcb-svg-mockup">
                  <svg viewBox="0 0 400 300" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                    <rect width="400" height="300" fill="#0f172a"/>
                    <rect x="25" y="25" width="350" height="250" rx="12" fill="#1e293b" stroke="rgba(236,92,10,0.4)" stroke-width="2"/>
                    <rect x="50" y="55" width="190" height="190" rx="8" fill="#0f172a" stroke="#007b3e" stroke-width="2"/>
                    <!-- MCB Switches -->
                    <rect x="70" y="80" width="22" height="55" rx="4" fill="#007b3e"/>
                    <rect x="100" y="80" width="22" height="55" rx="4" fill="#007b3e"/>
                    <rect x="130" y="80" width="22" height="55" rx="4" fill="#ec5c0a"/>
                    <rect x="160" y="80" width="22" height="55" rx="4" fill="#007b3e"/>
                    <rect x="190" y="80" width="22" height="55" rx="4" fill="#007b3e"/>
                    <circle cx="120" cy="180" r="8" fill="#25d366"/>
                    <text x="145" y="184" fill="#a7f3d0" font-size="10" font-family="Arial" font-weight="700">ONLINE</text>
                    <!-- VS Card -->
                    <rect x="260" y="75" width="95" height="150" rx="10" fill="url(#mcbCardGlow{{ i }})" stroke="#ffd700" stroke-width="2"/>
                    <circle cx="307" cy="120" r="20" fill="rgba(255,255,255,0.1)"/>
                    <text x="307" y="124" text-anchor="middle" fill="#ffffff" font-size="14" font-weight="800">⚡</text>
                    <text x="307" y="165" text-anchor="middle" fill="#ffffff" font-size="9" font-weight="800" font-family="Arial">VIDHYUT SAATHI</text>
                    <text x="307" y="180" text-anchor="middle" fill="#ff9d66" font-size="8" font-family="Arial">MCB SETUP #{{ i }}</text>
                    <!-- Wiring -->
                    <line x1="220" y1="105" x2="260" y2="105" stroke="#ffd700" stroke-width="3" stroke-dasharray="4,4"/>
                    <defs>
                      <linearGradient id="mcbCardGlow{{ i }}" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="{% if cat == 'three' %}#007b3e{% elsif cat == 'panel' %}#0f172a{% else %}#ec5c0a{% endif %}"/>
                        <stop offset="100%" stop-color="#1e293b"/>
                      </linearGradient>
                    </defs>
                  </svg>
                </div>
              {% endif %}
              <span class="mcb-card-badge">{{ badge }}</span>
              <div class="mcb-zoom-overlay"><i class="fa-solid fa-magnifying-glass-plus"></i></div>
