<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&family=IBM+Plex+Mono:wght@600;700&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     VIDHYUT SAATHI — RESIDENTIAL REQUIRED CARDS PAGE
     Ultra-Lucrative Light & Modern Design
     Theme: Warm Cream #fff8ef | Panel #ffffff | Accent #f0631b | Green #0a4a2c | Slate #16281f
  ============================================================ */
  .vsres {
    --bg:       #fff8ef;
    --bg-warm:  #f5ebd9;
    --panel:    #ffffff;
    --panel-2:  #fbf6ec;
    --line:     #e7dcce;
    --line-s:   #f0e5d6;
    --green:    #007b3e;
    --green-d:  #0a4a2c;
    --green-t:  #e6f4ec;
    --orange:   #ec5c0a;
    --orange-d: #c84900;
    --orange-t: #ffefe5;
    --gold:     #c9982e;
    --ink:      #0f172a;
    --muted:    #475569;
    --muted-2:  #64748b;
    --maxw:     1180px;

    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    font-size: 16px;
    line-height: 1.55;
  }

  .vsres *, .vsres *::before, .vsres *::after {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  .vsres h1, .vsres h2, .vsres h3, .vsres h4 {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }

  .vsres a { color: inherit; text-decoration: none; }
  .vsres img { max-width: 100%; display: block; }
  .vsres button { font-family: inherit; cursor: pointer; }

  .vsres .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 16px;
  }
  @media(min-width: 640px){ .vsres .wrap { padding: 0 28px; } }

  /* ---- CATEGORY NAVIGATION STRIP ---- */
  .vsres-nav-strip {
    background: #ffffff;
    border-bottom: 1.5px solid var(--line);
    padding: 12px 16px;
    position: relative;
    z-index: 9999;
    pointer-events: auto !important;
    box-shadow: 0 4px 14px rgba(0,0,0,0.03);
  }

  .vsres-nav-container {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    pointer-events: auto !important;
  }

  .vsres-nav-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .vsres-nav-title i { color: var(--orange); }

  .vsres-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    pointer-events: auto !important;
  }
  .vsres-nav-links::-webkit-scrollbar { display: none; }

  .vsres-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: var(--muted);
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative;
    z-index: 10;
  }
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: var(--muted);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .vsres-nav-item:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .vsres-nav-item.active {
    background: linear-gradient(135deg, var(--orange) 0%, #ff7b00 100%);
    color: #ffffff;
    border-color: var(--orange);
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.3);
  }

  /* ---- HERO SECTION ---- */
  .vsres-hero {
    position: relative;
    padding: clamp(32px, 5vw, 65px) 0 clamp(24px, 4vw, 45px) 0;
    background: linear-gradient(135deg, #ffffff 0%, #fff3e6 50%, #fff8ef 100%);
    border-bottom: 1.5px solid var(--line);
    overflow: hidden;
  }

  .vsres-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  @media(min-width: 900px){
    .vsres-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
    }
  }

  .vsres-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1.5px solid var(--orange);
    color: var(--orange);
    font-size: 11px;
    font-weight: 700;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 16px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.12);
  }

  .vsres-hero h1 {
    font-size: clamp(25px, 5.2vw, 46px);
    line-height: 1.15;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 14px 0;
  }
  .vsres-hero h1 span {
    background: linear-gradient(135deg, var(--orange) 0%, #ff7b00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsres-hero-lead {
    color: var(--muted);
    font-size: clamp(14px, 2vw, 16px);
    line-height: 1.6;
    margin: 0 0 24px 0;
    max-width: 620px;
  }

  .vsres-hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .vsres-btn-primary {
    background: linear-gradient(135deg, var(--orange) 0%, #ff7b00 100%);
    color: #ffffff;
    font-weight: 700;
    padding: 14px 26px;
    border-radius: 12px;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.32);
    transition: all 0.2s ease;
  }
  .vsres-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(236, 92, 10, 0.4);
  }

  .vsres-btn-secondary {
    background: #ffffff;
    color: var(--green-d);
    border: 1.5px solid var(--green);
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }
  .vsres-btn-secondary:hover {
    background: var(--green-t);
  }

  /* Trust Badges Strip */
  .vsres-trust-badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding-top: 20px;
    border-top: 1.5px solid var(--line);
  }
  @media(min-width: 600px){
    .vsres-trust-badges { grid-template-columns: repeat(4, 1fr); }
  }

  .vsres-trust-badge-item {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
  }

  .vsres-trust-badge-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--orange-t);
    color: var(--orange);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }

  .vsres-trust-badge-text strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .vsres-trust-badge-text span {
    font-size: 10.5px;
    color: var(--muted-2);
  }

  /* Right Card Image Showcase */
  .vsres-hero-image-box {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #ec5c0a 100%);
    border: 2px solid var(--line);
    box-shadow: 0 16px 36px rgba(0,0,0,0.12);
    padding: 24px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .vsres-hero-card-tag {
    background: rgba(236, 92, 10, 0.25);
    border: 1px solid rgba(236, 92, 10, 0.5);
    color: #ff9d66;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 16px;
  }

  .vsres-mcb-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(236, 92, 10, 0.22);
    border: 1.5px solid rgba(255, 157, 102, 0.5);
    color: #ffb088;
    font-size: 12.5px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 50px;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 10px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
  }
  .vsres-mcb-hero-link:hover {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    border-color: #ff7b00;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(236, 92, 10, 0.45);
  }

  /* ---- RESIDENTIAL CALCULATOR SECTION ---- */
  .vsres-sec { padding: 44px 0; }
  @media(min-width: 768px){ .vsres-sec { padding: 60px 0; } }

  .vsres-sec-head {
    max-width: 680px;
    margin: 0 auto 28px;
    text-align: center;
  }
  .vsres-sec-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 6px;
  }
  .vsres-sec-title {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 10px 0;
  }
  .vsres-sec-desc {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
  }

  .vsres-calc-box {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    padding: 24px 18px;
  }
  @media(min-width: 860px){
    .vsres-calc-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding: 36px 30px;
    }
  }

  .vsres-field {
    margin-bottom: 20px;
  }
  .vsres-field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .vsres-field-badge {
    background: var(--orange-t);
    color: var(--orange);
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 700;
  }

  .vsres-range-slider {
    width: 100%;
    height: 8px;
    border-radius: 50px;
    background: var(--line);
    outline: none;
    accent-color: var(--orange);
    margin: 10px 0;
  }

  .vsres-num-input {
    width: 100%;
    height: 46px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 0 14px;
    font-size: 15px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
    color: var(--ink);
    background: #ffffff;
    outline: none;
    transition: border-color 0.2s;
  }
  .vsres-num-input:focus {
    border-color: var(--orange);
  }

  .vsres-toggle-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .vsres-toggle-btn {
    padding: 12px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: #ffffff;
    color: var(--muted);
    font-weight: 700;
    font-size: 13px;
    transition: all 0.2s;
  }
  .vsres-toggle-btn.active {
    background: var(--green-d);
    color: #ffffff;
    border-color: var(--green-d);
  }

  /* Output Card */
  .vsres-output-card {
    background: var(--panel-2);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .vsres-res-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .vsres-res-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(48px, 10vw, 68px);
    font-weight: 800;
    color: var(--green-d);
    line-height: 1;
    margin: 8px 0 16px 0;
  }
  .vsres-res-val span {
    font-size: 16px;
    color: var(--muted);
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .vsres-savings-box {
    background: linear-gradient(135deg, #0a4a2c 0%, #007b3e 100%);
    border-radius: 14px;
    padding: 16px;
    color: #ffffff;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .vsres-savings-lbl {
    font-size: 10px;
    font-weight: 700;
    font-family: 'IBM Plex Mono', monospace;
    letter-spacing: 0.6px;
    color: #a7f3d0;
    text-transform: uppercase;
  }
  .vsres-savings-amount {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(18px, 3.5vw, 24px);
    font-weight: 800;
  }

  .vsres-action-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  @media(max-width: 420px){ .vsres-action-btns { grid-template-columns: 1fr; } }

  .vsres-btn-wa {
    background: #25d366;
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 700;
    padding: 12px 14px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(37,211,102,0.25);
  }
  .vsres-btn-phone {
    background: #ffffff;
    color: var(--green-d);
    border: 1.5px solid var(--green);
    font-size: 13.5px;
    font-weight: 700;
    padding: 12px 14px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-decoration: none;
  }

  /* ══ 20 MCB INSTALLATION GALLERY SECTION (LUCRATIVE) ══ */
  .mcb-sec {
    background: #ffffff;
    border-top: 1.5px solid var(--line);
    border-bottom: 1.5px solid var(--line);
    padding: clamp(40px, 6vw, 75px) 0;
  }

  .mcb-filter-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .mcb-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.22s ease;
  }
  .mcb-filter-btn:hover,
  .mcb-filter-btn.active {
    background: linear-gradient(135deg, var(--orange) 0%, #ff7b00 100%);
    color: #ffffff;
    border-color: var(--orange);
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.3);
  }

  .mcb-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media(min-width: 640px){
    .mcb-gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; }
  }
  @media(min-width: 1024px){
    .mcb-gallery-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  }

  .mcb-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
  }
  .mcb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(236, 92, 10, 0.14);
    border-color: var(--orange);
  }

  .mcb-card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0f172a;
  }

  .mcb-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .mcb-card:hover .mcb-card-img-wrap img {
    transform: scale(1.08);
  }

  .mcb-card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #ff9d66;
    font-size: 10px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    padding: 3.5px 10px;
    border-radius: 50px;
    border: 1px solid rgba(236, 92, 10, 0.4);
    z-index: 2;
  }

  .mcb-zoom-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    color: #ffffff;
    font-size: 20px;
  }
  .mcb-card:hover .mcb-zoom-overlay { opacity: 1; }

  .mcb-card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .mcb-card-num {
    font-size: 10px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    color: var(--orange);
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .mcb-card-title {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 4px 0;
    line-height: 1.3;
  }
  .mcb-card-desc {
    font-size: 11.5px;
    color: var(--muted-2);
    margin: 0;
    line-height: 1.45;
  }

  /* SVG Mockup Illustration Styling */
  .mcb-svg-mockup {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #007b3e 100%);
  }

  /* Lightbox Modal */
  .mcb-lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
  }
  .mcb-lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  .mcb-lightbox-box {
    background: #ffffff;
    border-radius: 20px;
    max-width: 720px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: relative;
    border: 1.5px solid var(--orange);
  }
  .mcb-lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    color: #0f172a;
    border: 1.5px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    z-index: 10;
  }
  .mcb-lightbox-img-wrap {
    width: 100%;
    max-height: 420px;
    background: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mcb-lightbox-info {
    padding: 20px;
  }

  /* ---- RESIDENTIAL REQUIREMENT TABLE ---- */
  .vsres-table-wrap {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .vsres-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .vsres-table thead tr {
    background: var(--green-d);
    color: #ffffff;
  }

  .vsres-table th {
    padding: 12px 14px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    text-align: center;
  }
  .vsres-table th:first-child { text-align: left; }

  .vsres-table tbody tr {
    border-bottom: 1px solid var(--line-s);
  }
  .vsres-table tbody tr:nth-child(even) { background: #fbf8f0; }

