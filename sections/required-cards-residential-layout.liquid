<script>
  var vsresThreePhase = false;

  function vsresSync() {
    var kwSlider = document.getElementById('vsres_kw_slider');
    var kwNum = document.getElementById('vsres_kw_num');
    var billNum = document.getElementById('vsres_bill_num');
    var kwBadge = document.getElementById('vsres_kw_badge');
    var billBadge = document.getElementById('vsres_bill_badge');

    var kw = Math.max(1, parseInt(kwNum.value) || 1);
    var bill = Math.max(0, parseInt(billNum.value) || 0);

    kwSlider.value = Math.min(kw, 40);
    kwBadge.innerText = kw + ' KW';
    billBadge.innerText = '₹' + bill.toLocaleString('en-IN');

    var kwCards = Math.max(1, Math.ceil(kw / 6));
    var billCards = bill > 0 ? Math.max(1, Math.ceil(bill / 6000)) : 1;
    var base = Math.max(kwCards, billCards);
    var total = vsresThreePhase ? base + 1 : base;

    document.getElementById('vsres_card_num').innerText = total;
    document.getElementById('vsres_card_unit').innerText = total > 1 ? 'Cards' : 'Card';

    var sMin = Math.round((bill * 0.20) / 100) * 100;
    var sMax = Math.round((bill * 0.30) / 100) * 100;
    document.getElementById('vsres_savings_range').innerText = '₹' + sMin.toLocaleString('en-IN') + ' – ₹' + sMax.toLocaleString('en-IN') + ' / mo';
  }

  function vsresSetPhase(isThree) {
    vsresThreePhase = isThree;
    var btnSingle = document.getElementById('vsres_btn_single');
    var btnThree = document.getElementById('vsres_btn_three');
    if (isThree) {
      btnThree.classList.add('active');
      btnSingle.classList.remove('active');
    } else {
      btnSingle.classList.add('active');
      btnThree.classList.remove('active');
    }
    vsresSync();
  }

  document.getElementById('vsres_kw_slider').addEventListener('input', function() {
    document.getElementById('vsres_kw_num').value = this.value;
    vsresSync();
  });

  /* MCB GALLERY FILTER & LIGHTBOX */
  function filterMcb(category, btnElem) {
    if (btnElem) {
      var allBtns = document.querySelectorAll('.mcb-filter-btn');
      allBtns.forEach(function(b) { b.classList.remove('active'); });
      btnElem.classList.add('active');
    }
    var cards = document.querySelectorAll('.mcb-card');
    cards.forEach(function(card) {
      var cat = card.getAttribute('data-category');
      if (category === 'all' || cat === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function openMcbLightbox(imgSrc, title, caption) {
    var container = document.getElementById('mcb_lightbox_img_container');
    if (imgSrc) {
      container.innerHTML = '<img src="' + imgSrc + '" style="max-width:100%; max-height:420px; object-fit:contain;">';
    } else {
      container.innerHTML = '<div style="padding:40px; text-align:center; color:#ff9d66; font-size:18px; font-weight:800;"><i class="fa-solid fa-bolt" style="font-size:36px; margin-bottom:10px; display:block;"></i>' + title + '</div>';
    }
    document.getElementById('mcb_lightbox_title').innerText = title;
    document.getElementById('mcb_lightbox_desc').innerText = caption;
    document.getElementById('mcb_lightbox').classList.add('active');
  }

  function closeMcbLightbox() {
    document.getElementById('mcb_lightbox').classList.remove('active');
  }
</script>

