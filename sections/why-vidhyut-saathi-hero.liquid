{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 1: HERO HEADER (OFFICIAL BRAND PALETTE)
     ========================================================================== */

  .wvs-hero-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    padding: clamp(35px, 4vw, 55px) 20px clamp(35px, 4vw, 50px) 20px;
    background: #FFFFFF;
    overflow: hidden;
    border-bottom: 3px solid #F17022;
    box-shadow: 0 10px 40px rgba(241, 112, 34, 0.08);
  }

  /* Vibrant Background Glow Orbs */
  .wvs-hero-orb-1 {
    position: absolute;
    top: -140px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(241, 112, 34, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-hero-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 154, 68, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* Moving Background Marquee Text */
  @keyframes wvs-hero-marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  .wvs-hero-moving-text {
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    left: 0;
    width: 200%;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.08;
    pointer-events: none;
    font-size: clamp(50px, 8.5vw, 120px);
    font-weight: 900;
    letter-spacing: 4px;
    text-transform: uppercase;
    background: linear-gradient(90deg, #F17022, #009A44, #FB5900, #F17022);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: wvs-hero-marquee 20s linear infinite;
    line-height: 1;
  }

  .wvs-hero-container {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    text-align: center;
  }

  /* Vibrant Top Badge */
  .wvs-hero-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 24px;
    background: #FFFFFF;
    border: 2px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.15);
    transition: transform 0.3s ease;
  }

  .wvs-hero-badge:hover {
    transform: scale(1.04);
  }

  .wvs-hero-pulse {
    width: 10px;
    height: 10px;
    background-color: #25D300;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(37, 211, 0, 0.7);
    animation: wvs-pulse-dot 1.8s infinite;
    flex-shrink: 0;
  }

  @keyframes wvs-pulse-dot {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 0, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 12px rgba(37, 211, 0, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 0, 0); }
  }

  /* Main Heading */
  .wvs-hero-title {
    font-size: clamp(28px, 4.5vw, 50px);
    font-weight: 800;
    line-height: 1.2;
    color: #231F20;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  .wvs-highlight-orange {
    color: #F17022;
    display: inline-block;
  }

  .wvs-highlight-green {
    color: #009A44;
    display: inline-block;
  }

  /* Subtitle Pill Card */
  .wvs-hero-subtitle-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #FFFFFF;
    border: 1.5px solid rgba(241, 112, 34, 0.3);
    border-radius: 50px;
    padding: 14px 28px;
    font-size: clamp(14px, 1.8vw, 18px);
    font-weight: 700;
    color: #231F20;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    margin-bottom: 26px;
  }

  .wvs-subtitle-icon {
    font-size: 1.3rem;
    color: #FDBA00;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Highlight Pills Row */
  .wvs-hero-highlights {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .wvs-feature-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #FFFFFF;
    border: 2px solid #FDBA00;
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #231F20;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
  }

  .wvs-feature-tag:hover {
    transform: translateY(-4px) scale(1.03);
    border-color: #FB5900;
    box-shadow: 0 14px 32px rgba(251, 89, 0, 0.2);
  }

  .wvs-tag-icon-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FFF8E7;
    border: 1px solid #FDBA00;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #F17022;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  /* Mobile Responsive Enhancements */
  @media (max-width: 768px) {
    p, .wvs-hero-subtitle-card {
      text-align: justify !important;
      text-justify: inter-word !important;
      hyphens: auto !important;
      -webkit-hyphens: auto !important;
    }
    .wvs-hero-wrapper {
      padding: 28px 14px 32px 14px;
    }
    .wvs-hero-badge {
      padding: 6px 18px;
      font-size: 0.82rem;
      margin-bottom: 12px;
    }
    .wvs-hero-title {
      font-size: clamp(24px, 5.8vw, 36px);
      line-height: 1.25;
      margin-bottom: 14px;
    }
    .wvs-hero-subtitle-card {
      padding: 12px 16px;
      flex-direction: row;
      text-align: left;
      gap: 10px;
      border-radius: 16px;
      font-size: 0.92rem;
      margin-bottom: 20px;
    }
    .wvs-hero-highlights {
      gap: 10px;
    }
    .wvs-feature-tag {
      padding: 8px 16px;
      font-size: 0.86rem;
    }
    .wvs-tag-icon-circle {
      width: 26px;
      height: 26px;
      font-size: 0.8rem;
    }
  }

  .wvs-hero-title-line1,
  .wvs-hero-title-line2 {
    display: inline;
  }

  /* Mobile Title Line Formatting: Exactly 2 Clean Lines on Mobile */
  @media (max-width: 768px) {
    h1.wvs-hero-title,
    .wvs-hero-title {
      font-size: clamp(1.28rem, 5.2vw, 1.7rem) !important;
      line-height: 1.35 !important;
      margin-bottom: 18px !important;
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 4px !important;
    }

    .wvs-hero-title-line1 {
      display: block !important;
      color: #231F20 !important;
      font-weight: 900 !important;
      text-align: center !important;
    }

    .wvs-hero-title-line2 {
      display: block !important;
      font-weight: 900 !important;
      text-align: center !important;
    }

    .wvs-hero-highlights {
      flex-direction: column !important;
      width: 100% !important;
      max-width: 320px !important;
      margin: 0 auto !important;
      gap: 12px !important;
    }
    .wvs-feature-tag {
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      padding: 10px 20px !important;
      box-sizing: border-box !important;
      border-radius: 50px !important;
    }
    .wvs-tag-icon-circle {
      width: 32px !important;
      min-width: 32px !important;
      height: 32px !important;
      font-size: 0.9rem !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
      margin-right: 12px !important;
    }
    .wvs-feature-tag span:last-child {
      flex: 1 !important;
      text-align: left !important;
      font-size: 0.92rem !important;
      font-weight: 700 !important;
    }

    .wvs-hero-wrapper p {
      text-align: justify !important;
      text-justify: inter-word !important;
      -webkit-hyphens: auto !important;
      hyphens: auto !important;
      word-spacing: -0.4px !important;
      letter-spacing: -0.15px !important;
    }
  }
{%- endstyle -%}

<div class="wvs-hero-wrapper">
  <!-- Background Glow Orbs -->
  <div class="wvs-hero-orb-1"></div>
  <div class="wvs-hero-orb-2"></div>

  <!-- Background Moving Text Marquee -->
  <div class="wvs-hero-moving-text">
    WHY VIDHYUT SAATHI • WHY VIDHYUT SAATHI • WHY VIDHYUT SAATHI • WHY VIDHYUT SAATHI
  </div>

  <div class="wvs-hero-container">
    <!-- Top Badge -->
    <div class="wvs-hero-badge">
      <span class="wvs-hero-pulse"></span>
      <span>{{ section.settings.badge_text | default: "WHY VIDHYUT SAATHI?" }}</span>
    </div>

    <!-- Main Title -->
    <h1 class="wvs-hero-title">
      <span class="wvs-hero-title-line1">{{ section.settings.title_part1 | default: "BUILD YOUR BUSINESS IN INDIA'S" }}</span>
      <span class="wvs-hero-title-line2">
        <span class="wvs-highlight-orange">{{ section.settings.title_part2 | default: "GROWING ENERGY-SAVING" }}</span>
        <span class="wvs-highlight-green">{{ section.settings.title_part3 | default: "MARKET." }}</span>
      </span>
    </h1>

    <!-- Subtitle Card -->
    <div class="wvs-hero-subtitle-card">
      <i class="fa-solid fa-bolt wvs-subtitle-icon"></i>
      <span>{{ section.settings.subtitle | default: "A Powerful Product. A Growing Market. A Pan-India Franchise Opportunity." }}</span>
    </div>

    <!-- Lucrative Highlight Pills -->
    <div class="wvs-hero-highlights">
      <div class="wvs-feature-tag">
        <span class="wvs-tag-icon-circle"><i class="fa-solid fa-shield-halved"></i></span>
        <span>Powerful Product</span>
      </div>
      <div class="wvs-feature-tag">
        <span class="wvs-tag-icon-circle"><i class="fa-solid fa-chart-line"></i></span>
        <span>Growing Market</span>
      </div>
      <div class="wvs-feature-tag">
        <span class="wvs-tag-icon-circle"><i class="fa-solid fa-map-location-dot"></i></span>
        <span>Pan-India Franchise</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Hero (Header)",
  "tag": "section",
  "class": "section-why-vidhyut-hero-only",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "WHY VIDHYUT SAATHI?"
    },
    {
      "type": "text",
      "id": "title_part1",
      "label": "Title Part 1",
      "default": "BUILD YOUR BUSINESS IN INDIA'S"
    },
    {
      "type": "text",
      "id": "title_part2",
      "label": "Title Part 2 (Orange)",
      "default": "GROWING ENERGY-SAVING"
    },
    {
      "type": "text",
      "id": "title_part3",
      "label": "Title Part 3 (Green)",
      "default": "MARKET."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Tagline",
      "default": "A Powerful Product. A Growing Market. A Pan-India Franchise Opportunity."
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Hero (Header)"
    }
  ]
}
{% endschema %}
