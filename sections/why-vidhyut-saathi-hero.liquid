{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 1: HERO HEADER (COMPACT, UPWARD & LUCRATIVE)
     ========================================================================== */

  .wvs-hero-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    padding: clamp(35px, 4vw, 55px) 20px clamp(35px, 4vw, 50px) 20px;
    background: radial-gradient(circle at 50% 20%, #fffbf2 0%, #fff4e5 45%, #fef0db 100%);
    overflow: hidden;
    border-bottom: 3px solid #ec5c0a;
    box-shadow: 0 10px 40px rgba(236, 92, 10, 0.08);
  }

  /* Vibrant Background Glow Orbs */
  .wvs-hero-orb-1 {
    position: absolute;
    top: -140px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-hero-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* Moving Background Marquee Text */
  @keyframes wvs-hero-marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  .wvs-hero-moving-text {
    position: absolute;
    top: 45%;
    transform: translateY(-50%);
    left: 0;
    width: 200%;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.14;
    pointer-events: none;
    font-size: clamp(50px, 8.5vw, 120px);
    font-weight: 900;
    letter-spacing: 4px;
    text-transform: uppercase;
    background: linear-gradient(90deg, #ec5c0a, #e67e22, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: wvs-hero-marquee 20s linear infinite;
    line-height: 1;
  }

  .wvs-hero-container {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    text-align: center;
  }

  /* Vibrant Top Badge - Shifted Slightly Up */
  .wvs-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 24px;
    background: linear-gradient(135deg, #ffffff 0%, #fff7ed 100%);
    border: 2px solid #ec5c0a;
    border-radius: 50px;
    color: #ec5c0a;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.18);
    transition: transform 0.3s ease;
  }

  .wvs-hero-badge:hover {
    transform: scale(1.04);
  }

  .wvs-hero-pulse {
    width: 10px;
    height: 10px;
    background-color: #00b853;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 184, 83, 0.7);
    animation: wvs-pulse-dot 1.8s infinite;
  }

  @keyframes wvs-pulse-dot {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 184, 83, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 12px rgba(0, 184, 83, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 184, 83, 0); }
  }

  /* Main Heading with Bright Lucrative Gradients */
  .wvs-hero-title {
    font-size: clamp(30px, 4.8vw, 54px);
    font-weight: 900;
    line-height: 1.18;
    color: #0f172a;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  .wvs-highlight-orange {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .wvs-highlight-green {
    background: linear-gradient(135deg, #007b3e 0%, #00b853 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Subtitle Pill Card */
  .wvs-hero-subtitle-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1.5px solid rgba(236, 92, 10, 0.25);
    border-radius: 50px;
    padding: 14px 28px;
    font-size: clamp(15px, 2vw, 19px);
    font-weight: 800;
    color: #1e293b;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    margin-bottom: 26px;
  }

  .wvs-subtitle-icon {
    font-size: 1.3rem;
    color: #ec5c0a;
  }

  /* Lucrative Highlight Pills Row with Custom Gradient Border Styling */
  .wvs-hero-highlights {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .wvs-feature-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(#ffffff, #ffffff) padding-box, linear-gradient(135deg, #ec5c0a 0%, #ffcc00 50%, #007b3e 100%) border-box;
    border: 2px solid transparent;
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 0.98rem;
    font-weight: 800;
    color: #0f172a;
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.12);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
  }

  .wvs-feature-tag:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 14px 32px rgba(236, 92, 10, 0.22);
    background: linear-gradient(#fff7ed, #fff7ed) padding-box, linear-gradient(135deg, #ffcc00 0%, #ec5c0a 100%) border-box;
  }

  .wvs-tag-icon-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fdba74;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ec5c0a;
    font-size: 0.95rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .wvs-hero-wrapper {
      padding: 30px 15px 35px 15px;
    }
    .wvs-hero-subtitle-card {
      padding: 12px 18px;
      flex-direction: column;
      text-align: center;
      gap: 6px;
      border-radius: 20px;
    }
    .wvs-hero-highlights {
      gap: 12px;
    }
    .wvs-feature-tag {
      padding: 10px 18px;
      font-size: 0.9rem;
    }
  }
{%- endstyle -%}

<div class="wvs-hero-wrapper">
  <!-- Vibrant Background Glow Orbs -->
  <div class="wvs-hero-orb-1"></div>
  <div class="wvs-hero-orb-2"></div>

  <!-- Background Moving Text Marquee -->
  <div class="wvs-hero-moving-text">
    WHY VIDHYUT SAATHI • WHY VIDHYUT SAATHI • WHY VIDHYUT SAATHI • WHY VIDHYUT SAATHI
  </div>

  <div class="wvs-hero-container">
    <!-- Top Badge -->
    <div class="wvs-hero-badge">
      <span class="wvs-hero-pulse"></span>
      <span>{{ section.settings.badge_text | default: "WHY VIDHYUT SAATHI?" }}</span>
    </div>

    <!-- Main Title -->
    <h1 class="wvs-hero-title">
      {{ section.settings.title_part1 | default: "BUILD YOUR BUSINESS IN INDIA’S" }}<br>
      <span class="wvs-highlight-orange">{{ section.settings.title_part2 | default: "GROWING ENERGY-SAVING" }}</span>
      <span class="wvs-highlight-green">{{ section.settings.title_part3 | default: "MARKET." }}</span>
    </h1>

    <!-- Subtitle Card -->
    <div class="wvs-hero-subtitle-card">
      <i class="fa-solid fa-bolt wvs-subtitle-icon"></i>
      <span>{{ section.settings.subtitle | default: "A Powerful Product. A Growing Market. A Pan-India Franchise Opportunity." }}</span>
    </div>

    <!-- Lucrative Highlight Pills with Styled Gradient Borders -->
    <div class="wvs-hero-highlights">
      <div class="wvs-feature-tag">
        <span class="wvs-tag-icon-circle"><i class="fa-solid fa-shield-halved"></i></span>
        <span>Powerful Product</span>
      </div>
      <div class="wvs-feature-tag">
        <span class="wvs-tag-icon-circle"><i class="fa-solid fa-chart-line"></i></span>
        <span>Growing Market</span>
      </div>
      <div class="wvs-feature-tag">
        <span class="wvs-tag-icon-circle"><i class="fa-solid fa-map-location-dot"></i></span>
        <span>Pan-India Franchise</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Hero (Header)",
  "tag": "section",
  "class": "section-why-vidhyut-hero-only",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "WHY VIDHYUT SAATHI?"
    },
    {
      "type": "text",
      "id": "title_part1",
      "label": "Title Part 1",
      "default": "BUILD YOUR BUSINESS IN INDIA’S"
    },
    {
      "type": "text",
      "id": "title_part2",
      "label": "Title Part 2 (Orange)",
      "default": "GROWING ENERGY-SAVING"
    },
    {
      "type": "text",
      "id": "title_part3",
      "label": "Title Part 3 (Green)",
      "default": "MARKET."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Tagline",
      "default": "A Powerful Product. A Growing Market. A Pan-India Franchise Opportunity."
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Hero (Header)"
    }
  ]
}
{% endschema %}
