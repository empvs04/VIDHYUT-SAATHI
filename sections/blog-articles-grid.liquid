<style>
  .vsblog-grid-section-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    box-sizing: border-box;
    width: 100%;
  }

  .vsblog-grid-section-wrap *, .vsblog-grid-section-wrap *::before, .vsblog-grid-section-wrap *::after {
    box-sizing: border-box;
  }

  .vsblog-grid-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media (min-width: 768px) {
    .vsblog-grid-container {
      padding: 0 20px;
    }
  }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ec5c0a;
    margin-bottom: 14px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.3), transparent);
  }

  /* ─── TWO-COL LAYOUT (GRID + SIDEBAR) ─── */
  .vsblog-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
    width: 100%;
  }

  @media (min-width: 1040px) {
    .vsblog-two-col { grid-template-columns: 1fr 330px; gap: 28px; }
  }

  /* ─── ARTICLE GRID CARDS ─── */
  .vsblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .vsblog-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  }

  .vsblog-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.035);
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    width: 100%;
  }

  .vsblog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ec5c0a 0%, #ff7b00 50%, #007b3e 100%);
    opacity: 0.85;
    z-index: 5;
    transition: opacity 0.25s ease, height 0.25s ease;
  }

  .vsblog-card:active {
    transform: scale(0.985);
  }

  .vsblog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(236, 92, 10, 0.12), 0 4px 12px rgba(0, 0, 0, 0.04);
    border-color: rgba(236, 92, 10, 0.35);
  }

  .vsblog-card:hover::before {
    height: 4px;
    opacity: 1;
  }

  .vsblog-card-img {
    position: relative;
    height: 220px;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .vsblog-card-img { height: 235px; }
  }

  @media (min-width: 1040px) {
    .vsblog-card-img { height: 250px; }
  }

  .vsblog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-card:hover .vsblog-card-img img {
    transform: scale(1.06);
  }

  .vsblog-thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsblog-card-cat-badge {
    display: none !important;
  }

  .vsblog-card-readtime-badge {
    display: none !important;
  }

  .vsblog-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 1040px) {
    .vsblog-card-body { padding: 18px 18px 16px 18px; }
  }

  .vsblog-card-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 8px 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.2s;
    min-height: 40px;
  }

  .vsblog-card-title:hover { color: #ec5c0a; }

  .vsblog-card-excerpt {
    font-size: 12.5px;
    color: #64748b;
    line-height: 1.5;
    font-weight: 400;
    margin: 0 0 14px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
    min-height: 38px;
  }

  .vsblog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
    gap: 8px;
  }

  .vsblog-card-date {
    font-size: 11px;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .vsblog-card-date i { color: #ec5c0a; }

  .vsblog-card-btn {
    font-size: 11.5px;
    font-weight: 700;
    color: #ec5c0a;
    background: #fff0e5;
    border: 1px solid rgba(236, 92, 10, 0.24);
    padding: 6px 14px;
    border-radius: 50px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.22s ease;
  }

  .vsblog-card-btn:hover {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.32);
  }

  /* ─── SIDEBAR WIDGETS ─── */
  .vsblog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
  }

  @media (min-width: 1040px) {
    .vsblog-sidebar { position: sticky; top: 100px; gap: 20px; }
  }

  .vsblog-sidebar-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    border: 1px solid #e2e8f0;
    width: 100%;
  }

  .vsblog-sidebar-heading {
    font-size: 12.5px;
    font-weight: 700;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0 0 12px 0;
    padding-bottom: 10px;
    border-bottom: 1.5px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vsblog-sidebar-heading i { color: #ec5c0a; }

  .vsblog-sidebar-post {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid #f8fafc;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .vsblog-sidebar-post:last-child { border-bottom: none; padding-bottom: 0; }
  .vsblog-sidebar-post:hover { opacity: 0.75; }

  .vsblog-sidebar-post-num {
    width: 26px;
    height: 26px;
    background: linear-gradient(135deg, #fff0e5 0%, #ffe3d1 100%);
    color: #ec5c0a;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11.5px;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(236, 92, 10, 0.12);
  }

  .vsblog-sidebar-post-info h4 {
    font-size: 12.5px;
    font-weight: 600;
    color: #1e293b;
    margin: 0 0 3px 0;
    line-height: 1.35;
  }

  .vsblog-sidebar-post-info span {
    font-size: 11px;
    color: #94a3b8;
    font-weight: 400;
  }

  .vsblog-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .vsblog-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    font-size: 11.5px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.22s;
  }

  .vsblog-tag-pill:hover {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.25);
  }

  /* SIDEBAR FRANCHISE CTA WIDGET */
  .vsblog-sidebar-cta {
    background: linear-gradient(135deg, #fff7ed 0%, #ffe8d6 100%);
    border-radius: 20px;
    padding: 20px 18px;
    text-align: center;
    border: 1.5px solid #ec5c0a;
    position: relative;
    overflow: hidden;
    width: 100%;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.08);
  }

  .vsblog-sidebar-cta-icon {
    width: 44px;
    height: 44px;
    background: #ffffff;
    border: 1.5px solid #ec5c0a;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #ec5c0a;
    margin: 0 auto 12px auto;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.15);
  }

  .vsblog-sidebar-cta h3 {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .vsblog-sidebar-cta p {
    font-size: 12px;
    color: #475569;
    font-weight: 400;
    line-height: 1.45;
    margin: 0 0 16px 0;
  }

  .vsblog-sidebar-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 700;
    padding: 11px 20px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.32);
    width: 100%;
  }
</style>

