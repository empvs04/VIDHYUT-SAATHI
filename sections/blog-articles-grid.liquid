      "id": "cta_desc",
      "label": "Franchise CTA Description",
      "default": "Earn ₹5–6 lakh/month with our exclusive district franchise program. ISO certified, zero royalty!"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Franchise CTA Button Link"
    },
    {
