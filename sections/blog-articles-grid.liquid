{% schema %}
{
  "name": "Blog Articles Grid",
  "tag": "section",
  "class": "vsblog-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "grid_title",
      "label": "Grid Section Title",
      "default": "Latest Articles (11)"
    },
    {
      "type": "text",
      "id": "popular_title",
      "label": "Sidebar Popular Articles Title",
      "default": "Popular Articles"
    },
    {
      "type": "text",
      "id": "topics_title",
      "label": "Sidebar Topics Title",
      "default": "Explore Topics"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Franchise CTA Card Title",
      "default": "Become a Franchise Partner"
    },
    {
