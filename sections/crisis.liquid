/* =========================================================
   ALL 3 CARDS — TRUE 360° ROTATING BORDER
   ========================================================= */

@keyframes vs360Border {
  0% {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  100% {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

  /* MOBILE ONLY: MASTER CONTAINER FOR HERO & STAT CARDS ONLY */
  @media(max-width: 767px) {
    .vs-problem-container {
      background: linear-gradient(160deg, #0A0D09 0%, #0F1A0E 50%, #0A0D09 100%) !important;
      border: none !important;
      border-radius: 26px !important;
      padding: 24px 14px 24px !important;
      margin: 16px 12px 24px !important;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 0 1.5px rgba(247,148,29,0.35) !important;
