<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800;900&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

<style>
  #vs-{{ section.id }} {
    --orange: {{ section.settings.color_orange }};
    --orange2: {{ section.settings.color_orange_dark }};
    --orange3: {{ section.settings.color_orange_light }};
    --green: {{ section.settings.color_green }};
    --green2: {{ section.settings.color_green_dark }};
    --green3: {{ section.settings.color_green_light }};
    --dark: {{ section.settings.color_dark }};
    --text: {{ section.settings.color_text }};
    --muted: {{ section.settings.color_muted }};
    --bg: {{ section.settings.color_bg }};
    --card-bg: {{ section.settings.color_card_bg }};
    --shadow: 0 8px 40px rgba(247,148,29,.15);
  }

  .vs-section-wrapper {
    width: 100%;
    background: var(--bg);
  }

  .vs-section {
    max-width: 1024px;
    width: 100%;
    margin: 0 auto;
    background: var(--bg);
    font-family: 'Nunito', sans-serif;
    position: relative;
    overflow: hidden;
    padding-bottom: 50px;
  }

  /* ambient glows */
  .vs-section::before {
    content: ''; position: absolute; top: -160px; right: -160px;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(247,148,29,.10) 0%, transparent 65%);
    border-radius: 50%; pointer-events: none; z-index: 0;
  }
  .vs-section::after {
    content: ''; position: absolute; bottom: 300px; left: -160px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(62,173,71,.08) 0%, transparent 65%);
    border-radius: 50%; pointer-events: none; z-index: 0;
  }

  /* TOP BAR */
  .vs-top-bar {
    width: 100%; height: 7px;
    background: linear-gradient(90deg, var(--green2) 0%, var(--green) 20%, var(--orange3) 50%, var(--orange) 80%, var(--green2) 100%);
  }

  /* HERO */
  .vs-hero {
    padding: 60px 40px 40px;
    position: relative; z-index: 2;
  }
  @media(min-width: 768px) { .vs-hero { padding: 60px 72px 40px; } }

  .vs-hero-label {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(90deg, #FFF3E0 0%, #E8F5E9 100%) !important;
    border: 1.5px solid rgba(247,148,29,.35) !important;
    border-radius: 50px; padding: 6px 20px; margin-bottom: 18px;
    box-shadow: 0 4px 14px rgba(247,148,29,0.12) !important;
  }
  .vs-hero-label span {
    font-family: 'Baloo 2', sans-serif; font-size: 12px; font-weight: 800;
    letter-spacing: 2.5px; text-transform: uppercase; color: #E07810 !important;
  }
  .vs-hero-label .dot {
    width: 8px; height: 8px; background: #F7941D; border-radius: 50%;
    box-shadow: 0 0 8px rgba(247,148,29,.7); animation: vsPulse 2s ease-in-out infinite;
  }
  @keyframes vsPulse {
    0%,100% { transform: scale(1); box-shadow: 0 0 8px rgba(247,148,29,.7); }
    50% { transform: scale(1.5); box-shadow: 0 0 16px rgba(247,148,29,.4); }
  }

  .vs-hero h1 {
    font-family: 'Baloo 2', sans-serif; font-weight: 900;
    line-height: 1.08; color: var(--dark); letter-spacing: -1.5px;
    font-size: 48px; margin: 0;
  }
  @media(min-width: 768px) { .vs-hero h1 { font-size: 68px; } }

  .vs-hero h1 .accent { color: var(--orange); position: relative; display: inline-block; }
  .vs-hero h1 .accent::after {
    content: ''; position: absolute; left: 0; bottom: -4px;
    width: 100%; height: 4px; border-radius: 2px; opacity: .5;
    background: linear-gradient(90deg, var(--orange), var(--orange3));
  }
  .vs-hero-divider {
    margin-top: 22px; width: 100px; height: 5px; border-radius: 999px;
    background: linear-gradient(90deg, #F7941D 0%, #FDB44B 50%, #3EAD47 100%) !important;
    box-shadow: 0 4px 15px rgba(247,148,29,0.35) !important;
  }

  /* TOWER SVG */
  .vs-hero-illustration {
    position: absolute; top: 30px; right: 20px;
    width: 120px; height: 180px; opacity: .13; z-index: 1; color: var(--orange);
  }
  @media(min-width: 768px) {
    .vs-hero-illustration { right: 55px; width: 200px; height: 260px; }
  }
  .vs-hero-illustration svg { width: 100%; height: 100%; object-fit: contain; }

  /* STATS GRID - LUCRATIVE BRAND THEME REDESIGN */
  .vs-stats-grid {
    display: grid; gap: 22px; padding: 0 20px;
    position: relative; z-index: 2; margin-top: 10px;
    grid-template-columns: 1fr;
  }
  @media(min-width: 768px) {
    .vs-stats-grid { grid-template-columns: repeat(3, 1fr) !important; padding: 0 72px !important; }
  }

  .vs-stat-card {
    background: #FFFFFF !important;
    border-radius: 22px !important;
    padding: 30px 22px !important;
    box-shadow: 0 12px 35px rgba(247,148,29,0.08), 0 2px 8px rgba(0,0,0,0.02) !important;
    border: 1.5px solid rgba(247, 148, 29, 0.25) !important;
    position: relative !important; 
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    justify-content: center !important;
    transition: transform .35s ease, box-shadow .35s ease !important;
  }
  .vs-stat-card::before {
    content: '' !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 5px !important;
  }
  .vs-stat-card.style-orange::before {
    background: linear-gradient(90deg, #F7941D 0%, #FDB44B 100%) !important;
  }
  .vs-stat-card.style-green::before {
    background: linear-gradient(90deg, #3EAD47 0%, #6DD47A 100%) !important;
  }
  .vs-stat-card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 20px 45px rgba(247,148,29,0.18) !important;
  }

  @media(min-width: 769px) {
    .vs-problem-container {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 44px !important;
      max-width: 1160px !important;
      margin: 0 auto 40px auto !important;
      padding: 48px 40px !important;
      background: linear-gradient(180deg, #FFF9F3 0%, #FFFFFF 100%) !important;
      border-radius: 28px !important;
      border: 1.5px solid rgba(236, 92, 10, 0.28) !important;
      box-shadow: 0 20px 50px rgba(236, 92, 10, 0.08) !important;
      width: 100% !important;
    }

    .vs-hero {
      flex: 0 0 48% !important;
      max-width: 540px !important;
      width: 48% !important;
      text-align: left !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      margin: 0 !important;
    }

    .vs-hero h1 {
      color: #0F172A !important;
      font-size: 42px !important;
      text-align: left !important;
      font-weight: 900 !important;
      letter-spacing: -0.8px !important;
      line-height: 1.18 !important;
      margin-bottom: 16px !important;
    }

    .vs-hero h1 .accent {
      background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      filter: drop-shadow(0 4px 12px rgba(236, 92, 10, 0.2)) !important;
    }
    .vs-hero h1 .accent::after { display: none !important; }

    .vs-hero-divider {
      margin-left: 0 !important;
      margin-right: 0 !important;
      width: 100px !important;
      height: 5px !important;
      margin-bottom: 24px !important;
    }

    .vs-hero-label {
      background: linear-gradient(135deg, #FFF3EB 0%, #FFE8D6 100%) !important;
      border: 1.5px solid rgba(236, 92, 10, 0.4) !important;
      padding: 6px 20px !important;
      border-radius: 50px !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      margin-bottom: 16px !important;
      box-shadow: 0 4px 15px rgba(236, 92, 10, 0.12) !important;
    }
    .vs-hero-label span { color: #EC5C0A !important; font-weight: 800 !important; font-size: 13px !important; letter-spacing: 1.2px !important; }

    .vs-stats-grid {
      flex: 0 0 48% !important;
      max-width: 520px !important;
      width: 48% !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 18px !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .vs-stats-grid .vs-stat-card {
      background: #FFFFFF !important;
      border: 1.5px solid rgba(236, 92, 10, 0.2) !important;
      border-left: 6px solid #EC5C0A !important;
      border-top: none !important;
      border-radius: 20px !important;
      padding: 20px 24px !important;
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 18px !important;
      text-align: left !important;
      min-height: auto !important;
      box-shadow: 0 12px 30px rgba(236, 92, 10, 0.06) !important;
      transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    }

    .vs-stats-grid .vs-stat-card:hover {
      transform: translateX(8px) !important;
      border-color: rgba(236, 92, 10, 0.5) !important;
      height: 54px !important;
      border-radius: 16px !important;
      background: linear-gradient(135deg, #FFF3E0, #FFE0B2) !important;
      color: #EC5C0A !important;
      box-shadow: 0 6px 18px rgba(236, 92, 10, 0.2) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin-bottom: 14px !important;
    }

    .vs-stat-card.style-orange .vs-stat-value,
    .vs-stat-card.style-green .vs-stat-value {
      background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      filter: drop-shadow(0 4px 12px rgba(236, 92, 10, 0.2)) !important;
      font-size: 38px !important;
      font-weight: 900 !important;
      line-height: 1.1 !important;
      margin-bottom: 8px !important;
    }

    .vs-stat-card.style-orange .vs-stat-desc,
    .vs-stat-card.style-green .vs-stat-desc {
      color: #334155 !important;
      font-size: 14.5px !important;
      font-weight: 600 !important;
      line-height: 1.45 !important;
    }
  }

  .vs-card-glow { display: none !important; }

  .vs-stat-icon-wrap {
    width: 60px !important;
    height: 60px !important;
    border-radius: 18px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 auto 16px auto !important;
    position: relative !important;
    z-index: 1 !important;
  }
  .vs-stat-card.style-orange .vs-stat-icon-wrap {
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2) !important;
    color: #F7941D !important;
    box-shadow: 0 8px 20px rgba(247,148,29,0.22) !important;
  }
  .vs-stat-card.style-green .vs-stat-icon-wrap {
    background: linear-gradient(135deg, #E8F5E9, #C8E6C9) !important;
    color: #3EAD47 !important;
    box-shadow: 0 8px 20px rgba(62,173,71,0.22) !important;
  }
  .vs-stat-icon-wrap svg { width: 30px !important; height: 30px !important; }

  .vs-stat-value {
    font-family: 'Baloo 2', sans-serif !important;
    font-size: 40px !important;
    font-weight: 900 !important;
    line-height: 1.1 !important;
    margin-bottom: 10px !important;
    letter-spacing: -0.5px !important;
  }
  .vs-stat-card.style-orange .vs-stat-value {
