      font-size: 28px !important;
      text-align: center !important;
      color: #FFFFFF !important;
    }
    .vs-hero h1 .accent {
      background: linear-gradient(135deg, #FDB44B 0%, #F7941D 50%, #FFD700 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
    .vs-hero h1 .accent::after { display: none !important; }

    .vs-stats-grid {
      display: flex !important;
      grid-template-columns: none !important;
      flex-direction: column !important;
      flex-wrap: nowrap !important;
      overflow: visible !important;
      scroll-snap-type: none !important;
      gap: 16px !important;
      padding: 10px 0 0 0 !important;
      width: 100% !important;
    }
    .vs-stats-grid::-webkit-scrollbar {
      display: none !important;
    }

    .vs-stat-card .vs-card-glow {
      display: none !important;
    }

    /* Every card gets its own rotating border */
    .vs-stats-grid .vs-stat-card {
      position: relative !important;
      isolation: isolate !important;
      overflow: hidden !important;

      border: none !important;
      border-radius: 20px !important;

      background: transparent !important;

      width: 100% !important;
      box-sizing: border-box !important;
      padding: 22px 18px !important;
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 12px 32px rgba(255, 138, 0, 0.15), 0 0 20px rgba(22, 184, 78, 0.12) !important;
    }

    /* ROTATING 360° ORANGE BORDER — ORANGE CARDS */
    .vs-stats-grid .vs-stat-card.style-orange::before {
      content: "" !important;
      position: absolute !important;
      width: 200% !important;
      height: 200% !important;
      top: 50% !important;
      left: 50% !important;
      transform: translate(-50%, -50%) rotate(0deg);
      background: conic-gradient(
        #FF8A00 0deg, #FFC107 80deg, #FF8A00 160deg,
        #FF4500 220deg, #FFC107 300deg, #FF8A00 360deg
      ) !important;
      animation: vs360Border 3.5s linear infinite !important;
      border-radius: 30px !important;
      z-index: -2 !important;
      pointer-events: none !important;
    }
    /* ROTATING 360° GREEN BORDER — GREEN CARD */
    .vs-stats-grid .vs-stat-card.style-green::before {
      content: "" !important;
      position: absolute !important;
      width: 200% !important;
      height: 200% !important;
      top: 50% !important;
      left: 50% !important;
      transform: translate(-50%, -50%) rotate(0deg);
      background: conic-gradient(
        #16B84E 0deg, #22C55E 80deg, #3EAD47 160deg,
        #16B84E 220deg, #10B981 300deg, #16B84E 360deg
      ) !important;
      animation: vs360Border 4s linear infinite !important;
      border-radius: 30px !important;
      z-index: -2 !important;
      pointer-events: none !important;
    }

    /* INNER CARD — LEAVES 2PX NEON BORDER VISIBLE */
    .vs-stats-grid .vs-stat-card::after {
      content: "" !important;
      position: absolute !important;
      top: 2px !important;
      right: 2px !important;
      bottom: 2px !important;
      left: 2px !important;
      border-radius: 18px !important;
      z-index: -1 !important;
      pointer-events: none !important;
    }

    /* Green card — dark forest glass */
    .vs-stats-grid .vs-stat-card.style-green::after {
      background: linear-gradient(160deg, #071209 0%, #050E07 60%, #030A04 100%) !important;
    }

    /* Orange card — dark amber glass */
    .vs-stats-grid .vs-stat-card.style-orange::after {
      background: linear-gradient(160deg, #1A0E00 0%, #140A00 60%, #0F0800 100%) !important;
    }

    /* ALL CONTENT ABOVE BORDER */
    .vs-stats-grid .vs-stat-card > * {
      position: relative !important;
      z-index: 3 !important;
    }

    /* EACH CARD STARTS AT DIFFERENT ROTATION BUT ALL COMPLETE 360° */
    .vs-stats-grid .vs-stat-card:nth-child(1)::before {
      animation: vs360Border 4s linear infinite !important;
      animation-delay: 0s !important;
    }

    .vs-stats-grid .vs-stat-card:nth-child(2)::before {
      animation: vs360Border 4s linear infinite !important;
      animation-delay: -1.33s !important;
    }

    .vs-stats-grid .vs-stat-card:nth-child(3)::before {
      animation: vs360Border 4s linear infinite !important;
      animation-delay: -2.66s !important;
    }

    .vs-stat-icon-wrap,
