<script>
  (function() {
    function initGalleryShowcase() {
      const sectionId = '{{ section.id }}';
      const sectionWrapper = document.getElementById(`vsg-mosaic-${sectionId}`);
      if (!sectionWrapper) return;

      const filterBtns = sectionWrapper.querySelectorAll('.vsg-filter-btn');
      const cards = sectionWrapper.querySelectorAll('.vsg-card-item');
      
      const lightbox = document.getElementById(`vsgLightbox-${sectionId}`);
      const lbImg = document.getElementById(`vsgLightboxImg-${sectionId}`);
      const lbClose = document.getElementById(`vsgLightboxClose-${sectionId}`);

      // 1. Dynamic Height Sync for Top 4-Card Hero
      function syncHeroHeights() {
        const heroGrid = document.getElementById(`vsgHeroGrid-${sectionId}`);
        if (heroGrid) {
          const leftCol = heroGrid.querySelector('.vsg-col-left');
          const rightCol = heroGrid.querySelector('.vsg-col-right');
          const centerCol = heroGrid.querySelector('.vsg-col-center');
          if (leftCol && rightCol && centerCol) {
            if (window.innerWidth > 900) {
              const centerHeight = centerCol.offsetHeight;
              if (centerHeight > 0) {
                leftCol.style.height = centerHeight + 'px';
                rightCol.style.height = centerHeight + 'px';
              }
            } else {
              leftCol.style.height = '';
              rightCol.style.height = '';
            }
          }
        }
      }

      window.addEventListener('resize', syncHeroHeights);
      window.addEventListener('load', syncHeroHeights);
      setTimeout(syncHeroHeights, 100);
      setTimeout(syncHeroHeights, 400);
      setTimeout(syncHeroHeights, 1000);

      // 2. Real-Time 2D Multi-Directional Bouncing Physics Engine for Smiley Balls
      const arena = document.getElementById(`vsgPhysicsArena-${sectionId}`);
      if (arena) {
        const ballEls = arena.querySelectorAll('.vsg-physics-ball');
        const balls = [];
        
        function initBalls() {
          const arenaWidth = arena.clientWidth || 1200;
          const arenaHeight = arena.clientHeight || 180;
          const ballSize = ballEls[0] ? (ballEls[0].offsetWidth || 80) : 80;

          ballEls.forEach((el, index) => {
            // Distribute initial positions evenly across arena width
            const initialX = Math.min(arenaWidth - ballSize, (index * (arenaWidth / ballEls.length)) + 15);
            const initialY = Math.random() * (arenaHeight - ballSize);
            const baseVx = parseFloat(el.getAttribute('data-vx')) || (Math.random() > 0.5 ? 2 : -2);
            const baseVy = parseFloat(el.getAttribute('data-vy')) || (Math.random() > 0.5 ? 2.2 : -2.2);
            const rotSpeed = parseFloat(el.getAttribute('data-rot')) || 1.5;

            balls[index] = {
              el: el,
              x: initialX,
              y: initialY,
              vx: baseVx,
              vy: baseVy,
              angle: Math.random() * 360,
              rotSpeed: rotSpeed,
              width: ballSize,
              height: ballSize,
              isDragging: false
            };
          });
        }

        initBalls();
        window.addEventListener('resize', initBalls);

        // Physics Animation Loop
        let animationId;
        function updatePhysics() {
          const arenaWidth = arena.clientWidth || 1200;
          const arenaHeight = arena.clientHeight || 180;

          balls.forEach(ball => {
            if (ball.isDragging) return;

            // Move in 2D space
            ball.x += ball.x_speed_mult ? ball.vx * ball.x_speed_mult : ball.vx;
            ball.y += ball.y_speed_mult ? ball.vy * ball.y_speed_mult : ball.vy;
            ball.angle += ball.rotSpeed;

            // Collision with TOP CARDS boundary (touches bottom edge of cards 11, 12, 13)
            if (ball.y <= 0) {
              ball.y = 0;
              ball.vy = Math.abs(ball.vy); // Rebound downwards!
              ball.rotSpeed = (Math.random() - 0.5) * 4;
              ball.el.style.boxShadow = '0 0 25px rgba(236, 92, 10, 0.9), inset 0 0 15px #ffffff';
              setTimeout(() => { ball.el.style.boxShadow = ''; }, 200);
            }

            // Collision with BOTTOM CARDS boundary (touches top edge of cards 14, 15, 16)
            if (ball.y >= (arenaHeight - ball.height)) {
              ball.y = arenaHeight - ball.height;
              ball.vy = -Math.abs(ball.vy); // Rebound upwards!
              ball.rotSpeed = (Math.random() - 0.5) * 4;
              ball.el.style.boxShadow = '0 0 25px rgba(0, 123, 62, 0.9), inset 0 0 15px #ffffff';
              setTimeout(() => { ball.el.style.boxShadow = ''; }, 200);
            }

            // Collision with LEFT wall
            if (ball.x <= 0) {
              ball.x = 0;
              ball.vx = Math.abs(ball.vx); // Rebound right
            }

            // Collision with RIGHT wall
            if (ball.x >= (arenaWidth - ball.width)) {
              ball.x = arenaWidth - ball.width;
              ball.vx = -Math.abs(ball.vx); // Rebound left
            }

            // Apply positions
            ball.el.style.left = ball.x + 'px';
            ball.el.style.top = ball.y + 'px';
            ball.el.style.transform = `rotate(${ball.angle}deg)`;
          });

          animationId = requestAnimationFrame(updatePhysics);
        }

        updatePhysics();

        // Interactive Click & Drag & Hover Boost
        ballEls.forEach((el, index) => {
          el.addEventListener('mouseenter', function() {
            if (balls[index]) {
              // Energetic bounce on hover
              balls[index].vx *= 1.35;
              balls[index].vy *= 1.35;
              balls[index].rotSpeed *= 2;
              setTimeout(() => {
                if (balls[index]) {
                  balls[index].vx = (balls[index].vx > 0 ? 1 : -1) * (1.8 + Math.random() * 0.8);
                  balls[index].vy = (balls[index].vy > 0 ? 1 : -1) * (2.0 + Math.random() * 0.8);
                  balls[index].rotSpeed = (Math.random() - 0.5) * 3;
                }
              }, 800);
            }
          });

          // Pointer Touch Drag & Throw Interaction
          let isDown = false;
          let startX, startY;

          el.addEventListener('pointerdown', function(e) {
            if (!balls[index]) return;
            isDown = true;
            balls[index].isDragging = true;
            startX = e.clientX - balls[index].x;
            startY = e.clientY - balls[index].y;
            el.setPointerCapture(e.pointerId);
          });

          el.addEventListener('pointermove', function(e) {
            if (!isDown || !balls[index]) return;
            const newX = e.clientX - startX;
            const newY = e.clientY - startY;
            balls[index].vx = (newX - balls[index].x) * 0.4;
            balls[index].vy = (newY - balls[index].y) * 0.4;
            balls[index].x = newX;
            balls[index].y = newY;
            el.style.left = newX + 'px';
            el.style.top = newY + 'px';
          });

          el.addEventListener('pointerup', function(e) {
            if (!isDown || !balls[index]) return;
            isDown = false;
            balls[index].isDragging = false;
            el.releasePointerCapture(e.pointerId);
          });
        });
      }

      // Category Filtering Logic
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          filterBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          const filter = this.getAttribute('data-filter');

          cards.forEach(card => {
            const cat = card.getAttribute('data-category') || 'all';
            if (filter === 'all' || cat === filter || cat === 'all') {
              card.style.opacity = '1';
              card.style.filter = 'none';
              card.style.pointerEvents = 'auto';
            } else {
              card.style.opacity = '0.18';
              card.style.filter = 'grayscale(85%)';
              card.style.pointerEvents = 'none';
            }
          });
          syncHeroHeights();
        });
      });

      // Lightbox Click Handler
      cards.forEach(card => {
        card.addEventListener('click', function() {
          const img = this.querySelector('.vsg-card-img');
          if (!img) return;

          lbImg.src = img.src;
          lbImg.alt = img.alt || '';
          
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeLightbox() {
        if (lightbox) {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
        }
      }

      if (lbClose) lbClose.addEventListener('click', closeLightbox);
      if (lightbox) {
        lightbox.addEventListener('click', function(e) {
          if (e.target === lightbox) closeLightbox();
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGalleryShowcase);
    } else {
      initGalleryShowcase();
    }
  })();
</script>

