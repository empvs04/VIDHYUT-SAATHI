<!-- FULLSCREEN LIGHTBOX MODAL DIALOG -->
<div class="vsg-lightbox" id="vsgLightbox-{{ section.id }}">
  <div class="vsg-lightbox-content">
    <button type="button" class="vsg-lightbox-close" id="vsgLightboxClose-{{ section.id }}">&times;</button>
    <div class="vsg-lightbox-img-box">
      <img src="" alt="" class="vsg-lightbox-img" id="vsgLightboxImg-{{ section.id }}">
    </div>
  </div>
</div>

<script>
  (function() {
    function initGalleryShowcase() {
      const sectionId = '{{ section.id }}';
      const sectionWrapper = document.getElementById(`vsg-mosaic-${sectionId}`);
      if (!sectionWrapper) return;

      const filterBtns = sectionWrapper.querySelectorAll('.vsg-filter-btn');
      const cards = sectionWrapper.querySelectorAll('.vsg-card-item');
      
      const lightbox = document.getElementById(`vsgLightbox-${sectionId}`);
      const lbImg = document.getElementById(`vsgLightboxImg-${sectionId}`);
      const lbClose = document.getElementById(`vsgLightboxClose-${sectionId}`);

      // Dynamic Height Sync for Top 4-Card Hero
      function syncHeroHeights() {
        const heroGrid = document.getElementById(`vsgHeroGrid-${sectionId}`);
        if (heroGrid) {
          const leftCol = heroGrid.querySelector('.vsg-col-left');
          const rightCol = heroGrid.querySelector('.vsg-col-right');
          const centerCol = heroGrid.querySelector('.vsg-col-center');
          if (leftCol && rightCol && centerCol) {
            if (window.innerWidth > 900) {
              const centerHeight = centerCol.offsetHeight;
              if (centerHeight > 0) {
                leftCol.style.height = centerHeight + 'px';
                rightCol.style.height = centerHeight + 'px';
              }
            } else {
              leftCol.style.height = '';
              rightCol.style.height = '';
            }
          }
        }
      }

      window.addEventListener('resize', syncHeroHeights);
      window.addEventListener('load', syncHeroHeights);
      setTimeout(syncHeroHeights, 100);
      setTimeout(syncHeroHeights, 400);
      setTimeout(syncHeroHeights, 1000);

      // Category Filtering Logic
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          filterBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          const filter = this.getAttribute('data-filter');

          cards.forEach(card => {
            const cat = card.getAttribute('data-category') || 'all';
            if (filter === 'all' || cat === filter || cat === 'all') {
              card.style.opacity = '1';
              card.style.filter = 'none';
              card.style.pointerEvents = 'auto';
            } else {
              card.style.opacity = '0.18';
              card.style.filter = 'grayscale(85%)';
              card.style.pointerEvents = 'none';
            }
          });
          syncHeroHeights();
        });
      });

      // Lightbox Click Handler
      cards.forEach(card => {
        card.addEventListener('click', function() {
          const img = this.querySelector('.vsg-card-img');
          if (!img) return;

          lbImg.src = img.src;
          lbImg.alt = img.alt || '';
          
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeLightbox() {
        if (lightbox) {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
        }
      }

      if (lbClose) lbClose.addEventListener('click', closeLightbox);
      if (lightbox) {
        lightbox.addEventListener('click', function(e) {
          if (e.target === lightbox) closeLightbox();
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGalleryShowcase);
    } else {
      initGalleryShowcase();
    }
  })();
</script>

