<script>
(function(){
  /* ---- TAB SWITCHING ---- */
  var tabButtons = document.querySelectorAll('.vscc-scenarios-sec .tab-btn');
  var panels = document.querySelectorAll('.vscc-scenarios-sec .eg-panel');

  tabButtons.forEach(function(btn){
    btn.addEventListener('click', function(){
      tabButtons.forEach(function(b){ b.classList.remove('active'); });
      panels.forEach(function(p){ p.classList.remove('active'); });
      
      btn.classList.add('active');
      var target = btn.getAttribute('data-vscc-tab');
      var activeP = document.querySelector('.vscc-scenarios-sec .eg-panel[data-vscc-panel="' + target + '"]');
      if(activeP){
        activeP.classList.add('active');
        vsccUpdateCardSlider(target);
      }
    });
  });

  /* ---- IN-CARD 4-IMAGE SLIDER CONTROLLER ---- */
  var vsccSliderIndex = {
    res: 0,
    com: 0,
    ind: 0,
    inst: 0
  };

  window.vsccGoCardImg = function(panelKey, idx) {
    vsccSliderIndex[panelKey] = (idx + 4) % 4;
    vsccUpdateCardSlider(panelKey);
  };

  window.vsccPrevCardImg = function(panelKey) {
    vsccSliderIndex[panelKey] = (vsccSliderIndex[panelKey] - 1 + 4) % 4;
    vsccUpdateCardSlider(panelKey);
  };

  window.vsccNextCardImg = function(panelKey) {
    vsccSliderIndex[panelKey] = (vsccSliderIndex[panelKey] + 1) % 4;
    vsccUpdateCardSlider(panelKey);
  };

  function vsccUpdateCardSlider(panelKey) {
    var panel = document.querySelector('.vscc-scenarios-sec .eg-panel[data-vscc-panel="' + panelKey + '"]');
    if (!panel) return;
    var track = panel.querySelector('.eg-slide-track');
    var badge = panel.querySelector('.eg-slider-badge-count');
    var dots = panel.querySelectorAll('.eg-slider-pill-dot');
    var cur = vsccSliderIndex[panelKey] || 0;
    
    if (track) {
      track.style.transform = 'translateX(-' + (cur * 100) + '%)';
    }
    if (badge) {
      badge.textContent = (cur + 1) + ' / 4';
    }
    dots.forEach(function(dot, i) {
      if (i === cur) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  // Touch Swipe for in-card image sliders
  document.querySelectorAll('.vscc-scenarios-sec .eg-slider-container').forEach(function(container) {
    var touchStartX = 0;
    var touchEndX = 0;
    var panel = container.closest('.eg-panel');
    if (!panel) return;
    var key = panel.getAttribute('data-vscc-panel');

    container.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, {passive: true});

    container.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 35) {
        if (diff > 0) {
          vsccNextCardImg(key);
        } else {
          vsccPrevCardImg(key);
        }
      }
    }, {passive: true});
  });

  // Auto-play active in-card image slider every 3.5s
  setInterval(function() {
    var activePanel = document.querySelector('.vscc-scenarios-sec .eg-panel.active');
    if (activePanel) {
      var key = activePanel.getAttribute('data-vscc-panel');
      if (key && vsccSliderIndex.hasOwnProperty(key)) {
        vsccSliderIndex[key] = (vsccSliderIndex[key] + 1) % 4;
        vsccUpdateCardSlider(key);
      }
    }
  }, 3500);
})();
</script>

