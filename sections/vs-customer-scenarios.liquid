}

.vscc-scenarios-sec .eg-slide-item {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  position: relative;
}

.vscc-scenarios-sec .eg-slide-item img {
  width: 100%;
  height: 100%;
