  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.vscc-scenarios-sec .eg-card-showcase::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32px;
  right: 32px;
  height: 3px;
  background: linear-gradient(90deg, transparent 0%, #f97316 50%, transparent 100%);
  border-radius: 50px;
}
.vscc-scenarios-sec .eg-card-showcase:hover {
  border-color: #f97316;
  box-shadow: 0 22px 50px -10px rgba(240, 99, 27, 0.2);
}

