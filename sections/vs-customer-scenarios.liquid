  var panels = sec.querySelectorAll('.eg-panel');

  tabBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      var tab = this.getAttribute('data-tab');
      tabBtns.forEach(function(b){
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function(p){
        p.classList.remove('active');
      });

      this.classList.add('active');
      this.setAttribute('aria-selected', 'true');

      var activePanel = sec.querySelector('#eg-panel-' + tab);
      if(activePanel){
        activePanel.classList.add('active');
      }
    });
  });

  /* In-Card 4-Image Slider Controller (Independent for each slider) */
  var sliders = sec.querySelectorAll('.card-slider-wrapper');
  sliders.forEach(function(slider){
    var track = slider.querySelector('.slider-track');
    var slides = slider.querySelectorAll('.slider-slide');
    var dots = slider.querySelectorAll('.slider-dot');
    var counterEl = slider.querySelector('.cur-idx');
    var btnPrev = slider.querySelector('.btn-prev');
    var btnNext = slider.querySelector('.btn-next');
    var total = slides.length;
    var current = 0;
    var autoTimer = null;

    if(total <= 1) return;

    function goTo(index){
      if(index < 0) index = total - 1;
      if(index >= total) index = 0;
      current = index;

      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      if(counterEl) counterEl.textContent = current + 1;

      dots.forEach(function(dot, i){
        if(i === current){
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    if(btnPrev){
      btnPrev.addEventListener('click', function(e){
        e.preventDefault();
        goTo(current - 1);
        resetAuto();
      });
    }

    if(btnNext){
      btnNext.addEventListener('click', function(e){
        e.preventDefault();
        goTo(current + 1);
        resetAuto();
      });
    }

    dots.forEach(function(dot){
      dot.addEventListener('click', function(){
        var idx = parseInt(this.getAttribute('data-index'), 10);
        goTo(idx);
        resetAuto();
      });
    });

    /* Touch Swipe */
    var touchStartX = 0;
    var touchEndX = 0;
    var viewport = slider.querySelector('.slider-viewport');
    if(viewport){
      viewport.addEventListener('touchstart', function(e){
        touchStartX = e.changedTouches[0].screenX;
      }, {passive: true});

      viewport.addEventListener('touchend', function(e){
        touchEndX = e.changedTouches[0].screenX;
        var diff = touchStartX - touchEndX;
        if(Math.abs(diff) > 40){
          if(diff > 0){
            goTo(current + 1);
          } else {
            goTo(current - 1);
          }
          resetAuto();
        }
      }, {passive: true});
    }

    /* Auto Rotation */
    function startAuto(){
      autoTimer = setInterval(function(){
        goTo(current + 1);
      }, 5000);
    }
    function resetAuto(){
      if(autoTimer) clearInterval(autoTimer);
      startAuto();
    }

    slider.addEventListener('mouseenter', function(){
      if(autoTimer) clearInterval(autoTimer);
    });
    slider.addEventListener('mouseleave', function(){
      resetAuto();
    });

    startAuto();
  });
})();
</script>

