}
.vscc-scenarios-sec .eg-panel.active {
  display: block !important;
  animation: vsccFadeIn 0.35s ease;
}

@keyframes vsccFadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

/* In-Card Showcase Layout */
.vscc-scenarios-sec .eg-card-showcase {
  max-width: 980px;
  margin: 0 auto;
  background: linear-gradient(180deg, #ffffff 0%, #fffdfa 100%);
  border: 1.5px solid #fed7aa;
  border-radius: 24px;
  padding: 24px;
