{%- comment -%}
  Vidhyut Saathi - Full Width Clickable Responsive Banner Section (Desktop & Mobile)
  File: sections/image.liquid
{%- endcomment -%}

<style>
  .vs-responsive-banner-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    background-color: {{ section.settings.bg_color | default: 'transparent' }};
    padding-top: {{ section.settings.padding_top_desk | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desk | default: 0 }}px;
    margin: 0 !important;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .vs-responsive-banner-{{ section.id }} .banner-inner-wrap {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  {% if section.settings.section_heading != blank %}
    .vs-responsive-banner-{{ section.id }} .section-header {
      text-align: center;
      margin-bottom: 20px;
      padding: 0 16px;
    }
    .vs-responsive-banner-{{ section.id }} .section-header h2 {
      font-family: 'Baloo 2', 'Outfit', sans-serif;
      font-size: 26px;
      font-weight: 800;
      color: #0F172A;
      margin: 0;
    }
  {% endif %}

  .vs-responsive-banner-{{ section.id }} .banners-outer-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    border-radius: {{ section.settings.border_radius_desk | default: 0 }}px;
    overflow: hidden;
    background: transparent;
  }

  .vs-responsive-banner-{{ section.id }} .banners-wrapper {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 0px;
    padding: 0;
    margin: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    width: 100%;
  }

  .vs-responsive-banner-{{ section.id }} .banners-wrapper::-webkit-scrollbar {
    display: none;
  }

  .vs-responsive-banner-{{ section.id }} .banner-item {
    flex: 0 0 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    width: 100% !important;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    border-radius: 0;
    margin: 0;
    padding: 0;
    position: relative;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
  }

  .vs-responsive-banner-{{ section.id }} .banner-picture {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .vs-responsive-banner-{{ section.id }} .banner-img {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    max-height: 85vh;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    border-radius: 0 !important;
    background: transparent !important;
    transition: transform 0.4s ease;
  }

  .vs-responsive-banner-{{ section.id }} .banner-item:hover .banner-img {
    {% if section.settings.enable_hover_zoom %}
      transform: scale(1.015);
    {% endif %}
  }

  .vs-responsive-banner-{{ section.id }} .banner-placeholder {
    width: 100%;
    min-height: 380px;
    background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    text-align: center;
    color: #E07810;
    border: 2px dashed rgba(236, 92, 10, 0.35);
  }

  .vs-responsive-banner-{{ section.id }} .banner-placeholder svg {
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
  }

  .vs-responsive-banner-{{ section.id }} .banner-placeholder span {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: 16px;
    font-weight: 800;
  }

  /* Slider Navigation Arrows */
  .vs-responsive-banner-{{ section.id }} .vs-banner-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 12;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #0F172A;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    transition: all 0.3s ease;
    opacity: 0.85;
  }

  .vs-responsive-banner-{{ section.id }} .vs-banner-nav:hover {
    background: #FFFFFF;
    color: #EC5C0A;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 22px rgba(236, 92, 10, 0.35);
    opacity: 1;
  }

  .vs-responsive-banner-{{ section.id }} .vs-prev-btn { left: 24px; }
  .vs-responsive-banner-{{ section.id }} .vs-next-btn { right: 24px; }

  /* Navigation Dots */
  .vs-responsive-banner-dots-{{ section.id }} {
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    margin: 0;
    padding: 0;
    gap: 8px;
  }

  .vs-responsive-banner-dots-{{ section.id }} .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(0, 0, 0, 0.25);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .vs-responsive-banner-dots-{{ section.id }} .dot.active {
    background: #EC5C0A;
    border-color: #FFFFFF;
    transform: scale(1.3);
    box-shadow: 0 2px 8px rgba(236, 92, 10, 0.6);
  }

  /* Mobile Responsive */
  @media(max-width: 767px) {
    .vs-responsive-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mob | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mob | default: 0 }}px;
    }

    .vs-responsive-banner-{{ section.id }} .banners-outer-container {
      border-radius: {{ section.settings.border_radius_mob | default: 0 }}px;
    }

    .vs-responsive-banner-{{ section.id }} .banner-img {
      max-height: none !important;
    }

    .vs-responsive-banner-{{ section.id }} .vs-banner-nav {
      display: none !important;
    }

    .vs-responsive-banner-dots-{{ section.id }} {
      bottom: 12px;
      gap: 6px;
    }
  }
</style>

<div class="vs-responsive-banner-{{ section.id }}" id="vs-responsive-banner-{{ section.id }}">
  <div class="banner-inner-wrap">
    {% if section.settings.section_heading != blank %}
      <div class="section-header">
        <h2>{{ section.settings.section_heading }}</h2>
      </div>
    {% endif %}

    {%- assign total_blocks = section.blocks.size -%}

    <div class="banners-outer-container">
      {% if total_blocks > 1 %}
        <button class="vs-banner-nav vs-prev-btn" id="vs-prev-btn-{{ section.id }}" aria-label="Previous Banner">
          <i class="fas fa-chevron-left"></i>
        </button>
      {% endif %}

      <div class="banners-wrapper" id="vs-wrapper-{{ section.id }}">
        {% if total_blocks > 0 %}
          {% for block in section.blocks %}
            <a href="{{ block.settings.banner_link | default: '#' }}" class="banner-item" {{ block.shopify_attributes }}>
              {% if block.settings.banner_image != blank or block.settings.banner_image_mobile != blank %}
                <picture class="banner-picture">
                  {% if block.settings.banner_image_mobile != blank %}
                    <source media="(max-width: 767px)" srcset="{{ block.settings.banner_image_mobile | image_url: width: 1000 }}">
                  {% endif %}
                  {% if block.settings.banner_image != blank %}
                    <source media="(min-width: 768px)" srcset="{{ block.settings.banner_image | image_url: width: 2400 }}">
                  {% endif %}
                  <img 
                    src="{{ block.settings.banner_image_mobile | default: block.settings.banner_image | image_url: width: 1400 }}"
                    alt="{{ block.settings.banner_image.alt | default: block.settings.banner_image_mobile.alt | default: 'Vidhyut Saathi Banner' }}"
                    class="banner-img"
                    loading="lazy"
                    width="1400"
                    height="600"
                  >
                </picture>
              {% else %}
                <div class="banner-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  <span>Upload Desktop & Mobile Banner in Shopify Customizer</span>
                </div>
              {% endif %}
            </a>
          {% endfor %}
        {% else %}
          {% comment %} Fallback to section-level settings if no blocks exist {% endcomment %}
          <a href="{{ section.settings.banner_link | default: '#' }}" class="banner-item">
            {% if section.settings.banner_image != blank or section.settings.banner_image_mobile != blank %}
              <picture class="banner-picture">
                {% if section.settings.banner_image_mobile != blank %}
                  <source media="(max-width: 767px)" srcset="{{ section.settings.banner_image_mobile | image_url: width: 1000 }}">
                {% endif %}
                {% if section.settings.banner_image != blank %}
                  <source media="(min-width: 768px)" srcset="{{ section.settings.banner_image | image_url: width: 2400 }}">
                {% endif %}
                <img 
                  src="{{ section.settings.banner_image_mobile | default: section.settings.banner_image | image_url: width: 1400 }}"
                  alt="{{ section.settings.banner_image.alt | default: section.settings.banner_image_mobile.alt | default: 'Vidhyut Saathi Banner' }}"
                  class="banner-img"
                  loading="lazy"
                  width="1400"
                  height="600"
                >
              </picture>
            {% else %}
              <div class="banner-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <span>Upload Desktop & Mobile Banner in Shopify Customizer</span>
              </div>
            {% endif %}
          </a>
        {% endif %}
      </div>

      {% if total_blocks > 1 %}
        <button class="vs-banner-nav vs-next-btn" id="vs-next-btn-{{ section.id }}" aria-label="Next Banner">
          <i class="fas fa-chevron-right"></i>
        </button>

        <div class="vs-responsive-banner-dots-{{ section.id }}" id="vs-dots-{{ section.id }}">
          {% for block in section.blocks %}
            <span class="dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% if total_blocks > 1 %}
<script>
  (function() {
    function initSlider() {
      const sectionEl = document.getElementById('vs-responsive-banner-{{ section.id }}');
      if (!sectionEl) return;

      const wrapper = document.getElementById('vs-wrapper-{{ section.id }}');
      const prevBtn = document.getElementById('vs-prev-btn-{{ section.id }}');
      const nextBtn = document.getElementById('vs-next-btn-{{ section.id }}');
      const dotsContainer = document.getElementById('vs-dots-{{ section.id }}');
      if (!wrapper) return;

      const dots = dotsContainer ? dotsContainer.querySelectorAll('.dot') : [];
      let autoplayTimer = null;
      const isAutoplay = {{ section.settings.autoplay | default: true }};
      const speed = {{ section.settings.autoplay_speed | default: 4 }} * 1000;

      function updateDots(index) {
        dots.forEach((d, i) => {
          if (i === index) d.classList.add('active');
          else d.classList.remove('active');
        });
      }

      function getActiveIndex() {
        const itemWidth = wrapper.offsetWidth;
        if (!itemWidth) return 0;
        return Math.round(wrapper.scrollLeft / itemWidth);
      }

      function scrollToIndex(idx) {
        const total = wrapper.children.length;
        if (idx < 0) idx = total - 1;
        if (idx >= total) idx = 0;
        wrapper.scrollTo({
          left: idx * wrapper.offsetWidth,
          behavior: 'smooth'
        });
        updateDots(idx);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          scrollToIndex(getActiveIndex() - 1);
          resetAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          scrollToIndex(getActiveIndex() + 1);
          resetAutoplay();
        });
      }

      dots.forEach(dot => {
        dot.addEventListener('click', function() {
          const idx = parseInt(this.getAttribute('data-index'), 10);
          scrollToIndex(idx);
          resetAutoplay();
        });
      });

      wrapper.addEventListener('scroll', function() {
        updateDots(getActiveIndex());
      }, { passive: true });

      function startAutoplay() {
        if (!isAutoplay) return;
        stopAutoplay();
        autoplayTimer = setInterval(function() {
          scrollToIndex(getActiveIndex() + 1);
        }, speed);
      }

      function stopAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
      }

      function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      sectionEl.addEventListener('mouseenter', stopAutoplay);
      sectionEl.addEventListener('mouseleave', startAutoplay);
      sectionEl.addEventListener('touchstart', stopAutoplay, { passive: true });
      sectionEl.addEventListener('touchend', startAutoplay, { passive: true });

      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlider);
    } else {
      initSlider();
    }
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') initSlider();
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Clickable Full Banner",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading (Optional)",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "🖥️ Desktop Banner Image (Recommended: 1920x720 or 2400x900)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "📱 Mobile Banner Image (Recommended: 1080x1080 or 1080x1350)"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link URL",
      "default": "/pages/get-franchise"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable Subtle Hover Zoom (Desktop)",
      "default": true
    },
    {
      "type": "header",
      "content": "Slider Settings (When using multiple blocks)"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-Slide Banners",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 4
    },
    {
      "type": "header",
      "content": "Dimensions & Spacing"
    },
    {
      "type": "range",
      "id": "border_radius_desk",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border Radius (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius_mob",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border Radius (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desk",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "banner_slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "🖥️ Desktop Banner Image (1920x720)"
        },
        {
          "type": "image_picker",
          "id": "banner_image_mobile",
          "label": "📱 Mobile Banner Image (1080x1080)"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clickable Full Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}