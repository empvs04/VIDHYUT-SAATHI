{% comment %}
  HOW TO INSTALL VIDHYUT SAATHI CARD - 100% Full Width Responsive Section
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsi-wrapper-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  /* Full Width Banner Stage - Edge to Edge */
  .vsi-fullwidth-stage-{{ section.id }} {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    position: relative;
    display: block;
    background: transparent;
    overflow: hidden;
  }

  .vsi-poster-link-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    text-decoration: none;
    margin: 0 !important;
    padding: 0 !important;
  }

  .vsi-poster-picture-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .vsi-poster-stage-img-{{ section.id }} {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    max-height: 85vh;
    display: block !important;
    border-radius: 0 !important;
    object-fit: cover !important;
    object-position: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Inner Container for Badges / Trust bar */
  .vsi-container-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 20px;
    position: relative;
    z-index: 2;
  }

  /* --- OPTIONAL HEADER STYLES --- */
  .vsi-header-{{ section.id }} {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 30px auto;
  }

  .vsi-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FFF3E0 0%, #FFE5B4 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.4);
    color: #D96924;
    padding: 7px 22px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.12);
  }

  .vsi-main-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 12px 0;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }
  .vsi-main-title .highlight-orange { color: #ec5c0a; text-shadow: 0 2px 10px rgba(236, 92, 10, 0.15); }
  .vsi-main-title .highlight-green { color: #007b3e; text-shadow: 0 2px 10px rgba(0, 123, 62, 0.15); }

  .vsi-subtitle-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }

  .vsi-sub-pill {
    background: #ffffff;
    border: 1.5px solid rgba(0, 123, 62, 0.3);
    color: #007b3e;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }
  .vsi-sub-pill.orange {
    border-color: rgba(236, 92, 10, 0.3);
    color: #ec5c0a;
  }

  .vsi-header-divider {
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 10px;
    margin: 16px auto 0 auto;
  }

  /* --- 4 GUARANTEE BADGES GRID --- */
  .vsi-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 25px;
    margin-bottom: 25px;
  }

  .vsi-badge-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.22);
    border-radius: 20px;
    padding: 18px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 20px rgba(247, 148, 29, 0.07);
    transition: all 0.3s ease;
  }
  .vsi-badge-card:hover {
    transform: translateY(-4px);
    border-color: #ec5c0a;
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.15);
  }

  .vsi-badge-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    color: #D96924;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(236, 92, 10, 0.15);
  }

  .vsi-badge-text h4 {
    font-family: 'Baloo 2', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 2px 0;
    line-height: 1.2;
  }
  .vsi-badge-text p {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0;
    font-weight: 600;
  }

  /* --- BOTTOM TRUST FOOTPRINT BAR --- */
  .vsi-trust-bar {
    background: linear-gradient(90deg, #111827 0%, #1e293b 100%);
    border-radius: 20px;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .vsi-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vsi-trust-item i {
    font-size: 1.4rem;
    color: #ec5c0a;
  }
  .vsi-trust-item i.green { color: #007b3e; }
  .vsi-trust-item h5 {
    font-family: 'Baloo 2', sans-serif;
    font-size: 0.92rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
  }
  .vsi-trust-item p {
    font-size: 0.72rem;
    color: #94a3b8;
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  @media(max-width: 991px) {
    .vsi-badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media(max-width: 767px) {
    .vsi-poster-stage-img-{{ section.id }} {
      max-height: none !important;
    }
    .vsi-badges-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .vsi-trust-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding: 16px;
    }
    .vsi-container-{{ section.id }} {
      padding: 20px 14px;
    }
  }
{%- endstyle -%}

<section class="vsi-wrapper-{{ section.id }}" id="how-to-install-{{ section.id }}">

  {% if section.settings.show_header %}
    <div class="vsi-container-{{ section.id }}">
      <div class="vsi-header-{{ section.id }}">
        <div class="vsi-eyebrow-pill">
          <i class="fa-solid fa-bolt-lightning"></i>
          <span>QUICK &amp; SIMPLE INSTALLATION</span>
        </div>
        
        <h2 class="vsi-main-title">
          {{ section.settings.section_title | default: 'HOW TO INSTALL' }} <span class="highlight-orange">VIDHYUT SAATHI</span> <span class="highlight-green">CARD</span>
        </h2>

        <div class="vsi-subtitle-pills">
          <div class="vsi-sub-pill orange">
            <i class="fa-solid fa-clock"></i>
            <span>3 SIMPLE STEPS</span>
          </div>
          <div class="vsi-sub-pill">
            <i class="fa-solid fa-scissors"></i>
            <span>NO WIRING</span>
          </div>
          <div class="vsi-sub-pill">
            <i class="fa-solid fa-user-slash"></i>
            <span>NO TECHNICIAN REQUIRED</span>
          </div>
        </div>

        <div class="vsi-header-divider"></div>
      </div>
    </div>
  {% endif %}

  <!-- 100% FULL-WIDTH BANNER STAGE (DESKTOP & MOBILE) -->
  <div class="vsi-fullwidth-stage-{{ section.id }}">
    {% if section.settings.poster_link != blank %}
      <a href="{{ section.settings.poster_link }}" class="vsi-poster-link-{{ section.id }}">
    {% endif %}
      <picture class="vsi-poster-picture-{{ section.id }}">
        {% if section.settings.poster_image_mobile != blank %}
          <source media="(max-width: 767px)" srcset="{{ section.settings.poster_image_mobile | image_url: width: 1200 }}">
        {% endif %}
        {% if section.settings.poster_image_desk != blank %}
          <source media="(min-width: 768px)" srcset="{{ section.settings.poster_image_desk | image_url: width: 2400 }}">
        {% endif %}
        <img 
          src="{% if section.settings.poster_image_desk != blank %}{{ section.settings.poster_image_desk | image_url: width: 2400 }}{% elsif section.settings.poster_image_mobile != blank %}{{ section.settings.poster_image_mobile | image_url: width: 1200 }}{% else %}{{ 'vs-how-to-install-poster.png' | asset_url }}{% endif %}" 
          alt="{{ section.settings.section_title | default: 'HOW TO INSTALL Vidhyut Saathi Card Process' }}" 
          class="vsi-poster-stage-img-{{ section.id }}" 
          loading="eager" 
          width="2400" 
          height="900"
          onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/file_00000000714c7206a34d95fc7b046fb2.png';"
        >
      </picture>
    {% if section.settings.poster_link != blank %}
      </a>
    {% endif %}
  </div>

  {% if section.settings.show_badges %}
    <div class="vsi-container-{{ section.id }}">
      <!-- 4 GUARANTEE BADGES GRID -->
      <div class="vsi-badges-grid">
        <div class="vsi-badge-card">
          <div class="vsi-badge-icon">
            <i class="fa-solid fa-stopwatch"></i>
          </div>
          <div class="vsi-badge-text">
            <h4>INSTALLATION IN 30 SECONDS</h4>
            <p>Instant zero-hassle setup</p>
          </div>
        </div>

        <div class="vsi-badge-card">
          <div class="vsi-badge-icon">
            <i class="fa-solid fa-scissors"></i>
          </div>
          <div class="vsi-badge-text">
            <h4>NO WIRING REQUIRED</h4>
            <p>100% Non-invasive design</p>
          </div>
        </div>

        <div class="vsi-badge-card">
          <div class="vsi-badge-icon">
            <i class="fa-solid fa-bolt-lightning"></i>
          </div>
          <div class="vsi-badge-text">
            <h4>NO ELECTRICITY INTERRUPTION</h4>
            <p>Zero power shutdown needed</p>
          </div>
        </div>

        <div class="vsi-badge-card">
          <div class="vsi-badge-icon">
            <i class="fa-solid fa-hand-pointer"></i>
          </div>
          <div class="vsi-badge-text">
            <h4>EASY SELF INSTALLATION</h4>
            <p>Do-it-yourself in 3 steps</p>
          </div>
        </div>
      </div>

      <!-- BOTTOM TRUST FOOTPRINT BAR -->
      <div class="vsi-trust-bar">
        <div class="vsi-trust-item">
          <i class="fa-solid fa-microchip"></i>
          <div>
            <h5>SMART TECHNOLOGY</h5>
            <p>BETTER SAVINGS</p>
          </div>
        </div>
        <div class="vsi-trust-item">
          <i class="fa-solid fa-leaf green"></i>
          <div>
            <h5>SAVE ELECTRICITY</h5>
            <p>SAVE MONEY</p>
          </div>
        </div>
        <div class="vsi-trust-item">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <h5>ISO CERTIFIED</h5>
            <p>TRUSTED QUALITY</p>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Vidhyut How To Install",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "HOW TO INSTALL VIDHYUT SAATHI CARD"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Top Header & Slogans",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show Bottom 4 Guarantee Badges & Trust Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "🖼️ 100% Full-Width Banner Uploads"
    },
    {
      "type": "image_picker",
      "id": "poster_image_desk",
      "label": "🖥️ Desktop Banner (1920x720 or 2400x900)"
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "📱 Mobile Banner (1080x1080 or 1080x1350)"
    },
    {
      "type": "url",
      "id": "poster_link",
      "label": "Banner Click Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut How To Install"
    }
  ]
}
{% endschema %}
