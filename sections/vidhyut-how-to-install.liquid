{% comment %}
  HOW TO INSTALL VIDHYUT SAATHI CARD - Perfectly Aligned & Uncropped Section
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsi-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #fffdf8 50%, #f6faf6 100%);
    padding: 65px 0 25px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .vsi-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  /* --- HEADER STYLES --- */
  .vsi-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 40px auto;
  }

  .vsi-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    border: 1.5px solid rgba(236, 92, 10, 0.4);
    color: #D96924;
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.12);
  }

  .vsi-main-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
  }
  .vsi-main-title .highlight-orange { color: #ec5c0a; }
  .vsi-main-title .highlight-green { color: #007b3e; }

  .vsi-subtitle-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  .vsi-sub-pill {
    background: #ffffff;
    border: 1.5px solid rgba(0, 123, 62, 0.3);
    color: #007b3e;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }
  .vsi-sub-pill.orange {
    border-color: rgba(236, 92, 10, 0.3);
    color: #ec5c0a;
  }

  .vsi-header-divider {
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 10px;
    margin: 16px auto 0 auto;
  }

  /* --- 3 STEPS GRID LAYOUT --- */
  .vsi-steps-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 14px;
    align-items: center;
    margin-bottom: 45px;
  }

  .vsi-arrow-wrap {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.2rem;
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.3);
    animation: vsiPulse 2s infinite ease-in-out;
  }
  @keyframes vsiPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 8px 20px rgba(236, 92, 10, 0.3); }
    50% { transform: scale(1.1); box-shadow: 0 12px 28px rgba(236, 92, 10, 0.5); }
  }

  /* STEP CARD ITEM */
  .vsi-step-card {
    background: #FFFFFF;
    border: 2px solid rgba(247, 148, 29, 0.3);
    border-top: 5px solid #F7941D;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(247, 148, 29, 0.1), 0 4px 12px rgba(0, 0, 0, 0.03);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .vsi-step-card:hover {
    transform: translateY(-6px);
    border-color: #ec5c0a;
    box-shadow: 0 20px 45px rgba(236, 92, 10, 0.2);
  }

  /* STEP TOP BADGE BAR */
  .vsi-step-topbar {
    padding: 16px 20px 12px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1.5px solid rgba(247, 148, 29, 0.15);
    background: linear-gradient(135deg, #FFFBF5 0%, #FFFFFF 100%);
  }

  .vsi-step-num {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    color: #ffffff;
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.25rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(236, 92, 10, 0.28);
    flex-shrink: 0;
  }

  .vsi-step-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.2px;
  }

  /* STEP PHOTO DISPLAY STAGE */
  .vsi-step-stage {
    padding: 0;
    background: #080d19;
    height: 230px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .vsi-step-stage.light-bg {
    background: linear-gradient(135deg, #F8FAFC 0%, #FFFDF8 100%);
    padding: 10px;
  }

  /* CARD 1: FULL STAGE FILL WITHOUT WHITE MARGINS */
  .vsi-card-fill-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .vsi-step-card:hover .vsi-card-fill-img {
    transform: scale(1.04);
  }

  /* CARD 2: PERFECT TRANSPARENT BACKGROUND 3M PEEL GRAPHIC */
  .vsi-peel-perfect-img {
    max-width: 95%;
    max-height: 200px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.15));
    transition: transform 0.4s ease;
  }
  .vsi-step-card:hover .vsi-peel-perfect-img {
    transform: scale(1.06) rotate(1deg);
  }

  /* CARD 3: ULTRA HD MCB BOX INSTALLATION GRAPHIC */
  .vsi-mcb-hd-img {
    max-width: 100%;
    max-height: 210px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.15));
    border-radius: 14px;
    transition: transform 0.4s ease;
  }
  .vsi-step-card:hover .vsi-mcb-hd-img {
    transform: scale(1.05);
  }

  .vsi-step-desc {
    padding: 16px 20px;
    text-align: center;
    font-size: 0.9rem;
    color: #475569;
    font-weight: 600;
    line-height: 1.45;
    background: #ffffff;
    margin-top: auto;
  }
  .vsi-step-desc strong {
    color: #ec5c0a;
    font-weight: 800;
  }

  /* --- 4 GUARANTEE BADGES GRID --- */
  .vsi-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .vsi-badge-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.22);
    border-radius: 20px;
    padding: 18px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 20px rgba(247, 148, 29, 0.07);
    transition: all 0.3s ease;
  }
  .vsi-badge-card:hover {
    transform: translateY(-4px);
    border-color: #ec5c0a;
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.15);
  }

  .vsi-badge-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    color: #D96924;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.12);
  }

  .vsi-badge-text h4 {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .vsi-badge-text p {
    font-size: 0.76rem;
    color: #64748b;
    margin: 2px 0 0 0;
    font-weight: 600;
  }

  /* --- BOTTOM TRUST FOOTPRINT BAR --- */
  .vsi-trust-bar {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF9EF 50%, #F5FAF6 100%);
    border: 2px solid rgba(247, 148, 29, 0.4);
    border-top: 5px solid #F7941D;
    border-radius: 24px;
    padding: 22px 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 20px;
    box-shadow: 0 16px 40px rgba(247, 148, 29, 0.12);
    margin-bottom: 20px;
  }

  .vsi-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vsi-trust-item i {
    font-size: 1.8rem;
    color: #ec5c0a;
  }
  .vsi-trust-item i.green {
    color: #007b3e;
  }
  .vsi-trust-item div h5 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    text-transform: uppercase;
  }
  .vsi-trust-item div p {
    font-size: 0.76rem;
    color: #64748b;
    margin: 2px 0 0 0;
    font-weight: 600;
  }

  /* --- COMPREHENSIVE MOBILE RESPONSIVE STYLES --- */
  @media screen and (max-width: 992px) {
    .vsi-steps-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .vsi-arrow-wrap {
      margin: 0 auto;
      transform: rotate(90deg);
    }
    @keyframes vsiPulse {
      0%, 100% { transform: rotate(90deg) scale(1); }
      50% { transform: rotate(90deg) scale(1.1); }
    }

    .vsi-badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .vsi-wrapper {
      padding: 35px 0 15px 0 !important;
    }

    .vsi-header {
      margin-bottom: 24px !important;
    }

    .vsi-eyebrow-pill {
      padding: 5px 16px !important;
      font-size: 0.76rem !important;
    }

    .vsi-main-title {
      font-size: clamp(20px, 5.5vw, 26px) !important;
      line-height: 1.25 !important;
    }

    .vsi-sub-pill {
      padding: 4px 14px !important;
      font-size: 0.74rem !important;
    }

    .vsi-step-stage {
      height: 190px !important;
    }

    .vsi-badges-grid {
      grid-template-columns: 1fr !important;
      gap: 10px !important;
    }

    .vsi-badge-card {
      padding: 14px 16px !important;
    }

    .vsi-trust-bar {
      flex-direction: column !important;
      align-items: flex-start !important;
      padding: 20px 20px !important;
      gap: 14px !important;
    }
  }
{%- endstyle -%}

<section class="vsi-wrapper" id="vsi-section-{{ section.id }}">
  <div class="vsi-container">
    
    <!-- HEADER -->
    <div class="vsi-header">
      <div class="vsi-eyebrow-pill">
        <i class="fa-solid fa-circle-nodes"></i>
        <span>EASY 3-STEP INSTALLATION GUIDE</span>
      </div>

      <h2 class="vsi-main-title">
        HOW TO INSTALL <span class="highlight-orange">VIDHYUT SAATHI</span> <span class="highlight-green">CARD</span>
      </h2>

      <div class="vsi-subtitle-pills">
        <div class="vsi-sub-pill orange">
          <i class="fa-solid fa-bolt"></i>
          <span>3 SIMPLE STEPS</span>
        </div>
        <div class="vsi-sub-pill">
          <i class="fa-solid fa-scissors"></i>
          <span>NO WIRING</span>
        </div>
        <div class="vsi-sub-pill">
          <i class="fa-solid fa-user-slash"></i>
          <span>NO TECHNICIAN REQUIRED</span>
        </div>
      </div>

      <div class="vsi-header-divider"></div>
    </div>

    <!-- 3-STEP SHOWCASE GRID -->
    <div class="vsi-steps-grid">

      <!-- STEP 01: TAKE THE CARD (FULL STAGE FILL) -->
      <div class="vsi-step-card">
        <div class="vsi-step-topbar">
          <div class="vsi-step-num">01</div>
          <h3 class="vsi-step-title">TAKE THE CARD</h3>
        </div>
        <div class="vsi-step-stage">
          <img 
            src="{{ 'vs-install-card-hd.jpg' | asset_url }}" 
            alt="Vidhyut Saathi Power Saving Card" 
            class="vsi-card-fill-img" 
            loading="eager" 
            width="800" 
            height="500"
            onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';"
          >
        </div>
        <div class="vsi-step-desc">
          Take the Card From<br><strong>Vidhyut Saathi Brand Box</strong>
        </div>
      </div>

      <!-- ARROW 1 -->
      <div class="vsi-arrow-wrap">
        <i class="fa-solid fa-arrow-right"></i>
      </div>

      <!-- STEP 02: PEEL OFF 3M ADHESIVE (PERFECT TRANSPARENT PNG GRAPHIC) -->
      <div class="vsi-step-card">
        <div class="vsi-step-topbar">
          <div class="vsi-step-num">02</div>
          <h3 class="vsi-step-title">PEEL OFF 3M ADHESIVE</h3>
        </div>
        <div class="vsi-step-stage light-bg">
          <img 
            src="{{ 'vs-install-peel-perfect.png' | asset_url }}" 
            alt="Peel off 3M adhesive layer from Vidhyut Saathi card" 
            class="vsi-peel-perfect-img" 
            loading="eager" 
            width="800" 
            height="600"
          >
        </div>
        <div class="vsi-step-desc">
          Remove the <strong>3M adhesive tape</strong><br>From the Back Side Of VS Card
        </div>
      </div>

      <!-- ARROW 2 -->
      <div class="vsi-arrow-wrap">
        <i class="fa-solid fa-arrow-right"></i>
      </div>

      <!-- STEP 03: PASTE IT ON MCB (ULTRA HD MCB BOX INSTALLATION GRAPHIC) -->
      <div class="vsi-step-card">
        <div class="vsi-step-topbar">
          <div class="vsi-step-num">03</div>
          <h3 class="vsi-step-title">PASTE IT ON MCB</h3>
        </div>
        <div class="vsi-step-stage light-bg">
          <img 
            src="{{ 'vs-install-step3-hd.png' | asset_url }}" 
            alt="EASY TO INSTALL ON MCB BOX - Vidhyut Saathi Card" 
            class="vsi-mcb-hd-img" 
            loading="eager" 
            width="800" 
            height="600"
          >
        </div>
        <div class="vsi-step-desc">
          Stick the card onto your<br><strong>MCB / ELCB / Switch Boards</strong>
        </div>
      </div>

    </div>

    <!-- 4 GUARANTEE BADGES GRID -->
    <div class="vsi-badges-grid">
      
      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-stopwatch"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>INSTALLATION IN 30 SECONDS</h4>
          <p>Instant zero-hassle setup</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-scissors"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>NO WIRING REQUIRED</h4>
          <p>100% Non-invasive design</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-bolt-lightning"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>NO ELECTRICITY INTERRUPTION</h4>
          <p>Zero power shutdown needed</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-hand-pointer"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>EASY SELF INSTALLATION</h4>
          <p>Do-it-yourself in 3 steps</p>
        </div>
      </div>

    </div>

    <!-- BOTTOM TRUST FOOTPRINT BAR -->
    <div class="vsi-trust-bar">
      <div class="vsi-trust-item">
        <i class="fa-solid fa-microchip"></i>
        <div>
          <h5>SMART TECHNOLOGY</h5>
          <p>BETTER SAVINGS</p>
        </div>
      </div>
      <div class="vsi-trust-item">
        <i class="fa-solid fa-leaf green"></i>
        <div>
          <h5>SAVE ELECTRICITY</h5>
          <p>SAVE MONEY</p>
        </div>
      </div>
      <div class="vsi-trust-item">
        <i class="fa-solid fa-shield-halved"></i>
        <div>
          <h5>ISO CERTIFIED</h5>
          <p>TRUSTED QUALITY</p>
        </div>
      </div>
    </div>

  </div>
</section>

