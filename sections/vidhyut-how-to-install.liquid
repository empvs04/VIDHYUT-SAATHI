{% comment %}
  HOW TO INSTALL VIDHYUT SAATHI CARD - Desktop Full Poster & Ultra-Lucrative Mobile Layout
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsi-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #fffdf8 45%, #f6faf6 100%);
    padding: 50px 0 40px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .vsi-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  /* --- DESKTOP FULL POSTER BANNER --- */
  .vsi-desktop-poster {
    display: block;
    background: #ffffff;
    border: 2.5px solid rgba(247, 148, 29, 0.35);
    border-top: 6px solid #F7941D;
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 20px 50px rgba(247, 148, 29, 0.14), 0 4px 20px rgba(0, 0, 0, 0.05);
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
  }

  .vsi-desktop-poster:hover {
    box-shadow: 0 28px 65px rgba(236, 92, 10, 0.2), 0 6px 25px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .vsi-poster-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    object-fit: contain;
    filter: drop-shadow(0 8px 25px rgba(0, 0, 0, 0.06));
  }

  /* --- MOBILE SPECIFIC LAYOUT (HIDDEN ON DESKTOP) --- */
  .vsi-mobile-layout {
    display: none;
  }

  /* ==========================================================
     MOBILE RESPONSIVE STYLES (Max Width 768px)
     ========================================================== */
  @media screen and (max-width: 768px) {
    .vsi-wrapper {
      padding: 24px 0 16px 0 !important;
    }

    .vsi-container {
      padding: 0 10px !important;
    }

    /* Hide static image on mobile for ultra-sharp readable typography & cards */
    .vsi-desktop-poster {
      display: none !important;
    }

    .vsi-mobile-layout {
      display: block !important;
    }

    /* MOBILE HEADER */
    .vsi-m-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .vsi-m-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: linear-gradient(135deg, #FFF3E0 0%, #FFE5B4 100%);
      border: 1.5px solid rgba(236, 92, 10, 0.5);
      color: #D96924;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.76rem;
      font-weight: 900;
      margin-bottom: 8px;
      box-shadow: 0 4px 12px rgba(236, 92, 10, 0.15);
    }

    .vsi-m-title {
      font-family: 'Baloo 2', 'Outfit', sans-serif;
      font-size: 1.45rem;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.25;
      margin: 0 0 10px 0;
      text-transform: uppercase;
    }
    .vsi-m-title .hl-navy { color: #0f172a; }
    .vsi-m-title .hl-orange { color: #ec5c0a; }

    .vsi-m-pills-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .vsi-m-pill {
      background: #ffffff;
      border: 1.2px solid rgba(0, 123, 62, 0.3);
      color: #007b3e;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.7rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .vsi-m-pill.orange {
      border-color: rgba(236, 92, 10, 0.3);
      color: #ec5c0a;
    }

    /* MASTER CARD ON MOBILE */
    .vsi-m-master-card {
      background: linear-gradient(145deg, #ffffff 0%, #fffdf8 60%, #f6faf6 100%);
      border: 2px solid rgba(247, 148, 29, 0.4);
      border-top: 5px solid #F7941D;
      border-radius: 20px;
      padding: 14px 10px;
      box-shadow: 0 14px 35px rgba(247, 148, 29, 0.15);
      margin-bottom: 20px;
    }

    .vsi-m-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1.5px solid rgba(247, 148, 29, 0.2);
    }

    .vsi-m-brand {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      font-weight: 900;
      color: #0f172a;
    }
    .vsi-m-brand i { color: #ec5c0a; font-size: 14px; }

    .vsi-m-slogan {
      background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
      border: 1px solid rgba(236, 92, 10, 0.4);
      color: #D96924;
      padding: 3px 10px;
      border-radius: 50px;
      font-size: 0.62rem;
      font-weight: 800;
    }

    /* 3 STEP CARDS STACKED/GRID ON MOBILE */
    .vsi-m-steps-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .vsi-m-step-card {
      background: #ffffff;
      border-radius: 14px;
      border: 1.5px solid rgba(247, 148, 29, 0.3);
      border-top: 3.5px solid #ec5c0a;
      padding: 10px;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .vsi-m-step-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(0,0,0,0.06);
    }

    .vsi-m-step-num {
      width: 24px;
      height: 24px;
      border-radius: 6px;
      background: linear-gradient(135deg, #ec5c0a, #ff9900);
      color: #ffffff;
      font-weight: 900;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .vsi-m-step-title {
      font-size: 0.78rem;
      font-weight: 900;
      color: #0f172a;
      margin: 0;
      text-transform: uppercase;
    }

    .vsi-m-step-stage {
      background: linear-gradient(135deg, #F8FAFC, #FFFDF8);
      border-radius: 10px;
      padding: 8px;
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .vsi-m-step-img {
      max-height: 95px;
      max-width: 95%;
      width: auto;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.12));
    }

    .vsi-m-step-desc {
      text-align: center;
      font-size: 0.72rem;
      color: #475569;
      font-weight: 600;
      line-height: 1.3;
    }
    .vsi-m-step-desc strong {
      color: #ec5c0a;
      font-weight: 900;
    }

    .vsi-m-step-arrow {
      text-align: center;
      color: #ec5c0a;
      font-size: 1rem;
      margin: -4px 0;
    }

    /* 2x2 GUARANTEE BADGES ON MOBILE */
    .vsi-m-badges-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 16px;
    }

    .vsi-m-badge-item {
      background: #ffffff;
      border: 1.2px solid rgba(247, 148, 29, 0.25);
      border-left: 3.5px solid #ec5c0a;
      border-radius: 12px;
      padding: 8px 6px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    }

    .vsi-m-badge-icon {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
      color: #D96924;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .vsi-m-badge-text h4 {
      font-size: 0.64rem;
      font-weight: 900;
      color: #0f172a;
      margin: 0;
      line-height: 1.15;
      text-transform: uppercase;
    }
    .vsi-m-badge-text p {
      font-size: 0.58rem;
      color: #64748b;
      margin: 1px 0 0 0;
      font-weight: 600;
    }

    /* TRUST BAR ON MOBILE */
    .vsi-m-trust-bar {
      background: linear-gradient(135deg, #FFFFFF 0%, #FFF9EF 50%, #F5FAF6 100%);
      border: 1.8px solid rgba(247, 148, 29, 0.4);
      border-top: 4px solid #F7941D;
      border-radius: 14px;
      padding: 10px 8px;
      display: flex;
      align-items: center;
      justify-content: space-around;
      gap: 6px;
      box-shadow: 0 10px 25px rgba(247, 148, 29, 0.1);
    }

    .vsi-m-trust-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .vsi-m-trust-item i {
      font-size: 1.05rem;
      color: #ec5c0a;
    }
    .vsi-m-trust-item i.green { color: #007b3e; }
    .vsi-m-trust-item h5 {
      font-size: 0.62rem;
      font-weight: 900;
      color: #0f172a;
      margin: 0;
      line-height: 1.1;
      text-transform: uppercase;
    }
    .vsi-m-trust-item p {
      font-size: 0.56rem;
      color: #64748b;
      margin: 1px 0 0 0;
      font-weight: 600;
    }
  }
{%- endstyle -%}

<section class="vsi-wrapper" id="vsi-section-{{ section.id }}">
  <div class="vsi-container">
    
    <!-- DESKTOP: FULL HIGH-RES POSTER BANNER -->
    <div class="vsi-desktop-poster">
      <img 
        src="{{ 'vs-how-to-install-poster.png' | asset_url }}" 
        alt="HOW TO INSTALL Vidhyut Saathi Card - 3 Simple Steps" 
        class="vsi-poster-img" 
        loading="eager" 
        width="1920" 
        height="1080"
        onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/file_00000000714c7206a34d95fc7b046fb2.png';"
      >
    </div>

    <!-- MOBILE: ULTRA-READABLE LUCRATIVE STEP-BY-STEP SHOWCASE -->
    <div class="vsi-mobile-layout">
      
      <!-- MOBILE HEADER -->
      <div class="vsi-m-header">
        <div class="vsi-m-eyebrow">
          <i class="fa-solid fa-circle-nodes"></i>
          <span>EASY 3-STEP INSTALLATION GUIDE</span>
        </div>

        <h2 class="vsi-m-title">
          HOW TO INSTALL<br>
          <span class="hl-navy">Vidhyut Saathi</span> <span class="hl-orange">Card</span>
        </h2>

        <div class="vsi-m-pills-row">
          <div class="vsi-m-pill orange">
            <i class="fa-solid fa-bolt"></i> 3 SIMPLE STEPS
          </div>
          <div class="vsi-m-pill">
            <i class="fa-solid fa-scissors"></i> NO WIRING
          </div>
          <div class="vsi-m-pill">
            <i class="fa-solid fa-user-slash"></i> NO TECHNICIAN
          </div>
        </div>
      </div>

      <!-- MOBILE MASTER CARD -->
      <div class="vsi-m-master-card">
        
        <div class="vsi-m-topbar">
          <div class="vsi-m-brand">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>VIDHYUT SAATHI PROCESS</span>
          </div>
          <div class="vsi-m-slogan">
            ⚡ 100% SAFE &amp; ZERO MAINTENANCE
          </div>
        </div>

        <div class="vsi-m-steps-container">
          
          <!-- STEP 01 -->
          <div class="vsi-m-step-card">
            <div class="vsi-m-step-header">
              <div class="vsi-m-step-num">01</div>
              <h3 class="vsi-m-step-title">TAKE THE CARD</h3>
            </div>
            <div class="vsi-m-step-stage">
              <img 
                src="{{ 'vs-install-step1-card.jpg' | asset_url }}" 
                alt="Vidhyut Saathi Brand Box and Card" 
                class="vsi-m-step-img" 
                loading="eager" 
                width="800" 
                height="500"
                onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/file_00000000714c7206a34d95fc7b046fb2.png';"
              >
            </div>
            <div class="vsi-m-step-desc">
              Take the Card From<br><strong>Vidhuyt Saathi Brand Box</strong>
            </div>
          </div>

          <div class="vsi-m-step-arrow">
            <i class="fa-solid fa-chevron-down"></i>
          </div>

          <!-- STEP 02 -->
          <div class="vsi-m-step-card">
            <div class="vsi-m-step-header">
              <div class="vsi-m-step-num">02</div>
              <h3 class="vsi-m-step-title">PEEL OFF 3M ADHESIVE</h3>
            </div>
            <div class="vsi-m-step-stage">
              <img 
                src="{{ 'vs-install-peel-hd.png' | asset_url }}" 
                alt="Peel off 3M adhesive layer from Vidhyut Saathi card" 
                class="vsi-m-step-img" 
                loading="eager" 
                width="800" 
                height="600"
              >
            </div>
            <div class="vsi-m-step-desc">
              Remove the 3M adhesive tape<br><strong>From the Back Side Of VS Card</strong>
            </div>
          </div>

          <div class="vsi-m-step-arrow">
            <i class="fa-solid fa-chevron-down"></i>
          </div>

          <!-- STEP 03 -->
          <div class="vsi-m-step-card">
            <div class="vsi-m-step-header">
              <div class="vsi-m-step-num">03</div>
              <h3 class="vsi-m-step-title">PASTE IT ON MCB</h3>
            </div>
            <div class="vsi-m-step-stage">
              <img 
                src="{{ 'vs-install-mcb-new-exact.jpg' | asset_url }}" 
                alt="EASY TO INSTALL ON MCB BOX - Vidhyut Saathi Card" 
                class="vsi-m-step-img" 
                loading="eager" 
                width="800" 
                height="600"
              >
            </div>
            <div class="vsi-m-step-desc">
              Stick the card onto your<br><strong>MCB/ELCB/Switch Boards</strong>
            </div>
          </div>

        </div>

      </div>

      <!-- 4 GUARANTEE BADGES ON MOBILE -->
      <div class="vsi-m-badges-grid">
        <div class="vsi-m-badge-item">
          <div class="vsi-m-badge-icon"><i class="fa-solid fa-stopwatch"></i></div>
          <div class="vsi-m-badge-text">
            <h4>INSTALLATION IN 30 SECONDS</h4>
            <p>Instant zero-hassle setup</p>
          </div>
        </div>

        <div class="vsi-m-badge-item">
          <div class="vsi-m-badge-icon"><i class="fa-solid fa-scissors"></i></div>
          <div class="vsi-m-badge-text">
            <h4>NO WIRING REQUIRED</h4>
            <p>100% Non-invasive design</p>
          </div>
        </div>

        <div class="vsi-m-badge-item">
          <div class="vsi-m-badge-icon"><i class="fa-solid fa-bolt-lightning"></i></div>
          <div class="vsi-m-badge-text">
            <h4>NO ELECTRICITY INTERRUPTION</h4>
            <p>Zero power shutdown needed</p>
          </div>
        </div>

        <div class="vsi-m-badge-item">
          <div class="vsi-m-badge-icon"><i class="fa-solid fa-hand-pointer"></i></div>
          <div class="vsi-m-badge-text">
            <h4>EASY SELF INSTALLATION</h4>
            <p>Do-it-yourself in 3 steps</p>
          </div>
        </div>
      </div>

      <!-- TRUST FOOTPRINT BAR ON MOBILE -->
      <div class="vsi-m-trust-bar">
        <div class="vsi-m-trust-item">
          <i class="fa-solid fa-microchip"></i>
          <div>
            <h5>SMART TECH</h5>
            <p>BETTER SAVINGS</p>
          </div>
        </div>
        <div class="vsi-m-trust-item">
          <i class="fa-solid fa-leaf green"></i>
          <div>
            <h5>SAVE ELECTRICITY</h5>
            <p>SAVE MONEY</p>
          </div>
        </div>
        <div class="vsi-m-trust-item">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <h5>ISO CERTIFIED</h5>
            <p>TRUSTED QUALITY</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Vidhyut How To Install",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "HOW TO INSTALL VIDHYUT SAATHI CARD"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut How To Install"
    }
  ]
}
{% endschema %}
