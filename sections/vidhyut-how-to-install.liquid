{
  "name": "How To Install VS Card",
  "settings": [
    {
      "type": "image_picker",
      "id": "step1_image",
      "label": "Step 1 Image — Take the Card"
    },
    {
      "type": "image_picker",
      "id": "step2_image",
      "label": "Step 2 Image — Peel 3M Adhesive"
    },
    {
      "type": "image_picker",
      "id": "step3_image",
      "label": "Step 3 Image — Paste on MCB"
    }
  ],
  "presets": [
    {
      "name": "How To Install VS Card"
    }
  ]
}
{% endschema %}
