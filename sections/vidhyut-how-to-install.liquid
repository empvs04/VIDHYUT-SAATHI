{% comment %}
  HOW TO INSTALL VIDHYUT SAATHI CARD - Full Poster Image Showcase (Desktop & Mobile)
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsi-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #fffdf8 45%, #f6faf6 100%);
    padding: 45px 0 35px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .vsi-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  /* --- FULL POSTER BANNER CONTAINER --- */
  .vsi-poster-wrapper {
    display: block;
    background: #ffffff;
    border: 2.5px solid rgba(247, 148, 29, 0.35);
    border-top: 6px solid #F7941D;
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 20px 50px rgba(247, 148, 29, 0.14), 0 4px 20px rgba(0, 0, 0, 0.05);
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
  }

  .vsi-poster-wrapper:hover {
    box-shadow: 0 28px 65px rgba(236, 92, 10, 0.2), 0 6px 25px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .vsi-poster-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    object-fit: contain;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.05));
  }

  /* ==========================================================
     MOBILE RESPONSIVE STYLES (Max Width 768px)
     ========================================================== */
  @media screen and (max-width: 768px) {
    .vsi-wrapper {
      padding: 18px 0 12px 0 !important;
    }

    .vsi-container {
      padding: 0 6px !important;
    }

    .vsi-poster-wrapper {
      padding: 6px !important;
      border-radius: 14px !important;
      border-width: 1.8px !important;
      border-top-width: 4px !important;
      box-shadow: 0 10px 25px rgba(247, 148, 29, 0.12) !important;
    }

    .vsi-poster-img {
      border-radius: 10px !important;
    }
  }
{%- endstyle -%}

<section class="vsi-wrapper" id="vsi-section-{{ section.id }}">
  <div class="vsi-container">
    
    <!-- FULL INSTALLATION POSTER IMAGE (SAME FOR DESKTOP AND MOBILE) -->
    <div class="vsi-poster-wrapper">
      <img 
        src="{{ 'vs-how-to-install-poster.png' | asset_url }}" 
        alt="HOW TO INSTALL Vidhyut Saathi Card - 3 Simple Steps" 
        class="vsi-poster-img" 
        loading="eager" 
        width="1920" 
        height="1080"
        onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/file_00000000714c7206a34d95fc7b046fb2.png';"
      >
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Vidhyut How To Install",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "HOW TO INSTALL VIDHYUT SAATHI CARD"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut How To Install"
    }
  ]
}
{% endschema %}
