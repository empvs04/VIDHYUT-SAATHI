{% comment %}
  HOW TO INSTALL VIDHYUT SAATHI CARD - Single Master Showcase Card Layout (Horizontal Mobile Alignment)
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsi-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #fffdf8 50%, #f6faf6 100%);
    padding: 65px 0 35px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .vsi-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  /* --- HEADER STYLES --- */
  .vsi-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 35px auto;
  }

  .vsi-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FFF3E0 0%, #FFE5B4 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.4);
    color: #D96924;
    padding: 7px 22px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.12);
  }

  .vsi-main-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 12px 0;
    letter-spacing: -0.5px;
  }
  .vsi-main-title .highlight-orange { color: #ec5c0a; }
  .vsi-main-title .highlight-green { color: #007b3e; }

  .vsi-subtitle-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }

  .vsi-sub-pill {
    background: #ffffff;
    border: 1.5px solid rgba(0, 123, 62, 0.3);
    color: #007b3e;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }
  .vsi-sub-pill.orange {
    border-color: rgba(236, 92, 10, 0.3);
    color: #ec5c0a;
  }

  .vsi-header-divider {
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 10px;
    margin: 16px auto 0 auto;
  }

  /* --- SINGLE MASTER SHOWCASE CARD CONTAINER --- */
  .vsi-master-showcase-card {
    background: linear-gradient(145deg, #ffffff 0%, #fffdf8 60%, #f6faf6 100%);
    border: 2.5px solid rgba(247, 148, 29, 0.4);
    border-top: 6px solid #F7941D;
    border-radius: 28px;
    padding: 35px 28px;
    box-shadow: 0 20px 60px rgba(247, 148, 29, 0.15), 0 4px 20px rgba(0, 0, 0, 0.04);
    margin-bottom: 45px;
    position: relative;
    overflow: hidden;
  }

  /* TOP BAR INSIDE MASTER CARD */
  .vsi-mc-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 30px;
    padding-bottom: 18px;
    border-bottom: 1.5px solid rgba(247, 148, 29, 0.2);
  }

  .vsi-mc-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vsi-mc-brand i { font-size: 24px; color: #ec5c0a; }
  .vsi-mc-brand span { font-family: 'Baloo 2', sans-serif; font-size: 1.25rem; font-weight: 900; color: #0f172a; }

  .vsi-mc-slogan-pill {
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    border: 1px solid rgba(236, 92, 10, 0.4);
    color: #D96924;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
  }

  /* 3-STEP GRID INSIDE MASTER CARD (DESKTOP) */
  .vsi-mc-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 14px;
    align-items: center;
  }

  .vsi-arrow-wrap {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.1rem;
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.35);
    animation: vsiPulse 2s infinite ease-in-out;
    flex-shrink: 0;
  }
  @keyframes vsiPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 8px 20px rgba(236, 92, 10, 0.35); }
    50% { transform: scale(1.1); box-shadow: 0 12px 28px rgba(236, 92, 10, 0.55); }
  }

  /* INNER STEP BOX INSIDE MASTER CARD */
  .vsi-inner-step-box {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.25);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(247, 148, 29, 0.08);
    transition: all 0.35s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .vsi-inner-step-box:hover {
    transform: translateY(-6px);
    border-color: #ec5c0a;
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.18);
  }

  .vsi-step-topbar {
    padding: 14px 18px 10px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1.5px solid rgba(247, 148, 29, 0.15);
    background: linear-gradient(135deg, #FFFBF5 0%, #FFFFFF 100%);
  }

  .vsi-step-num {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    color: #ffffff;
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.15rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 5px 14px rgba(236, 92, 10, 0.28);
    flex-shrink: 0;
  }

  .vsi-step-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: 0.98rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    line-height: 1.2;
  }

  .vsi-step-stage {
    padding: 0;
    background: #080d19;
    height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .vsi-step-stage.light-bg {
    background: linear-gradient(135deg, #F8FAFC 0%, #FFFDF8 100%);
    padding: 10px;
  }

  .vsi-card-fill-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .vsi-peel-perfect-img {
    max-width: 95%;
    max-height: 185px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.15));
    transition: transform 0.4s ease;
  }

  .vsi-mcb-user-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 12px;
    transition: transform 0.4s ease;
  }

  .vsi-step-desc {
    padding: 14px 16px;
    text-align: center;
    font-size: 0.88rem;
    color: #475569;
    font-weight: 600;
    line-height: 1.45;
    background: #ffffff;
    margin-top: auto;
  }
  .vsi-step-desc strong {
    color: #ec5c0a;
    font-weight: 800;
  }

  /* --- 4 GUARANTEE BADGES GRID --- */
  .vsi-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .vsi-badge-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.22);
    border-radius: 20px;
    padding: 18px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 20px rgba(247, 148, 29, 0.07);
    transition: all 0.3s ease;
  }
  .vsi-badge-card:hover {
    transform: translateY(-4px);
    border-color: #ec5c0a;
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.15);
  }

  .vsi-badge-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    color: #D96924;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.12);
  }

  .vsi-badge-text h4 {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .vsi-badge-text p {
    font-size: 0.76rem;
    color: #64748b;
    margin: 2px 0 0 0;
    font-weight: 600;
  }

  /* --- BOTTOM TRUST FOOTPRINT BAR --- */
  .vsi-trust-bar {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF9EF 50%, #F5FAF6 100%);
    border: 2px solid rgba(247, 148, 29, 0.4);
    border-top: 5px solid #F7941D;
    border-radius: 24px;
    padding: 22px 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 20px;
    box-shadow: 0 16px 40px rgba(247, 148, 29, 0.12);
    margin-bottom: 10px;
  }

  .vsi-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vsi-trust-item i {
    font-size: 1.8rem;
    color: #ec5c0a;
  }
  .vsi-trust-item i.green {
    color: #007b3e;
  }
  .vsi-trust-item div h5 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    text-transform: uppercase;
  }
  .vsi-trust-item div p {
    font-size: 0.76rem;
    color: #64748b;
    margin: 2px 0 0 0;
    font-weight: 600;
  }

  /* ==========================================================
     MOBILE HORIZONTAL ALIGNMENT (Max Width 768px)
     Renders all 3 step cards side-by-side horizontally inside Master Card
     ========================================================== */
  @media screen and (max-width: 768px) {
    .vsi-wrapper {
      padding: 30px 0 20px 0 !important;
    }

    .vsi-container {
      padding: 0 10px !important;
    }

    .vsi-header {
      margin-bottom: 20px !important;
    }

    .vsi-eyebrow-pill {
      padding: 5px 16px !important;
      font-size: 0.74rem !important;
      margin-bottom: 8px !important;
    }

    .vsi-main-title {
      font-size: clamp(18px, 5.2vw, 24px) !important;
      line-height: 1.2 !important;
      margin-bottom: 8px !important;
    }

    .vsi-subtitle-pills {
      gap: 6px !important;
    }

    .vsi-sub-pill {
      padding: 3px 10px !important;
      font-size: 0.7rem !important;
    }

    .vsi-master-showcase-card {
      padding: 16px 10px !important;
      border-radius: 20px !important;
      margin-bottom: 28px !important;
    }

    .vsi-mc-topbar {
      flex-direction: column !important;
      text-align: center !important;
      gap: 6px !important;
      margin-bottom: 16px !important;
      padding-bottom: 12px !important;
    }

    .vsi-mc-brand span {
      font-size: 1rem !important;
    }

    .vsi-mc-slogan-pill {
      font-size: 0.72rem !important;
      padding: 4px 12px !important;
    }

    /* ALL 3 CARDS ALIGNED HORIZONTALLY SIDE-BY-SIDE INSIDE MASTER CARD ON MOBILE */
    .vsi-mc-grid {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr auto 1fr !important;
      gap: 6px !important;
      align-items: stretch !important;
    }

    .vsi-arrow-wrap {
      width: 26px !important;
      height: 26px !important;
      font-size: 0.72rem !important;
      transform: none !important;
      margin: auto 0 !important;
      box-shadow: 0 4px 10px rgba(236, 92, 10, 0.25) !important;
    }
    @keyframes vsiPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    .vsi-inner-step-box {
      border-radius: 14px !important;
      border-width: 1.5px !important;
    }

    .vsi-step-topbar {
      padding: 8px 6px !important;
      gap: 6px !important;
      flex-direction: column !important;
      text-align: center !important;
    }

    .vsi-step-num {
      width: 28px !important;
      height: 28px !important;
      font-size: 0.8rem !important;
      border-radius: 8px !important;
    }

    .vsi-step-title {
      font-size: 0.72rem !important;
      line-height: 1.15 !important;
      text-align: center !important;
    }

    .vsi-step-stage {
      height: 125px !important;
    }

    .vsi-step-stage.light-bg {
      padding: 4px !important;
    }

    .vsi-peel-perfect-img {
      max-height: 110px !important;
    }

    .vsi-mcb-user-img {
      max-height: 115px !important;
    }

    .vsi-step-desc {
      padding: 8px 5px !important;
      font-size: 0.68rem !important;
      line-height: 1.25 !important;
    }

    .vsi-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
      margin-bottom: 20px !important;
    }

    .vsi-badge-card {
      padding: 10px 10px !important;
      gap: 8px !important;
      border-radius: 14px !important;
    }

    .vsi-badge-icon {
      width: 36px !important;
      height: 36px !important;
      font-size: 0.95rem !important;
      border-radius: 10px !important;
    }

    .vsi-badge-text h4 {
      font-size: 0.72rem !important;
      line-height: 1.2 !important;
    }

    .vsi-badge-text p {
      font-size: 0.65rem !important;
    }

    .vsi-trust-bar {
      padding: 14px 14px !important;
      border-radius: 18px !important;
      gap: 12px !important;
      flex-direction: row !important;
      flex-wrap: wrap !important;
      justify-content: space-between !important;
    }

    .vsi-trust-item {
      gap: 8px !important;
    }
    .vsi-trust-item i {
      font-size: 1.3rem !important;
    }
    .vsi-trust-item div h5 {
      font-size: 0.72rem !important;
    }
    .vsi-trust-item div p {
      font-size: 0.65rem !important;
    }
  }
{%- endstyle -%}

<section class="vsi-wrapper" id="vsi-section-{{ section.id }}">
  <div class="vsi-container">
    
    <!-- HEADER -->
    <div class="vsi-header">
      <div class="vsi-eyebrow-pill">
        <i class="fa-solid fa-circle-nodes"></i>
        <span>EASY 3-STEP INSTALLATION GUIDE</span>
      </div>

      <h2 class="vsi-main-title">
        HOW TO INSTALL <span class="highlight-orange">VIDHYUT SAATHI</span> <span class="highlight-green">CARD</span>
      </h2>

      <div class="vsi-subtitle-pills">
        <div class="vsi-sub-pill orange">
          <i class="fa-solid fa-bolt"></i>
          <span>3 SIMPLE STEPS</span>
        </div>
        <div class="vsi-sub-pill">
          <i class="fa-solid fa-scissors"></i>
          <span>NO WIRING</span>
        </div>
        <div class="vsi-sub-pill">
          <i class="fa-solid fa-user-slash"></i>
          <span>NO TECHNICIAN REQUIRED</span>
        </div>
      </div>

      <div class="vsi-header-divider"></div>
    </div>

    <!-- SINGLE MASTER SHOWCASE CARD CONTAINER (HORIZONTAL SIDE-BY-SIDE ALIGNMENT) -->
    <div class="vsi-master-showcase-card">
      
      <!-- TOP BAR INSIDE MASTER CARD -->
      <div class="vsi-mc-topbar">
        <div class="vsi-mc-brand">
          <i class="fa-solid fa-screwdriver-wrench"></i>
          <span>VIDHYUT SAATHI INSTALLATION PROCESS</span>
        </div>
        <div class="vsi-mc-slogan-pill">
          ⚡ 100% SAFE &amp; ZERO MAINTENANCE
        </div>
      </div>

      <!-- 3-STEP GRID INSIDE MASTER CARD (HORIZONTALLY ALIGNED ON MOBILE & DESKTOP) -->
      <div class="vsi-mc-grid">

        <!-- STEP 01: TAKE THE CARD -->
        <div class="vsi-inner-step-box">
          <div class="vsi-step-topbar">
            <div class="vsi-step-num">01</div>
            <h3 class="vsi-step-title">TAKE THE CARD</h3>
          </div>
          <div class="vsi-step-stage">
            <img 
              src="{{ 'vs-install-card-hd.jpg' | asset_url }}" 
              alt="Vidhyut Saathi Power Saving Card" 
              class="vsi-card-fill-img" 
              loading="eager" 
              width="800" 
              height="500"
              onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';"
            >
          </div>
          <div class="vsi-step-desc">
            Take the Card From<br><strong>VS Brand Box</strong>
          </div>
        </div>

        <!-- ARROW 1 -->
        <div class="vsi-arrow-wrap">
          <i class="fa-solid fa-arrow-right"></i>
        </div>

        <!-- STEP 02: PEEL OFF 3M ADHESIVE -->
        <div class="vsi-inner-step-box">
          <div class="vsi-step-topbar">
            <div class="vsi-step-num">02</div>
            <h3 class="vsi-step-title">PEEL OFF 3M ADHESIVE</h3>
          </div>
          <div class="vsi-step-stage light-bg">
            <img 
              src="{{ 'vs-install-peel-perfect.png' | asset_url }}" 
              alt="Peel off 3M adhesive layer from Vidhyut Saathi card" 
              class="vsi-peel-perfect-img" 
              loading="eager" 
              width="800" 
              height="600"
            >
          </div>
          <div class="vsi-step-desc">
            Remove the <strong>3M tape</strong><br>From Back Of VS Card
          </div>
        </div>

        <!-- ARROW 2 -->
        <div class="vsi-arrow-wrap">
          <i class="fa-solid fa-arrow-right"></i>
        </div>

        <!-- STEP 03: PASTE IT ON MCB -->
        <div class="vsi-inner-step-box">
          <div class="vsi-step-topbar">
            <div class="vsi-step-num">03</div>
            <h3 class="vsi-step-title">PASTE IT ON MCB</h3>
          </div>
          <div class="vsi-step-stage light-bg">
            <img 
              src="{{ 'vs-install-mcb-user-exact.jpg' | asset_url }}" 
              alt="EASY TO INSTALL ON MCB BOX - Vidhyut Saathi Card" 
              class="vsi-mcb-user-img" 
              loading="eager" 
              width="800" 
              height="600"
            >
          </div>
          <div class="vsi-step-desc">
            Stick card onto your<br><strong>MCB / Switch Boards</strong>
          </div>
        </div>

      </div>

    </div>

    <!-- 4 GUARANTEE BADGES GRID -->
    <div class="vsi-badges-grid">
      
      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-stopwatch"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>INSTALLATION IN 30 SECONDS</h4>
          <p>Instant zero-hassle setup</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-scissors"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>NO WIRING REQUIRED</h4>
          <p>100% Non-invasive design</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-bolt-lightning"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>NO ELECTRICITY INTERRUPTION</h4>
          <p>Zero power shutdown needed</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-hand-pointer"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>EASY SELF INSTALLATION</h4>
          <p>Do-it-yourself in 3 steps</p>
        </div>
      </div>

    </div>

    <!-- BOTTOM TRUST FOOTPRINT BAR -->
    <div class="vsi-trust-bar">
      <div class="vsi-trust-item">
        <i class="fa-solid fa-microchip"></i>
        <div>
          <h5>SMART TECHNOLOGY</h5>
          <p>BETTER SAVINGS</p>
        </div>
      </div>
      <div class="vsi-trust-item">
        <i class="fa-solid fa-leaf green"></i>
        <div>
          <h5>SAVE ELECTRICITY</h5>
          <p>SAVE MONEY</p>
        </div>
      </div>
      <div class="vsi-trust-item">
        <i class="fa-solid fa-shield-halved"></i>
        <div>
          <h5>ISO CERTIFIED</h5>
          <p>TRUSTED QUALITY</p>
        </div>
      </div>
    </div>

  </div>
</section>

