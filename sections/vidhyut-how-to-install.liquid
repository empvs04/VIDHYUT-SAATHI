      <!-- POSTER IMAGE PASTED EXACTLY INSIDE THE STEP AREA OF MASTER CARD -->
      <div class="vsi-poster-stage">
        <img 
          src="{{ 'vs-how-to-install-poster.png' | asset_url }}" 
          alt="HOW TO INSTALL Vidhyut Saathi Card Process" 
          class="vsi-poster-stage-img" 
          loading="eager" 
          width="1920" 
          height="1080"
          onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/file_00000000714c7206a34d95fc7b046fb2.png';"
        >
      </div>

    </div>

    <!-- 4 GUARANTEE BADGES GRID -->
    <div class="vsi-badges-grid">
      
      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-stopwatch"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>INSTALLATION IN 30 SECONDS</h4>
          <p>Instant zero-hassle setup</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-scissors"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>NO WIRING REQUIRED</h4>
          <p>100% Non-invasive design</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-bolt-lightning"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>NO ELECTRICITY INTERRUPTION</h4>
          <p>Zero power shutdown needed</p>
        </div>
      </div>

      <div class="vsi-badge-card">
        <div class="vsi-badge-icon">
          <i class="fa-solid fa-hand-pointer"></i>
        </div>
        <div class="vsi-badge-text">
          <h4>EASY SELF INSTALLATION</h4>
          <p>Do-it-yourself in 3 steps</p>
        </div>
      </div>

    </div>

    <!-- BOTTOM TRUST FOOTPRINT BAR -->
    <div class="vsi-trust-bar">
      <div class="vsi-trust-item">
        <i class="fa-solid fa-microchip"></i>
        <div>
          <h5>SMART TECHNOLOGY</h5>
          <p>BETTER SAVINGS</p>
        </div>
      </div>
      <div class="vsi-trust-item">
        <i class="fa-solid fa-leaf green"></i>
        <div>
          <h5>SAVE ELECTRICITY</h5>
