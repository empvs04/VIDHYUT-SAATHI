{% comment %}
  HOW TO INSTALL VIDHYUT SAATHI CARD - Single Master Showcase Card Layout with Poster Image inside step area
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsi-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #fffdf8 45%, #f6faf6 100%);
    padding: 55px 0 35px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .vsi-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  /* --- HEADER STYLES --- */
  .vsi-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 35px auto;
  }

  .vsi-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FFF3E0 0%, #FFE5B4 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.4);
    color: #D96924;
    padding: 7px 22px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.12);
  }

  .vsi-main-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 12px 0;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }
  .vsi-main-title .highlight-orange { color: #ec5c0a; text-shadow: 0 2px 10px rgba(236, 92, 10, 0.15); }
  .vsi-main-title .highlight-green { color: #007b3e; text-shadow: 0 2px 10px rgba(0, 123, 62, 0.15); }

  .vsi-subtitle-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }

  .vsi-sub-pill {
    background: #ffffff;
    border: 1.5px solid rgba(0, 123, 62, 0.3);
    color: #007b3e;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }
  .vsi-sub-pill.orange {
    border-color: rgba(236, 92, 10, 0.3);
    color: #ec5c0a;
  }

  .vsi-header-divider {
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 10px;
    margin: 16px auto 0 auto;
  }

  /* --- SINGLE MASTER SHOWCASE CARD CONTAINER --- */
  .vsi-master-showcase-card {
    background: linear-gradient(145deg, #ffffff 0%, #fffdf8 60%, #f6faf6 100%);
    border: 2.5px solid rgba(247, 148, 29, 0.4);
    border-top: 6px solid #F7941D;
    border-radius: 28px;
    padding: 30px 24px;
    box-shadow: 0 20px 60px rgba(247, 148, 29, 0.15), 0 4px 20px rgba(0, 0, 0, 0.04);
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
  }

  /* TOP BAR INSIDE MASTER CARD */
  .vsi-mc-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1.5px solid rgba(247, 148, 29, 0.2);
  }

  .vsi-mc-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vsi-mc-brand i { font-size: 24px; color: #ec5c0a; }
  .vsi-mc-brand span { font-family: 'Baloo 2', sans-serif; font-size: 1.25rem; font-weight: 900; color: #0f172a; }

  .vsi-mc-slogan-pill {
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    border: 1px solid rgba(236, 92, 10, 0.4);
    color: #D96924;
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
  }

  /* POSTER IMAGE AREA INSIDE MASTER CARD */
  .vsi-poster-stage {
    background: #ffffff;
    border-radius: 18px;
    padding: 10px;
    border: 1.5px solid rgba(247, 148, 29, 0.2);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
  }

  .vsi-poster-stage-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    object-fit: contain;
  }

  /* --- 4 GUARANTEE BADGES GRID --- */
  .vsi-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }

  .vsi-badge-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.22);
    border-radius: 20px;
    padding: 18px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 20px rgba(247, 148, 29, 0.07);
    transition: all 0.3s ease;
  }
  .vsi-badge-card:hover {
    transform: translateY(-4px);
    border-color: #ec5c0a;
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.15);
  }

  .vsi-badge-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    color: #D96924;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.12);
  }

  .vsi-badge-text h4 {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .vsi-badge-text p {
    font-size: 0.76rem;
    color: #64748b;
    margin: 2px 0 0 0;
    font-weight: 600;
  }

  /* --- BOTTOM TRUST FOOTPRINT BAR --- */
  .vsi-trust-bar {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF9EF 50%, #F5FAF6 100%);
    border: 2px solid rgba(247, 148, 29, 0.4);
    border-top: 5px solid #F7941D;
    border-radius: 24px;
    padding: 22px 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 20px;
    box-shadow: 0 16px 40px rgba(247, 148, 29, 0.12);
    margin-bottom: 10px;
  }

  .vsi-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vsi-trust-item i {
    font-size: 1.8rem;
    color: #ec5c0a;
  }
  .vsi-trust-item i.green {
    color: #007b3e;
  }
  .vsi-trust-item div h5 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    text-transform: uppercase;
  }
  .vsi-trust-item div p {
    font-size: 0.76rem;
    color: #64748b;
    margin: 2px 0 0 0;
    font-weight: 600;
  }

  /* ==========================================================
     DESKTOP FULL WIDTH & LUCRATIVE STYLES (Min Width 769px)
     ========================================================== */
  @media screen and (min-width: 769px) {
    .vsi-container {
      max-width: 1400px !important;
      padding: 0 24px !important;
    }

    .vsi-master-showcase-card {
      width: 100% !important;
      border-radius: 28px !important;
      padding: 24px !important;
      background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #F4FAF5 100%) !important;
      border: 2.5px solid rgba(247, 148, 29, 0.35) !important;
      border-top: 6px solid #F7941D !important;
      box-shadow: 0 25px 70px rgba(247, 148, 29, 0.16), 0 6px 24px rgba(0, 0, 0, 0.04) !important;
      margin-bottom: 40px !important;
    }

    .vsi-mc-topbar {
      background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%) !important;
      padding: 16px 28px !important;
      border-radius: 18px !important;
      border-bottom: none !important;
      margin-bottom: 20px !important;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12) !important;
    }

    .vsi-mc-brand i {
      color: #F7941D !important;
      font-size: 26px !important;
    }

    .vsi-mc-brand span {
      color: #FFFFFF !important;
      font-size: 1.35rem !important;
      font-weight: 900 !important;
      letter-spacing: -0.3px !important;
    }

    .vsi-mc-slogan-pill {
      background: linear-gradient(135deg, #F7941D 0%, #E07810 100%) !important;
      color: #FFFFFF !important;
      border: none !important;
      font-size: 0.9rem !important;
      padding: 8px 22px !important;
      font-weight: 900 !important;
      box-shadow: 0 4px 16px rgba(247, 148, 29, 0.35) !important;
    }

    .vsi-poster-stage {
      padding: 12px !important;
      border-radius: 22px !important;
      border: 2px solid rgba(247, 148, 29, 0.25) !important;
      background: #FFFFFF !important;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.05) !important;
      width: 100% !important;
    }

    .vsi-poster-stage-img {
      width: 100% !important;
      height: auto !important;
      border-radius: 16px !important;
      object-fit: cover !important;
      display: block !important;
    }

    .vsi-badges-grid {
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 20px !important;
      max-width: 1400px !important;
      margin: 0 auto 40px auto !important;
    }

    .vsi-badge-card {
      padding: 22px 20px !important;
      border-radius: 22px !important;
      border: 1.5px solid rgba(247, 148, 29, 0.25) !important;
      box-shadow: 0 10px 25px rgba(247, 148, 29, 0.08) !important;
    }

    .vsi-trust-bar {
      max-width: 1400px !important;
      margin: 0 auto !important;
      padding: 24px 40px !important;
      border-radius: 24px !important;
      justify-content: space-around !important;
    }
  }

  /* ==========================================================
     MOBILE RESPONSIVE STYLES (Max Width 768px)
     ========================================================== */
  @media screen and (max-width: 768px) {
    .vsi-wrapper {
      padding: 26px 0 16px 0 !important;
    }

    .vsi-container {
      padding: 0 8px !important;
    }

    .vsi-header {
      margin-bottom: 20px !important;
    }

    .vsi-eyebrow-pill {
      padding: 7px 18px !important;
      font-size: 0.82rem !important;
      font-weight: 900 !important;
      letter-spacing: 0.4px !important;
      margin-bottom: 8px !important;
      border: 1.8px solid rgba(236, 92, 10, 0.5) !important;
      box-shadow: 0 4px 14px rgba(236, 92, 10, 0.18) !important;
    }

    .vsi-main-title {
      font-size: clamp(21px, 5.8vw, 27px) !important;
      font-weight: 900 !important;
      line-height: 1.22 !important;
      margin-bottom: 10px !important;
      letter-spacing: -0.3px !important;
      text-transform: uppercase !important;
    }

    .vsi-subtitle-pills {
      gap: 6px !important;
    }

    .vsi-sub-pill {
      padding: 5px 14px !important;
      font-size: 0.76rem !important;
      font-weight: 900 !important;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05) !important;
    }

    .vsi-master-showcase-card {
      padding: 12px 6px !important;
      border-radius: 18px !important;
      border-width: 2px !important;
      border-top-width: 4.5px !important;
      box-shadow: 0 14px 35px rgba(247, 148, 29, 0.16) !important;
      margin-bottom: 22px !important;
    }

    .vsi-mc-topbar {
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 4px !important;
      margin-bottom: 12px !important;
      padding-bottom: 8px !important;
    }

    .vsi-mc-brand span {
      font-size: 0.78rem !important;
      font-weight: 900 !important;
    }
    .vsi-mc-brand i {
      font-size: 15px !important;
    }

    .vsi-mc-slogan-pill {
      font-size: 0.62rem !important;
      padding: 3px 8px !important;
    }

    .vsi-poster-stage {
      padding: 4px !important;
      border-radius: 12px !important;
    }

    .vsi-poster-stage-img {
      border-radius: 8px !important;
    }

    .vsi-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 6px !important;
      margin-bottom: 18px !important;
    }

    .vsi-badge-card {
      padding: 8px 8px !important;
      gap: 6px !important;
      border-radius: 12px !important;
      border-left: 3px solid #ec5c0a !important;
      box-shadow: 0 6px 14px rgba(247, 148, 29, 0.08) !important;
    }

    .vsi-badge-icon {
      width: 32px !important;
      height: 32px !important;
      font-size: 0.85rem !important;
      border-radius: 8px !important;
    }

    .vsi-badge-text h4 {
      font-size: 0.68rem !important;
      line-height: 1.15 !important;
      font-weight: 800 !important;
    }

    .vsi-badge-text p {
      font-size: 0.6rem !important;
    }

    .vsi-trust-bar {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      padding: 12px 4px !important;
      border-radius: 16px !important;
      gap: 4px !important;
      align-items: center !important;
      text-align: center !important;
    }

    .vsi-trust-item {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 3px !important;
      text-align: center !important;
    }
    .vsi-trust-item i {
      font-size: 1.15rem !important;
    }
    .vsi-trust-item div {
      text-align: center !important;
    }
    .vsi-trust-item div h5 {
      font-size: 0.62rem !important;
      font-weight: 800 !important;
      line-height: 1.15 !important;
      margin: 0 !important;
    }
    .vsi-trust-item div p {
      font-size: 0.55rem !important;
      line-height: 1.15 !important;
      margin: 1px 0 0 0 !important;
    }
  }
{%- endstyle -%}

<section class="vsi-wrapper" id="vsi-section-{{ section.id }}">
  <div class="vsi-container">
    
    <!-- HEADER -->
    <div class="vsi-header">
      <div class="vsi-eyebrow-pill">
        <i class="fa-solid fa-circle-nodes"></i>
        <span>EASY 3-STEP INSTALLATION GUIDE</span>
      </div>

      <h2 class="vsi-main-title">
