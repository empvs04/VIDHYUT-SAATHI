{% comment %}
  Vidhyut Saathi - How to Install Section (Official Graphic Poster Showcase + Interactive Steps)
  File: sections/vidhyut-how-to-install.liquid
{% endcomment %}

{%- style -%}
  .vsinst-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #fffdf8 40%, #f6faf6 100%);
    padding: 65px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .vsinst-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  /* --- HEADER STYLES --- */
  .vsinst-header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 40px auto;
  }

  .vsinst-top-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    background: linear-gradient(135deg, #FFF3E0 0%, #FFE5B4 100%);
    border: 1.5px solid rgba(247, 148, 29, 0.4);
    padding: 8px 24px;
    border-radius: 50px;
    margin-bottom: 18px;
    box-shadow: 0 6px 20px rgba(247, 148, 29, 0.12);
  }

  .vsinst-badge-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #D96924;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .vsinst-badge-divider {
    color: rgba(217, 105, 36, 0.4);
    font-weight: 300;
  }

  .vsinst-main-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 12px 0;
    letter-spacing: -0.5px;
  }
  .vsinst-main-title .hl-orange { color: #ec5c0a; }

  .vsinst-subtitle {
    font-size: 1.05rem;
    color: #475569;
    font-weight: 600;
    margin: 0 auto 18px auto;
  }

  .vsinst-header-divider {
    width: 90px;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 10px;
    margin: 0 auto;
  }

  /* --- OFFICIAL POSTER CARD SHOWCASE --- */
  .vsinst-poster-stage {
    background: #ffffff;
    border: 2px solid rgba(247, 148, 29, 0.35);
    border-top: 6px solid #F7941D;
    border-radius: 28px;
    padding: 16px;
    box-shadow: 0 20px 50px rgba(247, 148, 29, 0.12), 0 4px 20px rgba(0, 0, 0, 0.04);
    margin-bottom: 45px;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .vsinst-poster-stage:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 60px rgba(247, 148, 29, 0.18);
  }

  .vsinst-poster-img-wrap {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsinst-poster-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    object-fit: contain;
  }

  /* --- 3 STEP MINI CARDS (MOBILE & EXTRA VISIBILITY) --- */
  .vsinst-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 40px;
  }

  .vsinst-step-card {
    background: #ffffff;
    border: 1.5px solid rgba(247, 148, 29, 0.25);
    border-radius: 22px;
    padding: 22px 18px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .vsinst-step-card:hover {
    transform: translateY(-5px);
    border-color: #ec5c0a;
  }

  .vsinst-step-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ec5c0a, #ff9900);
    color: #ffffff;
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    box-shadow: 0 6px 16px rgba(236, 92, 10, 0.3);
  }
  .vsinst-step-card:nth-child(1) .vsinst-step-badge { background: linear-gradient(135deg, #090e1a, #1e293b); }
  .vsinst-step-card:nth-child(3) .vsinst-step-badge { background: linear-gradient(135deg, #007b3e, #10b981); }

  .vsinst-step-title {
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.15rem;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 8px 0;
    text-transform: uppercase;
  }

  .vsinst-step-desc {
    font-size: 0.88rem;
    font-weight: 700;
    color: #475569;
    margin: 0;
    line-height: 1.4;
  }
  .vsinst-step-desc strong { color: #ec5c0a; }

  /* --- ORDER CTA WRAPPER --- */
  .vsinst-cta-wrap {
    text-align: center;
  }

  .vsinst-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 18px 42px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    color: #ffffff !important;
    font-size: 1.1rem;
    font-weight: 900;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 35px rgba(236, 92, 10, 0.4);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .vsinst-cta-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.6);
    background: linear-gradient(135deg, #ff9900 0%, #007b3e 100%);
  }

  /* --- MOBILE RESPONSIVE OPTIMIZATIONS (Max Width 768px) --- */
  @media screen and (max-width: 768px) {
    .vsinst-wrapper {
      padding: 35px 0 !important;
    }

    .vsinst-header {
      margin-bottom: 24px !important;
    }

    .vsinst-top-badge {
      gap: 8px !important;
      padding: 6px 14px !important;
      margin-bottom: 14px !important;
    }

    .vsinst-badge-item {
      font-size: 0.74rem !important;
    }

    .vsinst-main-title {
      font-size: clamp(20px, 5.5vw, 26px) !important;
    }

    .vsinst-subtitle {
      font-size: 0.88rem !important;
    }

    .vsinst-poster-stage {
      padding: 10px !important;
      border-radius: 20px !important;
      margin-bottom: 24px !important;
    }

    .vsinst-poster-img {
      border-radius: 14px !important;
    }

    .vsinst-steps-grid {
      grid-template-columns: 1fr !important;
      gap: 12px !important;
      margin-bottom: 28px !important;
    }

    .vsinst-step-card {
      padding: 16px 14px !important;
      border-radius: 16px !important;
      flex-direction: row !important;
      text-align: left !important;
      gap: 14px !important;
    }

    .vsinst-step-badge {
      width: 40px !important;
      height: 40px !important;
      font-size: 1.05rem !important;
      margin-bottom: 0 !important;
      flex-shrink: 0 !important;
    }

    .vsinst-step-title {
      font-size: 1rem !important;
      margin-bottom: 4px !important;
    }

    .vsinst-step-desc {
      font-size: 0.82rem !important;
    }

    .vsinst-cta-btn {
      width: 100% !important;
      justify-content: center !important;
      padding: 16px 20px !important;
      font-size: 1rem !important;
      box-sizing: border-box !important;
    }
  }
{%- endstyle -%}

<section class="vsinst-wrapper" id="vsinst-section-{{ section.id }}">
  <div class="vsinst-container">
    
    <!-- HEADER -->
    <div class="vsinst-header">
      <div class="vsinst-top-badge">
        <div class="vsinst-badge-item">
          <i class="fa-solid fa-bolt"></i> 3 SIMPLE STEPS
        </div>
        <span class="vsinst-badge-divider">|</span>
        <div class="vsinst-badge-item">
          <i class="fa-solid fa-ban"></i> NO WIRING
        </div>
        <span class="vsinst-badge-divider">|</span>
        <div class="vsinst-badge-item">
          <i class="fa-solid fa-user-shield"></i> NO TECHNICIAN REQUIRED
        </div>
      </div>

      <h2 class="vsinst-main-title">
        HOW TO INSTALL <span class="hl-orange">VIDHYUT SAATHI CARD</span>
      </h2>
      <p class="vsinst-subtitle">
        Self-Installation in 30 Seconds — Just Peel 3M Adhesive & Paste Near Your MCB Box!
      </p>
      <div class="vsinst-header-divider"></div>
    </div>

    <!-- OFFICIAL GRAPHIC POSTER SHOWCASE CARD -->
    <div class="vsinst-poster-stage">
      <div class="vsinst-poster-img-wrap">
        {%- if section.settings.poster_image != blank -%}
          {{ section.settings.poster_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'How to Install Vidhyut Saathi Card Guide', class: 'vsinst-poster-img' }}
        {%- else -%}
          <img 
            src="{{ 'vs-how-to-install-poster.png' | asset_url }}" 
            alt="How to Install Vidhyut Saathi Card Guide Poster" 
            class="vsinst-poster-img"
            loading="eager" 
            width="1400" 
            height="900"
            onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';"
          >
        {%- endif -%}
      </div>
    </div>

    <!-- 3 STEP QUICK BREAKDOWN CARDS -->
    <div class="vsinst-steps-grid">
      <div class="vsinst-step-card">
        <div class="vsinst-step-badge">01</div>
        <div>
          <h3 class="vsinst-step-title">01. TAKE THE CARD</h3>
          <p class="vsinst-step-desc">Take the Card From <strong>Vidhyut Saathi Brand Box</strong></p>
        </div>
      </div>

      <div class="vsinst-step-card">
        <div class="vsinst-step-badge">02</div>
        <div>
          <h3 class="vsinst-step-title">02. PEEL OFF 3M ADHESIVE</h3>
          <p class="vsinst-step-desc">Remove the <strong>3M adhesive tape</strong> From Back Side Of Card</p>
        </div>
      </div>

      <div class="vsinst-step-card">
        <div class="vsinst-step-badge">03</div>
        <div>
          <h3 class="vsinst-step-title">03. PASTE IT ON MCB</h3>
          <p class="vsinst-step-desc">Stick the card onto your <strong>MCB / ELCB / Switch Boards</strong></p>
        </div>
      </div>
    </div>

    <!-- ORDER CTA BUTTON -->
    <div class="vsinst-cta-wrap">
      <a href="/products/vidhyut-saathi-card" class="vsinst-cta-btn">
        <span>Order Vidhyut Saathi Card Now</span>
        <i class="fa-solid fa-arrow-right-long"></i>
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "How to Install Section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "HOW TO INSTALL VIDHYUT SAATHI CARD"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Official How to Install Poster Card Image"
    }
  ],
  "presets": [
    {
      "name": "Vidhyut How to Install"
    }
  ]
}
{% endschema %}
