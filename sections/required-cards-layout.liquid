{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --req-secondary: #007b3e;
    --req-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --req-text-dark: #0f172a;
    --req-text-light: #334155;
    --req-radius: 20px;
    --req-shadow: 0 16px 45px rgba(0, 0, 0, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(236, 92, 10, 0.16);
    --req-border: rgba(236, 92, 10, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: radial-gradient(circle at 50% 0%, rgba(236, 92, 10, 0.06) 0%, #ffffff 45%, rgba(0, 123, 62, 0.05) 100%);
    overflow: hidden;
  }

  /* --- Section 1: Hero Header & Master Calculation Matrix --- */
  .req-hero-section {
    position: relative;
    padding: clamp(50px, 7vw, 90px) 20px 60px 20px;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    color: #ffffff;
    overflow: hidden;
    border-bottom: 3px solid rgba(255, 204, 0, 0.4);
  }

  /* Left to Right Moving Marquee Text */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 30px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 18s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 40px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffcc00;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(255, 204, 0, 0.15);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
  }

  .req-hero-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #ffcc00, #ec5c0a, #00ff66);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 820px;
    margin: 0 auto;
  }

  /* --- Golden Rule Box --- */
  .req-golden-banner {
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 2px solid #ffcc00;
    border-radius: 20px;
    padding: 20px 24px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .req-golden-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }
  .req-golden-info h3 {
    color: #ffcc00;
    font-weight: 900;
    font-size: 1.15rem;
    margin: 0 0 4px 0;
  }
  .req-golden-info p {
    color: #ffffff;
    font-size: 0.96rem;
    margin: 0;
    line-height: 1.5;
  }
  .req-golden-info strong {
    color: #00ff66;
    font-weight: 900;
  }
  .req-golden-pill {
    padding: 8px 18px;
    background: #ffcc00;
    color: #000000;
    font-weight: 900;
    font-size: 0.88rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(255, 204, 0, 0.3);
  }

  /* --- Section 1: Master Visual Requirement Table --- */
  .req-table-stage {
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 204, 0, 0.4);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.6);
    margin-bottom: 40px;
  }

  .req-table-header-bar {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: linear-gradient(135deg, #ec5c0a, #007b3e);
    border-radius: 16px;
    padding: 16px 20px;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    margin-bottom: 14px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .req-table-rows-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .req-table-row-card {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 14px 20px;
    align-items: center;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .req-table-row-card:hover {
    background: rgba(236, 92, 10, 0.18);
    border-color: #ffcc00;
    transform: scale(1.01);
    box-shadow: 0 10px 25px rgba(236, 92, 10, 0.25);
  }

  .req-col-kw {
    font-size: 1.05rem;
    font-weight: 900;
    color: #00ff66;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .req-col-bill {
    font-size: 0.98rem;
    font-weight: 800;
    color: #ffffff;
  }
  .req-col-1phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #ffcc00;
    background: rgba(255, 204, 0, 0.12);
    padding: 6px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 204, 0, 0.3);
  }
  .req-col-3phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #ff5500;
    background: rgba(236, 92, 10, 0.2);
    padding: 6px 12px;
    border-radius: 10px;
    border: 1px solid rgba(236, 92, 10, 0.4);
  }

  /* --- Real Scenario Highlight Card (User's Exact Example) --- */
  .req-example-spotlight {
    background: linear-gradient(135deg, rgba(0, 123, 62, 0.2), rgba(236, 92, 10, 0.2));
    border: 2px solid #00ff66;
    border-radius: 22px;
    padding: 26px 30px;
    box-shadow: 0 20px 50px rgba(0, 255, 102, 0.15);
    margin-top: 20px;
  }

  .req-spotlight-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .req-spotlight-badge {
    background: #00ff66;
    color: #000000;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 5px 14px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .req-spotlight-title h3 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 900;
    margin: 0;
  }

  .req-spotlight-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  @media (max-width: 850px) {
    .req-spotlight-steps-grid {
      grid-template-columns: 1fr;
    }
  }

  .req-step-box {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 16px 18px;
    text-align: center;
  }
  .req-step-num {
    font-size: 0.78rem;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }
  .req-step-val {
    font-size: 1.1rem;
    font-weight: 900;
    color: #ffcc00;
    margin-bottom: 4px;
    display: block;
  }
  .req-step-cards {
    font-size: 0.88rem;
    font-weight: 800;
    color: #ffffff;
    background: rgba(236, 92, 10, 0.2);
    padding: 4px 10px;
    border-radius: 8px;
    display: inline-block;
  }

  .req-spotlight-final-box {
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 16px;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #ffffff;
    flex-wrap: wrap;
  }
  .req-final-text h4 {
    font-size: 1.15rem;
    font-weight: 900;
    margin: 0 0 4px 0;
  }
  .req-final-text p {
    font-size: 0.92rem;
    margin: 0;
    color: #e2e8f0;
  }
  .req-final-result-badge {
    background: #ffffff;
    color: #0f172a;
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 1.25rem;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
  }
  .req-final-result-badge span {
    color: #ec5c0a;
  }

  /* Mobile Responsive Adjustments */
  @media screen and (max-width: 768px) {
    /* Mobile Justified Paragraphs */
    .req-hero-subheading,
    .req-golden-info p,
    .req-spotlight-final-box p {
      text-align: justify !important;
      text-justify: inter-word !important;
    }
    .req-hero-section {
      padding: 40px 12px 40px 12px !important;
    }
    .req-moving-text {
      top: 15px !important;
      font-size: 26px !important;
    }
    .hero-breadcrumb-pill {
      padding: 6px 14px !important;
      font-size: 0.76rem !important;
    }
    .req-badge-top {
      font-size: 0.72rem !important;
      padding: 5px 12px !important;
    }
    .req-hero-header h1 {
      font-size: clamp(1.7rem, 6vw, 2.2rem) !important;
    }
    .req-table-stage {
      padding: 12px !important;
      border-radius: 18px !important;
    }
    .req-table-header-bar {
      display: none !important;
    }
    .req-table-row-card {
      grid-template-columns: 1fr 1fr !important;
      gap: 10px !important;
      padding: 14px 12px !important;
      text-align: left !important;
      border-radius: 14px !important;
    }
    .req-col-kw {
      justify-content: flex-start !important;
      font-size: 0.98rem !important;
    }
    .req-col-bill {
      font-size: 0.88rem !important;
      text-align: right !important;
    }
    .req-col-1phase, .req-col-3phase {
      font-size: 0.88rem !important;
      text-align: center !important;
      padding: 6px 8px !important;
    }
    .req-golden-banner {
      padding: 16px !important;
      flex-direction: column !important;
      text-align: center !important;
    }
    .req-golden-text {
      flex-direction: column !important;
      text-align: center !important;
    }
    .req-example-spotlight {
      padding: 18px 14px !important;
      border-radius: 18px !important;
    }
    .req-spotlight-title {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 8px !important;
    }
    .req-spotlight-final-box {
      flex-direction: column !important;
      text-align: center !important;
      align-items: center !important;
    }
  }
{%- endstyle -%}

<div class="req-wrapper">
  
  <!-- ==========================================
       SECTION 1: HERO HEADER & MASTER CALCULATION MATRIX
       ========================================== -->
  <section class="req-hero-section">
    <div class="req-moving-text">Required Vidhyut Saathi Card &nbsp; &nbsp; Master Estimation Matrix &nbsp; &nbsp; Save Electricity</div>

    <div class="req-hero-container">
      
      <!-- Top Breadcrumb & Badge -->
      <div style="text-align: center; margin-bottom: 20px;">
        <div class="hero-breadcrumb-pill">
          <a href="/">Home</a>
          <span style="color: #ffcc00;">/</span>
          <span style="color: #ffffff; font-weight: 700;">Required Cards</span>
          <span style="color: rgba(255,255,255,0.3); margin: 0 4px;">|</span>
          <span style="color: #ffcc00; font-weight: 800;"><span class="pulse-dot"></span> Master Guide</span>
        </div>
      </div>

      <div class="req-hero-header">
        <div class="req-badge-top">
          <span class="pulse-dot"></span>
          <span>⚡ OFFICIAL CARD REQUIREMENT GUIDE</span>
        </div>
        <h1>Required Vidhyut Saathi Card <span>Instant Load &amp; Bill Estimation Matrix</span></h1>
        <p class="req-hero-subheading">How many Vidhyut Saathi Cards do you need for your home, shop, or factory? Understand instantly with the master estimation chart and examples below.</p>
      </div>

      <!-- Golden Rule Banner -->
      <div class="req-golden-banner">
        <div class="req-golden-text">
          <div class="req-golden-icon">🧮</div>
          <div class="req-golden-info">
            <h3>Golden Rule: Always Consider Higher Requirement</h3>
            <p>Between KW Connected Load and Monthly Electricity Bill amount (₹), <strong>always select whichever yields the higher number of cards!</strong></p>
          </div>
        </div>
        <div class="req-golden-pill">⚡ 3-Phase Meter = Add +1 Extra Card</div>
      </div>

      <!-- Section 1: Master Visual Requirement Table Stage -->
      <div class="req-table-stage">
        
        <!-- Table Column Headers -->
        <div class="req-table-header-bar">
          <div>🔌 KW Connection</div>
          <div>🧾 Monthly Bill Amount</div>
          <div>💳 Single Phase Cards</div>
          <div>⚡ 3-Phase Connection</div>
        </div>

        <!-- 10 Master Rows -->
        <div class="req-table-rows-container">
          
          <!-- Row 1: 1-6 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏠 1 – 6 KW</div>
            <div class="req-col-bill">Upto ₹6,000 / month</div>
            <div class="req-col-1phase">1 Card</div>
            <div class="req-col-3phase">2 Cards</div>
          </div>

          <!-- Row 2: 7-12 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏠 7 – 12 KW</div>
            <div class="req-col-bill">₹6,001 – ₹12,000</div>
            <div class="req-col-1phase">2 Cards</div>
            <div class="req-col-3phase">3 Cards</div>
          </div>

          <!-- Row 3: 13-18 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏠 13 – 18 KW</div>
            <div class="req-col-bill">₹12,001 – ₹18,000</div>
            <div class="req-col-1phase">3 Cards</div>
            <div class="req-col-3phase">4 Cards</div>
          </div>

          <!-- Row 4: 19-24 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏢 19 – 24 KW</div>
            <div class="req-col-bill">₹18,001 – ₹24,000</div>
            <div class="req-col-1phase">4 Cards</div>
            <div class="req-col-3phase">5 Cards</div>
          </div>

          <!-- Row 5: 25-30 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏢 25 – 30 KW</div>
            <div class="req-col-bill">₹24,001 – ₹30,000</div>
            <div class="req-col-1phase">5 Cards</div>
            <div class="req-col-3phase">6 Cards</div>
          </div>

          <!-- Row 6: 31-36 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏬 31 – 36 KW</div>
            <div class="req-col-bill">₹30,001 – ₹36,000</div>
            <div class="req-col-1phase">6 Cards</div>
            <div class="req-col-3phase">7 Cards</div>
          </div>

          <!-- Row 7: 37-42 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏬 37 – 42 KW</div>
            <div class="req-col-bill">₹36,001 – ₹42,000</div>
            <div class="req-col-1phase">7 Cards</div>
            <div class="req-col-3phase">8 Cards</div>
          </div>

          <!-- Row 8: 43-48 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏭 43 – 48 KW</div>
            <div class="req-col-bill">₹42,001 – ₹48,000</div>
            <div class="req-col-1phase">8 Cards</div>
            <div class="req-col-3phase">9 Cards</div>
          </div>

          <!-- Row 9: 49-54 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏭 49 – 54 KW</div>
            <div class="req-col-bill">₹48,001 – ₹54,000</div>
            <div class="req-col-1phase">9 Cards</div>
            <div class="req-col-3phase">10 Cards</div>
          </div>

          <!-- Row 10: 55-60 KW -->
          <div class="req-table-row-card">
            <div class="req-col-kw">🏭 55 – 60 KW</div>
            <div class="req-col-bill">₹54,001 – ₹60,000</div>
            <div class="req-col-1phase">10 Cards</div>
            <div class="req-col-3phase">11 Cards</div>
          </div>

        </div>
      </div>

      <!-- Real Example Spotlight (User's Scenario Example) -->
      <div class="req-example-spotlight">
        <div class="req-spotlight-title">
          <span class="req-spotlight-badge">💡 Practical Example</span>
          <h3>How many cards are required for a 5 KW Load + ₹10,000 Bill + 3-Phase Meter?</h3>
        </div>

        <div class="req-spotlight-steps-grid">
          
          <div class="req-step-box">
            <span class="req-step-num">Step 1: KW Load Rule</span>
            <span class="req-step-val">5 KW Load</span>
            <span class="req-step-cards">1 Card Required</span>
          </div>

          <div class="req-step-box">
            <span class="req-step-num">Step 2: Bill Amount Rule</span>
            <span class="req-step-val">₹10,000 Bill</span>
            <span class="req-step-cards">2 Cards Required</span>
          </div>

          <div class="req-step-box">
            <span class="req-step-num">Step 3: Higher Rule</span>
            <span class="req-step-val">Select Higher Count</span>
            <span class="req-step-cards">Select 2 Cards</span>
          </div>

        </div>

        <div class="req-spotlight-final-box">
          <div class="req-final-text">
            <h4>⚡ Final Calculation for 3-Phase Connection:</h4>
            <p>Higher Requirement (2 Cards) + 3-Phase Extra Card (+1 Card) = <strong>Total 3 Cards Required</strong></p>
          </div>
          <div class="req-final-result-badge">
            Total Needed: <span>3 Cards</span>
          </div>
        </div>

      </div>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "Required Cards Layout",
  "settings": [
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#ec5c0a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff8ef"
    }
  ],
  "presets": [
    {
      "name": "Required Cards Layout"
    }
  ]
}
{% endschema %}
