  font-size: 13.5px;
}

.vscc .chart-table-green td:nth-child(1) {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  color: var(--ink);
  font-size: 14.5px;
  text-align: left;
  white-space: nowrap;
}

.vscc .chart-table-green td:nth-child(2) {
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  color: #5e7568;
  font-size: 13.5px;
  text-align: center;
  white-space: nowrap;
}

.vscc .chart-table-green td:nth-child(3),
.vscc .chart-table-green td:nth-child(4) {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  color: #f0631b;
  font-size: 15px;
  text-align: center;
  white-space: nowrap;
}

@media(max-width: 600px) {
  .vscc .chart-table-green thead th {
    font-size: 10.5px;
    padding: 11px 8px;
  }
  .vscc .chart-table-green td {
    padding: 11px 8px;
    font-size: 12.5px;
  }
  .vscc .chart-table-green td:nth-child(1) {
    font-size: 13px;
  }
  .vscc .chart-table-green td:nth-child(2) {
    font-size: 12.5px;
  }
