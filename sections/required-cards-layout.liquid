/* ---- REAL 3D CARD COMPONENT (STATIC 3D ANGLE) ---- */
.vscc .vscc-3d-container {
  perspective: 1000px;
  width: 100%;
  max-width: 380px;
  margin: 16px auto 14px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.vscc .vscc-3d-card-stage {
  width: 100%;
  aspect-ratio: 1.586 / 1;
  position: relative;
  transform-style: preserve-3d;
  transform: rotateY(-6deg) rotateX(4deg);
  border-radius: 16px;
  box-shadow: 0 16px 36px rgba(0,0,0,0.28), 0 6px 16px rgba(240,99,27,0.2);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.vscc .vscc-3d-container:hover .vscc-3d-card-stage {
  transform: rotateY(0deg) rotateX(0deg) scale(1.02);
  box-shadow: 0 20px 44px rgba(0,0,0,0.32), 0 8px 20px rgba(240,99,27,0.25);
}

.vscc .vscc-3d-face {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.25);
  background: #0d2238;
}

.vscc .vscc-3d-face img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.vscc .vscc-3d-glare {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.22) 50%, transparent 65%);
  pointer-events: none;
  z-index: 3;
}

.vscc .vscc-3d-ribbon {
