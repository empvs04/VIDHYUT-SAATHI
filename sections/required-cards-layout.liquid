.vscc .eg-panel { display: none; }
.vscc .eg-panel.active { display: grid; }
.vscc .eg-card {
  background: var(--panel); border: 1.5px solid var(--line);
  border-radius: 18px; padding: 22px;
  transition: border-color .2s, transform .2s, box-shadow .2s;
}
.vscc .eg-card:hover {
