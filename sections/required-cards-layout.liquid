{%- style -%}
  /* --- Global & Variables (Why Vidhyut Saathi Official Brand Theme) --- */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#F17022' }};
    --req-secondary: #009A44;
    --req-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --req-text-dark: #111111;
    --req-text-light: #475569;
    --req-radius: 20px;
    --req-shadow: 0 16px 45px rgba(241, 112, 34, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(241, 112, 34, 0.16);
    --req-border: rgba(241, 112, 34, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  /* --- Section 1: Hero Header & Master Calculation Matrix (Light Theme) --- */
  .req-hero-section {
    position: relative;
    padding: clamp(45px, 6vw, 80px) 20px 50px 20px;
    background: #FFFFFF;
    color: #111111;
    overflow: hidden;
    border-bottom: 3px solid #F17022;
    box-shadow: 0 10px 40px rgba(241, 112, 34, 0.08);
  }

  /* Vibrant Background Glow Orbs */
  .req-hero-orb-1 {
    position: absolute;
    top: -140px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(241, 112, 34, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
  .req-hero-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 154, 68, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* Left to Right Moving Marquee Text */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 25px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.08;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #F17022, #009A44, #FB5900, #F17022);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 18s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.3);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.1);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #334155;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 40px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: #FFFFFF;
    border: 2px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.12);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #009A44;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 154, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0); }
  }

  .req-hero-header h1 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #111111;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #F17022, #009A44);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #475569;
    max-width: 820px;
    margin: 0 auto;
  }

  /* --- Golden Rule Box (Why Vidhyut Saathi Light Palette) --- */
  .req-golden-banner {
    background: linear-gradient(135deg, #FFF8EF 0%, #FFFFFF 60%, #FFF3E5 100%);
    border: 2.5px solid #F17022;
    border-radius: 22px;
    padding: 20px 24px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 14px 40px rgba(241, 112, 34, 0.14);
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .req-golden-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }
  .req-golden-info h3 {
    color: #F17022;
    font-weight: 900;
    font-size: 1.15rem;
    margin: 0 0 4px 0;
  }
  .req-golden-info p {
    color: #334155;
    font-size: 0.96rem;
    margin: 0;
    line-height: 1.55;
  }
  .req-golden-info strong {
    color: #009A44;
    font-weight: 900;
  }
  .req-golden-pill {
    padding: 10px 20px;
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #FFFFFF;
    font-weight: 900;
    font-size: 0.88rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.3);
  }

  /* --- Section 1: Master Visual Requirement Table --- */
  .req-table-stage {
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.25);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06);
    margin-bottom: 40px;
  }

  .req-table-header-bar {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: linear-gradient(135deg, #F17022 0%, #009A44 100%);
    border-radius: 16px;
    padding: 16px 20px;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    margin-bottom: 14px;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.25);
  }

  .req-mobile-table-header {
    display: none;
  }

  .req-table-rows-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .req-table-row-card {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px 20px;
    align-items: center;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .req-table-row-card:hover {
    background: #FFF7ED;
    border-color: #F17022;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(241, 112, 34, 0.15);
  }

  .req-col-kw {
    font-size: 1.05rem;
    font-weight: 900;
    color: #009A44;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .req-col-bill {
    font-size: 0.98rem;
    font-weight: 800;
    color: #111111;
  }
  .req-col-1phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #009A44;
    background: #E6F4EA;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(0, 154, 68, 0.3);
  }
  .req-col-3phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #F17022;
    background: #FFF7ED;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(241, 112, 34, 0.4);
  }

  .req-row-header-mobile {
    display: contents;
  }
  .req-row-phases-mobile {
    display: contents;
  }

  /* --- Real Scenario Highlight Card (User's Exact Example) --- */
  .req-example-spotlight {
    background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 60%, #E6F4EA 100%);
    border: 2.5px solid #F17022;
    border-radius: 24px;
    padding: 26px 30px;
    box-shadow: 0 16px 45px rgba(241, 112, 34, 0.12);
    margin-top: 20px;
  }

  .req-spotlight-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .req-spotlight-badge {
    background: #009A44;
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 6px 16px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(0, 154, 68, 0.25);
  }
  .req-spotlight-title h3 {
    color: #111111;
    font-size: 1.25rem;
    font-weight: 900;
    margin: 0;
  }

  .req-spotlight-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  @media (max-width: 850px) {
    .req-spotlight-steps-grid {
      grid-template-columns: 1fr;
    }
  }

  .req-step-box {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 16px 18px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .req-step-num {
    font-size: 0.78rem;
    font-weight: 800;
    color: #64748B;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }
  .req-step-val {
    font-size: 1.1rem;
    font-weight: 900;
    color: #F17022;
    margin-bottom: 4px;
    display: block;
  }
  .req-step-cards {
    font-size: 0.88rem;
    font-weight: 800;
    color: #009A44;
    background: #E6F4EA;
    padding: 4px 12px;
    border-radius: 8px;
    display: inline-block;
    border: 1px solid rgba(0, 154, 68, 0.3);
  }

  .req-spotlight-final-box {
    background: linear-gradient(135deg, #F17022 0%, #009A44 100%);
    border-radius: 16px;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #ffffff;
    flex-wrap: wrap;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.25);
  }
  .req-final-text h4 {
    font-size: 1.15rem;
    font-weight: 900;
    margin: 0 0 4px 0;
  }
  .req-final-text p {
    font-size: 0.92rem;
    margin: 0;
    color: #f8fafc;
  }
  .req-final-result-badge {
    background: #ffffff;
    color: #111111;
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 1.25rem;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
  }
  .req-final-result-badge span {
    color: #F17022;
  }

  /* --- 100% Mobile Responsive Optimization --- */
  @media screen and (max-width: 768px) {
    .req-hero-subheading,
    .req-golden-info p {
      text-align: justify !important;
      text-justify: inter-word !important;
    }

    .req-hero-section {
      padding: 24px 10px 30px 10px !important;
    }
    .req-moving-text {
      top: 10px !important;
      font-size: 20px !important;
      opacity: 0.1 !important;
    }
    .hero-breadcrumb-pill {
      padding: 5px 12px !important;
      font-size: 0.74rem !important;
      margin-bottom: 12px !important;
    }
    .req-badge-top {
      font-size: 0.7rem !important;
      padding: 4px 12px !important;
      margin-bottom: 10px !important;
    }
    .req-hero-header h1 {
      font-size: clamp(1.6rem, 5.5vw, 2.0rem) !important;
      margin-bottom: 8px !important;
    }

    .req-table-stage {
      padding: 10px 8px !important;
      border-radius: 18px !important;
    }
    .req-table-header-bar {
      display: none !important;
    }

    /* Mobile Header Guide Bar */
    .req-mobile-table-header {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 8px 12px !important;
      background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%) !important;
      color: #FFFFFF !important;
      font-size: 0.78rem !important;
      font-weight: 900 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.6px !important;
      border-radius: 12px !important;
      margin-bottom: 10px !important;
      border-bottom: 2.5px solid #F17022 !important;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12) !important;
      text-align: center !important;
    }

    /* Mobile 2-Line Clean Row Card */
    .req-table-row-card {
      display: flex !important;
      flex-direction: column !important;
      gap: 6px !important;
      padding: 10px 12px !important;
      border-radius: 14px !important;
      background: #FFFFFF !important;
      border: 1.5px solid #E2E8F0 !important;
      box-shadow: 0 3px 10px rgba(0,0,0,0.03) !important;
    }

    /* Line 1: Top Load & Bill Bar */
    .req-row-header-mobile {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      width: 100% !important;
      padding-bottom: 6px !important;
      border-bottom: 1px dashed #CBD5E1 !important;
    }
    .req-col-kw {
      font-size: 0.94rem !important;
      font-weight: 900 !important;
      color: #009A44 !important;
      justify-content: flex-start !important;
      gap: 4px !important;
    }
    .req-col-bill {
      font-size: 0.84rem !important;
      font-weight: 800 !important;
      color: #1E293B !important;
      text-align: right !important;
    }

    /* Line 2: Side-by-Side Phase Badges */
    .req-row-phases-mobile {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 6px !important;
      width: 100% !important;
    }
    .req-col-1phase, .req-col-3phase {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      font-size: 0.8rem !important;
      font-weight: 900 !important;
      padding: 6px 8px !important;
      border-radius: 10px !important;
      width: 100% !important;
      box-sizing: border-box !important;
      text-align: center !important;
    }
    .req-col-1phase {
      background: #E6F4EA !important;
      border: 1.5px solid #009A44 !important;
      color: #009A44 !important;
    }
    .req-col-3phase {
      background: #FFF7ED !important;
      border: 1.5px solid #F17022 !important;
      color: #C2410C !important;
    }

    .req-golden-banner {
      padding: 16px 12px !important;
      border-radius: 18px !important;
      flex-direction: column !important;
      text-align: center !important;
      gap: 12px !important;
    }
    .req-golden-text {
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
    }
    .req-example-spotlight {
      padding: 18px 14px !important;
      border-radius: 18px !important;
    }
    .req-spotlight-title {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 8px !important;
    }
    .req-spotlight-final-box {
      flex-direction: column !important;
      text-align: center !important;
      align-items: center !important;
    }
  }
{%- endstyle -%}

