<!-- Google Fonts & Font Awesome CDN -->
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800;900&family=Nunito:wght@400;500;600;700;800;900&family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
/* ============================================================
   VIDHYUT SAATHI — CARD CALCULATOR SECTION
   ============================================================ */
.vscc {
  --bg: #faf7ee;
  --panel: #ffffff;
  --panel-2: #fbf8f0;
  --line: #e5e0cf;
  --green: #0e6b3e;
  --green-d: #0a4a2c;
  --green-t: #e6f2ea;
  --orange: #f0631b;
  --orange-t: #fdece1;
  --gold: #c9982e;
  --ink: #16281f;
  --muted: #5e7568;
  --muted-2: #8ba095;
  font-family: 'Nunito', 'Work Sans', sans-serif;
  color: var(--ink);
  background: var(--bg);
  padding: 40px 16px;
  box-sizing: border-box;
}

.vscc * { box-sizing: border-box; }

.vscc .container {
  max-width: 1140px;
  margin: 0 auto;
}

.vscc .sec-head {
  text-align: center;
  max-width: 760px;
  margin: 0 auto 28px;
}

.vscc .sec-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #ffffff 0%, #fdece1 100%);
  border: 1.5px solid #f0631b;
  color: #c2410c;
  font-family: 'Baloo 2', sans-serif;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  padding: 6px 18px;
  border-radius: 999px;
  margin-bottom: 12px;
}

.vscc .sec-head h2 {
  font-family: 'Baloo 2', sans-serif;
  font-size: clamp(26px, 4.5vw, 34px);
  font-weight: 800;
  margin: 0 0 10px;
  color: #16281f;
}

.vscc .sec-head h2 span {
  background: linear-gradient(135deg, #f0631b 0%, #d97706 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.vscc .sec-head p.desc {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.6;
  margin: 0;
}

/* Outer Box Grid */
.vscc .calc-outer-box {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media(min-width: 900px) {
  .vscc .calc-outer-box {
    grid-template-columns: 1.05fr 0.95fr;
    gap: 28px;
    align-items: stretch;
  }
}

/* Left Input Card */
.vscc .c-inputs-card {
  background: linear-gradient(145deg, #ffffff 0%, #fffcf8 100%);
  border: 1.5px solid rgba(240,99,27,0.22);
  border-radius: 20px;
  padding: 24px 26px 20px;
  box-shadow: 0 10px 30px rgba(240,99,27,0.06);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.vscc .field {
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
}

.vscc .field-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.vscc .field-label > span:first-child {
  font-weight: 800;
  font-size: 12.5px;
  text-transform: uppercase;
  color: var(--ink);
}

.vscc .field-val {
  background: var(--orange-t);
  color: var(--orange);
  font-size: 13.5px;
  font-weight: 800;
  padding: 3px 12px;
  border-radius: 8px;
  font-family: 'Baloo 2', sans-serif;
}

.vscc input[type=range] {
  width: 100%;
  -webkit-appearance: none;
  appearance: none;
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--green) 0%, var(--green) var(--fill,10%), var(--line) var(--fill,10%));
  outline: none;
  margin: 6px 0 10px;
  cursor: pointer;
}

.vscc input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--orange);
  border: 3px solid #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  cursor: pointer;
}

.vscc .num-input {
  width: 100%;
  height: 44px;
  background: #ffffff;
  border: 1.5px solid #e5e0cf;
  color: var(--ink);
  font-family: 'Nunito', sans-serif;
  font-size: 15px;
  font-weight: 700;
  padding: 8px 14px;
  border-radius: 10px;
  outline: none;
  transition: border-color .15s, box-shadow .15s;
}

.vscc .num-input:focus {
  border-color: #f0631b;
  box-shadow: 0 0 0 3px rgba(240,99,27,0.15);
}

.vscc .prefix-wrap {
  position: relative;
  width: 100%;
}

.vscc .prefix-wrap .pfx {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted-2);
  font-family: 'Baloo 2', sans-serif;
  font-size: 17px;
  font-weight: 700;
  pointer-events: none;
}

.vscc .prefix-wrap input.num-input {
  padding-left: 32px;
}

.vscc .toggle-grp {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.vscc .tog-btn {
  padding: 10px;
  border-radius: 10px;
  border: 1.5px solid var(--line);
  background: #ffffff;
  color: var(--muted);
  font-weight: 700;
  font-size: 13px;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
  transition: all .15s;
  font-family: 'Baloo 2', sans-serif;
}

.vscc .tog-btn.active {
  border-color: #0a4a2c;
  color: #ffffff;
  background: #0a4a2c;
  box-shadow: 0 4px 12px rgba(10,74,44,.2);
}

.vscc .breakdown {
  background: var(--panel-2);
  border: 1px solid #e7dcce;
  border-radius: 12px;
  padding: 12px 14px;
  font-size: 12.5px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 12px;
}

.vscc .brow {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vscc .brow b {
  color: var(--ink);
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
}

.vscc .brow.win b { color: var(--green); }
.vscc .bdivider { border: none; border-top: 1px dashed var(--line); margin: 6px 0; }

.vscc .calc-note {
  font-size: 11.5px;
  color: var(--muted-2);
  line-height: 1.45;
  padding: 10px 12px;
  background: var(--green-t);
  border-radius: 10px;
  border: 1px solid rgba(14,107,62,.2);
}

/* How It Works Glowing Bulb Button */
@keyframes vsccBulbPulse {
  0%, 100% {
    color: #f59e0b;
    filter: drop-shadow(0 0 2px rgba(245, 158, 11, 0.4));
    transform: scale(1);
  }
  50% {
    color: #fbbf24;
    filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.9)) drop-shadow(0 0 14px rgba(240, 99, 27, 0.6));
    transform: scale(1.18);
  }
}

.vscc .vscc-bulb-glow {
  animation: vsccBulbPulse 1.4s ease-in-out infinite;
  display: inline-block;
  color: #f59e0b;
}

.vscc .vscc-how-it-works-btn {
  background: rgba(240, 99, 27, 0.08);
  border: 1.5px solid rgba(240, 99, 27, 0.3);
  color: #c2410c;
  font-family: 'Baloo 2', sans-serif;
  font-size: 12px;
  font-weight: 800;
  padding: 4px 12px;
  border-radius: 999px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.25s ease;
}

.vscc .vscc-how-it-works-btn:hover {
  background: rgba(240, 99, 27, 0.16);
  border-color: #ea580c;
  transform: translateY(-1px);
}

/* Right Output Card */
.vscc .c-output-card {
  background: #ffffff;
  border: 1.5px solid rgba(10,74,44,0.18);
  border-radius: 20px;
  padding: 24px 26px 20px;
  box-shadow: 0 15px 40px rgba(10,74,44,0.07);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.vscc .res-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--muted-2);
  margin-bottom: 2px;
}

.vscc .res-number {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 46px;
  line-height: 1;
  color: var(--green-d);
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 6px;
}

.vscc .res-number .unit {
  font-size: 16px;
  color: var(--muted);
  font-weight: 700;
  font-family: 'Nunito', sans-serif;
}

/* ---- CASCADING STEPPED CARDS SHOWCASE ---- */
.vscc .vscc-cascade-showcase {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 10px 0 16px 0;
  gap: 14px;
}

.vscc .vscc-top-tier-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 12px;
  width: 100%;
}

.vscc .vscc-cascade-card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1.586 / 1;
  background: #0d2238;
  display: inline-block;
  cursor: pointer;
  flex-shrink: 0;
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: high-quality;
}

.vscc .vscc-cascade-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: high-quality;
}

/* Top Stepped Card Sizes */
.vscc .vscc-cascade-card.vscc-tier-single {
  width: 250px;
  border-radius: 14px;
  border: 1.5px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 18px 40px -6px rgba(0, 0, 0, 0.5), 0 6px 16px rgba(0, 0, 0, 0.22);
}
.vscc .vscc-cascade-card.vscc-tier-single:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 24px 50px -6px rgba(0, 0, 0, 0.58), 0 8px 22px rgba(240, 99, 27, 0.3);
}

.vscc .vscc-cascade-card.vscc-tier-1 {
  width: 200px;
  border-radius: 12px;
  border: 1.5px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.48), 0 4px 14px rgba(0, 0, 0, 0.22);
}
.vscc .vscc-cascade-card.vscc-tier-1:hover {
  transform: translateY(-5px) scale(1.06);
  box-shadow: 0 24px 48px -4px rgba(0, 0, 0, 0.58), 0 8px 22px rgba(240, 99, 27, 0.3);
  z-index: 5;
}

.vscc .vscc-cascade-card.vscc-tier-2 {
  width: 155px;
  border-radius: 10px;
  border: 1.5px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.4);
}
.vscc .vscc-cascade-card.vscc-tier-2:hover {
  transform: translateY(-4px) scale(1.08);
  box-shadow: 0 18px 36px -4px rgba(0, 0, 0, 0.52);
  z-index: 5;
}

.vscc .vscc-cascade-card.vscc-tier-3 {
  width: 115px;
  border-radius: 8px;
  border: 1.2px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 10px 22px -3px rgba(0, 0, 0, 0.36);
}
.vscc .vscc-cascade-card.vscc-tier-3:hover {
  transform: translateY(-4px) scale(1.12);
  box-shadow: 0 16px 30px -3px rgba(0, 0, 0, 0.48);
  z-index: 5;
}

/* Subordinate Grid for 4+ Cards */
.vscc .vscc-sub-tier-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 7px;
  max-width: 480px;
  width: 100%;
  margin: 0 auto;
}

.vscc .vscc-cascade-card.vscc-tier-sub {
  width: 50px;
  height: 31.5px;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.32);
}
.vscc .vscc-cascade-card.vscc-tier-sub:hover {
  transform: translateY(-3px) scale(1.2);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.48);
  z-index: 6;
}

/* Savings Box */
.vscc .savings-box {
  background: linear-gradient(135deg, #0a4a2c, #0e6b3e);
  border-radius: 12px;
  padding: 10px 14px;
  color: #ffffff;
  margin: 8px 0 12px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vscc .savings-label {
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: .08em;
  color: #cfe4d7;
  text-transform: uppercase;
  margin-bottom: 2px;
}

.vscc .savings-amount {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 20px;
  color: #ffffff;
}

.vscc .savings-icon { font-size: 22px; }

/* Action Buttons */
.vscc .calc-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.vscc .btn-wa {
  background: #25D366;
  color: #ffffff;
  font-weight: 800;
  font-size: 13.5px;
  padding: 10px 14px;
  border-radius: 10px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: 'Baloo 2', sans-serif;
  box-shadow: 0 4px 12px rgba(37,211,102,0.25);
}

.vscc .btn-quote {
  background: #ffffff;
  color: #0a4a2c;
  border: 1.5px solid #0e6b3e;
  font-weight: 800;
  font-size: 13.5px;
  padding: 10px 14px;
  border-radius: 10px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-family: 'Baloo 2', sans-serif;
}

/* Modal Popup */
.vscc .vscc-modal {
  position: fixed;
  inset: 0;
  z-index: 999999;
  display: none !important;
  align-items: center;
  justify-content: center;
  padding: 16px;
  pointer-events: none !important;
  visibility: hidden !important;
}

.vscc .vscc-modal.active {
  display: flex !important;
  pointer-events: auto !important;
  visibility: visible !important;
}

.vscc .vscc-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 28, 21, 0.65);
  backdrop-filter: blur(6px);
}
.vscc .vscc-modal-card {
  position: relative;
  width: 100%;
  max-width: 540px;
  background: #ffffff;
  border: 2px solid #fed7aa;
  border-radius: 24px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  z-index: 10;
}
.vscc .vscc-modal-top-bar {
  padding: 16px 20px;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-bottom: 1px solid #fed7aa;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vscc .vscc-modal-close-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid #fed7aa;
  background: #ffffff;
  color: #64748b;
  cursor: pointer;
}
.vscc .vscc-modal-content {
  padding: 20px;
  max-height: 80vh;
  overflow-y: auto;
}
.vscc .vscc-popup-reason-badge {
  background: #f0fdf4;
  border: 1.5px solid #86efac;
  border-radius: 14px;
  padding: 12px 14px;
  color: #14532d;
  font-size: 0.88rem;
  line-height: 1.5;
  margin-bottom: 16px;
}
.vscc .vscc-rules-step-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.vscc .vscc-rule-step-item {
  display: flex;
  gap: 10px;
  background: #f8faf9;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 10px 12px;
}
.vscc .vscc-rule-step-num {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--green);
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: 'Baloo 2', sans-serif;
}
.vscc .vscc-rule-step-info strong {
  font-size: 0.84rem;
  color: #16281f;
  display: block;
}
.vscc .vscc-rule-step-info p {
  font-size: 0.78rem;
  color: #64748b;
  margin: 0;
}

@media(max-width: 600px) {
  .vscc .vscc-top-tier-row { gap: 8px; }
  .vscc .vscc-cascade-card.vscc-tier-single { width: 210px; }
  .vscc .vscc-cascade-card.vscc-tier-1 { width: 145px; }
  .vscc .vscc-cascade-card.vscc-tier-2 { width: 112px; }
  .vscc .vscc-cascade-card.vscc-tier-3 { width: 82px; }
  .vscc .vscc-cascade-card.vscc-tier-sub { width: 44px; height: 28px; }
}
</style>

<div class="vscc" id="vscc-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="sec-head">
      <div class="sec-eyebrow"><i class="fa-solid fa-sliders"></i> {{ section.settings.calc_eyebrow | default: 'INTERACTIVE CARD CALCULATOR' }}</div>
      <h2>{{ section.settings.calc_heading | default: 'Calculate Your Exact' }} <span>{{ section.settings.calc_heading_highlight | default: 'Card Count & Savings' }}</span></h2>
      <p class="desc">{{ section.settings.calc_desc | default: 'Enter your connected load and monthly bill — our dual-check calculation algorithm automatically considers the higher requirement with instant 20%–30% monthly savings projection.' }}</p>
    </div>

    <div class="calc-outer-box">
      <!-- LEFT CONTAINER: INPUTS -->
      <div class="c-inputs-card">
        <!-- Field 1: KW Load -->
        <div class="field">
          <div class="field-label">
            <span>1. Connected Load (KW)</span>
            <span class="field-val" id="vscc-kwVal">6 KW</span>
          </div>
          <input type="range" id="vscc-kwSlider" min="1" max="200" value="6" step="1" aria-label="Connected Load Slider">
          <input type="number" id="vscc-kwNumber" class="num-input" value="6" min="1" max="5000" placeholder="Enter KW load">
        </div>

        <!-- Field 2: Monthly Electricity Bill -->
        <div class="field">
          <div class="field-label">
            <span>2. Average Monthly Bill (₹)</span>
            <span class="field-val" id="vscc-billVal">₹6,000</span>
          </div>
          <div class="prefix-wrap">
            <span class="pfx">₹</span>
            <input type="number" id="vscc-billNumber" class="num-input" value="6000" min="0" max="5000000" step="500" placeholder="e.g. 6000">
          </div>
        </div>

        <!-- Field 3: Highest Bill in Last 12 Months -->
        <div class="field">
          <div class="field-label">
            <span>3. Highest Bill in Last 12 Months (₹)</span>
            <span class="field-val" id="vscc-peakBillVal">₹0</span>
          </div>
          <div class="prefix-wrap">
            <span class="pfx">₹</span>
            <input type="number" id="vscc-peakBillNumber" class="num-input" value="" min="0" max="10000000" step="500" placeholder="Optional peak summer bill">
          </div>
        </div>

        <!-- Field 4: Connection Type with How It Works Button -->
        <div class="field">
          <div class="field-label">
            <span>4. Connection Type</span>
            <button type="button" class="vscc-how-it-works-btn" id="vsccHowItWorksBtn">
              <i class="fa-solid fa-lightbulb vscc-bulb-glow"></i>
              <span>How it works?</span>
            </button>
          </div>
          <div class="toggle-grp">
            <button type="button" class="tog-btn active" id="vscc-btnSingle">⚡ Single Phase</button>
            <button type="button" class="tog-btn" id="vscc-btnThree">⚡⚡⚡ Three Phase</button>
          </div>
        </div>

        <!-- Sizing Logic Breakdown -->
        <div class="breakdown">
          <div class="brow"><span>From KW load (<span id="vscc-kwCards">1</span> @ 6 KW/card):</span><b id="vscc-kwCardsVal">1 Card</b></div>
          <div class="brow"><span>From Avg Bill (<span id="vscc-billCards">1</span> @ ₹6,000/card):</span><b id="vscc-billCardsVal">1 Card</b></div>
          <div class="brow" id="vscc-peakRow" style="display:none;"><span>From 12-Mo Peak (<span id="vscc-peakCards">0</span> @ ₹6,000/card):</span><b id="vscc-peakCardsVal">0 Cards</b></div>
          <hr class="bdivider">
          <div class="brow win"><span>Higher requirement selected:</span><b id="vscc-baseWin">1 Card</b></div>
          <div class="brow" id="vscc-phaseRow" style="display:none;"><span>Three-phase booster:</span><b>+1 Card</b></div>
        </div>
      </div>

      <!-- RIGHT CONTAINER: DYNAMIC CASCADING CARDS DISPLAY -->
      <div class="c-output-card">
        <div>
          <div class="res-label">CARDS REQUIRED</div>
          <div class="res-number">
            <span id="vscc-resultNum">1</span>
            <span class="unit" id="vscc-resultUnit">Card</span>
          </div>
        </div>

        <!-- Cascading Stepped Cards Showcase (Big -> Medium -> Small -> Mini Grid) -->
        <div class="vscc-cascade-showcase" id="vsccCascadeShowcase">
          <div class="vscc-top-tier-row" id="vsccTopTierRow"></div>
          <div class="vscc-sub-tier-grid" id="vsccSubTierGrid"></div>
        </div>

        <!-- Estimated Monthly Savings Banner -->
        <div class="savings-box">
          <div>
            <div class="savings-label">ESTIMATED MONTHLY SAVINGS</div>
            <div class="savings-amount" id="vscc-savingsRange">₹1,200 – ₹1,800</div>
          </div>
          <div class="savings-icon">💡</div>
        </div>

        <!-- Action Buttons -->
        <div class="calc-actions">
          {% assign wa_phone = section.settings.whatsapp_phone | default: '' %}
          {% assign wa_msg = section.settings.whatsapp_message | default: 'Hi, I want to order Vidhyut Saathi Electric Saver Cards' | url_encode %}
          <a href="https://wa.me/{{ wa_phone }}?text={{ wa_msg }}" class="btn-wa" target="_blank">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            {{ section.settings.whatsapp_button_label | default: 'Order on WhatsApp' }}
          </a>
          {% assign quote_tel = section.settings.quote_phone | default: '+919876543210' %}
          <a href="tel:{{ quote_tel }}" class="btn-quote">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {{ section.settings.quote_button_label | default: 'Call for Quote' }}
          </a>
        </div>

        {% if section.settings.custom_liquid != blank %}
          <div class="vscc-custom-liquid" style="margin-top:12px;">{{ section.settings.custom_liquid }}</div>
        {% endif %}
        {% if section.settings.custom_html != blank %}
          <div class="vscc-custom-html" style="margin-top:12px;">{{ section.settings.custom_html }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<!-- HOW IT WORKS POPUP MODAL -->
<div class="vscc-modal" id="vsccModal" style="display:none;" role="dialog" aria-modal="true">
  <div class="vscc-modal-backdrop" id="vsccModalBackdrop"></div>
  <div class="vscc-modal-card">
    <div class="vscc-modal-top-bar">
      <div style="display:flex;align-items:center;gap:8px;">
        <i class="fa-solid fa-lightbulb vscc-bulb-glow" style="font-size:1.2rem;"></i>
        <h3 style="margin:0;font-family:'Baloo 2',sans-serif;">How Sizing Logic & Rules Work</h3>
      </div>
      <button type="button" class="vscc-modal-close-btn" id="vsccModalCloseBtn">✕</button>
    </div>
    <div class="vscc-modal-content">
      <div class="vscc-popup-reason-badge" id="vsccRecReason">
        ⚡ <strong>Smart Selection:</strong> Evaluated across Connected Load (KW), Monthly Bill, and Peak 12-Month Bill.
      </div>
      <div class="vscc-rules-step-list">
        <div class="vscc-rule-step-item">
          <div class="vscc-rule-step-num">1</div>
          <div class="vscc-rule-step-info">
            <strong>Connected Load (KW):</strong>
            <p>1 Vidhyut Saathi Card handles up to 6 KW of connected electrical load (⌈KW ÷ 6⌉).</p>
          </div>
        </div>
        <div class="vscc-rule-step-item">
          <div class="vscc-rule-step-num">2</div>
          <div class="vscc-rule-step-info">
            <strong>Average Monthly Bill:</strong>
            <p>1 Card is rated for up to ₹6,000 monthly bill (2 Cards for ₹12,000, 3 Cards for ₹18,000, etc.).</p>
          </div>
        </div>
        <div class="vscc-rule-step-item">
          <div class="vscc-rule-step-num">3</div>
          <div class="vscc-rule-step-info">
            <strong>Peak 12-Month Bill:</strong>
            <p>If your peak summer bill was higher (e.g. ₹60,000), capacity is sized for that peak so your appliances are 100% protected during heavy load months.</p>
          </div>
        </div>
        <div class="vscc-rule-step-item">
          <div class="vscc-rule-step-num">4</div>
          <div class="vscc-rule-step-info">
            <strong>Three-Phase Booster:</strong>
            <p>Three-phase supplies automatically receive 1 additional booster card to balance inductive loads across all phases (R-Y-B).</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var kwSlider = document.getElementById('vscc-kwSlider');
  var kwNumber = document.getElementById('vscc-kwNumber');
  var kwVal = document.getElementById('vscc-kwVal');
  var billNumber = document.getElementById('vscc-billNumber');
  var billVal = document.getElementById('vscc-billVal');
  var peakBillNumber = document.getElementById('vscc-peakBillNumber');
  var peakBillVal = document.getElementById('vscc-peakBillVal');
  var btnSingle = document.getElementById('vscc-btnSingle');
  var btnThree = document.getElementById('vscc-btnThree');
  var kwCardsEl = document.getElementById('vscc-kwCards');
  var kwCardsVal = document.getElementById('vscc-kwCardsVal');
  var billCardsEl = document.getElementById('vscc-billCards');
  var billCardsVal = document.getElementById('vscc-billCardsVal');
  var peakCardsEl = document.getElementById('vscc-peakCards');
  var peakCardsVal = document.getElementById('vscc-peakCardsVal');
  var peakRow = document.getElementById('vscc-peakRow');
  var baseWinEl = document.getElementById('vscc-baseWin');
  var phaseRow = document.getElementById('vscc-phaseRow');
  var resultNum = document.getElementById('vscc-resultNum');
  var resultUnit = document.getElementById('vscc-resultUnit');
  var recReasonEl = document.getElementById('vsccRecReason');
  var threePhase = false;

  function inr(n){
    return '₹' + Number(n).toLocaleString('en-IN');
  }

  function sync(){
    var kw = Math.max(1, parseFloat(kwNumber.value) || 1);
    var bill = Math.max(0, parseFloat(billNumber.value) || 0);
    var peakBill = Math.max(0, parseFloat(peakBillNumber ? peakBillNumber.value : 0) || 0);

    if (kwVal) kwVal.textContent = kw + ' KW';
    if (billVal) billVal.textContent = inr(bill);
    if (peakBillVal) peakBillVal.textContent = peakBill > 0 ? inr(peakBill) : '₹0';
    if (kwSlider) {
      kwSlider.value = Math.min(kw, 200);
      kwSlider.style.setProperty('--fill', (Math.min(kw,200)/200*100) + '%');
    }

    var kwCards = Math.max(1, Math.ceil(kw / 6));
    var billCards = bill > 0 ? Math.max(1, Math.ceil(bill / 6000)) : 1;
    var peakBillCards = peakBill > 0 ? Math.max(1, Math.ceil(peakBill / 6000)) : 0;
    var base = Math.max(kwCards, billCards, peakBillCards);
    var total = threePhase ? base + 1 : base;

    if (kwCardsEl) kwCardsEl.textContent = kwCards;
    if (kwCardsVal) kwCardsVal.textContent = kwCards + (kwCards > 1 ? ' Cards' : ' Card');
    if (billCardsEl) billCardsEl.textContent = billCards;
    if (billCardsVal) billCardsVal.textContent = billCards + (billCards > 1 ? ' Cards' : ' Card');
    if (peakCardsEl) peakCardsEl.textContent = peakBillCards;
    if (peakCardsVal) peakCardsVal.textContent = peakBillCards + (peakBillCards > 1 ? ' Cards' : ' Card');
    if (peakRow) peakRow.style.display = peakBill > 0 ? 'flex' : 'none';
    if (baseWinEl) baseWinEl.textContent = base + (base > 1 ? ' Cards' : ' Card');
    if (phaseRow) phaseRow.style.display = threePhase ? 'flex' : 'none';
    if (resultNum) resultNum.textContent = total;
    if (resultUnit) resultUnit.textContent = total > 1 ? 'Cards' : 'Card';

    /* Estimated Savings */
    var savingsMin = Math.round((bill * 0.20) / 100) * 100;
    var savingsMax = Math.round((bill * 0.30) / 100) * 100;
    var savingsRangeEl = document.getElementById('vscc-savingsRange');
    if(savingsRangeEl){
      savingsRangeEl.textContent = inr(savingsMin) + ' – ' + inr(savingsMax);
    }

    /* Dynamic Cascading Stepped Cards Showcase */
    var topTierRow = document.getElementById('vsccTopTierRow');
    var subTierGrid = document.getElementById('vsccSubTierGrid');
    {% assign custom_card_img = 'official-vs-card-front.jpg' | asset_url %}
    {% if section.settings.card_image != blank %}
      {% assign custom_card_img = section.settings.card_image | image_url: width: 1000 %}
    {% endif %}
    var cardImgUrl = "{{ custom_card_img }}";

    if (topTierRow && subTierGrid) {
      topTierRow.innerHTML = '';
      subTierGrid.innerHTML = '';

      if (total === 1) {
        var c1 = document.createElement('div');
        c1.className = 'vscc-cascade-card vscc-tier-single';
        c1.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card 1">';
        c1.title = 'Card #1';
        topTierRow.appendChild(c1);
      } else if (total === 2) {
        var c1 = document.createElement('div');
        c1.className = 'vscc-cascade-card vscc-tier-1';
        c1.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card 1">';
        c1.title = 'Card #1';
        topTierRow.appendChild(c1);

        var c2 = document.createElement('div');
        c2.className = 'vscc-cascade-card vscc-tier-2';
        c2.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card 2">';
        c2.title = 'Card #2';
        topTierRow.appendChild(c2);
      } else {
        // total >= 3
        var c1 = document.createElement('div');
        c1.className = 'vscc-cascade-card vscc-tier-1';
        c1.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card 1">';
        c1.title = 'Card #1';
        topTierRow.appendChild(c1);

        var c2 = document.createElement('div');
        c2.className = 'vscc-cascade-card vscc-tier-2';
        c2.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card 2">';
        c2.title = 'Card #2';
        topTierRow.appendChild(c2);

        var c3 = document.createElement('div');
        c3.className = 'vscc-cascade-card vscc-tier-3';
        c3.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card 3">';
        c3.title = 'Card #3';
        topTierRow.appendChild(c3);

        // Subordinate cards (4 to total)
        var capped = Math.min(total, 35);
        for (var i = 3; i < capped; i++) {
          var sub = document.createElement('div');
          sub.className = 'vscc-cascade-card vscc-tier-sub';
          sub.innerHTML = '<img src="' + cardImgUrl + '" alt="Vidhyut Saathi Card ' + (i + 1) + '">';
          sub.title = 'Card #' + (i + 1);
          subTierGrid.appendChild(sub);
        }
        if (total > 35) {
          var more = document.createElement('span');
          more.style.cssText = 'font-family:Baloo 2,sans-serif;color:#f0631b;font-size:12.5px;font-weight:800;align-self:center;margin-left:4px;';
          more.textContent = '+' + (total - 35) + ' more';
          subTierGrid.appendChild(more);
        }
      }
    }
  }

  if (kwSlider) kwSlider.addEventListener('input', function(){ if (kwNumber) kwNumber.value = kwSlider.value; sync(); });
  if (kwNumber) kwNumber.addEventListener('input', sync);
  if (billNumber) billNumber.addEventListener('input', sync);
  if (peakBillNumber) peakBillNumber.addEventListener('input', sync);

  if (btnSingle) {
    btnSingle.addEventListener('click', function(){
      threePhase = false;
      btnSingle.classList.add('active');
      if (btnThree) btnThree.classList.remove('active');
      sync();
    });
  }
  if (btnThree) {
    btnThree.addEventListener('click', function(){
      threePhase = true;
      btnThree.classList.add('active');
      if (btnSingle) btnSingle.classList.remove('active');
      sync();
    });
  }

  /* Modal Handlers */
  var howItWorksBtn = document.getElementById('vsccHowItWorksBtn');
  var modal = document.getElementById('vsccModal');
  var modalBackdrop = document.getElementById('vsccModalBackdrop');
  var modalCloseBtn = document.getElementById('vsccModalCloseBtn');

  function openModal(e){
    if (e) e.preventDefault();
    if(modal){
      modal.classList.add('active');
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }
  function closeModal(){
    if(modal){
      modal.classList.remove('active');
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  if (howItWorksBtn) howItWorksBtn.addEventListener('click', openModal);
  if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

  sync();

  /* Shopify Theme Editor Lifecycle Events */
  document.addEventListener('shopify:section:select', function(e){
    if(e.detail && e.detail.sectionId === '{{ section.id }}'){
      sync();
    }
  });
  document.addEventListener('shopify:section:load', function(e){
    if(e.detail && e.detail.sectionId === '{{ section.id }}'){
      sync();
    }
  });
})();
</script>

