{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --req-secondary: #007b3e;
    --req-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --req-text-dark: #0f172a;
    --req-text-light: #334155;
    --req-radius: 24px;
    --req-shadow: 0 16px 45px rgba(0, 0, 0, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(236, 92, 10, 0.16);
    --req-border: rgba(236, 92, 10, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: radial-gradient(circle at 50% 0%, rgba(236, 92, 10, 0.06) 0%, #ffffff 45%, rgba(0, 123, 62, 0.05) 100%);
    overflow: hidden;
  }

  /* --- Section 1: Hero Header & Master Calculation Banner --- */
  .req-hero-section {
    position: relative;
    padding: clamp(60px, 8vw, 95px) 20px 60px 20px;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    color: #ffffff;
    overflow: hidden;
    border-bottom: 3px solid rgba(255, 204, 0, 0.4);
  }

  /* Left to Right Moving Marquee Text */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 35px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 18s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 50px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffcc00;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 18px;
    box-shadow: 0 6px 20px rgba(255, 204, 0, 0.15);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
  }

  .req-hero-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 16px;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #ffcc00, #ec5c0a, #00ff66);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-top: 6px;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 820px;
    margin: 0 auto;
  }

  /* --- Section 1: Main 2-Column Split Showcase Grid --- */
  .req-sec1-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 992px) {
    .req-sec1-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 50px;
    }
  }

  /* Left Side: 3D Product Showcase Card */
  .req-card-stage {
    position: relative;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 204, 0, 0.4);
    border-radius: 28px;
    padding: 24px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.7), 0 0 50px rgba(236, 92, 10, 0.25);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    text-align: center;
  }
  .req-card-stage:hover {
    border-color: rgba(255, 204, 0, 0.9);
    box-shadow: 0 40px 100px rgba(0,0,0,0.85), 0 0 75px rgba(236, 92, 10, 0.4);
    transform: translateY(-6px);
  }

  .req-card-img-wrapper {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    position: relative;
  }
  .req-card-img-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 20px;
  }

  .req-card-pills-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .req-card-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 204, 0, 0.35);
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ffcc00;
  }

  /* Right Side: Golden Calculation Rules Box */
  .req-rules-container {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .req-rule-box {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 2px solid rgba(256, 120, 20, 0.3);
    border-radius: 22px;
    padding: 24px 28px;
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
  }
  .req-rule-box:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #ec5c0a;
    transform: translateX(6px);
    box-shadow: 0 15px 35px rgba(236, 92, 10, 0.2);
  }

  .req-rule-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .req-rule-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: linear-gradient(135deg, #ec5c0a, #ff9900);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #ffffff;
    flex-shrink: 0;
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.4);
  }
  .req-rule-title {
    font-size: 1.2rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }
  .req-rule-title span {
    color: #ffcc00;
  }

  .req-rule-desc {
    font-size: 0.98rem;
    line-height: 1.7;
    color: #cbd5e1;
    margin: 0;
  }
  .req-rule-desc strong {
    color: #ffffff;
    background: rgba(236, 92, 10, 0.25);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(236, 92, 10, 0.4);
  }
  .req-rule-desc .highlight-yellow {
    color: #000000;
    background: #ffcc00;
    font-weight: 900;
    padding: 2px 8px;
    border-radius: 6px;
  }

  /* 4 Feature Badges Grid at Bottom of Section 1 */
  .req-badges-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 8px;
  }
  @media (min-width: 600px) {
    .req-badges-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .req-feature-badge {
    background: rgba(0, 123, 62, 0.12);
    border: 1px solid rgba(0, 255, 102, 0.3);
    border-radius: 16px;
    padding: 12px 14px;
    text-align: center;
    transition: all 0.3s ease;
  }
  .req-feature-badge:hover {
    background: rgba(0, 123, 62, 0.25);
    border-color: #00ff66;
    transform: translateY(-3px);
  }
  .req-feature-badge .b-icon {
    font-size: 1.4rem;
    display: block;
    margin-bottom: 4px;
  }
  .req-feature-badge .b-text {
    font-size: 0.8rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
    display: block;
  }

  /* --- Mobile Responsive Fixes --- */
  @media screen and (max-width: 768px) {
    .req-hero-section {
      padding: 45px 14px 45px 14px !important;
    }
    .req-moving-text {
      top: 20px !important;
      font-size: 28px !important;
    }
    .hero-breadcrumb-pill {
      padding: 6px 16px !important;
      font-size: 0.78rem !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
    }
    .req-badge-top {
      font-size: 0.72rem !important;
      padding: 6px 14px !important;
    }
    .req-hero-header h1 {
      font-size: clamp(1.8rem, 6.5vw, 2.4rem) !important;
    }
    .req-hero-header h1 span {
      font-size: clamp(1.3rem, 4.5vw, 1.8rem) !important;
    }
    .req-hero-subheading {
      font-size: 0.88rem !important;
      line-height: 1.6 !important;
    }
    .req-card-stage {
      padding: 16px !important;
      border-radius: 20px !important;
    }
    .req-rule-box {
      padding: 18px 16px !important;
      border-radius: 18px !important;
    }
    .req-rule-title {
      font-size: 1.05rem !important;
    }
    .req-rule-desc {
      font-size: 0.88rem !important;
      line-height: 1.6 !important;
    }
    .req-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
    }
  }
{%- endstyle -%}

<div class="req-wrapper">
  
  <!-- ==========================================
       SECTION 1: HERO HEADER & MASTER CALCULATION RULES
       ========================================== -->
  <section class="req-hero-section">
    <div class="req-moving-text">Required Vidhyut Saathi Card &nbsp; &nbsp; Card Estimation Guide &nbsp; &nbsp; Electric Power Saver</div>

    <div class="req-hero-container">
      
      <!-- Top Breadcrumb & Badge -->
      <div class="text-center">
        <div class="hero-breadcrumb-pill">
          <a href="/">Home</a>
          <span style="color: #ffcc00;">/</span>
          <span style="color: #ffffff; font-weight: 700;">Required Cards</span>
          <span style="color: rgba(255,255,255,0.3); margin: 0 4px;">|</span>
          <span style="color: #ffcc00; font-weight: 800;"><span class="pulse-dot"></span> Calculation Guide</span>
        </div>
      </div>

      <div class="req-hero-header">
        <div class="req-badge-top">
          <span class="pulse-dot"></span>
          <span>⚡ INDIA'S NO. 1 ELECTRIC SAVER CARD COMPANY</span>
        </div>
        <h1>Required Vidhyut Saathi Card <span>Master Calculation &amp; Selection Guide</span></h1>
        <p class="req-hero-subheading">Calculate your exact required card quantity based on your KW Sanctioned Load, Monthly Electricity Bill, and 1-Phase or 3-Phase Meter Connection.</p>
      </div>

      <!-- Main Section 1 Split Grid -->
      <div class="req-sec1-grid">
        
        <!-- Left Side: 3D Product Card Showcase -->
        <div class="req-card-stage">
          <div class="req-card-img-wrapper">
            {%- assign saver_card_img = 'vidhyut-power-saver-card.jpg' | asset_url -%}
            <img src="{{ saver_card_img }}" alt="Vidhyut Saathi Electric Power Saving Card" loading="lazy" width="800" height="800">
          </div>
          
          <div class="req-card-pills-bar">
            <span class="req-card-pill">⚡ Save Electricity</span>
            <span class="req-card-pill">₹ Save Money</span>
            <span class="req-card-pill">🌍 Save Environment</span>
          </div>
        </div>

        <!-- Right Side: Master Golden Calculation Rules Box -->
        <div class="req-rules-container">
          
          <!-- Golden Rule 1: Higher Requirement Rule -->
          <div class="req-rule-box">
            <div class="req-rule-header">
              <div class="req-rule-icon">🧮</div>
              <h3 class="req-rule-title">Golden Calculation Rule: <span>Always Consider Higher Requirement</span></h3>
            </div>
            <p class="req-rule-desc">
              Calculate by <strong>BOTH KW Connected Load</strong> &amp; <strong>Monthly Bill Amount (₹)</strong> — <span class="highlight-yellow">Always Consider the Higher Requirement</span>. Choose whichever calculation yields more cards to ensure optimal energy savings.
            </p>
          </div>

          <!-- Golden Rule 2: 3-Phase Connection Rule -->
          <div class="req-rule-box">
            <div class="req-rule-header">
              <div class="req-rule-icon">⚡</div>
              <h3 class="req-rule-title">3-Phase Connection Rule: <span>Add 1 Extra Card</span></h3>
            </div>
            <p class="req-rule-desc">
              For any premises having a <strong>3-Phase Meter Connection</strong>, simply add <strong>+1 Extra Card</strong> to the higher requirement calculated above. (Formula: <code>Final Cards = Higher Requirement + 1 Extra Card</code>).
            </p>
          </div>

          <!-- 4 Feature Badges Grid -->
          <div class="req-badges-grid">
            <div class="req-feature-badge">
              <span class="b-icon">⏳</span>
              <span class="b-text">10 YEARS Long Life</span>
            </div>
            <div class="req-feature-badge">
              <span class="b-icon">🛡️</span>
              <span class="b-text">3 YEARS Warranty</span>
            </div>
            <div class="req-feature-badge">
              <span class="b-icon">🌱</span>
              <span class="b-text">100% Eco-Friendly</span>
            </div>
            <div class="req-feature-badge">
              <span class="b-icon">⚖️</span>
              <span class="b-text">100% Legal to Use</span>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "Required Cards Layout",
  "settings": [
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#ec5c0a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff8ef"
    }
  ],
  "presets": [
    {
      "name": "Required Cards Layout"
    }
  ]
}
{% endschema %}
