{%- style -%}
  /* ==========================================================================
     REQUIRED CARDS LAYOUT — OFFICIAL WHY VIDHYUT SAATHI LIGHT THEME PALETTE
     ========================================================================== */
  :root {
    --req-primary: #F17022;
    --req-secondary: #009A44;
    --req-bg-light: #FFFFFF;
    --req-bg-subtle: #FFF7ED;
    --req-bg-card: #F8FAFC;
    --req-text-main: #111111;
    --req-text-muted: #475569;
    --req-border-light: rgba(241, 112, 34, 0.2);
    --req-shadow-soft: 0 10px 30px rgba(241, 112, 34, 0.08);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-main);
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  /* --- SECTION 1: HERO HEADER & INTERACTIVE CARD TABS (LIGHT THEME) --- */
  .req-hero-section {
    position: relative;
    padding: clamp(40px, 5vw, 75px) 20px 65px 20px;
    background: #FFFFFF;
    color: #111111;
    overflow: hidden;
    border-bottom: 3px solid #F17022;
    box-shadow: 0 10px 40px rgba(241, 112, 34, 0.08);
  }

  /* Radiant Ambient Glow Orbs */
  .req-hero-orb-1 {
    position: absolute;
    top: -140px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(241, 112, 34, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .req-hero-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 154, 68, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* Moving Marquee Background Text (Light Theme) */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .req-moving-text {
    position: absolute;
    top: 25px;
    left: 0;
    width: 200%;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.08;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(45px, 7.5vw, 110px);
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
    background: linear-gradient(90deg, #F17022, #009A44, #FB5900, #F17022);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 20s linear infinite;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Breadcrumb & Top Badge */
  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: #FFFFFF;
    border: 1.5px solid rgba(241, 112, 34, 0.25);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.1);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #111111;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .req-hero-header {
    text-align: center;
    max-width: 940px;
    margin: 0 auto 36px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 24px;
    background: #FFF7ED;
    border: 1.5px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.12);
  }
  .req-badge-top .pulse-dot {
    width: 9px;
    height: 9px;
    background-color: #009A44;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 154, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0); }
  }

  .req-hero-header h1 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.3rem, 4.8vw, 3.6rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #111111;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    color: #F17022;
    font-weight: 900;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #475569;
    max-width: 840px;
    margin: 0 auto;
  }

  /* Ultra-Lucrative Golden Rule Glass Card */
  .req-golden-banner {
    background: linear-gradient(135deg, #FFF8EF 0%, #FFFFFF 50%, #FFF3E5 100%);
    border: 2px solid #F17022;
    border-radius: 26px;
    padding: 28px 34px;
    margin-bottom: 40px;
    box-shadow: 0 20px 50px rgba(241, 112, 34, 0.16), inset 0 1px 0 #ffffff;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 22px;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .req-golden-banner:hover {
    box-shadow: 0 25px 60px rgba(241, 112, 34, 0.22), inset 0 1px 0 #ffffff;
    transform: translateY(-2px);
  }
  .req-golden-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .req-golden-icon {
    width: 54px;
    height: 54px;
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #ffffff;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    flex-shrink: 0;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.3);
  }
  .req-golden-info h3 {
    color: #F17022;
    font-weight: 900;
    font-size: 1.25rem;
    margin: 0 0 4px 0;
    letter-spacing: -0.3px;
  }
  .req-golden-info p {
    color: #334155;
    font-size: 0.98rem;
    margin: 0;
    line-height: 1.55;
  }
  .req-golden-info p strong {
    color: #111111;
    font-weight: 800;
  }
  .req-golden-pill {
    padding: 12px 24px;
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #FFFFFF;
    font-weight: 900;
    font-size: 0.95rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 10px 25px rgba(241, 112, 34, 0.35);
    border: 2px solid #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Golden Rule Formula Grid (3 Mini Formula Cards) */
  .req-golden-formula-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    border-top: 1.5px dashed rgba(241, 112, 34, 0.25);
    padding-top: 18px;
  }
  @media (max-width: 768px) {
    .req-golden-formula-grid {
      grid-template-columns: 1fr;
    }
  }
  .req-formula-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(241, 112, 34, 0.2);
    border-radius: 16px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .req-formula-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .req-formula-text span {
    display: block;
    font-size: 0.76rem;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
  }
  .req-formula-text strong {
    display: block;
    font-size: 0.98rem;
    font-weight: 900;
    color: #111111;
  }

  /* Interactive 3D Card Requirement Tabs Navigation */
  .req-tabs-wrapper {
    margin-bottom: 35px;
  }
  .req-tabs-helper-label {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 900;
    color: #F17022;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .req-tabs-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.22);
    border-radius: 60px;
    padding: 12px;
    box-shadow: 0 15px 45px rgba(241, 112, 34, 0.08);
  }

  .req-tab-btn {
    padding: 11px 22px;
    background: #FAF9F6;
    border: 1.5px solid #E2E8F0;
    border-radius: 50px;
    color: #334155;
    font-size: 0.92rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
  }
  .req-tab-btn:hover {
    color: #F17022;
    background: #FFF7ED;
    border-color: #F17022;
  }
  .req-tab-btn.active {
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #ffffff !important;
    border-color: #F17022;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.35);
    transform: translateY(-2px);
  }
  .req-tab-btn .tab-count {
    background: #E2E8F0;
    color: #1e293b;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 900;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .req-tab-btn.active .tab-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Tab Content Panels Stage */
  .req-tab-panel {
    display: none;
    animation: fadeInTab 0.4s ease forwards;
  }
  .req-tab-panel.active {
    display: block;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Lucrative Card Info Dashboard Box (Light Theme) */
  .req-card-info-dashboard {
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.2);
    border-radius: 28px;
    padding: 34px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.07);
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 992px) {
    .req-card-info-dashboard {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }

  .req-info-details-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .req-dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1.5px solid #E2E8F0;
    padding-bottom: 16px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .req-dash-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: #111111;
    margin: 0;
  }
  .req-dash-title span {
    color: #F17022;
  }
  .req-dash-tag {
    background: #E6F4EA;
    border: 1px solid rgba(0, 154, 68, 0.3);
    color: #009A44;
    font-size: 0.85rem;
    font-weight: 900;
    padding: 6px 16px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .req-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .req-spec-box {
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 16px 18px;
    transition: all 0.3s ease;
  }
  .req-spec-box:hover {
    background: #FFF7ED;
    border-color: rgba(241, 112, 34, 0.4);
    transform: translateY(-2px);
  }
  .req-spec-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 4px;
  }
  .req-spec-value {
    font-size: 1.12rem;
    font-weight: 900;
    color: #111111;
    display: block;
  }
  .req-spec-value .highlight {
    color: #009A44;
  }
  .req-spec-value .highlight-orange {
    color: #F17022;
  }

  .req-apps-banner {
    background: #E6F4EA;
    border: 1.5px solid rgba(0, 154, 68, 0.3);
    border-radius: 18px;
    padding: 18px 20px;
  }
  .req-apps-banner h4 {
    font-size: 1rem;
    font-weight: 900;
    color: #009A44;
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .req-apps-banner p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: #334155;
    margin: 0;
  }

  .req-info-visual-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 22px;
    padding: 24px;
    text-align: center;
  }

  /* Continuous 360° 3D Double-Sided Spin Animation (Upright Image & Text) */
  @keyframes rotate360Card {
    0% {
      transform: perspective(1000px) rotateY(0deg) translateY(0px);
      box-shadow: 0 15px 35px rgba(241, 112, 34, 0.18);
    }
    50% {
      transform: perspective(1000px) rotateY(180deg) translateY(-8px);
      box-shadow: 0 25px 45px rgba(241, 112, 34, 0.28);
    }
    100% {
      transform: perspective(1000px) rotateY(360deg) translateY(0px);
      box-shadow: 0 15px 35px rgba(241, 112, 34, 0.18);
    }
  }

  .req-card-thumb-wrapper {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1.58 / 1;
    border-radius: 18px;
    box-shadow: 0 15px 35px rgba(241, 112, 34, 0.18);
    border: 2.5px solid #F17022;
    margin-bottom: 18px;
    position: relative;
    transform-style: preserve-3d;
    animation: rotate360Card 7s linear infinite;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    background: transparent;
  }
  .req-card-thumb-wrapper:hover {
    animation-play-state: paused;
    transform: perspective(1000px) scale(1.06) rotateY(0deg);
    box-shadow: 0 30px 55px rgba(241, 112, 34, 0.35);
  }

  /* Double-Sided 3D Card Faces (Front & Back Upright) */
  .req-card-face {
    width: 100%;
    height: 100%;
    border-radius: 15px;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    position: absolute;
    top: 0;
    left: 0;
    background: transparent;
  }
  .req-card-face img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
    border-radius: 15px;
  }
  .req-card-front {
    z-index: 2;
    transform: rotateY(0deg);
  }
  .req-card-back {
    z-index: 1;
    transform: rotateY(180deg);
  }

  .req-savings-tag {
    font-size: 1.1rem;
    font-weight: 900;
    color: #F17022;
    margin-bottom: 16px;
    background: #FFF7ED;
    padding: 8px 20px;
    border-radius: 50px;
    border: 1.5px solid rgba(241, 112, 34, 0.3);
  }

  .req-tab-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 28px;
    background: linear-gradient(135deg, #F17022, #FB5900);
    color: #ffffff !important;
    font-size: 1.05rem;
    font-weight: 900;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(241, 112, 34, 0.35);
    transition: all 0.3s ease;
  }
  .req-tab-order-btn:hover {
    background: linear-gradient(135deg, #009A44, #007b3e);
    transform: translateY(-3px);
  }

  .req-multi-rows-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 14px;
  }

  .req-multi-row-card {
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .req-multi-row-kw {
    font-size: 0.98rem;
    font-weight: 900;
    color: #009A44;
  }
  .req-multi-row-bill {
    font-size: 0.82rem;
    color: #64748b;
  }
  .req-multi-row-cards {
    background: #FFF7ED;
    border: 1px solid #F17022;
    color: #F17022;
    font-size: 0.92rem;
    font-weight: 900;
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
  }


  /* ==========================================
     SECTION 2: REDESIGNED REAL-WORLD EXAMPLES (100% ENGLISH & MOBILE OPTIMIZED)
     ========================================== */
  .req-sec2-section {
    padding: clamp(60px, 8vw, 100px) 20px;
    background: linear-gradient(180deg, #FAF9F6 0%, #FFFFFF 100%);
    position: relative;
    border-top: 2px dashed rgba(241, 112, 34, 0.15);
  }
  .req-sec2-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .req-sec2-header {
    text-align: center;
    max-width: 920px;
    margin: 0 auto 35px auto;
  }

  .req-sec2-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 24px;
    background: #FFF7ED;
    border: 1.5px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.1);
  }

  .req-sec2-header h2 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    color: #111111;
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .req-sec2-header h2 span {
    background: linear-gradient(90deg, #F17022, #009A44);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .req-sec2-header p {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.7;
    margin: 0;
  }

  /* 3-Step Selection Visual Guide Banner */
  .req-sec2-guide-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.2);
    border-radius: 24px;
    padding: 22px 28px;
    margin-bottom: 45px;
    box-shadow: 0 15px 40px rgba(241, 112, 34, 0.07);
    align-items: center;
  }
  @media (min-width: 768px) {
    .req-sec2-guide-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
    }
  }

  .req-guide-step {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    transition: all 0.3s ease;
  }
  .req-guide-step.highlight-step {
    background: #FFF7ED;
    border-color: #F17022;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.15);
  }
  .req-step-num {
    background: #F17022;
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 4px 10px;
    border-radius: 50px;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .req-step-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }
  .req-step-content strong {
    display: block;
    font-size: 0.98rem;
    color: #111111;
    font-weight: 800;
  }
  .req-step-content span {
    display: block;
    font-size: 0.82rem;
    color: #64748b;
  }
  .req-guide-arrow {
    font-size: 1.4rem;
    color: #F17022;
    font-weight: 900;
    text-align: center;
  }

  /* Sector Switcher Tabs Navigation (Light Theme 3D Dock) */
  .req-sector-tabs-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin: 0 auto 45px auto;
    flex-wrap: wrap;
    background: #FFFFFF;
    padding: 12px 18px;
    border-radius: 60px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    border: 2px solid rgba(241, 112, 34, 0.18);
    max-width: 1100px;
  }
  
  .req-sector-tab {
    padding: 14px 28px;
    background: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 800;
    color: #334155;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    min-height: 52px;
  }

