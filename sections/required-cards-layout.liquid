}

/* ---- SECTION 3 REQUIREMENT CHART TABLE (EXACT MATCH FOR USER MOBILE PHOTO) ---- */
.vscc .chart-outer-box {
  background: #ffffff;
  border: 1.5px solid #e5e0cf;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  margin-top: 20px;
}

.vscc .chart-table-green {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
}

.vscc .chart-table-green thead tr {
  background: #0a4a2c;
}

.vscc .chart-table-green thead th {
  color: #ffffff;
  font-family: 'Work Sans', sans-serif;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 13px 12px;
  white-space: nowrap;
}

.vscc .chart-table-green tbody tr {
