.vscc .badge-item .lbl { font-size: 11.5px; color: var(--muted); margin-top: 6px; line-height: 1.4; }

/* ---- CTA ---- */
.vscc .cta-band {
  background: linear-gradient(135deg, var(--green-d), var(--green));
  border-radius: 22px; color: #fff; padding: 40px 28px; text-align: center;
  position: relative; overflow: hidden;
}
.vscc .cta-band::before {
  content: ''; position: absolute; top: -80px; right: -80px; width: 260px; height: 260px;
  background: radial-gradient(circle, rgba(255,255,255,.12), transparent 70%); pointer-events: none;
}
@media(min-width:640px){ .vscc .cta-band { padding: 56px 48px; } }
