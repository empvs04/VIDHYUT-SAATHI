<style>
  /* ============ VIDHYUT SAATHI — CARD CALCULATOR PAGE ============ */
  .vsc-calc-page {
    --bg:#faf7ee;
    --bg-warm:#f3efe1;
    --panel:#ffffff;
    --panel-2:#fbf8f0;
    --line:#e5e0cf;
    --line-soft:#eeead9;
    --green:#0e6b3e;
    --green-deep:#0a4a2c;
    --green-tint:#e6f2ea;
    --orange:#f0631b;
    --orange-tint:#fdece1;
    --gold:#c9982e;
    --ink:#16281f;
    --muted:#5e7568;
    --muted-2:#8ba095;
    --radius:14px;
    --maxw:1140px;
    --tap:48px;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    font-size: 16px;
  }
  .vsc-calc-page *, .vsc-calc-page *::before, .vsc-calc-page *::after { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  .vsc-calc-page h1, .vsc-calc-page h2, .vsc-calc-page h3 { font-family: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.01em; }
  .vsc-calc-page .mono { font-family: 'IBM Plex Mono', monospace; }
  .vsc-calc-page a { color: inherit; }
  .vsc-calc-page .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 20px; }
  @media(min-width:640px){ .vsc-calc-page .wrap { padding: 0 32px; } }
  .vsc-calc-page img { max-width: 100%; display: block; }
  .vsc-calc-page button { font-family: inherit; }

  .vsc-calc-page .texture-bg {
    position: absolute; inset: 0; z-index: 0;
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 38px 38px;
    -webkit-mask-image: radial-gradient(ellipse 75% 55% at 50% 15%, black 35%, transparent 85%);
            mask-image: radial-gradient(ellipse 75% 55% at 50% 15%, black 35%, transparent 85%);
  }

  /* HERO */
  .vsc-calc-page .hero { position: relative; padding: 44px 0 40px; overflow: hidden; }
  @media(min-width:760px){ .vsc-calc-page .hero { padding: 74px 0 56px; } }
  .vsc-calc-page .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--green); font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase;
    border: 1px solid var(--green); padding: 7px 12px; border-radius: 999px;
    margin-bottom: 20px; background: var(--green-tint);
  }
  .vsc-calc-page .eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 3px var(--orange-tint); }
  .vsc-calc-page .hero h1 {
    font-size: clamp(28px, 7.2vw, 58px);
    line-height: 1.08; font-weight: 700; margin: 0 0 16px; max-width: 820px;
  }
  .vsc-calc-page .hero h1 em { font-style: normal; color: var(--orange); }
  .vsc-calc-page .hero p.lead {
    color: var(--muted); font-size: clamp(15px, 3.6vw, 17px); line-height: 1.6; max-width: 560px; margin: 0 0 26px;
  }
  .vsc-calc-page .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .vsc-calc-page .btn-primary {
    background: var(--orange); color: #fff; font-weight: 700;
    padding: 14px 24px; border-radius: 10px; text-decoration: none; font-size: 15px;
    box-shadow: 0 8px 20px -8px rgba(240,99,27,.5);
    border: none; cursor: pointer; min-height: var(--tap); display: inline-flex; align-items: center; justify-content: center;
    width: 100%;
  }
  .vsc-calc-page .btn-ghost {
    border: 1.5px solid var(--green); color: var(--green);
    padding: 14px 24px; border-radius: 10px; text-decoration: none; font-size: 15px; font-weight: 700;
    min-height: var(--tap); display: inline-flex; align-items: center; justify-content: center;
    width: 100%; background: #fff;
  }
  @media(min-width:520px){ .vsc-calc-page .btn-primary, .vsc-calc-page .btn-ghost { width: auto; } }

  /* SECTION */
  .vsc-calc-page .section { padding: 48px 0; }
  @media(min-width:760px){ .vsc-calc-page .section { padding: 68px 0; } }
  .vsc-calc-page .section-head { max-width: 640px; margin: 0 0 28px; }
  @media(min-width:760px){ .vsc-calc-page .section-head { margin-bottom: 38px; } }
  .vsc-calc-page .section-eyebrow {
    font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--orange); margin-bottom: 8px; font-weight: 600;
  }
  .vsc-calc-page .section h2 { font-size: clamp(22px, 5.4vw, 32px); margin: 0 0 10px; font-weight: 700; }
  .vsc-calc-page .section p.desc { color: var(--muted); font-size: 15px; line-height: 1.6; margin: 0; }

  /* CALCULATOR */
  .vsc-calc-page .calc {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 20px;
    display: grid; grid-template-columns: 1fr;
    overflow: hidden;
    box-shadow: 0 1px 0 rgba(0,0,0,.02), 0 20px 40px -24px rgba(10,74,44,.15);
  }
  @media(min-width:860px){ .vsc-calc-page .calc { grid-template-columns: 1fr 1fr; } }

  .vsc-calc-page .calc-inputs { padding: 22px; }
  @media(min-width:520px){ .vsc-calc-page .calc-inputs { padding: 30px; } }
  @media(min-width:860px){ .vsc-calc-page .calc-inputs { padding: 36px; border-right: 1px solid var(--line); } }

  .vsc-calc-page .field { margin-bottom: 24px; }
  .vsc-calc-page .field label {
    display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
    font-weight: 700; color: var(--ink); margin-bottom: 12px;
    font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase;
  }
  .vsc-calc-page .field label .val {
    font-family: 'IBM Plex Mono', monospace; color: var(--orange); font-size: 16px; font-weight: 700;
  }
  .vsc-calc-page input[type=range] {
    width: 100%; -webkit-appearance: none; appearance: none;
    height: 8px; border-radius: 999px;
    background: linear-gradient(90deg, var(--green) 0%, var(--green) var(--fill,10%), var(--line) var(--fill,10%));
    outline: none; margin: 6px 0; touch-action: pan-y;
  }
  .vsc-calc-page input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%;
    background: var(--orange); border: 4px solid #fff; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  .vsc-calc-page input[type=range]::-moz-range-thumb {
    width: 26px; height: 26px; border-radius: 50%; background: var(--orange);
    border: 4px solid #fff; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  .vsc-calc-page .num-input {
    width: 100%; background: var(--panel-2); border: 1.5px solid var(--line);
    color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-size: 16px;
    padding: 13px 14px; border-radius: 10px; outline: none; min-height: var(--tap);
  }
  .vsc-calc-page .num-input:focus { border-color: var(--orange); background: #fff; }
  .vsc-calc-page .prefix-wrap { position: relative; }
  .vsc-calc-page .prefix-wrap .prefix {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: var(--muted-2); font-family: 'IBM Plex Mono', monospace; pointer-events: none; font-size: 16px;
  }
  .vsc-calc-page .prefix-wrap input { padding-left: 30px; }

  .vsc-calc-page .toggle-group { display: flex; gap: 10px; }
  .vsc-calc-page .toggle-btn {
    flex: 1; padding: 12px 8px; border-radius: 10px; border: 1.5px solid var(--line);
    background: var(--panel-2); color: var(--muted); font-weight: 700; font-size: 13.5px;
    cursor: pointer; text-align: center; transition: .15s; min-height: var(--tap);
    display: flex; align-items: center; justify-content: center;
  }
  .vsc-calc-page .toggle-btn.active {
    border-color: var(--green); color: var(--green); background: var(--green-tint);
  }

  /* OUTPUT */
  .vsc-calc-page .calc-output {
    padding: 22px; display: flex; flex-direction: column;
    background: var(--panel-2);
  }
  @media(min-width:520px){ .vsc-calc-page .calc-output { padding: 30px; } }
  @media(min-width:860px){ .vsc-calc-page .calc-output { padding: 36px; background: var(--panel); } }

  .vsc-calc-page .result-headline { color: var(--muted); font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; text-transform: uppercase; letter-spacing: .12em; margin-bottom: 8px; font-weight: 600; }
  .vsc-calc-page .result-number {
    font-family: 'Space Grotesk', sans-serif; font-weight: 700;
    font-size: clamp(46px, 13vw, 68px); line-height: 1; color: var(--green-deep);
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  .vsc-calc-page .result-number span.unit { font-size: 16px; color: var(--muted); font-weight: 600; font-family: 'Inter'; }

  .vsc-calc-page .card-mock {
    margin: 20px 0; padding: 14px 16px; border-radius: 12px; position: relative; overflow: hidden;
    background: linear-gradient(135deg, #0b2440, #173a5c 55%, #0b2440);
    min-height: 78px; display: flex; flex-direction: column; justify-content: space-between;
  }
  .vsc-calc-page .card-mock .banner {
    position: absolute; top: 8px; right: -30px; background: var(--orange); color: #fff;
    font-size: 9px; font-weight: 700; padding: 3px 34px; transform: rotate(28deg);
    letter-spacing: .03em;
  }
  .vsc-calc-page .card-mock .chip-real { width: 26px; height: 18px; border-radius: 3px; background: linear-gradient(135deg, #e8c766, var(--gold)); }
  .vsc-calc-page .card-mock .label { color: #cfe0f0; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: .06em; }

  .vsc-calc-page .chip-meter { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .vsc-calc-page .chip-icon {
    width: 22px; height: 15px; border-radius: 3px;
    background: var(--line); border: 1px solid var(--line);
    transition: .2s;
  }
  .vsc-calc-page .chip-icon.lit { background: linear-gradient(135deg, #e8c766, var(--gold)); border-color: var(--gold); }

  .vsc-calc-page .breakdown {
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px; font-size: 13.5px; color: var(--muted); line-height: 1.9;
    margin-bottom: 16px;
  }
  @media(min-width:860px){ .vsc-calc-page .breakdown { background: var(--panel-2); } }
  .vsc-calc-page .breakdown .row { display: flex; justify-content: space-between; gap: 12px; }
  .vsc-calc-page .breakdown .row b { color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-weight: 700; }
  .vsc-calc-page .breakdown .row.win b { color: var(--green); }
  .vsc-calc-page .breakdown hr { border: none; border-top: 1px dashed var(--line); margin: 8px 0; }
  .vsc-calc-page .note { font-size: 12.5px; color: var(--muted-2); line-height: 1.6; margin-top: auto; }

  /* TABLE / CHART */
  .vsc-calc-page .table-scroll { overflow-x: auto; display: none; }
  @media(min-width:700px){ .vsc-calc-page .table-scroll { display: block; } }
  .vsc-calc-page table { width: 100%; border-collapse: collapse; margin-top: 4px; font-size: 14px; }
  .vsc-calc-page thead th {
    text-align: left; padding: 12px 14px; color: var(--muted);
    font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; text-transform: uppercase; letter-spacing: .07em;
    border-bottom: 2px solid var(--line);
  }
  .vsc-calc-page tbody td { padding: 12px 14px; border-bottom: 1px solid var(--line-soft); color: var(--muted); }
  .vsc-calc-page tbody td.strong { color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-weight: 700; }
  .vsc-calc-page tbody td.amber { color: var(--orange); font-family: 'IBM Plex Mono', monospace; font-weight: 700; }
  .vsc-calc-page tbody tr:hover td { background: var(--bg-warm); }

  .vsc-calc-page .chart-cards { display: flex; flex-direction: column; gap: 10px; }
  @media(min-width:700px){ .vsc-calc-page .chart-cards { display: none; } }
  .vsc-calc-page .chart-card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .vsc-calc-page .chart-card .left b { display: block; font-size: 14.5px; margin-bottom: 2px; }
  .vsc-calc-page .chart-card .left span { color: var(--muted); font-size: 12.5px; }
  .vsc-calc-page .chart-card .right { text-align: right; flex-shrink: 0; }
  .vsc-calc-page .chart-card .right .n { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--orange); font-size: 15px; }
  .vsc-calc-page .chart-card .right .n2 { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--green); font-size: 12px; margin-top: 2px; }

  .vsc-calc-page .rule-box {
    display: flex; gap: 12px; align-items: flex-start; background: var(--green-tint);
    border: 1px solid var(--green); border-radius: 12px; padding: 16px 18px; margin-top: 18px;
    font-size: 13.5px; color: var(--green-deep); line-height: 1.6;
  }
  .vsc-calc-page .rule-box b { color: var(--orange); }

  /* EXAMPLES */
  .vsc-calc-page .tabs { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
  .vsc-calc-page .tab-btn {
    padding: 11px 16px; border-radius: 999px; border: 1.5px solid var(--line);
    background: #fff; color: var(--muted); font-weight: 700; font-size: 13px; cursor: pointer;
    min-height: 44px;
  }
  .vsc-calc-page .tab-btn.active { background: var(--green); border-color: var(--green); color: #fff; }
  .vsc-calc-page .example-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media(min-width:700px){ .vsc-calc-page .example-grid { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .vsc-calc-page .example-card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 20px;
  }
  @media(min-width:520px){ .vsc-calc-page .example-card { padding: 24px; } }
  .vsc-calc-page .example-card h4 { margin: 0 0 4px; font-size: 16px; }
  .vsc-calc-page .example-card .sub { color: var(--muted-2); font-size: 12px; margin-bottom: 16px; font-family: 'IBM Plex Mono', monospace; }
  .vsc-calc-page .example-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
  .vsc-calc-page .stat-box { background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .vsc-calc-page .stat-box .k { color: var(--muted-2); font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; font-family: 'IBM Plex Mono', monospace; }
  .vsc-calc-page .stat-box .v { font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 15px; margin-top: 4px; }
  .vsc-calc-page .example-result {
    display: flex; justify-content: space-between; align-items: center;
    background: var(--orange-tint); border: 1px solid var(--orange); border-radius: 10px; padding: 12px 16px;
  }
  .vsc-calc-page .example-result .lbl { font-size: 12px; color: var(--orange); font-weight: 600; }
  .vsc-calc-page .example-result .num { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--orange); font-size: 19px; }
  .vsc-calc-page .example-why { font-size: 12.5px; color: var(--muted); margin-top: 12px; line-height: 1.6; }
  .vsc-calc-page .example-panel { display: none; }
  .vsc-calc-page .example-panel.active { display: grid; }

  /* BADGES */
  .vsc-calc-page .badges {
    display: grid; grid-template-columns: repeat(2,1fr); gap: 10px;
  }
  @media(min-width:600px){ .vsc-calc-page .badges { grid-template-columns: repeat(5,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; } }
  .vsc-calc-page .badge {
    background: var(--panel); padding: 20px 14px; text-align: center; border-radius: 12px; border: 1px solid var(--line);
  }
  @media(min-width:600px){ .vsc-calc-page .badge { border-radius: 0; border: none; padding: 26px 14px; } }
  .vsc-calc-page .badge .big { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; color: var(--orange); }
  .vsc-calc-page .badge .lbl { font-size: 11.5px; color: var(--muted); margin-top: 6px; line-height: 1.4; }

  /* CTA BAND */
  .vsc-calc-page .cta-band {
    background: linear-gradient(135deg, #0a4a2c, #0e6b3e);
    border-radius: 20px; color: #fff;
    padding: 36px 24px; text-align: center; margin: 0 auto;
  }
  @media(min-width:640px){ .vsc-calc-page .cta-band { padding: 48px 40px; } }
  .vsc-calc-page .cta-band h3 { font-size: clamp(20px, 5vw, 28px); margin: 0 0 12px; }
  .vsc-calc-page .cta-band p { color: #cfe4d7; margin: 0 0 24px; font-size: 14.5px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .vsc-calc-page .cta-band .btn-primary { background: #fff; color: #0a4a2c; box-shadow: none; width: auto; }

  /* STICKY RESULT BAR */
  .vsc-calc-page .sticky-result {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    background: #0a4a2c; color: #fff;
    padding: 12px 16px; padding-bottom: calc(12px + env(safe-area-inset-bottom));
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    box-shadow: 0 -6px 18px rgba(0,0,0,.15);
    transform: translateY(100%); transition: transform .25s ease;
  }
  .vsc-calc-page .sticky-result.show { transform: translateY(0); }
  @media(min-width:860px){ .vsc-calc-page .sticky-result { display: none !important; } }
  .vsc-calc-page .sticky-result .txt { font-size: 12.5px; color: #cfe4d7; }
  .vsc-calc-page .sticky-result .num { font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 20px; }
  .vsc-calc-page .sticky-result a {
    background: #f0631b; color: #fff; font-weight: 700; font-size: 13px;
    padding: 10px 16px; border-radius: 8px; text-decoration: none; flex-shrink: 0;
  }

  .vsc-calc-page :focus-visible { outline: 2px solid #f0631b; outline-offset: 2px; }
  .vsc-calc-page ::selection { background: #f0631b; color: #fff; }

  /* ============ MOBILE RESPONSIVE ============ */
  @media (max-width: 767px) {

    /* HERO */
    .vsc-calc-page .hero { padding: 32px 0 28px; }
    .vsc-calc-page .eyebrow { font-size: 10.5px; padding: 6px 10px; margin-bottom: 16px; }
    .vsc-calc-page .hero h1 {
      font-size: clamp(26px, 8vw, 38px);
      line-height: 1.12; margin-bottom: 14px;
      text-align: left;
    }
    .vsc-calc-page .hero p.lead {
      font-size: 14.5px; line-height: 1.65;
      text-align: justify; text-justify: inter-word; hyphens: auto;
      margin-bottom: 22px;
    }
    .vsc-calc-page .hero-ctas { flex-direction: column; gap: 10px; }
    .vsc-calc-page .btn-primary,
    .vsc-calc-page .btn-ghost {
      width: 100%; font-size: 15px; padding: 15px 20px;
    }

    /* SECTION SPACING */
    .vsc-calc-page .section { padding: 36px 0; }
    .vsc-calc-page .section-head { margin-bottom: 22px; }
    .vsc-calc-page .section h2 { font-size: clamp(20px, 6vw, 26px); }
    .vsc-calc-page .section p.desc {
      font-size: 14px; line-height: 1.65;
      text-align: justify; text-justify: inter-word; hyphens: auto;
    }

    /* CALCULATOR */
    .vsc-calc-page .calc { border-radius: 16px; }
    .vsc-calc-page .calc-inputs { padding: 20px 18px; }
    .vsc-calc-page .calc-output { padding: 20px 18px; }
    .vsc-calc-page .field { margin-bottom: 20px; }
    .vsc-calc-page .field label { font-size: 10.5px; margin-bottom: 10px; }
    .vsc-calc-page .field label .val { font-size: 15px; }
    .vsc-calc-page .num-input { font-size: 15px; padding: 12px 13px; border-radius: 10px; }
    .vsc-calc-page .toggle-btn { font-size: 13px; padding: 13px 8px; min-height: 48px; }

    /* RESULT */
    .vsc-calc-page .result-headline { font-size: 10.5px; margin-bottom: 6px; }
    .vsc-calc-page .result-number { font-size: clamp(42px, 14vw, 60px); gap: 8px; }
    .vsc-calc-page .result-number span.unit { font-size: 15px; }

    /* CARD MOCK */
    .vsc-calc-page .card-mock { margin: 16px 0; padding: 12px 14px; border-radius: 10px; min-height: 70px; }
    .vsc-calc-page .card-mock .banner { font-size: 8px; padding: 2px 28px; right: -26px; }

    /* CHIP METER */
    .vsc-calc-page .chip-meter { gap: 5px; margin-bottom: 16px; }
    .vsc-calc-page .chip-icon { width: 20px; height: 13px; }

    /* BREAKDOWN */
    .vsc-calc-page .breakdown {
      padding: 14px; font-size: 13px; line-height: 1.8; margin-bottom: 14px;
    }
    .vsc-calc-page .breakdown .row { gap: 8px; flex-wrap: wrap; }
    .vsc-calc-page .note {
      font-size: 12px; line-height: 1.6;
      text-align: justify; text-justify: inter-word; hyphens: auto;
    }

    /* CHART CARDS (mobile list, table hidden) */
    .vsc-calc-page .chart-cards { gap: 10px; }
    .vsc-calc-page .chart-card {
      border-radius: 14px; padding: 14px 16px;
      display: flex; flex-direction: row; justify-content: space-between; align-items: center;
    }
