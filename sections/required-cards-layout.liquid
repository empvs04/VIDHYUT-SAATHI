<script>
(function(){
  const CHART = [
    ["1-6 KW","upto ₹6,000",1,2],
    ["7-12 KW","₹6,001 – ₹12,000",2,3],
    ["13-18 KW","₹12,001 – ₹18,000",3,4],
    ["19-24 KW","₹18,001 – ₹24,000",4,5],
    ["25-30 KW","₹24,001 – ₹30,000",5,6],
    ["31-36 KW","₹30,001 – ₹36,000",6,7],
    ["37-42 KW","₹36,001 – ₹42,000",7,8],
    ["43-48 KW","₹42,001 – ₹48,000",8,9],
    ["49-54 KW","₹48,001 – ₹54,000",9,10],
    ["55-60 KW","₹54,001 – ₹60,000",10,11],
  ];

  const chartBody  = document.getElementById('vsc2-chartBody');
  const chartCards = document.getElementById('vsc2-chartCards');
  CHART.forEach(function(row){
    const tr = document.createElement('tr');
    tr.innerHTML = '<td class="strong">' + row[0] + '</td><td>' + row[1] + '</td><td class="amber">' + row[2] + ' Card' + (row[2]>1?'s':'') + '</td><td class="amber">' + row[3] + ' Cards</td>';
    chartBody.appendChild(tr);

    const card = document.createElement('div');
    card.className = 'chart-card';
    card.innerHTML = '<div class="left"><b>' + row[0] + '</b><span>' + row[1] + '</span></div><div class="right"><div class="n">' + row[2] + ' Card' + (row[2]>1?'s':'') + '</div><div class="n2">3-Phase: ' + row[3] + '</div></div>';
    chartCards.appendChild(card);
  });

  const kwSlider   = document.getElementById('vsc2-kwSlider');
  const kwNumber   = document.getElementById('vsc2-kwNumber');
  const kwVal      = document.getElementById('vsc2-kwVal');
  const billNumber = document.getElementById('vsc2-billNumber');
  const billVal    = document.getElementById('vsc2-billVal');
  const btnSingle  = document.getElementById('vsc2-btnSingle');
  const btnThree   = document.getElementById('vsc2-btnThree');
  const resultNum  = document.getElementById('vsc2-resultNum');
  const resultUnit = document.getElementById('vsc2-resultUnit');
  const kwCardsEl  = document.getElementById('vsc2-kwCards');
  const billCardsEl= document.getElementById('vsc2-billCards');
  const baseWinEl  = document.getElementById('vsc2-baseWin');
  const phaseRow   = document.getElementById('vsc2-phaseRow');
  const chipMeter  = document.getElementById('vsc2-chipMeter');
  const stickyResult = document.getElementById('vsc2-stickyResult');
  const stickyNum  = document.getElementById('vsc2-stickyNum');
  const stickyUnit = document.getElementById('vsc2-stickyUnit');

  let threePhase = false;

  function inr(n){ return '₹' + Number(n).toLocaleString('en-IN'); }

  function sync(){
    const kw   = Math.max(1, Number(kwNumber.value) || 1);
    const bill = Math.max(0, Number(billNumber.value) || 0);

    kwVal.textContent  = kw + ' KW';
    billVal.textContent = inr(bill);
    kwSlider.value = Math.min(kw, 200);
    kwSlider.style.setProperty('--fill', (Math.min(kw,200)/200*100) + '%');

    const kwCards   = Math.max(1, Math.ceil(kw / 6));
    const billCards = bill > 0 ? Math.max(1, Math.ceil(bill / 6000)) : 1;
    const base      = Math.max(kwCards, billCards);
    const total     = threePhase ? base + 1 : base;

    kwCardsEl.textContent  = kwCards;
    billCardsEl.textContent = billCards;
    baseWinEl.textContent  = base;
    phaseRow.style.display = threePhase ? 'flex' : 'none';

    resultNum.textContent  = total;
    resultUnit.textContent = total > 1 ? 'Cards' : 'Card';
    stickyNum.textContent  = total;
    stickyUnit.textContent = total > 1 ? 'Cards' : 'Card';

    chipMeter.innerHTML = '';
    const capped = Math.min(total, 30);
    for(let i=0;i<capped;i++){
      const c = document.createElement('div');
      c.className = 'chip-icon lit';
      chipMeter.appendChild(c);
    }
    if(total > 30){
      const more = document.createElement('div');
      more.style.cssText = 'font-family:IBM Plex Mono,monospace;color:#f0631b;font-size:12.5px;font-weight:700;align-self:center;margin-left:4px;';
      more.textContent = '+' + (total - 30) + ' more';
      chipMeter.appendChild(more);
    }
  }

  kwSlider.addEventListener('input', function(){ kwNumber.value = kwSlider.value; sync(); });
  kwNumber.addEventListener('input', sync);
  billNumber.addEventListener('input', sync);

  btnSingle.addEventListener('click', function(){ threePhase=false; btnSingle.classList.add('active'); btnThree.classList.remove('active'); sync(); });
  btnThree.addEventListener('click', function(){ threePhase=true; btnThree.classList.add('active'); btnSingle.classList.remove('active'); sync(); });

  document.querySelectorAll('.vsc-calc-page .tab-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.vsc-calc-page .tab-btn').forEach(function(b){ b.classList.remove('active'); });
      document.querySelectorAll('.vsc-calc-page .example-panel').forEach(function(p){ p.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelector('.vsc-calc-page .example-panel[data-vsc2panel="' + btn.dataset.vsc2tab + '"]').classList.add('active');
    });
  });

  const calcSection = document.getElementById('vsc-calculator-section');
  if(calcSection && stickyResult){
    const io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.boundingClientRect.top < 0 && !e.isIntersecting){
          stickyResult.classList.add('show');
        } else if(e.isIntersecting){
          stickyResult.classList.remove('show');
        }
      });
    }, {threshold:0});
    io.observe(calcSection);
  }

  sync();
})();
</script>
