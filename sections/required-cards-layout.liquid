}
.vscc .chart-table-green tbody tr:last-child {
  border-bottom: none;
}
.vscc .chart-table-green tbody tr:nth-child(even) {
  background: #fbf8f0;
}
.vscc .chart-table-green tbody tr:hover {
  background: #f5f0e4;
}

.vscc .chart-table-green td {
  padding: 13px 12px;
  color: var(--muted);
