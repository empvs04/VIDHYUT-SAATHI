  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 10px 28px -6px rgba(240, 99, 27, 0.08), 0 2px 10px rgba(0, 0, 0, 0.03);
}

.vscc .eg-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 24px;
  right: 24px;
  height: 3px;
  background: linear-gradient(90deg, transparent 0%, #f97316 50%, transparent 100%);
  border-radius: 50px;
  opacity: 0.85;
  transition: opacity 0.3s ease;
}

.vscc .eg-card:hover {
  border-color: #f97316;
  transform: translateY(-5px);
  box-shadow: 0 20px 45px -10px rgba(240, 99, 27, 0.22), 0 0 0 1.5px rgba(249, 115, 22, 0.35);
}

.vscc .eg-img-wrap {
  width: 100%;
  height: 185px;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  margin-bottom: 14px;
  background: #1e293b;
  border: 1.5px solid rgba(254, 215, 170, 0.6);
