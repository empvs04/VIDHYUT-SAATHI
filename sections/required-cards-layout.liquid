{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --req-secondary: #007b3e;
    --req-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --req-text-dark: #0f172a;
    --req-text-light: #334155;
    --req-radius: 24px;
    --req-shadow: 0 16px 45px rgba(0, 0, 0, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(236, 92, 10, 0.18);
    --req-border: rgba(236, 92, 10, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: radial-gradient(circle at 50% 0%, rgba(236, 92, 10, 0.06) 0%, #ffffff 45%, rgba(0, 123, 62, 0.05) 100%);
    overflow: hidden;
  }

  /* --- Section 1: Hero Header & Interactive 3D Card Tabs --- */
  .req-hero-section {
    position: relative;
    padding: clamp(50px, 7vw, 90px) 20px 70px 20px;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    color: #ffffff;
    overflow: hidden;
    border-bottom: 3px solid rgba(255, 204, 0, 0.4);
  }

  /* Moving Marquee Background Text */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 30px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 18s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 920px;
    margin: 0 auto 36px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffcc00;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(255, 204, 0, 0.15);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
  }

  .req-hero-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #ffcc00, #ec5c0a, #00ff66);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 820px;
    margin: 0 auto;
  }

  /* --- Golden Rule Top Banner --- */
  .req-golden-banner {
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 2px solid #ffcc00;
    border-radius: 20px;
    padding: 18px 24px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .req-golden-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }
  .req-golden-info h3 {
    color: #ffcc00;
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 4px 0;
  }
  .req-golden-info p {
    color: #ffffff;
    font-size: 0.94rem;
    margin: 0;
    line-height: 1.5;
  }
  .req-golden-pill {
    padding: 8px 18px;
    background: #ffcc00;
    color: #000000;
    font-weight: 900;
    font-size: 0.88rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(255, 204, 0, 0.3);
  }

  /* --- Interactive 3D Card Requirement Tabs --- */
  .req-tabs-wrapper {
    margin-bottom: 35px;
  }
  .req-tabs-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 60px;
    padding: 10px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
  }

  .req-tab-btn {
    padding: 12px 24px;
    background: transparent;
    border: 1.5px solid transparent;
    border-radius: 50px;
    color: #cbd5e1;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
  }
  .req-tab-btn:hover {
    color: #ffcc00;
    background: rgba(255, 255, 255, 0.08);
  }
  .req-tab-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff !important;
    border-color: rgba(255, 204, 0, 0.6);
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.4);
    transform: translateY(-2px);
  }
  .req-tab-btn .tab-count {
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 900;
  }

  /* Tab Content Panels Stage */
  .req-tab-panel {
    display: none;
    animation: fadeInTab 0.4s ease forwards;
  }
  .req-tab-panel.active {
    display: block;
  }
  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Lucrative Card Info Showcase Box */
  .req-card-info-dashboard {
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 204, 0, 0.4);
    border-radius: 28px;
    padding: 32px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 992px) {
    .req-card-info-dashboard {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }

  /* Left Side: Detail Cards */
  .req-info-details-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .req-dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 16px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .req-dash-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }
  .req-dash-title span {
    color: #ffcc00;
  }
  .req-dash-tag {
    background: linear-gradient(90deg, #007b3e, #00a854);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 900;
    padding: 6px 16px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Grid of Technical Specs inside Tab */
  .req-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .req-spec-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 16px 18px;
    transition: all 0.3s ease;
  }
  .req-spec-box:hover {
    background: rgba(236, 92, 10, 0.15);
    border-color: rgba(255, 204, 0, 0.4);
    transform: translateY(-2px);
  }
  .req-spec-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 4px;
  }
  .req-spec-value {
    font-size: 1.12rem;
    font-weight: 900;
    color: #ffffff;
    display: block;
  }
  .req-spec-value .highlight {
    color: #00ff66;
  }
  .req-spec-value .highlight-orange {
    color: #ff5500;
  }

  /* Application & Savings Banner */
  .req-apps-banner {
    background: rgba(0, 123, 62, 0.15);
    border: 1px solid rgba(0, 255, 102, 0.3);
    border-radius: 18px;
    padding: 18px 20px;
  }
  .req-apps-banner h4 {
    font-size: 1rem;
    font-weight: 900;
    color: #00ff66;
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .req-apps-banner p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: #e2e8f0;
    margin: 0;
  }

  /* Right Side: 3D Visual Card Box & CTA */
  .req-info-visual-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    padding: 24px;
    text-align: center;
  }
  .req-card-thumb-wrapper {
    width: 100%;
    max-width: 320px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 30px rgba(236, 92, 10, 0.2);
    border: 2px solid rgba(255, 204, 0, 0.5);
    margin-bottom: 18px;
    transition: transform 0.4s ease;
  }
  .req-card-thumb-wrapper:hover {
    transform: scale(1.03) rotate(1deg);
  }
  .req-card-thumb-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .req-savings-tag {
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffcc00;
    margin-bottom: 16px;
    background: rgba(255, 204, 0, 0.12);
    padding: 8px 18px;
    border-radius: 50px;
    border: 1px solid rgba(255, 204, 0, 0.3);
  }

  .req-tab-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 28px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff !important;
    font-size: 1.05rem;
    font-weight: 900;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(236, 92, 10, 0.4);
    transition: all 0.3s ease;
  }
  .req-tab-order-btn:hover {
    background: linear-gradient(135deg, #f1721b, #007b3e);
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(236, 92, 10, 0.6);
  }

  /* --- Real Example Spotlight (User's Exact Scenario) --- */
  .req-example-spotlight {
    background: linear-gradient(135deg, rgba(0, 123, 62, 0.2), rgba(236, 92, 10, 0.2));
    border: 2px solid #00ff66;
    border-radius: 22px;
    padding: 26px 30px;
    box-shadow: 0 20px 50px rgba(0, 255, 102, 0.15);
    margin-top: 20px;
  }

  .req-spotlight-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .req-spotlight-badge {
    background: #00ff66;
    color: #000000;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 5px 14px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .req-spotlight-title h3 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 900;
    margin: 0;
  }

  .req-spotlight-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  @media (max-width: 850px) {
    .req-spotlight-steps-grid {
      grid-template-columns: 1fr;
    }
  }

  .req-step-box {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 16px 18px;
    text-align: center;
  }
  .req-step-num {
    font-size: 0.78rem;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }
  .req-step-val {
    font-size: 1.1rem;
    font-weight: 900;
    color: #ffcc00;
    margin-bottom: 4px;
    display: block;
  }
  .req-step-cards {
    font-size: 0.88rem;
    font-weight: 800;
    color: #ffffff;
    background: rgba(236, 92, 10, 0.2);
    padding: 4px 10px;
    border-radius: 8px;
    display: inline-block;
  }

  .req-spotlight-final-box {
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    border-radius: 16px;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #ffffff;
    flex-wrap: wrap;
  }
  .req-final-text h4 {
    font-size: 1.15rem;
    font-weight: 900;
    margin: 0 0 4px 0;
  }
  .req-final-text p {
    font-size: 0.92rem;
    margin: 0;
    color: #e2e8f0;
  }
  .req-final-result-badge {
    background: #ffffff;
    color: #0f172a;
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 1.25rem;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
  }
  .req-final-result-badge span {
    color: #ec5c0a;
  }

  /* --- Mobile Responsive Fixes --- */
  @media screen and (max-width: 768px) {
    .req-hero-section {
      padding: 40px 12px 40px 12px !important;
    }
    .req-moving-text {
      top: 15px !important;
      font-size: 26px !important;
    }
    .hero-breadcrumb-pill {
      padding: 6px 14px !important;
      font-size: 0.76rem !important;
    }
    .req-badge-top {
      font-size: 0.72rem !important;
      padding: 5px 12px !important;
    }
    .req-hero-header h1 {
      font-size: clamp(1.7rem, 6vw, 2.2rem) !important;
    }
    .req-tabs-nav {
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      justify-content: flex-start !important;
      border-radius: 20px !important;
      padding: 6px !important;
      -webkit-overflow-scrolling: touch !important;
    }
    .req-tabs-nav::-webkit-scrollbar {
      display: none;
    }
    .req-tab-btn {
      flex-shrink: 0 !important;
      padding: 8px 16px !important;
      font-size: 0.82rem !important;
      white-space: nowrap !important;
    }
    .req-card-info-dashboard {
      padding: 20px 16px !important;
      border-radius: 20px !important;
    }
    .req-dash-title {
      font-size: 1.3rem !important;
    }
    .req-specs-grid {
      grid-template-columns: 1fr !important;
      gap: 10px !important;
    }
    .req-golden-banner {
      padding: 16px !important;
      flex-direction: column !important;
      text-align: center !important;
    }
    .req-golden-text {
      flex-direction: column !important;
      text-align: center !important;
    }
    .req-example-spotlight {
      padding: 18px 14px !important;
      border-radius: 18px !important;
    }
    .req-spotlight-final-box {
      flex-direction: column !important;
      text-align: center !important;
    }
  }
{%- endstyle -%}

<div class="req-wrapper">
  
  <!-- ==========================================
       SECTION 1: HERO HEADER & INTERACTIVE CARD TABS
       ========================================== -->
  <section class="req-hero-section">
    <div class="req-moving-text">Required Vidhyut Saathi Card &nbsp; &nbsp; Interactive Card Calculator &nbsp; &nbsp; Save Electricity</div>

    <div class="req-hero-container">
      
      <!-- Top Breadcrumb & Badge -->
      <div class="text-center">
        <div class="hero-breadcrumb-pill">
          <a href="/">Home</a>
          <span style="color: #ffcc00;">/</span>
          <span style="color: #ffffff; font-weight: 700;">Required Cards</span>
          <span style="color: rgba(255,255,255,0.3); margin: 0 4px;">|</span>
          <span style="color: #ffcc00; font-weight: 800;"><span class="pulse-dot"></span> Interactive Tabs</span>
        </div>
      </div>

      <div class="req-hero-header">
        <div class="req-badge-top">
          <span class="pulse-dot"></span>
          <span>⚡ INTERACTIVE CARD REQUIREMENT DASHBOARD</span>
        </div>
        <h1>Required Vidhyut Saathi Card <span>Select Your Load &amp; Card Quantity</span></h1>
        <p class="req-hero-subheading">Select any Card Tab below to see complete load specifications, monthly electricity bill range, 1-Phase / 3-Phase requirement, and expected monthly bill savings.</p>
      </div>

      <!-- Golden Rule Banner -->
      <div class="req-golden-banner">
        <div class="req-golden-text">
          <div class="req-golden-icon">🧮</div>
          <div class="req-golden-info">
            <h3>Golden Rule: Always Consider Higher Requirement</h3>
            <p>KW Connected Load aur Monthly Electricity Bill amount (₹) <strong>donon me se jisme zyaada cards aayein</strong>, usi ko consider karein!</p>
          </div>
        </div>
        <div class="req-golden-pill">⚡ 3-Phase Meter = Add +1 Extra Card</div>
      </div>

      <!-- INTERACTIVE TABS NAVIGATION BAR -->
      <div class="req-tabs-wrapper">
        <div class="req-tabs-nav" id="reqTabsNav">
          <button class="req-tab-btn active" data-tab="tab1">
            💳 1 Card <span class="tab-count">1-6 KW</span>
          </button>
          <button class="req-tab-btn" data-tab="tab2">
            💳 2 Cards <span class="tab-count">7-12 KW</span>
          </button>
          <button class="req-tab-btn" data-tab="tab3">
            💳 3 Cards <span class="tab-count">13-18 KW</span>
          </button>
          <button class="req-tab-btn" data-tab="tab4">
            💳 4 Cards <span class="tab-count">19-24 KW</span>
          </button>
          <button class="req-tab-btn" data-tab="tab5">
            💳 5 Cards <span class="tab-count">25-30 KW</span>
          </button>
          <button class="req-tab-btn" data-tab="tab6">
            🏬 6-10 Cards <span class="tab-count">31-60 KW</span>
          </button>
        </div>
      </div>

      <!-- TABS CONTENT PANELS STAGE -->
      <div class="req-panels-stage">
        
        <!-- TAB 1 PANEL: 1 Card Required -->
        <div class="req-tab-panel active" id="tab1">
          <div class="req-card-info-dashboard">
            <div class="req-info-details-left">
              <div class="req-dash-header">
                <h3 class="req-dash-title">💳 1 Vidhyut Saathi Card <span>Requirement Details</span></h3>
                <span class="req-dash-tag">Ideal for Small Load</span>
              </div>

              <div class="req-specs-grid">
                <div class="req-spec-box">
                  <span class="req-spec-label">🔌 Connected KW Load</span>
                  <span class="req-spec-value highlight">1 – 6 KW Load</span>
                </div>
                <div class="req-spec-box">
                  <span class="req-spec-label">🧾 Monthly Electricity Bill</span>
                  <span class="req-spec-value">Upto ₹6,000 / month</span>
                </div>
                <div class="req-spec-box">
                  <span class="req-spec-label">⚡ Single Phase Meter</span>
                  <span class="req-spec-value highlight">1 Card Required</span>
                </div>
                <div class="req-spec-box">
                  <span class="req-spec-label">🔌 3-Phase Meter (+1 Extra)</span>
                  <span class="req-spec-value highlight-orange">2 Cards Required</span>
                </div>
              </div>

              <div class="req-apps-banner">
                <h4>🏡 Suitable Applications &amp; Appliances:</h4>
                <p>Ideal for 1-2 BHK Homes, Small Apartments, Retail Shops, Small Offices, Clinics with basic electrical load (AC up to 1.5 Ton, Refrigerator, Fans, Lights, TV).</p>
              </div>
            </div>

            <div class="req-info-visual-right">
              <div class="req-card-thumb-wrapper">
