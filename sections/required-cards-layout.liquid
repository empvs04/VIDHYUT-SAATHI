  font-family: 'IBM Plex Mono', monospace; letter-spacing: .04em;
}
.vscc .eg-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
.vscc .eg-stat {
  background: var(--panel-2); border: 1px solid var(--line);
  border-radius: 10px; padding: 12px 14px;
}
.vscc .eg-stat .k { color: var(--muted-2); font-size: 10px; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; margin-bottom: 4px; }
.vscc .eg-stat .v { font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 15.5px; color: var(--ink); }
.vscc .eg-result {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--orange-t); border: 1.5px solid rgba(240,99,27,.35);
  border-radius: 11px; padding: 13px 16px; margin-bottom: 12px;
}
.vscc .eg-result .rl { font-size: 12px; color: var(--orange); font-weight: 700; }
.vscc .eg-result .rn { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--orange); font-size: 20px; }
.vscc .eg-why {
  font-size: 12.5px; color: var(--muted); line-height: 1.6;
