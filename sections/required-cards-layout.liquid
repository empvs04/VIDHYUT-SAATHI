{%- style -%}
  /* ================================================================
     VIDHYUT SAATHI — CARD CALCULATOR (Brand Theme)
     Primary: #F17022 (Orange) | Secondary: #009A44 (Green)
     Background: #FFFFFF | Warm: #FFF7ED | Ink: #111111
  ================================================================ */
  :root {
    --vs-orange: #F17022;
    --vs-orange-deep: #C2410C;
    --vs-orange-tint: #FFF7ED;
    --vs-green: #009A44;
    --vs-green-deep: #006B30;
    --vs-green-tint: #E6F4EA;
    --vs-gold: #FDBA00;
    --vs-ink: #111111;
    --vs-muted: #475569;
    --vs-muted-2: #94A3B8;
    --vs-bg: #FFFFFF;
    --vs-bg-warm: #FFF7ED;
    --vs-panel: #FFFFFF;
    --vs-panel-2: #F8FAFC;
    --vs-line: #E2E8F0;
    --vs-line-soft: #F1F5F9;
    --vs-radius: 16px;
    --vs-maxw: 1140px;
    --vs-tap: 48px;
  }

  .vsc-wrap { max-width: var(--vs-maxw); margin: 0 auto; padding: 0 20px; }
  @media (min-width: 640px) { .vsc-wrap { padding: 0 32px; } }

  /* ---- HERO ---- */
  .vsc-hero {
    position: relative;
    padding: clamp(48px, 7vw, 88px) 0 clamp(40px, 5vw, 64px);
    background: #FFFFFF;
    overflow: hidden;
    border-bottom: 3px solid #F17022;
  }
  .vsc-hero-orb-1 {
    position: absolute; top: -120px; left: -80px;
    width: 450px; height: 450px; border-radius: 50%;
    background: radial-gradient(circle, rgba(241,112,34,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .vsc-hero-orb-2 {
    position: absolute; bottom: -120px; right: -80px;
    width: 450px; height: 450px; border-radius: 50%;
    background: radial-gradient(circle, rgba(0,154,68,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .vsc-hero-inner { position: relative; z-index: 2; }
  .vsc-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--vs-green-tint); border: 1.5px solid var(--vs-green);
    color: var(--vs-green); font-size: 11.5px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    padding: 7px 14px; border-radius: 50px; margin-bottom: 20px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .vsc-eyebrow-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--vs-orange); flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(241,112,34,.2);
    animation: vsc-pulse 1.8s infinite;
  }
  @keyframes vsc-pulse {
    0%   { box-shadow: 0 0 0 0   rgba(241,112,34,.6); }
    70%  { box-shadow: 0 0 0 10px rgba(241,112,34,0); }
    100% { box-shadow: 0 0 0 0   rgba(241,112,34,0); }
  }
  .vsc-hero h1 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 7vw, 56px);
    font-weight: 900; line-height: 1.1;
    color: var(--vs-ink); margin: 0 0 16px; max-width: 800px;
  }
  .vsc-hero h1 em { font-style: normal; color: var(--vs-orange); }
  .vsc-lead {
    color: var(--vs-muted); font-size: clamp(15px, 2.5vw, 17px);
    line-height: 1.65; max-width: 580px; margin: 0 0 28px;
  }
  .vsc-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .vsc-btn-primary {
    background: var(--vs-orange); color: #fff; font-weight: 800;
    padding: 14px 26px; border-radius: 12px; text-decoration: none;
    font-size: 15px; border: none; cursor: pointer;
    min-height: var(--vs-tap); display: inline-flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(241,112,34,.35); transition: all .2s;
  }
  .vsc-btn-primary:hover { background: var(--vs-orange-deep); transform: translateY(-2px); }
  .vsc-btn-ghost {
    border: 2px solid var(--vs-green); color: var(--vs-green); background: #fff;
    padding: 14px 26px; border-radius: 12px; text-decoration: none;
    font-size: 15px; font-weight: 800;
    min-height: var(--vs-tap); display: inline-flex; align-items: center; justify-content: center;
    transition: all .2s;
  }
  .vsc-btn-ghost:hover { background: var(--vs-green-tint); transform: translateY(-2px); }

  /* ---- SECTION COMMON ---- */
  .vsc-section { padding: clamp(40px, 6vw, 72px) 0; }
  .vsc-section-head { max-width: 640px; margin: 0 0 32px; }
  .vsc-section-eyebrow {
    font-size: 11.5px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--vs-orange);
    margin-bottom: 8px; font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .vsc-section h2 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(22px, 5vw, 34px); font-weight: 900;
    color: var(--vs-ink); margin: 0 0 10px;
  }
  .vsc-section .vsc-desc { color: var(--vs-muted); font-size: 15px; line-height: 1.65; margin: 0; }

  /* ---- CALCULATOR ---- */
  .vsc-calc {
    background: var(--vs-panel);
    border: 1.5px solid var(--vs-line);
    border-radius: 22px;
    display: grid; grid-template-columns: 1fr;
    overflow: hidden;
    box-shadow: 0 24px 60px -24px rgba(0,154,68,.15), 0 1px 0 rgba(0,0,0,.03);
  }
  @media (min-width: 860px) { .vsc-calc { grid-template-columns: 1fr 1fr; } }

  .vsc-calc-inputs { padding: 24px; }
  @media (min-width: 520px) { .vsc-calc-inputs { padding: 32px; } }
  @media (min-width: 860px) { .vsc-calc-inputs { padding: 40px; border-right: 1.5px solid var(--vs-line); } }

  .vsc-field { margin-bottom: 26px; }
  .vsc-field label {
    display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
    font-weight: 800; color: var(--vs-ink); margin-bottom: 12px;
    font-size: 12px; letter-spacing: .06em; text-transform: uppercase;
  }
  .vsc-field label .vsc-lval {
    color: var(--vs-orange); font-size: 17px; font-weight: 900; letter-spacing: 0;
    text-transform: none;
  }
  input[type="range"].vsc-slider {
    width: 100%; -webkit-appearance: none; appearance: none;
    height: 8px; border-radius: 50px; outline: none; margin: 6px 0; touch-action: pan-y;
    background: linear-gradient(90deg, var(--vs-green) 0%, var(--vs-green) var(--fill, 5%), var(--vs-line) var(--fill, 5%));
  }
  input[type="range"].vsc-slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%;
    background: var(--vs-orange); border: 4px solid #fff; cursor: pointer;
    box-shadow: 0 3px 10px rgba(0,0,0,.2);
  }
  input[type="range"].vsc-slider::-moz-range-thumb {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--vs-orange); border: 4px solid #fff; cursor: pointer;
  }
  .vsc-num-input {
    width: 100%; background: var(--vs-panel-2); border: 1.5px solid var(--vs-line);
    color: var(--vs-ink); font-size: 17px; font-weight: 700;
    padding: 13px 14px; border-radius: 12px; outline: none;
    min-height: var(--vs-tap); font-family: 'Plus Jakarta Sans', sans-serif;
    transition: border-color .2s, background .2s;
  }
  .vsc-num-input:focus { border-color: var(--vs-orange); background: #fff; }
  .vsc-prefix-wrap { position: relative; }
  .vsc-prefix {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: var(--vs-muted-2); pointer-events: none; font-size: 17px; font-weight: 700;
  }
  .vsc-prefix-wrap .vsc-num-input { padding-left: 28px; }

  .vsc-toggle-group { display: flex; gap: 10px; }
  .vsc-toggle-btn {
    flex: 1; padding: 13px 8px; border-radius: 12px; border: 1.5px solid var(--vs-line);
    background: var(--vs-panel-2); color: var(--vs-muted); font-weight: 800; font-size: 14px;
    cursor: pointer; text-align: center; transition: all .15s; min-height: var(--vs-tap);
    display: flex; align-items: center; justify-content: center;
  }
  .vsc-toggle-btn.vsc-active {
    border-color: var(--vs-green); color: var(--vs-green-deep); background: var(--vs-green-tint);
    box-shadow: 0 4px 14px rgba(0,154,68,.15);
  }

  /* ---- OUTPUT ---- */
  .vsc-calc-output {
    padding: 24px; display: flex; flex-direction: column;
    background: var(--vs-panel-2);
  }
  @media (min-width: 520px) { .vsc-calc-output { padding: 32px; } }
  @media (min-width: 860px) { .vsc-calc-output { padding: 40px; background: var(--vs-panel); } }

  .vsc-result-label {
    color: var(--vs-muted); font-size: 11.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .14em; margin-bottom: 8px;
  }
  .vsc-result-number {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif; font-weight: 900;
    font-size: clamp(48px, 13vw, 72px); line-height: 1; color: var(--vs-green-deep);
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  .vsc-result-number .vsc-unit {
    font-size: 17px; color: var(--vs-muted); font-weight: 700;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  /* Card mock */
  .vsc-card-mock {
    margin: 18px 0; padding: 14px 16px; border-radius: 14px;
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, #0b2440, #173a5c 55%, #0b2440);
    min-height: 76px; display: flex; flex-direction: column; justify-content: space-between;
  }
  .vsc-card-mock .vsc-card-banner {
    position: absolute; top: 8px; right: -28px; background: var(--vs-orange); color: #fff;
    font-size: 9px; font-weight: 800; padding: 3px 34px; transform: rotate(28deg); letter-spacing: .03em;
  }
  .vsc-card-chip { width: 28px; height: 20px; border-radius: 4px; background: linear-gradient(135deg, #e8c766, var(--vs-gold)); }
  .vsc-card-label { color: #cfe0f0; font-size: 10px; letter-spacing: .08em; font-weight: 700; text-transform: uppercase; }

  /* Chip meter */
  .vsc-chip-meter { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 18px; }
  .vsc-chip-icon {
    width: 22px; height: 15px; border-radius: 3px;
    background: var(--vs-line); border: 1px solid var(--vs-line); transition: .2s;
  }
  .vsc-chip-icon.vsc-lit {
    background: linear-gradient(135deg, #e8c766, var(--vs-gold));
    border-color: var(--vs-gold);
  }

  /* Breakdown */
  .vsc-breakdown {
    background: var(--vs-panel); border: 1.5px solid var(--vs-line);
    border-radius: 14px; padding: 16px; font-size: 13.5px;
    color: var(--vs-muted); line-height: 1.9; margin-bottom: 16px;
  }
  @media (min-width: 860px) { .vsc-breakdown { background: var(--vs-panel-2); } }
  .vsc-breakdown-row { display: flex; justify-content: space-between; gap: 12px; }
  .vsc-breakdown-row b { color: var(--vs-ink); font-weight: 800; }
  .vsc-breakdown-row.vsc-win b { color: var(--vs-green); }
  .vsc-breakdown hr { border: none; border-top: 1px dashed var(--vs-line); margin: 8px 0; }
  .vsc-note { font-size: 12.5px; color: var(--vs-muted-2); line-height: 1.6; margin-top: auto; }

  /* ---- CHART TABLE ---- */
  .vsc-table-scroll { overflow-x: auto; display: none; }
  @media (min-width: 700px) { .vsc-table-scroll { display: block; } }
  .vsc-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .vsc-table thead th {
    text-align: left; padding: 12px 16px; color: var(--vs-muted);
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    border-bottom: 2px solid var(--vs-line);
  }
  .vsc-table tbody td { padding: 13px 16px; border-bottom: 1px solid var(--vs-line-soft); color: var(--vs-muted); }
  .vsc-table tbody td.vsc-strong { color: var(--vs-ink); font-weight: 800; }
  .vsc-table tbody td.vsc-amber { color: var(--vs-orange); font-weight: 800; }
  .vsc-table tbody tr:hover td { background: var(--vs-bg-warm); }

  /* Chart mobile cards */
  .vsc-chart-cards { display: flex; flex-direction: column; gap: 10px; }
  @media (min-width: 700px) { .vsc-chart-cards { display: none; } }
  .vsc-chart-card {
    background: var(--vs-panel); border: 1.5px solid var(--vs-line);
    border-radius: 14px; padding: 14px 16px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .vsc-chart-card .vsc-cc-left b { display: block; font-size: 14.5px; margin-bottom: 2px; color: var(--vs-ink); }
  .vsc-chart-card .vsc-cc-left span { color: var(--vs-muted); font-size: 12.5px; }
  .vsc-chart-card .vsc-cc-right { text-align: right; flex-shrink: 0; }
  .vsc-chart-card .vsc-n1 { color: var(--vs-orange); font-weight: 800; font-size: 15px; }
  .vsc-chart-card .vsc-n2 { color: var(--vs-green); font-weight: 800; font-size: 12px; margin-top: 2px; }

  /* Rule box */
  .vsc-rule-box {
    display: flex; gap: 12px; align-items: flex-start;
    background: var(--vs-green-tint); border: 1.5px solid var(--vs-green);
    border-radius: 14px; padding: 16px 20px; margin-top: 20px;
    font-size: 13.5px; color: var(--vs-green-deep); line-height: 1.65;
  }
  .vsc-rule-box b { color: var(--vs-orange); }

  /* ---- EXAMPLES ---- */
  .vsc-tabs { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
  .vsc-tab-btn {
    padding: 11px 18px; border-radius: 50px; border: 1.5px solid var(--vs-line);
    background: #fff; color: var(--vs-muted); font-weight: 800; font-size: 13.5px;
    cursor: pointer; min-height: 44px; transition: all .2s;
  }
  .vsc-tab-btn.vsc-active { background: var(--vs-green); border-color: var(--vs-green); color: #fff; }
  .vsc-example-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 700px) { .vsc-example-grid { grid-template-columns: 1fr 1fr; gap: 22px; } }
  .vsc-example-card {
    background: var(--vs-panel); border: 1.5px solid var(--vs-line);
    border-radius: 18px; padding: 22px;
  }
  .vsc-example-card h4 { margin: 0 0 4px; font-size: 16.5px; font-weight: 800; color: var(--vs-ink); }
  .vsc-example-sub { color: var(--vs-muted-2); font-size: 12px; margin-bottom: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .vsc-example-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
  .vsc-stat-box { background: var(--vs-panel-2); border: 1.5px solid var(--vs-line); border-radius: 12px; padding: 12px 14px; }
  .vsc-stat-box .vsc-sk { color: var(--vs-muted-2); font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; }
  .vsc-stat-box .vsc-sv { font-weight: 900; font-size: 16px; margin-top: 4px; color: var(--vs-ink); }
  .vsc-example-result {
    display: flex; justify-content: space-between; align-items: center;
    background: var(--vs-orange-tint); border: 1.5px solid var(--vs-orange);
    border-radius: 12px; padding: 12px 16px;
  }
  .vsc-example-result .vsc-rl { font-size: 12px; color: var(--vs-orange); font-weight: 700; }
  .vsc-example-result .vsc-rn { font-weight: 900; color: var(--vs-orange-deep); font-size: 20px; }
  .vsc-example-why { font-size: 12.5px; color: var(--vs-muted); margin-top: 12px; line-height: 1.65; }
  .vsc-example-panel { display: none; }
  .vsc-example-panel.vsc-active { display: grid; }

  /* ---- BADGES ---- */
  .vsc-badges {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
  }
  @media (min-width: 600px) {
    .vsc-badges {
      grid-template-columns: repeat(5, 1fr); gap: 1px;
      background: var(--vs-line); border: 1.5px solid var(--vs-line);
      border-radius: 18px; overflow: hidden;
    }
  }
  .vsc-badge {
    background: var(--vs-panel); padding: 22px 14px; text-align: center;
    border-radius: 14px; border: 1.5px solid var(--vs-line);
  }
  @media (min-width: 600px) { .vsc-badge { border-radius: 0; border: none; padding: 28px 14px; } }
  .vsc-badge .vsc-big { font-family: 'Outfit', sans-serif; font-weight: 900; font-size: 22px; color: var(--vs-orange); }
  .vsc-badge .vsc-blbl { font-size: 12px; color: var(--vs-muted); margin-top: 6px; line-height: 1.4; }

  /* ---- CTA BAND ---- */
  .vsc-cta-band {
    background: linear-gradient(135deg, var(--vs-green-deep), var(--vs-green));
    border-radius: 22px; color: #fff;
    padding: clamp(32px, 5vw, 52px) clamp(24px, 5vw, 48px); text-align: center;
  }
  .vsc-cta-band h3 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(20px, 5vw, 30px); font-weight: 900; margin: 0 0 12px;
  }
  .vsc-cta-band p { color: rgba(255,255,255,.8); margin: 0 0 26px; font-size: 15px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .vsc-cta-band .vsc-btn-primary { background: #fff; color: var(--vs-green-deep); box-shadow: none; }
  .vsc-cta-band .vsc-btn-primary:hover { background: var(--vs-orange-tint); }

  /* ---- MOBILE STICKY RESULT ---- */
  .vsc-sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 999;
    background: var(--vs-green-deep); color: #fff;
    padding: 12px 18px;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    box-shadow: 0 -6px 20px rgba(0,0,0,.18);
    transform: translateY(100%); transition: transform .25s ease;
  }
  .vsc-sticky.vsc-sticky-show { transform: translateY(0); }
  @media (min-width: 860px) { .vsc-sticky { display: none !important; } }
  .vsc-sticky .vsc-stxt { font-size: 12.5px; color: rgba(255,255,255,.75); }
  .vsc-sticky .vsc-snum { font-weight: 900; font-size: 22px; }
  .vsc-sticky-btn {
    background: var(--vs-orange); color: #fff; font-weight: 800; font-size: 13.5px;
    padding: 10px 18px; border-radius: 10px; text-decoration: none; flex-shrink: 0;
  }
{%- endstyle -%}

<div>

  <!-- ===================== HERO ===================== -->
  <section class="vsc-hero">
    <div class="vsc-hero-orb-1"></div>
    <div class="vsc-hero-orb-2"></div>
    <div class="vsc-wrap vsc-hero-inner">
      <div class="vsc-eyebrow">
        <span class="vsc-eyebrow-dot"></span>
        India's No. 1 Electric Saver Card Company
      </div>
      <h1>How many <em>Vidhyut Saathi</em> cards does your connection need?</h1>
      <p class="vsc-lead">Enter your connected load and your monthly bill — the calculator checks both and always recommends the higher requirement, exactly the way our installation team does it on site.</p>
      <div class="vsc-ctas">
        <a href="#vsc-calculator" class="vsc-btn-primary">Calculate Now ↓</a>
        <a href="#vsc-chart" class="vsc-btn-ghost">View Full Chart</a>
      </div>
    </div>
  </section>

  <!-- ===================== CALCULATOR ===================== -->
  <section class="vsc-section" id="vsc-calculator">
    <div class="vsc-wrap">
      <div class="vsc-section-head">
        <div class="vsc-section-eyebrow">Card Calculator</div>
        <h2>Get your exact card count</h2>
        <p class="vsc-desc">One card saves 20–30% on a small load — bigger connections and heavier bills both call for more coverage. We calculate it both ways and take whichever number is higher.</p>
      </div>

      <div class="vsc-calc">
        <!-- Inputs -->
        <div class="vsc-calc-inputs">
          <div class="vsc-field">
            <label>Connected Load <span class="vsc-lval" id="vsc-kwVal">10 KW</span></label>
            <input type="range" class="vsc-slider" id="vsc-kwSlider" min="1" max="200" value="10" step="1">
            <div style="margin-top:12px;">
              <input type="number" inputmode="numeric" pattern="[0-9]*" class="vsc-num-input" id="vsc-kwNumber" value="10" min="1" max="2000">
            </div>
          </div>

          <div class="vsc-field">
            <label>Monthly Electricity Bill <span class="vsc-lval" id="vsc-billVal">₹6,000</span></label>
            <div class="vsc-prefix-wrap">
              <span class="vsc-prefix">₹</span>
              <input type="number" inputmode="numeric" pattern="[0-9]*" class="vsc-num-input" id="vsc-billNumber" value="6000" min="0" step="500">
            </div>
          </div>

          <div class="vsc-field" style="margin-bottom:0;">
            <label>Connection Type</label>
            <div class="vsc-toggle-group">
              <div class="vsc-toggle-btn vsc-active" id="vsc-btnSingle">⚡ Single Phase</div>
              <div class="vsc-toggle-btn" id="vsc-btnThree">🔌 Three Phase</div>
            </div>
          </div>
        </div>

        <!-- Output -->
        <div class="vsc-calc-output">
          <div class="vsc-result-label">Cards required</div>
          <div class="vsc-result-number">
            <span id="vsc-resultNum">1</span>
            <span class="vsc-unit" id="vsc-resultUnit">Card</span>
          </div>

          <div class="vsc-card-mock">
            <div class="vsc-card-banner">SAVE 20–30%</div>
            <div class="vsc-card-chip"></div>
            <div class="vsc-card-label">VIDHYUT SAATHI · TERAHERTZ CHIP</div>
          </div>

          <div class="vsc-chip-meter" id="vsc-chipMeter"></div>

          <div class="vsc-breakdown">
            <div class="vsc-breakdown-row"><span>Based on KW load (⌈KW ÷ 6⌉)</span><b id="vsc-kwCards">1</b></div>
