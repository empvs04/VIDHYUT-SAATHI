{%- style -%}
  /* --- Global & Variables (Why Vidhyut Saathi Official Brand Theme) --- */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#F17022' }};
    --req-secondary: #009A44;
    --req-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --req-text-dark: #111111;
    --req-text-light: #475569;
    --req-radius: 20px;
    --req-shadow: 0 16px 45px rgba(241, 112, 34, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(241, 112, 34, 0.16);
    --req-border: rgba(241, 112, 34, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  /* --- Section 1: Hero Header & Master Calculation Matrix (Light Theme) --- */
  .req-hero-section {
    position: relative;
    padding: clamp(45px, 6vw, 80px) 20px 50px 20px;
    background: #FFFFFF;
    color: #111111;
    overflow: hidden;
    border-bottom: 3px solid #F17022;
    box-shadow: 0 10px 40px rgba(241, 112, 34, 0.08);
  }

  /* Vibrant Background Glow Orbs */
  .req-hero-orb-1 {
    position: absolute;
    top: -140px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(241, 112, 34, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
  .req-hero-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 154, 68, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* Left to Right Moving Marquee Text (Light Theme Translucent Gradient) */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 25px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.08;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #F17022, #009A44, #FB5900, #F17022);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 20s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.3);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.1);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #334155;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 35px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: #FFFFFF;
    border: 2px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.12);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #009A44;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 154, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0); }
  }

  .req-hero-header h1 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #111111;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #F17022, #009A44);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #475569;
    max-width: 820px;
    margin: 0 auto;
  }

  /* --- Golden Rule Box (Why Vidhyut Saathi Palette) --- */
  .req-golden-banner {
    background: linear-gradient(135deg, #FFF8EF 0%, #FFFFFF 60%, #FFF3E5 100%);
    border: 2.5px solid #F17022;
    border-radius: 22px;
    padding: 20px 24px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 14px 40px rgba(241, 112, 34, 0.14);
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .req-golden-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }
  .req-golden-info h3 {
    color: #F17022;
    font-weight: 900;
    font-size: 1.15rem;
    margin: 0 0 4px 0;
  }
  .req-golden-info p {
    color: #334155;
    font-size: 0.96rem;
    margin: 0;
    line-height: 1.55;
  }
  .req-golden-info strong {
    color: #009A44;
    font-weight: 900;
  }
  .req-golden-pill {
    padding: 10px 20px;
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #FFFFFF;
    font-weight: 900;
    font-size: 0.88rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.3);
  }

  /* --- Section 1: Master Visual Requirement Table Stage --- */
  .req-table-stage {
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.25);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06);
  }

  .req-table-header-bar {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: linear-gradient(135deg, #F17022 0%, #009A44 100%);
    border-radius: 16px;
    padding: 16px 20px;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    margin-bottom: 14px;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.25);
  }

  .req-table-rows-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .req-table-row-card {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px 20px;
    align-items: center;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .req-table-row-card:hover {
    background: #FFF7ED;
    border-color: #F17022;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(241, 112, 34, 0.15);
  }

  .req-col-kw {
    font-size: 1.05rem;
    font-weight: 900;
    color: #009A44;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .req-col-bill {
    font-size: 0.98rem;
    font-weight: 800;
    color: #111111;
  }
  .req-col-1phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #009A44;
    background: #E6F4EA;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(0, 154, 68, 0.3);
  }
  .req-col-3phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #F17022;
    background: #FFF7ED;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(241, 112, 34, 0.4);
  }

  /* Mobile Responsive Adjustments */
  @media screen and (max-width: 768px) {
    /* Mobile Justified Paragraphs */
    .req-hero-subheading,
    .req-golden-info p {
      text-align: justify !important;
      text-justify: inter-word !important;
    }
    .req-hero-section {
      padding: 36px 12px 36px 12px !important;
    }
    .req-moving-text {
      top: 15px !important;
      font-size: 26px !important;
    }
    .hero-breadcrumb-pill {
      padding: 6px 14px !important;
      font-size: 0.76rem !important;
    }
    .req-badge-top {
      font-size: 0.72rem !important;
      padding: 5px 12px !important;
    }
    .req-hero-header h1 {
      font-size: clamp(1.7rem, 6vw, 2.2rem) !important;
    }
    .req-table-stage {
      padding: 12px !important;
      border-radius: 18px !important;
    }
    .req-table-header-bar {
      display: none !important;
    }
    .req-table-row-card {
      grid-template-columns: 1fr 1fr !important;
      gap: 10px !important;
      padding: 14px 12px !important;
      text-align: left !important;
      border-radius: 14px !important;
    }
    .req-col-kw {
      justify-content: flex-start !important;
      font-size: 0.98rem !important;
    }
    .req-col-bill {
      font-size: 0.88rem !important;
      text-align: right !important;
    }
    .req-col-1phase, .req-col-3phase {
      font-size: 0.88rem !important;
      text-align: center !important;
      padding: 6px 8px !important;
    }
    .req-golden-banner {
      padding: 16px !important;
      flex-direction: column !important;
      text-align: center !important;
    }
    .req-golden-text {
      flex-direction: column !important;
      text-align: center !important;
    }
  }
{%- endstyle -%}

<div class="req-wrapper">
  
  <!-- ==========================================
       SECTION 1: HERO HEADER & MASTER CALCULATION MATRIX (WHY VIDHYUT SAATHI BRAND PALETTE)
       ========================================== -->
  <section class="req-hero-section">
    <div class="req-hero-orb-1"></div>
    <div class="req-hero-orb-2"></div>
    <div class="req-moving-text">Required Vidhyut Saathi Card &nbsp; &nbsp; Master Estimation Matrix &nbsp; &nbsp; Save Electricity</div>

    <div class="req-hero-container">
      
      <!-- Top Breadcrumb & Badge -->
      <div style="text-align: center; margin-bottom: 20px;">
        <div class="hero-breadcrumb-pill">
          <a href="/">Home</a>
          <span style="color: #F17022;">/</span>
          <span style="color: #111111; font-weight: 700;">Required Cards</span>
          <span style="color: rgba(0,0,0,0.2); margin: 0 4px;">|</span>
