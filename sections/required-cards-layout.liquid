.vscc .guide-card {
  background: linear-gradient(165deg, #ffffff 0%, #fafffc 55%, #f4fbf7 100%);
  border: 1px solid rgba(14, 107, 62, 0.15);
  border-radius: 14px;
  padding: 13px 10px 10px;
  text-align: center;
  box-shadow: 0 4px 14px -4px rgba(10, 74, 44, 0.07), 0 1px 3px rgba(0, 0, 0, 0.02);
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  font-family: 'Nunito', sans-serif;
}
.vscc .guide-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2.5px;
  background: linear-gradient(90deg, #009b37, #f0631b, #c9982e);
  opacity: 0.9;
}
.vscc .guide-card:hover {
  transform: translateY(-3px);
  border-color: #00b050;
  box-shadow: 0 12px 24px -6px rgba(0, 155, 55, 0.18), 0 0 0 1px rgba(0, 155, 55, 0.3);
}

.vscc .guide-icon-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #00b050 0%, #007b3e 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  margin-bottom: 7px;
  box-shadow: 0 3px 10px rgba(0, 155, 55, 0.28), inset 0 1px 1px rgba(255, 255, 255, 0.5);
  transition: transform 0.25s ease;
}
.vscc .guide-card:hover .guide-icon-circle {
  transform: scale(1.08) rotate(5deg);
}

.vscc .guide-title {
  font-family: 'Baloo 2', sans-serif;
  font-size: 13.5px;
  font-weight: 800;
  letter-spacing: 0.01em;
  color: #16281f;
  text-transform: uppercase;
  margin-bottom: 4px;
  line-height: 1.2;
}
.vscc .guide-title span {
  color: #f0631b;
}

.vscc .guide-bill-pill {
  font-family: 'Nunito', sans-serif;
  font-size: 11px;
  font-weight: 700;
  color: #085a32;
  background: linear-gradient(135deg, #eaf6ee 0%, #d8f1e1 100%);
  border: 1px solid rgba(14, 107, 62, 0.22);
  padding: 3px 9px;
  border-radius: 999px;
  margin-bottom: 7px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.vscc .guide-rupee-pill {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #009b37;
  color: #ffffff;
  font-size: 9.5px;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
  box-shadow: 0 1px 4px rgba(0, 155, 55, 0.3);
  font-family: 'Baloo 2', sans-serif;
}

.vscc .guide-req-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
  width: 100%;
  padding-top: 7px;
  border-top: 1px dashed rgba(22, 40, 31, 0.1);
  margin-top: auto;
}

.vscc .guide-req-text {
  font-family: 'Nunito', sans-serif;
  font-size: 11px;
  font-weight: 700;
  color: #5e7568;
  text-transform: capitalize;
  margin: 0;
  text-align: left;
  line-height: 1.15;
}

.vscc .guide-shockwave-badge {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7b00 0%, #ec5c0a 100%);
  color: #ffffff;
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 0 2px rgba(240, 99, 27, 0.22);
  animation: vsccShockwave 2.2s infinite cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes vsccShockwave {
  0% { box-shadow: 0 0 0 0 rgba(240, 99, 27, 0.6); }
  70% { box-shadow: 0 0 0 8px rgba(240, 99, 27, 0); }
  100% { box-shadow: 0 0 0 0 rgba(240, 99, 27, 0); }
}

:focus-visible { outline: 2px solid #f0631b; outline-offset: 2px; }
