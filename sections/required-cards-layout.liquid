{%- style -%}
  /* ==========================================================================
     REQUIRED CARDS LAYOUT — OFFICIAL 'WHY VIDHYUT SAATHI' LIGHT BRAND THEME
     ========================================================================== */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#F17022' }};
    --req-secondary: #009A44;
    --req-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --req-text-dark: #111111;
    --req-text-light: #475569;
    --req-radius: 20px;
    --req-shadow: 0 16px 45px rgba(241, 112, 34, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(241, 112, 34, 0.16);
    --req-border: rgba(241, 112, 34, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  /* ==========================================
     SECTION 1: HERO HEADER & MASTER ESTIMATION MATRIX
     ========================================== */
  .req-hero-section {
    position: relative;
    padding: clamp(45px, 6vw, 80px) 20px 50px 20px;
    background: #FFFFFF;
    color: #111111;
    overflow: hidden;
    border-bottom: 3px solid #F17022;
    box-shadow: 0 10px 40px rgba(241, 112, 34, 0.08);
  }

  /* Vibrant Background Glow Orbs */
  .req-hero-orb-1 {
    position: absolute;
    top: -140px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(241, 112, 34, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }
  .req-hero-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 154, 68, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* Moving Marquee Text */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 25px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.08;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #F17022, #009A44, #FB5900, #F17022);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 20s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.3);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.1);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #334155;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 35px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: #FFFFFF;
    border: 2px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.12);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #009A44;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 154, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 154, 68, 0); }
  }

  .req-hero-header h1 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #111111;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #F17022, #009A44);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #475569;
    max-width: 820px;
    margin: 0 auto;
  }

  /* --- Golden Rule Box --- */
  .req-golden-banner {
    background: linear-gradient(135deg, #FFF8EF 0%, #FFFFFF 60%, #FFF3E5 100%);
    border: 2.5px solid #F17022;
    border-radius: 22px;
    padding: 20px 24px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 14px 40px rgba(241, 112, 34, 0.14);
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .req-golden-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }
  .req-golden-info h3 {
    color: #F17022;
    font-weight: 900;
    font-size: 1.15rem;
    margin: 0 0 4px 0;
  }
  .req-golden-info p {
    color: #334155;
    font-size: 0.96rem;
    margin: 0;
    line-height: 1.55;
  }
  .req-golden-info strong {
    color: #009A44;
    font-weight: 900;
  }
  .req-golden-pill {
    padding: 10px 20px;
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #FFFFFF;
    font-weight: 900;
    font-size: 0.88rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.3);
  }

  /* --- Master Visual Requirement Table Stage --- */
  .req-table-stage {
    background: #FFFFFF;
    border: 2px solid rgba(241, 112, 34, 0.25);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.06);
    margin-bottom: 40px;
  }

  .req-table-header-bar {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: linear-gradient(135deg, #F17022 0%, #009A44 100%);
    border-radius: 16px;
    padding: 16px 20px;
    color: #ffffff;
    font-weight: 900;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    margin-bottom: 14px;
    box-shadow: 0 8px 25px rgba(241, 112, 34, 0.25);
  }

  .req-table-rows-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .req-table-row-card {
    display: grid;
    grid-template-columns: 1.2fr 1.3fr 1fr 1fr;
    gap: 12px;
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px 20px;
    align-items: center;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }
  .req-table-row-card:hover {
    background: #FFF7ED;
    border-color: #F17022;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(241, 112, 34, 0.15);
  }

  .req-col-kw {
    font-size: 1.05rem;
    font-weight: 900;
    color: #009A44;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .req-col-bill {
    font-size: 0.98rem;
    font-weight: 800;
    color: #111111;
  }
  .req-col-1phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #009A44;
    background: #E6F4EA;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(0, 154, 68, 0.3);
  }
  .req-col-3phase {
    font-size: 1.05rem;
    font-weight: 900;
    color: #F17022;
    background: #FFF7ED;
    padding: 6px 12px;
    border-radius: 10px;
    border: 1.5px solid rgba(241, 112, 34, 0.4);
  }

  /* --- Vidhyut Saathi 3D Card Info Showcase Stage --- */
  .req-card-info-stage {
    background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 60%, #EFF6FF 100%);
    border: 2.5px solid #F17022;
    border-radius: 24px;
    padding: 30px;
    box-shadow: 0 20px 50px rgba(241, 112, 34, 0.12);
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 30px;
    align-items: center;
    margin-top: 40px;
  }
  @media (max-width: 992px) {
    .req-card-info-stage { grid-template-columns: 1fr; }
  }

  .req-card-info-dashboard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .req-spec-box {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
  }
  .req-spec-box.spec-green { border-color: #009A44; background: #E6F4EA; }
  .req-spec-box.spec-orange { border-color: #F17022; background: #FFF7ED; }
  .req-spec-box.spec-blue { border-color: #2563EB; background: #EFF6FF; }
  .req-spec-box span { display: block; font-size: 0.8rem; font-weight: 800; color: #475569; text-transform: uppercase; }
  .req-spec-box strong { display: block; font-size: 1.15rem; font-weight: 900; color: #111111; margin-top: 4px; }

  /* 3D Spinning Saver Card */
  @keyframes rotate360Card {
    0% { transform: translateY(0px) rotateY(0deg) rotateZ(0deg); }
    50% { transform: translateY(-12px) rotateY(180deg) rotateZ(2deg); }
    100% { transform: translateY(0px) rotateY(360deg) rotateZ(0deg); }
  }
  .req-card-thumb-wrapper {
    perspective: 1000px;
    width: 240px;
    height: 340px;
    margin: 0 auto;
    position: relative;
  }
  .req-3d-card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    animation: rotate360Card 12s infinite ease-in-out;
  }
  .req-card-face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(241, 112, 34, 0.35);
    border: 2px solid #F17022;
  }
  .req-card-face img { width: 100%; height: 100%; object-fit: cover; }
  .req-card-back { transform: rotateY(180deg); }

  /* ==========================================
     SECTION 2: REAL-WORLD EXAMPLES & SCENARIOS
     ========================================== */
  .req-sec2-section {
    padding: 60px 20px;
    background: #FFFFFF;
  }
  .req-sec2-container { max-width: 1280px; margin: 0 auto; }
  .req-sec2-header { text-align: center; margin-bottom: 40px; }
  .req-sec2-badge {
    display: inline-block; padding: 6px 18px; background: #FFF7ED; border: 1.5px solid #F17022;
    color: #F17022; font-size: 0.85rem; font-weight: 800; border-radius: 50px; text-transform: uppercase; margin-bottom: 12px;
  }
  .req-sec2-header h2 { font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #111111; margin: 0 0 10px 0; }
  .req-sec2-header h2 span { color: #F17022; }

  /* 3-Step Selection Guide Banner */
  .req-sec2-guide-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 16px;
    align-items: center;
    margin-bottom: 35px;
  }
  @media (max-width: 900px) {
    .req-sec2-guide-flow { grid-template-columns: 1fr; }
    .req-guide-arrow { transform: rotate(90deg); margin: 10px auto; }
  }
  .req-guide-step {
    padding: 20px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  .step-1-card { background: linear-gradient(135deg, #E6F4EA, #FFFFFF); border: 2px solid #009A44; }
  .step-2-card { background: linear-gradient(135deg, #FFF7ED, #FFFFFF); border: 2px solid #F17022; }
  .step-3-card { background: linear-gradient(135deg, #EFF6FF, #FFFFFF); border: 2px solid #2563EB; }
  .req-step-num { font-size: 0.8rem; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border-radius: 50px; background: #FFFFFF; }
  .req-step-icon { font-size: 2rem; }
  .req-step-content strong { display: block; font-size: 1.05rem; font-weight: 900; color: #111111; }
  .req-step-content span { font-size: 0.88rem; color: #475569; }

  .req-guide-arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2.5px solid #F17022;
    color: #F17022;
    font-size: 1.2rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.2);
    align-self: center;
    justify-self: center;
  }

  /* Sector Switcher Tabs Dock */
  .req-sector-tabs-wrapper {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .req-sector-tab {
    padding: 12px 24px;
    border-radius: 50px;
    border: 2px solid #E2E8F0;
    background: #FFFFFF;
    color: #475569;
    font-weight: 800;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
  }
  .req-sector-tab[data-sector="residential"].active { background: #009A44; color: #FFFFFF; border-color: #009A44; box-shadow: 0 8px 25px rgba(0, 154, 68, 0.3); }
  .req-sector-tab[data-sector="commercial"].active { background: #F17022; color: #FFFFFF; border-color: #F17022; box-shadow: 0 8px 25px rgba(241, 112, 34, 0.3); }
  .req-sector-tab[data-sector="industrial"].active { background: #2563EB; color: #FFFFFF; border-color: #2563EB; box-shadow: 0 8px 25px rgba(37, 99, 235, 0.3); }

  /* Sector Panels & Real World Example Cards */
  .req-sector-panel { display: none; }
  .req-sector-panel.active { display: block; }
  
  .req-examples-grid { display: flex; flex-direction: column; gap: 30px; }
  .req-example-card {
    background: #FFFFFF; border: 2px solid #E2E8F0; border-radius: 24px; overflow: hidden; box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
  }
  .req-ex-header {
    background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%); color: #FFFFFF; padding: 16px 24px;
    display: flex; justify-content: space-between; align-items: center; border-bottom: 2.5px solid #F17022; font-weight: 900;
  }
  .req-ex-header-tag { background: rgba(255, 255, 255, 0.2); padding: 4px 12px; border-radius: 50px; font-size: 0.8rem; }

  .req-ex-body { padding: 24px; }
  .req-ex-content-grid { display: grid; grid-template-columns: 260px 1.1fr 1fr; gap: 24px; align-items: center; }
  @media (max-width: 900px) { .req-ex-content-grid { grid-template-columns: 1fr; } }

  .req-building-img-box {
    width: 100%; height: 200px; border-radius: 18px; overflow: hidden; border: 2px solid #E2E8F0; position: relative;
  }
  .req-building-img-box img { width: 100%; height: 100%; object-fit: cover; }
  .req-img-overlay-badge { position: absolute; bottom: 10px; left: 10px; background: rgba(17, 17, 17, 0.85); color: #FFFFFF; padding: 4px 12px; border-radius: 50px; font-size: 0.78rem; font-weight: 800; }

  .req-customer-info { display: flex; flex-direction: column; gap: 12px; }
  .req-c-row { display: flex; align-items: center; gap: 12px; }
  .req-c-icon { width: 38px; height: 38px; border-radius: 12px; background: #F1F5F9; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
  .req-c-detail span { display: block; font-size: 0.78rem; font-weight: 700; color: #64748B; text-transform: uppercase; }
  .req-c-detail strong { display: block; font-size: 1.05rem; font-weight: 900; color: #111111; }

  .req-calc-matrix-box { background: #F8FAFC; border: 2px solid #E2E8F0; border-radius: 20px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .req-calc-line { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #FFFFFF; border-radius: 10px; border: 1.5px solid #E2E8F0; font-weight: 800; }
  .req-calc-line.winner-line { border-color: #F17022; background: #FFF7ED; }
  .req-ex-consider { background: linear-gradient(135deg, #F17022 0%, #FB5900 100%); color: #FFFFFF; padding: 10px; border-radius: 12px; text-align: center; font-weight: 900; }

  .req-ex-3phase-bar { margin-top: 16px; padding: 12px 18px; background: #FFF7ED; border: 1.5px solid #F17022; border-radius: 14px; color: #F17022; font-weight: 900; text-align: center; }
  .req-ex-why-box { margin-top: 16px; padding: 16px; background: #F8FAFC; border: 1.5px solid #E2E8F0; border-radius: 14px; display: flex; gap: 12px; align-items: center; }

  /* Mobile Responsive Optimization */
  @media screen and (max-width: 768px) {
    .req-hero-subheading, .req-golden-info p, .req-sec2-header p, .req-why-text { text-align: justify !important; text-justify: inter-word !important; }
    .req-hero-section { padding: 30px 10px 35px 10px !important; }
    .hero-breadcrumb-pill { padding: 5px 12px !important; font-size: 0.74rem !important; margin-bottom: 12px !important; }
    .req-badge-top { font-size: 0.7rem !important; padding: 4px 12px !important; margin-bottom: 10px !important; }
    .req-hero-header h1 { font-size: clamp(1.6rem, 5.5vw, 2.0rem) !important; margin-bottom: 8px !important; }
    
    .req-golden-banner { padding: 16px 12px !important; border-radius: 18px !important; flex-direction: column !important; text-align: center !important; gap: 12px !important; }
    .req-golden-text { flex-direction: column !important; align-items: center !important; text-align: center !important; }
    
    .req-table-stage { padding: 10px 8px !important; border-radius: 18px !important; }
    .req-table-header-bar { display: none !important; }
    .req-table-row-card { display: flex !important; flex-direction: column !important; gap: 8px !important; padding: 12px 14px !important; border-radius: 16px !important; }
    .req-col-kw { font-size: 0.96rem !important; font-weight: 900 !important; color: #009A44 !important; justify-content: flex-start !important; }
    .req-col-bill { font-size: 0.86rem !important; font-weight: 800 !important; color: #1E293B !important; text-align: right !important; }
    .req-col-1phase, .req-col-3phase { padding: 8px 10px !important; border-radius: 10px !important; font-size: 0.82rem !important; text-align: center !important; width: 100% !important; }

    .req-sector-tabs-wrapper {
      background: #FFFFFF !important; border: 2.5px solid #F17022 !important; border-radius: 50px !important; padding: 6px !important; box-shadow: 0 12px 35px rgba(241, 112, 34, 0.15) !important;
    }
    .req-sector-tab { font-size: 0.8rem !important; padding: 8px 14px !important; }
  }
{%- endstyle -%}

<div class="req-wrapper">
  
  <!-- ==========================================
       SECTION 1: HERO HEADER & MASTER ESTIMATION MATRIX
       ========================================== -->
  <section class="req-hero-section">
    <div class="req-hero-orb-1"></div>
    <div class="req-hero-orb-2"></div>
    <div class="req-moving-text">Required Vidhyut Saathi Card &nbsp; &nbsp; Master Estimation Matrix &nbsp; &nbsp; Save Electricity</div>

    <div class="req-hero-container">
      
      <!-- Top Breadcrumb & Badge -->
      <div style="text-align: center; margin-bottom: 16px;">
        <div class="hero-breadcrumb-pill">
          <a href="/">Home</a>
          <span style="color: #F17022;">/</span>
          <span style="color: #111111; font-weight: 700;">Required Cards</span>
          <span style="color: rgba(0,0,0,0.2); margin: 0 4px;">|</span>
          <span style="color: #F17022; font-weight: 800;"><span class="pulse-dot"></span> Master Guide</span>
        </div>
      </div>

      <div class="req-hero-header">
        <div class="req-badge-top">
          <span class="pulse-dot"></span>
          <span>⚡ OFFICIAL CARD REQUIREMENT GUIDE</span>
        </div>
        <h1>Required Vidhyut Saathi Card <span>Instant Load &amp; Bill Estimation Matrix</span></h1>
        <p class="req-hero-subheading">How many Vidhyut Saathi Cards do you need for your home, shop, or factory? Understand instantly with the master estimation chart and real-world examples below.</p>
      </div>

      <!-- Golden Rule Banner -->
      <div class="req-golden-banner">
        <div class="req-golden-text">
          <div class="req-golden-icon">🧮</div>
          <div class="req-golden-info">
            <h3>Golden Rule: Always Consider Higher Requirement</h3>
            <p>Between KW Connected Load and Monthly Electricity Bill amount (₹), <strong>always select whichever yields the higher number of cards!</strong></p>
          </div>
        </div>
        <div class="req-golden-pill">⚡ 3-Phase Meter = Add +1 Extra Card</div>
      </div>

      <!-- Section 1: Master Visual Requirement Table Stage -->
      <div class="req-table-stage">
        <div class="req-table-header-bar">
          <div>🔌 KW Connection</div>
          <div>🧾 Monthly Bill Amount</div>
          <div>💳 Single Phase Cards</div>
          <div>⚡ 3-Phase Connection</div>
        </div>

        <div class="req-table-rows-container">
          {%- assign rows = "1 – 6 KW|Upto ₹6,000 / mo|1 Card|2 Cards,7 – 12 KW|₹6,001 – ₹12,000|2 Cards|3 Cards,13 – 18 KW|₹12,001 – ₹18,000|3 Cards|4 Cards,19 – 24 KW|₹18,001 – ₹24,000|4 Cards|5 Cards,25 – 30 KW|₹24,001 – ₹30,000|5 Cards|6 Cards,31 – 36 KW|₹30,001 – ₹36,000|6 Cards|7 Cards,37 – 42 KW|₹36,001 – ₹42,000|7 Cards|8 Cards,43 – 48 KW|₹42,001 – ₹48,000|8 Cards|9 Cards,49 – 54 KW|₹48,001 – ₹54,000|9 Cards|10 Cards,55 – 60 KW|₹54,001 – ₹60,000|10 Cards|11 Cards" | split: "," -%}
