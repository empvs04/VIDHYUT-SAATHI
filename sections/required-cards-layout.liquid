    ['25–30 KW', '₹24,001 – ₹30,000',   5, 6],
    ['31–36 KW', '₹30,001 – ₹36,000',   6, 7],
    ['37–42 KW', '₹36,001 – ₹42,000',   7, 8],
    ['43–48 KW', '₹42,001 – ₹48,000',   8, 9],
    ['49–54 KW', '₹48,001 – ₹54,000',   9, 10],
    ['55–60 KW', '₹55,001 – ₹60,000',  10, 11],
  ];

  /* build desktop table & mobile cards */
  var tbody = document.getElementById('vscc-chartBody');
  var mobileContainer = document.getElementById('vscc-mobileCards');

  CHART.forEach(function(row){
    if(tbody){
      var tr = document.createElement('tr');
      var billTxt = row[1].startsWith('Upto') ? row[1].replace('Upto', 'Up to') : row[1].replace(/ – /g, '–');
      tr.innerHTML =
        '<td style="text-align:left;">' + row[0] + '</td>' +
        '<td style="text-align:center;">' + billTxt + '</td>' +
        '<td style="text-align:center;">' + row[2] + '</td>' +
        '<td style="text-align:center;">' + row[3] + '</td>';
      tbody.appendChild(tr);
    }
  });

  /* ---- CALCULATOR ---- */
  var kwSlider    = document.getElementById('vscc-kwSlider');
  var kwNumber    = document.getElementById('vscc-kwNumber');
  var kwVal       = document.getElementById('vscc-kwVal');
  var billNumber  = document.getElementById('vscc-billNumber');
  var billVal     = document.getElementById('vscc-billVal');
  var btnSingle   = document.getElementById('vscc-btnSingle');
  var btnThree    = document.getElementById('vscc-btnThree');
  var resultNum   = document.getElementById('vscc-resultNum');
  var resultUnit  = document.getElementById('vscc-resultUnit');
  var kwCardsEl   = document.getElementById('vscc-kwCards');
  var billCardsEl = document.getElementById('vscc-billCards');
  var baseWinEl   = document.getElementById('vscc-baseWin');
  var phaseRow    = document.getElementById('vscc-phaseRow');
  var chipMeter   = document.getElementById('vscc-chipMeter');
  var stickyBar   = document.getElementById('vscc-stickyBar');
  var stickyNum   = document.getElementById('vscc-stickyNum');
  var stickyUnit  = document.getElementById('vscc-stickyUnit');

  var threePhase = false;

  function inr(n){ return '₹' + Number(n).toLocaleString('en-IN'); }

  function sync(){
    var kw   = Math.max(1, Number(kwNumber.value) || 1);
    var bill = Math.max(0, Number(billNumber.value) || 0);

    kwVal.textContent   = kw + ' KW';
    billVal.textContent = inr(bill);
    kwSlider.value      = Math.min(kw, 200);
    kwSlider.style.setProperty('--fill', (Math.min(kw,200)/200*100) + '%');

    var kwCards   = Math.max(1, Math.ceil(kw / 6));
    var billCards = bill > 0 ? Math.max(1, Math.ceil(bill / 6000)) : 1;
    var base      = Math.max(kwCards, billCards);
    var total     = threePhase ? base + 1 : base;

    kwCardsEl.textContent   = kwCards;
    billCardsEl.textContent = billCards;
    baseWinEl.textContent   = base;
    phaseRow.style.display  = threePhase ? 'flex' : 'none';
    resultNum.textContent   = total;
    resultUnit.textContent  = total > 1 ? 'Cards' : 'Card';
    stickyNum.textContent   = total;
    stickyUnit.textContent  = total > 1 ? 'Cards' : 'Card';

    /* Estimated Savings (20%-30%) */
    var savingsMin = Math.round((bill * 0.20) / 100) * 100;
    var savingsMax = Math.round((bill * 0.30) / 100) * 100;
    var savingsRangeEl = document.getElementById('vscc-savingsRange');
    if(savingsRangeEl){
      savingsRangeEl.textContent = inr(savingsMin) + ' – ' + inr(savingsMax);
    }

    /* dynamic mini gold cards row */
    var miniCardsRow = document.getElementById('vscc-miniCardsRow');
    if(miniCardsRow){
      miniCardsRow.innerHTML = '';
      var capped = Math.min(total, 30);
      for(var i=0; i<capped; i++){
        var icon = document.createElement('div');
        icon.className = 'vscc-mini-card-icon';
        icon.title = 'Card ' + (i + 1);
        miniCardsRow.appendChild(icon);
      }
      if(total > 30){
        var more = document.createElement('span');
        more.style.cssText = 'font-family:Baloo 2,sans-serif;color:#f0631b;font-size:13px;font-weight:800;align-self:center;margin-left:4px;';
        more.textContent = '+' + (total - 30) + ' more';
        miniCardsRow.appendChild(more);
      }
    }
  }

  kwSlider.addEventListener('input', function(){ kwNumber.value = kwSlider.value; sync(); });
  kwNumber.addEventListener('input', sync);
  billNumber.addEventListener('input', sync);

  btnSingle.addEventListener('click', function(){
    threePhase = false;
    btnSingle.classList.add('active'); btnThree.classList.remove('active');
    sync();
  });
  btnThree.addEventListener('click', function(){
    threePhase = true;
    btnThree.classList.add('active'); btnSingle.classList.remove('active');
    sync();
  });

  /* ---- TABS ---- */
  document.querySelectorAll('.vscc .tab-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.vscc .tab-btn').forEach(function(b){ b.classList.remove('active'); });
      document.querySelectorAll('.vscc .eg-panel').forEach(function(p){
        p.classList.remove('active');
        p.style.transform = 'none';
      });
      btn.classList.add('active');
      var panel = document.querySelector('.vscc .eg-panel[data-vscc-panel="' + btn.dataset.vsccTab + '"]');
      if(panel) {
        panel.classList.add('active');
        currentEgSlide = 0;
        vsccUpdateEgSlider();
        vsccRestartEgTimer();
      }
    });
  });

  /* ---- MOBILE SLIDER FOR REAL CUSTOMER SCENARIOS (4s AUTO-ADVANCE) ---- */
  var currentEgSlide = 0;
  var egAutoTimer = null;
  var egSliderInView = false;

  function vsccUpdateEgSlider() {
    var activePanel = document.querySelector('.vscc .eg-panel.active');
    if (!activePanel) return;
    
    if (window.innerWidth < 768) {
      activePanel.style.transform = 'translateX(-' + (currentEgSlide * 100) + '%)';
    } else {
      activePanel.style.transform = 'none';
    }

    var dots = document.querySelectorAll('.vscc .vscc-eg-dot');
    dots.forEach(function(dot, idx) {
      if (idx === currentEgSlide) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  window.vsccGoEgSlide = function(idx) {
    var activePanel = document.querySelector('.vscc .eg-panel.active');
    if (!activePanel) return;
    var totalCards = activePanel.querySelectorAll('.eg-card').length || 2;
    currentEgSlide = (idx + totalCards) % totalCards;
    vsccUpdateEgSlider();
    vsccRestartEgTimer();
  };

  function vsccNextEgSlide() {
    var activePanel = document.querySelector('.vscc .eg-panel.active');
    if (!activePanel) return;
    var totalCards = activePanel.querySelectorAll('.eg-card').length || 2;
    currentEgSlide = (currentEgSlide + 1) % totalCards;
    vsccUpdateEgSlider();
  }

  function vsccStartEgTimer() {
    if (egAutoTimer) clearInterval(egAutoTimer);
    if (window.innerWidth < 768 && egSliderInView) {
      egAutoTimer = setInterval(function() {
        vsccNextEgSlide();
      }, 4000);
    }
  }

  function vsccStopEgTimer() {
    if (egAutoTimer) {
      clearInterval(egAutoTimer);
      egAutoTimer = null;
    }
  }

  function vsccRestartEgTimer() {
    vsccStopEgTimer();
    vsccStartEgTimer();
  }

  // Touch Swipe Support on Mobile for Examples
  var touchStartX = 0;
  var touchEndX = 0;
  var egSliderWrap = document.querySelector('.vscc .vscc-eg-slider-wrap');
  if (egSliderWrap) {
    egSliderWrap.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
      vsccStopEgTimer();
    }, {passive: true});

    egSliderWrap.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          // swipe left -> next slide
          vsccGoEgSlide(currentEgSlide + 1);
        } else {
          // swipe right -> prev slide
          vsccGoEgSlide(currentEgSlide - 1);
        }
      }
      vsccStartEgTimer();
    }, {passive: true});
  }

  // IntersectionObserver to auto-play only when section is in view on mobile
  var egSection = document.getElementById('vscc-examples');
  if (egSection && 'IntersectionObserver' in window) {
    var egIo = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        egSliderInView = entry.isIntersecting;
        if (entry.isIntersecting) {
          vsccStartEgTimer();
        } else {
          vsccStopEgTimer();
        }
      });
    }, {threshold: 0.15});
    egIo.observe(egSection);
  } else {
    egSliderInView = true;
    vsccStartEgTimer();
  }

  window.addEventListener('resize', function() {
    vsccUpdateEgSlider();
    if (window.innerWidth >= 768) {
      vsccStopEgTimer();
    } else if (egSliderInView) {
      vsccStartEgTimer();
    }
  });

  /* ---- STICKY BAR ---- */
  var calcSection = document.getElementById('vscc-calc');
  if(calcSection && stickyBar){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.boundingClientRect.top < 0 && !e.isIntersecting){
          stickyBar.classList.add('show');
        } else if(e.isIntersecting){
          stickyBar.classList.remove('show');
        }
      });
    }, {threshold: 0});
    io.observe(calcSection);
  }

  sync();
})();
</script>
