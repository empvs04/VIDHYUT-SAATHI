<script>
(function(){
  const CHART = [
    ["1–6 KW","Upto ₹6,000",1,2],
    ["7–12 KW","₹6,001 – ₹12,000",2,3],
    ["13–18 KW","₹12,001 – ₹18,000",3,4],
    ["19–24 KW","₹18,001 – ₹24,000",4,5],
    ["25–30 KW","₹24,001 – ₹30,000",5,6],
    ["31–36 KW","₹30,001 – ₹36,000",6,7],
    ["37–42 KW","₹36,001 – ₹42,000",7,8],
    ["43–48 KW","₹42,001 – ₹48,000",8,9],
    ["49–54 KW","₹48,001 – ₹54,000",9,10],
    ["55–60 KW","₹54,001 – ₹60,000",10,11],
  ];

  /* Build chart table + mobile cards */
  const chartBody  = document.getElementById('vsc-chartBody');
  const chartCards = document.getElementById('vsc-chartCards');
  CHART.forEach(function(row){
    const tr = document.createElement('tr');
    tr.innerHTML = '<td class="vsc-strong">'+row[0]+'</td><td>'+row[1]+'</td><td class="vsc-amber">'+row[2]+' Card'+(row[2]>1?'s':'')+'</td><td class="vsc-amber">'+row[3]+' Cards</td>';
    chartBody.appendChild(tr);

    const card = document.createElement('div');
    card.className = 'vsc-chart-card';
    card.innerHTML = '<div class="vsc-cc-left"><b>'+row[0]+'</b><span>'+row[1]+'</span></div><div class="vsc-cc-right"><div class="vsc-n1">'+row[2]+' Card'+(row[2]>1?'s':'')+'</div><div class="vsc-n2">3-Phase: '+row[3]+' Cards</div></div>';
    chartCards.appendChild(card);
  });

  /* Calculator logic */
  const kwSlider   = document.getElementById('vsc-kwSlider');
  const kwNumber   = document.getElementById('vsc-kwNumber');
  const kwVal      = document.getElementById('vsc-kwVal');
  const billNumber = document.getElementById('vsc-billNumber');
  const billVal    = document.getElementById('vsc-billVal');
  const btnSingle  = document.getElementById('vsc-btnSingle');
  const btnThree   = document.getElementById('vsc-btnThree');
  const resultNum  = document.getElementById('vsc-resultNum');
  const resultUnit = document.getElementById('vsc-resultUnit');
  const kwCardsEl  = document.getElementById('vsc-kwCards');
  const billCardsEl= document.getElementById('vsc-billCards');
  const baseWinEl  = document.getElementById('vsc-baseWin');
  const phaseRow   = document.getElementById('vsc-phaseRow');
  const chipMeter  = document.getElementById('vsc-chipMeter');
  const sticky     = document.getElementById('vsc-stickyResult');
  const stickyNum  = document.getElementById('vsc-stickyNum');
  const stickyUnit = document.getElementById('vsc-stickyUnit');

  let threePhase = false;

  function inr(n){ return '₹' + Number(n).toLocaleString('en-IN'); }

  function sync(){
    const kw   = Math.max(1, Number(kwNumber.value)   || 1);
    const bill = Math.max(0, Number(billNumber.value)  || 0);

    kwVal.textContent   = kw + ' KW';
    billVal.textContent = inr(bill);
    kwSlider.value = Math.min(kw, 200);
    kwSlider.style.setProperty('--fill', (Math.min(kw,200)/200*100) + '%');

    const kwCards   = Math.max(1, Math.ceil(kw / 6));
    const billCards = bill > 0 ? Math.max(1, Math.ceil(bill / 6000)) : 1;
    const base  = Math.max(kwCards, billCards);
    const total = threePhase ? base + 1 : base;

    kwCardsEl.textContent   = kwCards;
    billCardsEl.textContent = billCards;
    baseWinEl.textContent   = base;
    phaseRow.style.display  = threePhase ? 'flex' : 'none';

    resultNum.textContent  = total;
    resultUnit.textContent = total > 1 ? 'Cards' : 'Card';
    stickyNum.textContent  = total;
    stickyUnit.textContent = total > 1 ? 'Cards' : 'Card';

    /* Chip meter */
    chipMeter.innerHTML = '';
    const capped = Math.min(total, 30);
    for(let i = 0; i < capped; i++){
      const c = document.createElement('div');
      c.className = 'vsc-chip-icon vsc-lit';
      chipMeter.appendChild(c);
    }
    if(total > 30){
      const more = document.createElement('div');
      more.style.cssText = 'color:#F17022;font-size:12.5px;font-weight:800;align-self:center;margin-left:4px;';
      more.textContent = '+' + (total - 30) + ' more';
      chipMeter.appendChild(more);
    }
  }

  kwSlider.addEventListener('input',  function(){ kwNumber.value = kwSlider.value; sync(); });
  kwNumber.addEventListener('input',  sync);
  billNumber.addEventListener('input',sync);

  btnSingle.addEventListener('click', function(){
    threePhase = false;
    btnSingle.classList.add('vsc-active');
    btnThree.classList.remove('vsc-active');
    sync();
  });
  btnThree.addEventListener('click', function(){
    threePhase = true;
    btnThree.classList.add('vsc-active');
    btnSingle.classList.remove('vsc-active');
    sync();
  });

  /* Tab switching */
  document.querySelectorAll('.vsc-tab-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.vsc-tab-btn').forEach(function(b){ b.classList.remove('vsc-active'); });
      document.querySelectorAll('.vsc-example-panel').forEach(function(p){ p.classList.remove('vsc-active'); });
      btn.classList.add('vsc-active');
      const panel = document.querySelector('.vsc-example-panel[data-vpanel="'+btn.dataset.vtab+'"]');
      if(panel) panel.classList.add('vsc-active');
    });
  });

  /* Mobile sticky bar: show once calculator scrolled past */
  const calcSection = document.getElementById('vsc-calculator');
  if(calcSection && typeof IntersectionObserver !== 'undefined'){
    const io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.boundingClientRect.top < 0 && !e.isIntersecting){
          sticky.classList.add('vsc-sticky-show');
        } else if(e.isIntersecting){
          sticky.classList.remove('vsc-sticky-show');
        }
      });
    }, {threshold:0});
    io.observe(calcSection);
  }

  sync();
})();
</script>

