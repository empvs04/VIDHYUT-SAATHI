  gap: 14px;
  padding: 14px 20px;
}
.vscc .badge-item.full-width-mob .lbl {
  margin-top: 0;
  text-align: left;
}
.vscc .badge-item .big {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 22px;
  color: var(--orange);
