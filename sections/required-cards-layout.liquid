<style>
/* ============================================================
   VIDHYUT SAATHI — CARD CALCULATOR PAGE
   Desktop & Mobile Responsive Section
   ============================================================ */
.vscc {
  --bg:       #faf7ee;
  --bg-warm:  #f3efe1;
  --panel:    #ffffff;
  --panel-2:  #fbf8f0;
  --line:     #e5e0cf;
  --line-s:   #eeead9;
  --green:    #0e6b3e;
  --green-d:  #0a4a2c;
  --green-t:  #e6f2ea;
  --orange:   #f0631b;
  --orange-t: #fdece1;
  --gold:     #c9982e;
  --ink:      #16281f;
  --muted:    #5e7568;
  --muted-2:  #8ba095;
  --tap:      48px;
  --maxw:     1140px;

  background: var(--bg);
  color: var(--ink);
  font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  font-size: 16px;
}
.vscc *, .vscc *::before, .vscc *::after {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}
.vscc h1, .vscc h2, .vscc h3 {
  font-family: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif;
  letter-spacing: -.02em;
}
.vscc a { color: inherit; text-decoration: none; }
.vscc img { max-width: 100%; display: block; }
.vscc button { font-family: inherit; cursor: pointer; }

.vscc .wrap {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 18px;
}
@media(min-width:640px){ .vscc .wrap { padding: 0 32px; } }

/* ---- TEXTURE ---- */
.vscc .texture-bg {
  position: absolute; inset: 0; z-index: 0;
  background-image:
    linear-gradient(var(--line-s) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-s) 1px, transparent 1px);
  background-size: 36px 36px;
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 10%, black 30%, transparent 80%);
          mask-image: radial-gradient(ellipse 80% 60% at 50% 10%, black 30%, transparent 80%);
}

/* ---- HERO ---- */
.vscc .hero {
  position: relative;
  padding: 40px 0 36px;
  overflow: hidden;
}
@media(min-width:760px){ .vscc .hero { padding: 72px 0 56px; } }

.vscc .eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--green); font-size: 11px; letter-spacing: .08em;
  font-family: 'IBM Plex Mono', monospace;
  text-transform: uppercase; font-weight: 600;
  border: 1px solid var(--green);
  padding: 8px 16px; border-radius: 999px;
  margin-bottom: 20px; background: var(--green-t);
}
.vscc .eyebrow .dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--orange); flex-shrink: 0;
  box-shadow: 0 0 0 3px var(--orange-t);
}

.vscc .hero h1 {
  font-size: clamp(28px, 7vw, 56px);
  line-height: 1.12; font-weight: 700;
  margin: 0 0 18px; max-width: 800px;
}
.vscc .hero h1 em { font-style: normal; color: var(--orange); }

.vscc .hero .lead {
  color: var(--muted);
  font-size: clamp(14.5px, 3.5vw, 17px);
  line-height: 1.65; max-width: 560px;
  margin: 0 0 28px;
}

.vscc .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px; }
.vscc .btn-primary {
  background: var(--orange); color: #fff; font-weight: 700;
  padding: 16px 28px; border-radius: 14px;
  font-size: 16px; border: none;
  box-shadow: 0 8px 24px -8px rgba(240,99,27,.45);
  min-height: 52px;
  display: inline-flex; align-items: center; justify-content: center;
  transition: transform .15s, box-shadow .15s;
}
.vscc .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 12px 28px -8px rgba(240,99,27,.5); }
.vscc .btn-ghost {
  border: 1.5px solid var(--green); color: var(--green);
  padding: 16px 28px; border-radius: 14px;
  font-size: 16px; font-weight: 700;
  min-height: 52px;
  display: inline-flex; align-items: center; justify-content: center;
  background: #fff;
  transition: background .15s, color .15s;
}
.vscc .btn-ghost:hover { background: var(--green-t); }

.vscc .hero-features-strip {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 20px;
  padding-top: 24px; border-top: 1px solid var(--line);
  font-size: 13.5px; color: var(--muted);
}
@media(min-width:640px){
  .vscc .hero-features-strip { grid-template-columns: repeat(4, auto); justify-content: start; gap: 32px; }
}
.vscc .hf-item { display: flex; align-items: center; gap: 8px; }
.vscc .hf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); flex-shrink: 0; }
.vscc .hf-item b { color: var(--green); font-weight: 700; }

/* ---- SECTIONS ---- */
.vscc .sec { padding: 52px 0; }
@media(min-width:760px){ .vscc .sec { padding: 72px 0; } }

.vscc .sec-head { max-width: 640px; margin: 0 0 32px; }
.vscc .sec-eyebrow {
  font-size: 11px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--orange);
  margin-bottom: 8px; font-weight: 700;
}
.vscc .sec h2 { font-size: clamp(22px, 5vw, 32px); margin: 0 0 10px; font-weight: 700; }
.vscc .sec p.desc { color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0; }

/* ---- CALCULATOR ---- */
.vscc .calc-outer-box {
  position: relative;
  background: #fbf8f0;
  border: 1.5px solid #f0631b;
  border-radius: 24px;
  padding: 36px 20px 24px;
  margin-top: 16px;
  box-shadow: 0 4px 20px rgba(240,99,27,0.06);
}
@media(min-width:640px){
  .vscc .calc-outer-box { padding: 40px 32px 32px; }
}

.vscc .live-calc-badge {
  position: absolute;
  top: -14px;
  left: 24px;
  background: #e8c766;
  color: #16281f;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 999px;
  border: 1.5px solid #c9982e;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'IBM Plex Mono', monospace;
}

.vscc .field {
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
  margin-bottom: 24px !important;
  clear: both !important;
  box-sizing: border-box !important;
}
.vscc .field:last-child { margin-bottom: 0 !important; }

.vscc .field-label {
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between !important;
  align-items: center !important;
  width: 100% !important;
  margin-bottom: 12px !important;
  float: none !important;
  box-sizing: border-box !important;
}
.vscc .field-label > span:first-child {
  font-family: 'IBM Plex Mono', monospace !important;
  font-weight: 700 !important;
  font-size: 11.5px !important;
  letter-spacing: .04em !important;
  text-transform: uppercase !important;
  color: var(--ink) !important;
  white-space: nowrap !important;
}
.vscc .field-val {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: var(--orange-t) !important;
  color: var(--orange) !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  padding: 4px 12px !important;
  border-radius: 8px !important;
  font-family: 'IBM Plex Mono', monospace !important;
  flex-shrink: 0 !important;
  white-space: nowrap !important;
  float: none !important;
}

.vscc input[type=range] {
  display: block !important;
  width: 100% !important;
  -webkit-appearance: none !important;
  appearance: none !important;
  height: 8px !important;
  border-radius: 999px !important;
  background: linear-gradient(90deg, var(--green) 0%, var(--green) var(--fill,10%), var(--line) var(--fill,10%)) !important;
  outline: none !important;
  margin: 10px 0 14px 0 !important;
  touch-action: pan-y !important;
  box-sizing: border-box !important;
  float: none !important;
}
.vscc input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none !important;
  width: 28px !important;
  height: 28px !important;
  border-radius: 50% !important;
  background: var(--orange) !important;
  border: 4px solid #fff !important;
  box-shadow: 0 2px 8px rgba(0,0,0,.25) !important;
  cursor: pointer !important;
}
.vscc input[type=range]::-moz-range-thumb {
  width: 28px !important;
  height: 28px !important;
  border-radius: 50% !important;
  background: var(--orange) !important;
  border: 4px solid #fff !important;
  box-shadow: 0 2px 8px rgba(0,0,0,.25) !important;
  cursor: pointer !important;
}

.vscc .field-input-box {
  display: block !important;
  width: 100% !important;
  clear: both !important;
  margin-top: 6px !important;
  box-sizing: border-box !important;
}

.vscc .num-input {
  display: block !important;
  width: 100% !important;
  min-width: 100% !important;
  height: 52px !important;
  min-height: 52px !important;
  background: #ffffff !important;
  border: 1.5px solid #e5e0cf !important;
  color: var(--ink) !important;
  font-family: 'IBM Plex Mono', monospace !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  padding: 12px 16px !important;
  border-radius: 12px !important;
  outline: none !important;
  box-sizing: border-box !important;
  float: none !important;
  box-shadow: inset 0 1px 3px rgba(0,0,0,0.04) !important;
  transition: border-color .15s, box-shadow .15s !important;
}
.vscc .num-input:focus {
  border-color: #f0631b !important;
  background: #ffffff !important;
  box-shadow: 0 0 0 3px rgba(240,99,27,0.15) !important;
}

.vscc .prefix-wrap {
  position: relative !important;
  display: block !important;
  width: 100% !important;
  clear: both !important;
  box-sizing: border-box !important;
}
.vscc .prefix-wrap .pfx {
  position: absolute !important;
  left: 16px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  color: var(--muted-2) !important;
  font-family: 'IBM Plex Mono', monospace !important;
  pointer-events: none !important;
  font-size: 18px !important;
  font-weight: 700 !important;
  z-index: 2 !important;
}
.vscc .prefix-wrap input.num-input {
  padding-left: 36px !important;
}

.vscc .toggle-grp { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.vscc .tog-btn {
  padding: 14px 10px; border-radius: 12px;
  border: 1.5px solid var(--line);
  background: #ffffff; color: var(--muted);
  font-weight: 700; font-size: 13.5px;
  min-height: 50px;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: all .15s;
  white-space: nowrap;
}
.vscc .tog-btn.active {
  border-color: #0a4a2c; color: #ffffff;
  background: #0a4a2c;
  box-shadow: 0 4px 12px rgba(10,74,44,.2);
}

/* Savings Box */
.vscc .savings-box {
  background: linear-gradient(135deg, #0a4a2c, #0e6b3e);
  border-radius: 16px;
  padding: 16px 18px;
  color: #ffffff;
  margin: 18px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  box-shadow: 0 4px 16px rgba(10,74,44,0.2);
}
.vscc .savings-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  color: #cfe4d7;
  text-transform: uppercase;
  font-family: 'IBM Plex Mono', monospace;
  margin-bottom: 4px;
  white-space: nowrap;
}
.vscc .savings-amount {
  font-family: 'Space Grotesk', 'IBM Plex Mono', monospace;
  font-weight: 800;
  font-size: clamp(16px, 4.5vw, 22px);
  color: #ffffff;
  white-space: nowrap;
}
.vscc .savings-icon {
  font-size: 26px;
  flex-shrink: 0;
}

/* Action Buttons */
.vscc .calc-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 18px;
}
@media(max-width:480px){
  .vscc .calc-actions { grid-template-columns: 1fr; }
}

.vscc .btn-wa {
  background: #25D366;
  color: #ffffff;
  font-weight: 700;
  font-size: 14px;
  padding: 13px 16px;
  border-radius: 12px;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(37,211,102,0.25);
  transition: transform .15s;
}
.vscc .btn-wa:hover { transform: translateY(-1px); }

.vscc .btn-quote {
  background: #ffffff;
  color: #0a4a2c;
  border: 1.5px solid #0e6b3e;
  font-weight: 700;
  font-size: 14px;
  padding: 13px 16px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  transition: background .15s;
}
.vscc .btn-quote:hover { background: #e6f2ea; }

/* output side */
.vscc .c-output {
  padding: 28px 24px;
  background: var(--panel-2);
  display: flex; flex-direction: column; gap: 0;
}
@media(min-width:520px){ .vscc .c-output { padding: 34px 32px; } }
@media(min-width:860px){ .vscc .c-output { padding: 40px 36px; background: var(--panel); } }

.vscc .res-label {
  font-size: 11px; font-weight: 700; letter-spacing: .14em;
  text-transform: uppercase; color: var(--muted-2); margin-bottom: 6px;
}
.vscc .res-number {
  font-family: 'Space Grotesk', sans-serif; font-weight: 700;
  font-size: clamp(52px, 14vw, 72px); line-height: 1;
  color: var(--green-d);
  display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  margin-bottom: 20px;
}
.vscc .res-number .unit { font-size: 16px; color: var(--muted); font-weight: 600; font-family: 'Inter'; }

/* ---- REAL 3D ROTATING CARD COMPONENT ---- */
.vscc .vscc-3d-container {
  perspective: 1000px;
  width: 100%;
  max-width: 380px;
  margin: 18px auto 22px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.vscc .vscc-3d-card-stage {
  width: 100%;
  aspect-ratio: 1.586 / 1;
  position: relative;
  transform-style: preserve-3d;
  animation: vsccSpin3D 10s linear infinite;
  border-radius: 16px;
  cursor: pointer;
  box-shadow: 0 16px 38px rgba(0,0,0,0.28), 0 6px 16px rgba(240,99,27,0.2);
}
.vscc .vscc-3d-container:hover .vscc-3d-card-stage {
  animation-play-state: paused;
}

@keyframes vsccSpin3D {
  0%   { transform: rotateY(0deg) rotateX(2deg); }
  50%  { transform: rotateY(180deg) rotateX(-2deg); }
  100% { transform: rotateY(360deg) rotateX(2deg); }
}

.vscc .vscc-3d-face {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border: 1px solid rgba(255,255,255,0.25);
  background: #0d2238;
}

.vscc .vscc-3d-face.front {
  transform: rotateY(0deg);
}

.vscc .vscc-3d-face.back {
  transform: rotateY(180deg) scaleX(-1);
}

.vscc .vscc-3d-face img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.vscc .vscc-3d-glare {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.22) 50%, transparent 65%);
  pointer-events: none;
  z-index: 3;
}

.vscc .vscc-3d-ribbon {
  position: absolute;
  top: 12px;
  right: -32px;
  background: var(--orange);
  color: #ffffff;
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: .05em;
  padding: 4px 36px;
  transform: rotate(28deg);
  box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  z-index: 4;
}

.vscc .chip-meter { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 18px; }
.vscc .chip-dot {
  width: 22px; height: 15px; border-radius: 3px;
  background: var(--line); border: 1px solid var(--line);
  transition: background .2s, border-color .2s;
}
.vscc .chip-dot.on { background: linear-gradient(135deg, #e8c766, var(--gold)); border-color: var(--gold); }

.vscc .breakdown {
  background: var(--panel); border: 1.5px solid var(--line);
  border-radius: 13px; padding: 16px;
  font-size: 13.5px; color: var(--muted); line-height: 1.9;
  margin-bottom: 16px;
}
@media(min-width:860px){ .vscc .breakdown { background: var(--panel-2); } }
.vscc .brow { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
.vscc .brow b { color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 13px; }
.vscc .brow.win b { color: var(--green); }
.vscc .bdivider { border: none; border-top: 1px dashed var(--line); margin: 8px 0; }

.vscc .calc-note {
  font-size: 12px; color: var(--muted-2); line-height: 1.65; margin-top: auto;
  padding: 12px 14px; background: var(--green-t);
  border-radius: 10px; border: 1px solid rgba(14,107,62,.2);
}/* ---- REQUIREMENT CHART (CLEAN TABLE FOR DESKTOP & MOBILE) ---- */
.vscc .chart-table-wrap {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-top: 16px;
  box-sizing: border-box;
}

.vscc .chart-table-clean {
  width: 100%;
  border-collapse: collapse;
  background: transparent;
  font-size: 14px;
}

.vscc .chart-table-clean thead tr {
  border-bottom: 1.5px solid var(--line);
}

.vscc .chart-table-clean thead th {
  padding: 12px 10px 14px;
  color: var(--muted);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  text-align: left;
  white-space: nowrap;
}

.vscc .chart-table-clean tbody tr {
  border-bottom: 1px solid var(--line-s);
  transition: background .15s;
}
.vscc .chart-table-clean tbody tr:last-child {
  border-bottom: 1.5px solid var(--line);
}
.vscc .chart-table-clean tbody tr:hover {
  background: rgba(240, 99, 27, 0.03);
}

.vscc .chart-table-clean td {
  padding: 14px 10px;
  color: var(--muted);
  vertical-align: middle;
  white-space: nowrap;
}

.vscc .chart-table-clean td:nth-child(1) {
  font-family: 'Space Grotesk', 'IBM Plex Mono', monospace;
  font-weight: 800;
  color: var(--ink);
  font-size: 15px;
}

.vscc .chart-table-clean td:nth-child(2) {
  font-family: 'Inter', sans-serif;
  color: var(--muted);
  font-size: 14px;
}

.vscc .chart-table-clean td:nth-child(3),
.vscc .chart-table-clean td:nth-child(4) {
  font-family: 'IBM Plex Mono', monospace;
  font-weight: 700;
  color: var(--orange);
  font-size: 14.5px;
}

/* Mobile responsive optimizations for the chart table */
@media(max-width: 767px) {
  .vscc .chart-table-clean thead th {
    font-size: 10px;
    padding: 10px 4px;
    letter-spacing: .02em;
  }
  .vscc .chart-table-clean td {
    padding: 11px 4px;
  }
  .vscc .chart-table-clean td:nth-child(1) {
    font-size: 12px;
  }
  .vscc .chart-table-clean td:nth-child(2) {
    font-size: 11px;
  }
  .vscc .chart-table-clean td:nth-child(3),
  .vscc .chart-table-clean td:nth-child(4) {
    font-size: 12px;
  }
}

@media(max-width: 380px) {
  .vscc .chart-table-clean thead th {
    font-size: 9px;
    padding: 8px 2px;
    letter-spacing: 0;
  }
  .vscc .chart-table-clean td {
    padding: 9px 2px;
  }
  .vscc .chart-table-clean td:nth-child(1) {
    font-size: 11px;
  }
  .vscc .chart-table-clean td:nth-child(2) {
    font-size: 10px;
  }
  .vscc .chart-table-clean td:nth-child(3),
  .vscc .chart-table-clean td:nth-child(4) {
    font-size: 11px;
  }
}

/* rule box */
.vscc .rule-box {
  display: flex; gap: 14px; align-items: flex-start;
  background: var(--green-t); border: 1.5px solid var(--green);
  border-radius: 14px; padding: 18px 20px; margin-top: 20px;
  font-size: 13.5px; color: var(--green-d); line-height: 1.65;
}
.vscc .rule-icon {
  width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--green-d), var(--green));
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 18px; box-shadow: 0 4px 12px rgba(14,107,62,.25);
}
.vscc .rule-box b { color: var(--orange); }

/* ---- EXAMPLES ---- */
.vscc .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
.vscc .tab-btn {
  padding: 11px 18px; border-radius: 999px;
  border: 1.5px solid var(--line);
  background: #fff; color: var(--muted);
  font-weight: 700; font-size: 13px; min-height: 44px;
  transition: all .15s;
}
.vscc .tab-btn:hover { border-color: var(--green-d); color: var(--green-d); }
.vscc .tab-btn.active {
  background: linear-gradient(135deg, var(--green-d), var(--green));
  border-color: var(--green); color: #fff;
