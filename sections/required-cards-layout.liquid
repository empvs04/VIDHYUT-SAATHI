<script>
document.addEventListener('DOMContentLoaded', function() {
  // Section 1 Cards Tabs Logic
  const tabBtns = document.querySelectorAll('.req-tab-btn');
  const tabPanels = document.querySelectorAll('.req-tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      tabPanels.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      const targetTabId = btn.getAttribute('data-tab');
      const targetPanel = document.getElementById(targetTabId);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });

  // Section 2 Sector Switcher Tabs Logic
  const sectorBtns = document.querySelectorAll('.req-sector-tab');
  const sectorPanels = document.querySelectorAll('.req-sector-panel');

  sectorBtns.forEach(sBtn => {
    sBtn.addEventListener('click', () => {
      sectorBtns.forEach(sb => sb.classList.remove('active'));
      sectorPanels.forEach(sp => sp.classList.remove('active'));

      sBtn.classList.add('active');
      const sectorId = sBtn.getAttribute('data-sector');
      const targetSectorPanel = document.getElementById('sector-' + sectorId);
      if (targetSectorPanel) {
        targetSectorPanel.classList.add('active');
      }
    });
  });

  // Scenario Slider Dots & Arrow Navigation Click & Live Scroll Sync
  const sectorPanelList = document.querySelectorAll('.req-sector-panel');

  sectorPanelList.forEach(panel => {
    const grid = panel.querySelector('.req-examples-grid');
    const dots = panel.querySelectorAll('.req-slider-dot');
    const prevArrow = panel.querySelector('.prev-arrow');
    const nextArrow = panel.querySelector('.next-arrow');
    if (!grid) return;
    const cards = grid.querySelectorAll('.req-example-card');

    // Click dot to scroll to scenario
    if (dots.length) {
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const targetIndex = parseInt(dot.getAttribute('data-index'), 10) || 0;
          const cardWidth = grid.clientWidth;
          grid.scrollTo({
            left: targetIndex * cardWidth,
            behavior: 'smooth'
          });
          dots.forEach(d => d.classList.remove('active'));
          dot.classList.add('active');
        });
      });
    }

    // Click arrow buttons to navigate
    if (prevArrow && cards.length) {
      prevArrow.addEventListener('click', () => {
        const cardWidth = grid.clientWidth;
        const currentIdx = Math.round(grid.scrollLeft / cardWidth);
        const prevIdx = (currentIdx - 1 + cards.length) % cards.length;
        grid.scrollTo({ left: prevIdx * cardWidth, behavior: 'smooth' });
      });
    }

    if (nextArrow && cards.length) {
      nextArrow.addEventListener('click', () => {
        const cardWidth = grid.clientWidth;
        const currentIdx = Math.round(grid.scrollLeft / cardWidth);
        const nextIdx = (currentIdx + 1) % cards.length;
        grid.scrollTo({ left: nextIdx * cardWidth, behavior: 'smooth' });
      });
    }

    // Update dot active state on grid scroll
    grid.addEventListener('scroll', () => {
      const cardWidth = grid.clientWidth;
      if (!cardWidth || !dots.length) return;
      const activeIdx = Math.round(grid.scrollLeft / cardWidth);
      dots.forEach((d, idx) => {
        if (idx === activeIdx) {
          d.classList.add('active');
        } else {
          d.classList.remove('active');
        }
      });
    });
  });

  // Auto-Slide Mobile Examples Every 15 Seconds when Section 2 in View
  let autoSlideTimer = null;

  function startAutoSlide() {
    if (autoSlideTimer) return;
    autoSlideTimer = setInterval(() => {
      if (window.innerWidth > 768) return; // Only run on mobile viewports
      const activeSectorPanel = document.querySelector('.req-sector-panel.active');
      if (!activeSectorPanel) return;
      const grid = activeSectorPanel.querySelector('.req-examples-grid');
      if (!grid) return;
      
      const cards = grid.querySelectorAll('.req-example-card');
      if (cards.length < 2) return;

      const cardWidth = grid.clientWidth;
      const currentIndex = Math.round(grid.scrollLeft / cardWidth);
      const nextIndex = (currentIndex + 1) % cards.length;

      grid.scrollTo({
        left: nextIndex * cardWidth,
        behavior: 'smooth'
      });
    }, 15000); // 15 Seconds interval
  }

  function stopAutoSlide() {
    if (autoSlideTimer) {
      clearInterval(autoSlideTimer);
      autoSlideTimer = null;
    }
  }

  // IntersectionObserver to trigger 15-second auto slide when user enters Section 2
  const sec2 = document.querySelector('.req-sec2-section');
  if (sec2 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          startAutoSlide();
        } else {
          stopAutoSlide();
        }
      });
    }, { threshold: 0.15 });
    observer.observe(sec2);
  } else {
    startAutoSlide();
  }
});
</script>

