<style>
/* ============================================================
   VIDHYUT SAATHI — CARD CALCULATOR PAGE
   Premium design • Fully mobile-first responsive
   ============================================================ */
.vscc {
  --bg:       #faf7ee;
  --bg-warm:  #f3efe1;
  --panel:    #ffffff;
  --panel-2:  #fbf8f0;
  --line:     #e5e0cf;
  --line-s:   #eeead9;
  --green:    #0e6b3e;
  --green-d:  #0a4a2c;
  --green-t:  #e6f2ea;
  --orange:   #f0631b;
  --orange-t: #fdece1;
  --gold:     #c9982e;
  --ink:      #16281f;
  --muted:    #5e7568;
  --muted-2:  #8ba095;
  --tap:      48px;
  --maxw:     1140px;
  --r:        14px;

  background: var(--bg);
  color: var(--ink);
  font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  font-size: 16px;
}
.vscc *, .vscc *::before, .vscc *::after {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}
.vscc h1, .vscc h2, .vscc h3 {
  font-family: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif;
  letter-spacing: -.02em;
}
.vscc a { color: inherit; text-decoration: none; }
.vscc img { max-width: 100%; display: block; }
.vscc button { font-family: inherit; cursor: pointer; }

.vscc .wrap {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 18px;
}
@media(min-width:640px){ .vscc .wrap { padding: 0 32px; } }

/* ---- TEXTURE ---- */
.vscc .texture-bg {
  position: absolute; inset: 0; z-index: 0;
  background-image:
    linear-gradient(var(--line-s) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-s) 1px, transparent 1px);
  background-size: 36px 36px;
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 10%, black 30%, transparent 80%);
          mask-image: radial-gradient(ellipse 80% 60% at 50% 10%, black 30%, transparent 80%);
}

/* ---- HERO ---- */
.vscc .hero {
  position: relative;
  padding: 40px 0 36px;
  overflow: hidden;
}
@media(min-width:760px){ .vscc .hero { padding: 72px 0 56px; } }

.vscc .eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--green); font-size: 11px; letter-spacing: .12em;
  text-transform: uppercase; font-weight: 700;
  border: 1px solid var(--green);
  padding: 7px 14px; border-radius: 999px;
  margin-bottom: 18px; background: var(--green-t);
}
.vscc .eyebrow .dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--orange); flex-shrink: 0;
  box-shadow: 0 0 0 3px var(--orange-t);
}

.vscc .hero h1 {
  font-size: clamp(26px, 7vw, 56px);
  line-height: 1.1; font-weight: 700;
  margin: 0 0 16px; max-width: 800px;
}
.vscc .hero h1 em { font-style: normal; color: var(--orange); }

.vscc .hero .lead {
  color: var(--muted);
  font-size: clamp(14.5px, 3.5vw, 17px);
  line-height: 1.65; max-width: 560px;
  margin: 0 0 28px;
}

.vscc .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.vscc .btn-primary {
  background: var(--orange); color: #fff; font-weight: 700;
  padding: 14px 28px; border-radius: 12px;
  font-size: 15px; border: none;
  box-shadow: 0 8px 24px -8px rgba(240,99,27,.45);
  min-height: var(--tap);
  display: inline-flex; align-items: center; justify-content: center;
  transition: transform .15s, box-shadow .15s;
}
.vscc .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 12px 28px -8px rgba(240,99,27,.5); }
.vscc .btn-ghost {
  border: 2px solid var(--green); color: var(--green);
  padding: 14px 28px; border-radius: 12px;
  font-size: 15px; font-weight: 700;
  min-height: var(--tap);
  display: inline-flex; align-items: center; justify-content: center;
  background: #fff;
  transition: background .15s, color .15s;
}
.vscc .btn-ghost:hover { background: var(--green-t); }

/* ---- SECTIONS ---- */
.vscc .sec { padding: 52px 0; }
@media(min-width:760px){ .vscc .sec { padding: 72px 0; } }

.vscc .sec-head { max-width: 640px; margin: 0 0 32px; }
.vscc .sec-eyebrow {
  font-size: 11px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--orange);
  margin-bottom: 8px; font-weight: 700;
}
.vscc .sec h2 { font-size: clamp(22px, 5vw, 32px); margin: 0 0 10px; font-weight: 700; }
.vscc .sec p.desc { color: var(--muted); font-size: 15px; line-height: 1.65; margin: 0; }

/* ---- CALCULATOR ---- */
.vscc .calc-wrap {
  background: var(--panel);
  border: 1.5px solid var(--line);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 2px 0 rgba(0,0,0,.02), 0 24px 56px -24px rgba(10,74,44,.18);
  display: grid;
  grid-template-columns: 1fr;
}
@media(min-width:860px){ .vscc .calc-wrap { grid-template-columns: 1fr 1fr; } }

/* inputs side */
.vscc .c-inputs {
  padding: 28px 24px;
  border-bottom: 1.5px solid var(--line);
}
@media(min-width:520px){ .vscc .c-inputs { padding: 34px 32px; } }
@media(min-width:860px){
  .vscc .c-inputs { border-bottom: none; border-right: 1.5px solid var(--line); padding: 40px 36px; }
}

.vscc .c-inputs-title {
  font-size: 11px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: var(--muted-2);
  margin-bottom: 24px; padding-bottom: 14px;
  border-bottom: 1px dashed var(--line);
  display: flex; align-items: center; gap: 8px;
}
.vscc .c-inputs-title span {
  background: var(--green-t); color: var(--green);
  padding: 4px 10px; border-radius: 6px; font-size: 11px;
}

.vscc .field { margin-bottom: 22px; }
.vscc .field:last-child { margin-bottom: 0; }

.vscc .field-label {
  display: flex; justify-content: space-between; align-items: center;
  font-weight: 700; color: var(--ink);
  font-size: 12px; letter-spacing: .04em; text-transform: uppercase;
  margin-bottom: 10px;
}
.vscc .field-val {
  background: var(--orange-t); color: var(--orange);
  font-size: 14px; font-weight: 700;
  padding: 3px 10px; border-radius: 6px;
  font-family: 'IBM Plex Mono', monospace;
}

.vscc input[type=range] {
  width: 100%; -webkit-appearance: none; appearance: none;
  height: 8px; border-radius: 999px;
  background: linear-gradient(90deg, var(--green) 0%, var(--green) var(--fill,10%), var(--line) var(--fill,10%));
  outline: none; margin: 6px 0; touch-action: pan-y;
}
.vscc input[type=range]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%;
  background: var(--orange); border: 4px solid #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.25); cursor: pointer;
}
.vscc input[type=range]::-moz-range-thumb {
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--orange); border: 4px solid #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.25); cursor: pointer;
}

.vscc .num-input {
  width: 100%; background: var(--panel-2);
  border: 1.5px solid var(--line); color: var(--ink);
  font-family: 'IBM Plex Mono', monospace; font-size: 16px;
  padding: 13px 15px; border-radius: 11px;
  outline: none; min-height: var(--tap);
  transition: border-color .15s, background .15s;
}
.vscc .num-input:focus { border-color: var(--orange); background: #fff; }

.vscc .prefix-wrap { position: relative; }
.vscc .prefix-wrap .pfx {
  position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
  color: var(--muted-2); font-family: 'IBM Plex Mono', monospace;
  pointer-events: none; font-size: 16px;
}
.vscc .prefix-wrap input { padding-left: 32px; }

.vscc .toggle-grp { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.vscc .tog-btn {
  padding: 13px 10px; border-radius: 11px;
  border: 1.5px solid var(--line);
  background: var(--panel-2); color: var(--muted);
  font-weight: 700; font-size: 13.5px;
  min-height: var(--tap);
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: all .15s;
}
.vscc .tog-btn.active {
  border-color: var(--green); color: var(--green-d);
  background: var(--green-t);
  box-shadow: 0 0 0 3px rgba(14,107,62,.12);
}

/* output side */
.vscc .c-output {
  padding: 28px 24px;
  background: var(--panel-2);
  display: flex; flex-direction: column; gap: 0;
}
@media(min-width:520px){ .vscc .c-output { padding: 34px 32px; } }
@media(min-width:860px){ .vscc .c-output { padding: 40px 36px; background: var(--panel); } }

.vscc .res-label {
  font-size: 11px; font-weight: 700; letter-spacing: .14em;
  text-transform: uppercase; color: var(--muted-2); margin-bottom: 6px;
}
.vscc .res-number {
  font-family: 'Space Grotesk', sans-serif; font-weight: 700;
  font-size: clamp(52px, 14vw, 72px); line-height: 1;
  color: var(--green-d);
  display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  margin-bottom: 20px;
}
.vscc .res-number .unit { font-size: 16px; color: var(--muted); font-weight: 600; font-family: 'Inter'; }

/* product card mockup */
.vscc .card-mock {
  border-radius: 14px; overflow: hidden; position: relative;
  background: linear-gradient(135deg, #0b2440 0%, #173a5c 55%, #0b2440 100%);
  padding: 16px 18px; min-height: 82px;
  display: flex; flex-direction: column; justify-content: space-between;
  margin-bottom: 18px;
}
.vscc .card-mock .mock-ribbon {
  position: absolute; top: 10px; right: -28px;
  background: var(--orange); color: #fff;
  font-size: 9px; font-weight: 700; letter-spacing: .04em;
  padding: 3px 36px; transform: rotate(28deg);
}
.vscc .card-mock .mock-chip {
  width: 28px; height: 20px; border-radius: 4px;
  background: linear-gradient(135deg, #e8c766, var(--gold));
}
.vscc .card-mock .mock-label {
  color: rgba(207,224,240,.85);
  font-size: 10px; letter-spacing: .08em;
  font-family: 'IBM Plex Mono', monospace;
}

/* chip meter */
.vscc .chip-meter { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 18px; }
.vscc .chip-dot {
  width: 22px; height: 15px; border-radius: 3px;
  background: var(--line); border: 1px solid var(--line);
  transition: background .2s, border-color .2s;
}
.vscc .chip-dot.on { background: linear-gradient(135deg, #e8c766, var(--gold)); border-color: var(--gold); }

/* breakdown */
.vscc .breakdown {
  background: var(--panel); border: 1.5px solid var(--line);
  border-radius: 13px; padding: 16px;
  font-size: 13.5px; color: var(--muted); line-height: 1.9;
  margin-bottom: 16px;
}
@media(min-width:860px){ .vscc .breakdown { background: var(--panel-2); } }
.vscc .brow { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
.vscc .brow b { color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 13px; }
.vscc .brow.win b { color: var(--green); }
.vscc .brow hr { border: none; border-top: 1px dashed var(--line); margin: 6px 0; }
.vscc .bdivider { border: none; border-top: 1px dashed var(--line); margin: 8px 0; }

.vscc .calc-note {
  font-size: 12px; color: var(--muted-2); line-height: 1.65; margin-top: auto;
  padding: 12px 14px; background: var(--green-t);
  border-radius: 10px; border: 1px solid rgba(14,107,62,.2);
}

/* ---- REQUIREMENT CHART ---- */
.vscc .chart-outer {
  border-radius: 20px; overflow: hidden;
  border: 1.5px solid var(--line);
  box-shadow: 0 12px 40px -12px rgba(10,74,44,.1);
}

.vscc .chart-header {
  background: linear-gradient(135deg, var(--green-d) 0%, var(--green) 100%);
  padding: 18px 20px;
  display: grid;
  grid-template-columns: 1fr 1.6fr 1fr 1fr;
  gap: 10px;
}
.vscc .chart-header .ch {
  color: rgba(255,255,255,.85); font-size: 11px; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase;
}

.vscc .chart-body { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.vscc .chart-table {
  width: 100%; min-width: 480px;
  border-collapse: collapse;
}
.vscc .chart-table thead tr {
  background: linear-gradient(135deg, var(--green-d), var(--green));
}
.vscc .chart-table thead th {
  padding: 16px 20px; color: rgba(255,255,255,.9);
  font-size: 11.5px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; text-align: left;
  white-space: nowrap;
}
.vscc .chart-table thead th:nth-child(3),
.vscc .chart-table thead th:nth-child(4) { text-align: center; }

.vscc .chart-table tbody tr {
  border-bottom: 1px solid var(--line-s);
  transition: background .12s;
}
.vscc .chart-table tbody tr:last-child { border-bottom: none; }
.vscc .chart-table tbody tr:nth-child(even) { background: var(--panel-2); }
.vscc .chart-table tbody tr:hover { background: var(--bg-warm); }
.vscc .chart-table tbody tr:hover { background: #f5f0e4; }

.vscc .chart-table td {
  padding: 14px 20px; color: var(--muted); font-size: 14px;
  white-space: nowrap; vertical-align: middle;
}
.vscc .chart-table td:first-child {
  font-weight: 800; color: var(--ink);
  font-family: 'IBM Plex Mono', monospace;
}
.vscc .chart-table td.single { text-align: center; }
.vscc .chart-table td.three  { text-align: center; }

.vscc .pill-orange {
  display: inline-block;
  background: var(--orange-t); border: 1.5px solid rgba(240,99,27,.35);
  color: var(--orange); font-weight: 800; font-size: 13px;
  padding: 4px 14px; border-radius: 999px;
  font-family: 'IBM Plex Mono', monospace;
}
.vscc .pill-green {
  display: inline-block;
  background: var(--green-t); border: 1.5px solid rgba(14,107,62,.35);
  color: var(--green-d); font-weight: 800; font-size: 13px;
  padding: 4px 14px; border-radius: 999px;
  font-family: 'IBM Plex Mono', monospace;
}
.vscc .kw-badge {
  display: inline-flex; align-items: center; gap: 5px;
}
.vscc .kw-badge .kw-icon {
  font-size: 13px;
}

/* scroll hint on mobile */
.vscc .scroll-hint {
  display: none;
  font-size: 12px; color: var(--muted-2);
  text-align: center; padding: 8px;
  background: var(--panel-2);
  border-top: 1px solid var(--line-s);
}
@media(max-width:600px){ .vscc .scroll-hint { display: block; } }

/* rule box */
.vscc .rule-box {
  display: flex; gap: 14px; align-items: flex-start;
  background: var(--green-t); border: 1.5px solid var(--green);
  border-radius: 14px; padding: 18px 20px; margin-top: 20px;
  font-size: 13.5px; color: var(--green-d); line-height: 1.65;
}
.vscc .rule-icon {
  width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--green-d), var(--green));
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  box-shadow: 0 4px 12px rgba(14,107,62,.25);
}
.vscc .rule-box b { color: var(--orange); }

/* ---- EXAMPLES ---- */
.vscc .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
.vscc .tab-btn {
  padding: 11px 18px; border-radius: 999px;
  border: 1.5px solid var(--line);
  background: #fff; color: var(--muted);
  font-weight: 700; font-size: 13px; min-height: 44px;
  transition: all .15s;
}
.vscc .tab-btn:hover { border-color: var(--green-d); color: var(--green-d); }
.vscc .tab-btn.active {
  background: linear-gradient(135deg, var(--green-d), var(--green));
  border-color: var(--green); color: #fff;
  box-shadow: 0 6px 18px rgba(14,107,62,.25);
}
.vscc .eg-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media(min-width:680px){ .vscc .eg-grid { grid-template-columns: 1fr 1fr; gap: 20px; } }
.vscc .eg-panel { display: none; }
.vscc .eg-panel.active { display: grid; }
.vscc .eg-card {
  background: var(--panel); border: 1.5px solid var(--line);
  border-radius: 18px; padding: 22px;
  transition: border-color .2s, transform .2s, box-shadow .2s;
}
.vscc .eg-card:hover {
  border-color: rgba(240,99,27,.4);
  transform: translateY(-3px);
  box-shadow: 0 16px 40px -12px rgba(240,99,27,.12);
}
.vscc .eg-card h4 { margin: 0 0 4px; font-size: 16.5px; font-weight: 800; color: var(--ink); }
.vscc .eg-sub {
  color: var(--muted-2); font-size: 11.5px; margin-bottom: 16px;
  font-family: 'IBM Plex Mono', monospace; letter-spacing: .04em;
}
.vscc .eg-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
.vscc .eg-stat {
  background: var(--panel-2); border: 1px solid var(--line);
  border-radius: 10px; padding: 12px 14px;
}
.vscc .eg-stat .k { color: var(--muted-2); font-size: 10px; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; margin-bottom: 4px; }
.vscc .eg-stat .v { font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 15.5px; color: var(--ink); }
.vscc .eg-result {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--orange-t); border: 1.5px solid rgba(240,99,27,.35);
  border-radius: 11px; padding: 13px 16px;
  margin-bottom: 12px;
}
.vscc .eg-result .rl { font-size: 12px; color: var(--orange); font-weight: 700; }
.vscc .eg-result .rn { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--orange); font-size: 20px; }
.vscc .eg-why {
  font-size: 12.5px; color: var(--muted); line-height: 1.6;
  background: var(--panel-2); border-left: 3px solid var(--green);
  padding: 10px 12px; border-radius: 8px;
}

/* ---- BADGES ---- */
.vscc .badges-row {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
}
@media(min-width:600px){ .vscc .badges-row { grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line); border: 1.5px solid var(--line); border-radius: 18px; overflow: hidden; } }
.vscc .badge-item {
  background: var(--panel); padding: 22px 14px; text-align: center;
  border-radius: 14px; border: 1.5px solid var(--line);
}
@media(min-width:600px){ .vscc .badge-item { border-radius: 0; border: none; padding: 28px 14px; } }
.vscc .badge-item .big { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 21px; color: var(--orange); }
.vscc .badge-item .lbl { font-size: 11.5px; color: var(--muted); margin-top: 6px; line-height: 1.4; }

/* ---- CTA ---- */
.vscc .cta-band {
  background: linear-gradient(135deg, var(--green-d), var(--green));
  border-radius: 22px; color: #fff;
  padding: 40px 28px; text-align: center;
  position: relative; overflow: hidden;
}
.vscc .cta-band::before {
  content: ''; position: absolute;
  top: -80px; right: -80px; width: 260px; height: 260px;
  background: radial-gradient(circle, rgba(255,255,255,.12), transparent 70%);
  pointer-events: none;
}
@media(min-width:640px){ .vscc .cta-band { padding: 56px 48px; } }
.vscc .cta-band h3 { font-size: clamp(20px, 5vw, 30px); margin: 0 0 14px; }
.vscc .cta-band p { color: rgba(207,228,215,.9); margin: 0 0 28px; font-size: 15px; max-width: 460px; margin-left: auto; margin-right: auto; }
.vscc .cta-band .btn-white {
  background: #fff; color: var(--green-d); font-weight: 800;
  padding: 15px 32px; border-radius: 12px; font-size: 15px;
  display: inline-flex; align-items: center;
  box-shadow: 0 8px 24px rgba(0,0,0,.15);
  transition: transform .15s;
}
.vscc .cta-band .btn-white:hover { transform: translateY(-2px); }

/* ---- STICKY BAR ---- */
.vscc .sticky-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  background: var(--green-d); color: #fff;
  padding: 14px 20px;
  padding-bottom: calc(14px + env(safe-area-inset-bottom));
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  box-shadow: 0 -6px 20px rgba(0,0,0,.2);
  transform: translateY(110%);
  transition: transform .28s cubic-bezier(.16,1,.3,1);
}
.vscc .sticky-bar.show { transform: translateY(0); }
@media(min-width:860px){ .vscc .sticky-bar { display: none !important; } }
.vscc .sticky-bar .stxt { font-size: 11.5px; color: rgba(207,228,215,.9); font-weight: 600; }
.vscc .sticky-bar .snum { font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 22px; line-height: 1; }
.vscc .sticky-bar .sadj {
  background: var(--orange); color: #fff; font-weight: 700; font-size: 13.5px;
  padding: 11px 20px; border-radius: 10px; flex-shrink: 0;
  display: inline-flex; align-items: center;
}

/* ---- MOBILE OVERRIDES (max-width: 767px) ---- */
@media(max-width:767px){
  .vscc .hero { padding: 30px 0 26px; }
  .vscc .hero h1 { font-size: clamp(24px, 8vw, 36px); }
  .vscc .hero .lead { font-size: 14px; line-height: 1.65; text-align: justify; hyphens: auto; }
  .vscc .hero-ctas { flex-direction: column; gap: 10px; }
