/* Dynamic Mini Cards Row */
.vscc .vscc-mini-cards-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  margin: 14px 0 18px 0;
}

.vscc .vscc-mini-card-icon {
  width: 32px;
  height: 20px;
