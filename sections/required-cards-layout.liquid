  padding: 10px 12px; border-radius: 8px;
}

/* ---- BADGES ---- */
.vscc .badges-row {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
}
@media(min-width:600px){ .vscc .badges-row { grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line); border: 1.5px solid var(--line); border-radius: 18px; overflow: hidden; } }
.vscc .badge-item {
