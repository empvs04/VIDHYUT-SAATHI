<style>
  .vsblog-featured-section-wrap {
    background: #faf8f5;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    box-sizing: border-box;
    width: 100%;
    padding: 10px 0 24px 0;
  }

  .vsblog-featured-section-wrap *, .vsblog-featured-section-wrap *::before, .vsblog-featured-section-wrap *::after {
    box-sizing: border-box;
  }

  .vsblog-featured-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media (min-width: 768px) {
    .vsblog-featured-container {
      padding: 0 20px;
    }
  }

  /* ─── FEATURED ARTICLE CARD ─── */
  .vsblog-featured { margin-bottom: 24px; width: 100%; }
  @media (min-width: 768px) { .vsblog-featured { margin-bottom: 32px; } }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #64748b;
    margin-bottom: 14px;
  }

  .vsblog-section-title i {
    color: #ec5c0a;
    font-size: 12px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e2e8f0;
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.02);
    border: 1px solid #e2e8f0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    position: relative;
    width: 100%;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-card { 
      grid-template-columns: 1fr 1fr; 
      border-radius: 22px; 
      min-height: 380px;
    }
  }

  .vsblog-feat-card:active { transform: scale(0.99); }

  .vsblog-feat-card:hover {
    box-shadow: 0 20px 40px -4px rgba(15, 23, 42, 0.10), 0 0 0 1px rgba(236, 92, 10, 0.25);
    border-color: #cbd5e1;
    transform: translateY(-3px);
  }

  .vsblog-feat-img {
    position: relative;
    height: 240px;
    min-height: 240px;
    overflow: hidden;
    background: #0f172a;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-img { height: 100%; min-height: 380px; }
  }

  .vsblog-feat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-feat-card:hover .vsblog-feat-img img {
    transform: scale(1.04);
  }

  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0b1120;
  }

  .vsblog-feat-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-content { padding: 36px 40px; }
  }

  .vsblog-feat-content h2 {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.28;
    margin: 0 0 14px 0;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }

  .vsblog-feat-card:hover .vsblog-feat-content h2 { color: #ea580c; }

  .vsblog-feat-content p {
    color: #475569;
    line-height: 1.65;
    font-size: 13.5px;
    font-weight: 400;
    margin: 0 0 20px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-content p { font-size: 14.5px; line-height: 1.68; -webkit-line-clamp: 3; margin-bottom: 24px; }
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    font-weight: 500;
  }

  .vsblog-meta-chip i { color: #94a3b8; font-size: 12px; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #0f172a;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    width: 100%;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
  }

  @media (min-width: 640px) {
    .vsblog-read-btn { width: fit-content; padding: 12px 26px; }
  }

  .vsblog-read-btn:hover {
    background: #ec5c0a;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.32);
  }

  .vsblog-read-btn i {
    transition: transform 0.2s ease;
  }

  .vsblog-read-btn:hover i {
    transform: translateX(4px);
  }
</style>

<div class="vsblog-featured-section-wrap">
  <div class="vsblog-featured-container">
    <!-- FEATURED ARTICLE (ARTICLE 0) -->
    <div class="vsblog-featured">
      <div class="vsblog-section-title"><i class="fa-solid fa-star"></i> {{ section.settings.section_title | default: "Featured Article" }}</div>
      <div class="vsblog-feat-card" onclick="typeof vsOpenArticleModal === 'function' ? vsOpenArticleModal(0) : null">
        <div class="vsblog-feat-img">
          {% if section.settings.featured_image != blank %}
            <img src="{{ section.settings.featured_image | image_url: width: 900 }}" alt="Featured Article Image" loading="lazy" id="vsblog_featured_custom_img">
          {% else %}
            <div class="vsblog-feat-svg-placeholder">
              <svg viewBox="0 0 600 380" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="display:block;">
                <defs>
                  <linearGradient id="vsFeatBg" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#090d16"/>
                    <stop offset="60%" stop-color="#111827"/>
                    <stop offset="100%" stop-color="#1e293b"/>
                  </linearGradient>
                  <radialGradient id="vsFeatWarmGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#ec5c0a" stop-opacity="0.18"/>
                    <stop offset="100%" stop-color="#ec5c0a" stop-opacity="0"/>
                  </radialGradient>
                  <linearGradient id="vsCardBorderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="rgba(255,255,255,0.2)"/>
                    <stop offset="100%" stop-color="rgba(236,92,10,0.3)"/>
                  </linearGradient>
                  <linearGradient id="vsCardInnerGlow" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="rgba(255,255,255,0.08)"/>
                    <stop offset="100%" stop-color="rgba(255,255,255,0.02)"/>
                  </linearGradient>
                  <pattern id="vsTechGridFeat" width="30" height="30" patternUnits="userSpaceOnUse">
                    <circle cx="15" cy="15" r="1" fill="rgba(255,255,255,0.06)"/>
                  </pattern>
                </defs>

                <!-- Background Canvas -->
                <rect width="600" height="380" fill="url(#vsFeatBg)"/>
                
                <!-- Subtle Dot Grid Overlay -->
                <rect width="600" height="380" fill="url(#vsTechGridFeat)"/>
                
                <!-- Soft Ambient Glow -->
                <circle cx="300" cy="180" r="170" fill="url(#vsFeatWarmGlow)"/>
                
                <!-- Sleek Subtle Wave Lines -->
                <path d="M-50,220 C120,160 220,270 380,210 C480,170 580,240 650,200" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1.5"/>
                <path d="M-50,240 C140,190 260,290 420,230 C500,200 580,260 650,220" fill="none" stroke="rgba(236,92,10,0.18)" stroke-width="1.5"/>

                <!-- Center Floating Tech Badge / Card -->
                <g transform="translate(190, 85)">
                  <!-- Glassmorphic Card Container -->
                  <rect width="220" height="135" rx="16" fill="url(#vsCardInnerGlow)" stroke="url(#vsCardBorderGrad)" stroke-width="1.5" filter="drop-shadow(0 16px 32px rgba(0,0,0,0.4))"/>
                  
                  <!-- Micro Brand Chip / Logo -->
                  <rect x="20" y="20" width="42" height="42" rx="10" fill="linear-gradient(135deg, #ec5c0a 0%, #ff7800 100%)" filter="drop-shadow(0 4px 12px rgba(236,92,10,0.4))"/>
                  <!-- Crisp Lightning Bolt inside Chip -->
                  <path d="M42 27 L36 38 H41 L39 47 L47 36 H42 Z" fill="#ffffff"/>
                  
                  <!-- Card Text Lines -->
                  <text x="74" y="36" fill="#ffffff" font-size="12" font-weight="700" letter-spacing="0.5" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">VIDHYUT SAATHI</text>
                  <text x="74" y="52" fill="#94a3b8" font-size="9.5" font-weight="600" letter-spacing="0.8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">POWER SAVING TECH</text>

                  <!-- Sleek Wave Graph in bottom of card -->
                  <path d="M20,105 Q60,85 100,100 T180,95 T200,105" fill="none" stroke="rgba(236,92,10,0.6)" stroke-width="2"/>
                  <circle cx="180" cy="95" r="3" fill="#ec5c0a"/>
                  <circle cx="180" cy="95" r="6" fill="none" stroke="rgba(236,92,10,0.4)" stroke-width="1"/>
                </g>

                <!-- Editorial Title Under Card -->
                <text x="300" y="268" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="700" letter-spacing="1" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">ELECTRICITY BILL REDUCTION GUIDE</text>
                <text x="300" y="290" text-anchor="middle" fill="#94a3b8" font-size="11" font-weight="500" letter-spacing="0.5" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">US-German Nanotechnology Insights</text>
              </svg>
            </div>
          {% endif %}
        </div>
        <div class="vsblog-feat-content">
          <h2>{{ section.settings.article_title | default: "How to Reduce Your Electricity Bill in India: 10 Smart Tips with Vidhyut Saathi ⚡" }}</h2>
          <p>{{ section.settings.article_excerpt | default: "Is your electricity bill increasing every month? Unnecessary power wastage can increase your monthly expenses. With Vidhyut Saathi Card, explore a modern approach to electricity saving through advanced US–German Nanotechnology and MCB-based installation to reduce bills by 20–30%." }}</p>
          <div class="vsblog-meta-row">
            <span class="vsblog-meta-chip"><i class="fa-solid fa-calendar-days"></i> {{ section.settings.article_date | default: "Sep 25, 2026" }}</span>
            <span class="vsblog-meta-chip"><i class="fa-solid fa-user"></i> {{ section.settings.article_author | default: "Vidhyut Saathi Team" }}</span>
          </div>
          <button type="button" class="vsblog-read-btn" onclick="typeof vsOpenArticleModal === 'function' ? vsOpenArticleModal(0) : null">Read Full Article <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Blog",
  "tag": "section",
  "class": "vsblog-featured-section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Article"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Custom Featured Image"
    },
    {
      "type": "text",
      "id": "article_title",
      "label": "Article Title",
      "default": "How to Reduce Your Electricity Bill in India: 10 Smart Tips with Vidhyut Saathi ⚡"
    },
    {
      "type": "textarea",
      "id": "article_excerpt",
      "label": "Article Excerpt",
      "default": "Is your electricity bill increasing every month? Unnecessary power wastage can increase your monthly expenses. With Vidhyut Saathi Card, explore a modern approach to electricity saving through advanced US–German Nanotechnology and MCB-based installation to reduce bills by 20–30%."
    },
    {
      "type": "text",
      "id": "article_category",
      "label": "Article Category",
      "default": "Energy Savings"
    },
    {
      "type": "text",
      "id": "read_time",
      "label": "Read Time",
      "default": "6 min read"
    },
    {
      "type": "text",
      "id": "article_date",
      "label": "Article Date",
      "default": "Sep 25, 2026"
    },
    {
      "type": "text",
      "id": "article_author",
      "label": "Article Author",
      "default": "Vidhyut Saathi Team"
    }
  ],
  "presets": [
    {
      "name": "Featured Blog"
    }
  ]
}
{% endschema %}
