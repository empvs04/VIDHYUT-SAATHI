<style>
  .vsblog-featured-section-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    box-sizing: border-box;
    width: 100%;
  }

  .vsblog-featured-section-wrap *, .vsblog-featured-section-wrap *::before, .vsblog-featured-section-wrap *::after {
    box-sizing: border-box;
  }

  .vsblog-featured-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media (min-width: 768px) {
    .vsblog-featured-container {
      padding: 0 20px;
    }
  }

  /* ─── FEATURED ARTICLE CARD ─── */
  .vsblog-featured { margin-bottom: 28px; width: 100%; }
  @media (min-width: 768px) { .vsblog-featured { margin-bottom: 36px; } }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ec5c0a;
    margin-bottom: 14px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.3), transparent);
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    position: relative;
    width: 100%;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-card { 
      grid-template-columns: 1.2fr 1fr; 
      border-radius: 22px; 
      min-height: 380px;
    }
  }

  .vsblog-feat-card:active { transform: scale(0.99); }

  .vsblog-feat-card:hover {
    box-shadow: 0 18px 42px rgba(236, 92, 10, 0.14), 0 4px 12px rgba(0, 0, 0, 0.04);
    border-color: #ec5c0a;
    transform: translateY(-3px);
  }

  .vsblog-feat-img {
    position: relative;
    height: 205px;
    min-height: 205px;
    overflow: hidden;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-img { height: 100%; min-height: 380px; }
  }

  .vsblog-feat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-feat-card:hover .vsblog-feat-img img {
    transform: scale(1.06);
  }

  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #ec5c0a 100%);
  }

  .vsblog-feat-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 5px 14px;
    border-radius: 50px;
    z-index: 2;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.35);
  }

  .vsblog-feat-readtime-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 50px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .vsblog-feat-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-content { padding: 30px; }
  }

  .vsblog-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #007b3e;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    background: rgba(0, 123, 62, 0.08);
    padding: 4px 12px;
    border-radius: 50px;
    width: fit-content;
    border: 1px solid rgba(0, 123, 62, 0.15);
  }

  .vsblog-feat-content h2 {
    font-size: clamp(16px, 2.5vw, 24px);
    font-weight: 700;
    color: #0f172a;
    line-height: 1.32;
    margin: 0 0 10px 0;
    transition: color 0.2s;
  }

  .vsblog-feat-card:hover .vsblog-feat-content h2 { color: #ec5c0a; }

  .vsblog-feat-content p {
    color: #64748b;
    line-height: 1.55;
    font-size: 13px;
    font-weight: 400;
    margin: 0 0 16px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-content p { font-size: 14px; line-height: 1.6; -webkit-line-clamp: 3; margin-bottom: 20px; }
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    color: #64748b;
    font-weight: 500;
  }

  .vsblog-meta-chip i { color: #ec5c0a; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 11px 24px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    width: 100%;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(236, 92, 10, 0.3);
  }

  @media (min-width: 640px) {
    .vsblog-read-btn { width: fit-content; padding: 11px 26px; font-size: 13px; }
  }

  .vsblog-read-btn:hover {
    transform: translateX(4px);
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.42);
  }
</style>

<div class="vsblog-featured-section-wrap">
  <div class="vsblog-featured-container">
    <!-- FEATURED ARTICLE (ARTICLE 0) -->
    <div class="vsblog-featured">
      <div class="vsblog-section-title"><i class="fa-solid fa-star"></i> {{ section.settings.section_title | default: "Featured Article" }}</div>
      <div class="vsblog-feat-card" onclick="typeof vsOpenArticleModal === 'function' ? vsOpenArticleModal(0) : null">
        <div class="vsblog-feat-img">
          {% if section.settings.featured_image != blank %}
            <img src="{{ section.settings.featured_image | image_url: width: 900 }}" alt="Featured Article Image" loading="lazy">
          {% else %}
            <div class="vsblog-feat-svg-placeholder">
              <svg viewBox="0 0 600 380" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <radialGradient id="vsFeatGlowS" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#ec5c0a" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#0f172a" stop-opacity="0"/>
                  </radialGradient>
                </defs>
                <rect width="600" height="380" fill="#0f172a"/>
                <circle cx="300" cy="190" r="160" fill="url(#vsFeatGlowS)"/>
                <path d="M0,190 Q150,110 300,190 T600,190" fill="none" stroke="rgba(236,92,10,0.4)" stroke-width="2"/>
                <path d="M0,230 Q150,150 300,230 T600,230" fill="none" stroke="rgba(0,123,62,0.5)" stroke-width="2"/>
                <g transform="translate(240,110)">
                  <rect width="120" height="80" rx="16" fill="rgba(255,255,255,0.06)" stroke="rgba(236,92,10,0.5)" stroke-width="2"/>
                  <circle cx="60" cy="40" r="24" fill="#ec5c0a" opacity="0.9"/>
                  <path d="M54,40 L60,26 L66,40 L60,36 Z" fill="#ffffff"/>
                  <polyline points="50,44 56,44 60,34 64,48 70,44" fill="none" stroke="#ffffff" stroke-width="2"/>
                </g>
                <text x="300" y="240" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="700" letter-spacing="0.5" font-family="Arial">HOW TO REDUCE ELECTRICITY BILL IN INDIA</text>
              </svg>
            </div>
          {% endif %}
          <span class="vsblog-feat-badge"><i class="fa-solid fa-star"></i> Featured</span>
          <span class="vsblog-feat-readtime-badge"><i class="fa-solid fa-clock"></i> {{ section.settings.read_time | default: "6 min read" }}</span>
        </div>
        <div class="vsblog-feat-content">
          <span class="vsblog-cat-tag"><i class="fa-solid fa-bolt"></i> {{ section.settings.article_category | default: "Energy Savings" }}</span>
          <h2>{{ section.settings.article_title | default: "How to Reduce Your Electricity Bill in India: 10 Smart Tips with Vidhyut Saathi ⚡" }}</h2>
          <p>{{ section.settings.article_excerpt | default: "Is your electricity bill increasing every month? Unnecessary power wastage can increase your monthly expenses. With Vidhyut Saathi Card, explore a modern approach to electricity saving through advanced US–German Nanotechnology and MCB-based installation to reduce bills by 20–30%." }}</p>
          <div class="vsblog-meta-row">
            <span class="vsblog-meta-chip"><i class="fa-solid fa-calendar-days"></i> {{ section.settings.article_date | default: "Sep 25, 2026" }}</span>
            <span class="vsblog-meta-chip"><i class="fa-solid fa-user"></i> {{ section.settings.article_author | default: "Vidhyut Saathi Team" }}</span>
          </div>
          <button type="button" class="vsblog-read-btn">Read Full Article <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Blog",
  "tag": "section",
  "class": "vsblog-featured-section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Article"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Custom Featured Image"
    },
    {
      "type": "text",
      "id": "article_title",
      "label": "Article Title",
      "default": "How to Reduce Your Electricity Bill in India: 10 Smart Tips with Vidhyut Saathi ⚡"
    },
    {
      "type": "textarea",
      "id": "article_excerpt",
      "label": "Article Excerpt",
      "default": "Is your electricity bill increasing every month? Unnecessary power wastage can increase your monthly expenses. With Vidhyut Saathi Card, explore a modern approach to electricity saving through advanced US–German Nanotechnology and MCB-based installation to reduce bills by 20–30%."
    },
    {
      "type": "text",
      "id": "article_category",
      "label": "Article Category",
      "default": "Energy Savings"
    },
    {
      "type": "text",
      "id": "read_time",
      "label": "Read Time",
      "default": "6 min read"
    },
    {
      "type": "text",
      "id": "article_date",
      "label": "Article Date",
      "default": "Sep 25, 2026"
    },
    {
      "type": "text",
      "id": "article_author",
      "label": "Article Author",
      "default": "Vidhyut Saathi Team"
    }
  ],
  "presets": [
    {
      "name": "Featured Blog"
    }
  ]
}
{% endschema %}
