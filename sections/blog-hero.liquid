<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ─── VIDHYUT SAATHI ULTRA-LUCRATIVE LIGHT THEME BLOG HERO SECTION ─── */
  .vsblog-hero-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    position: relative;
    overflow: hidden;
    line-height: 1.55;
    box-sizing: border-box;
  }

  .vsblog-hero-wrap *, .vsblog-hero-wrap *::before, .vsblog-hero-wrap *::after {
    box-sizing: border-box;
  }

  /* ══ SOOTHING LUXURY LIGHT ORANGE PEACH GRADIENT (EYE-FRIENDLY & LUCRATIVE) ══ */
  .vsblog-hero {
    position: relative;
    background: linear-gradient(135deg, #fffdfa 0%, #fff3e8 30%, #ffe5d0 70%, #fff8f0 100%);
    padding: clamp(44px, 5.5vw, 72px) 16px clamp(50px, 6.5vw, 88px) 16px;
    overflow: hidden;
    color: #0f172a;
    border-bottom: 1px solid rgba(236, 92, 10, 0.12);
  }

  /* Soft Theme Dot-grid Texture Overlay */
  .vsblog-hero-dotgrid {
    position: absolute;
    top: 20px;
    left: 30px;
    width: 340px;
    height: 220px;
    background-image: radial-gradient(rgba(236, 92, 10, 0.14) 1.5px, transparent 1.5px);
    background-size: 18px 18px;
    opacity: 0.8;
    pointer-events: none;
  }

  /* Soft Ambient Glowing Orbs */
  .vsblog-hero-glow-orb {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.12) 0%, rgba(254, 215, 170, 0.25) 45%, transparent 70%);
    top: -140px;
    right: 5%;
    pointer-events: none;
    filter: blur(50px);
  }

  .vsblog-hero-glow-orb-left {
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.08) 0%, rgba(255, 237, 213, 0.3) 50%, transparent 70%);
    bottom: -70px;
    left: -50px;
    pointer-events: none;
    filter: blur(40px);
  }

  .vsblog-hero-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 34px;
    position: relative;
    z-index: 5;
  }

  @media (min-width: 900px) {
    .vsblog-hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
    }
  }

  .vsblog-hero-left {
    text-align: left;
  }

  .vsblog-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ec5c0a;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 14px;
    background: #ffffff;
    padding: 6px 14px;
    border-radius: 50px;
    border: 1.5px solid rgba(236, 92, 10, 0.25);
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.08);
  }

  .vsblog-hero-eyebrow i {
    color: #ec5c0a;
  }

  .vsblog-hero h1 {
    font-size: clamp(32px, 5.2vw, 56px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.15;
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .vsblog-hero h1 span {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7800 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .vsblog-hero-desc {
    color: #475569;
    font-size: clamp(15px, 2vw, 17.5px);
    line-height: 1.6;
    font-weight: 500;
    margin: 0 0 24px 0;
    max-width: 580px;
  }

  .vsblog-hero-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vsblog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1.5px solid rgba(236, 92, 10, 0.22);
    color: #1e293b;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-hero-pill:hover {
    background: #fff7ed;
    transform: translateY(-2px);
    border-color: #ec5c0a;
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.15);
  }

  .vsblog-hero-pill i {
    color: #ec5c0a;
  }

  .vsblog-hero-pill.green i {
    color: #007b3e;
  }

  .vsblog-hero-pill.cyan i {
    color: #0284c7;
  }

  /* Right Illustration Graphic Container */
  .vsblog-hero-illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .vsblog-hero-svg-wrap {
    width: 100%;
    max-width: 460px;
    filter: drop-shadow(0 18px 32px rgba(236, 92, 10, 0.12)) drop-shadow(0 6px 12px rgba(0, 0, 0, 0.06));
    animation: vsHeroFloat 4s ease-in-out infinite alternate;
  }

  @keyframes vsHeroFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-10px); }
  }

  /* Dynamic Wave Ribbons at bottom (Theme warm transition) */
  .vsblog-hero-bottom-curves {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 4;
    pointer-events: none;
  }

  .vsblog-hero-bottom-curves svg {
    display: block;
    width: 100%;
    height: clamp(55px, 8vw, 95px);
  }
</style>

<div class="vsblog-hero-wrap">
  <!-- ══ ULTRA-LUCRATIVE LIGHT THEME HERO BANNER ══ -->
  <section class="vsblog-hero">
    <!-- Theme Light Texture and Ambient Glows -->
    <div class="vsblog-hero-dotgrid"></div>
    <div class="vsblog-hero-glow-orb"></div>
    <div class="vsblog-hero-glow-orb-left"></div>
    
    <div class="vsblog-hero-container">
      <!-- Left Column: Information & Brand Badges -->
      <div class="vsblog-hero-left">
        {% if section.settings.hero_badge != blank %}
          <div class="vsblog-hero-eyebrow">
            <i class="fa-solid fa-bolt"></i> {{ section.settings.hero_badge }}
          </div>
        {% endif %}

        <h1>{{ section.settings.hero_title | default: "Insights on Energy Savings" }}</h1>
        <p class="vsblog-hero-desc">{{ section.settings.hero_subtitle | default: "Expert articles, franchise success stories, and tips to lower electricity bills across India." }}</p>
        
        <div class="vsblog-hero-pills">
          {% if section.settings.pill_1_text != blank %}
            <span class="vsblog-hero-pill"><i class="fa-solid fa-bolt"></i> {{ section.settings.pill_1_text }}</span>
          {% endif %}
          {% if section.settings.pill_2_text != blank %}
            <span class="vsblog-hero-pill green"><i class="fa-solid fa-microchip"></i> {{ section.settings.pill_2_text }}</span>
          {% endif %}
          {% if section.settings.pill_3_text != blank %}
            <span class="vsblog-hero-pill cyan"><i class="fa-solid fa-shield-halved"></i> {{ section.settings.pill_3_text }}</span>
          {% endif %}
        </div>
      </div>

      <!-- Right Column: 3D Isometric Digital Newsroom Graphic -->
      <div class="vsblog-hero-illustration">
        <div class="vsblog-hero-svg-wrap">
          <svg viewBox="0 0 540 380" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="vsLapBaseHero" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fff7ed"/>
                <stop offset="50%" stop-color="#fdba74"/>
                <stop offset="100%" stop-color="#ea580c"/>
              </linearGradient>
              <linearGradient id="vsScreenGradHero" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#0f172a"/>
                <stop offset="100%" stop-color="#1e293b"/>
              </linearGradient>
              <linearGradient id="vsPaperGradHero" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="100%" stop-color="#f8fafc"/>
              </linearGradient>
              <linearGradient id="vsFolderGradHero" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fde047"/>
                <stop offset="100%" stop-color="#f59e0b"/>
              </linearGradient>
              <linearGradient id="vsPhoneGradHero" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#007b3e"/>
                <stop offset="100%" stop-color="#064e3b"/>
              </linearGradient>
              <filter id="vsSvgShadowHero" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#ec5c0a" flood-opacity="0.16"/>
              </filter>
            </defs>

            <!-- Back Floor Glow -->
            <ellipse cx="270" cy="300" rx="190" ry="60" fill="rgba(236,92,10,0.12)" filter="blur(20px)"/>

            <!-- Floating 3D Folder (Top Left) -->
            <g transform="translate(140, 75)" filter="url(#vsSvgShadowHero)">
              <polygon points="10,20 35,0 75,0 75,45 10,45" fill="url(#vsFolderGradHero)"/>
              <polygon points="0,15 25,15 35,25 75,25 65,65 0,65" fill="#f59e0b"/>
              <polygon points="0,15 65,15 75,25 10,25" fill="#fef08a"/>
              <circle cx="20" cy="45" r="5" fill="#ffffff" opacity="0.95"/>
            </g>

            <!-- Floating 3D User Avatar Badge (Top Center) -->
            <g transform="translate(260, 60)" filter="url(#vsSvgShadowHero)">
              <rect x="0" y="0" width="32" height="32" rx="8" fill="#007b3e" opacity="0.95"/>
              <circle cx="16" cy="12" r="5" fill="#ffffff"/>
              <path d="M8,26 Q16,18 24,26" fill="#ffffff"/>
            </g>

            <!-- Floating 3D Star Badge -->
            <g transform="translate(155, 175)" filter="url(#vsSvgShadowHero)">
              <rect x="0" y="0" width="34" height="34" rx="8" fill="#007b3e"/>
              <polygon points="17,7 20,13 27,14 22,19 23,26 17,23 11,26 12,19 7,14 14,13" fill="#ffffff"/>
            </g>

            <!-- Floating 3D Message Bubble (Top Right) -->
            <g transform="translate(420, 165)" filter="url(#vsSvgShadowHero)">
              <rect x="0" y="0" width="30" height="24" rx="6" fill="#0284c7"/>
              <circle cx="9" cy="12" r="2" fill="#ffffff"/>
              <circle cx="15" cy="12" r="2" fill="#ffffff"/>
              <circle cx="21" cy="12" r="2" fill="#ffffff"/>
            </g>

            <!-- Floating 3D Check/Data Tag (Mid Right) -->
            <g transform="translate(450, 235)" filter="url(#vsSvgShadowHero)">
              <rect x="0" y="0" width="28" height="28" rx="6" fill="#007b3e"/>
              <polyline points="7,14 12,19 21,9" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </g>

            <!-- ISOMETRIC LAPTOP BASE (Theme styled) -->
            <polygon points="270,180 430,240 270,330 110,240" fill="rgba(0,0,0,0.12)"/>
            <polygon points="270,190 410,240 270,315 130,240" fill="url(#vsLapBaseHero)"/>
            <polygon points="130,240 270,315 270,323 130,248" fill="#c2410c"/>
            <polygon points="270,315 410,240 410,248 270,323" fill="#ea580c"/>
            <polygon points="270,210 380,248 280,290 170,245" fill="#0f172a"/>
            <polygon points="270,292 295,302 270,312 245,302" fill="#ffffff" opacity="0.9"/>

            <!-- ISOMETRIC SCREEN (UPRIGHT) -->
            <g transform="translate(230, 95)" filter="url(#vsSvgShadowHero)">
              <polygon points="0,30 120,0 120,130 0,160" fill="#0f172a" stroke="#ffffff" stroke-width="2.5"/>
              <polygon points="6,34 114,6 114,124 6,152" fill="url(#vsScreenGradHero)"/>
              <polygon points="6,34 114,6 114,20 6,48" fill="#1e293b"/>
              <circle cx="16" cy="40" r="2" fill="#ef4444"/>
              <circle cx="22" cy="38" r="2" fill="#f59e0b"/>
              <circle cx="28" cy="36" r="2" fill="#10b981"/>
              <polygon points="14,58 90,38 90,44 14,64" fill="#38bdf8" opacity="0.9"/>
              <polygon points="14,72 105,48 105,53 14,77" fill="#94a3b8"/>
              <polygon points="14,84 95,64 95,69 14,89" fill="#94a3b8"/>
              <polygon points="14,96 80,79 80,84 14,101" fill="#94a3b8"/>
              <polygon points="14,115 105,92 105,108 14,131" fill="rgba(236,92,10,0.35)" stroke="#ec5c0a" stroke-width="1.5"/>
              <polygon points="16,118 70,105 70,116 16,128" fill="#ec5c0a"/>
            </g>

            <!-- 3D FLOWING DIGITAL ARTICLE PAPER SHEET -->
            <g filter="url(#vsSvgShadowHero)">
              <path d="M260,110 L340,90 L340,240 C340,260 260,250 240,270 L140,240 C160,210 260,230 260,110 Z" fill="url(#vsPaperGradHero)" stroke="#e2e8f0" stroke-width="1.5"/>
              <path d="M140,240 C180,220 220,280 280,260 L260,320 C200,340 160,280 120,300 Z" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5"/>
              <rect x="268" y="115" width="55" height="7" rx="3" fill="#007b3e" opacity="0.9"/>
              <rect x="268" y="128" width="60" height="4" rx="2" fill="#94a3b8"/>
              <rect x="268" y="136" width="58" height="4" rx="2" fill="#cbd5e1"/>
              <rect x="268" y="144" width="45" height="4" rx="2" fill="#cbd5e1"/>
              
              <rect x="268" y="154" width="62" height="14" rx="3" fill="#ec5c0a"/>
              <rect x="272" y="158" width="40" height="3" rx="1.5" fill="#ffffff"/>
              <rect x="272" y="163" width="52" height="2.5" rx="1.5" fill="#fed7aa"/>

              <rect x="268" y="174" width="58" height="4" rx="2" fill="#94a3b8"/>
              <rect x="268" y="182" width="60" height="4" rx="2" fill="#cbd5e1"/>
              <rect x="268" y="190" width="50" height="4" rx="2" fill="#cbd5e1"/>

              <path d="M150,265 Q190,250 230,285" fill="none" stroke="#007b3e" stroke-width="3" stroke-linecap="round"/>
              <path d="M145,278 Q185,263 225,298" fill="none" stroke="#ea580c" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M140,290 Q175,276 210,310" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round"/>
            </g>

            <!-- Small 3D Smartphone on Table (Bottom Right) -->
            <g transform="translate(370, 275)" filter="url(#vsSvgShadowHero)">
              <polygon points="40,0 80,20 40,45 0,25" fill="url(#vsPhoneGradHero)"/>
              <polygon points="0,25 40,45 40,50 0,30" fill="#064e3b"/>
              <polygon points="40,45 80,20 80,25 40,50" fill="#042f2e"/>
              <polygon points="38,5 72,21 40,39 8,23" fill="#0f172a"/>
              <circle cx="40" cy="22" r="4" fill="#22c55e"/>
              <line x1="28" y1="16" x2="35" y2="19" stroke="#ffffff" stroke-width="1.5"/>
            </g>

            <!-- Little 3D Data Cubes -->
            <g transform="translate(360, 325)">
              <polygon points="10,0 20,5 10,10 0,5" fill="#f97316"/>
              <polygon points="0,5 10,10 10,18 0,13" fill="#ea580c"/>
              <polygon points="10,10 20,5 20,13 10,18" fill="#c2410c"/>
            </g>
            <g transform="translate(385, 335)">
              <polygon points="8,0 16,4 8,8 0,4" fill="#007b3e"/>
              <polygon points="0,4 8,8 8,14 0,10" fill="#064e3b"/>
              <polygon points="8,8 16,4 16,10 8,14" fill="#042f2e"/>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- DYNAMIC OVERLAPPING WAVE RIBBONS AT BOTTOM -->
    <div class="vsblog-hero-bottom-curves">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Neon Glow Ribbon 1 (Orange Accent) -->
        <path d="M0,70 C360,130 720,20 1080,80 C1260,110 1380,60 1440,50" stroke="#ec5c0a" stroke-width="3" fill="none" opacity="0.6"/>
        <!-- Neon Glow Ribbon 2 (Green Accent) -->
        <path d="M0,95 C320,30 680,140 1100,60 C1280,20 1390,90 1440,95" stroke="#007b3e" stroke-width="2.5" fill="none" opacity="0.5"/>
        <!-- White/Cream Solid Wave Base (Seamless fill transition to #fff8ef) -->
        <path d="M0,60 Q360,130 720,60 T1440,80 L1440,120 L0,120 Z" fill="#fff8ef"/>
      </svg>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Blog Hero",
  "tag": "section",
  "class": "vsblog-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Eyebrow Badge (Optional)"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Insights on Energy Savings"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Expert articles, franchise success stories, and tips to lower electricity bills across India."
    },
    {
      "type": "text",
      "id": "pill_1_text",
      "label": "Pill 1 Text",
      "default": "20–30% Bill Savings"
    },
    {
      "type": "text",
      "id": "pill_2_text",
      "label": "Pill 2 Text",
      "default": "Terahertz Wave Tech"
    },
    {
      "type": "text",
      "id": "pill_3_text",
      "label": "Pill 3 Text",
      "default": "ISO 9001:2015 Certified"
    }
  ],
  "presets": [
    {
      "name": "Blog Hero"
    }
  ]
}
{% endschema %}
