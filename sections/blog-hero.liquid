<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ─── VIDHYUT SAATHI BLOG HERO SECTION ─── */
  .vsblog-hero-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    position: relative;
    overflow: hidden;
    line-height: 1.55;
    box-sizing: border-box;
  }

  .vsblog-hero-wrap *, .vsblog-hero-wrap *::before, .vsblog-hero-wrap *::after {
    box-sizing: border-box;
  }

  .vsblog-hero {
    position: relative;
    background: linear-gradient(115deg, #420a75 0%, #221152 35%, #0f1c34 70%, #073844 100%);
    padding: clamp(42px, 5.5vw, 70px) 16px clamp(50px, 6.5vw, 88px) 16px;
    overflow: hidden;
    color: #ffffff;
  }

  .vsblog-hero-glow-orb {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.28) 0%, rgba(236, 72, 153, 0.16) 40%, transparent 70%);
    top: -140px;
    right: 10%;
    pointer-events: none;
    filter: blur(45px);
  }

  .vsblog-hero-glow-orb-left {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.2) 0%, transparent 70%);
    bottom: -60px;
    left: -40px;
    pointer-events: none;
    filter: blur(40px);
  }

  .vsblog-hero-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 34px;
    position: relative;
    z-index: 5;
  }

  @media (min-width: 960px) {
    .vsblog-hero-container {
      grid-template-columns: 1.12fr 0.88fr;
      gap: 44px;
    }
  }

  .vsblog-hero-left {
    text-align: left;
  }

  .vsblog-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(236, 92, 10, 0.18);
    border: 1.5px solid rgba(236, 92, 10, 0.45);
    color: #ff9d5c;
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 16px;
    backdrop-filter: blur(6px);
  }

  .vsblog-hero-eyebrow i {
    color: #ec5c0a;
  }

  .vsblog-hero h1 {
    font-size: clamp(32px, 4.8vw, 54px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .vsblog-hero h1 span {
    background: linear-gradient(135deg, #ff7b00 0%, #ec5c0a 50%, #facc15 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsblog-hero-desc {
    color: #e2e8f0;
    font-size: clamp(15px, 1.9vw, 17.5px);
    line-height: 1.6;
    font-weight: 400;
    margin: 0 0 24px 0;
    max-width: 590px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
  }

  .vsblog-hero-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vsblog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 7px 15px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }

  .vsblog-hero-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
    border-color: #ec5c0a;
  }

  .vsblog-hero-pill i {
    color: #fb923c;
  }

  .vsblog-hero-pill.green i {
    color: #34d399;
  }

  .vsblog-hero-pill.cyan i {
    color: #38bdf8;
  }

  /* Right 3D Tech Card Showcase Graphic */
  .vsblog-hero-illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .vsblog-hero-svg-wrap {
    width: 100%;
    max-width: 480px;
    filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.5));
    animation: vsHeroFloat 4s ease-in-out infinite alternate;
  }

  @keyframes vsHeroFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-10px); }
  }

  /* Dynamic Wave Ribbons at bottom */
  .vsblog-hero-bottom-curves {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 4;
    pointer-events: none;
  }

  .vsblog-hero-bottom-curves svg {
    display: block;
    width: 100%;
    height: clamp(55px, 8vw, 95px);
  }
</style>

<div class="vsblog-hero-wrap">
  <!-- ══ HERO BANNER ══ -->
  <section class="vsblog-hero">
    <div class="vsblog-hero-glow-orb"></div>
    <div class="vsblog-hero-glow-orb-left"></div>
    
    <div class="vsblog-hero-container">
      <!-- Left Column: Information & Brand Badges -->
      <div class="vsblog-hero-left">
        <div class="vsblog-hero-eyebrow">
          <i class="fa-solid fa-bolt"></i> {{ section.settings.hero_badge | default: "VIDHYUT SAATHI KNOWLEDGE HUB" }}
        </div>
        
        <h1>{{ section.settings.hero_title | default: "Insights on <span>Energy Savings</span> & Updates" }}</h1>
        <p class="vsblog-hero-desc">{{ section.settings.hero_subtitle | default: "Explore expert electricity saving guides, US-German Nanotechnology breakthroughs, and lucrative district franchise opportunities across India." }}</p>
        
        <div class="vsblog-hero-pills">
          <span class="vsblog-hero-pill"><i class="fa-solid fa-bolt"></i> {{ section.settings.pill_1_text | default: "20–30% Bill Savings" }}</span>
          <span class="vsblog-hero-pill green"><i class="fa-solid fa-microchip"></i> {{ section.settings.pill_2_text | default: "US–German Nanotech & THz" }}</span>
          <span class="vsblog-hero-pill cyan"><i class="fa-solid fa-shield-halved"></i> {{ section.settings.pill_3_text | default: "10-Yr Warranty | ISO Certified" }}</span>
        </div>
      </div>

      <!-- Right Column: 3D Isometric Vidhyut Saathi Smart Tech Hub Graphic -->
      <div class="vsblog-hero-illustration">
        <div class="vsblog-hero-svg-wrap">
          <svg viewBox="0 0 540 380" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Card Gradient -->
              <linearGradient id="vsCardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#420a75"/>
                <stop offset="45%" stop-color="#221152"/>
                <stop offset="100%" stop-color="#0f172a"/>
              </linearGradient>
              <!-- Gold Foil Border -->
              <linearGradient id="vsGoldBorder" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fbbf24"/>
                <stop offset="50%" stop-color="#f59e0b"/>
                <stop offset="100%" stop-color="#d97706"/>
              </linearGradient>
              <!-- Orange Electric Accent -->
              <linearGradient id="vsOrangeGlow" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#ff7b00"/>
                <stop offset="100%" stop-color="#ec5c0a"/>
              </linearGradient>
              <!-- Green Efficiency Gradient -->
              <linearGradient id="vsGreenGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#10b981"/>
                <stop offset="100%" stop-color="#007b3e"/>
              </linearGradient>
              <!-- Isometric Screen Backdrop -->
              <linearGradient id="vsHudGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#070d19"/>
                <stop offset="100%" stop-color="#111e33"/>
              </linearGradient>
              <filter id="vsSvgCardShadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#000000" flood-opacity="0.45"/>
              </filter>
            </defs>

            <!-- Bottom Floor Energy Aura -->
            <ellipse cx="270" cy="300" rx="200" ry="65" fill="rgba(236,92,10,0.18)" filter="blur(22px)"/>
            <ellipse cx="270" cy="300" rx="140" ry="45" fill="rgba(0,123,62,0.16)" filter="blur(16px)"/>

            <!-- Floating Badge Top Left: US-German Nanotech -->
            <g transform="translate(130, 65)" filter="url(#vsSvgCardShadow)">
              <rect x="0" y="0" width="130" height="34" rx="17" fill="#0f172a" stroke="#ec5c0a" stroke-width="1.5"/>
              <circle cx="17" cy="17" r="9" fill="#ec5c0a"/>
              <path d="M14,17 L17,13 L20,17 L17,16 Z" fill="#ffffff"/>
              <text x="34" y="21" fill="#ffffff" font-size="10" font-weight="700" font-family="sans-serif">US-GERMAN TECH</text>
            </g>

            <!-- Floating Badge Top Right: ISO & CE Certified -->
            <g transform="translate(390, 75)" filter="url(#vsSvgCardShadow)">
              <rect x="0" y="0" width="115" height="34" rx="17" fill="#0f172a" stroke="#10b981" stroke-width="1.5"/>
              <circle cx="17" cy="17" r="9" fill="#10b981"/>
              <polyline points="13,17 16,20 22,14" fill="none" stroke="#ffffff" stroke-width="2"/>
              <text x="34" y="21" fill="#ffffff" font-size="10" font-weight="700" font-family="sans-serif">ISO CERTIFIED</text>
            </g>

            <!-- Floating Badge Mid Right: 20-30% Savings Tag -->
            <g transform="translate(420, 175)" filter="url(#vsSvgCardShadow)">
              <rect x="0" y="0" width="105" height="36" rx="10" fill="url(#vsOrangeGlow)"/>
              <text x="52" y="18" fill="#ffffff" font-size="12" font-weight="900" text-anchor="middle" font-family="sans-serif">20–30%</text>
              <text x="52" y="29" fill="#ffffff" font-size="8.5" font-weight="700" text-anchor="middle" font-family="sans-serif">BILL SAVED</text>
            </g>

            <!-- Floating Badge Mid Left: cos φ = 0.99 Active -->
            <g transform="translate(100, 185)" filter="url(#vsSvgCardShadow)">
              <rect x="0" y="0" width="95" height="34" rx="10" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5"/>
              <text x="47" y="16" fill="#38bdf8" font-size="10" font-weight="800" text-anchor="middle" font-family="sans-serif">cos φ = 0.99</text>
              <text x="47" y="27" fill="#94a3b8" font-size="8" font-weight="600" text-anchor="middle" font-family="sans-serif">Power Factor</text>
            </g>

            <!-- ISOMETRIC 3D TECH BASE (MCB & DISTRIBUTION HUB) -->
            <!-- Base Shadow -->
            <polygon points="270,185 430,245 270,335 110,245" fill="rgba(0,0,0,0.35)"/>
            <!-- Base Platform Surface -->
            <polygon points="270,195 415,245 270,320 125,245" fill="#1e293b" stroke="#334155" stroke-width="2"/>
            <!-- Base Platform Front Edges -->
            <polygon points="125,245 270,320 270,330 125,255" fill="#0f172a"/>
            <polygon points="270,320 415,245 415,255 270,330" fill="#182234"/>

            <!-- Glowing Cyber Circuit Traces on Platform -->
            <path d="M160,252 L270,305 L380,252" fill="none" stroke="#00e5ff" stroke-width="2" opacity="0.85"/>
            <path d="M210,240 L270,268 L330,240" fill="none" stroke="#ec5c0a" stroke-width="2" opacity="0.8"/>
            <circle cx="270" cy="305" r="4" fill="#00e5ff"/>
            <circle cx="270" cy="268" r="3.5" fill="#ec5c0a"/>

            <!-- ISOMETRIC 3D HUD DISPLAY PANEL (UPRIGHT BACK) -->
            <g transform="translate(230, 95)" filter="url(#vsSvgCardShadow)">
              <polygon points="0,30 125,0 125,135 0,165" fill="#070d19" stroke="#38bdf8" stroke-width="2.5"/>
              <polygon points="6,34 119,6 119,129 6,157" fill="url(#vsHudGrad)"/>
              
              <!-- Header Bar in HUD -->
              <polygon points="6,34 119,6 119,22 6,50" fill="#1e293b"/>
              <circle cx="16" cy="41" r="2.5" fill="#ef4444"/>
              <circle cx="23" cy="39" r="2.5" fill="#f59e0b"/>
              <circle cx="30" cy="37" r="2.5" fill="#10b981"/>

              <!-- Live Energy Waveform on HUD -->
              <path d="M14,68 Q30,50 48,64 T80,56 T110,48" fill="none" stroke="#00e5ff" stroke-width="2.5"/>
              <path d="M14,84 Q35,70 55,80 T90,72 T110,65" fill="none" stroke="#ec5c0a" stroke-width="2"/>

              <!-- Live Stat Box in Screen -->
              <polygon points="14,102 110,78 110,125 14,149" fill="rgba(236,92,10,0.15)" stroke="#ec5c0a" stroke-width="1.2"/>
              <polygon points="18,106 65,95 65,115 18,126" fill="#ec5c0a"/>
            </g>

            <!-- ISOMETRIC 3D VIDHYUT SAATHI SMART CARD (HERO ELEMENT) -->
            <g transform="translate(190, 155)" filter="url(#vsSvgCardShadow)">
              <!-- Card Outer Shell -->
              <polygon points="80,0 200,45 120,135 0,90" fill="url(#vsCardGrad)" stroke="url(#vsGoldBorder)" stroke-width="3"/>
              <!-- Card Edge 3D Thickness -->
              <polygon points="0,90 120,135 120,143 0,98" fill="#2e0754"/>
              <polygon points="120,135 200,45 200,53 120,143" fill="#16042b"/>

              <!-- Card Inner Gold Foil Border Accent -->
              <polygon points="78,12 184,52 118,124 12,84" fill="none" stroke="url(#vsGoldBorder)" stroke-width="1.2" opacity="0.8"/>

              <!-- Terahertz Microchip in Center of Card -->
              <polygon points="98,42 138,57 114,84 74,69" fill="#0f172a" stroke="#fbbf24" stroke-width="2"/>
              <circle cx="106" cy="63" r="7" fill="url(#vsOrangeGlow)"/>
              <circle cx="106" cy="63" r="3" fill="#ffffff"/>

              <!-- Lightning Bolt on Microchip -->
              <path d="M104,59 L108,59 L105,63 L108,63 L103,68 L105,64 L102,64 Z" fill="#ffffff"/>

              <!-- Card Text: VIDHYUT SAATHI -->
              <g transform="rotate(18, 50, 70)">
                <text x="38" y="44" fill="#fbbf24" font-size="9" font-weight="900" letter-spacing="1" font-family="sans-serif">VIDHYUT SAATHI</text>
                <text x="38" y="54" fill="#ffffff" font-size="6.5" font-weight="700" letter-spacing="0.5" font-family="sans-serif">ELECTRICITY SAVER CARD</text>
              </g>

              <!-- Negative Ion Nano Aura Rings -->
              <ellipse cx="106" cy="63" rx="22" ry="12" fill="none" stroke="rgba(0,229,255,0.6)" stroke-width="1.2" transform="rotate(-20, 106, 63)"/>
            </g>

            <!-- Small 3D Smartphone on Desk (Bottom Right) -->
            <g transform="translate(375, 270)" filter="url(#vsSvgCardShadow)">
              <polygon points="40,0 80,20 40,45 0,25" fill="url(#vsHudGrad)" stroke="#06b6d4" stroke-width="1.5"/>
              <polygon points="0,25 40,45 40,50 0,30" fill="#0891b2"/>
              <polygon points="40,45 80,20 80,25 40,50" fill="#0e7490"/>
              <polygon points="38,5 72,21 40,39 8,23" fill="#070d19"/>
              <circle cx="40" cy="22" r="4" fill="#22c55e"/>
              <line x1="28" y1="16" x2="35" y2="19" stroke="#ffffff" stroke-width="1.5"/>
            </g>

            <!-- 3D Energy Cubes -->
            <g transform="translate(360, 325)">
              <polygon points="10,0 20,5 10,10 0,5" fill="#00e5ff"/>
              <polygon points="0,5 10,10 10,18 0,13" fill="#0891b2"/>
              <polygon points="10,10 20,5 20,13 10,18" fill="#0e7490"/>
            </g>
            <g transform="translate(385, 335)">
              <polygon points="8,0 16,4 8,8 0,4" fill="#ec5c0a"/>
              <polygon points="0,4 8,8 8,14 0,10" fill="#ea580c"/>
              <polygon points="8,8 16,4 16,10 8,14" fill="#c2410c"/>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <!-- DYNAMIC OVERLAPPING WAVE RIBBONS AT BOTTOM -->
    <div class="vsblog-hero-bottom-curves">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Neon Glow Ribbon 1 (Cyan) -->
        <path d="M0,70 C360,130 720,20 1080,80 C1260,110 1380,60 1440,50" stroke="#00e5ff" stroke-width="4.5" fill="none" opacity="0.85"/>
        <!-- Neon Glow Ribbon 2 (Magenta / Orange) -->
        <path d="M0,95 C320,30 680,140 1100,60 C1280,20 1390,90 1440,95" stroke="#ec4899" stroke-width="3.5" fill="none" opacity="0.8"/>
        <!-- White/Cream Solid Wave Body Base (Seamless fill transition) -->
        <path d="M0,60 Q360,130 720,60 T1440,80 L1440,120 L0,120 Z" fill="#fff8ef"/>
      </svg>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Blog Hero",
  "tag": "section",
  "class": "vsblog-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero Eyebrow Badge",
      "default": "VIDHYUT SAATHI KNOWLEDGE HUB"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title (use <span> for highlight)",
      "default": "Insights on <span>Energy Savings</span> & Updates"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Explore expert electricity saving guides, US-German Nanotechnology breakthroughs, and lucrative district franchise opportunities across India."
    },
    {
      "type": "text",
      "id": "pill_1_text",
      "label": "Pill 1 Text",
      "default": "20–30% Bill Savings"
    },
    {
      "type": "text",
      "id": "pill_2_text",
      "label": "Pill 2 Text",
      "default": "US–German Nanotech & THz"
    },
    {
      "type": "text",
      "id": "pill_3_text",
      "label": "Pill 3 Text",
      "default": "10-Yr Warranty | ISO Certified"
    }
  ],
  "presets": [
    {
      "name": "Blog Hero"
    }
  ]
}
{% endschema %}
