  /* Shimmer accent underline below heading */
  .why-heading-accent {
    width: 72px;
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, #F7941D, #3EAD47, #F7941D);
    background-size: 200% auto;
    animation: why-shimmer 2.5s linear infinite;
    margin-bottom: 20px;
  }
  @keyframes why-shimmer {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }

  /* Why Section Feature Cards */
  .why-feature-box {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .why-feat-item {
    background: #FFFFFF;
