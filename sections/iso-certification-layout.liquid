{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --iso-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --iso-secondary: #007b3e;
    --iso-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --iso-text-dark: #1a1a1a;
    --iso-text-light: #4a4a4a;
    --iso-radius: 16px;
    --iso-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    --iso-shadow-hover: 0 20px 40px rgba(0, 0, 0, 0.12);
  }
  
  .iso-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--iso-text-dark);
    background-color: var(--iso-bg);
    overflow: hidden;
  }

  /* --- Typography --- */
  .iso-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--iso-text-dark);
  }
  .iso-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--iso-text-light);
  }
  
  /* --- Premium Hero Section --- */
  .iso-hero {
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
    background-color: #090e1a;
    min-height: 480px;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
  }
  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 10px 26px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  
  /* --- Left to Right Moving Marquee Text --- */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .moving-text {
    position: absolute;
    top: 65px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.45;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(38px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 16s linear infinite;
  }

  /* --- Premium Certificate Showcase & Details --- */
  .iso-showcase {
    padding: clamp(60px, 7vw, 100px) 24px;
    background: linear-gradient(150deg, #FFFDF8 0%, #FFF5E0 30%, #FAFFF5 65%, #FFFFFF 100%);
    position: relative;
    overflow: hidden;
  }
  /* Section-level decorative orbs */
  .iso-showcase::before {
    content: '';
    position: absolute;
    top: -120px;
    right: -120px;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(247, 148, 29, 0.12) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }
  .iso-showcase::after {
    content: '';
    position: absolute;
    bottom: -100px;
    left: -100px;
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, rgba(62, 173, 71, 0.1) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }
  .iso-grid {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: stretch !important;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 912px) {
    .iso-grid { grid-template-columns: 1fr 1.25fr; gap: 44px; align-items: stretch !important; }
  }

  /* LUXURY 3D CERTIFICATE FRAME SHOWCASE */
  .iso-cert-box {
    perspective: 1200px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: linear-gradient(150deg, #FFFFFF 0%, #FFFDF5 50%, #F9FFF5 100%);
    border: 1.5px solid rgba(247, 148, 29, 0.28);
    border-top: 5px solid #F7941D;
    border-radius: 32px;
    padding: 36px 30px;
    box-shadow:
      0 30px 70px rgba(247, 148, 29, 0.15),
      0 8px 28px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transition: all 0.4s ease;
    height: 100%;
    box-sizing: border-box;
  }

  .iso-cert-box:hover {
    border-color: rgba(247, 148, 29, 0.5);
    box-shadow:
      0 40px 80px rgba(247, 148, 29, 0.22),
      0 12px 36px rgba(0, 0, 0, 0.06);
  }

  /* Ambient Soft Glows */
  .iso-cert-glow-orange {
    position: absolute;
    top: -30px;
    left: -30px;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(247, 148, 29, 0.18) 0%, rgba(255,255,255,0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .iso-cert-glow-green {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(62, 173, 71, 0.18) 0%, rgba(255,255,255,0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .iso-cert-img-wrapper {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: #FFFFFF;
    border: 3px solid #FFFFFF;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12), 0 0 25px rgba(247, 148, 29, 0.2);
    transform: perspective(1000px) rotateY(-2deg) rotateX(1deg);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    z-index: 3;
  }

  .iso-cert-img-wrapper:hover {
    transform: perspective(1000px) translateY(-6px) rotateY(0deg) rotateX(0deg) scale(1.015);
    box-shadow: 0 28px 60px rgba(247, 148, 29, 0.3);
  }

  .iso-cert-img-wrapper canvas,
  .iso-cert-img-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
  }

  /* Floating Authentic Seal Badges */
  .iso-cert-floating-badge {
    position: absolute;
    z-index: 5;
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.35);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 800;
    color: #E07810;
    box-shadow: 0 8px 22px rgba(247, 148, 29, 0.2);
    display: flex;
    align-items: center;
    gap: 6px;
    backdrop-filter: blur(8px);
    transition: transform 0.3s ease;
  }

  .iso-cert-floating-badge.top-right {
    top: -12px;
    right: 18px;
  }

  .iso-cert-floating-badge.bottom-left {
    bottom: -12px;
    left: 18px;
    background: #E8F5E9;
    border-color: rgba(62, 173, 71, 0.4);
    color: #2E7D32;
    box-shadow: 0 8px 22px rgba(62, 173, 71, 0.2);
  }
  .iso-cert-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    padding: 16px 36px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .iso-cert-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.5);
    background: linear-gradient(135deg, #f1721b, #007b3e);
  }

  /* Details Box — Ultra Lucrative Light Theme */
  .iso-details-box {
    background: linear-gradient(150deg, #FFFFFF 0%, #FFFDF8 50%, #F9FFF5 100%);
    border: 1.5px solid rgba(247, 148, 29, 0.25);
    border-top: 5px solid #F7941D;
    border-radius: 32px;
    padding: 46px 38px;
    box-shadow:
      0 30px 70px rgba(247, 148, 29, 0.14),
      0 8px 28px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  /* Decorative corner orbs inside details box */
  .iso-details-box::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(247, 148, 29, 0.1) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
  }
  .iso-details-box::after {
    content: '';
    position: absolute;
    bottom: -50px;
    left: -50px;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(62, 173, 71, 0.09) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
  }
  .iso-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    background: linear-gradient(135deg, #FFF3E0 0%, #E8F5E9 100%);
    border: 1.5px solid rgba(247, 148, 29, 0.35);
    border-radius: 50px;
    font-size: 0.88rem;
    font-weight: 800;
    color: #E07810;
    letter-spacing: 0.5px;
    margin-bottom: 22px;
    width: fit-content;
    box-shadow: 0 6px 18px rgba(247, 148, 29, 0.15);
  }
  .iso-badge .pulse-dot {
    width: 9px;
    height: 9px;
    background-color: #3EAD47;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(62, 173, 71, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(62, 173, 71, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(62, 173, 71, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(62, 173, 71, 0); }
  }

  .iso-details-box h2 {
    font-family: 'Baloo 2', sans-serif;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 10px;
    color: #0F172A;
    letter-spacing: -0.5px;
    position: relative;
    z-index: 1;
  }
  /* Shimmer underline below heading */
  .iso-details-heading-accent {
    width: 72px;
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, #F7941D, #3EAD47, #F7941D);
    background-size: 200% auto;
    animation: details-shimmer 2.5s linear infinite;
    margin-bottom: 18px;
  }
  @keyframes details-shimmer {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }
  .iso-main-text,
  .iso-main-text p {
    font-size: 1rem;
    line-height: 1.75;
    color: #475569;
    font-weight: 600;
    margin-bottom: 28px;
    text-align: justify !important;
    text-justify: inter-word !important;
    position: relative;
    z-index: 1;
  }
  
  .iso-data-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 600px) {
    .iso-data-grid { grid-template-columns: 1fr 1fr; }
  }

  .iso-data-item {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.25);
    border-radius: 20px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 25px rgba(247, 148, 29, 0.08), 0 2px 8px rgba(0,0,0,0.02);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
  }

  .iso-data-item.span-full {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #FFF9F2 0%, #FFFFFF 100%);
    border-color: rgba(62, 173, 71, 0.35);
  }

  .iso-data-item:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 36px rgba(247, 148, 29, 0.2);
    border-color: #F7941D;
  }

  .iso-data-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    box-shadow: 0 6px 16px rgba(0,0,0,0.06);
  }

  .iso-data-icon.orange { background: linear-gradient(135deg, #FFF3E0, #FFD59E); color: #C96218; box-shadow: 0 6px 16px rgba(247,148,29,0.22); }
  .iso-data-icon.green { background: linear-gradient(135deg, #E8F5E9, #A5D6A7); color: #1B6B22; box-shadow: 0 6px 16px rgba(62,173,71,0.22); }
  .iso-data-icon.blue { background: linear-gradient(135deg, #E0F2FE, #7DD3FC); color: #0369A1; box-shadow: 0 6px 16px rgba(2,132,199,0.22); }
  .iso-data-icon.gold { background: linear-gradient(135deg, #FFF8D6, #FDE68A); color: #B45309; box-shadow: 0 6px 16px rgba(217,119,6,0.22); }

  .iso-data-text-wrap {
    display: flex;
    flex-direction: column;
  }

  .iso-data-label {
    font-size: 0.76rem;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.6px;
    color: #94A3B8;
    margin-bottom: 2px;
  }

  .iso-data-value {
    font-family: 'Baloo 2', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.2;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .iso-active-tag {
    background: #E8F5E9;
    border: 1px solid rgba(62, 173, 71, 0.3);
    color: #2E7D32;
    font-size: 11px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Mobile Responsive Optimizations */
  @media screen and (max-width: 768px) {
    .iso-hero {
      min-height: 240px !important;
      padding: 12px 10px !important;
    }
    .moving-text {
      top: 38px !important;
      font-size: 30px !important;
      opacity: 0.70 !important;
    }
    .iso-showcase {
      padding: 26px 12px !important;
    }
    .iso-grid {
      grid-template-columns: 1fr !important;
      gap: 20px !important;
    }
    .iso-cert-box {
      padding: 20px 14px !important;
      border-radius: 22px !important;
    }
    .iso-cert-floating-badge {
      font-size: 0.7rem !important;
      padding: 6px 12px !important;
    }
    .iso-cert-floating-badge.top-right {
      top: -10px !important;
      right: 10px !important;
    }
    .iso-cert-floating-badge.bottom-left {
      bottom: -10px !important;
      left: 10px !important;
    }
    .iso-details-box {
      padding: 24px 16px !important;
      border-radius: 22px !important;
    }
    .iso-badge {
      margin-bottom: 16px !important;
      font-size: 0.82rem !important;
      padding: 6px 16px !important;
    }
    .iso-details-box h2 {
      font-size: 1.45rem !important;
      line-height: 1.3 !important;
      margin-bottom: 14px !important;
    }
    .iso-main-text,
    .iso-main-text p {
      font-size: 0.92rem !important;
      line-height: 1.65 !important;
      margin-bottom: 22px !important;
      text-align: justify !important;
    }
    .iso-data-grid {
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 12px !important;
    }
    .iso-data-item {
      background: linear-gradient(135deg, #FFFFFF 0%, #FFFDF8 100%) !important;
      border: 1.5px solid rgba(247, 148, 29, 0.25) !important;
      border-radius: 18px !important;
      padding: 16px 18px !important;
      gap: 14px !important;
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      box-shadow: 0 10px 25px rgba(247, 148, 29, 0.1), 0 2px 8px rgba(0,0,0,0.02) !important;
    }
    .iso-data-item.span-full {
      grid-column: 1 / -1 !important;
      background: linear-gradient(135deg, #FFF9F2 0%, #FFFFFF 100%) !important;
      border-color: rgba(62, 173, 71, 0.4) !important;
    }
    .iso-data-icon {
      width: 42px !important;
      height: 42px !important;
      font-size: 17px !important;
      border-radius: 14px !important;
      flex-shrink: 0 !important;
    }
    .iso-data-icon.orange {
      background: linear-gradient(135deg, #FFF3E0, #FFE0B2) !important;
      color: #D96924 !important;
      box-shadow: 0 4px 12px rgba(247, 148, 29, 0.25) !important;
    }
    .iso-data-icon.green {
      background: linear-gradient(135deg, #E8F5E9, #C8E6C9) !important;
      color: #2E7D32 !important;
      box-shadow: 0 4px 12px rgba(62, 173, 71, 0.25) !important;
    }
    .iso-data-icon.blue {
      background: linear-gradient(135deg, #E0F2FE, #BAE6FD) !important;
      color: #0284C7 !important;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25) !important;
    }
    .iso-data-icon.gold {
      background: linear-gradient(135deg, #FFF8D6, #FEF08A) !important;
      color: #D97706 !important;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25) !important;
    }
    .iso-data-label {
      font-size: 0.74rem !important;
      font-weight: 800 !important;
      margin-bottom: 3px !important;
      letter-spacing: 0.5px !important;
      color: #94A3B8 !important;
    }
    .iso-data-value {
      font-family: 'Baloo 2', sans-serif !important;
      font-size: 1.08rem !important;
      font-weight: 800 !important;
      line-height: 1.25 !important;
      color: #0F172A !important;
    }
    .iso-active-tag {
      background: linear-gradient(135deg, #E8F5E9, #C8E6C9) !important;
      color: #1B5E20 !important;
      border: 1px solid rgba(62, 173, 71, 0.4) !important;
      font-size: 10.5px !important;
      font-weight: 800 !important;
      padding: 3px 9px !important;
      border-radius: 50px !important;
      box-shadow: 0 2px 8px rgba(62, 173, 71, 0.2) !important;
    }
    .cert-frame-stage {
      padding: 14px !important;
      border-radius: 20px !important;
    }
    .cert-stamp-badge {
      width: 72px !important;
      height: 72px !important;
      top: 14px !important;
      right: 14px !important;
      font-size: 0.58rem !important;
    }
    .cert-stamp-badge span.big {
      font-size: 0.8rem !important;
    }
    .official-cert-card-mockup {
      padding: 18px 12px !important;
      border-width: 5px !important;
    }
    .cert-mock-company {
      font-size: 0.98rem !important;
      line-height: 1.3 !important;
    }
    .cert-mock-table {
      grid-template-columns: 1fr !important;
      gap: 4px !important;
      font-size: 0.74rem !important;
    }
    .cert-verification-bar {
      flex-direction: column !important;
      text-align: center !important;
      align-items: center !important;
      padding: 20px 16px !important;
      gap: 16px !important;
      border-radius: 20px !important;
    }
    .cert-verify-info {
      flex-direction: column !important;
      text-align: center !important;
      gap: 10px !important;
    }
    .cert-verify-btn {
      width: 100% !important;
      max-width: 320px !important;
      justify-content: center !important;
      text-align: center !important;
    }
  }
  /* --- Commitment to Quality — Premium Section --- */
  .iso-commitment {
    background: linear-gradient(160deg, #FFFDF8 0%, #FFF5E0 35%, #F2FAF3 100%);
    padding: 90px 24px 80px 24px;
    position: relative;
    overflow: hidden;
    border-top: 1.5px solid rgba(247, 148, 29, 0.12);
  }
  /* Decorative background orbs */
  .iso-commitment::before {
    content: '';
    position: absolute;
    top: -100px;
    left: -80px;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(247, 148, 29, 0.1) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
  }
  .iso-commitment::after {
    content: '';
    position: absolute;
    bottom: -80px;
    right: -80px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(62, 173, 71, 0.1) 0%, transparent 65%);
    border-radius: 50%;
    pointer-events: none;
  }

  .comm-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: linear-gradient(135deg, #FFF3E0, #FFE5B4);
    border: 1px solid rgba(247, 148, 29, 0.35);
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    color: #C96218;
    margin-bottom: 14px;
    box-shadow: 0 4px 12px rgba(247, 148, 29, 0.18);
  }

  .comm-title-wrap {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px auto;
    position: relative;
    z-index: 1;
  }

  .comm-title-wrap h2 {
    font-family: 'Baloo 2', sans-serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 6px 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  /* Shimmer underline below section heading */
  .comm-heading-accent {
