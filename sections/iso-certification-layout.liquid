{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --iso-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --iso-secondary: #007b3e;
    --iso-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --iso-text-dark: #1a1a1a;
    --iso-text-light: #4a4a4a;
    --iso-radius: 16px;
    --iso-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    --iso-shadow-hover: 0 20px 40px rgba(0, 0, 0, 0.12);
  }
  
  .iso-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--iso-text-dark);
    background-color: var(--iso-bg);
    overflow: hidden;
  }

  /* --- Typography --- */
  .iso-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--iso-text-dark);
  }
  .iso-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--iso-text-light);
  }
  
  /* --- Premium Hero Section --- */
  .iso-hero {
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
    background-color: #090e1a;
    min-height: 480px;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
  }
  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 10px 26px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  
  /* --- Left to Right Moving Marquee Text --- */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .moving-text {
    position: absolute;
    top: 65px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.45;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(38px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 16s linear infinite;
  }

  /* --- Premium Certificate Showcase & Details --- */
  .iso-showcase {
    padding: clamp(60px, 8vw, 100px) 20px;
    background: radial-gradient(circle at 80% 20%, rgba(236, 92, 10, 0.05) 0%, #ffffff 45%, rgba(0, 123, 62, 0.05) 100%);
    position: relative;
  }
  .iso-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 912px) {
    .iso-grid { grid-template-columns: 1fr 1.2fr; gap: 60px; }
  }

  /* 3D Certificate Viewer Box */
  .iso-cert-box {
    perspective: 1200px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .iso-cert-img-wrapper {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25), 0 0 40px rgba(236, 92, 10, 0.15), 0 0 0 2px rgba(255, 204, 0, 0.5);
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.6s ease;
  }
  .iso-cert-img-wrapper:hover {
    transform: translateY(-10px) rotateX(5deg) rotateY(-5deg);
    box-shadow: 0 35px 75px rgba(0, 0, 0, 0.3), 0 0 60px rgba(236, 92, 10, 0.25), 0 0 0 3px rgba(255, 204, 0, 0.8);
  }
  .iso-cert-img-wrapper img, .iso-cert-img-wrapper svg {
    width: 100%;
    height: auto;
    display: block;
    transform: translateZ(20px);
  }
  .iso-cert-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
    padding: 16px 36px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .iso-cert-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.5);
    background: linear-gradient(135deg, #f1721b, #007b3e);
  }

  /* Details Box */
  .iso-details-box {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.07);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .iso-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.12), rgba(0, 123, 62, 0.12));
    border: 1px solid rgba(236, 92, 10, 0.3);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #ec5c0a;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    width: fit-content;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.1);
  }
  .iso-badge .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ec5c0a;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(236, 92, 10, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(236, 92, 10, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(236, 92, 10, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(236, 92, 10, 0); }
  }

  .iso-details-box h2 {
    font-size: clamp(26px, 3vw, 42px);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 20px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: color-shift 4s linear infinite;
  }
  @keyframes color-shift {
    to { background-position: 200% center; }
  }
  .iso-main-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #444;
    margin-bottom: 35px;
  }
  
  .iso-data-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 600px) {
    .iso-data-grid { grid-template-columns: 1fr 1fr; }
  }
  .iso-data-item {
    background: #ffffff;
    padding: 16px 20px;
    border-radius: 16px;
    border-left: 4px solid #007b3e;
    border-right: 1px solid rgba(0, 123, 62, 0.1);
    border-top: 1px solid rgba(0, 123, 62, 0.1);
    border-bottom: 1px solid rgba(0, 123, 62, 0.1);
    box-shadow: 0 6px 15px rgba(0,0,0,0.04);
    transition: all 0.3s ease;
  }
  .iso-data-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 123, 62, 0.1);
    border-left-color: #ec5c0a;
  }
  .iso-data-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #888;
    margin-bottom: 6px;
  }
  .iso-data-value {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  /* Responsive fixes */
  @media screen and (max-width: 768px) {
    .iso-hero {
      min-height: 260px !important;
      height: 60vw !important;
      padding: 12px 10px !important;
    }
    .moving-text {
      top: 38px !important;
      font-size: 32px !important;
      opacity: 0.70 !important;
    }
    .iso-details-box {
      padding: 24px 20px;
    }
    .iso-cert-btn {
      width: 100%;
      max-width: 320px;
    }
  }

  /* --- Commitment Cards --- */
  .iso-commitment {
    background: #ffffff;
    padding: clamp(60px, 8vw, 100px) 20px;
  }
  .comm-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  .comm-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  @media (min-width: 600px) {
    .comm-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .comm-grid { grid-template-columns: repeat(4, 1fr); }
  }
  
  .comm-card {
    background: var(--iso-bg);
    padding: 40px 20px;
    border-radius: var(--iso-radius);
    text-align: center;
    border: 1px solid rgba(0,0,0,0.03);
    transition: transform 0.3s ease;
  }
  .comm-card:hover {
    transform: translateY(-5px);
  }
  .comm-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
    color: var(--iso-primary);
  }
  .comm-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--iso-text-dark);
  }

  /* --- Why it Matters Split Section --- */
  .iso-why {
    padding: clamp(60px, 8vw, 100px) 20px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 912px) {
    .why-grid { grid-template-columns: 1fr 1fr; gap: 80px; }
    .why-grid.reverse .why-text { order: 1; }
    .why-grid.reverse .why-img { order: 2; }
  }
  .why-img {
    border-radius: var(--iso-radius);
    overflow: hidden;
    box-shadow: var(--iso-shadow);
  }
  .why-img img, .why-img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .why-text h2 {
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 20px;
  }
  .why-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--iso-text-light);
    margin-bottom: 15px;
  }

  /* --- CTA Section --- */
  .iso-cta {
    background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
    color: #ffffff;
    padding: clamp(60px, 8vw, 100px) 20px;
    text-align: center;
  }
  .iso-cta-content {
    max-width: 600px;
    margin: 0 auto;
  }
  .iso-cta h2 {
    color: #ffffff;
    margin-bottom: 15px;
  }
  .iso-cta p {
    color: #cccccc;
    margin-bottom: 30px;
  }
  .iso-cta-btn {
    display: inline-block;
    padding: 15px 40px;
    background: var(--iso-primary);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .iso-cta-btn:hover {
    background: #d45007;
    transform: translateY(-3px);
  }
{%- endstyle -%}

<div class="iso-wrapper">
  
  <!-- Premium Hero Section -->
  <section class="iso-hero page-header page-header_align_center" 
           style="{% if section.settings.hero_bg != blank %}background-image: url('{{ section.settings.hero_bg | image_url: width: 1920 }}');{% else %}background-image: linear-gradient(135deg, #090e1a, #151d30);{% endif %}">
    <div class="moving-text">{{ section.settings.hero_title }} &nbsp; &nbsp; &nbsp; &nbsp; {{ section.settings.hero_title }} &nbsp; &nbsp; &nbsp; &nbsp; {{ section.settings.hero_title }} &nbsp; &nbsp; &nbsp; &nbsp; {{ section.settings.hero_title }}</div>
    <div class="hero-breadcrumb-pill">
      <a href="/">Home</a>
      <span style="color: #ffcc00;">/</span>
      <span style="color: #ffffff; font-weight: 700; font-size: 0.92rem;">{{ section.settings.hero_title }}</span>
    </div>
  </section>

  <!-- Showcase & Details -->
  <section class="iso-showcase">
    <div class="iso-grid">
      
      <!-- Certificate Viewer -->
      <div class="iso-cert-box">
        <div class="iso-cert-img-wrapper">
          {%- if section.settings.cert_image != blank -%}
            {{ section.settings.cert_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'ISO Certificate Preview' }}
          {%- else -%}
            {{ 'document' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        
        {%- if section.settings.cert_pdf_url != blank -%}
          <a href="{{ section.settings.cert_pdf_url }}" target="_blank" rel="noopener noreferrer" class="iso-cert-btn">
            {{ section.settings.cert_btn_text }}
          </a>
        {%- else -%}
          <button class="iso-cert-btn" style="opacity:0.6; cursor:not-allowed;" title="Upload PDF in Theme Editor">
            {{ section.settings.cert_btn_text }}
          </button>
        {%- endif -%}
      </div>

      <!-- Text Details -->
      <div class="iso-details-box">
        <div class="iso-badge">
          <div class="pulse-dot"></div>
          100% Verified & Compliant
        </div>
        <h2>{{ section.settings.details_heading }}</h2>
        <div class="iso-main-text">
          {{ section.settings.details_text }}
        </div>
        
        <div class="iso-data-grid">
          {%- if section.settings.detail_standard != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Standard</div>
              <div class="iso-data-value">{{ section.settings.detail_standard }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_body != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Accreditation Body</div>
              <div class="iso-data-value">{{ section.settings.detail_body }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_number != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Certificate No.</div>
              <div class="iso-data-value">{{ section.settings.detail_number }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_issue != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Issue Date</div>
              <div class="iso-data-value">{{ section.settings.detail_issue }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_expiry != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Valid Until</div>
              <div class="iso-data-value">{{ section.settings.detail_expiry }}</div>
            </div>
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </section>

  <!-- Commitment Cards -->
  <section class="iso-commitment">
    <div class="comm-container">
      <h2 class="iso-heading" style="text-align: center;">Our Commitment to Quality</h2>
      <div class="comm-grid">
        <div class="comm-card">
          <div class="comm-icon">⭐</div>
          <h3>{{ section.settings.comm_1 }}</h3>
        </div>
        <div class="comm-card">
          <div class="comm-icon">🤝</div>
          <h3>{{ section.settings.comm_2 }}</h3>
        </div>
        <div class="comm-card">
          <div class="comm-icon">📈</div>
          <h3>{{ section.settings.comm_3 }}</h3>
        </div>
        <div class="comm-card">
          <div class="comm-icon">🏆</div>
          <h3>{{ section.settings.comm_4 }}</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- Why it Matters -->
  <section class="iso-why">
    <div class="why-grid">
      <div class="why-text">
        <h2>{{ section.settings.why_heading }}</h2>
        <div class="iso-main-text">
          {{ section.settings.why_text }}
        </div>
      </div>
      <div class="why-img">
        {%- if section.settings.why_image != blank -%}
          {{ section.settings.why_image | image_url: width: 800, height: 600, crop: 'center' | image_tag: loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="iso-cta">
    <div class="iso-cta-content">
      <h2 class="iso-heading">{{ section.settings.cta_heading }}</h2>
      <p class="iso-subheading">{{ section.settings.cta_text }}</p>
      <a href="{{ section.settings.cta_link }}" class="iso-cta-btn">{{ section.settings.cta_btn_text }}</a>
    </div>
  </section>

</div>

