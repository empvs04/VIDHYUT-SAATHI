<script>
  function renderIsoPdfCertificate() {
    const pdfUrl = "{{ 'iso-certificate.pdf' | asset_url }}";
    if (typeof pdfjsLib !== 'undefined' && pdfUrl) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      
      pdfjsLib.getDocument(pdfUrl).promise.then(function(pdf) {
        pdf.getPage(1).then(function(page) {
          const scale = 2.5; // High resolution 300 DPI render scale
          const viewport = page.getViewport({ scale: scale });
          
          ['iso-pdf-canvas-1', 'iso-pdf-canvas-2'].forEach(function(canvasId) {
            const canvas = document.getElementById(canvasId);
            if (canvas) {
              const context = canvas.getContext('2d');
              canvas.height = viewport.height;
              canvas.width = viewport.width;
              page.render({ canvasContext: context, viewport: viewport });
            }
          });
        });
      }).catch(function(err) {
        console.warn('PDF.js rendering fallback to image:', err);
        const fallback1 = document.getElementById('iso-pdf-fallback-1');
        if (fallback1) fallback1.style.display = 'block';
        const canvas1 = document.getElementById('iso-pdf-canvas-1');
        if (canvas1) canvas1.style.display = 'none';
        const fallback2 = document.getElementById('iso-pdf-fallback-2');
        if (fallback2) fallback2.style.display = 'block';
        const canvas2 = document.getElementById('iso-pdf-canvas-2');
        if (canvas2) canvas2.style.display = 'none';
      });
    }
  }
  document.addEventListener("DOMContentLoaded", renderIsoPdfCertificate);
  if (window.Shopify && Shopify.designMode) { setTimeout(renderIsoPdfCertificate, 300); }

  // Our Commitment to Quality — Mobile 3s Auto-Slide JS
  document.addEventListener('DOMContentLoaded', function() {
    const commGrid = document.querySelector('.comm-grid');
    const commDots = document.querySelectorAll('#comm-slider-dots .comm-dot');
    let commCurrentIndex = 0;
    let commAutoSlideTimer = null;

    if (commGrid && commDots.length > 0) {
      function updateCommDots(index) {
        commDots.forEach((dot, idx) => {
          if (idx === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function scrollToSlide(index) {
        const cards = commGrid.querySelectorAll('.comm-card');
        if (cards[index]) {
          const cardWidth = cards[index].offsetWidth + 16;
          commGrid.scrollTo({
            left: index * cardWidth,
            behavior: 'smooth'
          });
          commCurrentIndex = index;
          updateCommDots(index);
        }
      }

      function startCommAutoSlide() {
        if (!commAutoSlideTimer) {
          commAutoSlideTimer = setInterval(function() {
            if (window.innerWidth <= 768) {
              const cards = commGrid.querySelectorAll('.comm-card');
              if (cards.length > 0) {
                commCurrentIndex = (commCurrentIndex + 1) % cards.length;
                scrollToSlide(commCurrentIndex);
              }
            }
          }, 3000);
        }
      }

      function stopCommAutoSlide() {
        if (commAutoSlideTimer) {
          clearInterval(commAutoSlideTimer);
          commAutoSlideTimer = null;
        }
      }

      if ('IntersectionObserver' in window) {
        const commObserver = new IntersectionObserver(function(entries) {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              startCommAutoSlide();
            } else {
              stopCommAutoSlide();
            }
          });
        }, { threshold: 0.2 });

        commObserver.observe(commGrid);
      } else {
        startCommAutoSlide();
      }

      commDots.forEach((dot, idx) => {
        dot.addEventListener('click', function() {
          scrollToSlide(idx);
          stopCommAutoSlide();
          startCommAutoSlide();
        });
      });

      commGrid.addEventListener('scroll', function() {
        if (window.innerWidth <= 768) {
          const cardWidth = commGrid.offsetWidth;
          if (cardWidth > 0) {
            const newIndex = Math.round(commGrid.scrollLeft / cardWidth);
            if (newIndex >= 0 && newIndex < commDots.length && newIndex !== commCurrentIndex) {
              commCurrentIndex = newIndex;
              updateCommDots(newIndex);
            }
          }
        }
      }, { passive: true });
    }
  });
</script>

