  }

  .why-text h2 {
    font-family: 'Baloo 2', sans-serif;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 16px;
    color: #0F172A;
    letter-spacing: -0.5px;
