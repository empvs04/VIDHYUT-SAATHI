  /* --- Why ISO Certification Matters — Premium Section --- */
  .iso-why {
    padding: 60px 48px;
    max-width: 1280px;
    margin: 50px auto 60px auto;
    background: linear-gradient(140deg, #FFFDF8 0%, #FFF8EE 40%, #F0FAF1 100%);
    border: 1.5px solid rgba(247, 148, 29, 0.2);
    border-top: 5px solid #F7941D;
    border-radius: 36px;
    box-shadow:
      0 30px 70px rgba(247, 148, 29, 0.14),
      0 10px 28px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    position: relative;
    overflow: hidden;
  }
  /* Decorative glowing orbs */
  .iso-why::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(247, 148, 29, 0.13) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .iso-why::after {
    content: '';
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(62, 173, 71, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 912px) {
