<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800;900&family=Nunito:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&family=IBM+Plex+Mono:wght@600;700&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     VIDHYUT SAATHI — INDUSTRIAL REQUIRED CARDS PAGE
     Theme: Industrial Deep Slate #0f172a | Cyan #0284c7 | Green #008744 | Orange #ec5c0a
  ============================================================ */
  .vsind {
    --bg:       #fff9f2;
    --bg-warm:  #f5ebd9;
    --panel:    #ffffff;
    --panel-2:  #f8fafc;
    --line:     #e2e8f0;
    --line-s:   #cbd5e1;
    --green:    #007b3e;
    --green-d:  #064e3b;
    --green-t:  #e6f4ec;
    --cyan:     #0284c7;
    --cyan-d:   #0369a1;
    --cyan-t:   #e0f2fe;
    --orange:   #ec5c0a;
    --orange-d: #c84900;
    --orange-t: #ffefe5;
    --gold:     #c9982e;
    --ink:      #0f172a;
    --muted:    #475569;
    --muted-2:  #64748b;
    --maxw:     1180px;

    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    font-size: 16px;
    line-height: 1.55;
  }

  .vsind *, .vsind *::before, .vsind *::after {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  .vsind h1, .vsind h2, .vsind h3, .vsind h4 {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }

  .vsind a { color: inherit; text-decoration: none; }
  .vsind img { max-width: 100%; display: block; }
  .vsind button { font-family: inherit; cursor: pointer; }

  .vsind .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 16px;
  }
  @media(min-width: 640px){ .vsind .wrap { padding: 0 28px; } }

  /* ---- CATEGORY NAVIGATION STRIP ---- */
  .vsind-nav-strip {
    background: #ffffff;
    border-bottom: 1.5px solid var(--line);
    padding: 12px 16px;
    position: relative;
    z-index: 9999;
    pointer-events: auto !important;
    box-shadow: 0 4px 14px rgba(0,0,0,0.03);
  }

  .vsind-nav-container {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    pointer-events: auto !important;
  }

  .vsind-nav-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .vsind-nav-title i { color: var(--orange); }

  .vsind-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    pointer-events: auto !important;
  }
  .vsind-nav-links::-webkit-scrollbar { display: none; }

  .vsind-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: var(--muted);
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative;
    z-index: 10;
  }
  .vsind-nav-item:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
  .vsind-nav-item.active {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border-color: #0284c7;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
  }

  /* ---- HERO SECTION ---- */
  .vsind-hero {
    position: relative;
    padding: clamp(32px, 5vw, 65px) 0 clamp(24px, 4vw, 45px) 0;
    background: linear-gradient(135deg, #ffffff 0%, #e0f2fe 45%, #fff9f2 100%);
    border-bottom: 1.5px solid var(--line);
    overflow: hidden;
  }

  .vsind-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  @media(min-width: 900px){
    .vsind-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
    }
  }

  .vsind-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--cyan-t);
    border: 1.5px solid #0284c7;
    color: #0369a1;
    font-size: 11px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 16px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.12);
  }

  .vsind-hero h1 {
    font-size: clamp(25px, 5.2vw, 46px);
    line-height: 1.15;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 14px 0;
  }
  .vsind-hero h1 span {
    background: linear-gradient(135deg, #0284c7 0%, #ec5c0a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsind-hero-lead {
    color: var(--muted);
    font-size: clamp(14px, 2vw, 16px);
    line-height: 1.6;
    margin: 0 0 24px 0;
    max-width: 620px;
  }

  .vsind-hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .vsind-btn-primary {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    font-weight: 800;
    padding: 14px 26px;
    border-radius: 12px;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    box-shadow: 0 6px 20px rgba(2, 132, 199, 0.3);
    transition: all 0.2s ease;
  }
  .vsind-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(2, 132, 199, 0.42);
    background: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);
  }

  .vsind-btn-secondary {
    background: #ffffff;
    color: var(--orange-d);
    border: 1.5px solid var(--orange);
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.1);
  }
  .vsind-btn-secondary:hover {
    background: var(--orange-t);
    transform: translateY(-2px);
  }

  /* Trust Badges Strip */
  .vsind-trust-badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding-top: 20px;
    border-top: 1.5px solid var(--line);
  }
  @media(min-width: 600px){
    .vsind-trust-badges { grid-template-columns: repeat(4, 1fr); }
  }

  .vsind-trust-badge-item {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    transition: all 0.25s ease;
  }
  .vsind-trust-badge-item:hover {
    transform: translateY(-2px);
    border-color: #0284c7;
    box-shadow: 0 6px 16px rgba(2, 132, 199, 0.12);
  }

  .vsind-trust-badge-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--cyan-t);
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
  }

  .vsind-trust-badge-text strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .vsind-trust-badge-text span {
    font-size: 10.5px;
    color: var(--muted-2);
  }

  /* Right Card Image Showcase */
  .vsind-hero-image-box {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, #ffffff 0%, #e0f2fe 60%, #fff7ed 100%);
    border: 2px solid rgba(2, 132, 199, 0.2);
    box-shadow: 0 16px 36px rgba(0,0,0,0.06);
    padding: 24px;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .vsind-hero-card-tag {
    background: #e0f2fe;
    border: 1px solid #0284c7;
    color: #0369a1;
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 16px;
  }

  .vsind-mcb-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1.5px solid #0284c7;
    color: #0284c7;
    font-size: 12.5px;
    font-weight: 800;
    padding: 8px 18px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: 10px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.12);
  }
  .vsind-mcb-hero-link:hover {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border-color: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(2, 132, 199, 0.35);
  }

  /* ---- CALCULATOR SECTION ---- */
  .vsind-sec {
    padding: 44px 0;
    font-family: 'Nunito', sans-serif;
  }
  @media(min-width: 768px){ .vsind-sec { padding: 60px 0; } }

  .vsind-sec-head {
    max-width: 680px;
    margin: 0 auto 28px;
    text-align: center;
  }
  .vsind-sec-eyebrow {
    font-size: 12px;
    font-weight: 800;
    font-family: 'Baloo 2', sans-serif;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--cyan-d);
    margin-bottom: 6px;
  }
  .vsind-sec-title {
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 800;
    font-family: 'Baloo 2', sans-serif !important;
    color: var(--ink);
    margin: 0 0 10px 0;
  }
  .vsind-sec-desc {
    color: var(--muted);
    font-size: 15px;
    font-family: 'Nunito', sans-serif;
    line-height: 1.6;
    margin: 0;
  }

  .vsind-calc-box {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    padding: 24px 18px;
    font-family: 'Nunito', sans-serif;
  }
  @media(min-width: 860px){
    .vsind-calc-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding: 36px 30px;
    }
  }

  .vsind-field { margin-bottom: 20px; }
  .vsind-field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 800;
    font-family: 'Nunito', sans-serif;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .vsind-field-badge {
    background: var(--cyan-t);
    color: var(--cyan-d);
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    font-family: 'Baloo 2', sans-serif;
  }

  .vsind-range-slider {
    width: 100%;
    height: 8px;
    border-radius: 50px;
    background: var(--line);
    outline: none;
    accent-color: var(--cyan-d);
    margin: 10px 0;
  }

  .vsind-num-input {
    width: 100%;
    height: 46px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 0 14px;
    font-size: 16px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    color: var(--ink);
    background: #ffffff;
    outline: none;
  }
  .vsind-num-input:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .vsind-toggle-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 6px;
  }
  .vsind-toggle-btn {
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    font-weight: 700;
    font-family: 'Nunito', sans-serif;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }
  .vsind-toggle-btn:hover {
    border-color: #0284c7;
    color: #0284c7;
  }
  .vsind-toggle-btn.active {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border-color: #0284c7;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
  }

  .vsind-output-card {
    background: var(--panel-2);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: 'Nunito', sans-serif;
  }

  .vsind-res-val {
    font-family: 'Baloo 2', sans-serif !important;
    font-size: clamp(48px, 10vw, 68px);
    font-weight: 800;
    color: #0284c7;
    line-height: 1;
    margin: 8px 0 16px 0;
  }
  .vsind-res-val span {
    font-size: 18px;
    color: var(--muted);
    font-family: 'Nunito', sans-serif;
  }

  .vsind-savings-box {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    border-radius: 14px;
    padding: 16px;
    color: #ffffff;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
    font-family: 'Nunito', sans-serif;
  }

  /* ══ 20 INDUSTRIAL MCB & LT PANEL GALLERY ══ */
  .ind-sec {
    background: #ffffff;
    border-top: 1.5px solid var(--line);
    border-bottom: 1.5px solid var(--line);
    padding: clamp(40px, 6vw, 75px) 0;
  }

  .ind-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .ind-filter-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .ind-filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    background: #ffffff;
    color: #334155;
    border: 1.5px solid #cbd5e1;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    cursor: pointer;
    transition: all 0.25s ease;
    line-height: 1;
    outline: none;
  }

  .ind-filter-btn i {
    font-size: 14px;
  }

  .ind-filter-btn:hover {
    border-color: #0284c7;
    color: #0284c7;
    background: #f0f9ff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.12);
  }

  .ind-filter-btn.active {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border-color: #0284c7;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
  }

  .ind-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    align-items: stretch;
  }
  @media(min-width: 640px){ .ind-gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  @media(min-width: 1024px){ .ind-gallery-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }

  .ind-card {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border: 1.5px solid #cbd5e1;
    border-top: 4px solid #0284c7;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0,0,0,0.04);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    cursor: pointer;
  }
  .ind-card:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow: 0 18px 40px rgba(2, 132, 199, 0.18);
    border-color: #0284c7;
  }

  .ind-card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0f172a;
  }
  .ind-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .ind-card:hover .ind-card-img-wrap img {
    transform: scale(1.08);
  }

  .ind-card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    font-size: 9px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 50px;
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
    z-index: 2;
    white-space: nowrap;
    max-width: calc(100% - 20px);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ind-card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: left;
    background: #ffffff;
  }
  .ind-card-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--ink);
    margin: 2px 0 4px 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ind-card-desc {
    font-size: 11px;
    color: var(--muted-2);
    margin: 0;
den;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- INDUSTRIAL SIZING TABLE (EXACT MATCH TO SCREENSHOT) ---- */
  .vsind-table-wrap {
    background: #ffffff;
    border: 1.5px solid #f3e6d3;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .vsind-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .vsind-table thead tr {
    background: #0284c7;
    color: #ffffff;
  }

  .vsind-table th {
    padding: 12px 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    color: #ffffff;
    vertical-align: middle;
  }
  .vsind-table th:first-child { text-align: left; padding-left: 14px; }

  .vsind-table tbody tr {
    border-bottom: 1px solid #f3e6d3;
  }
  .vsind-table tbody tr:nth-child(even) { background: #fffbf5; }
  .vsind-table tbody tr:last-child { border-bottom: none; }

  .vsind-table td {
    padding: 12px 10px;
    text-align: center;
    color: #475569;
    vertical-align: middle;
    line-height: 1.4;
  }
  .vsind-table td:first-child {
    text-align: left;
    padding-left: 14px;
    font-weight: 800;
    color: #0f172a;
    font-family: 'Space Grotesk', sans-serif;
  }
  .vsind-table td.highlight {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    color: #475569;
    font-size: 13.5px;
  }

  /* Worked Examples Summary Badge - Responsive for Mobile */
  .vsind-case-result-badge {
    background: linear-gradient(135deg, #0f172a 0%, #0284c7 100%);
    padding: 10px 14px;
    border-radius: 14px;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 700;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.2);
    min-height: 46px;
    width: 100%;
    box-sizing: border-box;
  }
  .vsind-case-result-badge span {
    white-space: nowrap;
  }
  .vsind-case-result-badge strong {
    font-family: 'Baloo 2', 'Space Grotesk', sans-serif;
    font-size: 13px;
    color: #ffffff;
    white-space: nowrap;
  }

  /* WORKED EXAMPLES SLIDER STYLING */
  .vs-cases-slider-wrap {
    width: 100%;
    position: relative;
  }
  .vs-slider-dots-bar {
    display: none;
  }
