<script>
  var vsindThreePhase = true;

  function vsindSetPhase(isThree) {
    vsindThreePhase = isThree;
    var btnSingle = document.getElementById('vsind_btn_single');
    var btnThree = document.getElementById('vsind_btn_three');
    if (isThree) {
      btnThree.classList.add('active');
      btnSingle.classList.remove('active');
    } else {
      btnSingle.classList.add('active');
      btnThree.classList.remove('active');
    }
    vsindSync();
  }

  function vsindSync(source) {
    var kwSlider = document.getElementById('vsind_kw_slider');
    var kwNum = document.getElementById('vsind_kw_num');
    var billNum = document.getElementById('vsind_bill_num');

    var kw = parseInt(kwNum.value) || 60;
    var bill = parseInt(billNum.value) || 60000;

    if (source === 'slider') {
      kw = parseInt(kwSlider.value) || 15;
      kwNum.value = kw;
      bill = kw * 1000;
      billNum.value = bill;
    } else if (source === 'kw') {
      kw = Math.max(1, kw);
      kwSlider.value = Math.min(kw, 500);
      bill = kw * 1000;
      billNum.value = bill;
    } else if (source === 'bill') {
      bill = Math.max(1000, bill);
      kw = Math.max(1, Math.round(bill / 1000));
      kwNum.value = kw;
      kwSlider.value = Math.min(kw, 500);
    }

    document.getElementById('vsind_kw_badge').innerText = kw + ' KW';
    document.getElementById('vsind_bill_badge').innerText = '₹' + bill.toLocaleString('en-IN');

    // Industrial Calculation: 1 card per 6 KW (+1 for 3-Phase LT/HT panel balancing)
    var baseCards = Math.max(1, Math.ceil(kw / 6));
    var total = vsindThreePhase ? baseCards + 1 : baseCards;

    document.getElementById('vsind_card_num').innerText = total;
    document.getElementById('vsind_card_unit').innerText = total > 1 ? 'Cards' : 'Card';

    // 20-30% DISCOM Bill Savings
    var sMin = Math.round((bill * 0.20) / 100) * 100;
    var sMax = Math.round((bill * 0.30) / 100) * 100;
    document.getElementById('vsind_savings_range').innerText = '₹' + sMin.toLocaleString('en-IN') + ' – ₹' + sMax.toLocaleString('en-IN') + ' / mo';
  }

  document.getElementById('vsind_kw_slider').addEventListener('input', function() { vsindSync('slider'); });
  document.getElementById('vsind_kw_num').addEventListener('input', function() { vsindSync('kw'); });
  document.getElementById('vsind_bill_num').addEventListener('input', function() { vsindSync('bill'); });

  /* INDUSTRIAL MCB GALLERY FILTER & LIGHTBOX */
  function filterInd(category, btnElem) {
    if (btnElem) {
      var allBtns = document.querySelectorAll('.ind-filter-btn');
      allBtns.forEach(function(b) { b.classList.remove('active'); });
      btnElem.classList.add('active');
    }
    var cards = document.querySelectorAll('.ind-card');
    cards.forEach(function(card) {
      var cat = card.getAttribute('data-category');
      if (category === 'all' || cat === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function openIndLightbox(imgSrc, title, caption) {
    var container = document.getElementById('ind_lightbox_img_container');
    if (imgSrc) {
      container.innerHTML = '<img src="' + imgSrc + '" style="max-width:100%; max-height:420px; object-fit:contain;">';
    } else {
      container.innerHTML = '<div style="padding:40px; text-align:center; color:#0369a1; font-size:18px; font-weight:800;"><i class="fa-solid fa-industry" style="font-size:36px; margin-bottom:10px; display:block;"></i>' + title + '</div>';
    }
    document.getElementById('ind_lightbox_title').innerText = title;
    document.getElementById('ind_lightbox_desc').innerText = caption;
    document.getElementById('ind_lightbox').classList.add('active');
  }

  function closeIndLightbox() {
    document.getElementById('ind_lightbox').classList.remove('active');
  }

  /* ══ MOBILE 5-SECOND CASE STUDIES AUTO-SLIDER ══ */
  (function() {
    var track = document.getElementById('vsindCaseTrack');
    var wrap = document.getElementById('vsindCaseSliderWrap');
    var dots = document.querySelectorAll('#vsindCaseDots .vs-slider-dot');
    if (!track || !wrap) return;

    var currentIdx = 0;
    var totalSlides = dots.length || 3;
    var timer = null;
    var isMobile = function() { return window.innerWidth < 768; };

    window.vsindGoSlide = function(idx) {
      if (!isMobile()) return;
      currentIdx = (idx + totalSlides) % totalSlides;
      track.style.transform = 'translateX(-' + (currentIdx * 100) + '%)';
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === currentIdx);
      });
    };

    function startAutoSlide() {
      stopAutoSlide();
      if (!isMobile()) return;
      timer = setInterval(function() {
        if (isMobile()) {
          window.vsindGoSlide(currentIdx + 1);
        }
      }, 5000);
    }

    function stopAutoSlide() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            startAutoSlide();
          } else {
            stopAutoSlide();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(wrap);
    } else {
      startAutoSlide();
    }

    var startX = 0;
    var deltaX = 0;
    wrap.addEventListener('touchstart', function(e) {
      if (!isMobile()) return;
      stopAutoSlide();
      startX = e.touches[0].clientX;
      deltaX = 0;
    }, { passive: true });

    wrap.addEventListener('touchmove', function(e) {
      if (!isMobile()) return;
      deltaX = e.touches[0].clientX - startX;
    }, { passive: true });

    wrap.addEventListener('touchend', function() {
      if (!isMobile()) return;
      if (deltaX < -40) {
        window.vsindGoSlide(currentIdx + 1);
      } else if (deltaX > 40) {
        window.vsindGoSlide(currentIdx - 1);
      }
      startAutoSlide();
    }, { passive: true });

    window.addEventListener('resize', function() {
      if (!isMobile()) {
        track.style.transform = '';
        stopAutoSlide();
      } else if (!timer) {
        startAutoSlide();
      }
    });
  })();
</script>

