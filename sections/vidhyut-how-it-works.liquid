<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

{%- style -%}
  /* --- HOW IT WORKS SECTION STYLES --- */
  .vshw-wrapper {
    position: relative;
    padding: clamp(50px, 7vw, 90px) 20px;
    background: linear-gradient(150deg, #FFFDF8 0%, #FFF5E0 35%, #F4FAF5 70%, #FFFFFF 100%);
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Poppins', sans-serif;
    color: #0f172a;
    overflow: hidden;
    border-top: 1.5px solid rgba(247, 148, 29, 0.15);
    border-bottom: 1.5px solid rgba(0, 123, 62, 0.15);
  }

  /* Decorative Background Glows */
  .vshw-wrapper::before {
    content: '';
    position: absolute;
    top: -120px;
    left: -120px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.10) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .vshw-wrapper::after {
    content: '';
    position: absolute;
    bottom: -120px;
    right: -120px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.10) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vshw-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- HEADER & TOP BADGES --- */
  .vshw-header {
    text-align: center;
    max-width: 920px;
    margin: 0 auto 50px auto;
  }

  .vshw-top-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .vshw-tag-slogan {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 22px;
    background: linear-gradient(135deg, #FFF3E0, #FFE5B4);
    border: 1.5px solid rgba(236, 92, 10, 0.4);
    border-radius: 50px;
    font-size: 0.88rem;
    font-weight: 800;
    color: #D96924;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.15);
  }
  .vshw-tag-slogan .pulse-bolt {
    color: #ec5c0a;
    font-size: 1rem;
    animation: vshwBoltPulse 1.5s infinite alternate;
  }
  @keyframes vshwBoltPulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    100% { transform: scale(1.2); opacity: 1; filter: drop-shadow(0 0 6px #ec5c0a); }
  }

  .vshw-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    background: #ffffff;
    border: 1px solid rgba(0, 123, 62, 0.3);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #007b3e;
    box-shadow: 0 4px 12px rgba(0, 123, 62, 0.08);
  }

  .vshw-main-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(26px, 4vw, 46px);
    font-weight: 900;
    line-height: 1.2;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin: 0 0 14px 0;
    text-transform: uppercase;
  }
  .vshw-main-title .highlight-orange {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .vshw-main-title .highlight-green {
    background: linear-gradient(135deg, #007b3e 0%, #3ead47 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vshw-header-divider {
    width: 90px;
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e, #ec5c0a);
    background-size: 200% auto;
    animation: vshwShimmer 2.5s linear infinite;
    margin: 0 auto;
  }
  @keyframes vshwShimmer {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }

  /* --- 3-COLUMN MAIN COMPARISON STAGE --- */
  .vshw-stage-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 26px;
    align-items: stretch;
    margin-bottom: 50px;
  }
  @media (max-width: 992px) {
    .vshw-stage-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  /* --- COMPARISON CARD BOX (BEFORE & AFTER) --- */
  .vshw-comp-box {
    background: #ffffff;
    border-radius: 28px;
    padding: 28px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vshw-comp-box:hover {
    transform: translateY(-6px);
  }

  /* BEFORE CARD STYLES */
  .vshw-comp-box.before-box {
    border: 2px solid rgba(220, 38, 38, 0.3);
    background: linear-gradient(160deg, #FFFFFF 0%, #FFF5F5 50%, #FEF2F2 100%);
  }
  .vshw-comp-box.before-box:hover {
    box-shadow: 0 24px 50px rgba(220, 38, 38, 0.18);
    border-color: rgba(220, 38, 38, 0.5);
  }

  /* AFTER CARD STYLES */
  .vshw-comp-box.after-box {
    border: 2px solid rgba(16, 185, 129, 0.3);
    background: linear-gradient(160deg, #FFFFFF 0%, #F0FDF4 50%, #ECFDF5 100%);
  }
  .vshw-comp-box.after-box:hover {
    box-shadow: 0 24px 50px rgba(16, 185, 129, 0.18);
    border-color: rgba(16, 185, 129, 0.5);
  }

  .vshw-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .vshw-badge-pill {
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .vshw-badge-pill.before {
    background: linear-gradient(135deg, #EF4444, #DC2626);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.3);
  }
  .vshw-badge-pill.after {
    background: linear-gradient(135deg, #10B981, #059669);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
  }

  .vshw-box-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 16px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .vshw-box-title i.red { color: #dc2626; }
  .vshw-box-title i.green { color: #10b981; }

  /* GRAPH CONTAINER & CANVAS */
  .vshw-graph-wrapper {
    position: relative;
    width: 100%;
    height: 160px;
    background: #090e1a;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 20px;
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .vshw-graph-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .vshw-graph-overlay {
    position: absolute;
    top: 10px;
    right: 12px;
    background: rgba(9, 14, 26, 0.85);
    backdrop-filter: blur(6px);
    border-radius: 30px;
    padding: 4px 12px;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .vshw-graph-overlay.red { color: #f87171; }
  .vshw-graph-overlay.green { color: #34d399; }
  .vshw-graph-overlay .dot {
    width: 7px; height: 7px; border-radius: 50%;
  }
  .vshw-graph-overlay.red .dot { background: #ef4444; box-shadow: 0 0 8px #ef4444; animation: vshwBlink 1s infinite alternate; }
  .vshw-graph-overlay.green .dot { background: #10b981; box-shadow: 0 0 8px #10b981; animation: vshwBlink 1.8s infinite alternate; }
  @keyframes vshwBlink { 0% { opacity: 0.3; } 100% { opacity: 1; } }

  .vshw-status-sub {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.8px;
    padding: 4px 10px;
    border-radius: 50px;
    text-transform: uppercase;
  }
  .vshw-status-sub.red {
    background: #FEF2F2;
    color: #DC2626;
    border: 1px solid rgba(220, 38, 38, 0.3);
  }
  .vshw-status-sub.green {
    background: #ECFDF5;
    color: #059669;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .vshw-scope-topbar {
    position: absolute;
    top: 10px;
    left: 12px;
    font-size: 0.7rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.7);
    z-index: 3;
    pointer-events: none;
  }
  .vshw-scope-topbar.red i { color: #ef4444; }
  .vshw-scope-topbar.green i { color: #10b981; }

  /* 3 MICRO METRICS GRID INSIDE CARD */
  .vshw-micro-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 20px;
  }

  .vshw-metric-item {
    padding: 8px 6px;
    border-radius: 12px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .vshw-metric-item.red {
    background: rgba(254, 242, 242, 0.8);
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
  .vshw-metric-item.green {
    background: rgba(236, 253, 245, 0.8);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .vshw-metric-item .m-label {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #64748B;
  }
  .vshw-metric-item.red .m-val {
    font-size: 0.78rem;
    font-weight: 900;
    color: #DC2626;
  }
  .vshw-metric-item.green .m-val {
    font-size: 0.78rem;
    font-weight: 900;
    color: #059669;
  }

  .vshw-bottom-pill {
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 0.88rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .vshw-bottom-pill.red {
    background: #FEF2F2;
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #991B1B;
  }
  .vshw-bottom-pill.green {
    background: #ECFDF5;
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #065F46;
  }

  /* --- CENTER CARD SHOWCASE STAGE (LIGHT THEME) --- */
  .vshw-card-stage {
    background: linear-gradient(150deg, #FFFFFF 0%, #FFFDF5 50%, #F9FFF5 100%);
    border: 2px solid rgba(247, 148, 29, 0.35);
    border-top: 6px solid #F7941D;
    border-radius: 32px;
    padding: 32px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    box-shadow:
      0 26px 60px rgba(247, 148, 29, 0.15),
      0 6px 20px rgba(0, 0, 0, 0.04);
    perspective: 1200px;
    overflow: hidden;
  }

  .vshw-card-glow-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, rgba(247, 148, 29, 0.18) 0%, rgba(62, 173, 71, 0.1) 50%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .vshw-card-img-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 420px;
    border-radius: 20px;
    overflow: hidden;
    border: 2px solid rgba(247, 148, 29, 0.4);
    box-shadow:
      0 20px 45px rgba(247, 148, 29, 0.22),
      0 8px 25px rgba(0, 0, 0, 0.08);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    background: transparent;
    animation: vshw3DFloat 4s ease-in-out infinite alternate;
  }

  @keyframes vshw3DFloat {
    0% {
      transform: translateY(0px) rotateY(-3deg) rotateX(2deg);
      box-shadow: 0 16px 36px rgba(247, 148, 29, 0.2), 0 6px 20px rgba(0,0,0,0.06);
    }
    100% {
      transform: translateY(-10px) rotateY(3deg) rotateX(-2deg);
      box-shadow: 0 28px 55px rgba(247, 148, 29, 0.32), 0 10px 30px rgba(62, 173, 71, 0.2);
    }
  }

  .vshw-card-img-wrapper:hover {
    transform: translateY(-12px) rotateY(-8deg) rotateX(5deg) scale(1.04) !important;
    border-color: #F7941D;
    box-shadow:
      0 35px 70px rgba(247, 148, 29, 0.4),
      0 12px 35px rgba(0, 0, 0, 0.12) !important;
  }

  .vshw-official-card-img,
  .vshw-card-img-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    object-fit: cover;
    background: transparent;
    transform: scale(1.08);
    transform-origin: center;
  }

  .vshw-card-subtext {
    position: relative;
    z-index: 2;
    margin-top: 22px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #334155;
    line-height: 1.6;
    max-width: 340px;
  }
  .vshw-card-subtext strong {
    color: #ec5c0a;
  }

  /* Mockup Card Design Fallback if image not provided */
  .vshw-mock-card {
    padding: 24px 20px;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0b1324 100%);
    border-radius: 20px;
    border: 2px solid rgba(247, 148, 29, 0.5);
    color: #ffffff;
    text-align: left;
    position: relative;
  }
  .vshw-mock-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .vshw-mock-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 900;
    font-size: 1.1rem;
    color: #F7941D;
  }
  .vshw-mock-chip {
    width: 42px;
    height: 30px;
    background: linear-gradient(135deg, #F59E0B, #D97706);
    border-radius: 6px;
    border: 1px solid #FCD34D;
  }
  .vshw-mock-title {
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 1px;
    color: #FFFFFF;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .vshw-mock-sub {
    font-size: 0.72rem;
    color: #3EAD47;
    font-weight: 800;
    margin-bottom: 20px;
  }
  .vshw-mock-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #94A3B8;
    font-weight: 700;
  }

  .vshw-card-subtext {
    position: relative;
    z-index: 2;
    margin-top: 22px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #334155;
    line-height: 1.6;
    max-width: 320px;
  }
  .vshw-card-subtext strong {
    color: #ec5c0a;
  }

  /* --- 5-BENEFITS GRID --- */
  .vshw-benefits-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
    margin-bottom: 40px;
  }
  @media (max-width: 1024px) {
    .vshw-benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 640px) {
    .vshw-benefits-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 14px;
    }
  }

  .vshw-benefit-card {
    background: #FFFFFF;
    border: 1.5px solid rgba(247, 148, 29, 0.22);
    border-radius: 20px;
    padding: 22px 16px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(247, 148, 29, 0.07);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .vshw-benefit-card:hover {
    transform: translateY(-6px) scale(1.02);
    border-color: #ec5c0a;
    box-shadow: 0 18px 36px rgba(236, 92, 10, 0.18);
  }

  .vshw-benefit-icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 14px;
    transition: transform 0.3s ease;
  }
  .vshw-benefit-card:hover .vshw-benefit-icon {
    transform: scale(1.12) rotate(-5deg);
  }

  .vshw-benefit-icon.ic-orange { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); color: #D96924; }
  .vshw-benefit-icon.ic-green { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); color: #1B5E20; }
  .vshw-benefit-icon.ic-blue { background: linear-gradient(135deg, #E0F2FE, #BAE6FD); color: #0284C7; }
  .vshw-benefit-icon.ic-gold { background: linear-gradient(135deg, #FEF3C7, #FDE68A); color: #B45309; }
  .vshw-benefit-icon.ic-teal { background: linear-gradient(135deg, #E0F2FE, #A7F3D0); color: #047857; }

  .vshw-benefit-title {
    font-size: 0.9rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.4;
    margin: 0;
  }

  /* --- LUCRATIVE CTA BANNER (LIGHT THEME) --- */
  .vshw-cta-banner {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF9EF 50%, #F5FAF6 100%);
    border: 2px solid rgba(247, 148, 29, 0.4);
    border-top: 5px solid #F7941D;
    border-radius: 26px;
    padding: 32px 40px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 18px 45px rgba(247, 148, 29, 0.14), 0 4px 15px rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
  }
  @media (max-width: 868px) {
    .vshw-cta-banner {
      flex-direction: column;
      text-align: center;
      padding: 26px 20px;
    }
  }

  .vshw-cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #FFF3E0, #FFE5B4);
    border: 1px solid rgba(236, 92, 10, 0.35);
    color: #D96924;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.1);
  }

  .vshw-cta-text h3 {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(1.25rem, 2.6vw, 1.85rem);
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    line-height: 1.3;
  }
  .vshw-cta-text h3 .hl-orange {
    color: #ec5c0a;
  }
  .vshw-cta-text h3 .hl-green {
    color: #007b3e;
  }

  .vshw-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 36px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff9900 100%);
    color: #ffffff !important;
    font-size: 1.05rem;
    font-weight: 900;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .vshw-cta-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 16px 40px rgba(236, 92, 10, 0.5), 0 0 25px rgba(0, 123, 62, 0.25);
    background: linear-gradient(135deg, #ff9900 0%, #007b3e 100%);
  }

  /* --- BOTTOM TECH FOOTPRINT BAR (LIGHT THEME) --- */
  .vshw-tech-bar {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFFDF7 50%, #F8FFF6 100%);
    border: 2px solid rgba(247, 148, 29, 0.3);
    border-radius: 50px;
    padding: 16px 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #1e293b;
    box-shadow: 0 14px 35px rgba(247, 148, 29, 0.12);
  }
  @media (max-width: 768px) {
    .vshw-tech-bar {
      border-radius: 24px;
      flex-direction: column;
      text-align: center;
      justify-content: center;
      padding: 20px 16px;
    }
  }

  .vshw-tech-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 800;
    color: #1e293b;
  }
  .vshw-tech-item i {
    color: #ec5c0a;
    font-size: 1.2rem;
  }
  .vshw-tech-badge {
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    border: 1.5px solid rgba(247, 148, 29, 0.4);
    padding: 6px 16px;
    border-radius: 50px;
