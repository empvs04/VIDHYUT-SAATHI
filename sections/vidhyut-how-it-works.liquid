<!-- LIVE CANVAS VOLTAGE WAVEFORM ANIMATION SCRIPT -->
<script>
  (function() {
    function initVoltageGraphs() {
      const sectionId = "{{ section.id }}";
      const canvasBefore = document.getElementById('vshw-canvas-before-' + sectionId);
      const canvasAfter = document.getElementById('vshw-canvas-after-' + sectionId);
      const valBefore = document.getElementById('vshw-val-before-' + sectionId);
      const valAfter = document.getElementById('vshw-val-after-' + sectionId);

      if (!canvasBefore || !canvasAfter) return;

      const ctxBefore = canvasBefore.getContext('2d');
      const ctxAfter = canvasAfter.getContext('2d');

      function resizeCanvas(canvas) {
        canvas.width = canvas.parentElement.clientWidth;
        canvas.height = canvas.parentElement.clientHeight;
      }

      resizeCanvas(canvasBefore);
      resizeCanvas(canvasAfter);

      window.addEventListener('resize', () => {
        resizeCanvas(canvasBefore);
        resizeCanvas(canvasAfter);
      });

      let stepBefore = 0;
      let stepAfter = 0;

      function drawGrid(ctx, width, height) {
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = 0; x < width; x += 25) {
          ctx.moveTo(x, 0); ctx.lineTo(x, height);
        }
        for (let y = 0; y < height; y += 25) {
          ctx.moveTo(0, y); ctx.lineTo(width, y);
        }
        ctx.stroke();
      }

      // BEFORE GRAPH (Red Spiky Volatile Fluctuation)
      function animateBefore() {
        const w = canvasBefore.width;
        const h = canvasBefore.height;
        ctxBefore.clearRect(0, 0, w, h);

        drawGrid(ctxBefore, w, h);

        ctxBefore.beginPath();
        ctxBefore.strokeStyle = '#ef4444';
        ctxBefore.lineWidth = 2.5;
        ctxBefore.shadowColor = '#ef4444';
        ctxBefore.shadowBlur = 10;

        const midY = h / 2;
        stepBefore += 0.08;

        for (let x = 0; x < w; x++) {
          const noise = Math.sin(x * 0.08 + stepBefore) * 25 +
                        Math.cos(x * 0.15 - stepBefore * 1.5) * 18 +
                        (Math.random() - 0.5) * 14;
          const y = midY + noise;
          if (x === 0) ctxBefore.moveTo(x, y);
          else ctxBefore.lineTo(x, y);
        }
        ctxBefore.stroke();

        if (Math.random() < 0.15 && valBefore) {
          const v = Math.floor(255 + Math.random() * 32);
          valBefore.textContent = v + 'V (Spiking!)';
        }

        requestAnimationFrame(animateBefore);
      }

      // AFTER GRAPH (Green Smooth Sine Wave)
      function animateAfter() {
        const w = canvasAfter.width;
        const h = canvasAfter.height;
        ctxAfter.clearRect(0, 0, w, h);

        drawGrid(ctxAfter, w, h);

        ctxAfter.beginPath();
        ctxAfter.strokeStyle = '#10b981';
        ctxAfter.lineWidth = 2.5;
        ctxAfter.shadowColor = '#10b981';
        ctxAfter.shadowBlur = 10;

        const midY = h / 2;
        stepAfter += 0.04;

        for (let x = 0; x < w; x++) {
          const noise = Math.sin(x * 0.035 + stepAfter) * 10;
          const y = midY + noise;
          if (x === 0) ctxAfter.moveTo(x, y);
          else ctxAfter.lineTo(x, y);
        }
        ctxAfter.stroke();

        if (Math.random() < 0.1 && valAfter) {
          const v = Math.floor(222 + Math.random() * 6);
          valAfter.textContent = v + 'V (Stable)';
        }

        requestAnimationFrame(animateAfter);
      }

      animateBefore();
      animateAfter();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVoltageGraphs);
    } else {
      initVoltageGraphs();
    }
  })();
</script>

