<!-- LIVE OSCILLOSCOPE CANVAS ANIMATION SCRIPT -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    function initCanvasGraphs() {
      // 1. BEFORE CANVAS (RED erratic spikes)
      const cBefore = document.getElementById('vshw-canvas-before-{{ section.id }}');
      const valBefore = document.getElementById('vshw-val-before-{{ section.id }}');
      if (cBefore) {
        const ctxB = cBefore.getContext('2d');
        let stepB = 0;
        function drawBefore() {
          const w = cBefore.offsetWidth;
          const h = cBefore.offsetHeight;
          if (cBefore.width !== w) cBefore.width = w;
          if (cBefore.height !== h) cBefore.height = h;

          ctxB.clearRect(0, 0, w, h);

          // Grid lines
          ctxB.strokeStyle = 'rgba(239, 68, 68, 0.12)';
          ctxB.lineWidth = 1;
          for (let x = 0; x < w; x += 24) {
            ctxB.beginPath(); ctxB.moveTo(x, 0); ctxB.lineTo(x, h); ctxB.stroke();
          }
          for (let y = 0; y < h; y += 20) {
            ctxB.beginPath(); ctxB.moveTo(0, y); ctxB.lineTo(w, y); ctxB.stroke();
          }

          // Erratic waveform
          ctxB.beginPath();
          ctxB.strokeStyle = '#ef4444';
          ctxB.lineWidth = 2.5;
          ctxB.shadowColor = '#ef4444';
          ctxB.shadowBlur = 10;

          const midY = h / 2;
          for (let x = 0; x < w; x++) {
            const noise = (Math.sin((x + stepB) * 0.1) * 22) + (Math.sin((x - stepB) * 0.25) * 18) + ((Math.random() - 0.5) * 14);
            const y = midY + noise;
            if (x === 0) ctxB.moveTo(x, y);
            else ctxB.lineTo(x, y);
          }
          ctxB.stroke();

          // Live Voltage Reading (255V - 285V)
          if (valBefore && Math.random() < 0.08) {
            const randV = Math.floor(255 + Math.random() * 32);
            valBefore.textContent = randV + 'V (SPIKE)';
          }

          stepB += 4;
          requestAnimationFrame(drawBefore);
        }
        drawBefore();
      }

      // 2. AFTER CANVAS (GREEN smooth wave)
      const cAfter = document.getElementById('vshw-canvas-after-{{ section.id }}');
      const valAfter = document.getElementById('vshw-val-after-{{ section.id }}');
      if (cAfter) {
        const ctxA = cAfter.getContext('2d');
        let stepA = 0;
        function drawAfter() {
          const w = cAfter.offsetWidth;
          const h = cAfter.offsetHeight;
          if (cAfter.width !== w) cAfter.width = w;
          if (cAfter.height !== h) cAfter.height = h;

          ctxA.clearRect(0, 0, w, h);

          // Grid lines
          ctxA.strokeStyle = 'rgba(16, 185, 129, 0.12)';
          ctxA.lineWidth = 1;
          for (let x = 0; x < w; x += 24) {
            ctxA.beginPath(); ctxA.moveTo(x, 0); ctxA.lineTo(x, h); ctxA.stroke();
          }
          for (let y = 0; y < h; y += 20) {
            ctxA.beginPath(); ctxA.moveTo(0, y); ctxA.lineTo(w, y); ctxA.stroke();
          }

          // Smooth sine wave
          ctxA.beginPath();
          ctxA.strokeStyle = '#10b981';
          ctxA.lineWidth = 2.5;
          ctxA.shadowColor = '#10b981';
          ctxA.shadowBlur = 10;

          const midY = h / 2;
          for (let x = 0; x < w; x++) {
            const y = midY + Math.sin((x + stepA) * 0.04) * 10;
            if (x === 0) ctxA.moveTo(x, y);
            else ctxA.lineTo(x, y);
          }
          ctxA.stroke();

          // Live Voltage Reading (220V - 225V)
          if (valAfter && Math.random() < 0.05) {
            const randV = Math.floor(220 + Math.random() * 6);
            valAfter.textContent = randV + 'V (STABLE)';
          }

          stepA += 2.5;
          requestAnimationFrame(drawAfter);
        }
        drawAfter();
      }
    }

    initCanvasGraphs();
  });
</script>

