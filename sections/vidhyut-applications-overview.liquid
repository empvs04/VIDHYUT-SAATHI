<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">

<style>
  .vs-apps-sec-{{ section.id }} {
    --ink: {{ section.settings.text_color | default: "#1A1210" }};
    --white: #FFFFFF;
    --orange-50: #FFF6EE;
    --orange-100: #FFE6D0;
    --saffron: {{ section.settings.accent_color | default: "#FF7A1A" }};
    --saffron-glow: rgba(255, 122, 26, 0.35);
    --leaf: #0F8B3D;
    --gold: #D4900F;
    --line: rgba(42, 33, 24, 0.08);

    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink) !important;
    background: radial-gradient(circle at 12% 18%, rgba(255, 244, 235, 0.95) 0%, #FFFFFF 48%),
                radial-gradient(circle at 88% 82%, rgba(255, 230, 208, 0.55) 0%, transparent 60%),
                linear-gradient(180deg, #FFFFFF 0%, #FFF9F4 100%) !important;
    padding: {{ section.settings.padding_top_desk | default: 70 }}px 20px {{ section.settings.padding_bottom_desk | default: 70 }}px 20px !important;
    position: relative !important;
    overflow: hidden !important;
    margin: 0 auto !important;
    box-sizing: border-box !important;
  }

  .vs-apps-sec-{{ section.id }} *,
  .vs-apps-sec-{{ section.id }} *::before,
  .vs-apps-sec-{{ section.id }} *::after {
    box-sizing: border-box !important;
    margin: 0;
    padding: 0;
  }

  /* ── EQUAL 1200PX CENTERED CONTAINER MATCHING SECTION 21 ── */
  .vs-apps-sec-{{ section.id }} .container {
    max-width: 1200px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    position: relative !important;
    z-index: 2 !important;
  }

  /* Decorative Ambient Glows */
  .vs-apps-sec-{{ section.id }} .ambient-glow-left {
    position: absolute;
    top: 5%;
    left: -100px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 122, 26, 0.14), transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .vs-apps-sec-{{ section.id }} .ambient-glow-right {
    position: absolute;
    bottom: 5%;
    right: -80px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 144, 15, 0.12), transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* ---------- SECTION HEADER (SINGLE LINE ON DESKTOP) ---------- */
  .vs-apps-sec-{{ section.id }} .section-head {
    text-align: center;
    max-width: 1200px !important;
    margin: 0 auto 46px auto !important;
  }

  .vs-apps-sec-{{ section.id }} .top-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--orange-100);
    border-radius: 999px;
    padding: 7px 22px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    box-shadow: 0 10px 24px -10px rgba(42, 33, 24, 0.2), 0 0 0 1px rgba(255, 122, 26, 0.12);
    margin-bottom: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .vs-apps-sec-{{ section.id }} .top-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgba(15, 139, 61, 0.25);
    animation: vsDotPulse 2s infinite ease-in-out;
  }

  @keyframes vsDotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.7; }
  }

  .vs-apps-sec-{{ section.id }} .kicker {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.14em;
    color: var(--saffron);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .vs-apps-sec-{{ section.id }} .section-title {
    font-family: 'Baloo 2', sans-serif !important;
    font-weight: 800 !important;
    font-size: clamp(26px, 2.7vw, 40px) !important;
    letter-spacing: -0.01em !important;
    line-height: 1.18 !important;
    color: var(--ink) !important;
    white-space: nowrap !important; /* Single line on desktop */
  }

  .vs-apps-sec-{{ section.id }} .section-title .accent {
    font-family: 'Baloo 2', sans-serif !important;
    background: linear-gradient(105deg, var(--saffron) 0%, #FF9636 50%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--saffron);
    display: inline-block;
  }

  .vs-apps-sec-{{ section.id }} .content {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 40px !important;
    align-items: stretch !important;
  }

  .vs-apps-sec-{{ section.id }} .cards-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    grid-template-rows: repeat(2, 1fr) !important;
    gap: 16px !important;
    height: 100% !important;
    margin-top: 0 !important;
  }

  .vs-apps-sec-{{ section.id }} .app-card {
    position: relative !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    box-shadow: 0 14px 32px -10px rgba(42, 33, 24, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.06) !important;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease !important;
    user-select: none !important;
    background-color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 190px !important;
    aspect-ratio: 4 / 3 !important;
  }

  .vs-apps-sec-{{ section.id }} .app-card:hover {
    transform: translateY(-6px) scale(1.02) !important;
    box-shadow: 0 24px 50px -12px rgba(255, 122, 26, 0.35), 0 0 0 2px rgba(255, 122, 26, 0.5) !important;
  }

  .vs-apps-sec-{{ section.id }} .app-card-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    border-radius: 18px !important;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
  }

  .vs-apps-sec-{{ section.id }} .app-card:hover .app-card-img {
    transform: scale(1.04) !important;
  }

  .vs-apps-sec-{{ section.id }} .card-placeholder {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
    text-align: center !important;
    border-radius: 18px !important;
  }

  .vs-apps-sec-{{ section.id }} .card-placeholder.residential {
    background: linear-gradient(145deg, #FFF4EB 0%, #FFE5D1 100%);
    color: #c84900;
  }
  .vs-apps-sec-{{ section.id }} .card-placeholder.commercial {
    background: linear-gradient(145deg, #F0FBF4 0%, #D7F3E2 100%);
    color: #007b3e;
  }
  .vs-apps-sec-{{ section.id }} .card-placeholder.industrial {
    background: linear-gradient(145deg, #F0F8FF 0%, #D8EDFE 100%);
    color: #0284c7;
  }
  .vs-apps-sec-{{ section.id }} .card-placeholder.institutional {
    background: linear-gradient(145deg, #FEFCE8 0%, #FEF08A 100%);
    color: #b45309;
  }

  .vs-apps-sec-{{ section.id }} .placeholder-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vs-apps-sec-{{ section.id }} .right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    margin-top: 0;
    padding-top: 0;
  }

  .vs-apps-sec-{{ section.id }} .right h2 {
    font-family: 'Baloo 2', sans-serif !important;
    font-weight: 800 !important;
    font-size: 34px !important;
    line-height: 1.2 !important;
    letter-spacing: -0.01em !important;
    color: var(--ink) !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
  }

  .vs-apps-sec-{{ section.id }} .right h2 .accent {
    font-family: 'Baloo 2', sans-serif !important;
    color: var(--saffron);
    background: linear-gradient(105deg, var(--saffron), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline;
  }

  .vs-apps-sec-{{ section.id }} .checklist {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: 13px;
  }

  .vs-apps-sec-{{ section.id }} .check-item {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    background: #ffffff;
    border-radius: 18px;
    padding: 13px 20px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
  }

  .vs-apps-sec-{{ section.id }} .check-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    border-radius: 4px 0 0 4px;
    transition: width 0.3s ease;
  }

  .vs-apps-sec-{{ section.id }} .check-item:hover {
    transform: translateX(8px) translateY(-2px);
  }

  .vs-apps-sec-{{ section.id }} .check-item:hover::before {
    width: 7px;
  }

  .vs-apps-sec-{{ section.id }} .check-circle {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    flex-shrink: 0;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .vs-apps-sec-{{ section.id }} .check-item:hover .check-circle {
    transform: scale(1.1) rotate(6deg);
  }

  .vs-apps-sec-{{ section.id }} .check-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vs-apps-sec-{{ section.id }} .check-item p {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
  }

  .vs-apps-sec-{{ section.id }} .check-item p strong {
    font-weight: 800;
  }

  .vs-apps-sec-{{ section.id }} .check-item.theme-res {
    background: linear-gradient(135deg, #ffffff 0%, #fffaf5 55%, #ffefe5 100%) !important;
    border: 1.5px solid rgba(236, 92, 10, 0.3) !important;
    box-shadow: 0 12px 28px -14px rgba(236, 92, 10, 0.2) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-res::before {
    background: linear-gradient(180deg, #ec5c0a, #ff7b00) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-res .check-circle {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%) !important;
    box-shadow: 0 8px 18px -4px rgba(236, 92, 10, 0.65), inset 0 1px 2px rgba(255, 255, 255, 0.4) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-res p strong {
    color: #c84900 !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-res:hover {
    box-shadow: 0 22px 42px -12px rgba(236, 92, 10, 0.32), 0 0 0 1.5px rgba(236, 92, 10, 0.45) !important;
  }

  .vs-apps-sec-{{ section.id }} .check-item.theme-com {
    background: linear-gradient(135deg, #ffffff 0%, #f6fbf8 55%, #e6f4ec 100%) !important;
    border: 1.5px solid rgba(0, 135, 68, 0.3) !important;
    box-shadow: 0 12px 28px -14px rgba(0, 135, 68, 0.2) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-com::before {
    background: linear-gradient(180deg, #008744, #00b050) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-com .check-circle {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%) !important;
    box-shadow: 0 8px 18px -4px rgba(0, 135, 68, 0.65), inset 0 1px 2px rgba(255, 255, 255, 0.4) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-com p strong {
    color: #007b3e !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-com:hover {
    box-shadow: 0 22px 42px -12px rgba(0, 135, 68, 0.32), 0 0 0 1.5px rgba(0, 135, 68, 0.45) !important;
  }

  .vs-apps-sec-{{ section.id }} .check-item.theme-ind {
    background: linear-gradient(135deg, #ffffff 0%, #f5faff 55%, #e0f2fe 100%) !important;
    border: 1.5px solid rgba(2, 132, 199, 0.3) !important;
    box-shadow: 0 12px 28px -14px rgba(2, 132, 199, 0.2) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ind::before {
    background: linear-gradient(180deg, #0284c7, #0369a1) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ind .check-circle {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
    box-shadow: 0 8px 18px -4px rgba(2, 132, 199, 0.65), inset 0 1px 2px rgba(255, 255, 255, 0.4) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ind p strong {
    color: #0284c7 !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ind:hover {
    box-shadow: 0 22px 42px -12px rgba(2, 132, 199, 0.32), 0 0 0 1.5px rgba(2, 132, 199, 0.45) !important;
  }

  .vs-apps-sec-{{ section.id }} .check-item.theme-ins {
    background: linear-gradient(135deg, #ffffff 0%, #fffef8 55%, #fef9c3 100%) !important;
    border: 1.5px solid rgba(217, 119, 6, 0.3) !important;
    box-shadow: 0 12px 28px -14px rgba(217, 119, 6, 0.2) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ins::before {
    background: linear-gradient(180deg, #d97706, #f59e0b) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ins .check-circle {
    background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%) !important;
    box-shadow: 0 8px 18px -4px rgba(217, 119, 6, 0.65), inset 0 1px 2px rgba(255, 255, 255, 0.4) !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ins p strong {
    color: #b45309 !important;
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ins:hover {
    box-shadow: 0 22px 42px -12px rgba(217, 119, 6, 0.32), 0 0 0 1.5px rgba(217, 119, 6, 0.45) !important;
  }

  @media (max-width: 1024px) {
    .vs-apps-sec-{{ section.id }} {
      padding: {{ section.settings.padding_top_mob | default: 50 }}px 20px {{ section.settings.padding_bottom_mob | default: 50 }}px 20px !important;
    }
    .vs-apps-sec-{{ section.id }} .section-title {
      white-space: normal !important;
      font-size: 32px !important;
    }
    .vs-apps-sec-{{ section.id }} .content {
      grid-template-columns: 1fr !important;
      gap: 36px !important;
    }
    .vs-apps-sec-{{ section.id }} .right {
      height: auto !important;
    }
    .vs-apps-sec-{{ section.id }} .checklist {
      gap: 13px !important;
      margin-top: 20px !important;
    }
    .vs-apps-sec-{{ section.id }} .check-item {
      padding: 14px 18px !important;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: 28px !important;
      text-align: center !important;
    }
    .vs-apps-sec-{{ section.id }} .section-head {
      margin-bottom: 32px !important;
    }
  }

  @media (max-width: 768px) {
    .vs-apps-sec-{{ section.id }} {
      padding: {{ section.settings.padding_top_mob | default: 36 }}px 14px {{ section.settings.padding_bottom_mob | default: 36 }}px 14px !important;
    }
    .vs-apps-sec-{{ section.id }} .container {
      padding-left: 0 !important;
      padding-right: 0 !important;
      max-width: 100% !important;
    }
    .vs-apps-sec-{{ section.id }} .cards-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      grid-template-rows: repeat(2, 1fr) !important;
      gap: 10px !important;
      height: auto !important;
    }
    .vs-apps-sec-{{ section.id }} .app-card {
      aspect-ratio: 4 / 3 !important;
      border-radius: 14px !important;
      min-height: 130px !important;
      box-shadow: 0 10px 24px -8px rgba(42, 33, 24, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.04) !important;
    }
    .vs-apps-sec-{{ section.id }} .app-card-img {
      border-radius: 14px !important;
    }
    .vs-apps-sec-{{ section.id }} .right {
      margin-top: 6px !important;
      height: auto !important;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: clamp(21px, 5.5vw, 25px) !important;
      text-align: center !important;
      line-height: 1.25 !important;
      margin-bottom: 16px !important;
    }
  }

  @media (max-width: 480px) {
    .vs-apps-sec-{{ section.id }} .cards-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 8px !important;
    }
    .vs-apps-sec-{{ section.id }} .app-card {
      aspect-ratio: 4 / 3 !important;
      border-radius: 12px !important;
      min-height: 110px !important;
    }
    .vs-apps-sec-{{ section.id }} .app-card-img {
      border-radius: 12px !important;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: 20px !important;
      margin-bottom: 14px !important;
    }
  }
</style>

<div class="vs-apps-sec-{{ section.id }}">
  <div class="ambient-glow-left"></div>
  <div class="ambient-glow-right"></div>

  <div class="container">
    <div class="section-head">
      {% if section.settings.badge_text != blank %}
        <div class="top-badge">
          <span class="dot"></span>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.kicker_text != blank %}
        <div class="kicker">{{ section.settings.kicker_text }}</div>
      {% endif %}

      <h2 class="section-title">
        {{ section.settings.heading_prefix | default: "One Solution for Every" }}
        <span class="accent">{{ section.settings.heading_accent | default: "Power-Consuming Sector." }}</span>
      </h2>
    </div>

    <div class="content">
      <div class="cards-grid">
        {% assign sector_cards = section.blocks | where: "type", "sector_card" %}
        {% if sector_cards.size > 0 %}
          {% for block in sector_cards %}
            {% assign card_idx = forloop.index %}
            {% assign custom_img = block.settings.card_image %}
            {% if custom_img == blank %}
              {% if card_idx == 1 and section.settings.card1_image != blank %}
                {% assign custom_img = section.settings.card1_image %}
              {% elsif card_idx == 2 and section.settings.card2_image != blank %}
                {% assign custom_img = section.settings.card2_image %}
              {% elsif card_idx == 3 and section.settings.card3_image != blank %}
                {% assign custom_img = section.settings.card3_image %}
              {% elsif card_idx == 4 and section.settings.card4_image != blank %}
                {% assign custom_img = section.settings.card4_image %}
              {% endif %}
            {% endif %}

            <div class="app-card" {{ block.shopify_attributes }}>
              {% if custom_img != blank %}
                <img 
                  class="app-card-img"
                  src="{{ custom_img | image_url: width: 1000 }}" 
                  alt="{{ block.settings.title | default: 'Sector Card' | escape }}" 
                  loading="lazy"
                >
              {% else %}
                <div class="card-placeholder {{ block.settings.card_theme | default: 'residential' }}">
                  <span class="placeholder-title">{{ block.settings.title | default: "Sector Application" }}</span>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <div class="app-card">
            {% if section.settings.card1_image != blank %}
              <img class="app-card-img" src="{{ section.settings.card1_image | image_url: width: 1000 }}" alt="Residential Use" loading="lazy">
            {% else %}
              <div class="card-placeholder residential"><span class="placeholder-title">Residential Use</span></div>
            {% endif %}
          </div>
          <div class="app-card">
            {% if section.settings.card2_image != blank %}
              <img class="app-card-img" src="{{ section.settings.card2_image | image_url: width: 1000 }}" alt="Commercial Use" loading="lazy">
            {% else %}
              <div class="card-placeholder commercial"><span class="placeholder-title">Commercial Use</span></div>
            {% endif %}
          </div>
          <div class="app-card">
            {% if section.settings.card3_image != blank %}
              <img class="app-card-img" src="{{ section.settings.card3_image | image_url: width: 1000 }}" alt="Industrial Use" loading="lazy">
            {% else %}
              <div class="card-placeholder industrial"><span class="placeholder-title">Industrial Use</span></div>
            {% endif %}
          </div>
          <div class="app-card">
            {% if section.settings.card4_image != blank %}
              <img class="app-card-img" src="{{ section.settings.card4_image | image_url: width: 1000 }}" alt="Institutional Use" loading="lazy">
            {% else %}
              <div class="card-placeholder institutional"><span class="placeholder-title">Institutional Use</span></div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="right">
        <h2>
          {{ section.settings.right_heading_prefix | default: "WHEREVER ELECTRICITY LIVES," }}
          <span class="accent">{{ section.settings.right_heading_accent | default: "VIDHYUT SAATHI BELONGS." }}</span>
        </h2>

        <div class="checklist">
          {% assign check_items = section.blocks | where: "type", "checklist_item" %}
          {% if check_items.size > 0 %}
            {% for block in check_items %}
              {% assign s_name = block.settings.sector_name | downcase %}
              {% if s_name contains 'com' %}
                {% assign card_theme = 'com' %}
              {% elsif s_name contains 'ind' %}
                {% assign card_theme = 'ind' %}
              {% elsif s_name contains 'ins' %}
                {% assign card_theme = 'ins' %}
              {% elsif s_name contains 'res' %}
                {% assign card_theme = 'res' %}
              {% elsif block.settings.theme_color != blank and block.settings.theme_color != 'res' %}
                {% assign card_theme = block.settings.theme_color %}
              {% else %}
                {% case forloop.index %}
                  {% when 2 %}
                    {% assign card_theme = 'com' %}
                  {% when 3 %}
                    {% assign card_theme = 'ind' %}
                  {% when 4 %}
                    {% assign card_theme = 'ins' %}
                  {% else %}
                    {% assign card_theme = 'res' %}
                {% endcase %}
              {% endif %}

              <div class="check-item theme-{{ card_theme }}" {{ block.shopify_attributes }}>
                <div class="check-circle">{{ block.settings.check_icon | default: "✓" }}</div>
                <div class="check-text-wrap">
                  <p><strong>{{ block.settings.sector_name }}{% unless block.settings.sector_name contains '—' or block.settings.sector_name contains ':' %} —{% endunless %}</strong> {{ block.settings.sector_text }}</p>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Residential Card -->
            <div class="check-item theme-res">
              <div class="check-circle">✓</div>
              <div class="check-text-wrap">
                <p><strong>🏠 RESIDENTIAL —</strong> Lower electricity bills, reduce power wastage & protect your valuable home appliances from voltage fluctuations.</p>
              </div>
            </div>

            <!-- Commercial Card -->
            <div class="check-item theme-com">
              <div class="check-circle">✓</div>
              <div class="check-text-wrap">
                <p><strong>🏢 COMMERCIAL —</strong> Reduce electricity expenses, minimize power losses in shops, offices, malls, hotels and commercial spaces.</p>
              </div>
            </div>

            <!-- Industrial Card -->
            <div class="check-item theme-ind">
              <div class="check-circle">✓</div>
              <div class="check-text-wrap">
                <p><strong>🏭 INDUSTRIAL —</strong> Built for heavy motor loads, helping improve power efficiency & drive greater savings across factories and plants.</p>
              </div>
            </div>

            <!-- Institutional Card -->
            <div class="check-item theme-ins">
              <div class="check-circle">✓</div>
              <div class="check-text-wrap">
                <p><strong>🏫 INSTITUTIONAL —</strong> Smarter power management, improved efficiency & enhanced electrical safety for schools, hospitals and institutions.</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</div>

