<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">

<style>
  .vs-apps-sec-{{ section.id }} {
    --ink: {{ section.settings.text_color | default: "#2A2118" }};
    --white: #FFFFFF;
    --orange-50: #FFF4EB;
    --orange-100: #FFE4CC;
    --saffron: {{ section.settings.accent_color | default: "#FF7A1A" }};
    --leaf: #0F8B3D;
    --gold: #D4900F;
    --line: rgba(42, 33, 24, 0.1);

    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF4EB 55%, #FFE4CC 100%);
    padding: {{ section.settings.padding_top_desk | default: 80 }}px 24px {{ section.settings.padding_bottom_desk | default: 80 }}px 24px;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .vs-apps-sec-{{ section.id }} *,
  .vs-apps-sec-{{ section.id }} *::before,
  .vs-apps-sec-{{ section.id }} *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .vs-apps-sec-{{ section.id }} .container {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* ---------- SECTION HEADER ---------- */
  .vs-apps-sec-{{ section.id }} .section-head {
    text-align: center;
    margin-bottom: 50px;
  }

  .vs-apps-sec-{{ section.id }} .top-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--white);
    border-radius: 999px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    box-shadow: 0 10px 22px -10px rgba(42,33,24,0.25), 0 0 0 1px var(--orange-100);
    margin-bottom: 16px;
  }

  .vs-apps-sec-{{ section.id }} .top-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgba(15, 139, 61, 0.2);
    animation: vsPulseDot 2s infinite ease-in-out;
  }

  @keyframes vsPulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  .vs-apps-sec-{{ section.id }} .kicker {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--saffron);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .vs-apps-sec-{{ section.id }} .section-title {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
  }

  .vs-apps-sec-{{ section.id }} .section-title .accent {
    background: linear-gradient(100deg, var(--saffron), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--saffron);
  }

  /* ---------- MAIN CONTENT LAYOUT ---------- */
  .vs-apps-sec-{{ section.id }} .content {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  /* ---------- LEFT: CARD GRID ---------- */
  .vs-apps-sec-{{ section.id }} .cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .vs-apps-sec-{{ section.id }} .app-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 3.25;
    box-shadow: 0 24px 44px -18px rgba(42,33,24,0.35), 0 0 0 1px rgba(255,255,255,0.6);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease;
    user-select: none;
  }

  .vs-apps-sec-{{ section.id }} .app-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 32px 55px -16px rgba(42,33,24,0.42), 0 0 0 1.5px rgba(255, 122, 26, 0.4);
  }

  .vs-apps-sec-{{ section.id }} .app-card.popular {
    box-shadow: 0 24px 44px -18px rgba(255,122,26,0.45), 0 0 0 2px var(--saffron);
  }

  .vs-apps-sec-{{ section.id }} .app-card.popular:hover {
    box-shadow: 0 32px 55px -16px rgba(255,122,26,0.55), 0 0 0 2.5px var(--saffron);
  }

  .vs-apps-sec-{{ section.id }} .ribbon {
    position: absolute;
    top: 15px;
    right: -36px;
    width: 145px;
    transform: rotate(40deg);
    background: linear-gradient(100deg, var(--saffron), var(--gold));
    color: var(--white);
    font-family: 'Sora', sans-serif;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 4px 0;
    z-index: 4;
    box-shadow: 0 4px 12px -3px rgba(255,122,26,0.6);
  }

  .vs-apps-sec-{{ section.id }} .card-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .vs-apps-sec-{{ section.id }} .card-bg.residential {
    background: linear-gradient(150deg, #4A3A2E 0%, #2A2118 70%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.commercial {
    background: linear-gradient(150deg, #1E2A38 0%, #12181F 70%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.industrial {
    background: linear-gradient(150deg, #3A2418 0%, #1A1210 70%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.institutional {
    background: linear-gradient(150deg, #223A2E 0%, #101B15 70%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.15) 55%, transparent 75%);
  }

  .vs-apps-sec-{{ section.id }} .icon-motif {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    opacity: 0.85;
    z-index: 2;
    pointer-events: none;
  }

  .vs-apps-sec-{{ section.id }} .use-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--saffron);
    z-index: 3;
    text-transform: uppercase;
  }

  .vs-apps-sec-{{ section.id }} .card-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    z-index: 3;
  }

  .vs-apps-sec-{{ section.id }} .card-tagline {
    color: rgba(255, 255, 255, 0.92);
    font-size: 12px;
    font-weight: 500;
    max-width: 62%;
    margin-top: 22px;
    line-height: 1.35;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }

  .vs-apps-sec-{{ section.id }} .card-bottom {
    display: flex;
    flex-direction: column;
  }

  .vs-apps-sec-{{ section.id }} .card-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(100deg, var(--leaf), #1BA852);
    color: var(--white);
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 9.5px;
    padding: 5px 11px;
    border-radius: 999px;
    margin-bottom: 7px;
    width: fit-content;
    box-shadow: 0 4px 10px -3px rgba(15,139,61,0.6);
  }

  .vs-apps-sec-{{ section.id }} .card-chip .bolt {
    font-size: 10px;
  }

  .vs-apps-sec-{{ section.id }} .card-title {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: var(--white);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .vs-apps-sec-{{ section.id }} .card-benefits {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255,255,255,0.18);
  }

  .vs-apps-sec-{{ section.id }} .card-benefits .b {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 8.5px;
    color: rgba(255,255,255,0.85);
    text-align: center;
    line-height: 1.2;
    flex: 1;
  }

  .vs-apps-sec-{{ section.id }} .card-benefits .b .ic {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255,255,255,0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
  }

  /* ---------- RIGHT: HEADING + CHECKLIST ---------- */
  .vs-apps-sec-{{ section.id }} .right {
    display: flex;
    flex-direction: column;
  }

  .vs-apps-sec-{{ section.id }} .right h2 {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 32px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .vs-apps-sec-{{ section.id }} .right h2 .accent {
    color: var(--saffron);
  }

  .vs-apps-sec-{{ section.id }} .checklist {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vs-apps-sec-{{ section.id }} .check-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--white);
    border-left: 4px solid var(--saffron);
    border-radius: 14px;
    padding: 18px 20px;
    box-shadow: 0 16px 32px -16px rgba(42,33,24,0.25), 0 0 0 1px var(--orange-100);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .vs-apps-sec-{{ section.id }} .check-item:hover {
    transform: translateX(4px);
    box-shadow: 0 20px 38px -14px rgba(42,33,24,0.3), 0 0 0 1px var(--saffron);
  }

  .vs-apps-sec-{{ section.id }} .check-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(150deg, #FF9142, var(--saffron));
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 8px 18px -6px rgba(255,122,26,0.6);
  }

  .vs-apps-sec-{{ section.id }} .check-item p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }

  .vs-apps-sec-{{ section.id }} .check-item p strong {
    font-weight: 700;
    color: var(--ink);
  }

  /* ---------- RESPONSIVE BREAKPOINTS ---------- */
  @media (max-width: 1024px) {
    .vs-apps-sec-{{ section.id }} {
      padding: {{ section.settings.padding_top_mob | default: 56 }}px 20px {{ section.settings.padding_bottom_mob | default: 56 }}px 20px;
    }
    .vs-apps-sec-{{ section.id }} .content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: 28px;
      text-align: center;
    }
    .vs-apps-sec-{{ section.id }} .section-head {
      margin-bottom: 36px;
    }
    .vs-apps-sec-{{ section.id }} .section-title {
      font-size: 28px;
    }
    .vs-apps-sec-{{ section.id }} .right {
      align-items: center;
    }
    .vs-apps-sec-{{ section.id }} .checklist {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .vs-apps-sec-{{ section.id }} .cards-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .vs-apps-sec-{{ section.id }} .app-card {
      aspect-ratio: 16 / 11;
    }
    .vs-apps-sec-{{ section.id }} .kicker {
      font-size: 12px;
    }
    .vs-apps-sec-{{ section.id }} .section-title {
      font-size: 24px;
    }
    .vs-apps-sec-{{ section.id }} .top-badge {
      font-size: 11.5px;
      padding: 7px 14px;
    }
    .vs-apps-sec-{{ section.id }} .check-item {
      padding: 15px;
      gap: 12px;
    }
    .vs-apps-sec-{{ section.id }} .check-item p {
      font-size: 13.5px;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: 24px;
    }
  }
</style>

<div class="vs-apps-sec-{{ section.id }}">
  <div class="container">

    <!-- SECTION HEADER -->
    <div class="section-head">
      {% if section.settings.badge_text != blank %}
        <div class="top-badge">
          <span class="dot"></span>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.kicker_text != blank %}
        <div class="kicker">{{ section.settings.kicker_text }}</div>
      {% endif %}

      <h2 class="section-title">
        {{ section.settings.heading_prefix | default: "Built for Every" }}
        <span class="accent">{{ section.settings.heading_accent | default: "Sector's Energy Needs" }}</span>
      </h2>
    </div>

    <!-- MAIN GRID CONTENT -->
    <div class="content">

      <!-- LEFT: 4 SECTOR CARDS -->
      <div class="cards-grid">

        <!-- 1. Residential -->
        <div class="app-card popular">
          <div class="ribbon">MOST POPULAR</div>
          <div class="card-bg residential"></div>
          <svg class="icon-motif" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg">
            <path d="M100 25 L170 80 L160 80 L160 140 L40 140 L40 80 L30 80 Z" fill="rgba(255,255,255,0.08)"/>
            <rect x="90" y="105" width="20" height="35" fill="rgba(255,255,255,0.1)"/>
            <rect x="55" y="95" width="18" height="18" fill="rgba(255,255,255,0.08)"/>
            <rect x="127" y="95" width="18" height="18" fill="rgba(255,255,255,0.08)"/>
          </svg>
          <div class="use-tag">USE</div>
          <div class="card-inner">
            <p class="card-tagline">Smart Saving for Every Home</p>
            <div class="card-bottom">
              <div class="card-chip"><span class="bolt">⚡</span>EVERY 6 KW REQUIRED 1 CARD</div>
              <div class="card-title">RESIDENTIAL USE</div>
              <div class="card-benefits">
                <div class="b"><span class="ic">💡</span>Save 25% Electricity Bill</div>
                <div class="b"><span class="ic">🛡️</span>Voltage Protection</div>
                <div class="b"><span class="ic">✓</span>Guaranteed Results</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Commercial -->
        <div class="app-card">
          <div class="card-bg commercial"></div>
          <svg class="icon-motif" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg">
            <rect x="60" y="20" width="80" height="120" fill="rgba(255,255,255,0.08)"/>
            <rect x="72" y="34" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="93" y="34" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="114" y="34" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="72" y="56" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="93" y="56" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="114" y="56" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="72" y="78" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="93" y="78" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
            <rect x="114" y="78" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
          </svg>
          <div class="use-tag">USE</div>
          <div class="card-inner">
            <p class="card-tagline">Smart Energy for Smart Business</p>
            <div class="card-bottom">
              <div class="card-chip"><span class="bolt">⚡</span>EVERY 6 KW REQUIRED 1 CARD</div>
              <div class="card-title">COMMERCIAL USE</div>
              <div class="card-benefits">
                <div class="b"><span class="ic">📉</span>Save kVAh Penalty</div>
                <div class="b"><span class="ic">🔌</span>Stable Supply</div>
                <div class="b"><span class="ic">🛠️</span>Control Leakage Current</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Industrial -->
        <div class="app-card">
          <div class="card-bg industrial"></div>
          <svg class="icon-motif" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg">
            <rect x="40" y="80" width="120" height="60" fill="rgba(255,255,255,0.08)"/>
            <rect x="55" y="45" width="16" height="35" fill="rgba(255,255,255,0.1)"/>
            <rect x="90" y="35" width="16" height="45" fill="rgba(255,255,255,0.1)"/>
            <rect x="125" y="50" width="16" height="30" fill="rgba(255,255,255,0.1)"/>
            <circle cx="63" cy="40" r="6" fill="rgba(255,255,255,0.15)"/>
            <circle cx="98" cy="30" r="6" fill="rgba(255,255,255,0.15)"/>
          </svg>
          <div class="use-tag">USE</div>
          <div class="card-inner">
            <p class="card-tagline">Maximum Power, Maximum Savings</p>
            <div class="card-bottom">
              <div class="card-chip"><span class="bolt">⚡</span>EVERY 6 KW REQUIRED 1 CARD</div>
              <div class="card-title">INDUSTRIAL USE</div>
              <div class="card-benefits">
                <div class="b"><span class="ic">📊</span>Save 20% Electricity Bill</div>
                <div class="b"><span class="ic">⚙️</span>Handles Heavy Loads</div>
                <div class="b"><span class="ic">🔋</span>Reduces Line Losses</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Institutional -->
        <div class="app-card">
          <div class="card-bg institutional"></div>
          <svg class="icon-motif" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg">
            <rect x="50" y="60" width="100" height="80" fill="rgba(255,255,255,0.08)"/>
            <polygon points="45,60 100,25 155,60" fill="rgba(255,255,255,0.1)"/>
            <rect x="68" y="80" width="12" height="30" fill="rgba(255,255,255,0.12)"/>
            <rect x="94" y="80" width="12" height="30" fill="rgba(255,255,255,0.12)"/>
            <rect x="120" y="80" width="12" height="30" fill="rgba(255,255,255,0.12)"/>
          </svg>
          <div class="use-tag">USE</div>
          <div class="card-inner">
            <p class="card-tagline">Reliable Power for a Better Tomorrow</p>
            <div class="card-bottom">
              <div class="card-chip"><span class="bolt">⚡</span>EVERY 6 KW REQUIRED 1 CARD</div>
              <div class="card-title">INSTITUTIONAL USE</div>
              <div class="card-benefits">
                <div class="b"><span class="ic">🏫</span>Save 22% Electricity Bill</div>
                <div class="b"><span class="ic">⚡</span>Stable Power Supply</div>
                <div class="b"><span class="ic">🛡️</span>Safer Performance</div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT: CHECKLIST -->
      <div class="right">
        <h2>
          {{ section.settings.right_heading_prefix | default: "Smart Energy Solutions Tailored for" }}
          <span class="accent">{{ section.settings.right_heading_accent | default: "Every Sector" }}</span>
        </h2>

        <div class="checklist">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="check-item" {{ block.shopify_attributes }}>
                <div class="check-circle">{{ block.settings.check_icon | default: "✓" }}</div>
                <p><strong>{{ block.settings.sector_name }}:</strong> {{ block.settings.sector_text }}</p>
              </div>
            {% endfor %}
          {% else %}
            <div class="check-item">
              <div class="check-circle">✓</div>
              <p><strong>Residential:</strong> Lowers home electricity bills & protects appliances from voltage spikes.</p>
            </div>
            <div class="check-item">
              <div class="check-circle">✓</div>
              <p><strong>Commercial:</strong> Reduces kVAh billing penalty & extends commercial equipment lifespan.</p>
            </div>
            <div class="check-item">
              <div class="check-circle">✓</div>
              <p><strong>Industrial:</strong> Handles heavy motor loads, cutting line losses in factories & plants.</p>
            </div>
            <div class="check-item">
              <div class="check-circle">✓</div>
              <p><strong>Institutional:</strong> Zero energy leakage & maximum safety for schools & hospitals.</p>
            </div>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Vidhyut Apps Overview",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "Trusted by 5,000+ installations across India"
    },
    {
      "type": "text",
      "id": "kicker_text",
      "label": "Kicker Text",
      "default": "APPLICATIONS OVERVIEW"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Section Heading Prefix",
      "default": "Built for Every"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Section Heading Accent",
      "default": "Sector's Energy Needs"
    },
    {
      "type": "text",
      "id": "right_heading_prefix",
      "label": "Right Heading Prefix",
      "default": "Smart Energy Solutions Tailored for"
    },
    {
      "type": "text",
      "id": "right_heading_accent",
      "label": "Right Heading Accent",
      "default": "Every Sector"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FF7A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A2118"
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "min": 20,
      "max": 140,
