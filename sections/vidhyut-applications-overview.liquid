<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">

<style>
  .vs-apps-sec-{{ section.id }} {
    --ink: {{ section.settings.text_color | default: "#1A1210" }};
    --white: #FFFFFF;
    --orange-50: #FFF6EE;
    --orange-100: #FFE6D0;
    --saffron: {{ section.settings.accent_color | default: "#FF7A1A" }};
    --saffron-glow: rgba(255, 122, 26, 0.35);
    --leaf: #0F8B3D;
    --gold: #D4900F;
    --line: rgba(42, 33, 24, 0.08);

    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink) !important;
    background: radial-gradient(circle at 12% 18%, rgba(255, 244, 235, 0.95) 0%, #FFFFFF 48%),
                radial-gradient(circle at 88% 82%, rgba(255, 230, 208, 0.55) 0%, transparent 60%),
                linear-gradient(180deg, #FFFFFF 0%, #FFF9F4 100%) !important;
    padding: {{ section.settings.padding_top_desk | default: 70 }}px 20px {{ section.settings.padding_bottom_desk | default: 70 }}px 20px !important;
    position: relative !important;
    overflow: hidden !important;
    margin: 0 auto !important;
    box-sizing: border-box !important;
  }

  .vs-apps-sec-{{ section.id }} *,
  .vs-apps-sec-{{ section.id }} *::before,
  .vs-apps-sec-{{ section.id }} *::after {
    box-sizing: border-box !important;
    margin: 0;
    padding: 0;
  }

  /* ── EQUAL 1200PX CENTERED CONTAINER MATCHING SECTION 21 ── */
  .vs-apps-sec-{{ section.id }} .container {
    max-width: 1200px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    position: relative !important;
    z-index: 2 !important;
  }

  /* Decorative Ambient Glows */
  .vs-apps-sec-{{ section.id }} .ambient-glow-left {
    position: absolute;
    top: 5%;
    left: -100px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 122, 26, 0.14), transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .vs-apps-sec-{{ section.id }} .ambient-glow-right {
    position: absolute;
    bottom: 5%;
    right: -80px;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 144, 15, 0.12), transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* ---------- SECTION HEADER (SINGLE LINE ON DESKTOP) ---------- */
  .vs-apps-sec-{{ section.id }} .section-head {
    text-align: center;
    max-width: 1200px !important;
    margin: 0 auto 46px auto !important;
  }

  .vs-apps-sec-{{ section.id }} .top-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--orange-100);
    border-radius: 999px;
    padding: 7px 22px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    box-shadow: 0 10px 24px -10px rgba(42, 33, 24, 0.2), 0 0 0 1px rgba(255, 122, 26, 0.12);
    margin-bottom: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .vs-apps-sec-{{ section.id }} .top-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgba(15, 139, 61, 0.25);
    animation: vsDotPulse 2s infinite ease-in-out;
  }

  @keyframes vsDotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.7; }
  }

  .vs-apps-sec-{{ section.id }} .kicker {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.14em;
    color: var(--saffron);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .vs-apps-sec-{{ section.id }} .section-title {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: clamp(24px, 2.4vw, 36px);
    letter-spacing: -0.025em;
    line-height: 1.22;
    color: var(--ink);
    white-space: nowrap; /* Single line on desktop */
  }

  .vs-apps-sec-{{ section.id }} .section-title .accent {
    background: linear-gradient(105deg, var(--saffron) 0%, #FF9636 50%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--saffron);
    display: inline-block;
  }

  /* ---------- MAIN CONTENT LAYOUT (1FR 1FR EQUAL HEIGHT) ---------- */
  .vs-apps-sec-{{ section.id }} .content {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 40px !important;
    align-items: stretch !important; /* Equal height */
  }

  /* ---------- LEFT: CARD GRID ---------- */
  .vs-apps-sec-{{ section.id }} .cards-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 16px !important;
    height: 100% !important;
    margin-top: 0 !important;
  }

  .vs-apps-sec-{{ section.id }} .app-card {
    position: relative !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    aspect-ratio: 4 / 3.3 !important;
    box-shadow: 0 16px 36px -12px rgba(42, 33, 24, 0.32), 0 0 0 1px rgba(255, 255, 255, 0.6) !important;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease, border-color 0.4s ease !important;
    user-select: none !important;
    background-color: #1F1714 !important;
    cursor: pointer !important;
  }

  .vs-apps-sec-{{ section.id }} .app-card:hover {
    transform: translateY(-8px) scale(1.015);
    box-shadow: 0 32px 60px -15px rgba(255, 122, 26, 0.38), 0 0 0 2px rgba(255, 122, 26, 0.5);
  }

  .vs-apps-sec-{{ section.id }} .app-card.popular {
    box-shadow: 0 22px 45px -15px rgba(255, 122, 26, 0.45), 0 0 0 2px var(--saffron);
  }

  .vs-apps-sec-{{ section.id }} .app-card.popular:hover {
    box-shadow: 0 36px 65px -15px rgba(255, 122, 26, 0.55), 0 0 0 2.5px var(--saffron);
  }

  .vs-apps-sec-{{ section.id }} .ribbon {
    position: absolute;
    top: 16px;
    right: -36px;
    width: 145px;
    transform: rotate(40deg);
    background: linear-gradient(100deg, var(--saffron), #FFA034, var(--gold));
    color: var(--white);
    font-family: 'Outfit', sans-serif;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-align: center;
    padding: 4px 0;
    z-index: 5;
    box-shadow: 0 4px 14px -2px rgba(255, 122, 26, 0.7);
  }

  .vs-apps-sec-{{ section.id }} .card-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .vs-apps-sec-{{ section.id }} .app-card:hover .card-bg {
    transform: scale(1.06);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.residential {
    background-color: #2A1E18;
    background-image: linear-gradient(145deg, #4F382A 0%, #2A1E18 75%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.commercial {
    background-color: #121A24;
    background-image: linear-gradient(145deg, #203144 0%, #121A24 75%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.industrial {
    background-color: #22140E;
    background-image: linear-gradient(145deg, #442316 0%, #22140E 75%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.institutional {
    background-color: #12221A;
    background-image: linear-gradient(145deg, #234736 0%, #12221A 75%);
  }

  .vs-apps-sec-{{ section.id }} .card-bg.has-custom-img {
    background-color: #1A1210 !important;
  }

  .vs-apps-sec-{{ section.id }} .card-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15, 10, 8, 0.92) 0%, rgba(20, 14, 10, 0.45) 55%, rgba(0, 0, 0, 0.2) 100%);
    pointer-events: none;
  }

  .vs-apps-sec-{{ section.id }} .icon-motif {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    opacity: 0.85;
    z-index: 2;
    pointer-events: none;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }

  .vs-apps-sec-{{ section.id }} .app-card:hover .icon-motif {
    transform: translate(-50%, -52%) scale(1.05);
    opacity: 0.95;
  }

  .vs-apps-sec-{{ section.id }} .use-tag {
    position: absolute;
    top: 15px;
    left: 16px;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--saffron);
    z-index: 4;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.4);
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid rgba(255, 122, 26, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .vs-apps-sec-{{ section.id }} .card-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    z-index: 4;
  }

  .vs-apps-sec-{{ section.id }} .card-tagline {
    color: rgba(255, 255, 255, 0.95);
    font-size: 12px;
    font-weight: 600;
    max-width: 65%;
    margin-top: 24px;
    line-height: 1.35;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  .vs-apps-sec-{{ section.id }} .card-bottom {
    display: flex;
    flex-direction: column;
  }

  .vs-apps-sec-{{ section.id }} .card-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(100deg, var(--leaf), #1BA852);
    color: var(--white);
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.03em;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 7px;
    width: fit-content;
    box-shadow: 0 4px 12px -3px rgba(15, 139, 61, 0.7);
  }

  .vs-apps-sec-{{ section.id }} .card-chip .bolt {
    font-size: 10px;
  }

  .vs-apps-sec-{{ section.id }} .card-title {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 16.5px;
    color: var(--white);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.6);
  }

  .vs-apps-sec-{{ section.id }} .card-benefits {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .vs-apps-sec-{{ section.id }} .card-benefits .b {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    font-size: 8.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    text-align: center;
    line-height: 1.2;
    flex: 1;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .vs-apps-sec-{{ section.id }} .card-benefits .b .ic {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* ---------- RIGHT: HEADING + 4 LUCRATIVE CARDS ---------- */
  .vs-apps-sec-{{ section.id }} .right {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    margin-top: 0;
    padding-top: 0;
  }

  .vs-apps-sec-{{ section.id }} .right h2 {
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 32px;
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
  }

  .vs-apps-sec-{{ section.id }} .right h2 .accent {
    color: var(--saffron);
    background: linear-gradient(105deg, var(--saffron), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline;
  }

  .vs-apps-sec-{{ section.id }} .checklist {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: 13px;
  }

  .vs-apps-sec-{{ section.id }} .check-item {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 248, 242, 0.92) 100%);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 18px;
    padding: 13px 20px;
    box-shadow: 0 14px 30px -14px rgba(42, 33, 24, 0.18), 0 0 0 1px var(--orange-100);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
  }

  .vs-apps-sec-{{ section.id }} .check-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    border-radius: 4px 0 0 4px;
    background: linear-gradient(180deg, var(--saffron), var(--gold));
    transition: width 0.3s ease;
  }

  .vs-apps-sec-{{ section.id }} .check-item.theme-res::before {
    background: linear-gradient(180deg, #FF7A1A, #FFB03A);
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-com::before {
    background: linear-gradient(180deg, #1E88E5, #00ACC1);
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ind::before {
    background: linear-gradient(180deg, #E65100, #F57C00);
  }
  .vs-apps-sec-{{ section.id }} .check-item.theme-ins::before {
    background: linear-gradient(180deg, #0F8B3D, #00BFA5);
  }

  .vs-apps-sec-{{ section.id }} .check-item:hover {
    transform: translateX(8px) translateY(-2px);
    box-shadow: 0 22px 42px -12px rgba(255, 122, 26, 0.28), 0 0 0 1.5px rgba(255, 122, 26, 0.35);
  }

  .vs-apps-sec-{{ section.id }} .check-circle {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(145deg, #FF9142 0%, var(--saffron) 100%);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 8px 18px -4px rgba(255, 122, 26, 0.65), inset 0 1px 2px rgba(255, 255, 255, 0.4);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .vs-apps-sec-{{ section.id }} .check-item:hover .check-circle {
    transform: scale(1.1) rotate(6deg);
    box-shadow: 0 10px 22px -3px rgba(255, 122, 26, 0.85);
  }

  .vs-apps-sec-{{ section.id }} .check-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .vs-apps-sec-{{ section.id }} .sector-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Outfit', sans-serif;
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--saffron);
    line-height: 1.2;
  }

  .vs-apps-sec-{{ section.id }} .check-item p {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
  }

  .vs-apps-sec-{{ section.id }} .check-item p strong {
    font-weight: 700;
    color: var(--ink);
  }

  /* ---------- RESPONSIVE BREAKPOINTS ---------- */
  @media (max-width: 1024px) {
    .vs-apps-sec-{{ section.id }} {
      padding: {{ section.settings.padding_top_mob | default: 56 }}px 20px {{ section.settings.padding_bottom_mob | default: 56 }}px 20px;
    }
    .vs-apps-sec-{{ section.id }} .section-title {
      white-space: normal;
      font-size: 28px;
    }
    .vs-apps-sec-{{ section.id }} .content {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .vs-apps-sec-{{ section.id }} .right {
      height: auto;
    }
    .vs-apps-sec-{{ section.id }} .checklist {
      gap: 14px;
      margin-top: 24px;
    }
    .vs-apps-sec-{{ section.id }} .check-item {
      padding: 16px 20px;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: 28px;
      text-align: center;
    }
    .vs-apps-sec-{{ section.id }} .section-head {
      margin-bottom: 38px;
    }
  }

  @media (max-width: 640px) {
    .vs-apps-sec-{{ section.id }} .cards-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .vs-apps-sec-{{ section.id }} .app-card {
      aspect-ratio: 16 / 11;
    }
    .vs-apps-sec-{{ section.id }} .kicker {
      font-size: 12px;
    }
    .vs-apps-sec-{{ section.id }} .section-title {
      font-size: 24px;
    }
    .vs-apps-sec-{{ section.id }} .top-badge {
      font-size: 11.5px;
      padding: 7px 16px;
    }
    .vs-apps-sec-{{ section.id }} .check-item {
      padding: 14px 16px;
      gap: 12px;
    }
    .vs-apps-sec-{{ section.id }} .check-item p {
      font-size: 13.5px;
    }
    .vs-apps-sec-{{ section.id }} .right h2 {
      font-size: 23px;
    }
  }
</style>

<div class="vs-apps-sec-{{ section.id }}">
  <div class="ambient-glow-left"></div>
  <div class="ambient-glow-right"></div>

  <div class="container">

    <!-- SECTION HEADER (SINGLE LINE ON DESKTOP) -->
    <div class="section-head">
      {% if section.settings.badge_text != blank %}
        <div class="top-badge">
          <span class="dot"></span>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.kicker_text != blank %}
        <div class="kicker">{{ section.settings.kicker_text }}</div>
      {% endif %}

      <h2 class="section-title">
        {{ section.settings.heading_prefix | default: "One Solution for Every" }}
        <span class="accent">{{ section.settings.heading_accent | default: "Power-Consuming Sector." }}</span>
      </h2>
    </div>

    <!-- MAIN GRID CONTENT -->
    <div class="content">

      <!-- LEFT: 4 SECTOR CARDS WITH SHOPIFY IMAGE SUPPORT -->
      <div class="cards-grid">
        {% assign sector_cards = section.blocks | where: "type", "sector_card" %}
        {% if sector_cards.size > 0 %}
          {% for block in sector_cards %}
            {% assign card_idx = forloop.index %}
            {% assign custom_img = block.settings.card_image %}
            {% if custom_img == blank %}
              {% if card_idx == 1 and section.settings.card1_image != blank %}
                {% assign custom_img = section.settings.card1_image %}
              {% elsif card_idx == 2 and section.settings.card2_image != blank %}
                {% assign custom_img = section.settings.card2_image %}
              {% elsif card_idx == 3 and section.settings.card3_image != blank %}
                {% assign custom_img = section.settings.card3_image %}
              {% elsif card_idx == 4 and section.settings.card4_image != blank %}
                {% assign custom_img = section.settings.card4_image %}
              {% endif %}
            {% endif %}

            <div class="app-card {% if block.settings.ribbon_text != blank %}popular{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.ribbon_text != blank %}
                <div class="ribbon">{{ block.settings.ribbon_text }}</div>
              {% endif %}

              <div 
                class="card-bg {{ block.settings.card_theme | default: 'residential' }} {% if custom_img != blank %}has-custom-img{% endif %}"
                {% if custom_img != blank %}
                  style="background-image: url('{{ custom_img | image_url: width: 1000 }}');"
                {% endif %}
              ></div>

              {% if custom_img == blank %}
                {% case block.settings.card_theme %}
                  {% when 'commercial' %}
                    <svg class="icon-motif" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg">
                      <rect x="60" y="20" width="80" height="120" fill="rgba(255,255,255,0.08)"/>
                      <rect x="72" y="34" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="93" y="34" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="114" y="34" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="72" y="56" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="93" y="56" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="114" y="56" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="72" y="78" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="93" y="78" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                      <rect x="114" y="78" width="14" height="14" fill="rgba(255,255,255,0.12)"/>
                    </svg>
                  {% when 'industrial' %}
                    <svg class="icon-motif" viewBox="0 0 200 160" xmlns="http://www.w3.org/2000/svg">
                      <rect x="40" y="80" width="120" height="60" fill="rgba(255,255,255,0.08)"/>
