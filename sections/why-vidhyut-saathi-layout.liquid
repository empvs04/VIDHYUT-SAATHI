{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 1 HERO & MARKET OPPORTUNITY STYLES
     ========================================================================== */

  :root {
    --wvs-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --wvs-secondary: {{ section.settings.secondary_color | default: '#007b3e' }};
    --wvs-dark-bg: #070c18;
    --wvs-card-bg: rgba(15, 23, 42, 0.75);
    --wvs-border: rgba(236, 92, 10, 0.25);
    --wvs-border-glow: rgba(255, 204, 0, 0.4);
    --wvs-text-light: #f8fafc;
    --wvs-text-muted: #94a3b8;
    --wvs-gold: #ffcc00;
  }

  .wvs-section-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    background-color: var(--wvs-dark-bg);
    color: var(--wvs-text-light);
    position: relative;
    overflow: hidden;
    padding: 70px 20px 80px 20px;
    border-bottom: 3px solid rgba(236, 92, 10, 0.3);
  }

  /* --- Glowing Radial Background Blur Effects --- */
  .wvs-bg-glow-1 {
    position: absolute;
    top: -100px;
    left: -100px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.22) 0%, rgba(0, 0, 0, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-bg-glow-2 {
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.2) 0%, rgba(0, 0, 0, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  /* --- Moving Background Marquee --- */
  @keyframes wvs-marquee-scroll {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  .wvs-moving-marquee {
    position: absolute;
    top: 25px;
    left: 0;
    width: 200%;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.12;
    pointer-events: none;
    font-size: clamp(40px, 6vw, 90px);
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: wvs-marquee-scroll 25s linear infinite;
  }

  .wvs-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- Header Badge & Titles --- */
  .wvs-header-center {
    text-align: center;
    max-width: 960px;
    margin: 0 auto 50px auto;
  }

  .wvs-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 24px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.2), rgba(0, 123, 62, 0.2));
    border: 1px solid var(--wvs-border-glow);
    border-radius: 50px;
    color: var(--wvs-gold);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
    box-shadow: 0 0 20px rgba(255, 204, 0, 0.15);
  }

  .wvs-pulse-dot {
    width: 9px;
    height: 9px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    animation: wvs-pulse-animation 1.8s infinite;
  }

  @keyframes wvs-pulse-animation {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
  }

  .wvs-main-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }

  .wvs-gradient-text {
    background: linear-gradient(135deg, #ff8c00 0%, #ffcc00 50%, #00ff88 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wvs-subtitle-bar {
    display: inline-block;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 12px 28px;
    font-size: clamp(15px, 2vw, 19px);
    font-weight: 700;
    color: #e2e8f0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
  }

  /* --- Electricity Presence Section --- */
  .wvs-electricity-box {
    background: linear-gradient(145deg, rgba(15, 23, 42, 0.85), rgba(11, 17, 32, 0.95));
    border: 1px solid rgba(255, 204, 0, 0.25);
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 50px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
  }

  .wvs-electricity-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .wvs-electricity-head i {
    font-size: 2rem;
    color: var(--wvs-gold);
  }

  .wvs-electricity-head h3 {
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .wvs-places-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
    margin-bottom: 30px;
  }

  .wvs-place-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 18px 10px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .wvs-place-card:hover {
    transform: translateY(-5px);
    background: rgba(236, 92, 10, 0.15);
    border-color: var(--wvs-primary);
    box-shadow: 0 10px 25px rgba(236, 92, 10, 0.25);
  }

  .wvs-place-card i {
    font-size: 1.8rem;
    color: var(--wvs-gold);
    margin-bottom: 8px;
    display: block;
  }

  .wvs-place-card span {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .wvs-opportunity-highlight {
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.15) 0%, rgba(0, 123, 62, 0.15) 100%);
    border-left: 4px solid var(--wvs-gold);
    border-radius: 0 16px 16px 0;
    padding: 20px 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wvs-opportunity-highlight p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #e2e8f0;
    margin: 0;
  }

  .wvs-opportunity-highlight p strong {
    color: #ffffff;
  }

  .wvs-district-tag {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--wvs-gold);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* --- Business & Ecosystem Split Grid --- */
  .wvs-ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 50px;
  }

  .wvs-eco-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8), rgba(20, 30, 55, 0.8));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 32px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .wvs-eco-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--wvs-primary), var(--wvs-secondary));
  }

  .wvs-eco-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 204, 0, 0.4);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .wvs-eco-icon {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.2), rgba(0, 123, 62, 0.2));
    border: 1px solid rgba(255, 204, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--wvs-gold);
    margin-bottom: 20px;
  }

  .wvs-eco-card h4 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .wvs-eco-card p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0;
  }

  /* --- 4 Core Pillars Row --- */
  .wvs-pillars-wrapper {
    margin-bottom: 50px;
  }

  .wvs-pillars-title {
    text-align: center;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--wvs-gold);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .wvs-pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .wvs-pillar-card {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 18px;
    padding: 24px 16px;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .wvs-pillar-card:hover {
    transform: translateY(-6px);
    background: linear-gradient(145deg, rgba(236, 92, 10, 0.15), rgba(0, 123, 62, 0.15));
    border-color: var(--wvs-gold);
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.2);
  }

  .wvs-pillar-number {
    position: absolute;
    top: 10px;
    right: 14px;
    font-size: 0.8rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.15);
  }

  .wvs-pillar-card i {
    font-size: 2.2rem;
    color: var(--wvs-gold);
    margin-bottom: 12px;
    display: inline-block;
  }

  .wvs-pillar-card h5 {
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 1px;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .wvs-pillar-card span {
    font-size: 0.85rem;
    color: #94a3b8;
    display: block;
    line-height: 1.4;
  }

  /* --- Bottom Tagline Banner & Action --- */
  .wvs-bottom-banner {
    background: linear-gradient(135deg, #ec5c0a 0%, #c44600 50%, #007b3e 100%);
    border-radius: 24px;
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 15px 40px rgba(236, 92, 10, 0.35);
    position: relative;
    overflow: hidden;
  }

  .wvs-bottom-banner::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.12);
    transform: rotate(45deg);
    pointer-events: none;
  }

  .wvs-banner-text h4 {
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 900;
    letter-spacing: 1.5px;
    color: #ffffff;
    margin: 0 0 6px 0;
    text-transform: uppercase;
  }

  .wvs-banner-text p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    font-weight: 600;
  }

  .wvs-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: #ffffff;
    color: #0f172a;
    font-size: 1rem;
    font-weight: 800;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .wvs-cta-btn:hover {
    background: var(--wvs-gold);
    color: #000000;
    transform: scale(1.05);
    box-shadow: 0 12px 30px rgba(255, 204, 0, 0.4);
  }

  /* --- Responsive Styles --- */
  @media (max-width: 1024px) {
    .wvs-places-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 768px) {
    .wvs-section-wrapper {
      padding: 45px 15px 50px 15px;
    }
    .wvs-places-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wvs-ecosystem-grid {
      grid-template-columns: 1fr;
    }
    .wvs-pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wvs-bottom-banner {
      flex-direction: column;
      text-align: center;
      padding: 28px 20px;
    }
    .wvs-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .wvs-places-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wvs-pillars-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="wvs-section-wrapper">
  <!-- Glowing Radial Background Blurs -->
  <div class="wvs-bg-glow-1"></div>
  <div class="wvs-bg-glow-2"></div>

  <!-- Background Moving Text Marquee -->
  <div class="wvs-moving-marquee">
    {{ section.settings.marquee_text | default: "WHY VIDHYUT SAATHI • PAN-INDIA FRANCHISE OPPORTUNITY • ENERGY SAVING MARKET • YOUR DISTRICT YOUR BUSINESS" }}
  </div>

  <div class="wvs-container">
    <!-- Header Section -->
    <div class="wvs-header-center">
      <div class="wvs-badge">
        <span class="wvs-pulse-dot"></span>
        <span>{{ section.settings.badge_title | default: "WHY VIDHYUT SAATHI?" }}</span>
      </div>

      <h1 class="wvs-main-title">
        {{ section.settings.main_heading_part1 | default: "BUILD YOUR BUSINESS IN INDIA’S" }}
        <span class="wvs-gradient-text">{{ section.settings.main_heading_part2 | default: "GROWING ENERGY-SAVING MARKET." }}</span>
      </h1>

      <div class="wvs-subtitle-bar">
        ✨ {{ section.settings.subtitle | default: "A Powerful Product. A Growing Market. A Pan-India Franchise Opportunity." }}
      </div>
    </div>

    <!-- Electricity Presence Section -->
    <div class="wvs-electricity-box">
      <div class="wvs-electricity-head">
        <i class="fa-solid fa-bolt-lightning"></i>
        <h3>Electricity is Everywhere</h3>
      </div>

      <!-- 7 Places Grid -->
      <div class="wvs-places-grid">
        <div class="wvs-place-card">
          <i class="fa-solid fa-house-chimney"></i>
          <span>Homes</span>
        </div>
        <div class="wvs-place-card">
          <i class="fa-solid fa-store"></i>
          <span>Shops</span>
        </div>
        <div class="wvs-place-card">
          <i class="fa-solid fa-building"></i>
          <span>Offices</span>
        </div>
        <div class="wvs-place-card">
          <i class="fa-solid fa-industry"></i>
          <span>Factories</span>
        </div>
        <div class="wvs-place-card">
          <i class="fa-solid fa-hotel"></i>
          <span>Hotels</span>
        </div>
        <div class="wvs-place-card">
          <i class="fa-solid fa-hospital"></i>
          <span>Hospitals</span>
        </div>
        <div class="wvs-place-card">
          <i class="fa-solid fa-school"></i>
          <span>Institutions</span>
        </div>
      </div>

      <!-- Opportunity Callout -->
      <div class="wvs-opportunity-highlight">
        <p>
          Everywhere electricity is consumed, there is an opportunity to introduce <strong>smarter energy-saving solutions.</strong>
        </p>
        <div class="wvs-district-tag">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Vidhyut Saathi is building that opportunity — one district at a time.</span>
        </div>
      </div>
    </div>

    <!-- Ecosystem & Value Proposition Grid -->
    <div class="wvs-ecosystem-grid">
      <div class="wvs-eco-card">
        <div class="wvs-eco-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4>National Brand & Product Business Model</h4>
        <p>
          Vidhyut Saathi brings together an innovative Electric Saver Card, a growing national brand and a structured district-level franchise business model to help ambitious entrepreneurs build and grow their own local market.
        </p>
      </div>

      <div class="wvs-eco-card">
        <div class="wvs-eco-icon">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <h4>More Than a Franchise — Complete Ecosystem</h4>
        <p>
          With product support, branding, marketing assistance, training and business guidance, you get more than a franchise—you get an ecosystem designed to help you move from starting a business to building a market.
        </p>
      </div>
    </div>

    <!-- 4 Core Pillars Row -->
    <div class="wvs-pillars-wrapper">
      <div class="wvs-pillars-title">The Complete Vidhyut Saathi Ecosystem</div>
      <div class="wvs-pillars-grid">
        <div class="wvs-pillar-card">
          <span class="wvs-pillar-number">01</span>
          <i class="fa-solid fa-microchip"></i>
          <h5>PRODUCT</h5>
          <span>Innovative Electric Saver Card</span>
        </div>

        <div class="wvs-pillar-card">
          <span class="wvs-pillar-number">02</span>
          <i class="fa-solid fa-award"></i>
          <h5>BRAND</h5>
          <span>Growing National Energy Brand</span>
        </div>

        <div class="wvs-pillar-card">
          <span class="wvs-pillar-number">03</span>
          <i class="fa-solid fa-globe"></i>
          <h5>MARKET</h5>
          <span>District-Level Business Model</span>
        </div>

        <div class="wvs-pillar-card">
          <span class="wvs-pillar-number">04</span>
          <i class="fa-solid fa-handshake-angle"></i>
          <h5>SUPPORT</h5>
          <span>Training, Marketing & Guidance</span>
        </div>
      </div>
    </div>

    <!-- Tagline Banner -->
    <div class="wvs-bottom-banner">
      <div class="wvs-banner-text">
        <h4>YOUR DISTRICT. YOUR BUSINESS. YOUR OPPORTUNITY.</h4>
        <p>Start building your local energy-saving franchise market with Vidhyut Saathi today.</p>
      </div>
      <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="wvs-cta-btn">
        <span>Apply For District Franchise</span>
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

