<style>
  .vsblog-newsletter-section-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    box-sizing: border-box;
    width: 100%;
  }

  .vsblog-newsletter-section-wrap *, .vsblog-newsletter-section-wrap *::before, .vsblog-newsletter-section-wrap *::after {
    box-sizing: border-box;
  }

  .vsblog-newsletter-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px 40px 16px;
  }

  @media (min-width: 768px) {
    .vsblog-newsletter-container {
      padding: 0 20px 60px 20px;
    }
  }

  /* ─── NEWSLETTER SECTION ─── */
  .vsblog-newsletter {
    margin-top: 30px;
    background: linear-gradient(135deg, #ffffff 0%, #fff6ec 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    border-radius: 20px;
    padding: 24px 18px;
    text-align: center;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.025);
    width: 100%;
  }

  @media (min-width: 768px) {
    .vsblog-newsletter { margin-top: 44px; padding: 40px 28px; border-radius: 24px; }
  }

  .vsblog-newsletter-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #ffffff;
    margin: 0 auto 14px auto;
    box-shadow: 0 4px 16px rgba(236, 92, 10, 0.28);
  }

  .vsblog-newsletter h2 {
    font-size: clamp(17px, 2.8vw, 26px);
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .vsblog-newsletter h2 span { color: #ec5c0a; font-weight: 700; }

  .vsblog-newsletter p {
    font-size: 13px;
    color: #64748b;
    font-weight: 400;
    margin: 0 auto 18px auto;
    max-width: 500px;
    line-height: 1.5;
  }

  .vsblog-nl-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 480px;
    margin: 0 auto;
    width: 100%;
  }

  @media (min-width: 600px) {
    .vsblog-nl-form {
      flex-direction: row;
      gap: 0;
      background: #ffffff;
      border-radius: 50px;
      border: 1.5px solid rgba(236, 92, 10, 0.28);
      overflow: hidden;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    }
  }

  .vsblog-nl-form input {
    width: 100%;
    height: 44px;
    padding: 0 18px;
    border: 1.5px solid rgba(236, 92, 10, 0.25);
    border-radius: 50px;
    outline: none;
    font-size: 12.5px;
    font-family: inherit;
    color: #0f172a;
    font-weight: 400;
    background: #ffffff;
  }

  @media (min-width: 600px) {
    .vsblog-nl-form input { border: none; height: 48px; border-radius: 0; padding: 0 22px; }
  }

  .vsblog-nl-form button {
    width: 100%;
    height: 44px;
    padding: 0 24px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    border: none;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    border-radius: 50px;
    white-space: nowrap;
    transition: all 0.25s ease;
  }

  @media (min-width: 600px) {
    .vsblog-nl-form button { width: auto; height: 48px; border-radius: 0 50px 50px 0; }
  }

  .vsblog-nl-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .vsblog-nl-trust-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #64748b;
    font-weight: 500;
  }

  .vsblog-nl-trust-item i { color: #007b3e; }
</style>

<div class="vsblog-newsletter-section-wrap">
  <div class="vsblog-newsletter-container">
    <!-- NEWSLETTER SECTION -->
    <div class="vsblog-newsletter">
      <div class="vsblog-newsletter-icon">
        <i class="fa-solid fa-envelope-open-text"></i>
      </div>
      <h2>{{ section.settings.heading | default: "Stay Updated with <span>Vidhyut Saathi</span>" }}</h2>
      <p>{{ section.settings.subheading | default: "Get energy-saving tips and franchise insights delivered directly to your inbox." }}</p>
      
      <form class="vsblog-nl-form" onsubmit="typeof vsSubscribeNewsletter === 'function' ? vsSubscribeNewsletter(event) : event.preventDefault()">
        <input type="email" id="vsblog_nl_email" placeholder="{{ section.settings.input_placeholder | default: 'Enter your email address...' }}" required>
        <button type="submit"><i class="fa-solid fa-paper-plane"></i> {{ section.settings.button_text | default: "Subscribe" }}</button>
      </form>
      <div id="vsblog_nl_msg" style="margin-top:10px; font-size:12px; font-weight:600; color:#007b3e;"></div>

      <div class="vsblog-nl-trust">
        <span class="vsblog-nl-trust-item"><i class="fa-solid fa-check-circle"></i> {{ section.settings.trust_1 | default: "No Spam" }}</span>
        <span class="vsblog-nl-trust-item"><i class="fa-solid fa-check-circle"></i> {{ section.settings.trust_2 | default: "Unsubscribe Anytime" }}</span>
        <span class="vsblog-nl-trust-item"><i class="fa-solid fa-check-circle"></i> {{ section.settings.trust_3 | default: "Free Guide" }}</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Newsletter",
  "tag": "section",
  "class": "vsblog-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Updated with <span>Vidhyut Saathi</span>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get energy-saving tips and franchise insights delivered directly to your inbox."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust Badge 1",
      "default": "No Spam"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust Badge 2",
      "default": "Unsubscribe Anytime"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust Badge 3",
      "default": "Free Guide"
    }
  ],
  "presets": [
    {
      "name": "Blog Newsletter"
    }
  ]
}
{% endschema %}
