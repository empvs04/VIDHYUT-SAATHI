<!-- ⑤ LIVE WAVEFORM CANVAS SCRIPT -->
<script>
(function() {
  function vsbInitGraphs() {
    var sid = '{{ section.id }}';

    /* ---- BEFORE canvas: erratic red spikes ---- */
    var cB = document.getElementById('vsb-bc-' + sid);
    var vB = document.getElementById('vsb-bv-' + sid);
    if (cB) {
      var ctxB = cB.getContext('2d');
      var stepB = 0;
      (function drawBefore() {
        var w = cB.offsetWidth, h = cB.offsetHeight;
        if (cB.width !== w || cB.height !== h) { cB.width = w; cB.height = h; }

        ctxB.clearRect(0, 0, w, h);

        /* Grid */
        ctxB.strokeStyle = 'rgba(239,68,68,0.1)';
        ctxB.lineWidth = 1;
        for (var gx = 0; gx < w; gx += 28) {
          ctxB.beginPath(); ctxB.moveTo(gx, 0); ctxB.lineTo(gx, h); ctxB.stroke();
        }
        for (var gy = 0; gy < h; gy += 22) {
          ctxB.beginPath(); ctxB.moveTo(0, gy); ctxB.lineTo(w, gy); ctxB.stroke();
        }

        /* Erratic wave */
        ctxB.beginPath();
        ctxB.strokeStyle = '#ef4444';
        ctxB.lineWidth = 2;
        ctxB.shadowColor = '#ef4444';
        ctxB.shadowBlur = 8;
        var my = h * 0.5;
        for (var x = 0; x < w; x++) {
          var y = my
            + Math.sin((x + stepB) * 0.12) * 18
            + Math.sin((x - stepB) * 0.3)  * 12
            + (Math.random() - 0.5) * 16;
          if (x === 0) ctxB.moveTo(x, y); else ctxB.lineTo(x, y);
        }
        ctxB.stroke();
        ctxB.shadowBlur = 0;

        if (vB && Math.random() < 0.06) {
          vB.textContent = (255 + Math.floor(Math.random() * 36)) + 'V ▲';
        }
        stepB += 5;
        requestAnimationFrame(drawBefore);
      })();
    }

    /* ---- AFTER canvas: smooth green sine ---- */
    var cA = document.getElementById('vsb-ac-' + sid);
    var vA = document.getElementById('vsb-av-' + sid);
    if (cA) {
      var ctxA = cA.getContext('2d');
      var stepA = 0;
      (function drawAfter() {
        var w = cA.offsetWidth, h = cA.offsetHeight;
        if (cA.width !== w || cA.height !== h) { cA.width = w; cA.height = h; }

        ctxA.clearRect(0, 0, w, h);

        /* Grid */
        ctxA.strokeStyle = 'rgba(16,185,129,0.1)';
        ctxA.lineWidth = 1;
        for (var gx = 0; gx < w; gx += 28) {
          ctxA.beginPath(); ctxA.moveTo(gx, 0); ctxA.lineTo(gx, h); ctxA.stroke();
        }
        for (var gy = 0; gy < h; gy += 22) {
          ctxA.beginPath(); ctxA.moveTo(0, gy); ctxA.lineTo(w, gy); ctxA.stroke();
        }

        /* Smooth sine */
        ctxA.beginPath();
        ctxA.strokeStyle = '#10b981';
        ctxA.lineWidth = 2;
        ctxA.shadowColor = '#10b981';
        ctxA.shadowBlur = 10;
        var my2 = h * 0.5;
        for (var x = 0; x < w; x++) {
          var y = my2 + Math.sin((x + stepA) * 0.042) * 10;
          if (x === 0) ctxA.moveTo(x, y); else ctxA.lineTo(x, y);
        }
        ctxA.stroke();
        ctxA.shadowBlur = 0;

        if (vA && Math.random() < 0.04) {
          vA.textContent = (220 + Math.floor(Math.random() * 5)) + 'V ✓';
        }
        stepA += 2.5;
        requestAnimationFrame(drawAfter);
      })();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', vsbInitGraphs);
  } else {
    vsbInitGraphs();
  }
})();
</script>


