{%- comment -%}
  Vidhyut Saathi - Institutional 1:1 Banner Slider (Section 10)
  Clean 1:1 Square Image Banners with Flush Thick Top/Bottom Rails & Straight Vertical Thick Dividers Connecting Directly
{%- endcomment -%}

<style>
  .vsinst-slider-11-section-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.bg_color | default: '#fffdf5' }};
    padding: {{ section.settings.padding_top | default: 50 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;
    position: relative;
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .vsinst-slider-11-section-{{ section.id }} .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header Styles */
  .vsinst-slider-11-head {
    text-align: center;
    margin-bottom: 28px;
    position: relative;
  }

  .vsinst-slider-11-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #b45309;
    background: #fef3c7;
    border: 1px solid #fde68a;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 12px;
    box-shadow: 0 2px 8px rgba(217, 119, 6, 0.08);
  }

  .vsinst-slider-11-title {
    font-family: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 10px 0;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .vsinst-slider-11-title span {
    background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsinst-slider-11-desc {
    font-size: 14.5px;
    color: #64748b;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 500;
  }

  /* ══ FRAMED SLIDER STRIP WITH FLUSH TOP & BOTTOM THICK LINES (ZERO PADDING/MARGIN) ══ */
  .vsinst-slider-11-strip-wrap {
    position: relative;
    width: 100%;
    border-top: {{ section.settings.line_thickness | default: 6 }}px solid {{ section.settings.line_color | default: '#d97706' }};
    border-bottom: {{ section.settings.line_thickness | default: 6 }}px solid {{ section.settings.line_color | default: '#d97706' }};
    padding: 0;
    margin: 0;
    background: {{ section.settings.strip_bg | default: '#0f172a' }};
    line-height: 0;
    box-shadow: 0 4px 20px rgba(217, 119, 6, 0.18);
  }

  /* Slider Outer & Track */
  .vsinst-marquee-11-outer {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 0;
    margin: 0;
    mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
  }

  .vsinst-marquee-11-track {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: max-content;
    animation: vsinstMarqueeLeft11-{{ section.id }} {{ section.settings.scroll_speed | default: 30 }}s linear infinite;
    cursor: grab;
    will-change: transform;
    padding: 0;
    margin: 0;
  }

  .vsinst-marquee-11-track:active {
    cursor: grabbing;
  }

  {% if section.settings.pause_on_hover %}
  .vsinst-marquee-11-outer:hover .vsinst-marquee-11-track {
    animation-play-state: paused !important;
  }
  {% endif %}

  @keyframes vsinstMarqueeLeft11-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Clean 1:1 Square Banner Card Flush with Frame */
  .vsinst-banner-card-11 {
    position: relative;
    width: clamp(240px, 24vw, 340px);
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    border-radius: 0;
    overflow: hidden;
    background: #f1f5f9;
    border: none;
    box-shadow: none;
    text-decoration: none;
    display: block;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  /* Card Image Full-Bleed */
  .vsinst-banner-11-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .vsinst-banner-card-11:hover .vsinst-banner-11-img {
    transform: scale(1.06);
  }

  /* ══ STRAIGHT THICK VERTICAL DIVIDER LINE CONNECTING TOP & BOTTOM FLUSH ══ */
  .vsinst-card-divider-11 {
    width: {{ section.settings.line_thickness | default: 6 }}px;
    background: {{ section.settings.line_color | default: '#d97706' }};
    border-radius: 0;
    flex-shrink: 0;
    align-self: stretch;
    margin: 0;
    padding: 0;
  }

  /* Nav Controls & Drag Helpers */
  .vsinst-slider-11-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 24px;
  }

  .vsinst-ctrl-11-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #fde68a;
    color: #b45309;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(217, 119, 6, 0.12);
    transition: all 0.25s ease;
  }

  .vsinst-ctrl-11-btn:hover {
    background: #f59e0b;
    color: #ffffff;
    border-color: #f59e0b;
    transform: scale(1.08);
  }

  .vsinst-ctrl-11-badge {
    font-size: 11.5px;
    font-weight: 700;
    color: #854d0e;
    background: #fef3c7;
    border: 1px solid #fde68a;
    padding: 6px 14px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Responsive Rules */
  @media (max-width: 768px) {
    .vsinst-slider-11-section-{{ section.id }} {
      padding: 38px 0 42px 0;
    }
    .vsinst-banner-card-11 {
      width: 220px;
    }
  }
</style>

<section class="vsinst-slider-11-section-{{ section.id }}" id="vsinst-banners-11-slider-{{ section.id }}">
  <div class="wrap">
    <div class="vsinst-slider-11-head">
      {% if section.settings.eyebrow != blank %}
        <div class="vsinst-slider-11-eyebrow">
          <i class="fa-solid fa-square"></i> {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      <h2 class="vsinst-slider-11-title">
        {{ section.settings.heading | default: 'Institutional Square Banners <span>(1:1 Showcase)</span>' }}
      </h2>

      {% if section.settings.subheading != blank %}
        <p class="vsinst-slider-11-desc">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>

  <!-- FRAMED SLIDER STRIP (TOP & BOTTOM THICK LINES) -->
  <div class="vsinst-slider-11-strip-wrap">
    <div class="vsinst-marquee-11-outer" id="vsinstMarquee11Outer-{{ section.id }}">
      <div class="vsinst-marquee-11-track" id="vsinstMarquee11Track-{{ section.id }}">

        <!-- RENDER PASS 1 -->
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign img_url = '' %}
            {% if block.settings.image != blank %}
              {% assign img_url = block.settings.image | image_url: width: 800 %}
            {% elsif forloop.index == 1 %}
              {% assign img_url = 'commercial-building-2.png' | asset_url %}
            {% elsif forloop.index == 2 %}
              {% assign img_url = 'case-institutional.jpg' | asset_url %}
            {% elsif forloop.index == 3 %}
              {% assign img_url = 'commercial-building-1.png' | asset_url %}
            {% elsif forloop.index == 4 %}
              {% assign img_url = 'institutional-mcb-showcase-final.jpg' | asset_url %}
            {% else %}
              {% assign img_url = 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80' %}
            {% endif %}

            <a href="{{ block.settings.link | default: '#vsinst-calc' }}" class="vsinst-banner-card-11" {{ block.shopify_attributes }} target="{% if block.settings.link contains 'http' or block.settings.link contains 'wa.me' %}_blank{% else %}_self{% endif %}">
              <img src="{{ img_url }}" alt="Institutional 1:1 Banner" class="vsinst-banner-11-img" loading="lazy" onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';">
            </a>

            <!-- VERTICAL THICK STRAIGHT LINE DIVIDER -->
            <div class="vsinst-card-divider-11"></div>
          {% endfor %}

        {% else %}
          <!-- SECTION SETTINGS FALLBACK CARDS (CARDS 1 TO 10) -->
          {% for i in (1..10) %}
            {% capture img_key %}banner_img_{{ i }}{% endcapture %}
            {% capture link_key %}banner_link_{{ i }}{% endcapture %}

            {% assign card_img = section.settings[img_key] %}
            {% assign card_link = section.settings[link_key] %}

            {% if card_img != blank or i <= 5 %}
              {% assign img_url = '' %}
              {% if card_img != blank %}
                {% assign img_url = card_img | image_url: width: 800 %}
              {% elsif i == 1 %}
                {% assign img_url = 'commercial-building-2.png' | asset_url %}
              {% elsif i == 2 %}
                {% assign img_url = 'case-institutional.jpg' | asset_url %}
              {% elsif i == 3 %}
                {% assign img_url = 'commercial-building-1.png' | asset_url %}
              {% elsif i == 4 %}
                {% assign img_url = 'institutional-mcb-showcase-final.jpg' | asset_url %}
              {% elsif i == 5 %}
                {% assign img_url = 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80' %}
              {% else %}
                {% assign img_url = 'commercial-building-2.png' | asset_url %}
              {% endif %}

              <a href="{{ card_link | default: '#vsinst-calc' }}" class="vsinst-banner-card-11" target="{% if card_link contains 'http' or card_link contains 'wa.me' %}_blank{% else %}_self{% endif %}">
                <img src="{{ img_url }}" alt="Institutional 1:1 Banner" class="vsinst-banner-11-img" loading="lazy" onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';">
              </a>

              <!-- VERTICAL THICK STRAIGHT LINE DIVIDER -->
              <div class="vsinst-card-divider-11"></div>
            {% endif %}
          {% endfor %}
        {% endif %}

        <!-- RENDER PASS 2 (DUPLICATE PASS FOR SEAMLESS 100% INFINITE LOOP) -->
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign img_url = '' %}
            {% if block.settings.image != blank %}
              {% assign img_url = block.settings.image | image_url: width: 800 %}
            {% elsif forloop.index == 1 %}
              {% assign img_url = 'commercial-building-2.png' | asset_url %}
            {% elsif forloop.index == 2 %}
              {% assign img_url = 'case-institutional.jpg' | asset_url %}
            {% elsif forloop.index == 3 %}
              {% assign img_url = 'commercial-building-1.png' | asset_url %}
            {% elsif forloop.index == 4 %}
              {% assign img_url = 'institutional-mcb-showcase-final.jpg' | asset_url %}
            {% else %}
              {% assign img_url = 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80' %}
            {% endif %}

            <a href="{{ block.settings.link | default: '#vsinst-calc' }}" class="vsinst-banner-card-11" aria-hidden="true" tabindex="-1" target="{% if block.settings.link contains 'http' or block.settings.link contains 'wa.me' %}_blank{% else %}_self{% endif %}">
              <img src="{{ img_url }}" alt="Institutional 1:1 Banner" class="vsinst-banner-11-img" loading="lazy" onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';">
            </a>

            <!-- VERTICAL THICK STRAIGHT LINE DIVIDER -->
            <div class="vsinst-card-divider-11"></div>
          {% endfor %}

        {% else %}
          <!-- DUPLICATE PASS FOR SETTINGS FALLBACK CARDS -->
          {% for i in (1..10) %}
            {% capture img_key %}banner_img_{{ i }}{% endcapture %}
            {% capture link_key %}banner_link_{{ i }}{% endcapture %}

            {% assign card_img = section.settings[img_key] %}
            {% assign card_link = section.settings[link_key] %}

            {% if card_img != blank or i <= 5 %}
              {% assign img_url = '' %}
              {% if card_img != blank %}
                {% assign img_url = card_img | image_url: width: 800 %}
              {% elsif i == 1 %}
                {% assign img_url = 'commercial-building-2.png' | asset_url %}
              {% elsif i == 2 %}
                {% assign img_url = 'case-institutional.jpg' | asset_url %}
              {% elsif i == 3 %}
                {% assign img_url = 'commercial-building-1.png' | asset_url %}
              {% elsif i == 4 %}
                {% assign img_url = 'institutional-mcb-showcase-final.jpg' | asset_url %}
              {% elsif i == 5 %}
                {% assign img_url = 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80' %}
              {% else %}
                {% assign img_url = 'commercial-building-2.png' | asset_url %}
              {% endif %}

              <a href="{{ card_link | default: '#vsinst-calc' }}" class="vsinst-banner-card-11" aria-hidden="true" tabindex="-1" target="{% if card_link contains 'http' or card_link contains 'wa.me' %}_blank{% else %}_self{% endif %}">
                <img src="{{ img_url }}" alt="Institutional 1:1 Banner" class="vsinst-banner-11-img" loading="lazy" onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';">
              </a>

              <!-- VERTICAL THICK STRAIGHT LINE DIVIDER -->
              <div class="vsinst-card-divider-11"></div>
            {% endif %}
          {% endfor %}
        {% endif %}

      </div>
    </div>
  </div>

  <!-- INTERACTIVE CONTROLS -->
  <div class="vsinst-slider-11-controls">
    <button type="button" class="vsinst-ctrl-11-btn" id="vsinst11Prev-{{ section.id }}" aria-label="Slide Left">
      <i class="fa-solid fa-arrow-left"></i>
    </button>
    <div class="vsinst-ctrl-11-badge">
      <i class="fa-solid fa-arrows-left-right" style="color:#d97706;"></i> 1:1 Square Ratio • Auto-Sliding Right to Left • Hover to Pause
    </div>
    <button type="button" class="vsinst-ctrl-11-btn" id="vsinst11Next-{{ section.id }}" aria-label="Slide Right">
      <i class="fa-solid fa-arrow-right"></i>
    </button>
  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var outer = document.getElementById('vsinstMarquee11Outer-' + sectionId);
    var track = document.getElementById('vsinstMarquee11Track-' + sectionId);
    var btnPrev = document.getElementById('vsinst11Prev-' + sectionId);
    var btnNext = document.getElementById('vsinst11Next-' + sectionId);

    if (!outer || !track) return;

    if (btnPrev) {
      btnPrev.addEventListener('click', function() {
        track.style.animationPlayState = 'paused';
        outer.scrollBy({ left: -300, behavior: 'smooth' });
        setTimeout(function() {
          track.style.animationPlayState = '';
        }, 2500);
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', function() {
        track.style.animationPlayState = 'paused';
        outer.scrollBy({ left: 300, behavior: 'smooth' });
        setTimeout(function() {
          track.style.animationPlayState = '';
        }, 2500);
      });
    }

    var isDown = false;
    var startX, scrollLeft;
    outer.addEventListener('mousedown', function(e) {
      isDown = true;
      startX = e.pageX - outer.offsetLeft;
      scrollLeft = outer.scrollLeft;
      track.style.animationPlayState = 'paused';
    });
    window.addEventListener('mouseup', function() {
      if (!isDown) return;
      isDown = false;
      track.style.animationPlayState = '';
    });
    outer.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      var x = e.pageX - outer.offsetLeft;
      var walk = (x - startX) * 1.5;
      outer.scrollLeft = scrollLeft - walk;
    });
  })();
</script>

