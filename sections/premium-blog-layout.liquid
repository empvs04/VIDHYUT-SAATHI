<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ============================================
     VIDHYUT SAATHI - PREMIUM BLOG PAGE STYLES
     Theme: #fff8ef bg | #ec5c0a orange | #007b3e green | #1a1a1a text
  ============================================= */

  .vsblog-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #1a1a1a;
    box-sizing: border-box;
  }

  *, *::before, *::after { box-sizing: border-box; }

  /* ─── HERO BANNER ─── */
  .vsblog-hero {
    position: relative;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d1f0a 50%, #1a1a1a 100%);
    padding: clamp(60px, 10vw, 110px) 20px;
    overflow: hidden;
    text-align: center;
  }

  .vsblog-hero-orbs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .vsblog-hero-orbs::before {
    content: '';
    position: absolute;
    top: -80px;
    left: -80px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(236,92,10,0.25) 0%, transparent 70%);
    border-radius: 50%;
  }

  .vsblog-hero-orbs::after {
    content: '';
    position: absolute;
    bottom: -100px;
    right: -80px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0,123,62,0.2) 0%, transparent 70%);
    border-radius: 50%;
  }

  /* Hero floating circuit SVG lines */
  .vsblog-hero-circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
  }

  .vsblog-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
  }

  .vsblog-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(236,92,10,0.15);
    border: 1px solid rgba(236,92,10,0.35);
    color: #f97316;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 18px;
  }

  .vsblog-hero h1 {
    font-size: clamp(28px, 6vw, 52px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.18;
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .vsblog-hero h1 span {
    background: linear-gradient(90deg, #ec5c0a, #ff9800);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsblog-hero-desc {
    color: rgba(255,255,255,0.7);
    font-size: clamp(14px, 2.2vw, 18px);
    line-height: 1.55;
    max-width: 620px;
    margin: 0 auto 28px auto;
  }

  /* Breadcrumb */
  .vsblog-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.5);
    font-size: 13px;
  }

  .vsblog-breadcrumb a {
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .vsblog-breadcrumb a:hover { color: #ec5c0a; }
  .vsblog-breadcrumb .sep { color: rgba(255,255,255,0.25); }
  .vsblog-breadcrumb .cur { color: #ec5c0a; font-weight: 600; }

  /* ─── HERO STATS STRIP ─── */
  .vsblog-stats-strip {
    background: #ffffff;
    border-bottom: 2px solid rgba(236,92,10,0.08);
    padding: 0 20px;
  }

  .vsblog-stats-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 0;
  }

  .vsblog-stat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-right: 1px solid #f1f5f9;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }

  .vsblog-stat-item:last-child { border-right: none; }

  .vsblog-stat-item i {
    color: #ec5c0a;
    font-size: 16px;
  }

  .vsblog-stat-item strong {
    color: #1a1a1a;
    font-size: 15px;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .vsblog-stat-item {
      padding: 12px 14px;
      font-size: 12px;
    }
  }

  /* ─── MAIN BODY LAYOUT ─── */
  .vsblog-body {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(30px, 5vw, 60px) 16px;
  }

  /* ─── CATEGORY FILTER BAR ─── */
  .vsblog-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 38px;
    padding-bottom: 22px;
    border-bottom: 2px solid #f1f5f9;
  }

  .vsblog-filter-label {
    font-size: 13px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    white-space: nowrap;
  }

  .vsblog-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex-grow: 1;
  }

  .vsblog-cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 16px;
    border-radius: 50px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    color: #334155;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.22s ease;
    white-space: nowrap;
  }

  .vsblog-cat-btn:hover, .vsblog-cat-btn.active {
    background: #ec5c0a;
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(236,92,10,0.25);
  }

  .vsblog-search {
    display: flex;
    position: relative;
    min-width: 220px;
  }

  .vsblog-search input {
    width: 100%;
    height: 42px;
    padding: 0 42px 0 16px;
    border: 1.5px solid #e2e8f0;
    border-radius: 50px;
    background: #ffffff;
    font-size: 13px;
    font-family: inherit;
    color: #1a1a1a;
    outline: none;
    transition: border-color 0.2s;
  }

  .vsblog-search input:focus { border-color: #ec5c0a; }

  .vsblog-search button {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    font-size: 14px;
    padding: 0;
  }

  /* ─── FEATURED ARTICLE (BIG CARD) ─── */
  .vsblog-featured {
    margin-bottom: 48px;
  }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ec5c0a;
    margin-bottom: 18px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236,92,10,0.4), transparent);
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    border: 1px solid rgba(236,92,10,0.1);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  @media (min-width: 860px) {
    .vsblog-feat-card {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .vsblog-feat-card:hover {
    box-shadow: 0 20px 55px rgba(0,0,0,0.1);
    transform: translateY(-3px);
  }

  .vsblog-feat-img {
    position: relative;
    min-height: 300px;
    overflow: hidden;
  }

  @media (min-width: 860px) {
    .vsblog-feat-img { min-height: 420px; }
  }

  .vsblog-feat-img img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vsblog-feat-card:hover .vsblog-feat-img img { transform: scale(1.04); }

  /* SVG placeholder for featured */
  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d1f0a 100%);
  }

  .vsblog-feat-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: #ec5c0a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 5px 12px;
    border-radius: 50px;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(236,92,10,0.4);
  }

  .vsblog-feat-content {
    padding: clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  .vsblog-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #007b3e;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
    background: rgba(0,123,62,0.08);
    padding: 4px 10px;
    border-radius: 6px;
    width: fit-content;
  }

  .vsblog-feat-content h2 {
    font-size: clamp(18px, 3.2vw, 28px);
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.3;
    margin: 0 0 14px 0;
  }

  .vsblog-feat-content p {
    color: #64748b;
    line-height: 1.65;
    font-size: clamp(13px, 1.6vw, 15px);
    margin: 0 0 22px 0;
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #94a3b8;
    font-weight: 500;
  }

  .vsblog-meta-chip i { color: #ec5c0a; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 50px;
    text-decoration: none;
    width: fit-content;
    transition: all 0.28s ease;
    box-shadow: 0 6px 18px rgba(236,92,10,0.3);
  }

  .vsblog-read-btn:hover {
    transform: translateX(4px);
    box-shadow: 0 10px 24px rgba(236,92,10,0.45);
  }

  /* ─── MAIN GRID + SIDEBAR ─── */
  .vsblog-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 1040px) {
    .vsblog-two-col {
      grid-template-columns: 1fr 340px;
    }
  }

  /* ARTICLE GRID */
  .vsblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 620px) {
    .vsblog-grid { grid-template-columns: 1fr 1fr; }
  }

  .vsblog-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    border: 1px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .vsblog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.09);
    border-color: rgba(236,92,10,0.18);
  }

  .vsblog-card-img {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .vsblog-card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vsblog-card:hover .vsblog-card-img img { transform: scale(1.06); }

  /* SVG placeholder for card thumbnails */
  .vsblog-thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsblog-card-cat-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(26,26,26,0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #f97316;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 4px 10px;
    border-radius: 50px;
    z-index: 2;
    border: 1px solid rgba(236,92,10,0.3);
  }

  .vsblog-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .vsblog-card-title {
    font-size: 15px;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.4;
    margin: 0 0 10px 0;
    text-decoration: none;
    display: block;
    transition: color 0.2s;
  }

  .vsblog-card-title:hover { color: #ec5c0a; }

  .vsblog-card-excerpt {
    font-size: 13px;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  .vsblog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
    gap: 10px;
  }

  .vsblog-card-date {
    font-size: 11.5px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .vsblog-card-date i { color: #ec5c0a; font-size: 11px; }

  .vsblog-card-link {
    font-size: 12.5px;
    font-weight: 700;
    color: #ec5c0a;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    transition: gap 0.2s;
  }

  .vsblog-card-link:hover { gap: 8px; }

  /* PAGINATION */
  .vsblog-pagination {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vsblog-pagination a,
  .vsblog-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    font-size: 14px;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    transition: all 0.2s;
  }

  .vsblog-pagination a:hover {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ec5c0a;
  }

  .vsblog-pagination .current {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 4px 12px rgba(236,92,10,0.3);
  }

  /* ─── SIDEBAR ─── */
  .vsblog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .vsblog-sidebar-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.05);
    border: 1px solid #f1f5f9;
  }

  .vsblog-sidebar-heading {
    font-size: 14px;
    font-weight: 800;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .vsblog-sidebar-heading i { color: #ec5c0a; }

  /* Sidebar Popular Post item */
  .vsblog-sidebar-post {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid #f8fafc;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .vsblog-sidebar-post:last-child { border-bottom: none; padding-bottom: 0; }
  .vsblog-sidebar-post:hover { opacity: 0.78; }

  .vsblog-sidebar-post-num {
    width: 28px;
    height: 28px;
    background: rgba(236,92,10,0.08);
    color: #ec5c0a;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .vsblog-sidebar-post-info h4 {
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px 0;
    line-height: 1.4;
  }

  .vsblog-sidebar-post-info span {
    font-size: 11px;
    color: #94a3b8;
  }

  /* Category Tags Cloud */
  .vsblog-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vsblog-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 13px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    transition: all 0.2s;
  }

  .vsblog-tag-pill:hover {
    background: #ec5c0a;
    border-color: #ec5c0a;
    color: #ffffff;
  }

  /* Sidebar CTA card */
  .vsblog-sidebar-cta {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d1f0a 100%);
    border-radius: 16px;
    padding: 26px;
    text-align: center;
    border: none;
    position: relative;
    overflow: hidden;
  }

  .vsblog-sidebar-cta::before {
    content: '';
    position: absolute;
    top: -30px;
    right: -30px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(236,92,10,0.25) 0%, transparent 70%);
    border-radius: 50%;
  }

  .vsblog-sidebar-cta-icon {
    width: 50px;
    height: 50px;
    background: rgba(236,92,10,0.15);
    border: 1.5px solid rgba(236,92,10,0.3);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: #ec5c0a;
    margin: 0 auto 14px auto;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta h3 {
    font-size: 16px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta p {
    font-size: 12.5px;
    color: rgba(255,255,255,0.6);
    line-height: 1.5;
    margin: 0 0 18px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    padding: 11px 22px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 6px 18px rgba(236,92,10,0.35);
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .vsblog-sidebar-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(236,92,10,0.5);
  }

  /* ─── NEWSLETTER SECTION ─── */
  .vsblog-newsletter {
    margin-top: 60px;
    background: linear-gradient(135deg, #fff8ef 0%, rgba(255,240,220,0.6) 100%);
    border: 1.5px solid rgba(236,92,10,0.15);
    border-radius: 24px;
    padding: clamp(40px, 6vw, 70px) 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .vsblog-newsletter::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(236,92,10,0.07), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-newsletter::after {
    content: '';
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(0,123,62,0.06), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-newsletter-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #ec5c0a, #ff7b00);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #ffffff;
    margin: 0 auto 18px auto;
    box-shadow: 0 8px 22px rgba(236,92,10,0.3);
    position: relative;
    z-index: 1;
  }

  .vsblog-newsletter h2 {
    font-size: clamp(20px, 3.5vw, 30px);
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 10px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-newsletter h2 span { color: #ec5c0a; }

  .vsblog-newsletter p {
