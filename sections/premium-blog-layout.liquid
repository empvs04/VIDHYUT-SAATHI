{% schema %}
{
  "name": "Premium Blog Layout",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero Eyebrow Badge",
      "default": "Vidhyut Saathi Knowledge Hub"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title (use <span> for highlight)",
      "default": "Insights on Energy Savings"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Expert articles, franchise success stories, and tips to lower electricity bills across India."
    },
    {
      "type": "text",
      "id": "blog_handle",
      "label": "Blog Handle (e.g. 'news')",
      "default": "news"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 4,
      "max": 18,
      "step": 2,
      "default": 6,
      "label": "Articles Per Page"
    }
  ],
  "presets": [
    {
      "name": "Premium Blog Layout"
    }
  ]
}
{% endschema %}
