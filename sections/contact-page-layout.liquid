  /* Map Card Container */
  /* Map Card Container (Full Width across both columns on Desktop) */
  .vs-map-card {
    grid-column: 1 / -1 !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    border: 1.5px solid rgba(236, 92, 10, 0.22) !important;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06) !important;
    position: relative !important;
    margin-top: 10px !important;
    width: 100% !important;
  }

  .vs-map-card iframe {
    width: 100% !important;
    height: 220px !important;
    border: none !important;
    display: block !important;
  }

  .vs-map-link {
    display: block !important;
    background: #0F172A !important;
    color: #FFFFFF !important;
    text-align: center !important;
    padding: 14px 18px !important;
    font-size: clamp(0.82rem, 1.8vw, 0.9rem) !important;
