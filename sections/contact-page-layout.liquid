{% comment %}
  =============================================================================
  VIDHYUT SAATHI - CONTACT US PAGE LAYOUT (MATCHING REFERENCE DESIGN 100%)
  =============================================================================
{% endcomment %}

{%- style -%}
  .vs-contact-section,
  .vs-contact-section * {
    box-sizing: border-box !important;
  }

  .vs-contact-section {
    display: block !important;
    width: 100% !important;
    clear: both !important;
    position: relative !important;
    padding: 80px 24px 100px 24px !important;
    background: linear-gradient(180deg, #FAFAF7 0%, #FFFFFF 50%, #FFFDF8 100%) !important;
    color: #1A1A1A !important;
    overflow: hidden !important;
  }

  .vs-contact-container {
    max-width: 1240px !important;
    margin: 0 auto !important;
    position: relative !important;
    z-index: 2 !important;
  }

  /* Header Block */
  .vs-contact-header {
    text-align: center !important;
    max-width: 780px !important;
    margin: 0 auto 50px auto !important;
  }

  .vs-contact-badge {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 7px 20px !important;
    border-radius: 50px !important;
    background: linear-gradient(135deg, #FFF3EB 0%, #FFE8D6 100%) !important;
    border: 1.5px solid rgba(236, 92, 10, 0.4) !important;
    color: #EC5C0A !important;
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    letter-spacing: 1px !important;
    margin-bottom: 16px !important;
    text-transform: uppercase !important;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.12) !important;
  }

  .vs-pulse-dot {
    width: 8px !important;
    height: 8px !important;
    background: #EC5C0A !important;
    border-radius: 50% !important;
    display: inline-block !important;
    box-shadow: 0 0 0 rgba(236, 92, 10, 0.4) !important;
    animation: vsPulse 2s infinite !important;
  }

  @keyframes vsPulse {
    0% { box-shadow: 0 0 0 0 rgba(236, 92, 10, 0.7); }
    70% { box-shadow: 0 0 0 8px rgba(236, 92, 10, 0); }
    100% { box-shadow: 0 0 0 0 rgba(236, 92, 10, 0); }
  }

  .vs-contact-title {
    font-size: 2.8rem !important;
    font-weight: 900 !important;
    line-height: 1.25 !important;
    color: #0F172A !important;
    margin: 0 0 12px 0 !important;
    letter-spacing: -0.4px !important;
  }

  .vs-contact-subtitle {
    font-size: 1.05rem !important;
    font-weight: 500 !important;
    color: #64748B !important;
    line-height: 1.65 !important;
    margin: 0 auto !important;
  }

  /* 2-Column Split Section Grid */
  .vs-contact-grid {
    display: grid !important;
    grid-template-columns: 1fr 1.25fr !important;
    gap: 32px !important;
    align-items: stretch !important;
    width: 100% !important;
  }

  /* LEFT COLUMN CARD (Vidhyut Saathi Light Theme Card) */
  .vs-info-card {
    background: linear-gradient(145deg, #FFF5EB 0%, #FFFFFF 50%, #F0FDF4 100%) !important;
    border: 2px solid rgba(236, 92, 10, 0.25) !important;
    border-top: 5px solid #EC5C0A !important;
    border-radius: 24px !important;
    padding: 44px 38px !important;
    color: #0F172A !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.1), 0 5px 20px rgba(0, 0, 0, 0.02) !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .vs-info-card::after {
    content: '' !important;
    position: absolute !important;
    bottom: -60px; right: -60px;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, transparent 70%) !important;
    border-radius: 50% !important;
    pointer-events: none !important;
  }

  .vs-info-tag {
    color: #EC5C0A !important;
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    margin-bottom: 12px !important;
    display: block !important;
  }

  .vs-info-heading {
    font-size: 1.85rem !important;
    font-weight: 900 !important;
    color: #0F172A !important;
    line-height: 1.3 !important;
    margin: 0 0 16px 0 !important;
  }

  .vs-info-desc {
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    color: #475569 !important;
    line-height: 1.65 !important;
    margin-bottom: 35px !important;
    padding-bottom: 25px !important;
    border-bottom: 1px solid rgba(236, 92, 10, 0.15) !important;
  }

  /* Info Blocks List */
  .vs-info-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 28px !important;
  }

  .vs-info-item {
    display: flex !important;
    align-items: flex-start !important;
    gap: 18px !important;
  }

  .vs-info-icon {
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
    min-height: 46px !important;
    border-radius: 14px !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.2rem !important;
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.3) !important;
    flex-shrink: 0 !important;
  }

  .vs-info-text h4 {
    font-size: 1.05rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    margin: 0 0 6px 0 !important;
  }

  .vs-info-text p,
  .vs-info-text a {
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    color: #334155 !important;
    line-height: 1.55 !important;
    margin: 0 !important;
    text-decoration: none !important;
    display: block !important;
    transition: color 0.25s ease !important;
  }

  .vs-info-text a:hover {
    color: #EC5C0A !important;
  }

  /* RIGHT COLUMN CARD (Luxury Glassmorphic White Form Card) */
  .vs-form-card {
    background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF8 100%) !important;
    border: 2px solid rgba(236, 92, 10, 0.22) !important;
    border-top: 5px solid #EC5C0A !important;
    border-radius: 24px !important;
    padding: 44px 42px !important;
    box-shadow: 0 25px 60px rgba(236, 92, 10, 0.1), 0 5px 20px rgba(0, 0, 0, 0.03) !important;
  }

  .vs-form-title {
    font-size: 1.85rem !important;
    font-weight: 900 !important;
    color: #0F172A !important;
    margin: 0 0 8px 0 !important;
  }

  .vs-form-subtitle {
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    color: #64748B !important;
    line-height: 1.6 !important;
    margin-bottom: 28px !important;
  }

  .vs-form-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 18px !important;
  }

  .vs-form-group.full-width {
    grid-column: 1 / -1 !important;
  }

  .vs-form-group label {
    display: block !important;
    font-size: 0.84rem !important;
    font-weight: 800 !important;
    color: #334155 !important;
    margin-bottom: 8px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
  }

  .vs-input-field {
    width: 100% !important;
    padding: 14px 18px !important;
    font-size: 0.95rem !important;
    font-family: inherit !important;
    color: #0F172A !important;
    background: #F8FAFC !important;
    border: 1.5px solid #CBD5E1 !important;
    border-radius: 12px !important;
    outline: none !important;
    transition: all 0.3s ease !important;
  }

  .vs-input-field:focus {
    background: #FFFFFF !important;
    border-color: #EC5C0A !important;
    box-shadow: 0 0 0 4px rgba(236, 92, 10, 0.15) !important;
  }

  textarea.vs-input-field {
    min-height: 120px !important;
    resize: vertical !important;
  }

  .vs-submit-btn {
    width: 100% !important;
    padding: 16px 28px !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    font-size: 1rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.8px !important;
    text-transform: uppercase !important;
    border: none !important;
    border-radius: 12px !important;
    cursor: pointer !important;
    box-shadow: 0 10px 25px rgba(236, 92, 10, 0.35) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    margin-top: 10px !important;
  }

  .vs-submit-btn:hover {
    background: linear-gradient(135deg, #FF9A00 0%, #EC5C0A 100%) !important;
    transform: translateY(-3px) !important;
    box-shadow: 0 15px 35px rgba(236, 92, 10, 0.45) !important;
  }

  /* MOBILE RESPONSIVE FIXES (100% CLEAN ALIGNMENT) */
  @media screen and (max-width: 991px) {
    .vs-contact-section {
      padding: 45px 16px 60px 16px !important;
    }

    .vs-contact-header {
      margin-bottom: 30px !important;
    }

    .vs-contact-title {
      font-size: 1.75rem !important;
    }

    .vs-contact-subtitle {
      font-size: 0.88rem !important;
    }

    .vs-contact-grid {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }

    .vs-info-card {
      padding: 30px 20px !important;
      border-radius: 18px !important;
    }

    .vs-info-heading {
      font-size: 1.45rem !important;
    }

    .vs-info-desc {
      font-size: 0.88rem !important;
      margin-bottom: 24px !important;
      padding-bottom: 18px !important;
    }

    .vs-info-list {
      gap: 20px !important;
    }

    .vs-form-card {
      padding: 28px 18px !important;
      border-radius: 18px !important;
    }

    .vs-form-title {
      font-size: 1.45rem !important;
    }

    .vs-form-subtitle {
      font-size: 0.86rem !important;
      margin-bottom: 20px !important;
    }

    .vs-form-grid {
      grid-template-columns: 1fr !important;
      gap: 14px !important;
    }

    .vs-form-group.full-width {
      grid-column: auto !important;
    }

    .vs-input-field {
      padding: 12px 14px !important;
      font-size: 0.9rem !important;
    }

    .vs-submit-btn {
      padding: 14px 20px !important;
      font-size: 0.95rem !important;
    }
  }
{%- endstyle -%}

<section class="vs-contact-section" id="vsContactSection">
  <div class="vs-contact-container">
    
    <!-- Header Block -->
    <div class="vs-contact-header">
      <div class="vs-contact-badge">
        <span class="vs-pulse-dot"></span>
        <span>⚡ OFFICIAL HELP &amp; SUPPORT</span>
      </div>
      <h1 class="vs-contact-title">Contact us</h1>
      <p class="vs-contact-subtitle">We would love to hear from you. Reach out to our energy management team for load audits, product inquiries, and franchise support.</p>
    </div>

    <!-- 2-Column Split Section Grid (Matching Reference Screenshot) -->
    <div class="vs-contact-grid">
      
      <!-- LEFT COLUMN CARD: Dark Branded Info Card -->
      <div class="vs-info-card">
        <div>
          <span class="vs-info-tag">GET IN TOUCH</span>
          <h2 class="vs-info-heading">Don't hesitate to contact us for more information.</h2>
          <p class="vs-info-desc">Vidhyut Saathi Energy Saver Pvt Ltd is dedicated to helping you save up to 30% on electricity bills with zero maintenance.</p>

          <!-- Contact Info List -->
          <div class="vs-info-list">
            
            <!-- 📍 Head Office -->
            <div class="vs-info-item">
              <div class="vs-info-icon">📍</div>
              <div class="vs-info-text">
                <h4>Head Office</h4>
                <p>Vidhyut Saathi Energy Saver Pvt. Ltd.<br>Ashoka Complex, Delhi Road, Rohtak, Haryana - 124001, India</p>
              </div>
            </div>

            <!-- ✉️ Email Us -->
            <div class="vs-info-item">
              <div class="vs-info-icon">✉️</div>
              <div class="vs-info-text">
                <h4>Email Us</h4>
                <a href="mailto:emp.vs04@gmail.com">emp.vs04@gmail.com</a>
                <a href="mailto:info@vidhyutsaathi.com">info@vidhyutsaathi.com</a>
              </div>
            </div>

            <!-- 📞 Call Us -->
            <div class="vs-info-item">
              <div class="vs-info-icon">📞</div>
              <div class="vs-info-text">
                <h4>Call us</h4>
                <a href="tel:+918199036060">Phone: +91 81990 36060</a>
                <a href="tel:+919999999999">Support: +91 99999 99999</a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN CARD: Luxury Glassmorphic White Form Card -->
      <div class="vs-form-card">
        <h2 class="vs-form-title">Send us a message</h2>
        <p class="vs-form-subtitle">Fill out the form below and our energy experts will get back to you within 24 hours.</p>

        {%- form 'contact', id: 'vsContactPageForm' -%}
          {%- if form.posted_successfully? -%}
            <div style="padding: 14px 20px; background: #E8F5E9; border: 1.5px solid #2E7D32; border-radius: 12px; color: #2E7D32; font-weight: 700; margin-bottom: 20px; font-size: 0.92rem;">
              ✅ Thank you! Your message has been sent successfully. Our team will contact you shortly.
            </div>
          {%- elsif form.errors -%}
            <div style="padding: 14px 20px; background: #FFEBEE; border: 1.5px solid #C62828; border-radius: 12px; color: #C62828; font-weight: 700; margin-bottom: 20px; font-size: 0.92rem;">
              ⚠️ Please fill out all required fields correctly.
            </div>
          {%- endif -%}

          <div class="vs-form-grid">
            
            <!-- Name -->
            <div class="vs-form-group">
              <label for="contact_name">Name</label>
              <input type="text" id="contact_name" name="contact[name]" class="vs-input-field" placeholder="Your Full Name" required>
            </div>

            <!-- Company -->
            <div class="vs-form-group">
              <label for="contact_company">Company</label>
              <input type="text" id="contact_company" name="contact[company]" class="vs-input-field" placeholder="Company Name (Optional)">
            </div>

            <!-- Phone -->
            <div class="vs-form-group">
              <label for="contact_phone">Phone</label>
              <input type="tel" id="contact_phone" name="contact[phone]" class="vs-input-field" placeholder="+91 98765 43210" required>
            </div>

            <!-- Email -->
            <div class="vs-form-group">
              <label for="contact_email">Email</label>
              <input type="email" id="contact_email" name="contact[email]" class="vs-input-field" placeholder="name@domain.com" required>
            </div>

            <!-- Subject -->
            <div class="vs-form-group full-width">
              <label for="contact_subject">Subject</label>
              <input type="text" id="contact_subject" name="contact[Subject]" class="vs-input-field" placeholder="e.g. Product Inquiry / Franchise Inquiry" required>
            </div>

            <!-- Message -->
            <div class="vs-form-group full-width">
              <label for="contact_message">Message</label>
              <textarea id="contact_message" name="contact[body]" class="vs-input-field" placeholder="Type your message here..." required></textarea>
            </div>

            <!-- Submit Button -->
            <div class="vs-form-group full-width">
              <button type="submit" class="vs-submit-btn">SEND MESSAGE</button>
            </div>

          </div>
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vidhyut Contact Us Page",
  "settings": [],
  "presets": [
    {
      "name": "Vidhyut Contact Us Page"
    }
  ]
}
{% endschema %}
