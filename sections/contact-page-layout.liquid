{% comment %}
  =============================================================================
  VIDHYUT SAATHI - PREMIUM HIGH-CONVERTING CONTACT US PAGE (100% MOBILE PERFECT)
  =============================================================================
{% endcomment %}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');

  html, body {
    overflow-x: hidden !important;
  }

  .vs-contact-section,
  .vs-contact-section * {
    box-sizing: border-box !important;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .vs-contact-section {
    display: block !important;
    width: 100% !important;
    max-width: 100vw !important;
    clear: both !important;
    position: relative !important;
    padding: 0 clamp(14px, 4vw, 24px) 0 clamp(14px, 4vw, 24px) !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
    background: radial-gradient(circle at 50% 0%, rgba(236, 92, 10, 0.08) 0%, #FAFAF7 40%, #FFFFFF 100%) !important;
    color: #1A1A1A !important;
    overflow: hidden !important;
  }

  .vs-contact-container {
    max-width: 1280px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
    position: relative !important;
    z-index: 3 !important;
  }

  /* 1ST SECTION: HERO BANNER (#141E5C) */
  .vs-top-marquee-header-banner {
    position: relative !important;
    width: 100vw !important;
    left: 50% !important;
    right: 50% !important;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    min-height: clamp(340px, 36vw, 440px) !important;
    background-color: #141E5C !important;
    background-image: linear-gradient(135deg, #141E5C 0%, #17236B 50%, #1A2878 100%) !important;
    border-top: 3px solid #10B981 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    margin-top: 0 !important;
    margin-bottom: clamp(35px, 5vw, 60px) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding: clamp(35px, 5vw, 60px) clamp(20px, 6vw, 85px) !important;
    overflow: hidden !important;
    z-index: 2 !important;
    box-sizing: border-box !important;
  }

  /* Wireframe Accent Boxes from Screenshot */
  .vs-tech-box-1 {
    position: absolute !important;
    top: 20px !important;
    right: 15% !important;
    width: 260px !important;
    height: 180px !important;
    border: 1.5px solid rgba(236, 92, 10, 0.25) !important;
    border-right: none !important;
    border-bottom: none !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .vs-tech-box-1 .vs-tech-dot {
    position: absolute !important;
    bottom: -5px !important;
    left: -5px !important;
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: #EC5C0A !important;
    box-shadow: 0 0 10px #EC5C0A !important;
  }

  .vs-tech-box-2 {
    position: absolute !important;
    bottom: 20px !important;
    right: 28% !important;
    width: 320px !important;
    height: 160px !important;
    border: 1.5px solid rgba(16, 185, 129, 0.25) !important;
    border-left: none !important;
    border-bottom: none !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .vs-tech-box-2 .vs-tech-dot {
    position: absolute !important;
    bottom: -5px !important;
    right: -5px !important;
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: #10B981 !important;
    box-shadow: 0 0 10px #10B981 !important;
  }

  /* Tech Circuit Grid Overlay */
  .vs-top-marquee-header-banner::before {
    content: '' !important;
    position: absolute !important;
    top: 0; left: 0; right: 0; bottom: 0 !important;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px) !important;
    background-size: 40px 40px !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  @keyframes vsMarqueeLeftToRight {
    0% { transform: translate3d(-50%, -50%, 0); }
    100% { transform: translate3d(0%, -50%, 0); }
  }

  .vs-top-header-marquee {
    position: absolute !important;
    top: 50% !important;
    left: 0 !important;
    width: 200% !important;
    white-space: nowrap !important;
    z-index: 1 !important;
    opacity: 0.08 !important;
    pointer-events: none !important;
    line-height: 1 !important;
    font-size: clamp(60px, 12vw, 150px) !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
    letter-spacing: 4px !important;
    display: inline-block !important;
    will-change: transform !important;
    animation: vsMarqueeLeftToRight 22s linear infinite !important;
  }

  /* Section 1 Content Box */
  .vs-hero-content-box {
    position: relative !important;
    z-index: 3 !important;
    max-width: 820px !important;
    text-align: left !important;
  }

  .vs-hero-pill-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 7px 20px !important;
    background: rgba(255, 204, 0, 0.08) !important;
    border: 1.5px solid rgba(255, 204, 0, 0.45) !important;
    border-radius: 50px !important;
    color: #FFCC00 !important;
    font-size: clamp(0.72rem, 1.4vw, 0.84rem) !important;
    font-weight: 800 !important;
    letter-spacing: 1.2px !important;
    text-transform: uppercase !important;
    margin-bottom: 22px !important;
    box-shadow: 0 4px 20px rgba(255, 204, 0, 0.15) !important;
  }

  .vs-hero-title {
    font-size: clamp(2.1rem, 4.8vw, 3.6rem) !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
    line-height: 1.16 !important;
    margin: 0 0 16px 0 !important;
    letter-spacing: -0.5px !important;
  }

  .vs-hero-title span.vs-highlight {
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  .vs-hero-subhead {
    font-size: clamp(0.92rem, 1.8vw, 1.12rem) !important;
    color: #CBD5E1 !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
    margin: 0 0 16px 0 !important;
    max-width: 680px !important;
  }

  .vs-hero-hindi-slogan {
    font-size: clamp(1.05rem, 2vw, 1.3rem) !important;
    font-weight: 800 !important;
    color: #FFCC00 !important;
    margin: 0 !important;
    letter-spacing: 0.5px !important;
  }

  @media screen and (max-width: 768px) {
    .vs-top-marquee-header-banner {
      min-height: auto !important;
      padding: 34px 18px 28px 18px !important;
    }

    .vs-tech-box-1,
    .vs-tech-box-2 {
      display: none !important;
    }

    .vs-hero-pill-badge {
      padding: 6px 14px !important;
      font-size: 0.72rem !important;
      margin-bottom: 14px !important;
    }

    .vs-hero-title {
      font-size: clamp(1.65rem, 6.2vw, 2.2rem) !important;
      line-height: 1.25 !important;
      margin-bottom: 12px !important;
    }

    .vs-hero-subhead {
      font-size: 0.88rem !important;
      line-height: 1.55 !important;
      margin-bottom: 14px !important;
    }

    .vs-hero-hindi-slogan {
      font-size: 0.98rem !important;
    }
  }

  /* Header Block */
  .vs-contact-header {
    text-align: center !important;
    max-width: 840px !important;
    margin: 0 auto clamp(25px, 5vw, 40px) auto !important;
    position: relative;
    z-index: 2;
  }

  .vs-contact-badge {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 8px 20px !important;
    border-radius: 50px !important;
    background: linear-gradient(135deg, #FFF3EB 0%, #FFE8D6 100%) !important;
    border: 1.5px solid rgba(236, 92, 10, 0.4) !important;
    color: #EC5C0A !important;
    font-size: clamp(0.72rem, 2vw, 0.85rem) !important;
    font-weight: 800 !important;
    letter-spacing: 1px !important;
    margin-bottom: 16px !important;
    text-transform: uppercase !important;
    box-shadow: 0 4px 20px rgba(236, 92, 10, 0.15) !important;
    max-width: 100% !important;
  }

  .vs-pulse-dot {
    width: 8px !important;
    height: 8px !important;
    min-width: 8px !important;
    background: #10B981 !important;
    border-radius: 50% !important;
    display: inline-block !important;
    box-shadow: 0 0 0 rgba(16, 185, 129, 0.4) !important;
    animation: vsPulseGreen 2s infinite !important;
    flex-shrink: 0 !important;
  }

  @keyframes vsPulseGreen {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .vs-contact-title {
    font-size: clamp(1.8rem, 5vw, 3.2rem) !important;
    font-weight: 900 !important;
    line-height: 1.2 !important;
    color: #0F172A !important;
    margin: 0 0 14px 0 !important;
    letter-spacing: -0.5px !important;
  }

  .vs-contact-title span {
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vs-contact-subtitle {
    font-size: clamp(0.92rem, 2.5vw, 1.15rem) !important;
    font-weight: 500 !important;
    color: #475569 !important;
    line-height: 1.65 !important;
    margin: 0 auto clamp(20px, 4vw, 30px) auto !important;
    max-width: 720px !important;
  }

  /* Trust Highlights Bar (Lucrative Theme on Desktop & Mobile) */
  .vs-trust-highlights {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    grid-auto-rows: 1fr !important;
    gap: clamp(10px, 2vw, 18px) !important;
    max-width: 1280px !important;
    margin: 0 auto clamp(30px, 5vw, 45px) auto !important;
    align-items: stretch !important;
  }

  .vs-trust-item {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFFDF8 50%, #FFF5EB 100%) !important;
    border: 1.5px solid rgba(236, 92, 10, 0.32) !important;
    border-top: 4px solid #EC5C0A !important;
    padding: 16px 18px !important;
    border-radius: 20px !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    box-shadow: 0 10px 28px rgba(236, 92, 10, 0.12), 0 2px 8px rgba(0, 0, 0, 0.02) !important;
    transition: all 0.3s ease !important;
    height: 100% !important;
    box-sizing: border-box !important;
  }

  .vs-trust-item:hover {
    transform: translateY(-4px) !important;
    border-color: #EC5C0A !important;
    box-shadow: 0 15px 35px rgba(236, 92, 10, 0.22) !important;
  }

  .vs-trust-icon {
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    border-radius: 12px !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.25rem !important;
    box-shadow: 0 6px 18px rgba(236, 92, 10, 0.32) !important;
    flex-shrink: 0 !important;
  }

  .vs-trust-text h5 {
    margin: 0 !important;
    font-size: clamp(0.85rem, 1.8vw, 0.98rem) !important;
    font-weight: 900 !important;
    color: #0F172A !important;
    line-height: 1.25 !important;
  }

  .vs-trust-text p {
    margin: 2px 0 0 0 !important;
    font-size: clamp(0.72rem, 1.5vw, 0.8rem) !important;
    color: #EC5C0A !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
  }

  /* 3RD SECTION: MAIN 2-COLUMN ACTION & FORM GRID (LUCRATIVE & CLEAN) */
  .vs-contact-grid {
    display: grid !important;
    grid-template-columns: 1fr 1.25fr !important;
    gap: clamp(24px, 4vw, 42px) !important;
    align-items: stretch !important;
    width: 100% !important;
    margin-bottom: clamp(45px, 6vw, 75px) !important;
  }

  /* LEFT COLUMN CARD (Lucrative & Spacious) */
  .vs-info-card {
    background: #FFFFFF !important;
    border: 1.5px solid #F1F5F9 !important;
    border-radius: clamp(22px, 3.5vw, 32px) !important;
    padding: clamp(32px, 4.5vw, 50px) clamp(24px, 4vw, 44px) !important;
    color: #0F172A !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.04), 0 4px 12px rgba(0, 0, 0, 0.02) !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .vs-info-tag {
    display: inline-flex !important;
    align-items: center !important;
