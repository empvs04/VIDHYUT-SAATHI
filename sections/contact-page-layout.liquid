<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Chips Selection Logic
    const chips = document.querySelectorAll('#vsChipsGrid .vs-chip');
    const subjectInput = document.getElementById('contact_subject');

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        chips.forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        if (subjectInput) {
          subjectInput.value = this.getAttribute('data-value');
        }
      });
    });

    // 4 Reviews Carousel Slider Handler
    let vsCurrentReviewIdx = 0;
    window.vsShowReview = function(idx) {
      const slides = document.querySelectorAll('#vsReviewCard .vs-review-slide');
      const dots = document.querySelectorAll('#vsReviewCard .vs-review-dot');
      if (!slides.length) return;
      if (idx >= slides.length) idx = 0;
      if (idx < 0) idx = slides.length - 1;
      vsCurrentReviewIdx = idx;
      slides.forEach(function(slide, i) {
        slide.style.display = (i === idx) ? 'block' : 'none';
        slide.classList.toggle('active', i === idx);
      });
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === idx);
      });
    };

    window.vsNextReview = function(dir) {
      window.vsShowReview(vsCurrentReviewIdx + dir);
    };

    // Auto rotate reviews every 5 seconds
    setInterval(function() {
      window.vsNextReview(1);
    }, 5000);

    // FAQ Accordion Toggle
    const faqItems = document.querySelectorAll('.vs-faq-item');
    faqItems.forEach(function(item) {
      const question = item.querySelector('.vs-faq-question');
      if (question) {
        question.addEventListener('click', function() {
          const isActive = item.classList.contains('active');
          faqItems.forEach(i => i.classList.remove('active'));
          if (!isActive) {
            item.classList.add('active');
          }
        });
      }
    });
    // Section 2 "What Makes Us Best" Mobile Auto-Slider on View (3 Seconds)
    (function() {
      const bestSection = document.querySelector('.vs-best-section');
      const bestGrid = document.querySelector('.vs-best-grid');
      const bestDots = document.querySelectorAll('.vs-best-dot');
      const prevBtn = document.getElementById('vsBestPrevBtn');
      const nextBtn = document.getElementById('vsBestNextBtn');
      if (!bestSection || !bestGrid || !bestDots.length) return;

      let currentIndex = 0;
      const totalCards = bestDots.length;
      let autoSlideTimer = null;
      let isObserverActive = false;

      function scrollToIndex(index) {
        if (window.innerWidth > 767) return;
        const cards = bestGrid.querySelectorAll('.vs-best-card');
        if (!cards[index]) return;

        const card = cards[index];
        const scrollLeft = card.offsetLeft - (bestGrid.offsetWidth - card.offsetWidth) / 2;
        bestGrid.scrollTo({
          left: scrollLeft,
          behavior: 'smooth'
        });

        bestDots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });
      }

      function nextSlide() {
        currentIndex = (currentIndex + 1) % totalCards;
        scrollToIndex(currentIndex);
      }

      function prevSlide() {
        currentIndex = (currentIndex - 1 + totalCards) % totalCards;
        scrollToIndex(currentIndex);
      }

      function startAutoSlide() {
        stopAutoSlide();
        if (window.innerWidth <= 767 && isObserverActive) {
          autoSlideTimer = setInterval(nextSlide, 3000); // 3 Seconds Auto Transition
        }
      }

      function stopAutoSlide() {
        if (autoSlideTimer) clearInterval(autoSlideTimer);
      }

      // IntersectionObserver: Start 3-second auto-slide ONLY when user scrolls to Section 2
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              isObserverActive = true;
              startAutoSlide();
            } else {
              isObserverActive = false;
              stopAutoSlide();
            }
          });
        }, { threshold: 0.15 });

        observer.observe(bestSection);
      } else {
        isObserverActive = true;
        startAutoSlide();
      }

      // Touch handlers
      bestGrid.addEventListener('touchstart', stopAutoSlide, { passive: true });
      bestGrid.addEventListener('touchend', () => {
        setTimeout(startAutoSlide, 4000);
      }, { passive: true });

      // Arrow button click handlers
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          startAutoSlide();
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          startAutoSlide();
        });
      }

      // Dot click handlers
      bestDots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          currentIndex = idx;
          scrollToIndex(idx);
          startAutoSlide();
        });
      });
    })();
  });

  function vsCopyText(text, el) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text);
      var orig = el.innerHTML;
      el.innerHTML = text + ' <small style="color:#10B981;font-weight:bold;">✅ Copied!</small>';
      setTimeout(function() { el.innerHTML = orig; }, 2200);
    }
  }
</script>

