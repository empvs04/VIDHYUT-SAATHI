  }

  /* Verified Customer Review Card (Matching Screenshot Design with 4 Carousel Reviews) */
  .vs-customer-review-card {
    background: #FFFDF9 !important;
    border: 1.5px dashed rgba(247, 148, 29, 0.5) !important;
    border-radius: 20px !important;
