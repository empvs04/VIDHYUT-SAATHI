{% render 'vs-residential-styles' %}

<div class="vsres">
  <!-- ══ RESIDENTIAL HOME SIZING & REQUIREMENT CHART ══ -->
  <section class="vsres-sec" id="vsres-sizing-chart">
    <div class="wrap">
      <div class="vsres-sec-head">
        <div class="vsres-sec-eyebrow"><i class="fa-solid fa-table-cells"></i> {{ section.settings.eyebrow | default: 'Home Sizing Reference' }}</div>
        <h2 class="vsres-sec-title">{{ section.settings.title_prefix | default: 'Residential Home' }} <span>{{ section.settings.title_highlight | default: 'Sizing and Requirement Chart' }}</span></h2>
        <p class="vsres-sec-desc">
          {{ section.settings.desc | default: 'Quick reference table based on house type, connected load (KW), and typical monthly electricity bill brackets.' }}
        </p>
      </div>

      <div class="vsres-table-wrap">
        <table class="vsres-table">
          <thead>
            <tr>
              <th>House Type</th>
              <th>Load (KW)</th>
              <th>Monthly Bill</th>
              <th>Single-Phase</th>
              <th>3-Phase</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1 BHK Flat / Studio</td>
              <td>1–3 KW</td>
              <td>Up to Rs.4,000</td>
              <td class="highlight">1 Card</td>
              <td class="highlight">2 Cards</td>
            </tr>
            <tr>
              <td>2 BHK Apartment (1 AC)</td>
              <td>4–6 KW</td>
              <td>Rs.4,001 – Rs.7,000</td>
              <td class="highlight">1 Card</td>
              <td class="highlight">2 Cards</td>
            </tr>
            <tr>
              <td>3 BHK Apartment (2 ACs)</td>
              <td>7–12 KW</td>
              <td>Rs.7,001 – Rs.13,000</td>
              <td class="highlight">2 Cards</td>
              <td class="highlight">3 Cards</td>
            </tr>
            <tr>
              <td>4 BHK House / Duplex (3+ ACs)</td>
              <td>13–18 KW</td>
              <td>Rs.13,001 – Rs.19,000</td>
              <td class="highlight">3 Cards</td>
              <td class="highlight">4 Cards</td>
            </tr>
            <tr>
              <td>Independent Villa / Bungalow</td>
              <td>19–24 KW</td>
              <td>Rs.19,001 – Rs.26,000</td>
              <td class="highlight">4 Cards</td>
              <td class="highlight">5 Cards</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Residential - Sizing Chart",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Home Sizing Reference"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title Prefix",
      "default": "Residential Home"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight",
      "default": "Sizing and Requirement Chart"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Quick reference table based on house type, connected load (KW), and typical monthly electricity bill brackets."
    }
  ],
  "presets": [
    {
      "name": "Residential - Sizing Chart"
    }
  ]
}
{% endschema %}
