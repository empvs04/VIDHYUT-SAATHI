    <img src="" alt="Full Preview" class="gms-modal-img" id="gmsModalImg-{{ section.id }}">
  </div>
</div>

<script>
  (function() {
    function initGalleryShowcase_{{ section.id | replace: '-', '_' }}() {
      const filterBtns = document.querySelectorAll('#gmsRibbonFilters-{{ section.id }} .gms-ribbon-btn');
      const cards = document.querySelectorAll('#gmsPhotoGrid-{{ section.id }} .gms-photo-card');
      const modal = document.getElementById('gmsModalOverlay-{{ section.id }}');
      const modalImg = document.getElementById('gmsModalImg-{{ section.id }}');
      const modalClose = document.getElementById('gmsModalClose-{{ section.id }}');

      if (!filterBtns.length || !cards.length) return;

      // Filter Button Switch Logic
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const filterValue = this.getAttribute('data-filter');

          filterBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');

          cards.forEach(card => {
            const cardCategory = card.getAttribute('data-category');
            if (filterValue === 'all' || cardCategory === filterValue) {
              card.classList.remove('gms-hidden');
            } else {
              card.classList.add('gms-hidden');
            }
          });
        });
      });

      // Lightbox Image Popup Modal
      cards.forEach(card => {
        card.addEventListener('click', function() {
          const fullImgSrc = this.getAttribute('data-full-img') || this.querySelector('img').src;
          if (modal && modalImg) {
            modalImg.src = fullImgSrc;
            modal.classList.add('active');
          }
        });
      });

      if (modalClose) {
        modalClose.addEventListener('click', function() {
          if (modal) modal.classList.remove('active');
        });
      }

      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            modal.classList.remove('active');
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGalleryShowcase_{{ section.id | replace: '-', '_' }});
    } else {
      initGalleryShowcase_{{ section.id | replace: '-', '_' }}();
    }
  })();
</script>

