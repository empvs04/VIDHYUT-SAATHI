<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800;900&family=Caveat:wght@600;700&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

{%- style -%}
  /* ===========================================================================
     SECTION 1: THEME-BASED LUCRATIVE DELIVERY TRACKER HERO
     Vidhyut Saathi Orange & Green GPS Highway + Animated EV Courier Van
     =========================================================================== */
  /* Full Width Page Container - 100% Viewport Fit */
  .dm-section-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  #deliveryMapHero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: clamp(520px, 76vh, 640px);
    min-height: clamp(520px, 76vh, 640px);
    background: radial-gradient(circle at 50% 20%, #ffffff 0%, #fff8ef 50%, #fef3e2 100%);
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    padding: clamp(25px, 4vh, 45px) clamp(20px, 4vw, 50px) 35px;
  }

  /* Desktop Single Viewport Fit (100% Single Screen Fit without Scrolling) */
  @media screen and (min-width: 769px) {
    #deliveryMapHero-{{ section.id }} {
      height: calc(100vh - 165px) !important;
      min-height: 500px !important;
      max-height: 600px !important;
      padding: clamp(20px, 3vh, 32px) 40px 25px !important;
    }

    .dm-title {
      font-size: clamp(26px, 3.6vw, 44px) !important;
      margin-bottom: 8px !important;
    }

    .dm-subtitle {
      font-size: clamp(13.5px, 1.3vw, 15px) !important;
      margin-bottom: 14px !important;
      line-height: 1.45 !important;
    }

    .dm-stats-pills-row {
      margin-bottom: 14px !important;
    }
  }

  /* Light Navigation Map Vector Background */
  .dm-map-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    perspective: 1000px;
  }

  /* Vidhyut Ambient Glows in Background */
  .dm-ambient-glow-orange {
    position: absolute;
    bottom: -5%;
    left: 5%;
    width: 50vw;
    height: 380px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.14) 0%, rgba(236, 92, 10, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .dm-ambient-glow-green {
    position: absolute;
    bottom: -5%;
    right: 5%;
    width: 50vw;
    height: 380px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.14) 0%, rgba(0, 123, 62, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .dm-street-network {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(rgba(236, 92, 10, 0.08) 1.5px, transparent 1.5px),
      radial-gradient(rgba(0, 123, 62, 0.06) 1.5px, transparent 1.5px);
    background-size: 36px 36px;
    background-position: 0 0, 18px 18px;
    opacity: 0.65;
    pointer-events: none;
  }

  .dm-upper-vignette {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.6) 60%, rgba(255,255,255,0) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* SVG Highway Map Canvas */
  .dm-svg-map-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }

  /* Animated Courier Highway Path Lines */
  .dm-route-glow {
    stroke: rgba(236, 92, 10, 0.25);
    stroke-width: 22;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    filter: blur(4px);
  }

  .dm-route-base {
    stroke: #0f172a;
    stroke-width: 12;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: 0.85;
  }

  .dm-route-active {
    stroke: #ff9a00;
    stroke-width: 4;
    stroke-dasharray: 14 10;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    animation: dmRouteFlow 1.4s linear infinite;
  }

  @keyframes dmRouteFlow {
    from { stroke-dashoffset: 48; }
    to { stroke-dashoffset: 0; }
  }

  /* Foreground Content Hero - Crisp & Top Aligned */
  .dm-content-hero {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    pointer-events: auto;
  }

  .dm-title {
    font-family: 'Baloo 2', 'Outfit', sans-serif;
    font-size: clamp(28px, 4.2vw, 52px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.15;
    margin: 0 0 10px 0;
    letter-spacing: -0.02em;
  }

  /* Vidhyut Saathi Signature Theme Gradient (#ec5c0a -> #ff9a00 -> #007b3e) */
  .dm-title-gradient {
    background: linear-gradient(90deg, #ec5c0a 0%, #ff9a00 50%, #007b3e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 900;
  }

  .dm-subtitle {
    font-size: clamp(14px, 1.6vw, 16px);
    color: #475569;
    line-height: 1.5;
    margin: 0 auto 18px;
    max-width: 680px;
    font-weight: 500;
  }

  /* Real-Time Live Metrics Tags Row */
  .dm-stats-pills-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 25px;
  }

  .dm-stat-tag {
    background: #ffffff;
    color: #0f172a;
    border: 1.5px solid rgba(236, 92, 10, 0.25);
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 0.84rem;
    font-weight: 700;
    box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .dm-stat-tag strong {
    color: #ec5c0a;
    font-weight: 800;
  }

  .dm-stat-tag:hover {
    transform: translateY(-2px);
    border-color: #ec5c0a;
  }

  .dm-pulse-dot {
    width: 9px;
    height: 9px;
    background-color: #16a34a;
    border-radius: 50%;
    box-shadow: 0 0 10px #16a34a;
    animation: livePulse 1.8s infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.9); opacity: 0.7; }
    50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 14px #16a34a; }
    100% { transform: scale(0.9); opacity: 0.7; }
  }

  /* Destination Hub Pin Markers */
  .dm-hub-pin {
    position: absolute;
    transform: translate(-50%, -100%);
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .dm-hub-pin:hover,
  .dm-hub-pin.active-hub {
    transform: translate(-50%, -115%) scale(1.18);
    z-index: 20;
  }

  .dm-hub-pin.active-hub .dm-pin-badge {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ffffff;
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.45);
  }

  .dm-pin-badge {
    background: #ffffff;
    color: #0f172a;
    border: 1.5px solid #ec5c0a;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 4px;
    transition: transform 0.3s ease;
  }

  /* Edge Badge Offsets so Location 1 & Location 5 text badges never overflow screen edges */
  .dm-hub-pin[data-hub="1"] .dm-pin-badge {
    transform: translateX(45%);
  }

  .dm-hub-pin[data-hub="5"] .dm-pin-badge {
    transform: translateX(-45%);
  }

  .dm-pin-icon-wrap {
    position: relative;
    width: 32px;
    height: 38px;
  }

  .dm-pin-svg {
    width: 32px;
    height: 38px;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.6));
  }

  /* Parcel Box Stack at Destinations */
  .dm-parcel-box {
    position: absolute;
    bottom: 2px;
    right: -8px;
    background: #d97706;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 900;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    border: 1.5px solid #fef08a;
  }

  @keyframes boxBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  /* Delivery Truck Moving Along Route */
  .dm-courier-truck {
    position: absolute;
    width: 84px;
    height: 52px;
    z-index: 8;
    transform: translate(-50%, -50%);
    pointer-events: none;
    filter: drop-shadow(0 8px 20px rgba(0,0,0,0.7));
    will-change: transform, left, top;
    transition: transform 0.25s ease-out;
  }

  .dm-truck-body {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Truck Delivery Status Label */
  .dm-truck-status-bubble {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    background: #2563eb;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 12px;
    white-space: nowrap;
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  /* 100% Unified Mobile Fluid Responsiveness - Compact Bottom Height & Perfect Alignment */
  @media (max-width: 768px) {
    #deliveryMapHero-{{ section.id }} {
      height: auto;
      min-height: clamp(380px, 88vw, 440px);
      padding: clamp(18px, 4vw, 24px) clamp(10px, 3vw, 16px) clamp(22px, 5vw, 30px);
    }

    /* Shift animated road & truck lower down on Mobile view only */
    .dm-svg-map-layer {
      transform: translateY(24px);
    }

    .dm-title {
      font-size: clamp(24px, 6.8vw, 34px);
      line-height: 1.22;
      margin-bottom: clamp(8px, 2.5vw, 12px);
      letter-spacing: -0.01em;
    }

    .dm-subtitle {
      font-size: clamp(0.84rem, 3.8vw, 0.94rem);
      line-height: 1.5;
      margin-bottom: clamp(14px, 3.8vw, 20px);
      padding: 0 clamp(4px, 2vw, 10px);
      font-weight: 500;
    }

    .dm-stats-pills-row {
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(6px, 2vw, 10px);
      margin-bottom: clamp(14px, 3.5vw, 20px);
    }

    .dm-stat-tag {
      font-size: clamp(0.74rem, 3.2vw, 0.82rem);
      font-weight: 800;
      padding: clamp(5px, 1.5vw, 7px) clamp(10px, 3vw, 14px);
      border-radius: 16px;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

    .dm-courier-truck {
      width: clamp(52px, 14vw, 64px);
      height: clamp(32px, 9vw, 40px);
    }

    .dm-pin-badge {
      font-size: clamp(0.66rem, 2.8vw, 0.75rem);
      font-weight: 800;
      padding: clamp(4px, 1.2vw, 6px) clamp(8px, 2.5vw, 12px);
      border-radius: 14px;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Mobile Clean Active Popup - Prevents all badge overlaps on mobile screens */
    .dm-hub-pin:not(.active-hub):not(:hover) .dm-pin-badge {
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px) scale(0.85);
      pointer-events: none;
    }

    .dm-hub-pin.active-hub .dm-pin-badge,
    .dm-hub-pin:hover .dm-pin-badge {
      opacity: 1;
      visibility: visible;
      z-index: 50;
    }

    .dm-hub-pin[data-hub="1"].active-hub .dm-pin-badge {
      transform: translateX(35%);
    }

    .dm-hub-pin[data-hub="5"].active-hub .dm-pin-badge {
      transform: translateX(-35%);
    }

    .dm-pin-icon-wrap {
      width: clamp(25px, 6.5vw, 29px);
      height: clamp(30px, 8vw, 35px);
    }

    .dm-pin-svg {
      width: clamp(25px, 6.5vw, 29px);
      height: clamp(30px, 8vw, 35px);
    }

    .dm-parcel-box {
      font-size: clamp(0.55rem, 2vw, 0.64rem);
      width: clamp(13px, 3.5vw, 16px);
      height: clamp(13px, 3.5vw, 16px);
      right: -4px;
      bottom: 0;
    }
  }
{%- endstyle -%}

<div class="dm-section-wrapper">
  <section class="dm-map-hero-section" id="deliveryMapHero-{{ section.id }}">
  <!-- Dark GPS Navigation Map Background Layer with Vidhyut Ambient Glows -->
  <div class="dm-map-container" id="dmMapContainer-{{ section.id }}">
    <div class="dm-ambient-glow-orange" aria-hidden="true"></div>
    <div class="dm-ambient-glow-green" aria-hidden="true"></div>
    <div class="dm-street-network" aria-hidden="true"></div>
    <div class="dm-upper-vignette" aria-hidden="true"></div>

    <!-- Map Route SVG -->
    <svg class="dm-svg-map-layer" id="dmMapSvg-{{ section.id }}" viewBox="0 0 1400 800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="routeGlowGrad-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.6"/>
          <stop offset="50%" stop-color="#2563eb" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#f97316" stop-opacity="0.9"/>
        </linearGradient>

        <!-- City Street Secondary Routes in Background -->
        <pattern id="streetPattern-{{ section.id }}" width="300" height="300" patternUnits="userSpaceOnUse">
          <path d="M0 150 H300 M150 0 V300 M50 50 L250 250 M250 50 L50 250" stroke="rgba(255,255,255,0.06)" stroke-width="1.5" fill="none"/>
        </pattern>
      </defs>

      <!-- Street Texture -->
      <rect width="100%" height="100%" fill="url(#streetPattern-{{ section.id }})" opacity="0.7"/>

      <!-- Secondary Clean Light Road Network -->
      <path d="M -50 450 Q 300 380 650 520 T 1450 460" stroke="rgba(236, 92, 10, 0.12)" stroke-width="10" fill="none"/>
      <path d="M 200 -50 Q 350 400 500 850" stroke="rgba(203, 213, 225, 0.6)" stroke-width="8" fill="none"/>
      <path d="M 900 -50 Q 800 350 1100 850" stroke="rgba(203, 213, 225, 0.6)" stroke-width="8" fill="none"/>

      <!-- Main Animated Courier Highway Route Path spanning 100% complete edge-to-edge off-screen -->
      <path id="dmDeliveryPath-{{ section.id }}" class="dm-route-glow" d="M -80 660 C 140 610, 300 695, 480 645 C 660 600, 780 705, 960 645 C 1140 595, 1280 695, 1480 645" />
      <path class="dm-route-base" d="M -80 660 C 140 610, 300 695, 480 645 C 660 600, 780 705, 960 645 C 1140 595, 1280 695, 1480 645" />
      <path class="dm-route-active" d="M -80 660 C 140 610, 300 695, 480 645 C 660 600, 780 705, 960 645 C 1140 595, 1280 695, 1480 645" />
    </svg>

    <!-- Destination Hub Pins with Parcel Boxes shifted further down -->
    <!-- Destination 1: Origin (VS Office Dispatch) -->
    <div class="dm-hub-pin" style="left: 6%; top: 91%;" data-hub="1">
      <div class="dm-pin-badge">📦 VS Office Dispatch</div>
      <div class="dm-pin-icon-wrap">
        <svg class="dm-pin-svg" viewBox="0 0 32 38" fill="none">
          <path d="M16 0C7.16 0 0 7.16 0 16C0 26 16 38 16 38C16 38 32 26 32 16C32 7.16 24.84 0 16 0Z" fill="#2563eb"/>
          <circle cx="16" cy="15" r="7" fill="#ffffff"/>
          <circle cx="16" cy="15" r="4" fill="#2563eb"/>
        </svg>
        <div class="dm-parcel-box">📦</div>
      </div>
    </div>

    <!-- Destination 2: North Logistics Hub -->
    <div class="dm-hub-pin" style="left: 28%; top: 90%;" data-hub="2">
      <div class="dm-pin-badge">📍 Hub B: Express</div>
      <div class="dm-pin-icon-wrap">
        <svg class="dm-pin-svg" viewBox="0 0 32 38" fill="none">
          <path d="M16 0C7.16 0 0 7.16 0 16C0 26 16 38 16 38C16 38 32 26 32 16C32 7.16 24.84 0 16 0Z" fill="#0284c7"/>
          <circle cx="16" cy="15" r="7" fill="#ffffff"/>
          <circle cx="16" cy="15" r="4" fill="#0284c7"/>
        </svg>
        <div class="dm-parcel-box" style="background:#ea580c; border-color:#fdba74;">📦</div>
      </div>
    </div>

    <!-- Destination 3: Central Delivery Center -->
    <div class="dm-hub-pin" style="left: 55%; top: 92%;" data-hub="3">
      <div class="dm-pin-badge">⚡ Hub C: Fulfillment</div>
      <div class="dm-pin-icon-wrap">
        <svg class="dm-pin-svg" viewBox="0 0 32 38" fill="none">
          <path d="M16 0C7.16 0 0 7.16 0 16C0 26 16 38 16 38C16 38 32 26 32 16C32 7.16 24.84 0 16 0Z" fill="#16a34a"/>
          <circle cx="16" cy="15" r="7" fill="#ffffff"/>
          <circle cx="16" cy="15" r="4" fill="#16a34a"/>
        </svg>
        <div class="dm-parcel-box" style="background:#ca8a04; border-color:#fde047;">📦</div>
      </div>
    </div>

    <!-- Destination 4: West Distribution -->
    <div class="dm-hub-pin" style="left: 77%; top: 89%;" data-hub="4">
      <div class="dm-pin-badge">🏢 Hub D: Regional</div>
      <div class="dm-pin-icon-wrap">
        <svg class="dm-pin-svg" viewBox="0 0 32 38" fill="none">
          <path d="M16 0C7.16 0 0 7.16 0 16C0 26 16 38 16 38C16 38 32 26 32 16C32 7.16 24.84 0 16 0Z" fill="#9333ea"/>
          <circle cx="16" cy="15" r="7" fill="#ffffff"/>
          <circle cx="16" cy="15" r="4" fill="#9333ea"/>
        </svg>
        <div class="dm-parcel-box">📦</div>
      </div>
    </div>

    <!-- Destination 5: Final Delivery Destination (Happiness Delivered) -->
    <div class="dm-hub-pin" style="left: 95%; top: 91%;" data-hub="5">
      <div class="dm-pin-badge">🎯 Happiness Delivered 🥳</div>
      <div class="dm-pin-icon-wrap">
        <svg class="dm-pin-svg" viewBox="0 0 32 38" fill="none">
          <path d="M16 0C7.16 0 0 7.16 0 16C0 26 16 38 16 38C16 38 32 26 32 16C32 7.16 24.84 0 16 0Z" fill="#ec5c0a"/>
          <circle cx="16" cy="15" r="7" fill="#ffffff"/>
          <circle cx="16" cy="15" r="4" fill="#ec5c0a"/>
        </svg>
        <div class="dm-parcel-box" style="background:#059669; border-color:#6ee7b7;">✅</div>
      </div>
    </div>

    <!-- Dynamic Courier Car / Delivery Truck Moving on Route -->
    <div class="dm-courier-truck" id="dmTruck-{{ section.id }}">
      <div class="dm-truck-body">
        <!-- SVG Truck Illustration with Packages -->
        <svg viewBox="0 0 96 58" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Truck Shadow -->
          <ellipse cx="48" cy="52" rx="42" ry="6" fill="rgba(0,0,0,0.5)"/>
          
          <!-- Cargo Container -->
          <rect x="2" y="10" width="56" height="34" rx="4" fill="#e2e8f0" stroke="#0f172a" stroke-width="2"/>
          <path d="M10 10 V44 M24 10 V44 M38 10 V44 M52 10 V44" stroke="#cbd5e1" stroke-width="1.5"/>
          
          <!-- Vidhyut Saathi Logo / Branding on Cargo -->
          <rect x="8" y="18" width="44" height="18" rx="3" fill="#ec5c0a"/>
          <text x="30" y="30" fill="#ffffff" font-size="8" font-weight="900" font-family="sans-serif" text-anchor="middle">VIDHYUT</text>
          
          <!-- Cabin -->
          <path d="M58 20 H76 L88 32 V44 H58 V20 Z" fill="#3b82f6" stroke="#0f172a" stroke-width="2"/>
          <!-- Windshield -->
          <path d="M62 23 H74 L82 32 H62 V23 Z" fill="#93c5fd"/>
          <!-- Headlight Glow -->
          <polygon points="88,38 115,32 115,48 88,42" fill="url(#headlightBeam-{{ section.id }})" opacity="0.6"/>
          <circle cx="86" cy="40" r="2.5" fill="#fef08a"/>
          
          <!-- Wheels -->
          <circle cx="20" cy="45" r="7" fill="#0f172a"/>
          <circle cx="20" cy="45" r="3.5" fill="#94a3b8"/>
          <circle cx="74" cy="45" r="7" fill="#0f172a"/>
          <circle cx="74" cy="45" r="3.5" fill="#94a3b8"/>

          <!-- Parcel Stack on Top of Cargo -->
          <rect x="12" y="3" width="12" height="7" rx="1" fill="#d97706" stroke="#fbbf24" stroke-width="1"/>
          <rect x="26" y="1" width="14" height="9" rx="1" fill="#b45309" stroke="#fde68a" stroke-width="1"/>
          <rect x="42" y="4" width="10" height="6" rx="1" fill="#ca8a04" stroke="#fef08a" stroke-width="1"/>

          <defs>
            <linearGradient id="headlightBeam-{{ section.id }}" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#fef08a" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#fef08a" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
    </div>
  </div>

  <!-- Center Lucrative Foreground Header -->
  <div class="dm-content-hero">
    <h1 class="dm-title">
      {{ section.settings.title | default: 'Capturing Moments Of <span class="dm-title-gradient">Trust & Innovation</span> Across India' }}
    </h1>

    <p class="dm-subtitle">
      {{ section.settings.subtitle | default: 'A live visual chronicle of thousands of electrical installations, happy customer stories, team milestones, and real-time dispatches delivered across India.' }}
    </p>

    <!-- Real-Time Gallery Metrics Tags -->
    <div class="dm-stats-pills-row">
      <div class="dm-stat-tag">
        <span class="dm-pulse-dot"></span>
        <span>📸 <strong>THOUSANDS OF HAPPY MOMENTS</strong></span>
      </div>
      <div class="dm-stat-tag">
        <span>⚡ <strong>1,00,000+ Verified Installations</strong></span>
      </div>
      <div class="dm-stat-tag">
        <span>📍 <strong>Pan-India Presence</strong></span>
      </div>
    </div>
  </div>
  </section>
</div>

<script>
  (function() {
    function initDeliveryTracker_{{ section.id | replace: '-', '_' }}() {
      const path = document.getElementById('dmDeliveryPath-{{ section.id }}');
      const truck = document.getElementById('dmTruck-{{ section.id }}');
      const statusBubble = document.getElementById('dmTruckStatus-{{ section.id }}');
      const container = document.getElementById('dmMapContainer-{{ section.id }}');
      if (!path || !truck || !container) return;

      const pathLength = path.getTotalLength();
      let progress = 0;
      const speed = 0.0018; // Speed of courier truck
      let isPaused = false;
      let pauseTimer = null;
      let lastHubIndex = -1;

      // Destination waypoints along path (percentage checkpoints for full width edge-to-edge highway)
      const hubs = [
        { pct: 0.08, name: "📦 VS Office Dispatch" },
        { pct: 0.28, name: "📍 Hub B: Transited Express" },
        { pct: 0.50, name: "⚡ Hub C: Sorted at Central Hub" },
        { pct: 0.70, name: "🏢 Hub D: Out for Regional Delivery" },
        { pct: 0.92, name: "🎯 Happiness Delivered 🥳" }
      ];

      // Dynamically position each Hub Pin marker EXACTLY on the SVG path point!
      const pinElements = document.querySelectorAll('#deliveryMapHero-{{ section.id }} .dm-hub-pin');
      hubs.forEach((hub, idx) => {
        const pt = path.getPointAtLength(hub.pct * pathLength);
        const posX = (pt.x / 1400) * 100;
        const posY = (pt.y / 800) * 100;
        if (pinElements[idx]) {
          pinElements[idx].style.left = posX + '%';
          pinElements[idx].style.top = posY + '%';
        }
      });

      function animate() {
        if (!isPaused) {
          progress += speed;
          if (progress > 1) {
            progress = 0;
            lastHubIndex = -1;
          }

          const currentDist = progress * pathLength;
          const currentPoint = path.getPointAtLength(currentDist);
          
          // Get next point slightly ahead to calculate truck rotation heading
          const nextDist = Math.min(currentDist + 8, pathLength);
          const nextPoint = path.getPointAtLength(nextDist);
          const angleRad = Math.atan2(nextPoint.y - currentPoint.y, nextPoint.x - currentPoint.x);
          const angleDeg = (angleRad * 180) / Math.PI;

          // Convert SVG point to percentage of container
          const posX = (currentPoint.x / 1400) * 100;
          const posY = (currentPoint.y / 800) * 100;

          truck.style.left = posX + '%';
          truck.style.top = posY + '%';
          truck.style.transform = `translate(-50%, -50%) rotate(${angleDeg}deg)`;

          // Check if truck reached a hub waypoint
          hubs.forEach((hub, idx) => {
            if (Math.abs(progress - hub.pct) < 0.008 && lastHubIndex !== idx) {
              lastHubIndex = idx;
              isPaused = true;

              // Align truck EXACTLY to the hub point while paused
              const exactPt = path.getPointAtLength(hub.pct * pathLength);
              truck.style.left = ((exactPt.x / 1400) * 100) + '%';
              truck.style.top = ((exactPt.y / 800) * 100) + '%';

              // Highlight active hub pin
              pinElements.forEach(pin => pin.classList.remove('active-hub'));
              if (pinElements[idx]) {
                pinElements[idx].classList.add('active-hub');
              }

              // Pause 1.2s at destination then proceed to next destination
              clearTimeout(pauseTimer);
              pauseTimer = setTimeout(() => {
                isPaused = false;
              }, 1200);
            }
          });
        }

        requestAnimationFrame(animate);
      }

      requestAnimationFrame(animate);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDeliveryTracker_{{ section.id | replace: '-', '_' }});
    } else {
      initDeliveryTracker_{{ section.id | replace: '-', '_' }}();
    }
  })();
</script>

