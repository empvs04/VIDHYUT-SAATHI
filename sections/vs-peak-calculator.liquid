<div class="premium-calculator-{{ section.id }}"
     id="calc-data-{{ section.id }}"
     data-price="{{ section.settings.calc_price }}"
     data-pct-base="{{ section.settings.pct_base }}"
     data-pct-mid="{{ section.settings.pct_mid }}"
     data-pct-high="{{ section.settings.pct_high }}">

  <div class="electric-particle" style="left:15%; animation-duration:7s;"></div>
  <div class="electric-particle" style="left:40%; animation-duration:11s;"></div>
  <div class="electric-particle" style="left:75%; animation-duration:9s;"></div>
  <div class="electric-particle" style="left:90%; animation-duration:13s;"></div>

  <div class="bg-grid"></div>
  <div class="blur blur1"></div>
  <div class="blur blur2"></div>

  <div class="wrapper">
    <!-- TOP CENTERED SECTION HEADER & SUBHEADER -->
    <div class="vs-calc-top-header-{{ section.id }}">
      <div class="tag-wrapper">
        <div class="section-tag"><div class="tag-dot"></div>{{ section.settings.tag_text }}</div>
      </div>
      <h2 class="section-title">
        {{ section.settings.heading_text }} <br>
        <span class="heading-line">{{ section.settings.heading_highlight }}</span>
      </h2>
      <p class="section-sub">{{ section.settings.subheading_text }}</p>
    </div>

    <!-- 2 SHUFFLED COLUMNS (LEFT: CALCULATOR CONTROLS | RIGHT: RESULTS & TRUST BADGES) -->
    <div class="vs-calc-desktop-grid-{{ section.id }}">
      
      <!-- LEFT COLUMN: INTERACTIVE CALCULATOR CONTROLS CARD -->
      <div class="vs-calc-left-col-{{ section.id }}">
        <div class="calc-card">

          <!-- BIG DISPLAY FOR CURRENT BILL -->
          <div class="calc-display-group">
            <div class="calc-label"><i class="fa-solid fa-file-invoice-dollar" style="color:var(--green); font-size:1.05rem; margin-right:6px; vertical-align:middle;"></i> Your Current Monthly Bill</div>
            <div class="calc-current" id="billDisplay-{{ section.id }}"><span class="rupee-icon" style="font-size:0.85em; margin-right:2px; font-weight:800; color:inherit;">₹</span>{{ section.settings.slider_default }}</div>
          </div>

          <!-- SLIDER CONTROL (FIRST) -->
          <div class="calc-label" style="margin-top: 10px;"><i class="fa-solid fa-sliders" style="color:var(--orange); font-size:1rem; margin-right:6px; vertical-align:middle;"></i> Drag Slider to Adjust Bill</div>
          <input type="range" class="calc-slider" id="billSlider-{{ section.id }}"
                 min="{{ section.settings.slider_min }}"
                 max="{{ section.settings.slider_max }}"
                 step="{{ section.settings.slider_step }}"
                 value="{{ section.settings.slider_default }}">

          <div style="display:flex; justify-content:space-between; font-size:.72rem; color:var(--muted); margin-top:8px; margin-bottom:18px;">
            <span id="minLabel-{{ section.id }}">₹{{ section.settings.slider_min }}</span>
            <span id="maxLabel-{{ section.id }}">₹{{ section.settings.slider_max }}</span>
          </div>

          <!-- EDITABLE NUMBER INPUTS (MONTHLY BILL & LOAD KW) -->
          <div class="input-dual-row">
            <div class="input-field-group">
              <div class="input-label-row">
                <div class="calc-label"><i class="fa-solid fa-receipt" style="color:var(--green); font-size:0.95rem; margin-right:5px; vertical-align:middle;"></i> Monthly Electricity Bill</div>
                <button type="button" class="how-it-works-btn how-it-works-mobile-only" id="howItWorksBtnMobile-{{ section.id }}" aria-label="How it works">
                  <i class="fa-solid fa-lightbulb bulb-glow-anim"></i>
                  <span>How it works</span>
                </button>
              </div>
              <div class="custom-bill-box">
                <span class="currency-symbol">₹</span>
                <input type="number" id="billInput-{{ section.id }}" class="custom-num-input" value="{{ section.settings.slider_default }}" min="500" max="300000" step="50">
              </div>
            </div>

            <div class="input-field-group">
              <div class="calc-label"><i class="fa-solid fa-bolt" style="color:var(--orange); font-size:0.95rem; margin-right:5px; vertical-align:middle;"></i> Sanctioned Load</div>
              <div class="custom-bill-box">
                <input type="number" id="kwInput-{{ section.id }}" class="custom-num-input" value="" min="1" max="250" step="1">
                <span class="unit-symbol">KW</span>
              </div>
            </div>
          </div>

          <!-- HIGHEST BILL IN LAST 12 MONTHS (PEAK BILL INPUT) -->
          <div class="input-single-row">
            <div class="input-field-group">
              <div class="calc-label"><i class="fa-solid fa-arrow-trend-up" style="color:var(--orange); font-size:0.95rem; margin-right:5px; vertical-align:middle;"></i> Highest Bill in Last 12 Months (Peak/Summer Bill)</div>
              <div class="custom-bill-box">
                <span class="currency-symbol">₹</span>
                <input type="number" id="peakBillInput-{{ section.id }}" class="custom-num-input" value="" min="500" max="1000000" step="100">
              </div>
            </div>
          </div>

          <!-- PHASE TYPE SELECTOR TOGGLE BUTTONS WITH "HOW IT WORKS" BLINKING BULB -->
          <div class="phase-selector-container">
            <div class="phase-header-row">
              <div class="calc-label"><i class="fa-solid fa-bolt" style="color:var(--green); font-size:0.95rem; margin-right:5px; vertical-align:middle;"></i> SELECT PHASE TYPE</div>
              <button type="button" class="how-it-works-btn how-it-works-desktop-only" id="howItWorksBtn-{{ section.id }}" aria-label="How it works">
                <i class="fa-solid fa-lightbulb bulb-glow-anim"></i>
                <span>How it works</span>
              </button>
            </div>
            <div class="phase-toggle-grid">
              <button type="button" class="phase-btn active" id="btnSinglePhase-{{ section.id }}" data-phase="single">
                <i class="fa-solid fa-bolt"></i> Single Phase
              </button>
              <button type="button" class="phase-btn" id="btnThreePhase-{{ section.id }}" data-phase="three">
                <i class="fa-solid fa-industry"></i> Three Phase (+1 Card)
              </button>
            </div>
          </div>

          <!-- DYNAMIC SMART LOAD & CARD RECOMMENDATION BAR -->
          <div class="calc-recommendation-bar" id="recBar-{{ section.id }}">
            <div class="calc-rec-pill">
              <i class="fa-solid fa-bolt-lightning"></i>
              <span class="rec-label">KW Load:</span>
              <strong class="rec-val" id="recLoad-{{ section.id }}">1 - 6 KW</strong>
            </div>
            <div class="calc-rec-pill highlight-pill">
              <i class="fa-solid fa-layer-group"></i>
              <span class="rec-label">Cards Needed:</span>
              <strong class="rec-val" id="recCards-{{ section.id }}">1 Card (Single Phase)</strong>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: RESULTS CARDS, DISCLAIMER & TRUST CAPSULE PILLS -->
      <div class="vs-calc-right-col-{{ section.id }}">
        <!-- 4 CALCULATION RESULT CARDS -->
        <div class="calc-results">
          <div class="calc-result-card">
            <div class="calc-result-val" id="monthlySaving-{{ section.id }}">₹0</div>
            <div class="calc-result-label">{{ section.settings.label_monthly }}</div>
          </div>
          <div class="calc-result-card">
            <div class="calc-result-val" id="yearlySaving-{{ section.id }}">₹0</div>
            <div class="calc-result-label">{{ section.settings.label_yearly }}</div>
          </div>
          <div class="calc-result-card">
            <div class="calc-result-val" id="newBill-{{ section.id }}">₹0</div>
            <div class="calc-result-label">{{ section.settings.label_newbill }}</div>
          </div>
          <div class="calc-result-card">
            <div class="calc-result-val" id="roiMonths-{{ section.id }}">0 Mo</div>
            <div class="calc-result-label">{{ section.settings.label_roi }}</div>
          </div>
        </div>

        <!-- DYNAMIC MINI CARDS SHOWCASE (RIGHT COLUMN) -->
        <div class="calc-mini-cards-wrapper" id="miniCardsWrapper-{{ section.id }}">
          <div class="calc-mini-cards-header">
            <span><i class="fa-solid fa-layer-group" style="color:var(--orange); margin-right:6px;"></i> Recommended Vidhyut Saathi Cards</span>
            <span class="count-badge" id="miniCardCountBadge-{{ section.id }}">1 Card</span>
          </div>
          <div class="calc-mini-cards-row" id="miniCardsRow-{{ section.id }}"></div>
        </div>

        <p class="calc-disclaimer">{{ section.settings.disclaimer_text }}</p>

        <!-- TRUST STRIP CAPSULE PILLS -->
        <div class="trust-strip">
          {%- for block in section.blocks -%}
            <div class="trust-item" {{ block.shopify_attributes }}>
              <span class="trust-icon">{{ block.settings.icon }}</span>
              <div>{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>

  <!-- HOW IT WORKS POPUP MODAL -->
  <div class="how-it-works-modal" id="howItWorksModal-{{ section.id }}" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modalTitle-{{ section.id }}">
    <div class="how-it-works-backdrop" id="howItWorksBackdrop-{{ section.id }}"></div>
    <div class="how-it-works-card">
      <div class="modal-top-bar">
        <div class="modal-title-wrap" id="modalTitle-{{ section.id }}">
          <i class="fa-solid fa-lightbulb modal-bulb-icon"></i>
          <h3>How Sizing Logic & Rules Work</h3>
        </div>
        <button type="button" class="modal-close-btn" id="modalCloseBtn-{{ section.id }}" aria-label="Close modal">✕</button>
      </div>

      <div class="modal-content-area">
        <!-- Live Rule Reason Text Injected Dynamically Based on User Inputs -->
        <div class="popup-reason-badge" id="recReason-{{ section.id }}">
          ⚡ <strong>Smart Selection:</strong> Evaluated from Monthly Bill, Peak 12-Mo Bill, and KW Load.
        </div>

        <div class="rules-step-list">
          <div class="rule-step-item">
            <div class="rule-step-num">1</div>
            <div class="rule-step-info">
              <strong>Average Monthly Bill:</strong>
              <p>1 Vidhyut Saathi Card handles up to ₹6,000 electricity bill (2 Cards for ₹12,000, 3 Cards for ₹18,000, etc.).</p>
            </div>
          </div>

          <div class="rule-step-item">
            <div class="rule-step-num">2</div>
            <div class="rule-step-info">
              <strong>Peak 12-Month Bill:</strong>
              <p>If your peak summer bill was higher (e.g. ₹60,000), capacity is sized for that peak so your appliances are 100% protected during heavy load months.</p>
            </div>
          </div>

          <div class="rule-step-item">
            <div class="rule-step-num">3</div>
            <div class="rule-step-info">
              <strong>Sanctioned Load (KW):</strong>
              <p>1 Card is rated for every 6 KW connected load. If load requires more cards than bill, the higher KW requirement is prioritized.</p>
            </div>
          </div>

          <div class="rule-step-item">
            <div class="rule-step-num">4</div>
            <div class="rule-step-info">
              <strong>Three-Phase Supply:</strong>
              <p>3-Phase lines require 1 extra card (+1) to balance inter-phase harmonics and voltage fluctuations across all phases.</p>
            </div>
          </div>
        </div>

        <div class="modal-cta-box">
          <span>Need custom machinery load sizing?</span>
          <a href="https://wa.me/918949826388?text=Hello%20Vidhyut%20Saathi%2C%20I%20want%20to%20verify%20my%20exact%20load%20calculation." target="_blank" rel="noopener noreferrer" class="modal-wa-btn">
            <i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  (function() {
    function initCalc() {
      const sectionId = '{{ section.id }}';
      const container = document.getElementById(`calc-data-${sectionId}`);
      if (!container) return;

      const slider = document.getElementById(`billSlider-${sectionId}`);
      const display = document.getElementById(`billDisplay-${sectionId}`);
      const mSaving = document.getElementById(`monthlySaving-${sectionId}`);
      const ySaving = document.getElementById(`yearlySaving-${sectionId}`);
      const nBill = document.getElementById(`newBill-${sectionId}`);
      const roi = document.getElementById(`roiMonths-${sectionId}`);

      const minLabel = document.getElementById(`minLabel-${sectionId}`);
      const maxLabel = document.getElementById(`maxLabel-${sectionId}`);

      if (!slider) return;

      if (minLabel && slider.min) minLabel.textContent = '₹' + parseInt(slider.min).toLocaleString('en-IN');
      if (maxLabel && slider.max) maxLabel.textContent = '₹' + parseInt(slider.max).toLocaleString('en-IN');

      const PRICE = parseFloat(container.dataset.price) || 3498;
      const pctBase = (parseFloat(container.dataset.pctBase) || 25) / 100.0;
      const pctMid = (parseFloat(container.dataset.pctMid) || 27) / 100.0;
      const pctHigh = (parseFloat(container.dataset.pctHigh) || 30) / 100.0;

      const recLoad = document.getElementById(`recLoad-${sectionId}`);
      const recCards = document.getElementById(`recCards-${sectionId}`);
      const recReason = document.getElementById(`recReason-${sectionId}`);

      const billInput = document.getElementById(`billInput-${sectionId}`);
      const peakBillInput = document.getElementById(`peakBillInput-${sectionId}`);
      const kwInput = document.getElementById(`kwInput-${sectionId}`);
      const btnSingle = document.getElementById(`btnSinglePhase-${sectionId}`);
      const btnThree = document.getElementById(`btnThreePhase-${sectionId}`);

      let currentPhase = 'single';

      function getCardsByKW(kw) {
        if (kw <= 6) return 1;
        if (kw <= 12) return 2;
        if (kw <= 18) return 3;
        if (kw <= 24) return 4;
        if (kw <= 30) return 5;
        if (kw <= 36) return 6;
        if (kw <= 42) return 7;
        if (kw <= 48) return 8;
        if (kw <= 54) return 9;
        if (kw <= 60) return 10;
        return Math.ceil(kw / 6);
      }

      function getCardsByBill(bill) {
        if (bill <= 6000) return 1;
        if (bill <= 12000) return 2;
        if (bill <= 18000) return 3;
        if (bill <= 24000) return 4;
        if (bill <= 30000) return 5;
        if (bill <= 36000) return 6;
        if (bill <= 42000) return 7;
        if (bill <= 48000) return 8;
        if (bill <= 54000) return 9;
        if (bill <= 60000) return 10;
        return Math.ceil(bill / 6000);
      }

      function updateSliderFill() {
        if (!slider) return;
        const min = parseFloat(slider.min) || 500;
        const max = parseFloat(slider.max) || 300000;
        const val = parseFloat(slider.value) || min;
        const pct = Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100));
        slider.style.background = `linear-gradient(to right, #148C3A 0%, #F58220 ${pct}%, #e2e8f0 ${pct}%, #e2e8f0 100%)`;
      }

      function updateCalculator(source) {
        let bill = 0;
        if (source === 'slider') {
          bill = parseFloat(slider ? slider.value : 0) || 0;
          if (billInput) billInput.value = Math.round(bill);
        } else if (source === 'billInput') {
          bill = parseFloat(billInput ? billInput.value : 0) || 0;
          if (slider) slider.value = Math.min(300000, Math.max(500, bill));
        } else {
          bill = parseFloat(billInput && billInput.value ? billInput.value : (slider ? slider.value : 0)) || 0;
        }

        updateSliderFill();

        // Read Peak Bill and KW load directly from user input
        let peakBill = parseFloat(peakBillInput && peakBillInput.value ? peakBillInput.value : 0) || 0;
        let kw = parseFloat(kwInput && kwInput.value ? kwInput.value : 0) || 0;

        const cardsFromBill = getCardsByBill(bill);
        const cardsFromPeakBill = peakBill > 0 ? getCardsByBill(peakBill) : 0;
        const cardsFromKW = kw > 0 ? getCardsByKW(kw) : 0;

        // 3-WAY HIGHER PRIORITY SELECTION RULE
        const baseRequiredCards = Math.max(cardsFromBill, cardsFromPeakBill, cardsFromKW);
        const totalCards = currentPhase === 'three' ? baseRequiredCards + 1 : baseRequiredCards;

        let pct = pctBase;
        if (bill > 10000 && bill <= 50000) pct = pctMid;
        if (bill > 50000) pct = pctHigh;

        const monthly = Math.round(bill * pct);
        const yearly = monthly * 12;
        const newBill = Math.max(0, bill - monthly);
        const roiMonths = monthly > 0 ? Math.ceil(PRICE / monthly) : 0;

        let cardsStr = totalCards + (totalCards === 1 ? ' Card' : ' Cards');
        if (currentPhase === 'three') {
          cardsStr += ` (${baseRequiredCards} + 1 Extra for 3-Phase)`;
        } else {
          cardsStr += ' (Single Phase)';
        }

        let higherReasonText = '';
        if (cardsFromPeakBill >= cardsFromBill && cardsFromPeakBill >= cardsFromKW && peakBill > 0) {
          higherReasonText = `📈 <strong>Peak 12-Mo Bill Rule Applied:</strong> Highest 12-month bill of ₹${Math.round(peakBill).toLocaleString('en-IN')} requires ${cardsFromPeakBill} Cards (vs ${kw > 0 ? kw + ' KW -> ' + cardsFromKW + ' Cards, ' : ''}₹${Math.round(bill).toLocaleString('en-IN')} avg bill -> ${cardsFromBill} Cards). Peak requirement considered (${cardsFromPeakBill} Cards${currentPhase === 'three' ? ' + 1 Extra for 3-Phase = ' + totalCards + ' Cards' : ''}).`;
        } else if (cardsFromKW >= cardsFromBill && cardsFromKW >= cardsFromPeakBill && kw > 0) {
          higherReasonText = `⚡ <strong>KW Load Rule Applied:</strong> ${kw} KW load requires ${cardsFromKW} Cards, higher than bill metrics (${cardsFromBill} Cards). Higher requirement selected (${cardsFromKW} Cards${currentPhase === 'three' ? ' + 1 Extra for 3-Phase = ' + totalCards + ' Cards' : ''}).`;
        } else if (cardsFromBill >= cardsFromKW && cardsFromBill >= cardsFromPeakBill) {
          higherReasonText = `💰 <strong>Monthly Bill Rule Applied:</strong> ₹${Math.round(bill).toLocaleString('en-IN')} monthly bill requires ${cardsFromBill} Cards${currentPhase === 'three' ? ' (+ 1 Extra for 3-Phase = ' + totalCards + ' Cards)' : ''}.`;
        } else {
          higherReasonText = `⚡ <strong>Smart Selection:</strong> Evaluated across Average Bill, Peak 12-Mo Bill, and KW Load. Higher requirement (${baseRequiredCards} Cards) selected.`;
        }

        if (display) display.innerHTML = '<span class="rupee-icon" style="font-size:0.85em; margin-right:2px; font-weight:800; color:inherit;">₹</span>' + Math.round(bill).toLocaleString('en-IN');
        if (mSaving) mSaving.textContent = '₹' + monthly.toLocaleString('en-IN');
        if (ySaving) ySaving.textContent = '₹' + yearly.toLocaleString('en-IN');
        if (nBill) nBill.textContent = '₹' + newBill.toLocaleString('en-IN');
        if (roi) roi.textContent = (isFinite(roiMonths) && roiMonths > 0 ? roiMonths : 0) + ' Mo';
        if (recLoad) recLoad.textContent = kw > 0 ? (kw + ' KW') : (peakBill > 0 ? ('Peak ₹' + Math.round(peakBill).toLocaleString('en-IN')) : 'Enter Load / Peak');
        if (recCards) recCards.textContent = cardsStr;
        if (recReason) recReason.innerHTML = higherReasonText;

        /* Dynamic Mini Cards Row Rendering in Right Column */
        const miniCardsRow = document.getElementById(`miniCardsRow-${sectionId}`);
        const miniCardCountBadge = document.getElementById(`miniCardCountBadge-${sectionId}`);
        if (miniCardCountBadge) {
          miniCardCountBadge.textContent = totalCards + (totalCards === 1 ? ' Card' : ' Cards');
        }
        if (miniCardsRow) {
          miniCardsRow.innerHTML = '';
          const maxDisplay = 24;
          const capped = Math.min(totalCards, maxDisplay);
          for (let i = 0; i < capped; i++) {
            const cardEl = document.createElement('div');
            cardEl.className = 'vs-calc-mini-card-icon';
            cardEl.title = `Vidhyut Saathi Card ${i + 1} of ${totalCards}`;
            miniCardsRow.appendChild(cardEl);
          }
          if (totalCards > maxDisplay) {
            const moreEl = document.createElement('span');
            moreEl.className = 'vs-calc-mini-card-more';
            moreEl.textContent = `+${totalCards - maxDisplay} more`;
            miniCardsRow.appendChild(moreEl);
          }
        }
      }

      if (btnSingle && btnThree) {
        btnSingle.addEventListener('click', function() {
          currentPhase = 'single';
          btnSingle.classList.add('active');
          btnThree.classList.remove('active');
          updateCalculator('phase');
        });

        btnThree.addEventListener('click', function() {
          currentPhase = 'three';
          btnThree.classList.add('active');
          btnSingle.classList.remove('active');
          updateCalculator('phase');
        });
      }

      slider.addEventListener('input', function() { updateCalculator('slider'); });
      slider.addEventListener('change', function() { updateCalculator('slider'); });

      if (billInput) {
        billInput.addEventListener('input', function() { updateCalculator('billInput'); });
        billInput.addEventListener('change', function() { updateCalculator('billInput'); });
      }

      if (peakBillInput) {
        peakBillInput.addEventListener('input', function() { updateCalculator('peakBillInput'); });
        peakBillInput.addEventListener('change', function() { updateCalculator('peakBillInput'); });
      }

      if (kwInput) {
        kwInput.addEventListener('input', function() { updateCalculator('kwInput'); });
        kwInput.addEventListener('change', function() { updateCalculator('kwInput'); });
      }

      /* HOW IT WORKS MODAL POPUP CONTROLLERS */
      const howItWorksBtn = document.getElementById(`howItWorksBtn-${sectionId}`);
      const howItWorksBtnMobile = document.getElementById(`howItWorksBtnMobile-${sectionId}`);
      const modal = document.getElementById(`howItWorksModal-${sectionId}`);
      const backdrop = document.getElementById(`howItWorksBackdrop-${sectionId}`);
      const closeBtn = document.getElementById(`modalCloseBtn-${sectionId}`);

      function openModal(e) {
        if (e) e.preventDefault();
        if (modal) {
          modal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      }

      if (howItWorksBtn) howItWorksBtn.addEventListener('click', openModal);
      if (howItWorksBtnMobile) howItWorksBtnMobile.addEventListener('click', openModal);

      function closeModal() {
        if (modal) {
          modal.style.display = 'none';
          document.body.style.overflow = '';
        }
      }

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (backdrop) backdrop.addEventListener('click', closeModal);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
          closeModal();
        }
      });

      updateCalculator('init');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalc);
    } else {
      initCalc();
    }
  })();
</script>

