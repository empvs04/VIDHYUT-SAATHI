<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800;900&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

{%- comment -%}
  Vidhyut Saathi 3-Way Peak Load & Savings Calculator
{%- endcomment -%}

{%- style -%}
  .premium-calculator-{{ section.id }} {
    --green: {{ section.settings.color_green }};
    --green2: {{ section.settings.color_green2 }};
    --orange: {{ section.settings.color_orange }};
    --text: {{ section.settings.color_text }};
    --muted: {{ section.settings.color_muted }};
    --gradient: linear-gradient(135deg, var(--green), var(--orange));
    --heading-font: 'Baloo 2', sans-serif !important;
    --body-font: 'Nunito', sans-serif !important;
    font-family: var(--body-font);
    background:
      radial-gradient(circle at top right, rgba(20,140,58,.08), transparent 30%),
      radial-gradient(circle at bottom left, rgba(245,130,32,.08), transparent 30%), #fff;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    position: relative;
    overflow: hidden;
    animation: bgFloat-{{ section.id }} 10s ease-in-out infinite alternate;
  }

  .premium-calculator-{{ section.id }} * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .premium-calculator-{{ section.id }} .bg-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(20,140,58,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(20,140,58,.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .premium-calculator-{{ section.id }} .blur {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    animation: floatBlur-{{ section.id }} 8s ease-in-out infinite alternate;
  }

  .premium-calculator-{{ section.id }} .blur1 { width: 300px; height: 300px; background: rgba(20,140,58,.08); top: -100px; right: -100px; }
  .premium-calculator-{{ section.id }} .blur2 { width: 260px; height: 260px; background: rgba(245,130,32,.08); bottom: -100px; left: -100px; }

  /* BASE WRAPPER (Mobile / Tablet) */
  .premium-calculator-{{ section.id }} .wrapper { width: 100%; max-width: 520px; position: relative; z-index: 10; margin: 0 auto; }

  .premium-calculator-{{ section.id }} .calc-card {
    animation: floatCard-{{ section.id }} 4s ease-in-out infinite alternate;
    background: linear-gradient(135deg, rgba(255,255,255,.95), rgba(255,255,255,.82));
    border: 1px solid rgba(20,140,58,.12);
    border-radius: 30px;
    padding: 34px 26px;
    backdrop-filter: blur(18px);
    box-shadow: 0 20px 60px rgba(0,0,0,.05), 0 0 35px rgba(245,130,32,.06);
    animation: cardEnter-{{ section.id }} .8s ease;
  }

  .premium-calculator-{{ section.id }} .tag-wrapper { text-align: center; }
  .premium-calculator-{{ section.id }} .section-tag {
    display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px;
    background: rgba(20,140,58,.06); border: 1px solid rgba(20,140,58,.10);
    color: var(--green); font-size: .72rem; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; margin-bottom: 22px;
  }
  .premium-calculator-{{ section.id }} .tag-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); animation: pulse-{{ section.id }} 1.4s infinite; }

  .premium-calculator-{{ section.id }} .section-title {
    font-family: var(--heading-font); font-size: 3rem; line-height: 1.1; font-weight: 900; margin-bottom: 18px; color: var(--text); text-align: center;
  }
  .premium-calculator-{{ section.id }} .section-title span { background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .premium-calculator-{{ section.id }} .section-sub { text-align: center; color: var(--muted); font-size: 1rem; line-height: 1.8; margin: 0 auto 34px; }

  .premium-calculator-{{ section.id }} .calc-label { font-size: .8rem; color: var(--muted); margin-bottom: 10px; }
  .premium-calculator-{{ section.id }} .calc-val-display { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .premium-calculator-{{ section.id }} .calc-current {
    font-family: var(--heading-font); font-size: 3rem; font-weight: 900; background: linear-gradient(135deg, var(--green), var(--green2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-shadow: 0 0 20px rgba(20,140,58,.15);
  }

  .premium-calculator-{{ section.id }} .calc-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 9px;
    border-radius: 999px;
    background: #e2e8f0;
    outline: none;
    cursor: pointer;
    transition: background 0.05s ease;
  }
  .premium-calculator-{{ section.id }} .calc-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 28px;
    height: 28px;
    background: #ffffff;
    border-radius: 50%;
    border: 4px solid var(--green);
    box-shadow: 0 0 0 6px rgba(20,140,58,.16), 0 4px 12px rgba(0,0,0,.15);
    cursor: grab;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .premium-calculator-{{ section.id }} .calc-slider::-webkit-slider-thumb:active {
    cursor: grabbing;
    transform: scale(1.18);
    box-shadow: 0 0 0 8px rgba(245,130,32,.25), 0 6px 16px rgba(0,0,0,.2);
  }
  .premium-calculator-{{ section.id }} .calc-slider::-moz-range-thumb {
    width: 28px;
    height: 28px;
    background: #ffffff;
    border-radius: 50%;
    border: 4px solid var(--green);
    box-shadow: 0 0 0 6px rgba(20,140,58,.16), 0 4px 12px rgba(0,0,0,.15);
    cursor: grab;
  }

  /* BASE 2-COLUMN GRID (Original Mobile) */
  .premium-calculator-{{ section.id }} .calc-results { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 28px; }
  .premium-calculator-{{ section.id }} .calc-result-card {
    background: rgba(255,255,255,.92); border: 1px solid rgba(20,140,58,.10); border-radius: 18px;
    padding: 22px 16px; text-align: center; transition: .35s ease; position: relative; box-shadow: 0 10px 25px rgba(0,0,0,.03);
  }
  .premium-calculator-{{ section.id }} .calc-result-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--gradient); border-radius: 18px 18px 0 0; }
  .premium-calculator-{{ section.id }} .calc-result-card:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 18px 35px rgba(20,140,58,.08); }

  .premium-calculator-{{ section.id }} .calc-result-val {
    font-family: var(--heading-font); font-size: 2rem; font-weight: 900; background: var(--gradient);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: softGlow-{{ section.id }} 2s infinite;
  }
  .premium-calculator-{{ section.id }} .calc-result-label { font-size: .78rem; color: var(--muted); margin-top: 6px; }

  .premium-calculator-{{ section.id }} .calc-disclaimer {
    margin-top: 24px; background: rgba(20,140,58,.04); border: 1px solid rgba(20,140,58,.08); border-radius: 14px;
    padding: 14px 16px; text-align: center; color: var(--muted); font-size: .75rem; line-height: 1.7;
  }

  /* BASE 2-COLUMN TRUST STRIP (Original Mobile) */
  .premium-calculator-{{ section.id }} .trust-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 22px; }
  .premium-calculator-{{ section.id }} .trust-item {
    position: relative; overflow: hidden; background: rgba(255,255,255,.88);
    border-radius: 22px; padding: 18px 12px; text-align: center; transition: .35s ease; z-index: 1;
  }
  .premium-calculator-{{ section.id }} .trust-item::before {
    content: ''; position: absolute; inset: -4px; border-radius: 26px;
    background: linear-gradient(90deg, var(--green), #22c55e, var(--orange), #ffd44d, var(--green));
    background-size: 300% 300%; animation: premiumOutline-{{ section.id }} 4s linear infinite; z-index: -2;
  }
  .premium-calculator-{{ section.id }} .trust-item::after {
    content: ''; position: absolute; inset: 4px;
    background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(255,255,255,.90)); border-radius: 18px; z-index: -1;
  }
  .premium-calculator-{{ section.id }} .trust-item:hover {
    transform: translateY(-8px) scale(1.03); box-shadow: 0 15px 40px rgba(20,140,58,.15), 0 0 30px rgba(245,130,32,.12);
  }

  .premium-calculator-{{ section.id }} .electric-particle {
    position: absolute; width: 10px; height: 10px; border-radius: 50%;
    background: rgba(245,130,32,.25); animation: particleMove-{{ section.id }} 10s linear infinite; filter: blur(1px);
  }

  .premium-calculator-{{ section.id }} .heading-line { display: inline-block; white-space: nowrap; }

  .premium-calculator-{{ section.id }} .input-dual-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
    margin-top: 10px;
  }

  .premium-calculator-{{ section.id }} .input-single-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 18px;
  }

  .premium-calculator-{{ section.id }} .input-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .premium-calculator-{{ section.id }} .custom-bill-box {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 2px solid rgba(20, 140, 58, 0.22);
    border-radius: 16px;
    padding: 10px 14px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  .premium-calculator-{{ section.id }} .custom-bill-box:focus-within {
    border-color: #F58220;
    box-shadow: 0 6px 18px rgba(245, 130, 32, 0.2);
  }

  .premium-calculator-{{ section.id }} .currency-symbol {
    font-size: 1.25rem;
    font-weight: 900;
    color: #148C3A;
    margin-right: 6px;
  }

  .premium-calculator-{{ section.id }} .unit-symbol {
    font-size: 0.9rem;
    font-weight: 800;
    color: #F58220;
    margin-left: 6px;
    white-space: nowrap;
  }

  .premium-calculator-{{ section.id }} .custom-num-input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1.2rem;
    font-weight: 800;
    color: #1f2937;
    font-family: inherit;
  }

  .premium-calculator-{{ section.id }} .phase-selector-container {
    margin-top: 16px;
    margin-bottom: 22px;
  }

  .premium-calculator-{{ section.id }} .phase-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    gap: 10px;
  }

  @keyframes bulbPulseGlow {
    0%, 100% {
      color: #eab308;
      filter: drop-shadow(0 0 2px rgba(234, 179, 8, 0.4));
      transform: scale(1);
    }
    50% {
      color: #facc15;
      filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.9)) drop-shadow(0 0 14px rgba(245, 130, 32, 0.6));
      transform: scale(1.18);
    }
  }

  .premium-calculator-{{ section.id }} .bulb-glow-anim {
    animation: bulbPulseGlow 1.4s ease-in-out infinite;
    display: inline-block;
    font-size: 0.95rem;
    color: #f59e0b;
  }

  .premium-calculator-{{ section.id }} .how-it-works-btn {
    background: rgba(245, 130, 32, 0.08);
    border: 1.5px solid rgba(245, 130, 32, 0.3);
    color: #c2410c;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(245, 130, 32, 0.08);
  }

  .premium-calculator-{{ section.id }} .how-it-works-btn:hover {
    background: rgba(245, 130, 32, 0.16);
    border-color: #ea580c;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 130, 32, 0.16);
  }

  .premium-calculator-{{ section.id }} .how-it-works-desktop-only {
    display: inline-flex !important;
  }

  .premium-calculator-{{ section.id }} .how-it-works-mobile-only {
    display: none !important;
  }

  .premium-calculator-{{ section.id }} .input-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 2px;
  }

  @media(max-width: 768px) {
    .premium-calculator-{{ section.id }} .how-it-works-desktop-only {
      display: none !important;
    }
    .premium-calculator-{{ section.id }} .how-it-works-mobile-only {
      display: inline-flex !important;
    }
  }

  /* DYNAMIC MINI CARDS SHOWCASE IN RIGHT COLUMN */
  .premium-calculator-{{ section.id }} .calc-mini-cards-wrapper {
    background: linear-gradient(135deg, rgba(20, 140, 58, 0.04) 0%, rgba(245, 130, 32, 0.05) 100%);
    border: 1.5px solid rgba(20, 140, 58, 0.16);
    border-radius: 18px;
    padding: 14px 16px;
    margin-top: 14px;
    margin-bottom: 14px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    transition: all 0.3s ease;
  }

  .premium-calculator-{{ section.id }} .calc-mini-cards-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
  }

  .premium-calculator-{{ section.id }} .calc-mini-cards-header span.count-badge {
    background: linear-gradient(135deg, var(--green), var(--orange));
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.3px;
  }

  .premium-calculator-{{ section.id }} .calc-mini-cards-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 36px;
  }

  .premium-calculator-{{ section.id }} .vs-calc-mini-card-icon {
    width: 50px;
    height: 31px;
    border-radius: 5px;
    background-color: #050c26;
    background-image: url("{{ 'official-vs-card-front.jpg' | asset_url }}");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border: 1.5px solid rgba(245, 130, 32, 0.4);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.18);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
    display: inline-block;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
  }

  .premium-calculator-{{ section.id }} .vs-calc-mini-card-icon:hover {
    transform: translateY(-4px) scale(1.22);
    border-color: #F58220;
    box-shadow: 0 8px 20px rgba(245, 130, 32, 0.35);
    z-index: 5;
  }

  .premium-calculator-{{ section.id }} .vs-calc-mini-card-more {
    font-family: inherit;
    color: var(--orange);
    font-size: 0.82rem;
    font-weight: 800;
    align-self: center;
    margin-left: 4px;
    padding: 4px 8px;
    background: rgba(245, 130, 32, 0.1);
    border-radius: 8px;
  }

  /* HOW IT WORKS INTERACTIVE POPUP MODAL */
  .premium-calculator-{{ section.id }} .how-it-works-modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .premium-calculator-{{ section.id }} .how-it-works-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 28, 21, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .premium-calculator-{{ section.id }} .how-it-works-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    background: #ffffff;
    border: 2px solid #fed7aa;
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 35px rgba(245, 130, 32, 0.15);
    overflow: hidden;
    animation: modalPop-{{ section.id }} 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  @keyframes modalPop-{{ section.id }} {
    from { opacity: 0; transform: scale(0.92) translateY(12px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .premium-calculator-{{ section.id }} .modal-top-bar {
    padding: 16px 20px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border-bottom: 1px solid #fed7aa;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .premium-calculator-{{ section.id }} .modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .premium-calculator-{{ section.id }} .modal-bulb-icon {
    font-size: 1.2rem;
    color: #f59e0b;
  }

  .premium-calculator-{{ section.id }} .modal-title-wrap h3 {
    font-family: 'Baloo 2', sans-serif !important;
    font-size: 1.15rem;
    font-weight: 800;
    color: #16281f;
    margin: 0;
  }

  .premium-calculator-{{ section.id }} .modal-close-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #fed7aa;
    background: #ffffff;
    color: #64748b;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .premium-calculator-{{ section.id }} .modal-close-btn:hover {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
  }

  .premium-calculator-{{ section.id }} .modal-content-area {
    padding: 20px;
    max-height: 80vh;
    overflow-y: auto;
  }

  .premium-calculator-{{ section.id }} .popup-reason-badge {
    background: #f0fdf4;
    border: 1.5px solid #86efac;
    border-radius: 14px;
    padding: 14px 16px;
    color: #14532d;
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 16px;
    box-shadow: 0 4px 12px rgba(20, 140, 58, 0.06);
  }

  .premium-calculator-{{ section.id }} .rules-step-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }

  .premium-calculator-{{ section.id }} .rule-step-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    background: #f8faf9;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 12px;
  }

  .premium-calculator-{{ section.id }} .rule-step-num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #148C3A;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .premium-calculator-{{ section.id }} .rule-step-info strong {
    font-size: 0.84rem;
    color: #16281f;
    display: block;
    margin-bottom: 2px;
  }

  .premium-calculator-{{ section.id }} .rule-step-info p {
    font-size: 0.78rem;
    color: #64748b;
    line-height: 1.45;
    margin: 0;
  }

  .premium-calculator-{{ section.id }} .modal-cta-box {
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1.5px dashed #f97316;
    border-radius: 14px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .premium-calculator-{{ section.id }} .modal-cta-box span {
    font-size: 0.8rem;
    font-weight: 700;
    color: #9a3412;
  }

  .premium-calculator-{{ section.id }} .modal-wa-btn {
    background: #25D366;
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 3px 8px rgba(37, 211, 102, 0.25);
  }

  .premium-calculator-{{ section.id }} .phase-toggle-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 8px;
  }

  .premium-calculator-{{ section.id }} .phase-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 16px;
    border: 2px solid #e5e7eb;
    background: #ffffff;
    color: #4b5563;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    user-select: none;
  }

  .premium-calculator-{{ section.id }} .phase-btn:hover {
    border-color: #148C3A;
    color: #148C3A;
    transform: translateY(-2px);
  }

  .premium-calculator-{{ section.id }} .phase-btn.active {
    background: linear-gradient(135deg, #148C3A, #0f6c2c);
    border-color: #148C3A;
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(20, 140, 58, 0.25);
  }

  .premium-calculator-{{ section.id }} .phase-btn.active i {
    color: #ffffff;
  }

  /* DYNAMIC RECOMMENDATION BAR */
  .premium-calculator-{{ section.id }} .calc-recommendation-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: linear-gradient(135deg, rgba(20, 140, 58, 0.07) 0%, rgba(245, 130, 32, 0.08) 100%);
    border: 1.5px solid rgba(20, 140, 58, 0.2);
    border-radius: 20px;
    padding: 14px 20px;
    margin-top: 18px;
    margin-bottom: 24px;
