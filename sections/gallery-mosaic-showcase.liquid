        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Corporate Milestone"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Card Description",
          "default": "Verified energy saving installation across pan-India."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mosaic Moments Gallery",
      "category": "Gallery"
    }
  ]
}
