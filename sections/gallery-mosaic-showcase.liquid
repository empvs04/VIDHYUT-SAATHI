            { "value": "all", "label": "All Categories" },
            { "value": "corporate", "label": "Corporate Office" },
            { "value": "installations", "label": "Installations" },
            { "value": "events", "label": "Events & Awards" },
            { "value": "celebrating", "label": "Celebrating Moments" },
