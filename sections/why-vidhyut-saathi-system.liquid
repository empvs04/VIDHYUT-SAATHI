{%- comment -%}
  Why Vidhyut Saathi Section 5 - Business Engine, Franchise Advantage & Built for Entrepreneurs (Points 07, 08, 09)
{%- endcomment -%}

{%- style -%}
  .wvs-sec5-wrapper {
    position: relative;
    background: #FFFFFF;
    padding: clamp(60px, 8vw, 110px) 0;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    color: #231F20;
    overflow: hidden;
  }

  .wvs-sec5-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  .wvs-sec5-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: #FFF7ED;
    border: 1.5px solid #F17022;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 20px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.1);
  }

  .wvs-sec5-main-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(26px, 3.8vw, 46px);
    font-weight: 900;
    line-height: 1.2;
    color: #231F20;
    margin-bottom: 12px;
    letter-spacing: -0.5px;
  }

  .wvs-sec5-subhead {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
    color: #F17022;
    font-weight: 900;
    margin-bottom: 35px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* --- POINT 07: THE VIDHYUT SAATHI BUSINESS ENGINE --- */
  .wvs-p7-section {
    margin-bottom: 100px;
  }

  .wvs-p7-head {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 50px auto;
  }

  /* 8-Step Engine Flywheel Grid */
  .wvs-engine-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin-bottom: 35px;
  }

  .wvs-engine-card {
    background: #ffffff;
    border: 2px solid rgba(241, 112, 34, 0.18);
    border-radius: 24px;
    padding: 28px 22px;
    position: relative;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  .wvs-engine-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #009A44 0%, #25D300 35%, #F17022 70%, #FDBA00 100%);
    border-radius: 24px 24px 0 0;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .wvs-engine-card:hover {
    transform: translateY(-8px);
    border-color: #F17022;
    box-shadow: 0 22px 50px rgba(241, 112, 34, 0.2), 0 0 0 4px rgba(241, 112, 34, 0.08);
  }

  .wvs-engine-card:hover::before {
    opacity: 1;
    height: 6px;
  }

  .wvs-engine-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: linear-gradient(135deg, #009A44 0%, #00b853 100%);
    border: 2px solid #FDBA00;
    color: #FDBA00;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 16px;
    box-shadow: 0 10px 24px rgba(0, 154, 68, 0.3);
    transition: all 0.35s ease;
    flex-shrink: 0;
  }

  .wvs-engine-card:hover .wvs-engine-icon {
    transform: scale(1.12) rotate(6deg);
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    border-color: #ffffff;
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(241, 112, 34, 0.4);
  }

  .wvs-engine-step-num {
    display: inline-block;
    padding: 3px 12px;
    background: #FFF7ED;
    border: 1px solid #F17022;
    border-radius: 50px;
    font-size: 0.76rem;
    font-weight: 900;
    color: #F17022;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
    box-shadow: 0 3px 8px rgba(241, 112, 34, 0.1);
  }

  .wvs-engine-card h4 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.18rem;
    font-weight: 900;
    color: #111111;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
  }

  .wvs-engine-card p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #475569;
    font-weight: 600;
    margin: 0;
  }

  .wvs-engine-banner {
    text-align: center;
    padding: 26px 22px;
    background: linear-gradient(135deg, #009A44 0%, #007b3e 50%, #00b853 100%);
    border: 2.5px solid #FDBA00;
    color: #ffffff;
    border-radius: 26px;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(16px, 2.2vw, 22px);
    font-weight: 900;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    box-shadow: 0 18px 45px rgba(0, 154, 68, 0.35), 0 0 20px rgba(253, 186, 0, 0.2);
  }

  .wvs-engine-banner span {
    color: #FDBA00;
    text-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  /* --- POINT 08: THE FRANCHISE ADVANTAGE --- */
  .wvs-p8-section {
    margin-bottom: 100px;
  }

  .wvs-p8-head {
    text-align: center;
    max-width: 880px;
    margin: 0 auto 50px auto;
  }

  /* Point 08 Custom 2-Line Headline */
  .wvs-p8-main-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 18px;
    text-align: center;
  }

  .wvs-p8-line-1 {
    display: block;
    font-size: clamp(24px, 3.8vw, 44px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }

  .wvs-p8-line-1 .wvs-text-dark {
    color: #111111;
  }

  .wvs-p8-line-1 .wvs-text-orange {
    color: #F17022;
  }

  .wvs-p8-line-2 {
    display: block;
    margin-top: 4px;
  }

  .wvs-brand-pill-green {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 32px;
    background: linear-gradient(135deg, #009A44 0%, #00b853 100%);
    border: 2.5px solid #FDBA00;
    color: #ffffff;
    border-radius: 50px;
    font-size: clamp(20px, 3vw, 36px);
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 14px 38px rgba(0, 154, 68, 0.35), 0 0 20px rgba(253, 186, 0, 0.25);
  }

  .wvs-brand-pill-green i {
    color: #FDBA00;
  }

  .wvs-p8-intro-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    max-width: 820px;
    margin: 0 auto 35px auto;
    font-weight: 600;
  }

  .wvs-split-ecosystem {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-bottom: 35px;
  }

  .wvs-eco-box {
    border-radius: 28px;
    padding: clamp(28px, 3.5vw, 40px) clamp(20px, 3vw, 32px);
    position: relative;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.05);
    transition: transform 0.35s ease;
  }

  .wvs-eco-box-growth {
    background: linear-gradient(145deg, #ffffff 0%, #fff7ed 100%);
    border: 2.5px solid #F17022;
    box-shadow: 0 18px 45px rgba(241, 112, 34, 0.12);
  }

  .wvs-eco-box-support {
    background: linear-gradient(145deg, #ffffff 0%, #f0fdf4 100%);
    border: 2.5px solid #009A44;
    box-shadow: 0 18px 45px rgba(0, 154, 68, 0.12);
  }

  .wvs-eco-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.35rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.1);
  }

  .wvs-eco-box-growth .wvs-eco-title {
    color: #F17022;
  }

  .wvs-eco-box-support .wvs-eco-title {
    color: #009A44;
  }

  .wvs-eco-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .wvs-eco-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #ffffff;
    border-radius: 18px;
    padding: 16px 20px;
    border: 1.5px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  .wvs-eco-item:hover {
    transform: translateX(8px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .wvs-eco-box-growth .wvs-eco-item:hover {
    border-color: #F17022;
  }

  .wvs-eco-box-support .wvs-eco-item:hover {
    border-color: #009A44;
  }

  .wvs-eco-item-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  .wvs-eco-box-growth .wvs-eco-item-icon {
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    color: #ffffff;
  }

  .wvs-eco-box-support .wvs-eco-item-icon {
    background: linear-gradient(135deg, #009A44 0%, #00b853 100%);
    color: #ffffff;
  }

  .wvs-eco-item-content h5 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 900;
    color: #111111;
    margin: 0 0 4px 0;
  }

  .wvs-eco-item-content p {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #475569;
    font-weight: 600;
    margin: 0;
  }

  .wvs-p8-cta-banner {
    background: linear-gradient(135deg, #009A44 0%, #007b3e 50%, #00b853 100%);
    border: 2.5px solid #FDBA00;
    border-radius: 26px;
    padding: 28px 24px;
    text-align: center;
    color: #ffffff;
    box-shadow: 0 18px 45px rgba(0, 154, 68, 0.35), 0 0 20px rgba(253, 186, 0, 0.2);
  }

  .wvs-p8-cta-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(20px, 2.8vw, 30px);
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .wvs-p8-cta-title span {
    color: #FDBA00;
    text-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  /* --- POINT 09: BUILT FOR ENTREPRENEURS --- */
  .wvs-p9-section {
    margin-bottom: 40px;
  }

  .wvs-p9-head {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 50px auto;
  }

  /* 5 Archetypes Grid */
  .wvs-p9-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .wvs-p9-card {
    flex: 0 0 calc(33.333% - 16px);
    max-width: calc(33.333% - 16px);
    box-sizing: border-box;
    background: #ffffff;
    border: 2px solid rgba(241, 112, 34, 0.18);
    border-radius: 24px;
    padding: 32px 24px;
    position: relative;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .wvs-p9-card:hover {
    transform: translateY(-8px);
    border-color: #F17022;
    box-shadow: 0 22px 50px rgba(241, 112, 34, 0.2), 0 0 0 4px rgba(241, 112, 34, 0.08);
  }

  .wvs-p9-card-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
    border: 2px solid #F17022;
    color: #F17022;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 18px;
    transition: all 0.35s ease;
    box-shadow: 0 6px 18px rgba(241, 112, 34, 0.15);
  }

  .wvs-p9-card:hover .wvs-p9-card-icon {
    transform: scale(1.12) rotate(-6deg);
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    border-color: #ffffff;
    color: #ffffff;
    box-shadow: 0 10px 25px rgba(241, 112, 34, 0.35);
  }

  .wvs-p9-card h4 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.18rem;
    font-weight: 900;
    color: #111111;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
  }

  .wvs-p9-card p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: #475569;
    font-weight: 600;
    margin: 0;
  }

  /* WHAT MATTERS MOST Section */
  .wvs-matters-box {
    background: linear-gradient(135deg, #009A44 0%, #008038 100%);
    border: 2.5px solid #FDBA00;
    border-radius: 28px;
    padding: 38px 30px;
    text-align: center;
    color: #ffffff;
    box-shadow: 0 20px 50px rgba(0, 154, 68, 0.3), 0 0 20px rgba(253, 186, 0, 0.2);
  }

  .wvs-matters-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 900;
    color: #FDBA00;
    margin-bottom: 24px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }

  .wvs-matters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .wvs-matter-pill {
    background: rgba(255, 255, 255, 0.12);
    border: 2px solid #FDBA00;
    border-radius: 18px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 1.05rem;
    font-weight: 900;
    color: #ffffff;
    transition: all 0.35s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .wvs-matter-pill:hover {
    background: rgba(241, 112, 34, 0.4);
    border-color: #ffffff;
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .wvs-matter-pill i {
    color: #FDBA00;
    flex-shrink: 0;
  }

  /* ==========================================================================
     POINT 09: THE BIGGER VISION
     ========================================================================== */
  .wvs-p9-section {
    margin-bottom: 70px;
  }

  .wvs-vision-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .wvs-vision-card {
    flex: 0 0 calc(33.333% - 16px);
    max-width: calc(33.333% - 16px);
    box-sizing: border-box;
    background: #ffffff;
    border: 2px solid rgba(0, 154, 68, 0.22);
    border-radius: 24px;
    padding: 36px 28px;
    position: relative;
    text-align: center;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .wvs-vision-card:hover {
    transform: translateY(-8px);
    border-color: #009A44;
    box-shadow: 0 22px 50px rgba(0, 154, 68, 0.2), 0 0 0 4px rgba(0, 154, 68, 0.08);
  }

  .wvs-vision-icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
    border: 2px solid #009A44;
    color: #009A44;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    margin: 0 auto 20px auto;
    box-shadow: 0 6px 18px rgba(0, 154, 68, 0.15);
  }

  .wvs-vision-card h4 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.25rem;
    font-weight: 900;
    color: #231F20;
    margin-bottom: 12px;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .wvs-vision-card p {
    font-size: 0.96rem;
    line-height: 1.6;
    color: #475569;
    font-weight: 600;
    margin: 0;
  }

  .wvs-vision-card p strong {
    color: #009A44;
    font-weight: 800;
  }

  /* ==========================================================================
     POINT 10: OUR JOURNEY IS ALREADY UNDERWAY (VIBRANT LIGHT THEME)
     ========================================================================== */
  .wvs-p10-section {
    margin-bottom: 70px;
    background: radial-gradient(circle at 50% 0%, #FFFFFF 0%, #FFF8F0 50%, #F0FDF4 100%);
    border: 2.5px solid #F17022;
    border-radius: 36px;
    padding: clamp(45px, 6vw, 75px) 30px;
    color: #231F20;
    position: relative;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(241, 112, 34, 0.12), 0 0 40px rgba(0, 154, 68, 0.08);
  }

  .wvs-p10-head {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 50px auto;
  }

  .wvs-p10-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 24px;
    background: #FFF7ED;
    border: 1.5px solid #F17022;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 20px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.12);
  }

  .wvs-p10-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    color: #231F20;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .wvs-p10-title span {
    color: #F17022;
    font-weight: 900;
  }

  .wvs-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 980px;
    margin: 0 auto 40px auto;
  }

  .wvs-stat-box {
    background: #ffffff;
    border: 2.5px solid rgba(241, 112, 34, 0.22);
    border-radius: 26px;
    padding: 36px 24px;
    text-align: center;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wvs-stat-box:hover {
    transform: translateY(-8px);
    border-color: #F17022;
    box-shadow: 0 24px 50px rgba(241, 112, 34, 0.22), 0 0 0 4px rgba(241, 112, 34, 0.08);
  }

  .wvs-stat-num {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(40px, 5.5vw, 64px);
    font-weight: 900;
    background: linear-gradient(135deg, #F17022 0%, #FB5900 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
    margin-bottom: 12px;
    letter-spacing: -1px;
  }

  .wvs-stat-box:nth-child(2) .wvs-stat-num {
    background: linear-gradient(135deg, #009A44 0%, #00b853 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wvs-stat-box:nth-child(3) .wvs-stat-num {
    background: linear-gradient(135deg, #EAB308 0%, #D97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wvs-stat-label {
    font-size: 1.15rem;
    font-weight: 900;
    color: #231F20;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .wvs-p10-callout-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 15px;
  }

  .wvs-p10-callout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: clamp(15px, 2vw, 20px);
    font-weight: 800;
    color: #1e293b;
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF7ED 100%);
    padding: 16px 32px;
    border-radius: 50px;
    border: 2px solid #F17022;
    box-shadow: 0 12px 35px rgba(241, 112, 34, 0.18), 0 0 25px rgba(0, 154, 68, 0.1);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .wvs-p10-callout:hover {
    transform: scale(1.03);
    box-shadow: 0 16px 45px rgba(241, 112, 34, 0.28);
  }

  .wvs-callout-highlight {
    color: #009A44;
    font-weight: 900;
    background: #F0FDF4;
    padding: 6px 18px;
    border-radius: 50px;
    border: 1.5px solid #009A44;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 15px rgba(0, 154, 68, 0.12);
  }

  /* ==========================================================================
     POINT 11: THIS IS YOUR INVITATION (FINAL CTA)
     ========================================================================== */
  .wvs-p11-section {
