<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  {%- assign main_font = section.settings.main_font -%}
  {%- if main_font != blank -%}
    {{ main_font | font_face: font_display: 'swap' }}
  {%- endif -%}

  .vs-franchise-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 24px 12px 60px 12px;
    font-family: {% if main_font != blank %}{{ main_font.family }}, {{ main_font.fallback_families }}{% else %}'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif{% endif %};
    color: {{ section.settings.text_color }};
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .vs-franchise-wrapper {
      padding: 50px 20px 90px 20px;
    }
  }

  /* Soft Light Radial Glow Ornaments */
  .vs-franchise-wrapper::before {
    content: '';
    position: absolute;
    top: -100px;
    left: -100px;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vs-franchise-wrapper::after {
    content: '';
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.07) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vs-franchise-container {
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  /* Top Header Banner */
  .vs-franchise-header {
    text-align: center;
    margin-bottom: 24px;
    padding: 0 4px;
  }

  @media (min-width: 768px) {
    .vs-franchise-header {
      margin-bottom: 38px;
    }
  }

  .vs-brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.12) 0%, rgba(241, 114, 27, 0.06) 100%);
    border: 1px solid rgba(236, 92, 10, 0.25);
    color: #ec5c0a;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 12px;
    box-shadow: 0 2px 8px rgba(236, 92, 10, 0.08);
  }

  @media (min-width: 768px) {
    .vs-brand-badge {
      font-size: 13px;
      padding: 6px 18px;
      margin-bottom: 16px;
    }
  }

  .vs-franchise-title {
    font-size: clamp(22px, 5.8vw, 40px);
    font-weight: 900;
    color: #1a1a1a;
    line-height: 1.25;
    margin: 0 0 10px 0;
    text-transform: uppercase;
    letter-spacing: -0.3px;
    word-break: break-word;
  }

  .vs-franchise-title span {
    color: #ec5c0a;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vs-franchise-subtitle {
    font-size: clamp(13px, 3.5vw, 16px);
    color: #4b5563;
    max-width: 780px;
    margin: 0 auto 20px auto;
    line-height: 1.5;
    font-weight: 400;
  }

  /* TRUST CHIPS BAR - 2x2 GRID ON MOBILE (2 POINTS PER LINE), INLINE FLEX ON DESKTOP */
  .vs-trust-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 24px;
    padding: 0;
  }

  .vs-trust-chip {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    background: #ffffff;
    border: 1px solid rgba(236, 92, 10, 0.16);
    padding: 8px 10px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    font-size: 11px;
    font-weight: 700;
    color: #1e293b;
    box-sizing: border-box;
    width: 100%;
    transition: all 0.25s ease;
  }

  .vs-trust-chip i {
    color: #007b3e;
    font-size: 12px;
    background: rgba(0, 123, 62, 0.08);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .vs-trust-highlights {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin-bottom: 36px;
    }

    .vs-trust-chip {
      width: auto;
      border-radius: 50px;
      padding: 9px 20px;
      font-size: 13px;
      gap: 8px;
    }

    .vs-trust-chip i {
      width: 26px;
      height: 26px;
      font-size: 14px;
    }
  }

  /* Main Grid */
  .vs-franchise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
  }

  @media (min-width: 992px) {
    .vs-franchise-grid {
      grid-template-columns: 1.4fr 0.8fr;
      gap: 32px;
    }
  }

  /* Executive Form Card - Lucrative Mobile Polish */
  .vs-form-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 22px 14px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(236, 92, 10, 0.18);
    color: #1a1a1a;
    box-sizing: border-box;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  /* Gradient Top Bar Accent */
  .vs-form-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a 0%, #ff9800 50%, #007b3e 100%);
  }

  @media (min-width: 640px) {
    .vs-form-card {
      border-radius: 24px;
      padding: 36px 32px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.06);
    }
  }

  .vs-form-card-header {
    text-align: center;
    border-bottom: 2px dashed #f1f5f9;
    padding-bottom: 16px;
    margin-bottom: 20px;
  }

  .vs-form-brand-logo {
    max-height: 44px;
    width: auto;
    margin: 0 auto 8px auto;
    display: block;
  }

  @media (min-width: 768px) {
    .vs-form-brand-logo {
      max-height: 55px;
    }
  }

  .vs-text-logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 18px;
    font-weight: 900;
    margin-bottom: 6px;
  }

  .vs-text-logo .logo-vs {
    background: #ec5c0a;
    color: #ffffff;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 15px;
  }

  .vs-text-logo .logo-name {
    color: #1a1a1a;
  }

  .vs-text-logo .logo-name span {
    color: #ec5c0a;
  }

  .vs-form-card-header h3 {
    font-size: 14px;
    font-weight: 800;
    color: #007b3e;
    margin: 4px 0 0 0;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .vs-form-card-header h3 {
      font-size: 18px;
    }
  }

  /* Form Step Divider Badges for Mobile Clarity */
  .vs-form-step-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    color: #ec5c0a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 6px 0 10px 0;
    background: rgba(236, 92, 10, 0.06);
    padding: 3px 10px;
    border-radius: 4px;
    width: fit-content;
  }

  /* Form Inputs & Mobile Stacking */
  .vs-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }

  @media (min-width: 640px) {
    .vs-form-row {
      gap: 18px;
      margin-bottom: 18px;
    }
    .vs-form-row.two-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .vs-form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    box-sizing: border-box;
  }

  .vs-form-group label {
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .vs-form-group label span.required {
    color: #e53e3e;
  }

  .vs-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .vs-input-wrapper i.vs-field-icon {
    position: absolute;
    left: 12px;
    color: #ec5c0a;
    font-size: 14px;
    pointer-events: none;
    transition: color 0.2s ease;
  }

  .vs-input,
  .vs-select {
    width: 100%;
    height: 48px;
    padding: 0 12px 0 38px;
    font-size: 14px;
    font-family: inherit;
    color: #0f172a;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    outline: none;
    transition: all 0.25s ease;
    box-sizing: border-box;
  }

  .vs-select {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ec5c0a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 16px;
    cursor: pointer;
  }

  .vs-input:focus,
  .vs-select:focus {
    background: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 0 0 3.5px rgba(236, 92, 10, 0.14);
  }

  /* File Upload Card - Mobile Touch Friendly */
  .vs-file-upload-card {
    background: #fdfbf7;
    border: 1.5px dashed #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    transition: all 0.25s ease;
    cursor: pointer;
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
  }

  .vs-file-upload-card:hover {
    border-color: #ec5c0a;
    background: rgba(236, 92, 10, 0.03);
  }

  .vs-file-info {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
  }

  .vs-file-info i {
    font-size: 15px;
    color: #ec5c0a;
    flex-shrink: 0;
  }

  .vs-file-name {
    font-size: 11.5px;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 150px;
  }

  @media (min-width: 480px) {
    .vs-file-name {
      max-width: 220px;
      font-size: 12px;
    }
  }

  .vs-file-btn {
    background: #ec5c0a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    flex-shrink: 0;
  }

  .vs-file-upload-card input[type="file"] {
    display: none;
  }

  /* Terms Checkbox */
  .vs-terms-group {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 16px 0 20px 0;
  }

  .vs-terms-group input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #ec5c0a;
    cursor: pointer;
    margin-top: 1px;
    flex-shrink: 0;
  }

  .vs-terms-group label {
    font-size: 11.5px;
    color: #475569;
    line-height: 1.45;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .vs-terms-group label {
      font-size: 12.5px;
    }
  }

  .vs-terms-group label a {
    color: #ec5c0a;
    font-weight: 700;
    text-decoration: underline;
  }

  /* Submit Button - Mobile Touch Target */
  .vs-submit-btn {
    width: 100%;
    height: 52px;
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff;
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(236, 92, 10, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (min-width: 640px) {
    .vs-submit-btn {
      height: 54px;
      font-size: 16px;
      letter-spacing: 1px;
    }
  }

  .vs-submit-btn:hover,
  .vs-submit-btn:active {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(236, 92, 10, 0.45);
    background: linear-gradient(135deg, #d94e02 0%, #ec5c0a 100%);
  }

  /* Success Notice */
  .vs-success-box {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    padding: 14px 16px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vs-success-box i {
    font-size: 20px;
    color: #007b3e;
    flex-shrink: 0;
  }

  /* Side Perks Card */
  .vs-side-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 22px 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 123, 62, 0.15);
    color: #1a1a1a;
    box-sizing: border-box;
    width: 100%;
  }

  @media (min-width: 640px) {
    .vs-side-card {
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.05);
    }
  }

  .vs-side-title {
    font-size: 16px;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 16px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (min-width: 640px) {
    .vs-side-title {
      font-size: 18px;
      margin: 0 0 20px 0;
      padding-bottom: 12px;
    }
  }

  .vs-side-title i {
    color: #007b3e;
  }

  .vs-perk-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .vs-perk-icon {
    width: 36px;
    height: 36px;
    background: rgba(0, 123, 62, 0.08);
    color: #007b3e;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .vs-perk-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      font-size: 17px;
    }
  }

  .vs-perk-content h4 {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 3px 0;
  }

  .vs-perk-content p {
    font-size: 12px;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }

  /* Earning Highlight Banner */
  .vs-earning-banner {
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.08) 0%, rgba(241, 114, 27, 0.16) 100%);
    border: 1.5px dashed #ec5c0a;
    border-radius: 14px;
    padding: 18px 14px;
    text-align: center;
    margin-top: 20px;
  }

  .vs-earning-banner h4 {
    font-size: 11px;
    font-weight: 800;
    color: #ec5c0a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0 0 4px 0;
  }

  .vs-earning-banner p.earning-val {
    font-size: clamp(20px, 5.5vw, 26px);
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 4px 0;
  }

  .vs-earning-banner p.earning-desc {
    font-size: 11.5px;
    color: #475569;
    margin: 0;
    line-height: 1.35;
  }

  /* Mobile Support Buttons */
  .vs-support-card {
    margin-top: 20px;
    background: #f8fafc;
    border-radius: 12px;
    padding: 14px;
    text-align: center;
    border: 1px solid #e2e8f0;
  }

  .vs-support-card p {
    font-size: 12.5px;
    font-weight: 700;
    color: #334155;
    margin: 0 0 10px 0;
  }

  .vs-support-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 480px) {
    .vs-support-buttons {
      flex-direction: row;
      justify-content: center;
      gap: 10px;
    }
  }

  .vs-support-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 480px) {
    .vs-support-btn {
      width: auto;
    }
  }

  .vs-support-btn.wa {
    background: #25d366;
    color: #ffffff;
  }

  .vs-support-btn.call {
    background: #0284c7;
    color: #ffffff;
  }
</style>

<div class="vs-franchise-wrapper">
  <div class="vs-franchise-container">
    
    <!-- Top Header Banner -->
    <div class="vs-franchise-header">
      <div class="vs-brand-badge">
        <i class="fa-solid fa-bolt"></i> {{ section.settings.badge_text }}
      </div>
      <h1 class="vs-franchise-title">
        {{ section.settings.heading_main }} <span>{{ section.settings.heading_highlight }}</span>
      </h1>
      <p class="vs-franchise-subtitle">
        {{ section.settings.subheading }}
      </p>

      <!-- HORIZONTAL SLEEK TRUST CHIPS BAR FOR MOBILE & DESKTOP -->
      <div class="vs-trust-highlights">
        <div class="vs-trust-chip">
          <i class="fa-solid fa-certificate"></i> ISO 9001:2015 Certified
        </div>
        <div class="vs-trust-chip">
          <i class="fa-solid fa-microchip"></i> US-German Terahertz Tech
        </div>
        <div class="vs-trust-chip">
          <i class="fa-solid fa-shield-halved"></i> 100% Legal & Approved
        </div>
        <div class="vs-trust-chip">
          <i class="fa-solid fa-truck-fast"></i> Pan-India Distribution
        </div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="vs-franchise-grid">
      
      <!-- Application Form Card -->
      <div class="vs-form-card">
        
        <div class="vs-form-card-header">
          {%- if section.settings.form_logo != blank -%}
            <img src="{{ section.settings.form_logo | image_url: width: 250 }}" alt="Vidhyut Saathi" class="vs-form-brand-logo" loading="lazy">
          {%- elsif settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 250 }}" alt="Vidhyut Saathi" class="vs-form-brand-logo" loading="lazy">
          {%- else -%}
            <div class="vs-text-logo">
              <span class="logo-vs">VS</span>
              <span class="logo-name">VIDHYUT <span>SAATHI</span></span>
            </div>
          {%- endif -%}
          <h3>BECOME A VIDHYUT SAATHI BUSINESS PARTNER</h3>
        </div>

        {%- form 'contact', id: 'vsFranchiseForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="vs-success-box">
              <i class="fa-solid fa-circle-check"></i>
              <div>
                <strong>Application Submitted Successfully!</strong><br>
                Our Business Expansion Team will contact you within 24 hours.
              </div>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div style="background:#fef2f2; border:1px solid #fca5a5; color:#991b1b; padding:14px; border-radius:10px; margin-bottom:20px; font-size:13px;">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <!-- Step 1: Personal & Entity Info -->
          <div class="vs-form-step-badge">
            <i class="fa-solid fa-user"></i> 01. Select Identity & Applicant Info
          </div>

          <!-- Row 1: Identity & Name/Company -->
          <div class="vs-form-row two-col">
            <div class="vs-form-group">
              <label for="vs_identity">Please Select Your Identity <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-user-tie vs-field-icon"></i>
                <select id="vs_identity" name="contact[Identity]" class="vs-select" required>
                  <option value="" disabled selected>-- Select Identity --</option>
                  <option value="Individual / Entrepreneur">Individual / Entrepreneur</option>
                  <option value="Proprietorship Firm">Proprietorship Firm</option>
                  <option value="Partnership / LLP">Partnership / LLP</option>
                  <option value="Private Limited Company">Private Limited Company</option>
                  <option value="Existing Electrical Dealer/Distributor">Existing Electrical Dealer/Distributor</option>
                </select>
              </div>
            </div>

            <div class="vs-form-group">
              <label for="vs_name">Name / Company Name <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-building vs-field-icon"></i>
                <input type="text" id="vs_name" name="contact[Name_Or_Company]" class="vs-input" placeholder="e.g. Raj Sharma / Apex Enterprises" required>
              </div>
            </div>
          </div>

          <!-- Row 2: Mobile & Email -->
          <div class="vs-form-row two-col">
            <div class="vs-form-group">
              <label for="vs_mobile">Mobile Number <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-phone vs-field-icon"></i>
                <input type="tel" id="vs_mobile" name="contact[Mobile_Number]" class="vs-input" placeholder="+91 98765 43210" pattern="[0-9+ ]{10,14}" required>
              </div>
            </div>

            <div class="vs-form-group">
              <label for="vs_email">Email Address <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-envelope vs-field-icon"></i>
                <input type="email" id="vs_email" name="contact[email]" class="vs-input" placeholder="name@domain.com" required>
              </div>
            </div>
          </div>

          <!-- Step 2: Location & Business Model -->
          <div class="vs-form-step-badge" style="margin-top: 10px;">
            <i class="fa-solid fa-location-dot"></i> 02. Location & Partnership Model
          </div>

          <!-- Row 3: City & Pincode -->
          <div class="vs-form-row two-col">
            <div class="vs-form-group">
              <label for="vs_city">Current City <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-location-dot vs-field-icon"></i>
                <input type="text" id="vs_city" name="contact[City]" class="vs-input" placeholder="e.g. Jaipur / Mumbai / Lucknow" required>
              </div>
            </div>

            <div class="vs-form-group">
              <label for="vs_pincode">Pincode <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-map-pin vs-field-icon"></i>
                <input type="text" id="vs_pincode" name="contact[Pincode]" class="vs-input" placeholder="e.g. 302001" pattern="[0-9]{6}" maxlength="6" required>
              </div>
            </div>
          </div>

          <!-- Row 4: Select Business Model -->
          <div class="vs-form-row">
            <div class="vs-form-group">
              <label for="vs_business_model">Select Your Business Model <span class="required">*</span></label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-briefcase vs-field-icon"></i>
                <select id="vs_business_model" name="contact[Business_Model]" class="vs-select" required>
                  <option value="" disabled selected>-- Select Business Partnership Model --</option>
                  <option value="NON-EXCLUSIVE DISTRICT FRANCHISE MODEL">NON-EXCLUSIVE DISTRICT FRANCHISE MODEL</option>
                  <option value="STANDARD EXCLUSIVE DISTRICT FRANCHISE MODEL">STANDARD EXCLUSIVE DISTRICT FRANCHISE MODEL</option>
                  <option value="PREMIUM EXCLUSIVE DISTRICT FRANCHISE MODEL">PREMIUM EXCLUSIVE DISTRICT FRANCHISE MODEL</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Step 3: Verification & KYC Documents -->
          <div class="vs-form-step-badge" style="margin-top: 10px;">
            <i class="fa-solid fa-id-card"></i> 03. Verification & Documents
          </div>

          <!-- Row 5: Address Proof Upload -->
          <div class="vs-form-row two-col">
            <div class="vs-form-group">
              <label for="vs_address_proof_type">Address Proof Type</label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-file-contract vs-field-icon"></i>
                <select id="vs_address_proof_type" name="contact[Address_Proof_Type]" class="vs-select">
                  <option value="Aadhaar Card">Aadhaar Card</option>
                  <option value="Electricity Bill">Electricity Bill</option>
                  <option value="Rent Agreement">Rent Agreement</option>
                  <option value="Voter ID Card">Voter ID Card</option>
                </select>
              </div>
            </div>

            <div class="vs-form-group">
              <label>Upload Address Proof</label>
              <label class="vs-file-upload-card" for="vs_address_file">
                <div class="vs-file-info">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                  <span class="vs-file-name" id="address_file_name">Choose File...</span>
                </div>
                <span class="vs-file-btn">Browse</span>
                <input type="file" id="vs_address_file" accept="image/*,.pdf" onchange="document.getElementById('address_file_name').innerText = this.files[0] ? this.files[0].name : 'Choose File...';">
              </label>
            </div>
          </div>

          <!-- Row 6: ID Proof Upload -->
          <div class="vs-form-row two-col">
            <div class="vs-form-group">
              <label for="vs_id_proof_type">ID Proof Type</label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-id-card vs-field-icon"></i>
                <select id="vs_id_proof_type" name="contact[ID_Proof_Type]" class="vs-select">
                  <option value="PAN Card">PAN Card</option>
                  <option value="Aadhaar Card">Aadhaar Card</option>
                  <option value="Passport">Passport</option>
                  <option value="Driving License">Driving License</option>
                </select>
              </div>
            </div>

            <div class="vs-form-group">
              <label>Upload ID Proof</label>
              <label class="vs-file-upload-card" for="vs_id_file">
                <div class="vs-file-info">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                  <span class="vs-file-name" id="id_file_name">Choose File...</span>
                </div>
                <span class="vs-file-btn">Browse</span>
                <input type="file" id="vs_id_file" accept="image/*,.pdf" onchange="document.getElementById('id_file_name').innerText = this.files[0] ? this.files[0].name : 'Choose File...';">
              </label>
            </div>
          </div>

          <!-- Row 7: GST Number & Referral Code -->
          <div class="vs-form-row two-col">
            <div class="vs-form-group">
              <label for="vs_gst">GST Number (Optional)</label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-receipt vs-field-icon"></i>
                <input type="text" id="vs_gst" name="contact[GST_Number]" class="vs-input" placeholder="e.g. 08AAAAA0000A1Z5">
              </div>
            </div>

            <div class="vs-form-group">
              <label for="vs_referral">Referral Code (Optional)</label>
              <div class="vs-input-wrapper">
                <i class="fa-solid fa-ticket vs-field-icon"></i>
                <input type="text" id="vs_referral" name="contact[Referral_Code]" class="vs-input" placeholder="e.g. VS-PARTNER-108">
              </div>
            </div>
          </div>

          <!-- Terms Checkbox -->
          <div class="vs-terms-group">
            <input type="checkbox" id="vs_terms" required checked>
            <label for="vs_terms">
              I agree to all <a href="/policies/terms-of-service" target="_blank">Terms & Conditions</a> and authorize Vidhyut Saathi team to contact me regarding business partnership opportunities.
            </label>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="vs-submit-btn">
            <i class="fa-solid fa-paper-plane"></i> BOOK NOW / SUBMIT APPLICATION
          </button>

        {%- endform -%}

      </div>

      <!-- Right Perks Card -->
      <div class="vs-side-card">
        <h3 class="vs-side-title">
          <i class="fa-solid fa-trophy"></i> Why Join Vidhyut Saathi?
        </h3>

        <div class="vs-perk-item">
          <div class="vs-perk-icon">
            <i class="fa-solid fa-sack-dollar"></i>
          </div>
          <div class="vs-perk-content">
            <h4>High Profit Margins</h4>
            <p>Earn exceptional profit margins on every unit sold with zero royalty fees.</p>
          </div>
        </div>

        <div class="vs-perk-item">
          <div class="vs-perk-icon">
            <i class="fa-solid fa-award"></i>
          </div>
          <div class="vs-perk-content">
            <h4>ISO & Lab Certified Quality</h4>
            <p>Tested and certified for 100% legal, safe, and effective electricity optimization.</p>
          </div>
        </div>

        <div class="vs-perk-item">
          <div class="vs-perk-icon">
            <i class="fa-solid fa-bullhorn"></i>
          </div>
          <div class="vs-perk-content">
            <h4>Marketing & Training Support</h4>
            <p>Get complete marketing kits, posters, demo units, and digital lead generation support.</p>
          </div>
        </div>

        <div class="vs-perk-item">
          <div class="vs-perk-icon">
            <i class="fa-solid fa-truck-ramp-box"></i>
          </div>
          <div class="vs-perk-content">
            <h4>Fast Dispatch & Inventory</h4>
            <p>Priority order dispatch across India with dedicated account management.</p>
          </div>
        </div>

        <!-- Earning Highlight Banner -->
        <div class="vs-earning-banner">
          <h4>EXPECTED MONTHLY INCOME</h4>
          <p class="earning-val">₹5,00,000 - ₹6,00,000+</p>
          <p class="earning-desc">Based on active territory dealers and direct commercial/residential sales.</p>
        </div>

        <!-- Direct Support Helpline -->
        <div class="vs-support-card">
          <p>Need Quick Assistance Before Applying?</p>
          <div class="vs-support-buttons">
            <a href="https://wa.me/919876543210?text=Hi%20Vidhyut%20Saathi%20Team,%20I%20want%20to%20apply%20for%20Franchise" class="vs-support-btn wa" target="_blank">
              <i class="fa-brands fa-whatsapp"></i> WhatsApp Us
            </a>
            <a href="tel:+919876543210" class="vs-support-btn call">
              <i class="fa-solid fa-phone"></i> Call Manager
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

