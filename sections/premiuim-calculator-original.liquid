      transition: all 0.3s ease !important;
    }
    .vs-calc-right-col-{{ section.id }} .calc-result-card:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 10px 25px rgba(20, 140, 58, 0.08) !important;
    }
    .vs-calc-right-col-{{ section.id }} .calc-result-card::before {
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      height: 4px !important;
      background: linear-gradient(90deg, #148C3A 0%, #20B14B 40%, #E67E22 80%, #F58220 100%) !important;
      border-radius: 18px 18px 0 0 !important;
      z-index: 2 !important;
    }
    .vs-calc-right-col-{{ section.id }} .calc-result-val {
      font-family: var(--heading-font) !important;
      font-size: 2.15rem !important;
      font-weight: 800 !important;
      background: linear-gradient(135deg, #1b8a32 0%, #a16207 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      line-height: 1.1 !important;
      margin-bottom: 6px !important;
      display: block !important;
    }
    .vs-calc-right-col-{{ section.id }} .calc-result-label {
      font-family: var(--body-font) !important;
      font-size: 0.88rem !important;
      color: #64748B !important;
      font-weight: 600 !important;
      line-height: 1.2 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .vs-calc-right-col-{{ section.id }} .calc-explain-badge {
      margin-top: 14px !important;
      margin-bottom: 12px !important;
    }

    .vs-calc-right-col-{{ section.id }} .calc-disclaimer {
      margin-top: 0 !important;
      margin-bottom: 16px !important;
    }

    .vs-calc-right-col-{{ section.id }} .trust-strip { 
      display: grid !important; 
      grid-template-columns: repeat(2, 1fr) !important; 
      gap: 12px !important; 
      margin-top: 0 !important; 
      width: 100% !important;
    }
    .vs-calc-right-col-{{ section.id }} .trust-item { 
      background: linear-gradient(#FFFFFF, #FFFFFF) padding-box, linear-gradient(90deg, #F58220 0%, #FFC107 50%, #20B14B 100%) border-box !important;
      border: 2px solid transparent !important;
      border-radius: 999px !important;
      padding: 10px 14px !important; 
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03) !important;
      transition: all 0.3s ease !important;
    }
    .vs-calc-right-col-{{ section.id }} .trust-item:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 20px rgba(245, 130, 32, 0.15) !important;
    }
    .vs-calc-right-col-{{ section.id }} .trust-icon {
      font-size: 1.15rem !important;
      margin-bottom: 2px !important;
      display: inline-block !important;
    }
    .vs-calc-right-col-{{ section.id }} .trust-item div {
      font-size: 0.85rem !important;
      font-weight: 700 !important;
      color: #1E293B !important;
      line-height: 1.2 !important;
    }
    .premium-calculator-original-{{ section.id }} .blur1 { width: 350px; height: 350px; top: -50px; right: -50px; }
    .premium-calculator-original-{{ section.id }} .blur2 { width: 300px; height: 300px; bottom: -50px; left: -50px; }
  }

  @keyframes pulse-{{ section.id }} { 50% { transform: scale(1.4); } }
  @keyframes sliderMove-{{ section.id }} { 0% { background-position: left center; } 100% { background-position: right center; } }
  @keyframes floatBlur-{{ section.id }} { 100% { transform: translateY(20px) translateX(10px); } }
  @keyframes bgFloat-{{ section.id }} { 100% { background-position: right bottom; } }
  @keyframes softGlow-{{ section.id }} { 50% { filter: drop-shadow(0 0 8px rgba(245,130,32,.25)); } }
  @keyframes cardEnter-{{ section.id }} { from { opacity: 0; transform: translateY(25px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes floatCard-{{ section.id }} { 0% { transform: translateY(0); } 100% { transform: translateY(-8px); } }
  @keyframes particleMove-{{ section.id }} { 0% { transform: translateY(100vh) translateX(0); } 100% { transform: translateY(-100vh) translateX(80px); } }
  @keyframes premiumOutline-{{ section.id }} { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
{%- endstyle -%}

<div class="premium-calculator-original-{{ section.id }}"
     id="calc-data-{{ section.id }}"
     data-price="{{ section.settings.calc_price }}"
     data-pct-base="{{ section.settings.pct_base }}"
     data-pct-mid="{{ section.settings.pct_mid }}"
     data-pct-high="{{ section.settings.pct_high }}">

  <div class="electric-particle" style="left:15%; animation-duration:7s;"></div>
  <div class="electric-particle" style="left:40%; animation-duration:11s;"></div>
  <div class="electric-particle" style="left:75%; animation-duration:9s;"></div>
  <div class="electric-particle" style="left:90%; animation-duration:13s;"></div>

  <div class="bg-grid"></div>
  <div class="blur blur1"></div>
  <div class="blur blur2"></div>

  <div class="wrapper">
    <!-- TOP CENTERED SECTION HEADER & SUBHEADER -->
    <div class="vs-calc-top-header-{{ section.id }}">
      <div class="tag-wrapper">
        <div class="section-tag"><div class="tag-dot"></div>{{ section.settings.tag_text }}</div>
      </div>
      <h2 class="section-title">
        {{ section.settings.heading_text }} <br>
        <span class="heading-line">{{ section.settings.heading_highlight }}</span>
      </h2>
      <p class="section-sub">{{ section.settings.subheading_text }}</p>
    </div>

    <!-- 2 SHUFFLED COLUMNS (LEFT: CALCULATOR CONTROLS | RIGHT: RESULTS & TRUST BADGES) -->
    <div class="vs-calc-desktop-grid-{{ section.id }}">
      
      <!-- LEFT COLUMN: INTERACTIVE CALCULATOR CONTROLS CARD -->
      <div class="vs-calc-left-col-{{ section.id }}">
        <div class="calc-card">

          <!-- BIG DISPLAY FOR CURRENT BILL -->
          <div class="calc-display-group">
            <div class="calc-label">{{ section.settings.slider_label }}</div>
            <div class="calc-current" id="billDisplay-{{ section.id }}">{{ section.settings.slider_default }}</div>
          </div>

          <!-- SLIDER CONTROL (FIRST) -->
          <div class="calc-label" style="margin-top: 10px;">🎚️ Drag Slider to Adjust Bill</div>
          <input type="range" class="calc-slider" id="billSlider-{{ section.id }}"
                 min="{{ section.settings.slider_min }}"
                 max="{{ section.settings.slider_max }}"
                 step="{{ section.settings.slider_step }}"
                 value="{{ section.settings.slider_default }}">

          <div style="display:flex; justify-content:space-between; font-size:.72rem; color:var(--muted); margin-top:8px; margin-bottom:18px;">
            <span id="minLabel-{{ section.id }}">₹{{ section.settings.slider_min }}</span>
            <span id="maxLabel-{{ section.id }}">₹{{ section.settings.slider_max }}</span>
          </div>

          <!-- DUAL EDITABLE NUMBER INPUTS (BILL RS SECOND & LOAD KW THIRD) -->
          <div class="input-dual-row">
            <div class="input-field-group">
              <div class="calc-label">💰 Monthly Electricity Bill</div>
              <div class="custom-bill-box">
                <span class="currency-symbol">₹</span>
                <input type="number" id="billInput-{{ section.id }}" class="custom-num-input" value="{{ section.settings.slider_default }}" min="500" max="300000" step="50">
              </div>
            </div>

            <div class="input-field-group">
              <div class="calc-label">⚡ Sanctioned Load</div>
              <div class="custom-bill-box">
                <input type="number" id="kwInput-{{ section.id }}" class="custom-num-input" value="" min="1" max="60" step="1">
                <span class="unit-symbol">KW</span>
              </div>
            </div>
          </div>

          <!-- PHASE TYPE SELECTOR TOGGLE BUTTONS -->
          <div class="phase-selector-container">
            <div class="calc-label">🔌 SELECT PHASE TYPE</div>
            <div class="phase-toggle-grid">
              <button type="button" class="phase-btn active" id="btnSinglePhase-{{ section.id }}" data-phase="single">
                <i class="fa-solid fa-bolt"></i> Single Phase
              </button>
              <button type="button" class="phase-btn" id="btnThreePhase-{{ section.id }}" data-phase="three">
                <i class="fa-solid fa-industry"></i> Three Phase (+1 Card)
              </button>
            </div>
          </div>

          <!-- DYNAMIC SMART LOAD & CARD RECOMMENDATION BAR -->
          <div class="calc-recommendation-bar" id="recBar-{{ section.id }}">
            <div class="calc-rec-pill">
              <i class="fa-solid fa-bolt-lightning"></i>
              <span class="rec-label">House Load:</span>
              <strong class="rec-val" id="recLoad-{{ section.id }}">1 - 6 KW</strong>
            </div>
            <div class="calc-rec-pill highlight-pill">
              <i class="fa-solid fa-layer-group"></i>
              <span class="rec-label">Cards Needed:</span>
              <strong class="rec-val" id="recCards-{{ section.id }}">1 Card (Single Phase)</strong>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: RESULTS CARDS, EXPLANATION, DISCLAIMER & TRUST CAPSULE PILLS -->
      <div class="vs-calc-right-col-{{ section.id }}">
        <!-- 4 CALCULATION RESULT CARDS -->
        <div class="calc-results">
          <div class="calc-result-card">
            <div class="calc-result-val" id="monthlySaving-{{ section.id }}">₹0</div>
            <div class="calc-result-label">{{ section.settings.label_monthly }}</div>
          </div>
          <div class="calc-result-card">
            <div class="calc-result-val" id="yearlySaving-{{ section.id }}">₹0</div>
            <div class="calc-result-label">{{ section.settings.label_yearly }}</div>
          </div>
          <div class="calc-result-card">
            <div class="calc-result-val" id="newBill-{{ section.id }}">₹0</div>
            <div class="calc-result-label">{{ section.settings.label_newbill }}</div>
          </div>
          <div class="calc-result-card">
            <div class="calc-result-val" id="roiMonths-{{ section.id }}">0 Mo</div>
            <div class="calc-result-label">{{ section.settings.label_roi }}</div>
          </div>
        </div>

        <!-- EXPLANATION BADGE & DISCLAIMER (MOVED HERE BELOW RESULTS CARDS) -->
        <div class="calc-explain-badge" id="recReason-{{ section.id }}">
          ⚡ <strong>Smart Selection:</strong> Evaluated from both KW Load and Monthly Bill — Higher Requirement Selected.
        </div>

        <p class="calc-disclaimer">{{ section.settings.disclaimer_text }}</p>

        <!-- TRUST STRIP CAPSULE PILLS -->
        <div class="trust-strip">
          {%- for block in section.blocks -%}
            <div class="trust-item" {{ block.shopify_attributes }}>
              <span class="trust-icon">{{ block.settings.icon }}</span>
              <div>{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  (function() {
    function initCalc() {
      const sectionId = '{{ section.id }}';
      const container = document.getElementById(`calc-data-${sectionId}`);
      if (!container) return;

      const slider = document.getElementById(`billSlider-${sectionId}`);
      const display = document.getElementById(`billDisplay-${sectionId}`);
      const mSaving = document.getElementById(`monthlySaving-${sectionId}`);
      const ySaving = document.getElementById(`yearlySaving-${sectionId}`);
      const nBill = document.getElementById(`newBill-${sectionId}`);
      const roi = document.getElementById(`roiMonths-${sectionId}`);

      const minLabel = document.getElementById(`minLabel-${sectionId}`);
      const maxLabel = document.getElementById(`maxLabel-${sectionId}`);

      if (!slider) return;

      if (minLabel && slider.min) minLabel.textContent = '₹' + parseInt(slider.min).toLocaleString('en-IN');
      if (maxLabel && slider.max) maxLabel.textContent = '₹' + parseInt(slider.max).toLocaleString('en-IN');

      const PRICE = parseFloat(container.dataset.price) || 3498;
      const pctBase = (parseFloat(container.dataset.pctBase) || 25) / 100.0;
      const pctMid = (parseFloat(container.dataset.pctMid) || 27) / 100.0;
      const pctHigh = (parseFloat(container.dataset.pctHigh) || 30) / 100.0;

      const recLoad = document.getElementById(`recLoad-${sectionId}`);
      const recCards = document.getElementById(`recCards-${sectionId}`);
      const recReason = document.getElementById(`recReason-${sectionId}`);

      const billInput = document.getElementById(`billInput-${sectionId}`);
      const kwInput = document.getElementById(`kwInput-${sectionId}`);
      const btnSingle = document.getElementById(`btnSinglePhase-${sectionId}`);
      const btnThree = document.getElementById(`btnThreePhase-${sectionId}`);

      let currentPhase = 'single';

      function getCardsByKW(kw) {
        if (kw <= 6) return 1;
        if (kw <= 12) return 2;
        if (kw <= 18) return 3;
        if (kw <= 24) return 4;
        if (kw <= 30) return 5;
        if (kw <= 36) return 6;
        if (kw <= 42) return 7;
        if (kw <= 48) return 8;
        if (kw <= 54) return 9;
        if (kw <= 60) return 10;
        return Math.ceil(kw / 6);
      }

      function getCardsByBill(bill) {
        if (bill <= 6000) return 1;
        if (bill <= 12000) return 2;
        if (bill <= 18000) return 3;
        if (bill <= 24000) return 4;
        if (bill <= 30000) return 5;
        if (bill <= 36000) return 6;
        if (bill <= 42000) return 7;
        if (bill <= 48000) return 8;
        if (bill <= 54000) return 9;
        if (bill <= 60000) return 10;
        return Math.ceil(bill / 6000);
      }

      function updateCalculator(source) {
        let bill = 0;
        if (source === 'slider') {
          bill = parseFloat(slider ? slider.value : 0) || 0;
          if (billInput) billInput.value = Math.round(bill);
        } else if (source === 'billInput') {
          bill = parseFloat(billInput ? billInput.value : 0) || 0;
          if (slider) slider.value = Math.min(300000, Math.max(500, bill));
        } else {
          bill = parseFloat(billInput && billInput.value ? billInput.value : (slider ? slider.value : 0)) || 0;
        }

        // Read KW load directly from user input without auto-writing kwInput.value on bill/slider change
        let kw = parseFloat(kwInput && kwInput.value ? kwInput.value : 0) || 0;

        const cardsFromKW = kw > 0 ? getCardsByKW(kw) : 0;
        const cardsFromBill = getCardsByBill(bill);

        // HIGHER PRIORITY SELECTION RULE
        const baseRequiredCards = Math.max(cardsFromKW, cardsFromBill);
        const totalCards = currentPhase === 'three' ? baseRequiredCards + 1 : baseRequiredCards;

        let pct = pctBase;
        if (bill > 10000 && bill <= 50000) pct = pctMid;
        if (bill > 50000) pct = pctHigh;

        const monthly = Math.round(bill * pct);
        const yearly = monthly * 12;
        const newBill = Math.max(0, bill - monthly);
        const roiMonths = monthly > 0 ? Math.ceil(PRICE / monthly) : 0;

        let cardsStr = totalCards + (totalCards === 1 ? ' Card' : ' Cards');
        if (currentPhase === 'three') {
          cardsStr += ` (${baseRequiredCards} + 1 Extra for 3-Phase)`;
        } else {
          cardsStr += ' (Single Phase)';
        }

        let higherReasonText = '';
        if (kw > 0) {
          if (cardsFromKW > cardsFromBill) {
            higherReasonText = `⚡ <strong>KW Rule Applied:</strong> ${kw} KW load requires ${cardsFromKW} Cards, while ₹${Math.round(bill).toLocaleString('en-IN')} bill requires ${cardsFromBill} Cards. Higher requirement considered (${cardsFromKW} Cards${currentPhase === 'three' ? ' + 1 Extra for 3-Phase = ' + totalCards + ' Cards' : ''}).`;
          } else if (cardsFromBill > cardsFromKW) {
            higherReasonText = `💰 <strong>Bill Rule Applied:</strong> ₹${Math.round(bill).toLocaleString('en-IN')} bill requires ${cardsFromBill} Cards, while ${kw} KW load requires ${cardsFromKW} Cards. Higher requirement considered (${cardsFromBill} Cards${currentPhase === 'three' ? ' + 1 Extra for 3-Phase = ' + totalCards + ' Cards' : ''}).`;
          } else {
            higherReasonText = `⚡ <strong>Balanced Load:</strong> Both ${kw} KW load and ₹${Math.round(bill).toLocaleString('en-IN')} bill require ${baseRequiredCards} Cards${currentPhase === 'three' ? ' (+ 1 Extra for 3-Phase = ' + totalCards + ' Cards)' : ''}.`;
          }
        } else {
          higherReasonText = `💰 <strong>Bill Rule Applied:</strong> ₹${Math.round(bill).toLocaleString('en-IN')} bill requires ${cardsFromBill} Cards${currentPhase === 'three' ? ' (+ 1 Extra for 3-Phase = ' + totalCards + ' Cards)' : ''}. (Enter your KW load above if known).`;
        }

        if (display) display.textContent = Math.round(bill).toLocaleString('en-IN');
        if (mSaving) mSaving.textContent = '₹' + monthly.toLocaleString('en-IN');
        if (ySaving) ySaving.textContent = '₹' + yearly.toLocaleString('en-IN');
        if (nBill) nBill.textContent = '₹' + newBill.toLocaleString('en-IN');
        if (roi) roi.textContent = (isFinite(roiMonths) && roiMonths > 0 ? roiMonths : 0) + ' Mo';
        if (recLoad) recLoad.textContent = kw > 0 ? (kw + ' KW') : '1 - 6 KW';
        if (recCards) recCards.textContent = cardsStr;
        if (recReason) recReason.innerHTML = higherReasonText;
      }

      if (btnSingle && btnThree) {
        btnSingle.addEventListener('click', function() {
          currentPhase = 'single';
          btnSingle.classList.add('active');
          btnThree.classList.remove('active');
          updateCalculator('phase');
        });

        btnThree.addEventListener('click', function() {
          currentPhase = 'three';
          btnThree.classList.add('active');
          btnSingle.classList.remove('active');
          updateCalculator('phase');
        });
      }

      slider.addEventListener('input', function() { updateCalculator('slider'); });
      slider.addEventListener('change', function() { updateCalculator('slider'); });

      if (billInput) {
        billInput.addEventListener('input', function() { updateCalculator('billInput'); });
        billInput.addEventListener('change', function() { updateCalculator('billInput'); });
      }

      if (kwInput) {
        kwInput.addEventListener('input', function() { updateCalculator('kwInput'); });
        kwInput.addEventListener('change', function() { updateCalculator('kwInput'); });
      }

      updateCalculator('init');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalc);
    } else {
      initCalc();
    }
  })();
</script>

