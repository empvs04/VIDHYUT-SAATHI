        <div class="mcb-filter-row row-2">
          <button class="mcb-filter-btn" onclick="filterMcb('office', this)"><i class="fa-solid fa-building"></i> Offices & IT Parks (5)</button>
          <button class="mcb-filter-btn" onclick="filterMcb('retail', this)"><i class="fa-solid fa-store"></i> Retail & Malls (5)</button>
        </div>
        <div class="mcb-filter-row row-3">
          <button class="mcb-filter-btn" onclick="filterMcb('hotel', this)"><i class="fa-solid fa-hotel"></i> Hotels & Cafes (5)</button>
          <button class="mcb-filter-btn" onclick="filterMcb('hospital', this)"><i class="fa-solid fa-hospital"></i> Hospitals & Clinics (5)</button>
        </div>
      </div>

      <div class="mcb-gallery-grid">
        {% for i in (1..20) %}
          {% capture img_key %}comm_mcb_img_{{ i }}{% endcapture %}
          {% assign custom_img = section.settings[img_key] %}

          {% assign block = nil %}
          {% if section.blocks.size >= i %}
            {% assign block_idx = i | minus: 1 %}
            {% assign block = section.blocks[block_idx] %}
          {% endif %}

          {% assign cat = 'office' %}
          {% assign badge = '3-PHASE DB PANEL' %}
          {% assign title = 'Commercial DB Setup #' | append: i %}
          {% assign desc = 'Parallel connection on main 63A commercial breaker with zero downtime.' %}

          {% if i > 5 and i <= 10 %}
            {% assign cat = 'retail' %}
            {% assign badge = 'RETAIL STORE MCB' %}
            {% assign title = 'Supermarket DB Box #' | append: i %}
          {% elsif i > 10 and i <= 15 %}
            {% assign cat = 'hotel' %}
            {% assign badge = 'HOTEL HVAC PANEL' %}
            {% assign title = 'Hotel Chiller DB #' | append: i %}
          {% elsif i > 15 %}
            {% assign cat = 'hospital' %}
            {% assign badge = 'HOSPITAL MAINS DB' %}
            {% assign title = 'Hospital Elevator DB #' | append: i %}
          {% endif %}

          {% if block != nil %}
            {% if block.settings.title != blank %}{% assign title = block.settings.title %}{% endif %}
            {% if block.settings.category != blank %}{% assign cat = block.settings.category %}{% endif %}
            {% if block.settings.badge != blank %}{% assign badge = block.settings.badge %}{% endif %}
            {% if block.settings.caption != blank %}{% assign desc = block.settings.caption %}{% endif %}
            {% if block.settings.image != blank %}{% assign custom_img = block.settings.image %}{% endif %}
          {% endif %}

          <div class="mcb-card" data-category="{{ cat }}" onclick="openMcbLightbox('{% if custom_img != blank %}{{ custom_img | image_url: width: 1200 }}{% endif %}', '{{ title | escape }}', '{{ desc | escape }}')">
            <div class="mcb-card-img-wrap">
              {% if custom_img != blank %}
                <img src="{{ custom_img | image_url: width: 600 }}" alt="{{ title }}" loading="lazy">
              {% else %}
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
                  <svg viewBox="0 0 400 300" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                    <rect width="400" height="300" fill="#0f172a"/>
                    <rect x="25" y="25" width="350" height="250" rx="12" fill="#1e293b" stroke="#00b050" stroke-width="2"/>
                    <rect x="50" y="55" width="190" height="190" rx="8" fill="#0f172a" stroke="#00b050" stroke-width="2"/>
                    <!-- 3-Phase Commercial Heavy MCBs -->
                    <rect x="70" y="80" width="22" height="55" rx="4" fill="#00b050"/>
                    <rect x="100" y="80" width="22" height="55" rx="4" fill="#00b050"/>
                    <rect x="130" y="80" width="22" height="55" rx="4" fill="#00b050"/>
                    <rect x="160" y="80" width="22" height="55" rx="4" fill="#ec5c0a"/>
                    <rect x="190" y="80" width="22" height="55" rx="4" fill="#00b050"/>
                    <circle cx="120" cy="180" r="8" fill="#25d366"/>
                    <text x="145" y="184" fill="#a7f3d0" font-size="10" font-family="Arial" font-weight="700">3-PHASE ON</text>
                    <!-- Gold Commercial VS Card -->
                    <rect x="260" y="75" width="95" height="150" rx="10" fill="url(#commMcbGlow{{ i }})" stroke="#ffd700" stroke-width="2"/>
                    <circle cx="307" cy="120" r="20" fill="rgba(255,255,255,0.1)"/>
                    <text x="307" y="124" text-anchor="middle" fill="#ffffff" font-size="14" font-weight="800">⚡</text>
                    <text x="307" y="165" text-anchor="middle" fill="#ffffff" font-size="9" font-weight="800" font-family="Arial">VIDHYUT SAATHI</text>
                    <text x="307" y="180" text-anchor="middle" fill="#a7f3d0" font-size="8" font-family="Arial">COMMERCIAL #{{ i }}</text>
                    <line x1="220" y1="105" x2="260" y2="105" stroke="#ffd700" stroke-width="3" stroke-dasharray="4,4"/>
                    <defs>
                      <linearGradient id="commMcbGlow{{ i }}" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#008744"/>
                        <stop offset="100%" stop-color="#0f172a"/>
                      </linearGradient>
                    </defs>
                  </svg>
                </div>
              {% endif %}
              <span class="mcb-card-badge">{{ badge }}</span>
              <div class="mcb-zoom-overlay" style="position:absolute; inset:0; background:rgba(6,78,59,0.5); display:flex; align-items:center; justify-content:center; color:#ffffff; font-size:20px; opacity:0; transition:opacity 0.2s;"><i class="fa-solid fa-magnifying-glass-plus"></i></div>
            </div>
            <div class="mcb-card-body">
              <span style="font-size:10px; font-weight:800; font-family:'IBM Plex Mono',monospace; color:var(--green-d);">COMMERCIAL SETUP #{{ i }}</span>
              <h4 class="mcb-card-title">{{ title }}</h4>
              <p class="mcb-card-desc">{{ desc }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

