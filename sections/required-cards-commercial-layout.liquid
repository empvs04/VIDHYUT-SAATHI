<script>
  var vscomThreePhase = true;

  function vscomSetPhase(isThree) {
    vscomThreePhase = isThree;
    var btnSingle = document.getElementById('vscom_btn_single');
    var btnThree = document.getElementById('vscom_btn_three');
    if (isThree) {
      btnThree.classList.add('active');
      btnSingle.classList.remove('active');
    } else {
      btnSingle.classList.add('active');
      btnThree.classList.remove('active');
    }
    vscomSync();
  }

  function vscomSync(source) {
    var kwSlider = document.getElementById('vscom_kw_slider');
    var kwNum = document.getElementById('vscom_kw_num');
    var billNum = document.getElementById('vscom_bill_num');
    var peakBillNum = document.getElementById('vscom_peak_bill_num');

    if (!kwSlider || !kwNum || !billNum) return;

    var kw = parseInt(kwNum.value) || 18;
    var bill = parseInt(billNum.value) || 0;
    var peakBill = parseInt(peakBillNum ? peakBillNum.value : 0) || 0;

    if (source === 'slider') {
      kw = parseInt(kwSlider.value) || 6;
      kwNum.value = kw;
    } else if (source === 'kw') {
      kw = Math.max(1, kw);
      kwSlider.value = Math.min(kw, 150);
    } else if (source === 'bill') {
      bill = Math.max(0, bill);
    } else if (source === 'peakBill') {
      peakBill = Math.max(0, peakBill);
    }

    kwSlider.style.setProperty('--fill', (Math.min(kw, 150) / 150 * 100) + '%');

    var kwBadge = document.getElementById('vscom_kw_badge');
    var billBadge = document.getElementById('vscom_bill_badge');
    var peakBillBadge = document.getElementById('vscom_peak_bill_badge');
    if (kwBadge) kwBadge.innerText = kw + ' KW';
    if (billBadge) billBadge.innerText = '₹' + bill.toLocaleString('en-IN');
    if (peakBillBadge) peakBillBadge.innerText = peakBill > 0 ? '₹' + peakBill.toLocaleString('en-IN') : '₹0';

    // 1 Card per 6 KW (if 3-Phase, +1 card to balance 3 phase lines)
    var kwCards = Math.max(1, Math.ceil(kw / 6));
    var billCards = bill > 0 ? Math.max(1, Math.ceil(bill / 6000)) : 1;
    var peakBillCards = peakBill > 0 ? Math.max(1, Math.ceil(peakBill / 6000)) : 0;
    var baseCards = Math.max(kwCards, billCards, peakBillCards);
    var total = vscomThreePhase ? baseCards + 1 : baseCards;

    var numCardEl = document.getElementById('vscom_card_num');
    var unitCardEl = document.getElementById('vscom_card_unit');
    if (numCardEl) numCardEl.innerText = total;
    if (unitCardEl) unitCardEl.innerText = total > 1 ? 'Cards' : 'Card';

    /* Dynamic Mini Gold Cards Row */
    var miniCardsRow = document.getElementById('vscom_mini_cards_row');
    if (miniCardsRow) {
      miniCardsRow.innerHTML = '';
      var capped = Math.min(total, 30);
      for (var i = 0; i < capped; i++) {
        var icon = document.createElement('div');
        icon.className = 'vscom-mini-card-icon';
        icon.title = 'Commercial Card ' + (i + 1);
        miniCardsRow.appendChild(icon);
      }
      if (total > 30) {
        var more = document.createElement('span');
        more.style.cssText = 'font-family:Baloo 2,sans-serif;color:#008744;font-size:13px;font-weight:800;align-self:center;margin-left:4px;';
        more.textContent = '+' + (total - 30) + ' more';
        miniCardsRow.appendChild(more);
      }
    }

    // 20-30% DISCOM Bill Savings
    var baseBillForSavings = Math.max(bill, peakBill);
    var sMin = Math.round((baseBillForSavings * 0.20) / 100) * 100;
    var sMax = Math.round((baseBillForSavings * 0.30) / 100) * 100;
    var savingsRangeEl = document.getElementById('vscom_savings_range');
    if (savingsRangeEl) {
      savingsRangeEl.innerText = '₹' + sMin.toLocaleString('en-IN') + ' – ₹' + sMax.toLocaleString('en-IN') + ' / mo';
    }
  }

  var kwSliderElemCom = document.getElementById('vscom_kw_slider');
  if (kwSliderElemCom) {
    kwSliderElemCom.addEventListener('input', function() { vscomSync('slider'); });
    kwSliderElemCom.addEventListener('change', function() { vscomSync('slider'); });
  }

  var kwNumElemCom = document.getElementById('vscom_kw_num');
  if (kwNumElemCom) {
    kwNumElemCom.addEventListener('input', function() { vscomSync('kw'); });
  }

  var billNumElemCom = document.getElementById('vscom_bill_num');
  if (billNumElemCom) {
    billNumElemCom.addEventListener('input', function() { vscomSync('bill'); });
  }

  var peakBillNumElemCom = document.getElementById('vscom_peak_bill_num');
  if (peakBillNumElemCom) {
    peakBillNumElemCom.addEventListener('input', function() { vscomSync('peakBill'); });
  }

  // Initial Sync
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { vscomSync('init'); });
  } else {
    vscomSync('init');
  }

  /* COMMERCIAL MCB GALLERY FILTER & LIGHTBOX */
  function filterMcb(category, btnElem) {
