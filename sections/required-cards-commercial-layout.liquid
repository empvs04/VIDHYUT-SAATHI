<script>
  var vscomThreePhase = true;

  function vscomSetPhase(isThree) {
    vscomThreePhase = isThree;
    var btnSingle = document.getElementById('vscom_btn_single');
    var btnThree = document.getElementById('vscom_btn_three');
    if (isThree) {
      btnThree.classList.add('active');
      btnSingle.classList.remove('active');
    } else {
      btnSingle.classList.add('active');
      btnThree.classList.remove('active');
    }
    vscomSync();
  }

  function vscomSync(source) {
    var kwSlider = document.getElementById('vscom_kw_slider');
    var kwNum = document.getElementById('vscom_kw_num');
    var billNum = document.getElementById('vscom_bill_num');

    var kw = parseInt(kwNum.value) || 18;
    var bill = parseInt(billNum.value) || 18000;

    if (source === 'slider') {
      kw = parseInt(kwSlider.value) || 6;
      kwNum.value = kw;
      bill = kw * 1000;
      billNum.value = bill;
    } else if (source === 'kw') {
      kw = Math.max(1, kw);
      kwSlider.value = Math.min(kw, 150);
      bill = kw * 1000;
      billNum.value = bill;
    } else if (source === 'bill') {
      bill = Math.max(1000, bill);
      kw = Math.max(1, Math.round(bill / 1000));
      kwNum.value = kw;
      kwSlider.value = Math.min(kw, 150);
    }

    document.getElementById('vscom_kw_badge').innerText = kw + ' KW';
    document.getElementById('vscom_bill_badge').innerText = '₹' + bill.toLocaleString('en-IN');

    // 1 Card per 6 KW (if 3-Phase, +1 card to balance 3 phase lines)
    var baseCards = Math.max(1, Math.ceil(kw / 6));
    var total = vscomThreePhase ? baseCards + 1 : baseCards;

    document.getElementById('vscom_card_num').innerText = total;
    document.getElementById('vscom_card_unit').innerText = total > 1 ? 'Cards' : 'Card';

    // 20-30% DISCOM Bill Savings
    var sMin = Math.round((bill * 0.20) / 100) * 100;
    var sMax = Math.round((bill * 0.30) / 100) * 100;
    document.getElementById('vscom_savings_range').innerText = '₹' + sMin.toLocaleString('en-IN') + ' – ₹' + sMax.toLocaleString('en-IN') + ' / mo';
  }

  document.getElementById('vscom_kw_slider').addEventListener('input', function() { vscomSync('slider'); });
  document.getElementById('vscom_kw_num').addEventListener('input', function() { vscomSync('kw'); });
  document.getElementById('vscom_bill_num').addEventListener('input', function() { vscomSync('bill'); });

  /* COMMERCIAL MCB GALLERY FILTER & LIGHTBOX */
  function filterMcb(category, btnElem) {
    if (btnElem) {
      var allBtns = document.querySelectorAll('.mcb-filter-btn');
      allBtns.forEach(function(b) { b.classList.remove('active'); });
      btnElem.classList.add('active');
    }
    var cards = document.querySelectorAll('.mcb-card');
    cards.forEach(function(card) {
      var cat = card.getAttribute('data-category');
      if (category === 'all' || cat === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function openMcbLightbox(imgSrc, title, caption) {
    var container = document.getElementById('mcb_lightbox_img_container');
    if (imgSrc) {
      container.innerHTML = '<img src="' + imgSrc + '" style="max-width:100%; max-height:420px; object-fit:contain;">';
    } else {
      container.innerHTML = '<div style="padding:40px; text-align:center; color:#064e3b; font-size:18px; font-weight:800;"><i class="fa-solid fa-building" style="font-size:36px; margin-bottom:10px; display:block;"></i>' + title + '</div>';
    }
    document.getElementById('mcb_lightbox_title').innerText = title;
    document.getElementById('mcb_lightbox_desc').innerText = caption;
    document.getElementById('mcb_lightbox').classList.add('active');
  }

  function closeMcbLightbox() {
    document.getElementById('mcb_lightbox').classList.remove('active');
  }
</script>

