<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&family=IBM+Plex+Mono:wght@600;700&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     VIDHYUT SAATHI — COMMERCIAL REQUIRED CARDS PAGE
     Theme: Warm Cream #fff8ef | Commercial Deep Emerald #064e3b | Orange #ec5c0a
  ============================================================ */
  .vscom {
    --bg:       #fff8ef;
    --bg-warm:  #f5ebd9;
    --panel:    #ffffff;
    --panel-2:  #fbf6ec;
    --line:     #e7dcce;
    --line-s:   #f0e5d6;
    --green:    #007b3e;
    --green-d:  #064e3b;
    --green-t:  #e6f4ec;
    --orange:   #ec5c0a;
    --orange-d: #c84900;
    --orange-t: #ffefe5;
    --gold:     #c9982e;
    --ink:      #0f172a;
    --muted:    #475569;
    --muted-2:  #64748b;
    --maxw:     1180px;

    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    font-size: 16px;
    line-height: 1.55;
  }

  .vscom *, .vscom *::before, .vscom *::after {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  .vscom h1, .vscom h2, .vscom h3, .vscom h4 {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }

  .vscom a { color: inherit; text-decoration: none; }
  .vscom img { max-width: 100%; display: block; }
  .vscom button { font-family: inherit; cursor: pointer; }

  .vscom .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 16px;
  }
  @media(min-width: 640px){ .vscom .wrap { padding: 0 28px; } }

  /* ---- CATEGORY NAVIGATION STRIP ---- */
  .vscom-nav-strip {
    background: #ffffff;
    border-bottom: 1.5px solid var(--line);
    padding: 12px 16px;
    position: relative;
    z-index: 9999;
    pointer-events: auto !important;
    box-shadow: 0 4px 14px rgba(0,0,0,0.03);
  }

  .vscom-nav-container {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    pointer-events: auto !important;
  }

  .vscom-nav-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .vscom-nav-title i { color: var(--orange); }

  .vscom-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    pointer-events: auto !important;
  }
  .vscom-nav-links::-webkit-scrollbar { display: none; }

  .vscom-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: var(--muted);
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative;
    z-index: 10;
  }
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: var(--muted);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .vscom-nav-item:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .vscom-nav-item.active {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%);
    color: #ffffff;
    border-color: #008744;
    box-shadow: 0 4px 14px rgba(0, 135, 68, 0.3);
  }

  /* ---- HERO SECTION ---- */
  .vscom-hero {
    position: relative;
    padding: clamp(32px, 5vw, 65px) 0 clamp(24px, 4vw, 45px) 0;
    background: linear-gradient(135deg, #ffffff 0%, #e6f4ec 50%, #fff8ef 100%);
    border-bottom: 1.5px solid var(--line);
    overflow: hidden;
  }

  .vscom-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  @media(min-width: 900px){
    .vscom-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
    }
  }

  .vscom-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--green-t);
    border: 1.5px solid #007b3e;
    color: #007b3e;
    font-size: 11px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 16px;
    box-shadow: 0 4px 14px rgba(0, 123, 62, 0.1);
  }

  .vscom-hero h1 {
    font-size: clamp(25px, 5.2vw, 46px);
    line-height: 1.15;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 14px 0;
  }
  .vscom-hero h1 span {
    background: linear-gradient(135deg, #008744 0%, #ec5c0a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vscom-hero-lead {
    color: var(--muted);
    font-size: clamp(14px, 2vw, 16px);
    line-height: 1.6;
    margin: 0 0 24px 0;
    max-width: 620px;
  }

  .vscom-hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .vscom-btn-primary {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%);
    color: #ffffff;
    font-weight: 800;
    padding: 14px 26px;
    border-radius: 12px;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    box-shadow: 0 6px 20px rgba(0, 176, 80, 0.3);
    transition: all 0.2s ease;
  }
  .vscom-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(0, 176, 80, 0.42);
    background: linear-gradient(135deg, #007b3e 0%, #00994d 100%);
  }

  .vscom-btn-secondary {
    background: #ffffff;
    color: var(--orange-d);
    border: 1.5px solid var(--orange);
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.1);
  }
  .vscom-btn-secondary:hover {
    background: var(--orange-t);
    transform: translateY(-2px);
  }

  /* Trust Badges Strip */
  .vscom-trust-badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding-top: 20px;
    border-top: 1.5px solid var(--line);
  }
  @media(min-width: 600px){
    .vscom-trust-badges { grid-template-columns: repeat(4, 1fr); }
  }

  .vscom-trust-badge-item {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.02);
  }

  .vscom-trust-badge-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--green-t);
    color: #007b3e;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }

  .vscom-trust-badge-text strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .vscom-trust-badge-text span {
    font-size: 10.5px;
    color: var(--muted-2);
  }

  /* Right Card Image Showcase (Light & Crisp) */
  .vscom-hero-image-box {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 60%, #fff7ed 100%);
    border: 2px solid #e2e8f0;
    box-shadow: 0 16px 36px rgba(0,0,0,0.06);
    padding: 24px;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .vscom-hero-card-tag {
    background: #e6f4ec;
    border: 1px solid #007b3e;
    color: #007b3e;
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 4px 14px;
    border-radius: 50px;
    margin-bottom: 16px;
  }

  .vscom-mcb-hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1.5px solid #007b3e;
    color: #007b3e;
    font-size: 12.5px;
    font-weight: 800;
    padding: 8px 18px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: 10px;
    box-shadow: 0 4px 14px rgba(0, 123, 62, 0.12);
  }
  .vscom-mcb-hero-link:hover {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%);
    color: #ffffff;
    border-color: #008744;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 176, 80, 0.35);
  }

  /* ---- CALCULATOR SECTION ---- */
  .vscom-sec { padding: 44px 0; }
  @media(min-width: 768px){ .vscom-sec { padding: 60px 0; } }

  .vscom-sec-head {
    max-width: 680px;
    margin: 0 auto 28px;
    text-align: center;
  }
  .vscom-sec-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--green-d);
    margin-bottom: 6px;
  }
  .vscom-sec-title {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 10px 0;
  }
  .vscom-sec-desc {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
  }

  .vscom-calc-box {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    padding: 24px 18px;
  }
  @media(min-width: 860px){
    .vscom-calc-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding: 36px 30px;
    }
  }

  .vscom-field { margin-bottom: 20px; }
  .vscom-field-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .vscom-field-badge {
    background: var(--green-t);
    color: var(--green-d);
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 700;
  }

  .vscom-range-slider {
    width: 100%;
    height: 8px;
    border-radius: 50px;
    background: var(--line);
    outline: none;
    accent-color: var(--green-d);
    margin: 10px 0;
  }

  .vscom-num-input {
    width: 100%;
    height: 46px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 0 14px;
    font-size: 15px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
    color: var(--ink);
    background: #ffffff;
    outline: none;
  }

  .vscom-toggle-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 6px;
  }
  .vscom-toggle-btn {
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    font-weight: 700;
    font-size: 13.5px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }
  .vscom-toggle-btn:hover {
    border-color: #008744;
    color: #008744;
  }
  .vscom-toggle-btn.active {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%);
    color: #ffffff;
    border-color: #008744;
    box-shadow: 0 4px 12px rgba(0, 176, 80, 0.25);
  }

  .vscom-output-card {
    background: var(--panel-2);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .vscom-res-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(48px, 10vw, 68px);
    font-weight: 800;
    color: #008744;
    line-height: 1;
    margin: 8px 0 16px 0;
  }
  .vscom-res-val span {
    font-size: 16px;
    color: var(--muted);
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .vscom-savings-box {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%);
    border-radius: 14px;
    padding: 16px;
    color: #ffffff;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 14px rgba(0, 176, 80, 0.25);
  }

  /* ══ 20 COMMERCIAL MCB GALLERY ══ */
  .mcb-sec {
    background: #ffffff;
    border-top: 1.5px solid var(--line);
    border-bottom: 1.5px solid var(--line);
    padding: clamp(40px, 6vw, 75px) 0;
  }

  .mcb-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .mcb-filter-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .mcb-filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    font-family: inherit;
    background: #ffffff;
    color: #334155;
    border: 1.5px solid #cbd5e1;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    cursor: pointer;
    transition: all 0.25s ease;
    line-height: 1;
    outline: none;
  }

  .mcb-filter-btn i {
    font-size: 14px;
  }

  .mcb-filter-btn:hover {
    border-color: #008744;
    color: #008744;
    background: #f0fdf4;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 135, 68, 0.12);
  }

  .mcb-filter-btn.active {
    background: linear-gradient(135deg, #008744 0%, #00b050 100%);
    color: #ffffff;
    border-color: #008744;
    box-shadow: 0 4px 14px rgba(0, 176, 80, 0.3);
  }

  .mcb-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    align-items: stretch;
  }
  @media(min-width: 640px){ .mcb-gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  @media(min-width: 1024px){ .mcb-gallery-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }

  .mcb-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-top: 3.5px solid #008744;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    cursor: pointer;
  }
  .mcb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(0, 176, 80, 0.15);
    border-color: #008744;
  }

  .mcb-card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f8fafc;
  }
  .mcb-card-img-wrap img { width: 100%; height: 100%; object-fit: cover; }

  .mcb-card-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #ffffff;
    color: #007b3e;
    font-size: 9px;
    font-weight: 800;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 50px;
    border: 1px solid #007b3e;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    z-index: 2;
    white-space: nowrap;
    max-width: calc(100% - 16px);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mcb-card-body {
    padding: 12px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: left;
  }
  .mcb-card-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--ink);
    margin: 2px 0 4px 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mcb-card-desc {
    font-size: 11px;
    color: var(--muted-2);
    margin: 0;
    line-height: 1.4;
    text-align: left !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- COMMERCIAL SIZING TABLE (EXACT MATCH TO RESIDENTIAL TABLE) ---- */
  .vscom-table-wrap {
    background: #ffffff;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
  }

  .vscom-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .vscom-table thead tr {
    background: #007b3e;
    color: #ffffff;
  }

  .vscom-table th {
    padding: 12px 14px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    text-align: center;
  }
  .vscom-table th:first-child { text-align: left; }

  .vscom-table tbody tr {
    border-bottom: 1px solid var(--line-s);
  }
  .vscom-table tbody tr:nth-child(even) { background: #fbf8f0; }

  .vscom-table td {
    padding: 12px 14px;
    text-align: center;
    color: var(--muted);
  }
  .vscom-table td:first-child {
    text-align: left;
    font-weight: 800;
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
  }
  /* ---- WORKED EXAMPLES CASE STUDIES GRID ---- */
  .vsres-case-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }
  @media(min-width: 900px){
    .vsres-case-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .vsres-case-card {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .vsres-case-card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 16px 36px rgba(0,0,0,0.09) !important;
  }

  /* Mobile Justification & Lucrative Card Styling Overrides */
  @media (max-width: 767px) {
    .vscom p,
    .vscom .vscom-hero-lead,
    .vscom .vscom-sec-desc,
    .vscom .vsres-case-location {
      text-align: justify !important;
      text-justify: inter-word !important;
      hyphens: auto !important;
    }

    .vscom-hero {
      padding: 24px 0 32px 0;
      background: linear-gradient(180deg, #ffffff 0%, #e6f4ec 60%, #fff8ef 100%);
    }
    .vscom-hero h1 {
      font-size: clamp(24px, 7.5vw, 34px);
      line-height: 1.2;
      margin-bottom: 12px;
    }

    .vscom-hero-ctas {
      flex-direction: column;
      gap: 10px;
    }
    .vscom-btn-primary, .vscom-btn-secondary {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
      font-size: 15px;
      border-radius: 14px;
    }

    .mcb-sec {
      padding: 28px 0 36px 0;
      background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
    }

    /* 3 VERTICAL ROWS FILTER BAR ON MOBILE & DESKTOP */
    .mcb-filter-bar {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 8px !important;
      margin-bottom: 24px !important;
      padding: 0 !important;
      width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      overflow-x: visible !important;
    }

    .mcb-filter-row {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      width: 100% !important;
    }

    .mcb-filter-row.row-1 .mcb-filter-btn {
      width: 55% !important;
      min-width: unset !important;
      padding: 9px 16px !important;
      font-size: 12.5px !important;
      justify-content: center !important;
    }

    .mcb-filter-row.row-2 .mcb-filter-btn,
    .mcb-filter-row.row-3 .mcb-filter-btn {
      flex: 1 !important;
      padding: 9px 8px !important;
