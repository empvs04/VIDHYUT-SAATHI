  function vsGenerateCommercialBillSvg(name, loc, amount, type, cards) {
    var isNew = type === 'NEW';
    var bgHeader = isNew ? '#008744' : '#b91c1c';
    var accentBorder = isNew ? '#10b981' : '#f87171';
    var statusTitle = isNew ? 'REDUCED COMMERCIAL LT/HT TARIFF' : 'HIGH COMMERCIAL NON-DOMESTIC TARIFF';
    var stampText = isNew ? 'PAID & SAVED (20-30%)' : 'HIGH PENALTY LEVY';
    var stampColor = isNew ? '#008744' : '#b91c1c';
    var billDate = isNew ? 'Post-Installation Bill' : 'Pre-Installation Bill';
    var caNum = 'COMM-CA-' + Math.floor(10000000 + Math.random() * 90000000);
    
    return '<div style="width:100%; max-width:400px; background:#ffffff; border:2px solid ' + accentBorder + '; border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,0.06); font-family:\'Nunito\',sans-serif; overflow:hidden; position:relative;">' +
      '<div style="background:' + bgHeader + '; color:#ffffff; padding:12px 16px; display:flex; justify-content:space-between; align-items:center;">' +
      '<div>' +
        '<div style="font-size:10px; font-weight:800; letter-spacing:0.8px; opacity:0.9;">COMMERCIAL POWER DISTRIBUTION CORP</div>' +
        '<div style="font-size:13px; font-weight:800; font-family:\'Baloo 2\',sans-serif;">' + statusTitle + '</div>' +
      '</div>' +
      '<div style="font-size:18px;">' + (isNew ? '⚡' : '🏢') + '</div>' +
    '</div>' +
    '<div style="padding:14px 16px; font-size:11.5px; color:#334155; line-height:1.5;">' +
      '<div style="display:flex; justify-content:space-between; margin-bottom:8px; border-bottom:1px dashed #e2e8f0; padding-bottom:6px;">' +
        '<div><strong>Enterprise:</strong> ' + name + '<br><span style="color:#64748b; font-size:10.5px;">' + loc + '</span></div>' +
        '<div style="text-align:right;"><strong>' + caNum + '</strong><br><span style="color:#64748b; font-size:10.5px;">Tariff: LT/HT Commercial</span></div>' +
      '</div>' +
      '<div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; background:#f8fafc; padding:8px 10px; border-radius:8px; margin-bottom:10px; font-size:11px;">' +
        '<div>Billing Cycle: <strong>Monthly Commercial</strong></div>' +
        '<div>Status: <strong style="color:' + (isNew ? '#008744' : '#b91c1c') + ';">' + billDate + '</strong></div>' +
        '<div>Grid Setup: <strong>' + cards + '</strong></div>' +
        '<div>Power Factor: <strong>' + (isNew ? '0.99 (Penalty Waived)' : '0.82 (KVAh Penalty & Losses)') + '</strong></div>' +
      '</div>' +
      '<div style="border-top:1.5px solid #cbd5e1; padding-top:8px; display:flex; justify-content:space-between; align-items:center;">' +
        '<div>' +
          '<span style="font-size:10px; font-weight:800; color:#64748b; text-transform:uppercase;">TOTAL AMOUNT DUE</span>' +
          '<div style="font-size:19px; font-weight:800; font-family:\'IBM Plex Mono\',monospace; color:' + (isNew ? '#008744' : '#b91c1c') + ';">' + amount + '</div>' +
        '</div>' +
        '<div style="border:2px solid ' + stampColor + '; color:' + stampColor + '; font-size:9px; font-weight:900; padding:4px 8px; border-radius:6px; text-transform:uppercase; transform:rotate(-4deg); font-family:\'Baloo 2\',sans-serif; letter-spacing:0.5px;">' +
          stampText +
        '</div>' +
      '</div>' +
    '</div>' +
  '</div>';
  }
</script>

