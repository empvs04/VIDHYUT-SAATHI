      container.innerHTML = '<img src="' + imgSrc + '" style="max-width:100%; max-height:420px; object-fit:contain;">';
    } else {
      container.innerHTML = '<div style="padding:40px; text-align:center; color:#064e3b; font-size:18px; font-weight:800;"><i class="fa-solid fa-building" style="font-size:36px; margin-bottom:10px; display:block;"></i>' + title + '</div>';
    }
