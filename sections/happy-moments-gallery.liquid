<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">

{%- style -%}
  /* ===========================================================================
     SECTION 16: HAPPY MOMENTS GALLERY / OUR HAPPY JOURNEY
     Pure Crisp White Background + Animated Linings & Plus (+) Marks
     =========================================================================== */
  #hmGallerySection-{{ section.id }} {
    position: relative;
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 70 }}px 0;
    background: #ffffff !important; /* Pure White Background - Page Theme Removed */
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }

  /* Linings & Plus (+) Marks Animation Wrapper */
  .hm-gallery-linings-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  /* Grid Linings Pattern Behind Header & Cards */
  .hm-gallery-linings-pattern {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1300px;
    max-width: 100%;
    height: 320px;
    background-image: 
      linear-gradient(to right, rgba(225, 205, 185, 0.55) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(225, 205, 185, 0.55) 1px, transparent 1px);
    background-size: 70px 70px;
    background-position: center top;
    mask-image: radial-gradient(circle at 50% 35%, rgba(0,0,0,0.9) 25%, rgba(0,0,0,0) 80%);
    -webkit-mask-image: radial-gradient(circle at 50% 35%, rgba(0,0,0,0.9) 25%, rgba(0,0,0,0) 80%);
    animation: liningsFloat 10s ease-in-out infinite alternate;
  }

  @keyframes liningsFloat {
    0% { transform: translateX(-50%) translateY(0px); }
    100% { transform: translateX(-50%) translateY(-10px); }
  }

  /* Plus (+) Marks at Grid Intersections */
  .hm-plus-mark {
    position: absolute;
    color: rgba(220, 195, 170, 0.8);
    font-family: Arial, sans-serif;
    font-size: 18px;
    font-weight: 300;
    line-height: 1;
    user-select: none;
    animation: plusPulse 4s ease-in-out infinite alternate;
  }

  .hm-plus-mark-1 { top: 30px; left: 25%; animation-delay: 0s; }
  .hm-plus-mark-2 { top: 30px; right: 25%; animation-delay: 1s; }
  .hm-plus-mark-3 { top: 100px; left: 38%; animation-delay: 1.5s; }
  .hm-plus-mark-4 { top: 100px; right: 38%; animation-delay: 2.5s; }
  .hm-plus-mark-5 { top: 170px; left: 18%; animation-delay: 0.5s; }
  .hm-plus-mark-6 { top: 170px; right: 18%; animation-delay: 2s; }

  @keyframes plusPulse {
    0% { opacity: 0.35; transform: scale(0.85); }
    100% { opacity: 0.95; transform: scale(1.2); }
  }

  .hm-gallery-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  /* Header Section */
  .hm-gallery-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom | default: 36 }}px;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hm-gallery-script-subtitle {
    font-family: 'Dancing Script', 'Caveat', cursive;
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 700;
    color: {{ section.settings.subtitle_color | default: '#2b70e4' }};
    line-height: 1.1;
    margin: 0 0 6px 0;
    letter-spacing: 0.5px;
    display: inline-block;
  }

  .hm-gallery-main-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(26px, 4.2vw, 42px);
    font-weight: 800;
    color: {{ section.settings.heading_color | default: '#222222' }};
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Gradient Highlight Span for Heading */
  .hm-gallery-main-heading span,
  .hm-gallery-gradient-text {
    background: linear-gradient(90deg, #ec5c0a 0%, #ff9a00 50%, #007b3e 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
  }

  /* CAROUSEL SCROLLER CONTAINER WITH EXTRA VERTICAL PADDING FOR STAGGER EFFECT */
  .hm-gallery-carousel-viewport {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 35px 0 45px 0;
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }

  .hm-gallery-carousel-viewport::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
    width: 0;
    height: 0;
  }

  .hm-gallery-carousel-viewport.hm-is-grabbing {
    cursor: grabbing;
  }

  .hm-gallery-track {
    display: flex;
    gap: {{ section.settings.card_gap | default: 22 }}px;
    width: max-content;
    padding: 0 20px;
    will-change: transform, scroll-position;
    align-items: center;
  }

  /* Individual Image Cards with Alternating Up/Down Stagger Wave & Theme Border */
  .hm-gallery-card {
    flex: 0 0 {{ section.settings.card_width_desktop | default: 260 }}px;
    width: {{ section.settings.card_width_desktop | default: 260 }}px;
    height: {{ section.settings.card_height_desktop | default: 340 }}px;
    border-radius: {{ section.settings.card_radius | default: 20 }}px;
    overflow: hidden;
    position: relative;
    background: #ffffff;
    border: 2px solid rgba(236, 92, 10, 0.18);
    box-shadow: 0 12px 32px rgba(236, 92, 10, 0.12);
    transition: transform 0.45s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.45s ease, border-color 0.45s ease;
    display: block;
    text-decoration: none;
    box-sizing: border-box;
  }

  /* Alternating Zig-Zag Wave: Odd cards shifted down, Even cards shifted up */
  .hm-gallery-card:nth-child(odd) {
    transform: translateY({{ section.settings.stagger_offset | default: 24 }}px);
  }

  .hm-gallery-card:nth-child(even) {
    transform: translateY(-{{ section.settings.stagger_offset | default: 24 }}px);
  }

  .hm-gallery-card:nth-child(odd):hover {
    transform: translateY({{ section.settings.stagger_offset | default: 24 | minus: 8 }}px) scale(1.03);
    border-color: #ec5c0a;
    box-shadow: 0 22px 50px rgba(236, 92, 10, 0.28), 0 0 20px rgba(0, 123, 62, 0.18);
  }

  .hm-gallery-card:nth-child(even):hover {
    transform: translateY(-{{ section.settings.stagger_offset | default: 24 | plus: 8 }}px) scale(1.03);
    border-color: #ec5c0a;
    box-shadow: 0 22px 50px rgba(236, 92, 10, 0.28), 0 0 20px rgba(0, 123, 62, 0.18);
  }

  .hm-gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
    transition: transform 0.6s ease;
  }

  .hm-gallery-card:hover .hm-gallery-img {
    transform: scale(1.07);
  }

  /* Responsive Styling */
  @media screen and (max-width: 768px) {
    #hmGallerySection-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile | default: 45 }}px 0 {{ section.settings.padding_bottom_mobile | default: 50 }}px 0;
    }

    .hm-gallery-carousel-viewport {
      padding: 24px 0 30px 0;
    }

    .hm-gallery-header {
      margin-bottom: 20px;
    }

    .hm-gallery-script-subtitle {
      font-size: 22px;
    }

    .hm-gallery-main-heading {
      font-size: 26px;
    }

    .hm-gallery-track {
      gap: {{ section.settings.card_gap_mobile | default: 14 }}px;
      padding: 0 14px;
    }

    .hm-gallery-card {
      flex: 0 0 {{ section.settings.card_width_mobile | default: 190 }}px;
      width: {{ section.settings.card_width_mobile | default: 190 }}px;
      height: {{ section.settings.card_height_mobile | default: 250 }}px;
      border-radius: {{ section.settings.card_radius_mobile | default: 16 }}px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    /* Mobile Stagger Wave */
    .hm-gallery-card:nth-child(odd) {
      transform: translateY({{ section.settings.stagger_offset_mobile | default: 14 }}px);
    }

    .hm-gallery-card:nth-child(even) {
      transform: translateY(-{{ section.settings.stagger_offset_mobile | default: 14 }}px);
    }

    .hm-gallery-card:nth-child(odd):hover {
      transform: translateY({{ section.settings.stagger_offset_mobile | default: 14 | minus: 5 }}px) scale(1.02);
    }

    .hm-gallery-card:nth-child(even):hover {
      transform: translateY(-{{ section.settings.stagger_offset_mobile | default: 14 | plus: 5 }}px) scale(1.02);
    }
  }

  @media screen and (max-width: 480px) {
    .hm-gallery-card {
      flex: 0 0 170px;
      width: 170px;
      height: 230px;
    }
  }
{%- endstyle -%}

<section class="hm-gallery-section" id="hmGallerySection-{{ section.id }}">
  <!-- Background Linings & Plus (+) Marks Animation -->
  {%- if section.settings.show_grid -%}
    <div class="hm-gallery-linings-wrapper" aria-hidden="true">
      <div class="hm-gallery-linings-pattern"></div>
      <div class="hm-plus-mark hm-plus-mark-1">+</div>
      <div class="hm-plus-mark hm-plus-mark-2">+</div>
      <div class="hm-plus-mark hm-plus-mark-3">+</div>
      <div class="hm-plus-mark hm-plus-mark-4">+</div>
      <div class="hm-plus-mark hm-plus-mark-5">+</div>
      <div class="hm-plus-mark hm-plus-mark-6">+</div>
    </div>
  {%- endif -%}

  <div class="hm-gallery-container">
    <!-- Header -->
    <div class="hm-gallery-header">
      {%- if section.settings.subtitle != blank -%}
        <div class="hm-gallery-script-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hm-gallery-main-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <!-- Carousel Viewport -->
    <div class="hm-gallery-carousel-viewport" id="hmGalleryViewport-{{ section.id }}">
      <div class="hm-gallery-track" id="hmGalleryTrack-{{ section.id }}">
        
        {%- if section.blocks.size > 0 -%}
          <!-- SET 1 (Original Blocks) -->
          {%- for block in section.blocks -%}
            {%- assign card_href = block.settings.link -%}
            {%- if card_href != blank -%}
              <a href="{{ card_href }}" class="hm-gallery-card" {{ block.shopify_attributes }}>
            {%- else -%}
              <div class="hm-gallery-card" role="button" tabindex="0" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.alt_text | default: section.settings.heading | escape }}" class="hm-gallery-img" loading="lazy">
              {%- else -%}
                {%- assign placeholder_idx = forloop.index0 | modulo: 5 | plus: 1 -%}
                {%- case placeholder_idx -%}
                  {%- when 1 -%}
                    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=700&auto=format&fit=crop&q=80" alt="Happy Journey Mountain Landscape" class="hm-gallery-img" loading="lazy">
                  {%- when 2 -%}
                    <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=700&auto=format&fit=crop&q=80" alt="Happy Moments Roadtrip" class="hm-gallery-img" loading="lazy">
                  {%- when 3 -%}
                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=700&auto=format&fit=crop&q=80" alt="Happy Team Portrait" class="hm-gallery-img" loading="lazy">
                  {%- when 4 -%}
                    <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=700&auto=format&fit=crop&q=80" alt="Beautiful Lake Scenery" class="hm-gallery-img" loading="lazy">
                  {%- else -%}
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=700&auto=format&fit=crop&q=80" alt="Happy Customer Girl" class="hm-gallery-img" loading="lazy">
                {%- endcase -%}
              {%- endif -%}
            {%- if card_href != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

          <!-- SET 2 (Clones for infinite seamless loop) -->
          {%- for block in section.blocks -%}
            {%- assign card_href = block.settings.link -%}
            {%- if card_href != blank -%}
              <a href="{{ card_href }}" class="hm-gallery-card" aria-hidden="true" tabindex="-1">
            {%- else -%}
              <div class="hm-gallery-card" aria-hidden="true" tabindex="-1">
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.alt_text | default: section.settings.heading | escape }}" class="hm-gallery-img" loading="lazy">
              {%- else -%}
                {%- assign placeholder_idx = forloop.index0 | modulo: 5 | plus: 1 -%}
                {%- case placeholder_idx -%}
                  {%- when 1 -%}
                    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=700&auto=format&fit=crop&q=80" alt="Happy Journey Mountain Landscape" class="hm-gallery-img" loading="lazy">
                  {%- when 2 -%}
                    <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=700&auto=format&fit=crop&q=80" alt="Happy Moments Roadtrip" class="hm-gallery-img" loading="lazy">
                  {%- when 3 -%}
                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=700&auto=format&fit=crop&q=80" alt="Happy Team Portrait" class="hm-gallery-img" loading="lazy">
                  {%- when 4 -%}
                    <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=700&auto=format&fit=crop&q=80" alt="Beautiful Lake Scenery" class="hm-gallery-img" loading="lazy">
                  {%- else -%}
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=700&auto=format&fit=crop&q=80" alt="Happy Customer Girl" class="hm-gallery-img" loading="lazy">
                {%- endcase -%}
              {%- endif -%}
            {%- if card_href != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

          <!-- SET 3 (Buffer for wide screens) -->
          {%- for block in section.blocks -%}
            {%- assign card_href = block.settings.link -%}
            {%- if card_href != blank -%}
              <a href="{{ card_href }}" class="hm-gallery-card" aria-hidden="true" tabindex="-1">
            {%- else -%}
              <div class="hm-gallery-card" aria-hidden="true" tabindex="-1">
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.alt_text | default: section.settings.heading | escape }}" class="hm-gallery-img" loading="lazy">
              {%- else -%}
                {%- assign placeholder_idx = forloop.index0 | modulo: 5 | plus: 1 -%}
                {%- case placeholder_idx -%}
                  {%- when 1 -%}
                    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=700&auto=format&fit=crop&q=80" alt="Happy Journey Mountain Landscape" class="hm-gallery-img" loading="lazy">
                  {%- when 2 -%}
                    <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=700&auto=format&fit=crop&q=80" alt="Happy Moments Roadtrip" class="hm-gallery-img" loading="lazy">
                  {%- when 3 -%}
                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=700&auto=format&fit=crop&q=80" alt="Happy Team Portrait" class="hm-gallery-img" loading="lazy">
                  {%- when 4 -%}
                    <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=700&auto=format&fit=crop&q=80" alt="Beautiful Lake Scenery" class="hm-gallery-img" loading="lazy">
                  {%- else -%}
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=700&auto=format&fit=crop&q=80" alt="Happy Customer Girl" class="hm-gallery-img" loading="lazy">
                {%- endcase -%}
              {%- endif -%}
            {%- if card_href != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

        {%- else -%}
          <!-- Default 6 Fallback Cards if no block added yet -->
          {%- assign sample_imgs = "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=700&auto=format&fit=crop&q=80|https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=700&auto=format&fit=crop&q=80|https://images.unsplash.com/photo-1517841905240-472988babdf9?w=700&auto=format&fit=crop&q=80|https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=700&auto=format&fit=crop&q=80|https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=700&auto=format&fit=crop&q=80|https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=700&auto=format&fit=crop&q=80" | split: "|" -%}
          {%- for rep in (1..3) -%}
            {%- for img_url in sample_imgs -%}
              <div class="hm-gallery-card">
                <img src="{{ img_url }}" alt="Happy Journey Moments" class="hm-gallery-img" loading="lazy">
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initGallerySlider_{{ section.id | replace: '-', '_' }}() {
      const viewport = document.getElementById('hmGalleryViewport-{{ section.id }}');
      const track = document.getElementById('hmGalleryTrack-{{ section.id }}');
      if (!viewport || !track) return;

      const stepInterval = {{ section.settings.interval_seconds | default: 3 }} * 1000;
      let intervalTimer = null;
      let isPaused = false;
      let isDragging = false;
      let startX = 0;
      let scrollStart = 0;
      let dragDistance = 0;

      // Function to calculate exact step width (1 card width + gap)
      function getStepDistance() {
        const firstCard = track.querySelector('.hm-gallery-card');
        if (!firstCard) return 280;
        const cardWidth = firstCard.offsetWidth;
        const trackStyle = window.getComputedStyle(track);
        const gap = parseFloat(trackStyle.gap) || 20;
        return cardWidth + gap;
      }

      // Step transition right-to-left every 3 seconds
      function autoStepMove() {
        if (isPaused || isDragging) return;
        
        const step = getStepDistance();
        const maxLoopWidth = track.scrollWidth / 3;

        // Smoothly scroll forward by 1 card step
        viewport.scrollBy({
          left: step,
          behavior: 'smooth'
        });

        // Loop check after smooth scroll animation
        setTimeout(() => {
          if (viewport.scrollLeft >= maxLoopWidth * 2) {
            viewport.scrollLeft -= maxLoopWidth;
          }
        }, 500);
      }

      // Start interval timer
      function startAutoTimer() {
        clearInterval(intervalTimer);
        intervalTimer = setInterval(autoStepMove, stepInterval);
      }

      startAutoTimer();

      // Pause on mouse enter, resume on leave
      viewport.addEventListener('mouseenter', function() {
        isPaused = true;
      });

      viewport.addEventListener('mouseleave', function() {
        isPaused = false;
      });

      // Drag to scroll for Desktop Mouse
      viewport.addEventListener('mousedown', function(e) {
        isDragging = true;
        isPaused = true;
        dragDistance = 0;
        viewport.classList.add('hm-is-grabbing');
        startX = e.pageX - viewport.offsetLeft;
        scrollStart = viewport.scrollLeft;
      });

      window.addEventListener('mouseup', function() {
        if (isDragging) {
          isDragging = false;
          viewport.classList.remove('hm-is-grabbing');
          setTimeout(() => { isPaused = false; }, 1500);
        }
      });

      viewport.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - viewport.offsetLeft;
        const walk = (x - startX) * 1.3;
        dragDistance = Math.abs(walk);
        viewport.scrollLeft = scrollStart - walk;

        const maxLoopWidth = track.scrollWidth / 3;
        if (viewport.scrollLeft >= maxLoopWidth * 2) {
          viewport.scrollLeft -= maxLoopWidth;
          startX = e.pageX - viewport.offsetLeft;
          scrollStart = viewport.scrollLeft;
        } else if (viewport.scrollLeft <= 0) {
          viewport.scrollLeft += maxLoopWidth;
          startX = e.pageX - viewport.offsetLeft;
          scrollStart = viewport.scrollLeft;
        }
      });

      // Prevent accidental link clicks when dragging & prevent '#' anchor top jump
      viewport.querySelectorAll('.hm-gallery-card').forEach(function(card) {
        card.addEventListener('click', function(e) {
          const href = card.getAttribute('href');
          if (dragDistance > 10 || !href || href === '#' || href === 'javascript:void(0);' || href === 'javascript:void(0)') {
            e.preventDefault();
          }
        });
      });

      // Touch events for mobile
      viewport.addEventListener('touchstart', function() {
        isPaused = true;
      }, { passive: true });

      viewport.addEventListener('touchend', function() {
        setTimeout(() => {
          const maxLoopWidth = track.scrollWidth / 3;
          if (viewport.scrollLeft >= maxLoopWidth * 2) {
            viewport.scrollLeft -= maxLoopWidth;
          } else if (viewport.scrollLeft <= 0) {
            viewport.scrollLeft += maxLoopWidth;
          }
          isPaused = false;
        }, 1200);
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallerySlider_{{ section.id | replace: '-', '_' }});
    } else {
      initGallerySlider_{{ section.id | replace: '-', '_' }}();
    }
  })();
</script>

{% schema %}
{
  "name": "Happy Moments Gallery 16",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text (Optional)",
      "default": "⚡ MEMORABLE MILESTONES"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Script Subtitle",
      "default": "Happy Moments Gallery"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ec5c0a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Some Of Our Happy Journey"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0f172a"
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show Background Decorative Grid",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#fff8ef"
    },
    {
      "type": "range",
      "id": "interval_seconds",
      "min": 1,
      "max": 10,
