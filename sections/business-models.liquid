<script>
  document.addEventListener("DOMContentLoaded", function() {
    if (window.innerWidth <= 768) {
      const section = document.querySelector('.business-section-{{ section.id }}');
      const grid = section ? section.querySelector('.grid') : null;
      const dotsContainer = document.getElementById('vs-bm-dots-{{ section.id }}');
      
      if (grid && dotsContainer) {
        const cards = Array.from(grid.querySelectorAll('.card'));
        const dots = Array.from(dotsContainer.querySelectorAll('.dot'));
        let autoTimer = null;
        let currentIndex = 0;

        function updateDots(activeIndex) {
          dots.forEach((dot, idx) => {
            if (idx === activeIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        function scrollToCard(index) {
          if (!cards[index]) return;
          const cardWidth = grid.offsetWidth;
          grid.scrollTo({ left: index * cardWidth, behavior: 'smooth' });
          currentIndex = index;
          updateDots(currentIndex);
        }

        // Realtime Touch & Scroll Sync for Dots
        let scrollTimeout;
        grid.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            const scrollLeft = grid.scrollLeft;
            const cardWidth = grid.offsetWidth;
            const activeIndex = Math.min(Math.round(scrollLeft / cardWidth), cards.length - 1);
            if (currentIndex !== activeIndex) {
              currentIndex = activeIndex;
              updateDots(currentIndex);
            }
          }, 50);
        }, { passive: true });

        // Dot Click Navigation
        dots.forEach((dot, idx) => {
          dot.addEventListener('click', () => {
            scrollToCard(idx);
            resetAuto();
          });
        });

        // 5-Second Viewport Auto Slide
        function startAuto() {
          if (!autoTimer) {
            autoTimer = setInterval(() => {
              let nextIndex = (currentIndex + 1) % cards.length;
              scrollToCard(nextIndex);
            }, 5000);
          }
        }

        function stopAuto() {
          if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        }

        function resetAuto() {
          stopAuto();
          startAuto();
        }

        // IntersectionObserver for 5s Viewport Trigger
        const viewportObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              startAuto();
            } else {
              stopAuto();
            }
          });
        }, { threshold: 0.2 });

        viewportObserver.observe(grid);

        grid.addEventListener('touchstart', stopAuto, { passive: true });
        grid.addEventListener('touchend', startAuto, { passive: true });
      }
    }
  });
</script>

{% schema %}
{
  "name": "Franchise Models",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section Heading",
      "default": "BUSINESS<br>WITH US"
    }
  ],
  "blocks": [
    {
      "type": "franchise_card",
      "name": "Franchise Card",
      "settings": [
        {
          "type": "select",
          "id": "theme_color",
          "label": "Theme Color",
          "options": [
            { "value": "green", "label": "Green (Starter)" },
            { "value": "orange", "label": "Orange (Standard)" },
            { "value": "dark", "label": "Dark (Premium)" }
          ],
          "default": "green"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Growth Entry"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon Emoji",
          "default": "💼"
        },
        {
          "type": "textarea",
