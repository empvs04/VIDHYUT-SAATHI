      width: 44px !important;
      height: 44px !important;
      font-size: 20px !important;
      border-radius: 14px !important;
      box-shadow: 0 6px 18px rgba(247,148,29,.15) !important;
    }
    .business-section-{{ section.id }} .card h2 {
      font-size: 1.15rem !important;
      line-height: 1.15 !important;
      text-align: center !important;
      font-weight: 800 !important;
    }
    .business-section-{{ section.id }} .amount-box {
      margin: 10px 0 !important;
      padding: 12px 14px !important;
      border-radius: 14px !important;
      text-align: center !important;
    }
    .business-section-{{ section.id }} .amount { font-size: 1.85rem !important; font-weight: 900 !important; }
    .business-section-{{ section.id }} .points { gap: 10px !important; margin-top: 4px !important; }
    .business-section-{{ section.id }} .point {
      font-size: 13.5px !important;
      line-height: 1.35 !important;
      gap: 10px !important;
      font-weight: 700 !important;
    }
    .business-section-{{ section.id }} .badge {
      font-size: 10.5px !important;
      padding: 5px 12px !important;
      margin-bottom: 12px !important;
      letter-spacing: 0.8px !important;
    }
    .business-section-{{ section.id }} .heading h1 {
      font-size: 12vw !important;
      line-height: 1 !important;
      letter-spacing: -1px !important;
    }
    .business-section-{{ section.id }} .glow-line { width: 140px !important; height: 5px !important; }
    
    .business-section-{{ section.id }} .book-btn {
      width: 100% !important;
      max-width: 290px !important;
      padding: 12px 36px !important;
      font-size: 15px !important;
      margin: 16px auto 6px auto !important;
      border-radius: 999px !important;
      box-shadow: 0 8px 24px rgba(247,148,29,.35) !important;
      align-self: center !important;
    }
    .business-section-{{ section.id }} .book-btn svg {
      width: 22px !important;
      height: 22px !important;
    }
    .business-section-{{ section.id }} .book-btn .hand-left { left: 12px !important; }
    .business-section-{{ section.id }} .book-btn .hand-right { right: 12px !important; }

    .vs-bm-dots {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 8px !important;
      margin-top: 18px !important;
    }
    .vs-bm-dots .dot {
      width: 10px !important;
      height: 10px !important;
      border-radius: 50% !important;
