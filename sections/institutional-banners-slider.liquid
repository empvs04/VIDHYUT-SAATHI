              {% endif %}

              <div class="vsinst-banner-footer">
                <span class="vsinst-banner-btn">
                  {{ block.settings.button_text | default: 'Explore Setup' }} <i class="fa-solid fa-arrow-right-long"></i>
                </span>
                {% if block.settings.stat_tag != blank %}
                  <span class="vsinst-banner-stat">{{ block.settings.stat_tag }}</span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}

      {% else %}
        <!-- DUPLICATE PASS FOR SETTINGS FALLBACK CARDS -->
        {% for i in (1..10) %}
          {% capture img_key %}banner_img_{{ i }}{% endcapture %}
          {% capture badge_key %}banner_badge_{{ i }}{% endcapture %}
          {% capture title_key %}banner_title_{{ i }}{% endcapture %}
          {% capture desc_key %}banner_desc_{{ i }}{% endcapture %}
          {% capture stat_key %}banner_stat_{{ i }}{% endcapture %}
          {% capture btn_key %}banner_btn_{{ i }}{% endcapture %}
          {% capture link_key %}banner_link_{{ i }}{% endcapture %}
          {% capture badge_bg_key %}banner_badge_bg_{{ i }}{% endcapture %}

          {% assign card_img = section.settings[img_key] %}
          {% assign card_badge = section.settings[badge_key] %}
          {% assign card_title = section.settings[title_key] %}
          {% assign card_desc = section.settings[desc_key] %}
          {% assign card_stat = section.settings[stat_key] %}
          {% assign card_btn = section.settings[btn_key] %}
          {% assign card_link = section.settings[link_key] %}
          {% assign card_badge_bg = section.settings[badge_bg_key] | default: '#d97706' %}

          {% if i == 1 and card_title == blank %}
            {% assign card_badge = '🏥 HEALTHCARE CRITICAL' %}
            {% assign card_title = '24/7 ICU & Diagnostic Zero-Spike Power' %}
            {% assign card_desc = 'Stabilizing sensitive MRI, CT & surgical suites with 20%–30% genuine bill reduction.' %}
            {% assign card_stat = '⚡ 28.5% Saved' %}
            {% assign card_btn = 'View Medical Setup' %}
            {% assign card_badge_bg = '#d97706' %}
          {% elsif i == 2 and card_title == blank %}
            {% assign card_badge = '🎓 CAMPUS INFRASTRUCTURE' %}
            {% assign card_title = 'Centralized HVAC & Research Lab Efficiency' %}
            {% assign card_desc = 'Heavy 3-phase LT panel power factor correction across universities & academic blocks.' %}
            {% assign card_stat = '⚡ 28.0% Saved' %}
            {% assign card_btn = 'View Campus Setup' %}
            {% assign card_badge_bg = '#7c3aed' %}
          {% elsif i == 3 and card_title == blank %}
            {% assign card_badge = '🏫 INSTITUTIONAL HUBS' %}
            {% assign card_title = 'Smart Power Management for CBSE Campuses' %}
            {% assign card_desc = 'Safe, eco-certified power conservation for auditoriums, smart classes & labs.' %}
            {% assign card_stat = '⚡ 28.1% Saved' %}
            {% assign card_btn = 'View School Setup' %}
            {% assign card_badge_bg = '#059669' %}
          {% elsif i == 4 and card_title == blank %}
            {% assign card_badge = '🏛️ GOVT & PUBLIC BUILDINGS' %}
            {% assign card_title = 'DISCOM Non-Domestic Tariff Slashing' %}
            {% assign card_desc = 'Proven ₹1,00,000+ monthly budget savings with 10-year maintenance-free durability.' %}
            {% assign card_stat = '⚡ 28.4% Saved' %}
            {% assign card_btn = 'View Govt Case' %}
            {% assign card_badge_bg = '#b45309' %}
          {% elsif i == 5 and card_title == blank %}
            {% assign card_badge = '⚡ 0.99 POWER FACTOR' %}
            {% assign card_title = 'Continuous 3-Phase Substation Load Balancing' %}
            {% assign card_desc = 'Protecting high-load diagnostic scanners and centralized chillers with zero downtime.' %}
            {% assign card_stat = '⚡ Surge Protected' %}
            {% assign card_btn = 'Calculate Cards' %}
            {% assign card_badge_bg = '#ea580c' %}
          {% endif %}

          {% if card_title != blank %}
            {% assign img_url = '' %}
            {% if card_img != blank %}
              {% assign img_url = card_img | image_url: width: 900 %}
            {% elsif i == 1 %}
              {% assign img_url = 'commercial-building-2.png' | asset_url %}
            {% elsif i == 2 %}
              {% assign img_url = 'case-institutional.jpg' | asset_url %}
            {% elsif i == 3 %}
              {% assign img_url = 'commercial-building-1.png' | asset_url %}
            {% elsif i == 4 %}
              {% assign img_url = 'institutional-mcb-showcase-final.jpg' | asset_url %}
            {% elsif i == 5 %}
              {% assign img_url = 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80' %}
            {% else %}
              {% assign img_url = 'commercial-building-2.png' | asset_url %}
            {% endif %}

            <a href="{{ card_link | default: '#vsinst-calc' }}" class="vsinst-banner-card" aria-hidden="true" tabindex="-1" target="{% if card_link contains 'http' or card_link contains 'wa.me' %}_blank{% else %}_self{% endif %}">
              <img src="{{ img_url }}" alt="{{ card_title | escape }}" class="vsinst-banner-img" loading="lazy" onerror="this.onerror=null; this.src='https://cdn.shopify.com/s/files/1/0663/8783/7093/files/VS_Card_Final_Design_Golden_1.png';">
              
              <div class="vsinst-banner-overlay"></div>

              {% if card_badge != blank %}
                <span class="vsinst-card-top-badge" style="background: {{ card_badge_bg }}; color: #ffffff;">
                  {{ card_badge }}
                </span>
              {% endif %}

              <span class="vsinst-card-ratio-tag">4:3</span>

              <div class="vsinst-banner-content">
                <h3 class="vsinst-banner-heading">{{ card_title }}</h3>
                {% if card_desc != blank %}
                  <p class="vsinst-banner-sub">{{ card_desc }}</p>
                {% endif %}

                <div class="vsinst-banner-footer">
                  <span class="vsinst-banner-btn">
                    {{ card_btn | default: 'Explore Setup' }} <i class="fa-solid fa-arrow-right-long"></i>
                  </span>
                  {% if card_stat != blank %}
                    <span class="vsinst-banner-stat">{{ card_stat }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      {% endif %}

    </div>
  </div>

  <!-- INTERACTIVE CONTROLS -->
  <div class="vsinst-slider-controls">
    <button type="button" class="vsinst-ctrl-btn" id="vsinstPrev-{{ section.id }}" aria-label="Slide Left">
      <i class="fa-solid fa-arrow-left"></i>
    </button>
    <div class="vsinst-ctrl-badge">
      <i class="fa-solid fa-arrows-left-right" style="color:#d97706;"></i> Auto-Sliding Right to Left • Hover to Pause
    </div>
    <button type="button" class="vsinst-ctrl-btn" id="vsinstNext-{{ section.id }}" aria-label="Slide Right">
      <i class="fa-solid fa-arrow-right"></i>
    </button>
  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var outer = document.getElementById('vsinstMarqueeOuter-' + sectionId);
    var track = document.getElementById('vsinstMarqueeTrack-' + sectionId);
    var btnPrev = document.getElementById('vsinstPrev-' + sectionId);
    var btnNext = document.getElementById('vsinstNext-' + sectionId);

    if (!outer || !track) return;

    // Arrow click adjustments for quick manual browsing
    if (btnPrev) {
      btnPrev.addEventListener('click', function() {
        track.style.animationPlayState = 'paused';
        outer.scrollBy({ left: -320, behavior: 'smooth' });
        setTimeout(function() {
          track.style.animationPlayState = '';
        }, 2500);
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', function() {
        track.style.animationPlayState = 'paused';
        outer.scrollBy({ left: 320, behavior: 'smooth' });
        setTimeout(function() {
          track.style.animationPlayState = '';
        }, 2500);
      });
    }

    // Touch Drag support
    var isDown = false;
    var startX, scrollLeft;
    outer.addEventListener('mousedown', function(e) {
      isDown = true;
      startX = e.pageX - outer.offsetLeft;
      scrollLeft = outer.scrollLeft;
      track.style.animationPlayState = 'paused';
    });
    window.addEventListener('mouseup', function() {
      if (!isDown) return;
      isDown = false;
      track.style.animationPlayState = '';
    });
    outer.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      var x = e.pageX - outer.offsetLeft;
      var walk = (x - startX) * 1.5;
      outer.scrollLeft = scrollLeft - walk;
    });
  })();
</script>

