          <a href="{{ block.settings.link | default: '#vsinst-calc' }}" class="vsinst-banner-card" aria-hidden="true" tabindex="-1" target="{% if block.settings.link contains 'http' or block.settings.link contains 'wa.me' %}_blank{% else %}_self{% endif %}">
