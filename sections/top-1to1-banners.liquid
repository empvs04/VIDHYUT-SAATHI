{%- comment -%}
  Vidhyut Saathi - 1:1 Square Banners Top Section
{%- endcomment -%}

<style>
  .vs-top-banners-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    background-color: {{ section.settings.bg_color | default: '#FAFAF7' }};
    padding: 0 !important;
    margin: 0 !important;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .vs-top-banners-{{ section.id }} .container {
    max-width: 100% !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    position: relative;
  }

  {% if section.settings.section_heading != blank %}
    .vs-top-banners-{{ section.id }} .section-header {
      text-align: center;
      margin-bottom: 20px;
    }
    .vs-top-banners-{{ section.id }} .section-header h2 {
      font-family: 'Baloo 2', sans-serif;
      font-size: 24px;
      font-weight: 800;
      color: #0F172A;
      margin: 0;
    }
  {% endif %}

  /* DESKTOP FULL-SCREEN DISPLAY SLIDER LAYOUT */
  .vs-top-banners-{{ section.id }} .banners-outer-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    border-radius: 0;
    overflow: hidden;
    background: #000000 !important;
    border: none !important;
    box-shadow: none;
  }

  .vs-top-banners-{{ section.id }} .banners-wrapper {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 0px;
    padding: 0;
    margin: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-radius: 0;
    background: #000000 !important;
    width: 100%;
  }

  .vs-top-banners-{{ section.id }} .banners-wrapper::-webkit-scrollbar {
    display: none;
  }

  .vs-top-banners-{{ section.id }} .banner-item {
    flex: 0 0 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    width: 100% !important;
    height: 570px !important;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    border-radius: 0;
    box-shadow: none !important;
    border: none !important;
    background: #000000 !important;
    padding: 0;
    margin: 0;
    position: relative;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none;
    overflow: hidden;
  }

  .vs-top-banners-{{ section.id }} .banner-img {
    width: 100% !important;
    max-width: 100% !important;
    height: 570px !important;
    object-fit: contain !important; /* 100% COMPLETE INNER IMAGE VISIBLE WITHOUT CROPPING */
    display: block !important;
    border-radius: 0 !important;
    transform: none !important;
    transition: none !important;
  }

  .vs-top-banners-{{ section.id }} .banner-placeholder {
    width: 100%;
    height: 400px;
    background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
    border-radius: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    text-align: center;
    color: #E07810;
  }

  .vs-top-banners-{{ section.id }} .banner-placeholder svg {
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
  }

  .vs-top-banners-{{ section.id }} .banner-placeholder span {
    font-family: 'Baloo 2', sans-serif;
    font-size: 14px;
    font-weight: 800;
  }

  .vs-top-banners-{{ section.id }} .banner-badge {
    display: none !important;
  }

  /* INSIDE BANNER OVERLAY DOTS — VISIBLE ON DESKTOP & MOBILE */
  .vs-top-banners-dots {
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    margin: 0;
    padding: 0;
    gap: 8px;
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
    border: none !important;
    pointer-events: auto;
  }

  .vs-top-banners-dots .dot {
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.75) !important;
    border: 1px solid rgba(0, 0, 0, 0.25) !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4) !important;
    transition: all 0.3s ease !important;
    cursor: pointer;
  }

  .vs-top-banners-dots .dot.active {
    width: 10px !important;
    height: 10px !important;
    border-radius: 50% !important;
    background: #EC5C0A !important;
    border-color: #FFFFFF !important;
    transform: scale(1.3) !important;
    box-shadow: 0 2px 8px rgba(236, 92, 10, 0.6) !important;
  }

  /* DESKTOP NAVIGATION ARROWS */
  .vs-top-banners-{{ section.id }} .vs-banner-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 12;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #0F172A;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    transition: all 0.3s ease;
    opacity: 0.85;
  }

  .vs-top-banners-{{ section.id }} .vs-banner-nav:hover {
    background: #FFFFFF;
    color: #EC5C0A;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 22px rgba(236, 92, 10, 0.35);
    opacity: 1;
  }

  .vs-top-banners-{{ section.id }} .vs-prev-btn { left: 24px; }
  .vs-top-banners-{{ section.id }} .vs-next-btn { right: 24px; }

  /* MOBILE SLIDER LAYOUT — ZERO OUTER BOX & FULL WIDTH EDGE-TO-EDGE */
  @media(max-width: 767px) {
    .vs-top-banners-{{ section.id }} {
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      background: transparent !important;
      box-shadow: none !important;
      border: none !important;
    }

    .vs-top-banners-{{ section.id }} .container {
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
    }

    .vs-top-banners-{{ section.id }} .banners-outer-container {
      border-radius: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      max-width: 100% !important;
    }

    .vs-top-banners-{{ section.id }} .banners-wrapper {
      display: flex !important;
      flex-direction: row !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      scroll-behavior: smooth !important;
      gap: 0px !important;
      padding: 0 !important;
      margin: 0 !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
      border-radius: 0 !important;
      background: transparent !important;
      width: 100% !important;
    }

    .vs-top-banners-{{ section.id }} .banners-wrapper::-webkit-scrollbar {
      display: none !important;
    }

    .vs-top-banners-{{ section.id }} .banner-item {
      flex: 0 0 100% !important;
      max-width: 100% !important;
      min-width: 100% !important;
      width: 100% !important;
      scroll-snap-align: center !important;
      scroll-snap-stop: always !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      border: none !important;
      background: transparent !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .vs-top-banners-{{ section.id }} .banner-img {
      width: 100% !important;
      height: auto !important;
      max-height: none !important;
      aspect-ratio: 1 / 1 !important;
      object-fit: cover !important;
      display: block !important;
      border-radius: 0 !important;
    }

    /* HIDE NAVIGATION ARROWS ON MOBILE */
    .vs-top-banners-{{ section.id }} .vs-banner-nav {
      display: none !important;
    }

    /* MOBILE INSIDE DOTS — ONLY CLEAN FLOATING CIRCULAR DOTS */
    .vs-top-banners-dots {
      display: flex !important;
      align-items: center;
      justify-content: center;
      gap: 8px !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      bottom: 12px !important;
    }
  }
</style>

<div class="vs-top-banners-{{ section.id }}" id="vs-banners-{{ section.id }}">
  <div class="container">
    {% if section.settings.section_heading != blank %}
      <div class="section-header">
        <h2>{{ section.settings.section_heading }}</h2>
      </div>
    {% endif %}

    <div class="banners-outer-container">
      <button class="vs-banner-nav vs-prev-btn" id="vs-banner-prev-{{ section.id }}" aria-label="Previous Banner">
        <i class="fas fa-chevron-left"></i>
      </button>
      
      <div class="banners-wrapper">
        {% for block in section.blocks %}
          <a href="{{ block.settings.banner_link | default: '#' }}" class="banner-item" {{ block.shopify_attributes }}>
            {% if block.settings.banner_image != blank %}
              <img 
                src="{{ block.settings.banner_image | image_url: width: 1200 }}"
                alt="{{ block.settings.banner_image.alt | default: 'Vidhyut Saathi Banner' }}"
                class="banner-img"
                loading="lazy"
                width="1200"
                height="600"
              >
            {% else %}
              <div class="banner-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <span>Upload Banner {{ forloop.index }}</span>
              </div>
            {% endif %}
          </a>
        {% endfor %}
      </div>

      <button class="vs-banner-nav vs-next-btn" id="vs-banner-next-{{ section.id }}" aria-label="Next Banner">
        <i class="fas fa-chevron-right"></i>
      </button>

      <!-- INSIDE BANNER DOTS -->
      <div class="vs-top-banners-dots" id="vs-banners-dots-{{ section.id }}">
        {% for block in section.blocks %}
          <span class="dot {% if forloop.first %}active{% endif %}"></span>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initTopBannerSlider() {
      const section = document.getElementById('vs-banners-{{ section.id }}');
      const wrapper = section ? section.querySelector('.banners-wrapper') : null;
      const dotsContainer = document.getElementById('vs-banners-dots-{{ section.id }}');
      
      if (!wrapper || !dotsContainer) return;

      const items = Array.from(wrapper.querySelectorAll('.banner-item'));
      const dots = Array.from(dotsContainer.querySelectorAll('.dot'));
      if (items.length <= 1) return;

      let currentIndex = 0;
      let autoTimer = null;

      function updateDots(index) {
        dots.forEach((dot, idx) => {
          if (idx === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function scrollToBanner(index) {
        if (!items[index]) return;
        const itemWidth = items[0].offsetWidth;
        wrapper.scrollTo({ left: index * itemWidth, behavior: 'smooth' });
        currentIndex = index;
        updateDots(currentIndex);
      }

      // Realtime Scroll Listener (Instant active dot sync)
      wrapper.addEventListener('scroll', function() {
        const itemWidth = items[0] ? items[0].offsetWidth : wrapper.offsetWidth;
        if (itemWidth > 0) {
          const activeIndex = Math.min(Math.max(Math.round(wrapper.scrollLeft / itemWidth), 0), items.length - 1);
          if (currentIndex !== activeIndex) {
            currentIndex = activeIndex;
            updateDots(currentIndex);
          }
        }
      }, { passive: true });

      const prevBtn = document.getElementById('vs-banner-prev-{{ section.id }}');
      const nextBtn = document.getElementById('vs-banner-next-{{ section.id }}');

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          let prevIndex = (currentIndex - 1 + items.length) % items.length;
          scrollToBanner(prevIndex);
          resetAuto();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          let nextIndex = (currentIndex + 1) % items.length;
          scrollToBanner(nextIndex);
          resetAuto();
        });
      }

      // Dot Click Navigation
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          scrollToBanner(idx);
          resetAuto();
        });
      });

      // 3-Second Viewport Auto Slide
      function startAuto() {
        if (!autoTimer && items.length > 1) {
          autoTimer = setInterval(function() {
            let nextIndex = (currentIndex + 1) % items.length;
            scrollToBanner(nextIndex);
          }, 3000);
        }
      }

      function stopAuto() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      function resetAuto() {
        stopAuto();
        startAuto();
      }

      // IntersectionObserver for 3s Viewport Trigger
      if ('IntersectionObserver' in window) {
        const viewportObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              startAuto();
            } else {
              stopAuto();
            }
          });
        }, { threshold: 0.1 });

        viewportObserver.observe(wrapper);
      } else {
        startAuto();
      }

      wrapper.addEventListener('touchstart', stopAuto, { passive: true });
      wrapper.addEventListener('touchend', startAuto, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTopBannerSlider);
    } else {
      initTopBannerSlider();
    }
  })();
</script>

{% schema %}
{
  "name": "Top Square Banners",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading (Optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAF7"
    },
    {
      "type": "range",
      "id": "banners_per_row_desk",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Desktop Banners Per Row",
      "default": 5
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Desktop Border Radius",
      "default": 18
    },
    {
      "type": "range",
      "id": "border_radius_mob",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile Border Radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_desk",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "banner_1to1",
      "name": "Square Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "1:1 Banner Image (Square)"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Banner Click Link"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Tag (Optional)",
          "default": "OFFER"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Square Banners",
      "blocks": [
        {
          "type": "banner_1to1",
          "settings": {
            "badge_text": "30% OFF"
          }
        },
        {
          "type": "banner_1to1",
          "settings": {
            "badge_text": "BESTSELLER"
          }
        },
        {
          "type": "banner_1to1",
          "settings": {
            "badge_text": "FRANCHISE"
          }
        },
        {
          "type": "banner_1to1",
          "settings": {
            "badge_text": "CERTIFIED"
          }
        },
        {
          "type": "banner_1to1",
          "settings": {
            "badge_text": "LIMITED"
          }
        }
      ]
    }
  ]
}
{% endschema %}
