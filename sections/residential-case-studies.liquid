                  {% assign def_img_1 = "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&q=80" %}
                {% when 4 %}
                  {% assign c_name = "Anil Deshmukh" %}
                  {% assign c_loc = "3 BHK House, Pune" %}
