{% render 'vs-residential-styles' %}

<div class="vsres">
  <!-- ══ REAL CUSTOMER SCENARIOS / CASE STUDIES SLIDER ══ -->
  <section class="vsres-sec" style="background:#fbf8f0; border-top:1px solid var(--line);">
    <div class="wrap">
      <div class="vsres-sec-head">
        <div class="vsres-sec-eyebrow"><i class="fa-solid fa-circle-check"></i> {{ section.settings.eyebrow | default: 'Customer Case Studies' }}</div>
        <h2 class="vsres-sec-title">{{ section.settings.title_prefix | default: 'Real Residential' }} <span>{{ section.settings.title_highlight | default: 'Savings Stories' }}</span></h2>
        <p class="vsres-sec-desc">{{ section.settings.desc | default: 'See how Indian households cut their monthly electricity bills by 20%–30% with Vidhyut Saathi.' }}</p>
      </div>

      <!-- MOBILE CAROUSEL SLIDER WRAPPER -->
      <div class="vs-cases-slider-wrap" id="vsresCaseSliderWrap">
        <div class="vsres-case-grid" id="vsresCaseTrack">
          {% assign case_study_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'residential_case_study' %}
              {% assign case_study_count = case_study_count | plus: 1 %}
              {% assign idx = case_study_count %}
              
              {% case idx %}
                {% when 1 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=700&q=80" %}
