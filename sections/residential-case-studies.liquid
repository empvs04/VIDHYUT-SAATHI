<script>
  /* ══ 4-IMAGE MINI SLIDER CONTROLS ══ */
  window.advanceCardMedia = function(cardOrSlider) {
    var slider = cardOrSlider.classList && cardOrSlider.classList.contains('vs-card-media-slider') ? cardOrSlider : cardOrSlider.querySelector('.vs-card-media-slider');
    if (!slider) return;
    var slides = slider.querySelectorAll('.vs-card-media-slide');
    var dots = slider.querySelectorAll('.vs-media-dot');
    var curSpan = slider.querySelector('.vs-media-cur');
    if (!slides.length) return;
    var activeIdx = 0;
    slides.forEach(function(s, idx) {
      if (s.classList.contains('active')) activeIdx = idx;
    });
    var nextIdx = (activeIdx + 1) % slides.length;
    slides[activeIdx].classList.remove('active');
    slides[nextIdx].classList.add('active');
    if (dots.length > nextIdx) {
      dots[activeIdx].classList.remove('active');
      dots[nextIdx].classList.add('active');
    }
    if (curSpan) curSpan.innerText = nextIdx + 1;
  };

  window.vsSlideMedia = function(btn, dir) {
    var slider = btn.closest('.vs-card-media-slider');
    if (!slider) return;
    var slides = slider.querySelectorAll('.vs-card-media-slide');
    var dots = slider.querySelectorAll('.vs-media-dot');
    var curSpan = slider.querySelector('.vs-media-cur');
    if (!slides.length) return;
    var activeIdx = 0;
    slides.forEach(function(s, idx) {
      if (s.classList.contains('active')) activeIdx = idx;
    });
    var nextIdx = (activeIdx + dir + slides.length) % slides.length;
    slides[activeIdx].classList.remove('active');
    slides[nextIdx].classList.add('active');
    if (dots.length > nextIdx) {
      dots[activeIdx].classList.remove('active');
      dots[nextIdx].classList.add('active');
    }
    if (curSpan) curSpan.innerText = nextIdx + 1;
  };

  window.vsGoMediaSlide = function(dot, idx) {
    var slider = dot.closest('.vs-card-media-slider');
    if (!slider) return;
    var slides = slider.querySelectorAll('.vs-card-media-slide');
    var dots = slider.querySelectorAll('.vs-media-dot');
    var curSpan = slider.querySelector('.vs-media-cur');
    if (!slides.length || idx >= slides.length) return;
    slides.forEach(function(s) { s.classList.remove('active'); });
    dots.forEach(function(d) { d.classList.remove('active'); });
    slides[idx].classList.add('active');
    if (dots[idx]) dots[idx].classList.add('active');
    if (curSpan) curSpan.innerText = idx + 1;
  };

  /* ══ DESKTOP HOVER AUTO-SLIDE INTERNAL IMAGES ══ */
  (function() {
    var cards = document.querySelectorAll('#vsresCaseTrack .vsres-case-card');
    cards.forEach(function(card) {
      var hoverTimer = null;

      card.addEventListener('mouseenter', function() {
        if (window.innerWidth < 768) return;
        if (hoverTimer) clearInterval(hoverTimer);
        hoverTimer = setInterval(function() {
          if (window.innerWidth >= 768) {
            window.advanceCardMedia(card);
          } else {
            clearInterval(hoverTimer);
            hoverTimer = null;
          }
        }, 1800);
      });

      card.addEventListener('mouseleave', function() {
        if (hoverTimer) {
          clearInterval(hoverTimer);
          hoverTimer = null;
        }
      });
    });
  })();

  /* ══ MOBILE SLIDER ══ */
  (function() {
    var track = document.getElementById('vsresCaseTrack');
    var wrap = document.getElementById('vsresCaseSliderWrap');
    var dots = document.querySelectorAll('#vsresCaseDots .vs-slider-dot');
    if (!track || !wrap) return;

    var currentIdx = 0;
    var totalSlides = dots.length || 3;
    var timer = null;
    var isSectionInView = false;
    var isMobile = function() { return window.innerWidth < 768; };

    window.vsresGoSlide = function(idx) {
      if (!isMobile()) return;
      currentIdx = (idx + totalSlides) % totalSlides;
      track.style.transform = 'translateX(-' + (currentIdx * 100) + '%)';
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === currentIdx);
      });

      var cards = track.querySelectorAll('.vsres-case-card');
      if (cards[currentIdx]) {
        var ms = cards[currentIdx].querySelector('.vs-card-media-slider');
        if (ms) {
          var s = ms.querySelectorAll('.vs-card-media-slide');
          var d = ms.querySelectorAll('.vs-media-dot');
          var c = ms.querySelector('.vs-media-cur');
          s.forEach(function(el, i) { el.classList.toggle('active', i === 0); });
          d.forEach(function(el, i) { el.classList.toggle('active', i === 0); });
          if (c) c.innerText = 1;
        }
      }
    };

    function stepMediaOrCard() {
      if (!isMobile() || !isSectionInView) return;
      var cards = track.querySelectorAll('.vsres-case-card');
      if (!cards.length) return;
      var currentCard = cards[currentIdx];
      if (!currentCard) return;

      var mediaSlider = currentCard.querySelector('.vs-card-media-slider');
      if (!mediaSlider) {
        window.vsresGoSlide(currentIdx + 1);
        return;
      }

      var slides = mediaSlider.querySelectorAll('.vs-card-media-slide');
      var cardDots = mediaSlider.querySelectorAll('.vs-media-dot');
      var curSpan = mediaSlider.querySelector('.vs-media-cur');
      var totalMediaSlides = slides.length;

      if (totalMediaSlides <= 1) {
        window.vsresGoSlide(currentIdx + 1);
        return;
      }

      var activePhotoIdx = 0;
      slides.forEach(function(s, idx) {
        if (s.classList.contains('active')) activePhotoIdx = idx;
      });

      if (activePhotoIdx < totalMediaSlides - 1) {
        var nextPhotoIdx = activePhotoIdx + 1;
        slides[activePhotoIdx].classList.remove('active');
        slides[nextPhotoIdx].classList.add('active');
        if (cardDots[activePhotoIdx]) cardDots[activePhotoIdx].classList.remove('active');
        if (cardDots[nextPhotoIdx]) cardDots[nextPhotoIdx].classList.add('active');
        if (curSpan) curSpan.innerText = nextPhotoIdx + 1;
      } else {
        window.vsresGoSlide(currentIdx + 1);
      }
    }

    function startAutoSlide() {
      stopAutoSlide();
      if (!isMobile() || !isSectionInView) return;
      timer = setInterval(function() {
        if (isMobile() && isSectionInView) {
          stepMediaOrCard();
        } else {
          stopAutoSlide();
        }
      }, 2000);
    }

    function stopAutoSlide() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    var targetSection = wrap.closest('.vsres-sec') || wrap;
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            isSectionInView = true;
            startAutoSlide();
          } else {
            isSectionInView = false;
            stopAutoSlide();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(targetSection);
    }

    var startX = 0;
    var deltaX = 0;
    wrap.addEventListener('touchstart', function(e) {
      if (!isMobile()) return;
      stopAutoSlide();
      startX = e.touches[0].clientX;
      deltaX = 0;
    }, { passive: true });

    wrap.addEventListener('touchmove', function(e) {
      if (!isMobile()) return;
      deltaX = e.touches[0].clientX - startX;
    }, { passive: true });

    wrap.addEventListener('touchend', function() {
      if (!isMobile()) return;
      if (deltaX < -40) {
        window.vsresGoSlide(currentIdx + 1);
      } else if (deltaX > 40) {
        window.vsresGoSlide(currentIdx - 1);
      }
      if (isSectionInView) {
        startAutoSlide();
      }
    }, { passive: true });

    window.addEventListener('resize', function() {
      if (!isMobile()) {
        track.style.transform = '';
        stopAutoSlide();
      } else if (!timer && isSectionInView) {
        startAutoSlide();
      }
    });
  })();

  /* ══ VERIFIED BILLS COMPARISON LIGHTBOX MODAL ══ */
  function vsOpenBillsModal(btn) {
    if (!btn) return;
    var customer = btn.getAttribute('data-customer') || 'Verified Customer';
    var location = btn.getAttribute('data-location') || 'Residential House';
    var oldBill = btn.getAttribute('data-old-bill') || '₹8,400/mo';
    var newBill = btn.getAttribute('data-new-bill') || '₹6,100/mo';
    var savings = btn.getAttribute('data-savings') || 'Saved ₹2,300/mo (27%)';
    var cards = btn.getAttribute('data-cards') || '⚡ 2 Residential Cards';
    var oldImg = btn.getAttribute('data-old-img') || '';
    var newImg = btn.getAttribute('data-new-img') || '';

    var modal = document.getElementById('vsres_bills_modal');
    if (!modal) return;

    var custEl = document.getElementById('vsres_bills_modal_customer');
    var locEl = document.getElementById('vsres_bills_modal_loc');
    var saveBadge = document.getElementById('vsres_bills_modal_savings_badge');
    var oldValEl = document.getElementById('vsres_modal_old_val');
    var newValEl = document.getElementById('vsres_modal_new_val');
    var oldDocBox = document.getElementById('vsres_modal_old_doc');
    var newDocBox = document.getElementById('vsres_modal_new_doc');

    if (custEl) custEl.textContent = customer;
    if (locEl) locEl.innerHTML = '<i class="fa-solid fa-location-dot" style="color:#ec5c0a;"></i> ' + location + ' &bull; ' + cards;
    if (saveBadge) saveBadge.textContent = '⚡ ' + savings;
    if (oldValEl) oldValEl.textContent = oldBill;
    if (newValEl) newValEl.textContent = newBill;

    if (oldDocBox) {
      if (oldImg && oldImg.trim() !== '') {
        oldDocBox.innerHTML = '<a href="' + oldImg + '" target="_blank" title="Click to view full size"><img src="' + oldImg + '" alt="Old DISCOM Bill" class="vsres-bill-uploaded-img"></a>';
      } else {
        oldDocBox.innerHTML = vsGenerateBillSvg(customer, location, oldBill, 'OLD', cards);
      }
    }

    if (newDocBox) {
      if (newImg && newImg.trim() !== '') {
        newDocBox.innerHTML = '<a href="' + newImg + '" target="_blank" title="Click to view full size"><img src="' + newImg + '" alt="New DISCOM Bill" class="vsres-bill-uploaded-img"></a>';
      } else {
        newDocBox.innerHTML = vsGenerateBillSvg(customer, location, newBill, 'NEW', cards);
      }
    }

    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function vsCloseBillsModal(e) {
    if (e && e.stopPropagation) e.stopPropagation();
    var modal = document.getElementById('vsres_bills_modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      vsCloseBillsModal();
    }
  });

  function vsGenerateBillSvg(name, loc, amount, type, cards) {
    var isNew = type === 'NEW';
    var bgHeader = isNew ? '#007b3e' : '#e11d48';
    var accentBorder = isNew ? '#10b981' : '#f43f5e';
    var statusTitle = isNew ? 'REDUCED DISCOM TARIFF' : 'STANDARD REGULAR TARIFF';
    var stampText = isNew ? 'PAID & SAVED (20-30%)' : 'HIGH CONSUMPTION';
    var stampColor = isNew ? '#007b3e' : '#e11d48';
    var billDate = isNew ? 'Post-Installation Bill' : 'Pre-Installation Bill';
    var caNum = 'CA-' + Math.floor(10000000 + Math.random() * 90000000);
    
    return '<div style="width:100%; max-width:400px; background:#ffffff; border:2px solid ' + accentBorder + '; border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,0.06); font-family:\'Nunito\',sans-serif; overflow:hidden; position:relative;">' +
      '<div style="background:' + bgHeader + '; color:#ffffff; padding:12px 16px; display:flex; justify-content:space-between; align-items:center;">' +
        '<div>' +
          '<div style="font-size:10px; font-weight:800; letter-spacing:0.8px; opacity:0.9;">ELECTRICITY DISTRIBUTION CO.</div>' +
          '<div style="font-size:13px; font-weight:800; font-family:\'Space Grotesk\',sans-serif;">' + statusTitle + '</div>' +
        '</div>' +
        '<div style="font-size:18px;">' + (isNew ? '⚡' : '🏛️') + '</div>' +
      '</div>' +
      '<div style="padding:14px 16px; font-size:11.5px; color:#334155; line-height:1.5;">' +
        '<div style="display:flex; justify-content:space-between; margin-bottom:8px; border-bottom:1px dashed #e2e8f0; padding-bottom:6px;">' +
          '<div><strong>Consumer:</strong> ' + name + '<br><span style="color:#64748b; font-size:10.5px;">' + loc + '</span></div>' +
          '<div style="text-align:right;"><strong>' + caNum + '</strong><br><span style="color:#64748b; font-size:10.5px;">Tariff: LT-Domestic</span></div>' +
        '</div>' +
        '<div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; background:#f8fafc; padding:8px 10px; border-radius:8px; margin-bottom:10px; font-size:11px;">' +
          '<div>Billing Cycle: <strong>Monthly</strong></div>' +
          '<div>Status: <strong style="color:' + (isNew ? '#007b3e' : '#e11d48') + ';">' + billDate + '</strong></div>' +
          '<div>Grid Setup: <strong>' + cards + '</strong></div>' +
          '<div>Power Factor: <strong>' + (isNew ? '0.98 (Optimized)' : '0.81 (Losses)') + '</strong></div>' +
        '</div>' +
        '<div style="border-top:1.5px solid #cbd5e1; padding-top:8px; display:flex; justify-content:space-between; align-items:center;">' +
          '<div>' +
            '<span style="font-size:10px; font-weight:800; color:#64748b; text-transform:uppercase;">TOTAL AMOUNT DUE</span>' +
            '<div style="font-size:19px; font-weight:800; font-family:\'IBM Plex Mono\',monospace; color:' + (isNew ? '#007b3e' : '#e11d48') + ';">' + amount + '</div>' +
          '</div>' +
          '<div style="border:2px solid ' + stampColor + '; color:' + stampColor + '; font-size:9px; font-weight:900; padding:4px 8px; border-radius:6px; text-transform:uppercase; transform:rotate(-4deg); font-family:\'Space Grotesk\',sans-serif; letter-spacing:0.5px;">' +
            stampText +
          '</div>' +
        '</div>' +
      '</div>' +
    '</div>';
  }
</script>

