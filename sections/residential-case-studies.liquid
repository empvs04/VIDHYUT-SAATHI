                  {% assign def_img_4 = "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=150&q=80" %}
                {% when 3 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&q=80" %}
                {% when 4 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1509391365360-2e959784a276?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1556912172-45b7abe8b7e1?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=150&q=80" %}
                {% when 5 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=150&q=80" %}
                {% when 6 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1582735689369-4fe89db7114c?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=150&q=80" %}
                {% when 7 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1585338107529-13afc5f02586?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1504917599217-d4dc5ebe6122?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=150&q=80" %}
                {% when 8 %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=150&q=80" %}
                {% else %}
                  {% assign def_img_1 = "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_2 = "https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_3 = "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_img_4 = "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=700&q=80" %}
                  {% assign def_avatar = "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=150&q=80" %}
              {% endcase %}

              <div class="vsres-case-card" {{ block.shopify_attributes }} style="background:#ffffff; border:2px solid #e7dcce; border-radius:20px; padding:16px; box-shadow:0 8px 24px rgba(15,23,42,0.05); transition:all 0.35s ease; display:flex; flex-direction:column; position:relative; overflow:hidden;">
                <!-- MINI SLIDER -->
                <div class="vs-card-media-slider">
                  <div class="vs-card-media-slides">
                    <div class="vs-card-media-slide active">
                      {% if block.settings.image_1 != blank %}
                        <img src="{{ block.settings.image_1 | image_url: width: 800 }}" alt="{{ block.settings.tag_1 | default: 'Living Room AC' | escape }}" loading="lazy">
                      {% else %}
                        <img src="{{ def_img_1 }}" alt="{{ block.settings.tag_1 | default: 'Living Room AC' | escape }}" loading="lazy">
                      {% endif %}
                      {% if block.settings.tag_1 != blank %}
                        <span class="vs-media-tag"><i class="fa-solid fa-snowflake"></i> {{ block.settings.tag_1 }}</span>
                      {% endif %}
                    </div>
                    <div class="vs-card-media-slide">
                      {% if block.settings.image_2 != blank %}
                        <img src="{{ block.settings.image_2 | image_url: width: 800 }}" alt="{{ block.settings.tag_2 | default: 'Refrigerator' | escape }}" loading="lazy">
                      {% else %}
                        <img src="{{ def_img_2 }}" alt="{{ block.settings.tag_2 | default: 'Refrigerator' | escape }}" loading="lazy">
                      {% endif %}
                      {% if block.settings.tag_2 != blank %}
                        <span class="vs-media-tag"><i class="fa-solid fa-cube"></i> {{ block.settings.tag_2 }}</span>
                      {% endif %}
                    </div>
                    <div class="vs-card-media-slide">
                      {% if block.settings.image_3 != blank %}
                        <img src="{{ block.settings.image_3 | image_url: width: 800 }}" alt="{{ block.settings.tag_3 | default: 'Kitchen Grid' | escape }}" loading="lazy">
                      {% else %}
                        <img src="{{ def_img_3 }}" alt="{{ block.settings.tag_3 | default: 'Kitchen Grid' | escape }}" loading="lazy">
                      {% endif %}
                      {% if block.settings.tag_3 != blank %}
                        <span class="vs-media-tag"><i class="fa-solid fa-tv"></i> {{ block.settings.tag_3 }}</span>
                      {% endif %}
                    </div>
                    <div class="vs-card-media-slide">
                      {% if block.settings.image_4 != blank %}
                        <img src="{{ block.settings.image_4 | image_url: width: 800 }}" alt="{{ block.settings.tag_4 | default: 'Main MCB Board' | escape }}" loading="lazy">
                      {% else %}
                        <img src="{{ def_img_4 }}" alt="{{ block.settings.tag_4 | default: 'Main MCB Board' | escape }}" loading="lazy">
                      {% endif %}
                      {% if block.settings.tag_4 != blank %}
                        <span class="vs-media-tag"><i class="fa-solid fa-bolt"></i> {{ block.settings.tag_4 }}</span>
                      {% endif %}
                    </div>
                  </div>
                  <button type="button" class="vs-media-arrow vs-media-prev" onclick="vsSlideMedia(this, -1)" aria-label="Previous image"><i class="fa-solid fa-chevron-left"></i></button>
                  <button type="button" class="vs-media-arrow vs-media-next" onclick="vsSlideMedia(this, 1)" aria-label="Next image"><i class="fa-solid fa-chevron-right"></i></button>
                  <div class="vs-media-dots-bar">
                    <span class="vs-media-dot active" onclick="vsGoMediaSlide(this, 0)"></span>
                    <span class="vs-media-dot" onclick="vsGoMediaSlide(this, 1)"></span>
                    <span class="vs-media-dot" onclick="vsGoMediaSlide(this, 2)"></span>
                    <span class="vs-media-dot" onclick="vsGoMediaSlide(this, 3)"></span>
                  </div>
                  <div class="vs-media-counter"><span class="vs-media-cur">1</span>/<span class="vs-media-tot">4</span></div>
                </div>

                <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">
                  <div style="width:46px; height:46px; border-radius:50%; overflow:hidden; flex-shrink:0; border:2px solid #ec5c0a; box-shadow:0 4px 10px rgba(236,92,10,0.25);">
                    {% if block.settings.avatar_image != blank %}
                      <img src="{{ block.settings.avatar_image | image_url: width: 150 }}" alt="Customer Avatar" style="width:100%; height:100%; object-fit:cover; display:block;">
                    {% else %}
                      <img src="{{ def_avatar }}" alt="Customer Avatar" style="width:100%; height:100%; object-fit:cover; display:block;" onerror="this.onerror=null; this.src='{{ 'wvs-happy-man.jpg' | asset_url }}';">
                    {% endif %}
                  </div>
                  <div>
                    <h4 style="font-size:15px; font-weight:800; color:#0f172a; margin:0 0 2px 0; font-family:'Space Grotesk',sans-serif;">{{ block.settings.customer_name | default: 'Rohan Mehta' }} <i class="fa-solid fa-circle-check" style="color:#007b3e; font-size:13px;"></i></h4>
                    <div style="font-size:12px; color:#64748b; font-weight:600;"><i class="fa-solid fa-location-dot" style="color:#ec5c0a;"></i> {{ block.settings.location_load | default: '2 BHK Apartment, Mumbai' }}</div>
                  </div>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:12px;">
                  <div style="background:#fff1f2; border:1px solid #fecdd3; padding:9px 11px; border-radius:10px; display:flex; flex-direction:column; gap:2px;">
                    <span style="color:#e11d48; font-size:10px; font-weight:700; text-transform:uppercase; font-family:'IBM Plex Mono',monospace;">Old DISCOM Bill</span>
                    <span style="font-family:'IBM Plex Mono',monospace; color:#9f1239; font-size:14px; font-weight:800; text-decoration:line-through;">{{ block.settings.old_bill | default: '₹8,400/mo' }}</span>
                  </div>
                  <div style="background:#ecfdf5; border:1px solid #a7f3d0; padding:9px 11px; border-radius:10px; display:flex; flex-direction:column; gap:2px;">
                    <span style="color:#059669; font-size:10px; font-weight:700; text-transform:uppercase; font-family:'IBM Plex Mono',monospace;">New DISCOM Bill</span>
                    <span style="font-family:'IBM Plex Mono',monospace; color:#065f46; font-size:14px; font-weight:800;">{{ block.settings.new_bill | default: '₹6,100/mo' }}</span>
                  </div>
                </div>
                <!-- SHOW BILLS BUTTON (HIGHLIGHTED) -->
                <button type="button" class="vsres-btn-view-bills" 
                  data-customer="{{ block.settings.customer_name | default: 'Rohan Mehta' | escape }}" 
                  data-location="{{ block.settings.location_load | default: '2 BHK Apartment, Mumbai' | escape }}" 
                  data-old-bill="{{ block.settings.old_bill | default: '₹8,400/mo' | escape }}" 
                  data-new-bill="{{ block.settings.new_bill | default: '₹6,100/mo' | escape }}" 
                  data-savings="{{ block.settings.savings_summary | default: 'Saved ₹2,300/mo (27%)' | escape }}" 
                  data-cards="{{ block.settings.cards_count | default: '⚡ 2 Residential Cards' | escape }}" 
                  data-old-img="{% if block.settings.old_bill_image != blank %}{{ block.settings.old_bill_image | image_url: width: 1200 }}{% elsif section.settings.global_old_bill_image != blank %}{{ section.settings.global_old_bill_image | image_url: width: 1200 }}{% endif %}" 
                  data-new-img="{% if block.settings.new_bill_image != blank %}{{ block.settings.new_bill_image | image_url: width: 1200 }}{% elsif section.settings.global_new_bill_image != blank %}{{ section.settings.global_new_bill_image | image_url: width: 1200 }}{% endif %}"
                  onclick="vsOpenBillsModal(this)">
                  <i class="fa-solid fa-file-invoice-dollar"></i> Show Bills
                  <span class="vsres-btn-pulse-dot"></span>
                </button>
                <div style="background:linear-gradient(135deg, #0a4a2c 0%, #ec5c0a 100%); padding:9px 12px; border-radius:12px; color:#ffffff; display:flex; justify-content:space-between; align-items:center; gap:8px; white-space:nowrap; overflow:hidden; box-shadow:0 4px 14px rgba(236,92,10,0.2);">
                  <span style="color:#a7f3d0; font-size:11px; font-weight:700; white-space:nowrap; flex-shrink:0;">{{ block.settings.cards_count | default: '⚡ 2 Residential Cards' }}</span>
                  <strong style="color:#ffffff; font-size:12px; font-weight:800; white-space:nowrap; flex-shrink:0;">{{ block.settings.savings_summary | default: 'Saved ₹2,300/mo (27%)' }}</strong>
                </div>
              </div>
            {% endif %}
          {% endfor %}
          {% if case_study_count < 9 %}
            <!-- REMAINING DEFAULT CARDS (SO ALL 9 CARDS ALWAYS STAY VISIBLE) -->
            {% assign start_fallback = case_study_count | plus: 1 %}
