{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap');

  /* ===========================================================================
     SECTION 15: VIDHYUT OUR JOURNEY CAROUSEL (DESKTOP ONLY)
     AUTO-SCROLLING + MOUSE WHEEL SCROLL + MOUSE DRAG SUPPORT
     =========================================================================== */
  .vs-journey-section {
    display: block !important;
    padding: 65px 0 75px 0 !important;
    background: #FFFFFF !important;
    position: relative !important;
    overflow: hidden !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
  }

  /* Hide on Mobile */
  @media screen and (max-width: 768px) {
    .vs-journey-section {
      display: none !important;
    }
  }

  .vs-journey-container {
    max-width: 1440px !important;
    margin: 0 auto !important;
    padding: 0 20px !important;
    text-align: center !important;
  }

  .vs-journey-header {
    margin-bottom: 35px !important;
  }

  .vs-journey-script-subtitle {
    font-family: 'Caveat', cursive !important;
    font-size: 2.1rem !important;
    color: #EC5C0A !important;
    margin: 0 0 6px 0 !important;
    line-height: 1.1 !important;
    letter-spacing: 0.5px !important;
    font-weight: 700 !important;
  }

  .vs-journey-main-heading {
    font-size: clamp(1.65rem, 2.4vw, 2.15rem) !important;
    font-weight: 800 !important;
    color: #1E293B !important;
    line-height: 1.25 !important;
    margin: 0 !important;
    letter-spacing: -0.4px !important;
  }

  /* CAROUSEL SCROLLABLE TRACK WRAPPER */
  .vs-journey-carousel-wrapper {
    position: relative !important;
    width: 100% !important;
    overflow-x: scroll !important;
    overflow-y: hidden !important;
    padding: 15px 0 !important;
    cursor: grab !important;
    user-select: none !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
    mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%) !important;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%) !important;
  }

  .vs-journey-carousel-wrapper::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .vs-journey-carousel-wrapper.vs-grabbing {
    cursor: grabbing !important;
  }

  .vs-journey-carousel-track {
    display: flex !important;
    gap: 18px !important;
    width: max-content !important;
    will-change: scroll-position !important;
  }

  /* INDIVIDUAL IMAGE ITEM */
  .vs-journey-card-item {
    flex: 0 0 180px !important;
    width: 180px !important;
    aspect-ratio: 4 / 3 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    border: 3px solid #EC5C0A !important;
    box-shadow: 0 8px 24px rgba(236, 92, 10, 0.16) !important;
    position: relative !important;
    background: #F8FAFC !important;
    transition: transform 0.35s ease, box-shadow 0.35s ease !important;
    cursor: pointer !important;
    display: block !important;
    text-decoration: none !important;
  }

  .vs-journey-card-item:hover {
    transform: translateY(-6px) scale(1.04) !important;
    box-shadow: 0 16px 36px rgba(236, 92, 10, 0.3) !important;
  }

  .vs-journey-card-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    pointer-events: none !important;
    transition: transform 0.5s ease !important;
  }

  .vs-journey-card-item:hover .vs-journey-card-img {
    transform: scale(1.08) !important;
  }
{%- endstyle -%}

<!-- SECTION 15: VIDHYUT OUR JOURNEY CAROUSEL -->
<section class="vs-journey-section" id="vsJourneySection">
  <div class="vs-journey-container">

    <!-- HEADER -->
    <div class="vs-journey-header">
      <div class="vs-journey-script-subtitle">{{ section.settings.script_subtitle | default: "Our Journey" }}</div>
      <h2 class="vs-journey-main-heading">
        {{ section.settings.heading | default: "“The Journey of a 1,000 miles begins with one step”" }}
      </h2>
    </div>

    <!-- CAROUSEL (SEAMLESS INFINITE AUTO-GLIDE + MOUSE WHEEL SCROLL + DRAG) -->
    <div class="vs-journey-carousel-wrapper" id="vsJourneyWrapper">
      <div class="vs-journey-carousel-track" id="vsJourneyTrack">
        
        {%- if section.blocks.size > 0 -%}
          <!-- SET 1 -->
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="vs-journey-card-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt_text | default: 'Vidhyut Saathi Journey Milestone' }}" class="vs-journey-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'Vidhyut_Saathi_Logo.jpg_1.jpg' | asset_url }}" alt="Vidhyut Saathi Journey" class="vs-journey-card-img" loading="lazy">
              {%- endif -%}
            </a>
          {%- endfor -%}
          
          <!-- SET 2 (DUPLICATE FOR SEAMLESS CONTINUOUS SCROLL) -->
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="vs-journey-card-item" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt_text | default: 'Vidhyut Saathi Journey Milestone' }}" class="vs-journey-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'Vidhyut_Saathi_Logo.jpg_1.jpg' | asset_url }}" alt="Vidhyut Saathi Journey" class="vs-journey-card-img" loading="lazy">
              {%- endif -%}
            </a>
          {%- endfor -%}

          <!-- SET 3 (BUFFER FOR WIDE MONITORS) -->
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="vs-journey-card-item" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt_text | default: 'Vidhyut Saathi Journey Milestone' }}" class="vs-journey-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'Vidhyut_Saathi_Logo.jpg_1.jpg' | asset_url }}" alt="Vidhyut Saathi Journey" class="vs-journey-card-img" loading="lazy">
              {%- endif -%}
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback items -->
          {%- for i in (1..12) -%}
            <div class="vs-journey-card-item">
              <img src="{{ 'electronics-minimal-1.jpg' | asset_url }}" alt="Our Journey Milestone" class="vs-journey-card-img" loading="lazy">
            </div>
          {%- endfor -%}
          {%- for i in (1..12) -%}
            <div class="vs-journey-card-item" aria-hidden="true">
              <img src="{{ 'electronics-minimal-1.jpg' | asset_url }}" alt="Our Journey Milestone" class="vs-journey-card-img" loading="lazy">
            </div>
          {%- endfor -%}
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    function initJourneyScroller() {
      const wrapper = document.getElementById('vsJourneyWrapper');
      if (!wrapper) return;

      let isAutoScrolling = true;
      let autoSpeed = 0.9; // Smooth continuous glide speed
      let resumeTimer = null;
      let isDragging = false;
      let startX = 0;
      let scrollStart = 0;

      // Continuous Smooth Glide
      function glideLoop() {
        if (isAutoScrolling && !isDragging) {
          wrapper.scrollLeft += autoSpeed;
          
          // Seamless loop back when scrolled half of total track
          const halfWidth = wrapper.scrollWidth / 3;
          if (wrapper.scrollLeft >= halfWidth * 2) {
            wrapper.scrollLeft -= halfWidth;
          }
        }
        requestAnimationFrame(glideLoop);
      }
      requestAnimationFrame(glideLoop);

      // MOUSE WHEEL SCROLL EVENT (Scrolls Horizontally on Wheel Up/Down)
      wrapper.addEventListener('wheel', function(e) {
        if (Math.abs(e.deltaY) > 0 || Math.abs(e.deltaX) > 0) {
          e.preventDefault();
          isAutoScrolling = false;
          
          const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          wrapper.scrollLeft += delta * 1.2;

          // Infinite bounds checking
          const halfWidth = wrapper.scrollWidth / 3;
          if (wrapper.scrollLeft >= halfWidth * 2) {
            wrapper.scrollLeft -= halfWidth;
          } else if (wrapper.scrollLeft <= 0) {
            wrapper.scrollLeft += halfWidth;
          }

          clearTimeout(resumeTimer);
          resumeTimer = setTimeout(() => {
            isAutoScrolling = true;
          }, 1500);
        }
      }, { passive: false });

      // MOUSE DRAG / GRAB TO SCROLL
      wrapper.addEventListener('mousedown', function(e) {
        isDragging = true;
        isAutoScrolling = false;
        wrapper.classList.add('vs-grabbing');
        startX = e.pageX - wrapper.offsetLeft;
        scrollStart = wrapper.scrollLeft;
      });

      window.addEventListener('mouseup', function() {
        if (isDragging) {
          isDragging = false;
          wrapper.classList.remove('vs-grabbing');
          clearTimeout(resumeTimer);
          resumeTimer = setTimeout(() => {
            isAutoScrolling = true;
          }, 1200);
        }
      });

      wrapper.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - wrapper.offsetLeft;
        const walk = (x - startX) * 1.5;
        wrapper.scrollLeft = scrollStart - walk;

        // Infinite bounds checking
        const halfWidth = wrapper.scrollWidth / 3;
        if (wrapper.scrollLeft >= halfWidth * 2) {
          wrapper.scrollLeft -= halfWidth;
          startX = e.pageX - wrapper.offsetLeft;
          scrollStart = wrapper.scrollLeft;
        } else if (wrapper.scrollLeft <= 0) {
          wrapper.scrollLeft += halfWidth;
          startX = e.pageX - wrapper.offsetLeft;
          scrollStart = wrapper.scrollLeft;
        }
      });

      // Pause when cursor hovers
      wrapper.addEventListener('mouseenter', function() {
        if (!isDragging) {
          isAutoScrolling = false;
        }
      });

      wrapper.addEventListener('mouseleave', function() {
        if (!isDragging) {
          clearTimeout(resumeTimer);
          resumeTimer = setTimeout(() => {
            isAutoScrolling = true;
          }, 800);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initJourneyScroller);
    } else {
      initJourneyScroller();
    }
  })();
</script>

{% schema %}
{
  "name": "Journey Carousel 15",
  "settings": [
    {
      "type": "text",
      "id": "script_subtitle",
      "label": "Script Subtitle",
      "default": "Our Journey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "“The Journey of a 1,000 miles begins with one step”"
    }
  ],
  "blocks": [
    {
      "type": "journey_image",
      "name": "Journey Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Journey Photo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text",
          "default": "Vidhyut Saathi Journey Milestone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link (Optional)"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Journey Carousel 15",
      "blocks": [
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" }
      ]
    }
  ]
}
{% endschema %}
