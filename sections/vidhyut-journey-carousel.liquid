{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap');

  /* ===========================================================================
     SECTION 15: VIDHYUT OUR JOURNEY CAROUSEL (DESKTOP ONLY)
     BUTTER-SMOOTH INFINITE GLIDE / AUTO-SCROLL
     =========================================================================== */
  .vs-journey-section {
    display: block !important;
    padding: 65px 0 75px 0 !important;
    background: #FFFFFF !important;
    position: relative !important;
    overflow: hidden !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
  }

  /* Hide on Mobile */
  @media screen and (max-width: 768px) {
    .vs-journey-section {
      display: none !important;
    }
  }

  .vs-journey-container {
    max-width: 1440px !important;
    margin: 0 auto !important;
    padding: 0 20px !important;
    text-align: center !important;
  }

  .vs-journey-header {
    margin-bottom: 35px !important;
  }

  .vs-journey-script-subtitle {
    font-family: 'Caveat', cursive !important;
    font-size: 2.1rem !important;
    color: #EC5C0A !important;
    margin: 0 0 6px 0 !important;
    line-height: 1.1 !important;
    letter-spacing: 0.5px !important;
    font-weight: 700 !important;
  }

  .vs-journey-main-heading {
    font-size: clamp(1.65rem, 2.4vw, 2.15rem) !important;
    font-weight: 800 !important;
    color: #1E293B !important;
    line-height: 1.25 !important;
    margin: 0 !important;
    letter-spacing: -0.4px !important;
  }

  /* CAROUSEL TRACK WRAPPER */
  .vs-journey-carousel-wrapper {
    position: relative !important;
    width: 100% !important;
    overflow: hidden !important;
    padding: 15px 0 !important;
    mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%) !important;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%) !important;
  }

  .vs-journey-carousel-track {
    display: flex !important;
    gap: 18px !important;
    width: max-content !important;
    animation: vsJourneySlideLeft {{ section.settings.slide_duration | default: 22 }}s linear infinite !important;
    will-change: transform !important;
  }

  .vs-journey-carousel-wrapper:hover .vs-journey-carousel-track {
    animation-play-state: paused !important;
  }

  @keyframes vsJourneySlideLeft {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* INDIVIDUAL IMAGE ITEM */
  .vs-journey-card-item {
    flex: 0 0 180px !important;
    width: 180px !important;
    aspect-ratio: 4 / 3 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    border: 3px solid #EC5C0A !important;
    box-shadow: 0 8px 24px rgba(236, 92, 10, 0.16) !important;
    position: relative !important;
    background: #F8FAFC !important;
    transition: transform 0.35s ease, box-shadow 0.35s ease !important;
    cursor: pointer !important;
    display: block !important;
    text-decoration: none !important;
  }

  .vs-journey-card-item:hover {
    transform: translateY(-6px) scale(1.04) !important;
    box-shadow: 0 16px 36px rgba(236, 92, 10, 0.3) !important;
  }

  .vs-journey-card-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.5s ease !important;
  }

  .vs-journey-card-item:hover .vs-journey-card-img {
    transform: scale(1.08) !important;
  }
{%- endstyle -%}

<!-- SECTION 15: VIDHYUT OUR JOURNEY CAROUSEL -->
<section class="vs-journey-section" id="vsJourneySection">
  <div class="vs-journey-container">

    <!-- HEADER -->
    <div class="vs-journey-header">
      <div class="vs-journey-script-subtitle">{{ section.settings.script_subtitle | default: "Our Journey" }}</div>
      <h2 class="vs-journey-main-heading">
        {{ section.settings.heading | default: "“The Journey of a 1,000 miles begins with one step”" }}
      </h2>
    </div>

    <!-- CAROUSEL (SEAMLESS INFINITE AUTO-GLIDE) -->
    <div class="vs-journey-carousel-wrapper" id="vsJourneyWrapper">
      <div class="vs-journey-carousel-track" id="vsJourneyTrack">
        
        {%- if section.blocks.size > 0 -%}
          <!-- FIRST SET OF IMAGES -->
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="vs-journey-card-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt_text | default: 'Vidhyut Saathi Journey Milestone' }}" class="vs-journey-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'Vidhyut_Saathi_Logo.jpg_1.jpg' | asset_url }}" alt="Vidhyut Saathi Journey" class="vs-journey-card-img" loading="lazy">
              {%- endif -%}
            </a>
          {%- endfor -%}
          
          <!-- DUPLICATE SET 1 (FOR SEAMLESS LOOP) -->
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="vs-journey-card-item" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt_text | default: 'Vidhyut Saathi Journey Milestone' }}" class="vs-journey-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'Vidhyut_Saathi_Logo.jpg_1.jpg' | asset_url }}" alt="Vidhyut Saathi Journey" class="vs-journey-card-img" loading="lazy">
              {%- endif -%}
            </a>
          {%- endfor -%}

          <!-- DUPLICATE SET 2 (ENSURES FULL BUFFER ON WIDE SCREENS) -->
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="vs-journey-card-item" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt_text | default: 'Vidhyut Saathi Journey Milestone' }}" class="vs-journey-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'Vidhyut_Saathi_Logo.jpg_1.jpg' | asset_url }}" alt="Vidhyut Saathi Journey" class="vs-journey-card-img" loading="lazy">
              {%- endif -%}
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default fallback photos (Looping 16 items) -->
          {%- for i in (1..8) -%}
            <div class="vs-journey-card-item">
              <img src="{{ 'electronics-minimal-1.jpg' | asset_url }}" alt="Our Journey Milestone" class="vs-journey-card-img" loading="lazy">
            </div>
          {%- endfor -%}
          {%- for i in (1..8) -%}
            <div class="vs-journey-card-item" aria-hidden="true">
              <img src="{{ 'electronics-minimal-1.jpg' | asset_url }}" alt="Our Journey Milestone" class="vs-journey-card-img" loading="lazy">
            </div>
          {%- endfor -%}
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Journey Carousel 15",
  "settings": [
    {
      "type": "text",
      "id": "script_subtitle",
      "label": "Script Subtitle",
      "default": "Our Journey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "“The Journey of a 1,000 miles begins with one step”"
    },
    {
      "type": "range",
      "id": "slide_duration",
      "min": 10,
      "max": 45,
      "step": 2,
      "unit": "s",
      "label": "Slide Speed Duration",
      "default": 22
    }
  ],
  "blocks": [
    {
      "type": "journey_image",
      "name": "Journey Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Journey Photo"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text",
          "default": "Vidhyut Saathi Journey Milestone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link (Optional)"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Journey Carousel 15",
      "blocks": [
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" },
        { "type": "journey_image" }
      ]
    }
  ]
}
{% endschema %}
