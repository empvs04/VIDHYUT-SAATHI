  function vsFilterArticles(catName, btnElem) {
    if (btnElem) {
      var allBtns = document.querySelectorAll('.vsblog-cat-btn');
      allBtns.forEach(function(b) { b.classList.remove('active'); });
      btnElem.classList.add('active');
    }
    
    var cards = document.querySelectorAll('#vsblog_article_grid .vsblog-card');
    cards.forEach(function(card) {
      var cardCat = card.getAttribute('data-category');
      if (catName === 'all' || cardCat === catName) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function vsSearchArticles() {
    var searchVal = document.getElementById('vsblog_search_input').value.toLowerCase();
    var cards = document.querySelectorAll('#vsblog_article_grid .vsblog-card');
    
    cards.forEach(function(card) {
      var title = card.getAttribute('data-title').toLowerCase();
      var cat = card.getAttribute('data-category').toLowerCase();
      if (title.indexOf(searchVal) !== -1 || cat.indexOf(searchVal) !== -1) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function vsOpenArticleModal(index) {
    var article = VS_ARTICLES[index] || VS_ARTICLES[0];
    document.getElementById('vsmodal_header_title').innerText = article.title;
    document.getElementById('vsmodal_cat').innerText = article.category;
    document.getElementById('vsmodal_date').innerText = article.date;
    document.getElementById('vsmodal_author').innerText = article.author;
    document.getElementById('vsmodal_readtime').innerText = article.readTime;
    document.getElementById('vsmodal_full_html').innerHTML = article.html;
    
    var overlay = document.getElementById('vsblog_modal_overlay');
    if (overlay) overlay.classList.add('active');
  }

  function vsCloseArticleModal(e) {
    var overlay = document.getElementById('vsblog_modal_overlay');
    if (overlay) overlay.classList.remove('active');
  }

  function vsSubscribeNewsletter(e) {
    e.preventDefault();
    var email = document.getElementById('vsblog_nl_email').value;
    var msg = document.getElementById('vsblog_nl_msg');
    if (email && msg) {
      msg.innerHTML = '<i class="fa-solid fa-circle-check"></i> Thank you! You have successfully subscribed to Vidhyut Saathi updates.';
      document.getElementById('vsblog_nl_email').value = '';
    }
  }
</script>

