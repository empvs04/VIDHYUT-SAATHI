<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* ============================================
     VIDHYUT SAATHI - ULTRA LUCRATIVE LIGHT BLOG HUB
     Theme: Warm Cream #fff8ef | Cards #ffffff | Premium Accent #ec5c0a | Green #007b3e | Slate #0f172a
  ============================================= */

  .vsblog-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    line-height: 1.55;
    font-weight: 400;
  }

  .vsblog-wrap *, .vsblog-wrap *::before, .vsblog-wrap *::after {
    box-sizing: border-box;
  }

  /* ─── ULTRA MODERN NEWSROOM HERO BANNER (INSPIRED BY REFERENCE) ─── */
  .vsblog-hero {
    position: relative;
    background: linear-gradient(135deg, #ec5c0a 0%, #ea580c 25%, #f97316 60%, #ff9a00 100%);
    padding: clamp(44px, 5.5vw, 72px) 16px clamp(50px, 6.5vw, 88px) 16px;
    overflow: hidden;
    color: #ffffff;
  }

  .vsblog-hero-dotgrid {
    position: absolute;
    top: 25px;
    left: 40px;
    width: 280px;
    height: 180px;
    background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1.5px, transparent 1.5px);
    background-size: 16px 16px;
    opacity: 0.6;
    pointer-events: none;
  }

  .vsblog-hero-glow-orb {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(254, 215, 170, 0.35) 0%, rgba(249, 115, 22, 0.22) 40%, transparent 70%);
    top: -140px;
    right: 8%;
    pointer-events: none;
    filter: blur(50px);
  }

  .vsblog-hero-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 32px;
    position: relative;
    z-index: 5;
  }

  @media (min-width: 900px) {
    .vsblog-hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
    }
  }

  .vsblog-hero-left {
    text-align: left;
  }

  .vsblog-hero-breadcrumb-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e2e8f0;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 16px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
    padding: 6px 14px;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .vsblog-hero-breadcrumb-tag a {
    color: #f8fafc;
    text-decoration: none;
    transition: color 0.2s;
  }

  .vsblog-hero-breadcrumb-tag a:hover {
    color: #fb923c;
  }

  .vsblog-hero-breadcrumb-tag .sep {
    color: #38bdf8;
    font-weight: 800;
  }

  .vsblog-hero-breadcrumb-tag .cur {
    color: #fb923c;
  }

  .vsblog-hero h1 {
    font-size: clamp(32px, 5.2vw, 56px);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.12;
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .vsblog-hero-desc {
    color: #e2e8f0;
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.55;
    font-weight: 500;
    margin: 0 0 24px 0;
    max-width: 580px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  .vsblog-hero-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vsblog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 7px 15px;
    border-radius: 50px;
    font-size: 12.5px;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }

  .vsblog-hero-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
    border-color: #ec5c0a;
  }

  .vsblog-hero-pill i {
    color: #fb923c;
  }

  .vsblog-hero-pill.green i {
    color: #34d399;
  }

  .vsblog-hero-pill.cyan i {
    color: #38bdf8;
  }

  /* Right Illustration Graphic Container */
  .vsblog-hero-illustration {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .vsblog-hero-svg-wrap {
    width: 100%;
    max-width: 460px;
    filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.45));
    animation: vsHeroFloat 4s ease-in-out infinite alternate;
  }

  @keyframes vsHeroFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-10px); }
  }

  /* Dynamic Wave Ribbons at bottom */
  .vsblog-hero-bottom-curves {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 4;
    pointer-events: none;
  }

  .vsblog-hero-bottom-curves svg {
    display: block;
    width: 100%;
    height: clamp(55px, 8vw, 95px);
  }

  /* ─── FLOATING STATS STRIP ─── */
  .vsblog-stats-strip {
    max-width: 1280px;
    margin: -18px auto 0 auto;
    padding: 0 16px;
    position: relative;
    z-index: 10;
  }

  .vsblog-stats-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1.5px solid rgba(236, 92, 10, 0.18);
    box-shadow: 0 10px 28px rgba(236, 92, 10, 0.07);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .vsblog-stats-card { grid-template-columns: repeat(4, 1fr); border-radius: 20px; }
    .vsblog-stats-strip { margin-top: -26px; padding: 0 20px; }
  }

  .vsblog-stat-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-right: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
  }

  @media (min-width: 768px) {
    .vsblog-stat-item { padding: 18px 22px; border-bottom: none; }
  }

  .vsblog-stat-item:nth-child(2n) { border-right: none; }
  @media (min-width: 768px) {
    .vsblog-stat-item:nth-child(2n) { border-right: 1px solid #f1f5f9; }
    .vsblog-stat-item:last-child { border-right: none; }
  }

  .vsblog-stat-icon {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #fff0e5 0%, #ffe3d1 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ec5c0a;
    font-size: 16px;
    flex-shrink: 0;
    box-shadow: 0 3px 10px rgba(236, 92, 10, 0.18);
  }

  .vsblog-stat-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .vsblog-stat-text strong {
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
  }

  .vsblog-stat-text span {
    color: #64748b;
    font-size: 11px;
    font-weight: 500;
  }

  /* ─── MAIN BODY ─── */
  .vsblog-body {
    max-width: 1280px;
    margin: 0 auto;
    padding: 26px 16px clamp(30px, 5vw, 56px) 16px;
  }

  @media (min-width: 768px) {
    .vsblog-body { padding: 36px 20px clamp(40px, 5vw, 70px) 20px; }
  }

  /* ─── CATEGORY FILTER BAR & SEARCH ─── */
  .vsblog-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    padding: 12px 14px;
    background: #ffffff;
    border-radius: 18px;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
    width: 100%;
  }

  @media (min-width: 768px) {
    .vsblog-filter-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      border-radius: 60px;
      padding: 12px 24px;
      margin-bottom: 32px;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
    }
  }

  .vsblog-filter-label {
    font-size: 12px;
    font-weight: 700;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .vsblog-filter-label i { color: #ec5c0a; }

  .vsblog-cats {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
    width: 100%;
  }

  .vsblog-cats::-webkit-scrollbar { display: none; }

  .vsblog-cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .vsblog-cat-btn:active {
    transform: scale(0.96);
  }

  .vsblog-cat-btn:hover,
  .vsblog-cat-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(236, 92, 10, 0.32);
  }

  .vsblog-search {
    display: flex;
    position: relative;
    width: 100%;
  }

  @media (min-width: 768px) {
    .vsblog-search { width: auto; min-width: 240px; max-width: 280px; }
  }

  .vsblog-search input {
    width: 100%;
    height: 40px;
    padding: 0 40px 0 16px;
    border: 1.5px solid #e2e8f0;
    border-radius: 50px;
    background: #f8fafc;
    font-size: 12px;
    font-family: inherit;
    color: #0f172a;
    font-weight: 400;
    outline: none;
    transition: all 0.2s ease;
  }

  .vsblog-search input:focus {
    background: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 0 0 3.5px rgba(236, 92, 10, 0.12);
  }

  .vsblog-search button {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #ec5c0a;
    cursor: pointer;
    font-size: 14px;
    padding: 0;
  }

  /* ─── ULTRA LUCRATIVE FEATURED ARTICLE CARD ─── */
  .vsblog-featured { margin-bottom: 28px; width: 100%; }
  @media (min-width: 768px) { .vsblog-featured { margin-bottom: 36px; } }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ec5c0a;
    margin-bottom: 14px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.3), transparent);
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    position: relative;
    width: 100%;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-card { 
      grid-template-columns: 1.2fr 1fr; 
      border-radius: 22px; 
      min-height: 380px;
    }
  }

  .vsblog-feat-card:active { transform: scale(0.99); }

  .vsblog-feat-card:hover {
    box-shadow: 0 18px 42px rgba(236, 92, 10, 0.14), 0 4px 12px rgba(0, 0, 0, 0.04);
    border-color: #ec5c0a;
    transform: translateY(-3px);
  }

  .vsblog-feat-img {
    position: relative;
    height: 205px;
    min-height: 205px;
    overflow: hidden;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-img { height: 100%; min-height: 380px; }
  }

  .vsblog-feat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-feat-card:hover .vsblog-feat-img img {
    transform: scale(1.06);
  }

  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #ec5c0a 100%);
  }

  .vsblog-feat-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 5px 14px;
    border-radius: 50px;
    z-index: 2;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.35);
  }

  .vsblog-feat-readtime-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 50px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .vsblog-feat-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-content { padding: 30px; }
  }

  .vsblog-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #007b3e;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    background: rgba(0, 123, 62, 0.08);
    padding: 4px 12px;
    border-radius: 50px;
    width: fit-content;
    border: 1px solid rgba(0, 123, 62, 0.15);
  }

  .vsblog-feat-content h2 {
    font-size: clamp(16px, 2.5vw, 24px);
    font-weight: 700;
    color: #0f172a;
    line-height: 1.32;
    margin: 0 0 10px 0;
    transition: color 0.2s;
  }

  .vsblog-feat-card:hover .vsblog-feat-content h2 { color: #ec5c0a; }

  .vsblog-feat-content p {
    color: #64748b;
    line-height: 1.55;
    font-size: 13px;
    font-weight: 400;
    margin: 0 0 16px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 1040px) {
    .vsblog-feat-content p { font-size: 14px; line-height: 1.6; -webkit-line-clamp: 3; margin-bottom: 20px; }
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    color: #64748b;
    font-weight: 500;
  }

  .vsblog-meta-chip i { color: #ec5c0a; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 11px 24px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    width: 100%;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(236, 92, 10, 0.3);
  }

  @media (min-width: 640px) {
    .vsblog-read-btn { width: fit-content; padding: 11px 26px; font-size: 13px; }
  }

  .vsblog-read-btn:hover {
    transform: translateX(4px);
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.42);
  }

  /* ─── TWO-COL LAYOUT (GRID + SIDEBAR) ─── */
  .vsblog-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
    width: 100%;
  }

  @media (min-width: 1040px) {
    .vsblog-two-col { grid-template-columns: 1fr 330px; gap: 28px; }
  }

  /* ─── SLEEK MODERN EDITORIAL ARTICLE GRID CARDS ─── */
  .vsblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .vsblog-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  }

  .vsblog-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.035);
    border: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    width: 100%;
  }

  .vsblog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ec5c0a 0%, #ff7b00 50%, #007b3e 100%);
    opacity: 0.85;
    z-index: 5;
    transition: opacity 0.25s ease, height 0.25s ease;
  }

  .vsblog-card:active {
    transform: scale(0.985);
  }

  .vsblog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(236, 92, 10, 0.12), 0 4px 12px rgba(0, 0, 0, 0.04);
    border-color: rgba(236, 92, 10, 0.35);
  }

  .vsblog-card:hover::before {
    height: 4px;
    opacity: 1;
  }

  .vsblog-card-img {
    position: relative;
    height: 155px;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 1040px) {
    .vsblog-card-img { height: 160px; }
  }

  .vsblog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-card:hover .vsblog-card-img img {
    transform: scale(1.06);
  }

  .vsblog-thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsblog-card-cat-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    color: #ec5c0a;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3.5px 11px;
    border-radius: 50px;
    z-index: 2;
    border: 1px solid rgba(236, 92, 10, 0.25);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .vsblog-card-readtime-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 9.5px;
    font-weight: 600;
    padding: 3px 9.5px;
    border-radius: 50px;
    z-index: 2;
  }

  .vsblog-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 1040px) {
    .vsblog-card-body { padding: 18px 18px 16px 18px; }
  }

  .vsblog-card-title {
    font-size: 14.5px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 8px 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.2s;
    min-height: 40px;
  }

  .vsblog-card-title:hover { color: #ec5c0a; }

  .vsblog-card-excerpt {
    font-size: 12.5px;
    color: #64748b;
    line-height: 1.5;
    font-weight: 400;
    margin: 0 0 14px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
    min-height: 38px;
  }

  .vsblog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
    gap: 8px;
  }

  .vsblog-card-date {
    font-size: 11px;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

