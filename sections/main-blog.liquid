  .vsblog-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(6px);
    z-index: 9999;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  @media (min-width: 640px) {
    .vsblog-modal-overlay {
      align-items: center;
      padding: 20px;
    }
  }

  /* ============================================================
     ULTRA-PREMIUM MODAL READER STYLES
     ============================================================ */
  .vsblog-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(8, 15, 28, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .vsblog-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .vsblog-modal-box {
    background: #ffffff;
    border-radius: 24px;
    max-width: 900px;
    width: 100%;
    max-height: 92vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(236, 92, 10, 0.25);
    border: 1px solid rgba(236, 92, 10, 0.28);
    animation: vsModalPopUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    scrollbar-width: thin;
    scrollbar-color: #ec5c0a #f1f5f9;
  }

  .vsblog-modal-box::-webkit-scrollbar {
    width: 6px;
  }
  .vsblog-modal-box::-webkit-scrollbar-thumb {
    background: #ec5c0a;
    border-radius: 4px;
  }
  .vsblog-modal-box::-webkit-scrollbar-track {
    background: #f1f5f9;
  }

  @keyframes vsModalPopUp {
    from { opacity: 0; transform: translateY(30px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .vsblog-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    cursor: pointer;
    z-index: 30;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  }

  .vsblog-modal-close:hover {
    background: #ec5c0a;
    color: #ffffff;
    transform: rotate(90deg) scale(1.08);
    border-color: #ec5c0a;
  }

  .vsblog-modal-header-banner {
    position: relative;
    background: linear-gradient(135deg, #070d19 0%, #0f1c32 55%, #182b49 100%);
    padding: 34px 28px 26px 28px;
    border-bottom: 2px solid rgba(236, 92, 10, 0.35);
    overflow: hidden;
  }

  .vsblog-modal-header-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(236,92,10,0.4) 0%, rgba(236,92,10,0) 70%);
    pointer-events: none;
  }

  .vsblog-modal-header-content {
    position: relative;
    z-index: 2;
  }

  .vsblog-modal-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .vsmodal-badge-cat {
    display: inline-flex;
