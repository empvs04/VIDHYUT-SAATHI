<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ============================================
     VIDHYUT SAATHI - ULTRA-LUCRATIVE MOBILE-FIRST LIGHT BLOG HUB
     Theme: Warm Cream #fff8ef | Cards #ffffff | Orange #ec5c0a | Green #007b3e | Slate #0f172a
  ============================================= */

  .vsblog-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    line-height: 1.5;
  }

  .vsblog-wrap *, .vsblog-wrap *::before, .vsblog-wrap *::after {
    box-sizing: border-box;
  }

  /* ─── HERO BANNER ─── */
  .vsblog-hero {
    position: relative;
    background: linear-gradient(135deg, #ffffff 0%, #fff3e6 40%, #fff8ef 100%);
    padding: clamp(36px, 6vw, 80px) 16px clamp(32px, 4vw, 60px) 16px;
    overflow: hidden;
    text-align: center;
    border-bottom: 2px solid rgba(236, 92, 10, 0.12);
  }

  .vsblog-hero-orbs::before {
    content: '';
    position: absolute;
    top: -80px;
    left: -80px;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.14) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-hero-circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.12;
    pointer-events: none;
  }

  .vsblog-hero-content {
    position: relative;
    z-index: 2;
    max-width: 840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vsblog-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ffffff;
    border: 1.5px solid #ec5c0a;
    color: #ec5c0a;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 5px 16px;
    border-radius: 50px;
    margin-bottom: 14px;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.1);
  }

  .vsblog-hero h1 {
    font-size: clamp(22px, 4.8vw, 48px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.2;
    margin: 0 0 10px 0;
    letter-spacing: -0.5px;
  }

  .vsblog-hero h1 span {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsblog-hero-desc {
    color: #475569;
    font-size: clamp(13.5px, 1.8vw, 17px);
    line-height: 1.55;
    max-width: 660px;
    margin: 0 0 18px 0;
  }

  /* Breadcrumb */
  .vsblog-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    padding: 6px 16px;
    border-radius: 50px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
  }

  .vsblog-breadcrumb a { color: #475569; text-decoration: none; }
  .vsblog-breadcrumb a:hover { color: #ec5c0a; }
  .vsblog-breadcrumb .sep { color: #cbd5e1; }
  .vsblog-breadcrumb .cur { color: #ec5c0a; font-weight: 800; }

  /* ─── FLOATING STATS STRIP ─── */
  .vsblog-stats-strip {
    max-width: 1240px;
    margin: -18px auto 0 auto;
    padding: 0 12px;
    position: relative;
    z-index: 10;
  }

  .vsblog-stats-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1.5px solid rgba(236, 92, 10, 0.15);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.04);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .vsblog-stats-card { grid-template-columns: repeat(4, 1fr); }
    .vsblog-stats-strip { margin-top: -28px; padding: 0 20px; }
  }

  .vsblog-stat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-right: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
  }

  @media (min-width: 768px) {
    .vsblog-stat-item { padding: 18px 20px; border-bottom: none; }
  }

  .vsblog-stat-item:nth-child(2n) { border-right: none; }
  @media (min-width: 768px) {
    .vsblog-stat-item:nth-child(2n) { border-right: 1px solid #f1f5f9; }
    .vsblog-stat-item:last-child { border-right: none; }
  }

  .vsblog-stat-icon {
    width: 36px;
    height: 36px;
    background: #fff0e5;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ec5c0a;
    font-size: 15px;
    flex-shrink: 0;
  }

  .vsblog-stat-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .vsblog-stat-text strong {
    color: #0f172a;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.2;
  }

  .vsblog-stat-text span {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
  }

  /* ─── MAIN BODY ─── */
  .vsblog-body {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px 12px clamp(30px, 5vw, 60px) 12px;
  }

  @media (min-width: 768px) {
    .vsblog-body { padding: 44px 20px clamp(40px, 6vw, 80px) 20px; }
  }

  /* ─── CATEGORY FILTER BAR & SEARCH ─── */
  .vsblog-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
    padding: 12px;
    background: #ffffff;
    border-radius: 18px;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  @media (min-width: 768px) {
    .vsblog-filter-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      border-radius: 60px;
      padding: 14px 24px;
      margin-bottom: 40px;
    }
  }

  .vsblog-filter-label {
    font-size: 12px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .vsblog-filter-label i { color: #ec5c0a; }

  /* Horizontal swipeable category strip on mobile */
  .vsblog-cats {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
    width: 100%;
  }

  .vsblog-cats::-webkit-scrollbar { display: none; }

  .vsblog-cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .vsblog-cat-btn:hover,
  .vsblog-cat-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.3);
  }

  .vsblog-search {
    display: flex;
    position: relative;
    width: 100%;
  }

  @media (min-width: 768px) {
    .vsblog-search { width: auto; min-width: 240px; max-width: 300px; }
  }

  .vsblog-search input {
    width: 100%;
    height: 40px;
    padding: 0 40px 0 16px;
    border: 1.5px solid #e2e8f0;
    border-radius: 50px;
    background: #f8fafc;
    font-size: 12.5px;
    font-family: inherit;
    color: #0f172a;
    outline: none;
    transition: all 0.2s ease;
  }

  .vsblog-search input:focus {
    background: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 0 0 3px rgba(236, 92, 10, 0.12);
  }

  .vsblog-search button {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #ec5c0a;
    cursor: pointer;
    font-size: 14px;
    padding: 0;
  }

  /* ─── FEATURED ARTICLE CARD ─── */
  .vsblog-featured { margin-bottom: 30px; }
  @media (min-width: 768px) { .vsblog-featured { margin-bottom: 44px; } }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #ec5c0a;
    margin-bottom: 14px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.3), transparent);
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .vsblog-feat-card { grid-template-columns: 1.15fr 1fr; border-radius: 24px; }
  }

  .vsblog-feat-card:hover {
    box-shadow: 0 16px 40px rgba(236, 92, 10, 0.12);
    transform: translateY(-3px);
  }

  .vsblog-feat-img {
    position: relative;
    height: 200px;
    min-height: 200px;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .vsblog-feat-img { height: 100%; min-height: 420px; }
  }

  .vsblog-feat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vsblog-feat-card:hover .vsblog-feat-img img {
    transform: scale(1.04);
  }

  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fff7ed 0%, #ffede0 100%);
  }

  .vsblog-feat-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #ec5c0a;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 4px 12px;
    border-radius: 50px;
    z-index: 2;
    box-shadow: 0 3px 10px rgba(236, 92, 10, 0.3);
  }

  .vsblog-feat-content {
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  @media (min-width: 768px) {
    .vsblog-feat-content { padding: 32px; }
  }

  .vsblog-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #007b3e;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 10px;
    background: rgba(0, 123, 62, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    width: fit-content;
  }

  .vsblog-feat-content h2 {
    font-size: clamp(16px, 2.8vw, 26px);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    margin: 0 0 10px 0;
  }

  .vsblog-feat-content p {
    color: #64748b;
    line-height: 1.55;
    font-size: 13px;
    margin: 0 0 16px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .vsblog-feat-content p { font-size: 14.5px; -webkit-line-clamp: 4; margin-bottom: 20px; }
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    color: #64748b;
    font-weight: 600;
  }

  .vsblog-meta-chip i { color: #ec5c0a; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    padding: 11px 22px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    width: 100%;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.3);
  }

  @media (min-width: 640px) {
    .vsblog-read-btn { width: fit-content; padding: 12px 26px; }
  }

  .vsblog-read-btn:hover {
    transform: translateX(3px);
    box-shadow: 0 8px 22px rgba(236, 92, 10, 0.45);
  }

  /* ─── TWO-COL LAYOUT (GRID + SIDEBAR) ─── */
  .vsblog-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 1040px) {
    .vsblog-two-col { grid-template-columns: 1fr 340px; gap: 36px; }
  }

  /* COMPACT ARTICLE GRID ON MOBILE */
  .vsblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 600px) {
    .vsblog-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  }

  .vsblog-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    border: 1.5px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.25s ease;
  }

  .vsblog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 35px rgba(236, 92, 10, 0.1);
    border-color: rgba(236, 92, 10, 0.28);
  }

  .vsblog-card-img {
    position: relative;
    height: 160px;
    overflow: hidden;
    flex-shrink: 0;
  }

  @media (min-width: 600px) {
    .vsblog-card-img { height: 190px; }
  }

  .vsblog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vsblog-card:hover .vsblog-card-img img {
    transform: scale(1.05);
  }

  .vsblog-thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsblog-card-cat-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #ffffff;
    color: #ec5c0a;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 10px;
    border-radius: 50px;
    z-index: 2;
    border: 1px solid rgba(236, 92, 10, 0.2);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .vsblog-card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (min-width: 600px) {
    .vsblog-card-body { padding: 20px; }
  }

  .vsblog-card-title {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 8px 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.2s;
  }

  @media (min-width: 600px) {
    .vsblog-card-title { font-size: 15px; margin-bottom: 10px; min-height: 42px; }
  }

  .vsblog-card-title:hover { color: #ec5c0a; }

  .vsblog-card-excerpt {
    font-size: 12.5px;
    color: #64748b;
    line-height: 1.5;
    margin: 0 0 14px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  @media (min-width: 600px) {
    .vsblog-card-excerpt { font-size: 13px; line-height: 1.55; -webkit-line-clamp: 3; min-height: 60px; margin-bottom: 18px; }
  }

  .vsblog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
    gap: 8px;
  }

  .vsblog-card-date {
    font-size: 11px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  .vsblog-card-date i { color: #ec5c0a; }

  .vsblog-card-btn {
    font-size: 11.5px;
    font-weight: 800;
    color: #ec5c0a;
    background: #fff0e5;
    border: 1px solid rgba(236, 92, 10, 0.25);
    padding: 5px 12px;
    border-radius: 50px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.2s ease;
  }

  .vsblog-card-btn:hover {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ec5c0a;
  }

  /* ─── SIDEBAR WIDGETS ─── */
  .vsblog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 1040px) {
    .vsblog-sidebar { position: sticky; top: 90px; gap: 24px; }
  }

  .vsblog-sidebar-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    border: 1.5px solid #f1f5f9;
  }

  @media (min-width: 768px) {
    .vsblog-sidebar-card { padding: 22px; border-radius: 20px; }
  }

  .vsblog-sidebar-heading {
    font-size: 12.5px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0 0 12px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vsblog-sidebar-heading i { color: #ec5c0a; }

  .vsblog-sidebar-post {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid #f8fafc;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .vsblog-sidebar-post:last-child { border-bottom: none; padding-bottom: 0; }
  .vsblog-sidebar-post:hover { opacity: 0.75; }

  .vsblog-sidebar-post-num {
    width: 26px;
    height: 26px;
    background: #fff0e5;
    color: #ec5c0a;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .vsblog-sidebar-post-info h4 {
    font-size: 12.5px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 3px 0;
    line-height: 1.35;
  }

  .vsblog-sidebar-post-info span {
    font-size: 11px;
    color: #94a3b8;
  }

  .vsblog-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .vsblog-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    font-size: 11.5px;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
  }

  .vsblog-tag-pill:hover {
    background: #ec5c0a;
    border-color: #ec5c0a;
    color: #ffffff;
  }

  /* SIDEBAR FRANCHISE CTA WIDGET */
  .vsblog-sidebar-cta {
    background: linear-gradient(135deg, #fff7ed 0%, #ffe8d6 100%);
    border-radius: 16px;
    padding: 20px 16px;
    text-align: center;
    border: 1.5px solid #ec5c0a;
    position: relative;
    overflow: hidden;
  }

  .vsblog-sidebar-cta-icon {
    width: 48px;
    height: 48px;
    background: #ffffff;
    border: 1.5px solid #ec5c0a;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: #ec5c0a;
    margin: 0 auto 12px auto;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.15);
  }

  .vsblog-sidebar-cta h3 {
    font-size: 15px;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 6px 0;
  }

  .vsblog-sidebar-cta p {
    font-size: 12px;
    color: #475569;
    line-height: 1.45;
    margin: 0 0 16px 0;
  }

  .vsblog-sidebar-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
