        {% if section.settings.social_insta != blank %}<a href="{{ section.settings.social_insta }}" target="_blank" aria-label="Instagram" class="vs-social-pill"><i class="fa-brands fa-instagram"></i></a>{% endif %}
        {% if section.settings.social_yt != blank %}<a href="{{ section.settings.social_yt }}" target="_blank" aria-label="YouTube" class="vs-social-pill"><i class="fa-brands fa-youtube"></i></a>{% endif %}
      </div>
    </div>
  </div>
</footer>

<script>
  function initNeoFooterAnimations() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      const elements = document.querySelectorAll('#section-{{ section.id }} .v-anim-footer');
      gsap.fromTo(elements, 
        { y: 40, opacity: 0 },
        {
          scrollTrigger: { trigger: "#section-{{ section.id }}", start: "top 95%" },
          y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: "power3.out", clearProps: "transform"
        }
      );
    }
  }
  document.addEventListener("DOMContentLoaded", initNeoFooterAnimations);
  if (window.Shopify && Shopify.designMode) { setTimeout(initNeoFooterAnimations, 200); }
</script>

{% schema %}
{
  "name": "Vidhyut Neo Footer",
  "settings": [
    { "type": "header", "content": "Brand Settings" },
    { "type": "image_picker", "id": "footer_logo", "label": "Footer Logo" },
    { "type": "text", "id": "address", "label": "Address", "default": "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." },
    { "type": "text", "id": "email", "label": "Email Address", "default": "info@vidhyutsaathi.com" },
    
    { "type": "header", "content": "Certifications" },
    { "type": "image_picker", "id": "iso_cert_image", "label": "ISO Certificate Image" },
    { "type": "image_picker", "id": "startup_india_image", "label": "Startup India Logo" },

    { "type": "header", "content": "Social Links" },
    { "type": "url", "id": "social_fb", "label": "Facebook URL" },
    { "type": "url", "id": "social_insta", "label": "Instagram URL" },
    { "type": "url", "id": "social_yt", "label": "YouTube URL" }
  ],
  "presets": [
    { "name": "Vidhyut Neo Footer" }
  ]
}
{% endschema %}