      </svg>
    </div>

    <!-- 4 MINIMALIST COLUMNS (EXACT DRIBBBLE FOOTER GRID BELOW WORDMARK) -->
    <div class="vs-dribbble-grid">
      
      <!-- Column 1: VIDHYUT -->
      <div class="vs-dribbble-col v-anim-footer">
        <h5>VIDHYUT</h5>
