<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  /* ================= DRIBBBLE MAGIC PEOPLE EXACT TYPOGRAPHY FOOTER ================= */
  .vs-magic-footer {
    background-color: #080808;
    color: #8e8e93;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    padding: 90px 0 40px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid #1c1c1e;
    -webkit-tap-highlight-color: transparent;
  }

  .vs-magic-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 5;
  }

  /* GIANT DISPLAY WORDMARK (EXACT MAGIC PEOPLE FONT & STYLING) */
  .vs-magic-wordmark-block {
    width: 100%;
    position: relative;
    margin-bottom: 75px;
    user-select: none;
  }

  .vs-magic-top-emblem {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 48px;
    height: 48px;
    border: 2px solid #f5f4ef;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f17e39;
    font-size: 1.2rem;
    z-index: 10;
  }

  .vs-magic-wordmark-title {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-size: clamp(3.5rem, 15vw, 13.5rem);
    font-weight: 900;
    line-height: 0.78;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #f5f4ef;
    margin: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .vs-magic-line-1 {
    display: block;
    text-align: left;
    color: #f5f4ef;
    transform: scaleY(1.05);
  }

  .vs-magic-line-2 {
    display: block;
    text-align: right;
    color: #f5f4ef;
    transform: scaleY(1.05);
    margin-top: -0.05em;
  }

  /* 4 MINIMALIST COLUMNS BELOW WORDMARK */
  .vs-magic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.1fr 1.4fr;
    gap: 40px;
    padding-top: 50px;
    padding-bottom: 70px;
    border-top: 1px solid #2c2c2e;
  }

  .vs-magic-col h5 {
    font-family: 'Unbounded', sans-serif;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 24px 0;
  }

  .vs-magic-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-magic-links a {
    color: #8e8e93;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
  }

  .vs-magic-links a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  /* Highlighted Required Cards Link */
  .vs-req-badge-link {
    color: #f17e39 !important;
  }

  .vs-req-badge-link span {
    background: #f17e39;
    color: #000000;
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 900;
  }

  /* Certifications List (Dribbble Style) */
  .vs-magic-cert-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vs-magic-cert-item {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
    background: #121214;
    border: 1px solid #2c2c2e;
    padding: 10px 14px;
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .vs-magic-cert-item:hover {
    border-color: #f17e39;
    transform: translateY(-2px);
  }

  .vs-magic-cert-img {
    width: 32px;
    height: 32px;
    background: #ffffff;
    border-radius: 6px;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vs-magic-cert-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .vs-magic-cert-text strong {
    display: block;
    font-size: 0.8rem;
    color: #ffffff;
    font-weight: 700;
  }

  .vs-magic-cert-text span {
    font-size: 0.7rem;
    color: #22c55e;
    font-weight: 600;
  }

  /* Studio / Contact Block (Exact Dribbble Style) */
  .vs-studio-details {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.85rem;
    color: #8e8e93;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .vs-studio-details a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .vs-studio-details a:hover {
    color: #f17e39;
  }

  .vs-studio-address-text {
    color: #8e8e93;
    font-size: 0.8rem;
    line-height: 1.6;
    margin-top: 4px;
    text-transform: uppercase;
  }

  /* DRIBBBLE BOTTOM STRIP */
  .vs-magic-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid #1c1c1e;
  }

  .vs-magic-copyright {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #636366;
  }

  .vs-magic-socials {
    display: flex;
    gap: 20px;
  }

  .vs-magic-socials a {
    color: #8e8e93;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .vs-magic-socials a:hover {
    color: #f17e39;
  }

  .vs-magic-tagline {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f5f4ef;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vs-magic-tagline i {
    color: #f17e39;
  }

  /* MOBILE RESPONSIVE DESIGN */
  @media (max-width: 1024px) {
    .vs-magic-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .vs-magic-footer {
      padding: 50px 0 30px 0;
    }
    .vs-magic-container {
      padding: 0 1.2rem;
    }
    .vs-magic-wordmark-block {
      margin-bottom: 40px;
    }
    .vs-magic-wordmark-title {
      font-size: clamp(2.5rem, 13vw, 5.5rem);
    }
    .vs-magic-line-1 {
      text-align: center;
    }
    .vs-magic-line-2 {
      text-align: center;
    }
    .vs-magic-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .vs-magic-bottom {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
    .vs-magic-socials {
      justify-content: center;
    }
  }
{%- endstyle -%}

<footer class="vs-magic-footer" id="section-{{ section.id }}">
  <div class="vs-magic-container">
    
    <!-- GIANT DISPLAY WORDMARK (EXACT DRIBBBLE MAGIC PEOPLE FONT & STYLING) -->
    <div class="vs-magic-wordmark-block v-anim-footer">
      <div class="vs-magic-top-emblem">
        <i class="fa-solid fa-bolt"></i>
      </div>
      
      <h1 class="vs-magic-wordmark-title">
        <span class="vs-magic-line-1">VIDHYUT</span>
        <span class="vs-magic-line-2">SAATHI</span>
      </h1>
    </div>

    <!-- 4 MINIMALIST COLUMNS (EXACT DRIBBBLE FOOTER GRID) -->
    <div class="vs-magic-grid">
      
      <!-- Column 1: VIDHYUT (Useful Links) -->
      <div class="vs-magic-col v-anim-footer">
        <h5>VIDHYUT</h5>
        <ul class="vs-magic-links">
          <li><a href="/">Home</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/b2c">Why Vidhyut Saathi</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms &amp; Conditions</a></li>
          <li><a href="/pages/disclaimer">Disclaimer</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 2: SAATHI (Our Solutions) -->
      <div class="vs-magic-col v-anim-footer">
        <h5>SAATHI</h5>
        <ul class="vs-magic-links">
          <li><a href="/products/vidhyut-saathi-electric-power-saver-card">Vidhyut Saathi Card</a></li>
          <li>
            <a href="/pages/required-cards" class="vs-req-badge-link">
              Required Cards <span>HOT</span>
            </a>
          </li>
          <li><a href="/pages/b2c">Fuel Saving Saathi</a></li>
          <li><a href="/products/vidhyut-saathi-electric-power-saver-card">Get Card</a></li>
          <li><a href="/pages/contact">Get Franchise</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: SOCIALS & RECOGNITIONS -->
      <div class="vs-magic-col v-anim-footer">
        <h5>SOCIALS</h5>
        <ul class="vs-magic-links">
          {% if section.settings.social_fb != blank %}<li><a href="{{ section.settings.social_fb }}" target="_blank">Facebook</a></li>{% else %}<li><a href="#">Facebook</a></li>{% endif %}
          {% if section.settings.social_insta != blank %}<li><a href="{{ section.settings.social_insta }}" target="_blank">Instagram</a></li>{% else %}<li><a href="#">Instagram</a></li>{% endif %}
          {% if section.settings.social_yt != blank %}<li><a href="{{ section.settings.social_yt }}" target="_blank">YouTube</a></li>{% else %}<li><a href="#">YouTube</a></li>{% endif %}
        </ul>

        <div class="vs-magic-cert-list">
          <a href="/pages/iso-certification" class="vs-magic-cert-item">
            <div class="vs-magic-cert-img">
              {% if section.settings.iso_cert_image != blank %}
                <img src="{{ section.settings.iso_cert_image | img_url: 'small' }}" alt="ISO" loading="lazy">
              {% else %}
                <img src="{{ 'iso-certificate.jpg' | asset_url }}" alt="ISO" loading="lazy">
              {% endif %}
            </div>
            <div class="vs-magic-cert-text">
              <strong>ISO 9001 CERTIFIED</strong>
              <span>✓ Quality Guaranteed</span>
            </div>
          </a>

          <div class="vs-magic-cert-item">
            <div class="vs-magic-cert-img">
              {% if section.settings.startup_india_image != blank %}
                <img src="{{ section.settings.startup_india_image | img_url: 'small' }}" alt="Startup India" loading="lazy">
              {% else %}
                <img src="{{ 'startup-india.svg' | asset_url }}" alt="Startup India" loading="lazy">
              {% endif %}
            </div>
            <div class="vs-magic-cert-text">
              <strong>STARTUP INDIA</strong>
              <span>✓ Govt. Recognized</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Column 4: STUDIO / CONTACT -->
      <div class="vs-magic-col v-anim-footer">
        <h5>STUDIO</h5>
        <div class="vs-studio-details">
          <div>
            <a href="mailto:{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}">{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}</a>
          </div>

          <div>
            <a href="tel:+918199036060">+91-8199036060</a><br>
            <a href="tel:+919053110707">+91-9053110707</a>
          </div>

          <div class="vs-studio-address-text">
            {{ section.settings.address | default: "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." }}
          </div>
        </div>
      </div>

    </div>

    <!-- DRIBBBLE BOTTOM STRIP -->
    <div class="vs-magic-bottom v-anim-footer">
      <div class="vs-magic-copyright">
        COPYRIGHT &copy; {{ 'now' | date: "%Y" }}
      </div>

      <div class="vs-magic-socials">
        {% if section.settings.social_fb != blank %}<a href="{{ section.settings.social_fb }}" target="_blank">Facebook</a>{% endif %}
        {% if section.settings.social_insta != blank %}<a href="{{ section.settings.social_insta }}" target="_blank">Instagram</a>{% endif %}
        {% if section.settings.social_yt != blank %}<a href="{{ section.settings.social_yt }}" target="_blank">YouTube</a>{% endif %}
      </div>

      <div class="vs-magic-tagline">
        <i class="fa-solid fa-bolt"></i> WE ARE VIDHYUT SAATHI
      </div>
    </div>

  </div>
</footer>

<script>
  function initMagicFooterAnimations() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      const elements = document.querySelectorAll('#section-{{ section.id }} .v-anim-footer');
      gsap.fromTo(elements, 
        { y: 40, opacity: 0 },
        {
          scrollTrigger: { trigger: "#section-{{ section.id }}", start: "top 95%" },
          y: 0, opacity: 1, duration: 0.8, stagger: 0.12, ease: "power3.out", clearProps: "transform"
        }
      );
    }
  }
  document.addEventListener("DOMContentLoaded", initMagicFooterAnimations);
  if (window.Shopify && Shopify.designMode) { setTimeout(initMagicFooterAnimations, 200); }
</script>

{% schema %}
{
  "name": "Vidhyut Magic Footer",
  "settings": [
    { "type": "header", "content": "Brand Settings" },
    { "type": "text", "id": "address", "label": "Address", "default": "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." },
    { "type": "text", "id": "email", "label": "Email Address", "default": "info@vidhyutsaathi.com" },
    
    { "type": "header", "content": "Certifications" },
    { "type": "image_picker", "id": "iso_cert_image", "label": "ISO Certificate Image" },
    { "type": "image_picker", "id": "startup_india_image", "label": "Startup India Logo" },

    { "type": "header", "content": "Social Links" },
    { "type": "url", "id": "social_fb", "label": "Facebook URL" },
    { "type": "url", "id": "social_insta", "label": "Instagram URL" },
    { "type": "url", "id": "social_yt", "label": "YouTube URL" }
  ],
  "presets": [
    { "name": "Vidhyut Magic Footer" }
  ]
}
{% endschema %}