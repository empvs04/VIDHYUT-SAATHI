<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  /* ================= DRIBBBLE EXACT REPLICA FOOTER ================= */
  .vs-dribbble-footer {
    background-color: #050505;
    color: #a1a1aa;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    padding: 80px 0 40px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid #18181b;
    -webkit-tap-highlight-color: transparent;
  }

  .vs-dribbble-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 5;
  }

  /* GIANT STACKED WORDMARK (EXACT DRIBBBLE STYLE) */
  .vs-giant-stack {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 70px;
    user-select: none;
  }

  .vs-giant-line {
    font-family: 'Syne', sans-serif;
    font-size: clamp(4rem, 16vw, 15rem);
    font-weight: 900;
    line-height: 0.78;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: #f5f4ef;
    margin: 0;
    text-align: center;
    width: 100%;
    display: block;
  }

  .vs-giant-line-accent {
    color: #f5f4ef;
    position: relative;
  }

  .vs-giant-line-accent::after {
    content: '★';
    font-size: 0.35em;
    color: #f17e39;
    vertical-align: super;
    margin-left: 10px;
  }

  /* 4 MINIMALIST COLUMNS (EXACT DRIBBBLE LAYOUT) */
  .vs-dribbble-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.4fr;
    gap: 40px;
    padding-top: 40px;
    padding-bottom: 70px;
  }

  .vs-dribbble-col h5 {
    font-family: 'Syne', sans-serif;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 24px 0;
  }

  .vs-dribbble-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-dribbble-links a {
    color: #8e8e93;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
  }

  .vs-dribbble-links a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  /* Highlighted Required Cards */
  .vs-req-card-link {
    color: #f17e39 !important;
  }

  .vs-req-card-link span {
    background: #f17e39;
    color: #000000;
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 900;
  }

  /* Studio / Contact Block (Exact Dribbble Style) */
  .vs-studio-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.88rem;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .vs-studio-block a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .vs-studio-block a:hover {
    color: #f17e39;
  }

  .vs-studio-address {
    color: #8e8e93;
    font-size: 0.82rem;
    line-height: 1.6;
    margin-top: 6px;
    text-transform: uppercase;
  }

  /* Recognition Badges in Column 3 */
  .vs-dribbble-badge-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 15px;
  }

  .vs-dribbble-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #121214;
    border: 1px solid #27272a;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    width: fit-content;
    transition: all 0.3s ease;
  }

  .vs-dribbble-badge:hover {
    border-color: #f17e39;
    transform: translateY(-2px);
  }

  .vs-dribbble-badge img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    background: #ffffff;
    border-radius: 4px;
    padding: 2px;
  }

  /* DRIBBBLE BOTTOM STRIP */
  .vs-dribbble-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid #1c1c1e;
  }

  .vs-dribbble-copy {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #636366;
  }

  .vs-dribbble-tagline {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f5f4ef;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vs-dribbble-tagline i {
    color: #f17e39;
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .vs-dribbble-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .vs-dribbble-footer {
      padding: 50px 0 30px 0;
    }
    .vs-dribbble-container {
      padding: 0 1.2rem;
    }
    .vs-giant-stack {
      margin-bottom: 40px;
    }
    .vs-dribbble-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .vs-dribbble-bottom {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
  }
{%- endstyle -%}

<footer class="vs-dribbble-footer" id="section-{{ section.id }}">
  <div class="vs-dribbble-container">
    
    <!-- GIANT STACKED WORDMARK (EXACT DRIBBBLE ARTWORK STYLE) -->
    <div class="vs-giant-stack v-anim-footer">
      <span class="vs-giant-line">VIDHYUT</span>
      <span class="vs-giant-line vs-giant-line-accent">SAATHI</span>
    </div>

    <!-- 4 MINIMALIST COLUMNS (EXACT DRIBBBLE FOOTER GRID) -->
    <div class="vs-dribbble-grid">
      
      <!-- Column 1: VIDHYUT -->
      <div class="vs-dribbble-col v-anim-footer">
        <h5>VIDHYUT</h5>
        <ul class="vs-dribbble-links">
          <li><a href="/">Home</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/b2c">Why Vidhyut Saathi</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms &amp; Conditions</a></li>
          <li><a href="/pages/disclaimer">Disclaimer</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 2: SAATHI -->
      <div class="vs-dribbble-col v-anim-footer">
        <h5>SAATHI</h5>
        <ul class="vs-dribbble-links">
          <li><a href="/products/vidhyut-saathi-electric-power-saver-card">Vidhyut Saathi Card</a></li>
          <li>
            <a href="/pages/required-cards" class="vs-req-card-link">
              Required Cards <span>HOT</span>
            </a>
          </li>
          <li><a href="/pages/b2c">Fuel Saving Saathi</a></li>
          <li><a href="/products/vidhyut-saathi-electric-power-saver-card">Get Card</a></li>
          <li><a href="/pages/contact">Get Franchise</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: SOCIALS & RECOGNITIONS -->
      <div class="vs-dribbble-col v-anim-footer">
        <h5>SOCIALS</h5>
        <ul class="vs-dribbble-links">
          {% if section.settings.social_fb != blank %}<li><a href="{{ section.settings.social_fb }}" target="_blank">Facebook</a></li>{% else %}<li><a href="#">Facebook</a></li>{% endif %}
          {% if section.settings.social_insta != blank %}<li><a href="{{ section.settings.social_insta }}" target="_blank">Instagram</a></li>{% else %}<li><a href="#">Instagram</a></li>{% endif %}
          {% if section.settings.social_yt != blank %}<li><a href="{{ section.settings.social_yt }}" target="_blank">YouTube</a></li>{% else %}<li><a href="#">YouTube</a></li>{% endif %}
        </ul>

        <div class="vs-dribbble-badge-list">
          <a href="/pages/iso-certification" class="vs-dribbble-badge">
            {% if section.settings.iso_cert_image != blank %}
              <img src="{{ section.settings.iso_cert_image | img_url: 'small' }}" alt="ISO" loading="lazy">
            {% else %}
              <img src="{{ 'iso-certificate.jpg' | asset_url }}" alt="ISO" loading="lazy">
            {% endif %}
            <span>ISO 9001 CERTIFIED</span>
          </a>

          <div class="vs-dribbble-badge">
            {% if section.settings.startup_india_image != blank %}
              <img src="{{ section.settings.startup_india_image | img_url: 'small' }}" alt="Startup India" loading="lazy">
            {% else %}
              <img src="{{ 'startup-india.svg' | asset_url }}" alt="Startup India" loading="lazy">
            {% endif %}
            <span>STARTUP INDIA</span>
          </div>
        </div>
      </div>

      <!-- Column 4: STUDIO / CONTACT -->
      <div class="vs-dribbble-col v-anim-footer">
        <h5>STUDIO</h5>
        <div class="vs-studio-block">
          <div>
            <a href="mailto:{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}">{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}</a>
          </div>

          <div>
            <a href="tel:+918199036060">+91-8199036060</a><br>
            <a href="tel:+919053110707">+91-9053110707</a>
          </div>

          <div class="vs-studio-address">
            {{ section.settings.address | default: "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." }}
          </div>
        </div>
      </div>

    </div>

    <!-- DRIBBBLE BOTTOM STRIP -->
    <div class="vs-dribbble-bottom v-anim-footer">
      <div class="vs-dribbble-copy">
        COPYRIGHT &copy; {{ 'now' | date: "%Y" }}
      </div>

      <div class="vs-dribbble-tagline">
        <i class="fa-solid fa-sparkles"></i> WE ARE VIDHYUT SAATHI
      </div>
    </div>

  </div>
</footer>

<script>
  function initDribbbleFooterAnimations() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      const elements = document.querySelectorAll('#section-{{ section.id }} .v-anim-footer');
      gsap.fromTo(elements, 
        { y: 50, opacity: 0 },
        {
          scrollTrigger: { trigger: "#section-{{ section.id }}", start: "top 95%" },
          y: 0, opacity: 1, duration: 0.8, stagger: 0.12, ease: "power3.out", clearProps: "transform"
        }
      );
    }
  }
  document.addEventListener("DOMContentLoaded", initDribbbleFooterAnimations);
  if (window.Shopify && Shopify.designMode) { setTimeout(initDribbbleFooterAnimations, 200); }
</script>

{% schema %}
{
  "name": "Vidhyut Dribbble Footer",
  "settings": [
    { "type": "header", "content": "Brand Settings" },
    { "type": "text", "id": "address", "label": "Address", "default": "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." },
    { "type": "text", "id": "email", "label": "Email Address", "default": "info@vidhyutsaathi.com" },
    
    { "type": "header", "content": "Certifications" },
    { "type": "image_picker", "id": "iso_cert_image", "label": "ISO Certificate Image" },
    { "type": "image_picker", "id": "startup_india_image", "label": "Startup India Logo" },

    { "type": "header", "content": "Social Links" },
    { "type": "url", "id": "social_fb", "label": "Facebook URL" },
    { "type": "url", "id": "social_insta", "label": "Instagram URL" },
    { "type": "url", "id": "social_yt", "label": "YouTube URL" }
  ],
  "presets": [
    { "name": "Vidhyut Dribbble Footer" }
  ]
}
{% endschema %}