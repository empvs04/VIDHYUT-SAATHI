{%- style -%}
  .vs-footer-modern {
    background-color: {{ section.settings.bg_color | default: '#0f172a' }}; 
    color: {{ section.settings.text_color | default: '#94a3b8' }}; 
    font-family: 'Inter', 'Poppins', sans-serif;
    padding: 80px 0 30px 0;
    position: relative;
    overflow: hidden;
  }

  /* Gradient top border strip */
  .vs-footer-modern::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #f17e39, #007b3e, #3b82f6);
  }

  .vs-footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1.4fr;
    gap: 40px;
    position: relative;
    z-index: 10;
  }

  /* Column 1: Brand & Info */
  .vs-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .vs-brand-logo-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 8px 16px;
    width: fit-content;
    display: inline-block;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
  }

  .vs-brand-logo-card:hover {
    transform: translateY(-3px);
  }

  .vs-brand-logo-card img {
    width: 180px;
    height: auto;
    display: block;
  }

  .vs-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vs-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  .vs-contact-list i {
    color: #f17e39;
    margin-top: 4px;
    font-size: 1.1rem;
    width: 18px;
    text-align: center;
  }

  .vs-contact-list a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .vs-contact-list a:hover {
    color: #ffffff;
  }

  /* Link Columns */
  .vs-footer-links h4 {
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 24px;
    position: relative;
    padding-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .vs-footer-links h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 35px;
    height: 3px;
    background-color: #f17e39;
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .vs-footer-links:hover h4::after {
    width: 55px;
  }

  .vs-footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-footer-links li a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
    padding: 2px 0;
  }

  .vs-footer-links li a i {
    font-size: 0.75rem;
    margin-right: 8px;
    color: #f17e39;
    transition: transform 0.3s ease;
  }

  .vs-footer-links li a:hover {
    color: #ffffff;
    transform: translateX(5px);
  }

  .vs-footer-links li a:hover i {
    transform: translateX(3px);
  }

  /* Certifications Column */
  .vs-footer-certs h4 {
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 24px;
    position: relative;
    padding-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .vs-footer-certs h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 35px;
    height: 3px;
    background-color: #007b3e;
    border-radius: 2px;
  }

  .vs-certs-box {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vs-cert-card {
    background: rgba(255, 255, 255, 0.04);
    padding: 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    gap: 15px;
    transition: all 0.3s ease;
    backdrop-filter: blur(5px);
  }

  .vs-cert-card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-3px);
    border-color: rgba(241, 126, 57, 0.4);
  }

  .vs-cert-card img {
    width: 60px;
    height: 60px;
    object-fit: contain;
    background: #ffffff;
    border-radius: 8px;
    padding: 4px;
  }

  .vs-cert-info h5 {
    color: #ffffff;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .vs-cert-info p {
    color: #94a3b8;
    margin: 4px 0 0 0;
    font-size: 0.8rem;
  }

  /* Footer Bottom */
  .vs-footer-bottom {
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1300px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
    padding-right: 2rem;
    flex-wrap: wrap;
    gap: 15px;
  }

  .vs-copyright {
    font-size: 0.9rem;
    color: #64748b;
  }

  .vs-social-links {
    display: flex;
    gap: 12px;
  }

  .vs-social-links a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .vs-social-links a:hover {
    background: #f17e39;
    color: #ffffff;
    transform: translateY(-3px);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .vs-footer-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 640px) {
    .vs-footer-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .vs-footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

