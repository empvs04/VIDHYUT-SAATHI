<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  /* ================= ELEGANT MODERN FOOTER ================= */
  .vs-footer-root {
    background-color: #0b1120;
    color: #94a3b8;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    padding: 60px 0 0 0;
    position: relative;
    border-top: 3px solid #f17e39;
    -webkit-tap-highlight-color: transparent;
  }

  .vs-footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Main 4-Column Layout */
  .vs-footer-grid {
    display: grid;
    grid-template-columns: 2.2fr 1.1fr 1.2fr 1.3fr;
    gap: 36px;
    padding-bottom: 50px;
  }

  /* Column 1: Brand Info & Contact */
  .vs-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .vs-brand-logo-wrapper {
    background: #ffffff;
    padding: 10px 18px;
    border-radius: 12px;
    display: inline-block;
    width: fit-content;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  .vs-brand-logo-wrapper img {
    height: 42px;
    width: auto;
    display: block;
  }

  .vs-brand-logo-fallback {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f17e39;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .vs-brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  .vs-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .vs-contact-list i {
    color: #f17e39;
    font-size: 1rem;
    margin-top: 3px;
    flex-shrink: 0;
    width: 18px;
    text-align: center;
  }

  .vs-contact-list a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .vs-contact-list a:hover {
    color: #ffffff;
  }

  /* Column Headings */
  .vs-footer-title {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .vs-footer-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 32px;
    height: 3px;
    background-color: #f17e39;
    border-radius: 2px;
  }

  /* Navigation Links */
  .vs-footer-nav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vs-footer-nav a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    transition: all 0.3s ease;
  }

  .vs-footer-nav a i {
    font-size: 0.7rem;
    color: #f17e39;
    transition: transform 0.3s ease;
  }

  .vs-footer-nav a:hover {
    color: #ffffff;
    transform: translateX(5px);
  }

  .vs-footer-nav a:hover i {
    transform: translateX(3px);
  }

  /* Required Cards Badge Tag */
  .vs-req-badge {
    background: rgba(241, 126, 57, 0.15);
    color: #f17e39;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 6px;
    border: 1px solid rgba(241, 126, 57, 0.3);
  }

  /* Certifications Column */
  .vs-cert-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vs-cert-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .vs-cert-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(241, 126, 57, 0.4);
    transform: translateY(-2px);
  }

  .vs-cert-img-holder {
    width: 48px;
    height: 48px;
    background: #ffffff;
    border-radius: 8px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .vs-cert-img-holder img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .vs-cert-details h5 {
    color: #ffffff;
    margin: 0 0 3px 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .vs-cert-details span {
    color: #4ade80;
    font-size: 0.76rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Bottom Bar */
  .vs-footer-bottom {
    background-color: #070c18;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px 0;
  }

  .vs-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .vs-copyright-info {
    font-size: 0.88rem;
    color: #64748b;
  }

  .vs-social-links {
    display: flex;
    gap: 10px;
  }

  .vs-social-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .vs-social-icon:hover {
    background: #f17e39;
    border-color: #f17e39;
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .vs-footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 640px) {
    .vs-footer-root {
      padding-top: 40px;
    }
    .vs-footer-grid {
      grid-template-columns: 1fr;
      gap: 26px;
      padding-bottom: 30px;
    }
    .vs-bottom-flex {
      flex-direction: column;
      text-align: center;
    }
    .vs-social-links {
      justify-content: center;
    }
  }
{%- endstyle -%}

