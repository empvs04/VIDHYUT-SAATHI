          <h4 class="vs-section-heading"><i class="fa-solid fa-compass"></i> Quick Navigation</h4>
          <div class="vs-nav-pill-cloud">
            <a href="/" class="vs-nav-tag"><i class="fa-solid fa-house"></i> Home</a>
