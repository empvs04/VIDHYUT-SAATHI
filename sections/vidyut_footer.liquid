        <h4 class="vs-footer-title">Useful Links</h4>
        <ul class="vs-footer-nav">
          <li><a href="/"><i class="fa-solid fa-chevron-right"></i> Home</a></li>
          <li><a href="/pages/about-us"><i class="fa-solid fa-chevron-right"></i> About Us</a></li>
          <li><a href="/pages/b2c"><i class="fa-solid fa-chevron-right"></i> Why Vidhyut Saathi</a></li>
          <li><a href="/policies/privacy-policy"><i class="fa-solid fa-chevron-right"></i> Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service"><i class="fa-solid fa-chevron-right"></i> Terms &amp; Conditions</a></li>
