<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  .vs-footer-wrapper {
    background-color: {{ section.settings.bg_color | default: '#fff8ef' }}; 
    color: {{ section.settings.text_color | default: '#0f172a' }}; 
    font-family: 'Poppins', sans-serif;
    padding: 80px 5% 40px;
    border-top: 4px solid {{ section.settings.primary_color | default: '#F17E39' }};
    overflow: hidden;
    position: relative;
    z-index: 10;
  }

  .vs-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1.2fr 1.4fr;
    gap: 30px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  /* STABLE 3D HOVER CARD LAYOUT */
  .footer-col-box {
    background: #ffffff; 
    padding: 30px;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06); 
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  
  .footer-col-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(241, 126, 57, 0.12);
    border-color: {{ section.settings.primary_color | default: '#F17E39' }}; 
    z-index: 5;
  }

  .footer-brand-logo-pill {
    background: #ffffff;
    padding: 6px 12px;
    border-radius: 10px;
    display: inline-block;
    margin-bottom: 16px;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .footer-brand img {
    width: 100%;
    max-width: 180px; 
    height: auto; 
    display: block;
  }

  .footer-brand p {
    color: #64748b; 
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .footer-col-box h4 {
    color: #0f172a; 
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    margin-top: 0;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 8px;
  }

  .footer-col-box h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 30px;
    height: 3px;
    background: {{ section.settings.primary_color | default: '#F17E39' }};
    border-radius: 2px;
  }

  /* LINK STYLING */
  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #64748b; 
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: all 0.3s ease;
    padding: 4px 0;
  }

  .footer-link i {
    font-size: 0.75rem;
    color: {{ section.settings.primary_color | default: '#F17E39' }};
    transition: transform 0.3s ease;
  }

  .footer-link:hover {
    color: {{ section.settings.primary_color | default: '#F17E39' }}; 
    transform: translateX(6px); 
  }

  .footer-link:hover i {
    transform: translateX(3px);
  }

  /* CONTACT LINKS */
  .contact-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-link {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #64748b;
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.5;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .contact-link i { 
    color: {{ section.settings.primary_color | default: '#F17E39' }}; 
    margin-top: 4px; 
    font-size: 1.1rem;
    flex-shrink: 0;
    width: 18px;
  }
  
  .contact-link:hover { 
    color: {{ section.settings.secondary_color | default: '#007B3E' }}; 
    transform: translateX(4px); 
  }

  /* CERTIFICATIONS BOXES */
  .footer-certs-stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-cert-card {
    background: #f8fafc;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .footer-cert-card:hover {
    border-color: {{ section.settings.primary_color | default: '#F17E39' }};
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
  }

  .footer-cert-img {
    width: 48px;
    height: 48px;
    background: #ffffff;
    border-radius: 8px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .footer-cert-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .footer-cert-info h5 {
    color: #0f172a;
    margin: 0 0 2px 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .footer-cert-info span {
    color: #007b3e;
    font-size: 0.78rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* BOTTOM BAR */
  .footer-bottom {
    max-width: 1400px;
    margin: 50px auto 0;
    padding-top: 25px;
    border-top: 1px solid rgba(0, 0, 0, 0.08); 
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    position: relative;
    z-index: 10;
  }

  .copyright { color: #64748b; font-size: 0.9rem; font-weight: 500; }
  
  .social-icons { display: flex; gap: 12px; }
  .social-icons a { 
    color: #0f172a; 
    font-size: 1.1rem; 
    transition: all 0.3s ease; 
    width: 40px; height: 40px;
    background: #ffffff; 
    border: 1px solid rgba(0,0,0,0.08);
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
  }
  .social-icons a:hover { 
    color: #ffffff; 
    background: {{ section.settings.primary_color | default: '#F17E39' }}; 
    transform: translateY(-4px); 
    box-shadow: 0 10px 20px rgba(241, 126, 57, 0.3);
  }

  /* MOBILE RESPONSIVE */
  @media (max-width: 1024px) {
    .vs-footer-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .vs-footer-wrapper { padding: 50px 5% 30px; }
    .vs-footer-grid { grid-template-columns: 1fr; gap: 20px; }
    .footer-col-box { padding: 24px 20px; }
    .footer-bottom { flex-direction: column; text-align: center; }
    .social-icons { justify-content: center; }
  }
{%- endstyle -%}

