<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  /* ================= DRIBBBLE AGENCY DISPLAY FOOTER ================= */
  .vs-agency-footer {
    background-color: #080808;
    color: #a1a1aa;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    padding: 80px 0 30px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid #18181b;
    -webkit-tap-highlight-color: transparent;
  }

  .vs-agency-container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 5;
  }

  /* GIANT DISPLAY WORDMARK (Dribbble Style) */
  .vs-giant-wordmark-wrap {
    width: 100%;
    text-align: center;
    margin-bottom: 70px;
    user-select: none;
    overflow: hidden;
  }

  .vs-giant-wordmark {
    font-size: clamp(3.2rem, 11vw, 10.5rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #f4f4f5;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
  }

  .vs-wordmark-primary {
    color: #fafafa;
    font-family: 'Inter', sans-serif;
  }

  .vs-wordmark-accent {
    color: #f17e39;
    font-weight: 900;
  }

  .vs-wordmark-sub {
    font-size: clamp(1rem, 2.5vw, 1.8rem);
    letter-spacing: 4px;
    font-weight: 700;
    color: #71717a;
    text-transform: uppercase;
    display: block;
    margin-top: 15px;
  }

  /* Main Grid below Wordmark */
  .vs-agency-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr 1.3fr 1.8fr;
    gap: 40px;
    padding-top: 20px;
    padding-bottom: 60px;
    border-top: 1px solid #27272a;
  }

  .vs-agency-col h5 {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 24px 0;
  }

  .vs-agency-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-agency-links a {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
  }

  .vs-agency-links a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  /* Highlighted Required Cards Link */
  .vs-agency-req-card {
    color: #f17e39 !important;
    font-weight: 700 !important;
  }

  .vs-agency-req-card span {
    background: #f17e39;
    color: #000000;
    font-size: 0.68rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 900;
  }

  /* Certifications List (Agency Style) */
  .vs-agency-certs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vs-agency-cert-item {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: #e4e4e7;
    background: #121215;
    border: 1px solid #27272a;
    padding: 12px 16px;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .vs-agency-cert-item:hover {
    border-color: #f17e39;
    background: #18181b;
    transform: translateY(-2px);
  }

  .vs-agency-cert-img {
    width: 44px;
    height: 44px;
    background: #ffffff;
    border-radius: 8px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vs-agency-cert-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .vs-agency-cert-text strong {
    display: block;
    font-size: 0.9rem;
    color: #ffffff;
    font-weight: 700;
  }

  .vs-agency-cert-text span {
    font-size: 0.75rem;
    color: #22c55e;
    font-weight: 600;
  }

  /* Contact Details Column */
  .vs-contact-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.95rem;
  }

  .vs-contact-line {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.5;
  }

  .vs-contact-line i {
    color: #f17e39;
    margin-top: 4px;
    font-size: 1rem;
    width: 18px;
  }

  .vs-contact-line a {
    color: #e4e4e7;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .vs-contact-line a:hover {
    color: #ffffff;
  }

  /* Agency Bottom Strip */
  .vs-agency-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid #18181b;
  }

  .vs-copyright {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #71717a;
  }

  .vs-agency-socials {
    display: flex;
    gap: 20px;
  }

  .vs-agency-socials a {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .vs-agency-socials a:hover {
    color: #f17e39;
  }

  .vs-agency-tagline {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #f17e39;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .vs-agency-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px;
    }
  }

  @media (max-width: 640px) {
    .vs-agency-footer {
      padding: 50px 0 25px 0;
    }
    .vs-agency-container {
      padding: 0 1.2rem;
    }
    .vs-giant-wordmark-wrap {
      margin-bottom: 40px;
    }
    .vs-giant-wordmark {
      flex-direction: column;
      gap: 0;
    }
    .vs-agency-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .vs-agency-bottom {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
    .vs-agency-socials {
      justify-content: center;
    }
  }
{%- endstyle -%}

<footer class="vs-agency-footer" id="section-{{ section.id }}">
  <div class="vs-agency-container">
    
    <!-- GIANT AGENCY DISPLAY WORDMARK -->
    <div class="vs-giant-wordmark-wrap v-anim-footer">
      <h1 class="vs-giant-wordmark">
        <span class="vs-wordmark-primary">VIDHYUT</span>
        <span class="vs-wordmark-accent">SAATHI</span>
      </h1>
      <span class="vs-wordmark-sub">ENERGY SAVERS PVT. LIMITED</span>
    </div>

    <!-- 4-COLUMN MINIMALIST AGENCY GRID -->
    <div class="vs-agency-grid">
      
      <!-- Column 1: Useful Links -->
      <div class="vs-agency-col v-anim-footer">
        <h5>Useful Links</h5>
        <ul class="vs-agency-links">
          <li><a href="/">Home</a></li>
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/b2c">Why Vidhyut Saathi</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms &amp; Conditions</a></li>
          <li><a href="/pages/disclaimer">Disclaimer</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 2: Our Solutions -->
      <div class="vs-agency-col v-anim-footer">
        <h5>Our Solutions</h5>
        <ul class="vs-agency-links">
          <li><a href="/products/vidhyut-saathi-electric-power-saver-card">Vidhyut Saathi Card</a></li>
          <li>
            <a href="/pages/required-cards" class="vs-agency-req-card">
              Required Cards <span>HOT</span>
            </a>
          </li>
          <li><a href="/pages/b2c">Fuel Saving Saathi</a></li>
          <li><a href="/products/vidhyut-saathi-electric-power-saver-card">Get Card</a></li>
          <li><a href="/pages/contact">Get Franchise</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: Recognitions -->
      <div class="vs-agency-col v-anim-footer">
        <h5>Recognitions</h5>
        <div class="vs-agency-certs">
          
          <a href="/pages/iso-certification" class="vs-agency-cert-item">
            <div class="vs-agency-cert-img">
              {% if section.settings.iso_cert_image != blank %}
                <img src="{{ section.settings.iso_cert_image | img_url: 'medium' }}" alt="ISO Certification" loading="lazy">
              {% else %}
                <img src="{{ 'iso-certificate.jpg' | asset_url }}" alt="ISO Certification" loading="lazy">
              {% endif %}
            </div>
            <div class="vs-agency-cert-text">
              <strong>ISO 9001 Certified</strong>
              <span>✓ Quality Guaranteed</span>
            </div>
          </a>

          <div class="vs-agency-cert-item">
            <div class="vs-agency-cert-img">
              {% if section.settings.startup_india_image != blank %}
                <img src="{{ section.settings.startup_india_image | img_url: 'medium' }}" alt="Startup India" loading="lazy">
              {% else %}
                <img src="{{ 'startup-india.svg' | asset_url }}" alt="Startup India" loading="lazy">
              {% endif %}
            </div>
            <div class="vs-agency-cert-text">
              <strong>Startup India</strong>
              <span>✓ Govt. Recognized</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Column 4: Contact & Studio Info -->
      <div class="vs-agency-col v-anim-footer">
        <h5>Contact &amp; Studio</h5>
        <div class="vs-contact-block">
          <div class="vs-contact-line">
            <i class="fa-solid fa-envelope"></i>
            <a href="mailto:{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}">{{ section.settings.email | default: 'info@vidhyutsaathi.com' }}</a>
          </div>

          <div class="vs-contact-line">
            <i class="fa-solid fa-phone"></i>
            <div>
              <a href="tel:+918199036060">+91-8199036060</a><br>
              <a href="tel:+919053110707">+91-9053110707</a>
            </div>
          </div>

          <div class="vs-contact-line">
            <i class="fa-solid fa-location-dot"></i>
            <span>{{ section.settings.address | default: "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." }}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- AGENCY BOTTOM STRIP -->
    <div class="vs-agency-bottom v-anim-footer">
      <div class="vs-copyright">
        Copyright &copy; {{ 'now' | date: "%Y" }} Vidhyut Saathi
      </div>

      <div class="vs-agency-socials">
        {% if section.settings.social_fb != blank %}<a href="{{ section.settings.social_fb }}" target="_blank">Facebook</a>{% endif %}
        {% if section.settings.social_insta != blank %}<a href="{{ section.settings.social_insta }}" target="_blank">Instagram</a>{% endif %}
        {% if section.settings.social_yt != blank %}<a href="{{ section.settings.social_yt }}" target="_blank">YouTube</a>{% endif %}
      </div>

      <div class="vs-agency-tagline">
        <i class="fa-solid fa-bolt"></i> 20,000 ION TECH
      </div>
    </div>

  </div>
</footer>

<script>
  function initAgencyFooterAnimations() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      const elements = document.querySelectorAll('#section-{{ section.id }} .v-anim-footer');
      gsap.fromTo(elements, 
        { y: 40, opacity: 0 },
        {
          scrollTrigger: { trigger: "#section-{{ section.id }}", start: "top 95%" },
          y: 0, opacity: 1, duration: 0.8, stagger: 0.12, ease: "power3.out", clearProps: "transform"
        }
      );
    }
  }
  document.addEventListener("DOMContentLoaded", initAgencyFooterAnimations);
  if (window.Shopify && Shopify.designMode) { setTimeout(initAgencyFooterAnimations, 200); }
</script>

{% schema %}
{
  "name": "Vidhyut Display Footer",
  "settings": [
    { "type": "header", "content": "Brand Settings" },
    { "type": "text", "id": "address", "label": "Address", "default": "SCO-77A, 3rd Floor, Ashoka Complex, Delhi Road Rohtak - 124001, Haryana." },
    { "type": "text", "id": "email", "label": "Email Address", "default": "info@vidhyutsaathi.com" },
    
    { "type": "header", "content": "Certifications" },
    { "type": "image_picker", "id": "iso_cert_image", "label": "ISO Certificate Image" },
    { "type": "image_picker", "id": "startup_india_image", "label": "Startup India Logo" },

    { "type": "header", "content": "Social Links" },
    { "type": "url", "id": "social_fb", "label": "Facebook URL" },
    { "type": "url", "id": "social_insta", "label": "Instagram URL" },
    { "type": "url", "id": "social_yt", "label": "YouTube URL" }
  ],
  "presets": [
    { "name": "Vidhyut Display Footer" }
  ]
}
{% endschema %}