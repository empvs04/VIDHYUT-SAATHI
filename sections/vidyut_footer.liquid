      <h4>Important Links</h4>
      <ul class="footer-link-list">
        <li><a href="/products/vidhyut-saathi-electric-power-saver-card" class="footer-link"><i class="fas fa-chevron-right"></i> Vidhyut Saathi Card</a></li>
        <li><a href="/pages/required-cards" class="footer-link" style="color:#F17E39; font-weight:700;"><i class="fas fa-bolt"></i> Required Cards</a></li>
