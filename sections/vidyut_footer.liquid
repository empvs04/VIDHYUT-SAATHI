<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Syne:wght@800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  /* ================= DRIBBBLE CUSTOM LIQUID WORDMARK FOOTER ================= */
  .vs-dribbble-footer {
    background-color: #000000;
    color: #a1a1aa;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    padding: 70px 0 40px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid #141414;
    -webkit-tap-highlight-color: transparent;
  }

  .vs-dribbble-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 5;
  }

  /* CUSTOM LIQUID GRAPHIC WORDMARK ARTWORK (EXACT MAGIC PEOPLE REPLICA) */
  .vs-magic-wordmark-container {
    width: 100%;
    margin-bottom: 50px;
    position: relative;
    user-select: none;
  }

  .vs-liquid-svg-artwork {
    width: 100%;
    height: auto;
    display: block;
    max-height: 480px;
    filter: drop-shadow(0 10px 30px rgba(0,0,0,0.5));
  }

  /* 4 MINIMALIST COLUMNS (EXACT DRIBBBLE LAYOUT BELOW WORDMARK) */
  .vs-dribbble-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.4fr;
    gap: 40px;
    padding-top: 50px;
    padding-bottom: 60px;
    border-top: 1px solid #1a1a1a;
  }

  .vs-dribbble-col h5 {
    font-family: 'Syne', sans-serif;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    margin: 0 0 22px 0;
  }

  .vs-dribbble-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-dribbble-links a {
    color: #71717a;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
  }

  .vs-dribbble-links a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  /* Highlighted Required Cards Link */
  .vs-req-card-link {
    color: #f17e39 !important;
  }

  .vs-req-card-link span {
    background: #f17e39;
    color: #000000;
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 900;
  }

  /* Studio / Contact Block (Exact Dribbble Style) */
  .vs-studio-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.85rem;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .vs-studio-block a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .vs-studio-block a:hover {
    color: #f17e39;
  }

  .vs-studio-address {
    color: #71717a;
    font-size: 0.8rem;
    line-height: 1.6;
    margin-top: 4px;
    text-transform: uppercase;
  }

  /* Recognition Badges in Column 3 */
  .vs-dribbble-badge-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 15px;
  }

  .vs-dribbble-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0d0d0d;
    border: 1px solid #27272a;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    width: fit-content;
    transition: all 0.3s ease;
  }

  .vs-dribbble-badge:hover {
    border-color: #f17e39;
    transform: translateY(-2px);
  }

  .vs-dribbble-badge img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    background: #ffffff;
    border-radius: 4px;
    padding: 2px;
  }

  /* DRIBBBLE BOTTOM STRIP */
  .vs-dribbble-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid #141414;
  }

  .vs-dribbble-copy {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #52525b;
  }

  .vs-dribbble-tagline {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #e4e4e7;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vs-dribbble-tagline i {
    color: #f17e39;
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .vs-dribbble-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .vs-dribbble-footer {
      padding: 40px 0 25px 0;
    }
    .vs-dribbble-container {
      padding: 0 1rem;
    }
    .vs-magic-wordmark-container {
      margin-bottom: 30px;
    }
    .vs-dribbble-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .vs-dribbble-bottom {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
  }
{%- endstyle -%}

