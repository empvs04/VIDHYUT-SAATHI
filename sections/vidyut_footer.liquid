      </div>

      <!-- Card 2: Quick Links -->
      <div class="vs-bento-dock-card v-anim-footer">
        <h4 class="vs-dock-card-title">Quick Links</h4>
        <ul class="vs-dock-links">
          <li><a href="/"><i class="fa-solid fa-chevron-right"></i> Home Page</a></li>
