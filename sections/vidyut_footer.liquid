<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- style -%}
  /* ================= SLEEK ACCENT FOOTER ================= */
  .vs-sleek-footer {
    background-color: #0b1120;
    color: #94a3b8;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    padding: 70px 0 0 0;
    position: relative;
    border-top: 1px solid #1e293b;
    -webkit-tap-highlight-color: transparent;
  }

  /* Glowing Accent Top Bar */
  .vs-sleek-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f17e39 0%, #007b3e 50%, #3b82f6 100%);
  }

  .vs-footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Main Grid */
  .vs-footer-main-grid {
    display: grid;
    grid-template-columns: 2.2fr 1.1fr 1.2fr 1.3fr;
    gap: 40px;
    padding-bottom: 50px;
  }

  /* Brand Column */
  .vs-brand-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .vs-brand-logo-box {
    background: #ffffff;
    padding: 10px 18px;
    border-radius: 14px;
    display: inline-block;
    width: fit-content;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  .vs-brand-logo-box img {
    height: 40px;
    width: auto;
    display: block;
  }

  .vs-brand-logo-fallback {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f17e39;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .vs-live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 123, 62, 0.12);
    border: 1px solid rgba(0, 123, 62, 0.3);
    color: #4ade80;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    width: fit-content;
  }

  .vs-pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 10px #22c55e;
    animation: vsPulse 2s infinite;
  }

  @keyframes vsPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  .vs-info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .vs-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 0.93rem;
    line-height: 1.5;
  }

  .vs-info-list i {
    color: #f17e39;
    font-size: 1.1rem;
    margin-top: 3px;
    flex-shrink: 0;
    width: 20px;
    text-align: center;
  }

  .vs-info-list a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .vs-info-list a:hover {
    color: #ffffff;
  }

  /* Columns Headings */
  .vs-col-title {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 22px;
    position: relative;
    padding-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .vs-col-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 30px;
    height: 3px;
    background: #f17e39;
    border-radius: 2px;
  }

  /* Links List */
  .vs-nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vs-nav-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.93rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    transition: all 0.3s ease;
  }

  .vs-nav-links a i {
    font-size: 0.7rem;
    color: #f17e39;
    transition: transform 0.3s ease;
  }

  .vs-nav-links a:hover {
    color: #ffffff;
    transform: translateX(6px);
  }

  .vs-nav-links a:hover i {
    transform: translateX(4px);
  }

  /* Highlighted Link Pill */
  .vs-highlight-link {
    background: rgba(241, 126, 57, 0.12);
    border: 1px solid rgba(241, 126, 57, 0.3);
    color: #f17e39 !important;
    padding: 6px 12px !important;
    border-radius: 8px;
    margin-top: 4px;
    width: fit-content;
  }

  .vs-highlight-link:hover {
    background: #f17e39;
    color: #ffffff !important;
  }

  .vs-highlight-link:hover i {
    color: #ffffff !important;
  }

  /* Certifications Showcase */
  .vs-cert-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .vs-cert-card-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .vs-cert-card-item:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(0, 123, 62, 0.5);
    transform: translateY(-3px);
  }

  .vs-cert-img-box {
    width: 54px;
    height: 54px;
    background: #ffffff;
    border-radius: 10px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vs-cert-img-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .vs-cert-info h5 {
    color: #ffffff;
    margin: 0 0 4px 0;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .vs-cert-info span {
    color: #4ade80;
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Bottom Bar */
  .vs-footer-bottom-bar {
    background: #070c18;
    border-top: 1px solid #1e293b;
    padding: 24px 0;
  }

  .vs-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .vs-copy-text {
    font-size: 0.88rem;
    color: #64748b;
  }

  .vs-social-row {
    display: flex;
    gap: 12px;
  }

  .vs-social-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .vs-social-btn:hover {
    background: #f17e39;
    border-color: #f17e39;
    color: #ffffff;
    transform: translateY(-3px);
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .vs-footer-main-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 640px) {
    .vs-sleek-footer {
      padding-top: 45px;
    }
    .vs-footer-main-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 35px;
    }
    .vs-bottom-content {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

