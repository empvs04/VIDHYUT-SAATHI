              <span><i class="fa-solid fa-circle-check"></i> Govt. Recognized</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- BOTTOM STRIP -->
    <div class="vs-dock-bottom-strip v-anim-footer">
      <div class="vs-dock-copy">
        &copy; {{ 'now' | date: "%Y" }} <strong>Vidhyut Saathi Energy Savers</strong>. All rights reserved.
      </div>
      <div class="vs-dock-socials">
        {% if section.settings.social_fb != blank %}<a href="{{ section.settings.social_fb }}" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>{% else %}<a href="https://facebook.com" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>{% endif %}
        {% if section.settings.social_insta != blank %}<a href="{{ section.settings.social_insta }}" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>{% else %}<a href="https://instagram.com" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>{% endif %}
        {% if section.settings.social_yt != blank %}<a href="{{ section.settings.social_yt }}" target="_blank" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>{% else %}<a href="https://youtube.com" target="_blank" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>{% endif %}
      </div>
      <div class="vs-dock-status-tag">
        <i class="fa-solid fa-shield-halved"></i> 100% Result Guaranteed
      </div>
    </div>

  </div>
</footer>

<script>
  function initDockFooterAnimations() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      const elements = document.querySelectorAll('#section-{{ section.id }} .v-anim-footer');
      gsap.fromTo(elements, 
        { y: 35, opacity: 0 },
        {
          scrollTrigger: { trigger: "#section-{{ section.id }}", start: "top 95%" },
          y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: "power2.out", clearProps: "transform"
        }
      );
    }
  }
  document.addEventListener("DOMContentLoaded", initDockFooterAnimations);
  if (window.Shopify && Shopify.designMode) { setTimeout(initDockFooterAnimations, 200); }
</script>

