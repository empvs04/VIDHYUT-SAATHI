{
  "name": "Vidhyut Blog Page",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero Eyebrow Badge",
      "default": "Vidhyut Saathi Knowledge Hub"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title (use <span> for highlight)",
      "default": "Insights on Energy Savings"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Expert articles, franchise success stories, and tips to lower electricity bills across India."
    }
  ],
  "presets": [
    {
      "name": "Vidhyut Blog Page"
    }
  ]
}
