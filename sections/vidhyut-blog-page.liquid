<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ============================================
     VIDHYUT SAATHI - PURE LIGHT THEME BLOG PAGE
     Theme: #fff8ef light bg | #ffffff cards | #ec5c0a orange | #007b3e green | #0f172a slate text
  ============================================= */

  .vsblog-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  *, *::before, *::after { box-sizing: border-box; }

  /* ─── LIGHT HERO BANNER ─── */
  .vsblog-hero {
    position: relative;
    background: linear-gradient(135deg, #ffffff 0%, #fff4e8 50%, #fff8ef 100%);
    padding: clamp(65px, 9vw, 110px) 20px;
    overflow: hidden;
    text-align: center;
    border-bottom: 2px solid rgba(236, 92, 10, 0.12);
  }

  .vsblog-hero-orbs::before {
    content: '';
    position: absolute;
    top: -100px;
    left: -100px;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-hero-orbs::after {
    content: '';
    position: absolute;
    bottom: -120px;
    right: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-hero-circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.15;
    pointer-events: none;
  }

  .vsblog-hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
  }

  .vsblog-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff0e5;
    border: 1.5px solid #ec5c0a;
    color: #ec5c0a;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 7px 20px;
    border-radius: 50px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.1);
  }

  .vsblog-hero h1 {
    font-size: clamp(28px, 5.8vw, 54px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.18;
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .vsblog-hero h1 span {
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsblog-hero-desc {
    color: #475569;
    font-size: clamp(14px, 2.2vw, 17px);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 30px auto;
  }

  /* Breadcrumb */
  .vsblog-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
  }

  .vsblog-breadcrumb a {
    color: #475569;
    text-decoration: none;
    transition: color 0.2s;
  }

  .vsblog-breadcrumb a:hover { color: #ec5c0a; }
  .vsblog-breadcrumb .sep { color: #cbd5e1; }
  .vsblog-breadcrumb .cur { color: #ec5c0a; font-weight: 800; }

  /* ─── STATS STRIP ─── */
  .vsblog-stats-strip {
    background: #ffffff;
    border-bottom: 2px solid rgba(236, 92, 10, 0.1);
    padding: 0 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .vsblog-stats-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .vsblog-stat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    border-right: 1px solid #f1f5f9;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }

  .vsblog-stat-item:last-child { border-right: none; }
  .vsblog-stat-item i { color: #ec5c0a; font-size: 17px; }
  .vsblog-stat-item strong { color: #0f172a; font-size: 15px; font-weight: 800; }

  @media (max-width: 640px) {
    .vsblog-stat-item { padding: 12px 14px; font-size: 12px; }
  }

  /* ─── MAIN BODY ─── */
  .vsblog-body {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(30px, 5vw, 60px) 16px;
  }

  /* ─── CATEGORY FILTER BAR & SEARCH ─── */
  .vsblog-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 38px;
    padding-bottom: 22px;
    border-bottom: 2px solid #f1f5f9;
  }

  .vsblog-filter-label {
    font-size: 13px;
    font-weight: 800;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vsblog-filter-label i { color: #ec5c0a; }

  .vsblog-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex-grow: 1;
  }

  .vsblog-cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 50px;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
    user-select: none;
  }

  .vsblog-cat-btn:hover,
  .vsblog-cat-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.3);
  }

  .vsblog-search {
    display: flex;
    position: relative;
    min-width: 240px;
  }

  .vsblog-search input {
    width: 100%;
    height: 44px;
    padding: 0 44px 0 18px;
    border: 1.5px solid #e2e8f0;
    border-radius: 50px;
    background: #ffffff;
    font-size: 13px;
    font-family: inherit;
    color: #0f172a;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .vsblog-search input:focus {
    border-color: #ec5c0a;
    box-shadow: 0 0 0 3px rgba(236, 92, 10, 0.12);
  }

  .vsblog-search button {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #ec5c0a;
    cursor: pointer;
    font-size: 15px;
    padding: 0;
  }

  /* ─── FEATURED ARTICLE ─── */
  .vsblog-featured { margin-bottom: 48px; }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ec5c0a;
    margin-bottom: 18px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.4), transparent);
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    cursor: pointer;
  }

  @media (min-width: 860px) {
    .vsblog-feat-card { grid-template-columns: 1.15fr 1fr; }
  }

  .vsblog-feat-card:hover {
    box-shadow: 0 22px 55px rgba(236, 92, 10, 0.14);
    transform: translateY(-4px);
  }

  .vsblog-feat-img {
    position: relative;
    min-height: 300px;
    overflow: hidden;
  }

  @media (min-width: 860px) {
    .vsblog-feat-img { min-height: 420px; }
  }

  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fff7ed 0%, #ffede0 100%);
  }

  .vsblog-feat-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: #ec5c0a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 5px 14px;
    border-radius: 50px;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.3);
  }

  .vsblog-feat-content {
    padding: clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  .vsblog-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #007b3e;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
    background: rgba(0, 123, 62, 0.08);
    padding: 5px 12px;
    border-radius: 6px;
    width: fit-content;
  }

  .vsblog-feat-content h2 {
    font-size: clamp(18px, 3.2vw, 28px);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    margin: 0 0 14px 0;
  }

  .vsblog-feat-content p {
    color: #64748b;
    line-height: 1.65;
    font-size: clamp(13px, 1.6vw, 15px);
    margin: 0 0 22px 0;
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    font-weight: 600;
  }

  .vsblog-meta-chip i { color: #ec5c0a; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 26px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    width: fit-content;
    transition: all 0.28s ease;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.35);
  }

  .vsblog-read-btn:hover {
    transform: translateX(4px);
    box-shadow: 0 10px 26px rgba(236, 92, 10, 0.5);
  }

  /* ─── TWO-COL GRID + SIDEBAR ─── */
  .vsblog-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 1040px) {
    .vsblog-two-col { grid-template-columns: 1fr 340px; }
  }

  /* ARTICLE GRID */
  .vsblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 620px) {
    .vsblog-grid { grid-template-columns: 1fr 1fr; }
  }

  .vsblog-card {
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.04);
    border: 1.5px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .vsblog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
    border-color: rgba(236, 92, 10, 0.3);
  }

  .vsblog-card-img {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .vsblog-thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsblog-card-cat-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #ffffff;
    color: #ec5c0a;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 4px 12px;
    border-radius: 50px;
    z-index: 2;
    border: 1px solid rgba(236, 92, 10, 0.3);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .vsblog-card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .vsblog-card-title {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.4;
    margin: 0 0 10px 0;
    text-decoration: none;
    display: block;
    transition: color 0.2s;
    cursor: pointer;
  }

  .vsblog-card-title:hover { color: #ec5c0a; }

  .vsblog-card-excerpt {
    font-size: 13px;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 18px 0;
    flex-grow: 1;
  }

  .vsblog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
    gap: 10px;
  }

  .vsblog-card-date {
    font-size: 11.5px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: 600;
  }

  .vsblog-card-date i { color: #ec5c0a; font-size: 12px; }

  .vsblog-card-btn {
    font-size: 12.5px;
    font-weight: 800;
    color: #ec5c0a;
    background: rgba(236, 92, 10, 0.08);
    border: 1px solid rgba(236, 92, 10, 0.2);
    padding: 6px 14px;
    border-radius: 50px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.25s ease;
  }

  .vsblog-card-btn:hover {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.3);
  }

  /* ─── SIDEBAR ─── */
  .vsblog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .vsblog-sidebar-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
    border: 1.5px solid #f1f5f9;
  }

  .vsblog-sidebar-heading {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .vsblog-sidebar-heading i { color: #ec5c0a; }

  .vsblog-sidebar-post {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid #f8fafc;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .vsblog-sidebar-post:last-child { border-bottom: none; padding-bottom: 0; }
  .vsblog-sidebar-post:hover { opacity: 0.78; }

  .vsblog-sidebar-post-num {
    width: 28px;
    height: 28px;
    background: rgba(236, 92, 10, 0.1);
    color: #ec5c0a;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .vsblog-sidebar-post-info h4 {
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px 0;
    line-height: 1.4;
  }

  .vsblog-sidebar-post-info span {
    font-size: 11px;
    color: #94a3b8;
  }

  .vsblog-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vsblog-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 14px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .vsblog-tag-pill:hover {
    background: #ec5c0a;
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.25);
  }

  /* LIGHT SIDEBAR FRANCHISE CTA CARD */
  .vsblog-sidebar-cta {
    background: linear-gradient(135deg, #fff7ed 0%, #ffe8d6 100%);
    border-radius: 18px;
    padding: 26px;
    text-align: center;
    border: 1.5px solid #ec5c0a;
    position: relative;
    overflow: hidden;
  }

  .vsblog-sidebar-cta::before {
    content: '';
    position: absolute;
    top: -30px;
    right: -30px;
    width: 130px;
    height: 130px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.2) 0%, transparent 70%);
    border-radius: 50%;
  }

  .vsblog-sidebar-cta-icon {
    width: 52px;
    height: 52px;
    background: #ffffff;
    border: 1.5px solid #ec5c0a;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: #ec5c0a;
    margin: 0 auto 14px auto;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 12px rgba(236, 92, 10, 0.15);
  }

  .vsblog-sidebar-cta h3 {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta p {
    font-size: 12.5px;
    color: #475569;
    line-height: 1.5;
    margin: 0 0 20px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.4);
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .vsblog-sidebar-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(236, 92, 10, 0.55);
  }

  /* ─── NEWSLETTER SECTION ─── */
  .vsblog-newsletter {
    margin-top: 60px;
    background: linear-gradient(135deg, #ffffff 0%, #fff7ed 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    border-radius: 24px;
    padding: clamp(40px, 6vw, 70px) 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.04);
  }

  .vsblog-newsletter-icon {
    width: 62px;
    height: 62px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    color: #ffffff;
    margin: 0 auto 18px auto;
    box-shadow: 0 8px 24px rgba(236, 92, 10, 0.35);
    position: relative;
    z-index: 1;
  }

  .vsblog-newsletter h2 {
    font-size: clamp(20px, 3.5vw, 32px);
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 10px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-newsletter h2 span { color: #ec5c0a; }

  .vsblog-newsletter p {
    font-size: 15px;
    color: #64748b;
    margin: 0 auto 28px auto;
    max-width: 520px;
    line-height: 1.55;
    position: relative;
    z-index: 1;
  }

  .vsblog-nl-form {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    gap: 0;
    background: #ffffff;
    border-radius: 50px;
    border: 1.5px solid rgba(236, 92, 10, 0.3);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    position: relative;
    z-index: 1;
  }

  .vsblog-nl-form input {
    flex-grow: 1;
    height: 52px;
    padding: 0 22px;
    border: none;
    outline: none;
    font-size: 14px;
    font-family: inherit;
    color: #0f172a;
    background: transparent;
    min-width: 0;
  }

  .vsblog-nl-form button {
    height: 52px;
    padding: 0 28px;
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff;
    border: none;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    border-radius: 0 50px 50px 0;
    white-space: nowrap;
    transition: all 0.28s ease;
    flex-shrink: 0;
  }

  .vsblog-nl-form button:hover {
    background: linear-gradient(135deg, #d94e02 0%, #ec5c0a 100%);
  }

  @media (max-width: 480px) {
