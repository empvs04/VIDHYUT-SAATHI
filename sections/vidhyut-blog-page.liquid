<script>
  // DETAILED COMPREHENSIVE MULTI-ARTICLE DATABASE (8 ARTICLES)
  var VS_ARTICLES = [
    {
      title: "How Vidhyut Saathi's Terahertz Technology Reduces Electricity Bills by 20–30%",
      category: "Energy Savings",
      date: "Aug 22, 2026",
      author: "Vidhyut Saathi Technical Team",
      readTime: "6 min read",
      html: `
        <p>In modern Indian households, offices, and industrial facilities, electricity bills are rising steadily due to uncorrected power factor and reactive power losses. Vidhyut Saathi introduces a breakthrough US-German patented <strong>Terahertz Frequency Wave Technology</strong> engineered to optimize electrical efficiency from the root.</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-microchip"></i> What is Terahertz Frequency Wave Technology?</div>
        <p>Terahertz waves operate at ultra-high frequency spectrums between infrared and microwave bands. When integrated into Vidhyut Saathi's power factor optimization circuit, these micro-waves align microscopic electron movement within conductor wires, reducing internal line resistance and suppressing harmful harmonic distortion.</p>

        <div class="vsblog-modal-box-highlight">
          <strong>Key Engineering Fact:</strong> Standard electrical appliances (ACs, refrigerators, water pumps, fans) have an uncorrected Power Factor of 0.70 to 0.80. Vidhyut Saathi elevates power factor close to unity (0.98–0.99), turning wasted reactive current into productive work!
        </div>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-shield-halved"></i> How It Reduces Your Monthly Electricity Bill by 20–30%</div>
        <ul class="vsblog-modal-list">
          <li><strong>Eliminates Reactive Power Waste:</strong> Prevents your electricity meter from recording excess apparent power ($kVA$) caused by motor inductance.</li>
          <li><strong>Prevents Wire Overheating:</strong> Lowering line current reduces $I^2R$ heat dissipation loss, saving up to 15% energy in internal household wiring alone.</li>
          <li><strong>Extends Appliance Lifespan:</strong> Voltage stabilization prevents motor coil burnouts in air conditioners, refrigerators, and heavy 3-phase machinery.</li>
          <li><strong>Zero Legal Issues:</strong> Vidhyut Saathi connects in parallel behind the mains meter — it does NOT tamper with meter seals or breach DISCOM regulations.</li>
        </ul>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-check-double"></i> Tested & Certified Across 15+ States</div>
        <p>Over 10,000+ satisfied residential and commercial customers across Rajasthan, UP, Haryana, Gujarat, and Maharashtra have verified real-world savings of 20–30% on monthly DISCOM bills.</p>
      `
    },
    {
      title: "Understanding the 3 Exclusive District Franchise Models of Vidhyut Saathi",
      category: "Franchise",
      date: "Aug 20, 2026",
      author: "Franchise Development Team",
      readTime: "7 min read",
      html: `
        <p>Vidhyut Saathi provides a high-margin, recession-proof business opportunity for entrepreneurs across India. To cater to different investment capacities and district dynamics, we offer three distinct franchise partnership models:</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-shop"></i> 1. Non-Exclusive District Franchise Model</div>
        <p>Designed for entry-level entrepreneurs and regional distributors. This model allows flexible non-exclusive distribution across local markets with low starting capital and full marketing collateral support.</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-award"></i> 2. Standard Exclusive District Franchise Model</div>
        <p>Provides 100% exclusive territorial rights for one assigned district. No other distributor can operate or sell Vidhyut Saathi products in your territory. Includes direct manufacturer pricing, dedicated relationship manager, and lead forwarding from head office.</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-crown"></i> 3. Premium Exclusive District Franchise Model</div>
        <p>Our flagship VIP tier for master distributors seeking maximum profitability. Offers complete district monopoly, highest profit margin per unit, priority stock dispatch, dedicated local digital marketing ad campaigns run by head office, and direct B2B corporate order allocations.</p>

        <div class="vsblog-modal-box-highlight">
          <strong>Profit Potential:</strong> Premium Exclusive District Franchise partners generate net earnings between ₹5 Lakh to ₹6 Lakh per month with zero ongoing royalty fees!
        </div>
      `
    },
    {
      title: "Why ISO 9001:2015 & ISO 14001 Certification Ensures Top Device Safety",
      category: "Technology",
      date: "Aug 18, 2026",
      author: "Quality Control Cell",
      readTime: "5 min read",
      html: `
        <p>Safety and electrical compliance are non-negotiable when connecting any energy management device to your main power distribution board. Vidhyut Saathi is proud to be built under international quality and safety benchmarks.</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-certificate"></i> Our Quadruple International Certifications</div>
        <ul class="vsblog-modal-list">
          <li><strong>ISO 9001:2015 (Quality Management System):</strong> Guarantees rigorous batch testing, component-level insulation checks, and zero-defect manufacturing standards.</li>
          <li><strong>ISO 14001:2015 (Environmental Management):</strong> Ensures eco-friendly production, recyclable materials, and zero hazardous waste output.</li>
          <li><strong>ISO 45001:2018 (Occupational Health & Safety):</strong> High-grade flame-retardant V0-grade polycarbonate body casing with automatic surge protection up to 6kV.</li>
          <li><strong>CE European Compliance:</strong> Tested for strict electromagnetic compatibility (EMC) and low voltage safety directive (LVD).</li>
        </ul>
      `
    },
    {
      title: "How Residential & Commercial Establishments Cut Power Losses",
      category: "Energy Savings",
      date: "Aug 15, 2026",
      author: "Energy Audit Cell",
      readTime: "6 min read",
      html: `
        <p>Different premises consume electricity differently. Here is how Vidhyut Saathi delivers targeted 20–30% power bill reductions across sectors:</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-house"></i> 1. Residential Homes & Apartments</div>
        <p>In homes, heavy inductive loads like split ACs, refrigerators, washing machines, and water pumps cause voltage drops and power factor degradation. Vidhyut Saathi smooths out current spikes during motor startup, reducing electricity bills by 20–30% during peak summer months.</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-building-user"></i> 2. Commercial Stores, Offices & Hotels</div>
        <p>Commercial establishments with continuous lighting, HVAC chillers, elevators, and computers suffer heavy reactive power penalties. Vidhyut Saathi 3-Phase commercial units keep power factor consistently above 0.98, yielding lakhs in monthly savings.</p>
      `
    },
    {
      title: "KYC & Document Verification Guide for New Franchise Applicants",
      category: "Franchise",
      date: "Aug 10, 2026",
      author: "Legal & Onboarding Cell",
      readTime: "4 min read",
      html: `
        <p>To maintain high brand standards and protect territory exclusivity, all new Vidhyut Saathi franchise applicants undergo digital KYC document verification.</p>

        <div class="vsblog-modal-h3"><i class="fa-solid fa-id-card"></i> Accepted Mandatory Proofs</div>
        <ul class="vsblog-modal-list">
          <li><strong>Address Proof Options (Choose 1):</strong> Aadhaar Card, Voter Card, Driving License, or Passport.</li>
          <li><strong>ID Proof Option:</strong> PAN Card (Compulsory for tax compliance and agreement execution).</li>
        </ul>

        <div class="vsblog-modal-box-highlight">
          <strong>Smart Document Verification:</strong> Our online portal includes AI document scanning to check uploaded images match the selected ID type, ensuring instant approval for authentic applicants.
        </div>
      `
    },
    {
      title: "Power Factor Optimization: Active vs. Reactive Power Explained",
      category: "Technology",
      date: "Aug 05, 2026",
      author: "Industrial Engineering Cell",
      readTime: "6 min read",
      html: `
        <p>Electrical power in alternating current (AC) circuits consists of two main components: <strong>Active Power (kW)</strong> which performs actual mechanical work, and <strong>Reactive Power (kVAR)</strong> required to sustain magnetic fields in motors and transformers.</p>
        <div class="vsblog-modal-h3"><i class="fa-solid fa-calculator"></i> The Power Factor Equation</div>
        <p>Power Factor is defined as the ratio $\\cos\\phi = \\frac{kW}{kVA}$. When power factor drops below 0.85, DISCOMs charge extra penalty surcharges. Vidhyut Saathi's Terahertz wave capacitor matrix automatically injects leading reactive power to hold power factor at 0.98–0.99.</p>
      `
    },
    {
      title: "10-Year Replacement Warranty & 24/7 Customer Support Network",
      category: "Technology",
      date: "Jul 28, 2026",
      author: "Customer Assurance Division",
      readTime: "5 min read",
      html: `
        <p>Every Vidhyut Saathi device is engineered with industrial-grade components to deliver over 15 years of continuous trouble-free performance.</p>
        <div class="vsblog-modal-h3"><i class="fa-solid fa-shield-cat"></i> Direct 10-Year Replacement Policy</div>
        <p>In the rare event of a component breakdown, customers enjoy a hassle-free 10-year instant replacement guarantee handled directly by assigned District Franchise partners.</p>
      `
    },
    {
      title: "Franchise Growth: Partner Success Across Rajasthan & UP",
      category: "Franchise",
      date: "Jul 20, 2026",
      author: "Regional Operations Team",
      readTime: "6 min read",
      html: `
        <p>Over the past 24 months, Vidhyut Saathi franchise partners across Rajasthan (Jaipur, Jodhpur, Kota), Uttar Pradesh (Lucknow, Kanpur, Varanasi), and Haryana have successfully onboarded over 500+ commercial clients and 8,000+ residential homes.</p>
        <div class="vsblog-modal-box-highlight">
          <strong>Partner Insight:</strong> Exclusive territorial protection allowed district franchise leaders to capture 45% market share in their first year with zero local competition!
        </div>
      `
    }
  ];

  function vsFilterArticles(catName, btnElem) {
    if (btnElem) {
      var allBtns = document.querySelectorAll('.vsblog-cat-btn');
      allBtns.forEach(function(b) { b.classList.remove('active'); });
      btnElem.classList.add('active');
    }
    
    var cards = document.querySelectorAll('#vsblog_article_grid .vsblog-card');
    cards.forEach(function(card) {
      var cardCat = card.getAttribute('data-category');
      if (catName === 'all' || cardCat === catName) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function vsSearchArticles() {
    var searchVal = document.getElementById('vsblog_search_input').value.toLowerCase();
    var cards = document.querySelectorAll('#vsblog_article_grid .vsblog-card');
    
    cards.forEach(function(card) {
      var title = card.getAttribute('data-title').toLowerCase();
      var cat = card.getAttribute('data-category').toLowerCase();
      if (title.indexOf(searchVal) !== -1 || cat.indexOf(searchVal) !== -1) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function vsOpenArticleModal(index) {
    var article = VS_ARTICLES[index] || VS_ARTICLES[0];
    document.getElementById('vsmodal_header_title').innerText = article.title;
    document.getElementById('vsmodal_cat').innerText = article.category;
    document.getElementById('vsmodal_date').innerText = article.date;
    document.getElementById('vsmodal_author').innerText = article.author;
    document.getElementById('vsmodal_readtime').innerText = article.readTime;
    document.getElementById('vsmodal_full_html').innerHTML = article.html;
    
    var overlay = document.getElementById('vsblog_modal_overlay');
    if (overlay) overlay.classList.add('active');
  }

  function vsCloseArticleModal(e) {
    var overlay = document.getElementById('vsblog_modal_overlay');
    if (overlay) overlay.classList.remove('active');
  }

  function vsSubscribeNewsletter(e) {
    e.preventDefault();
    var email = document.getElementById('vsblog_nl_email').value;
    var msg = document.getElementById('vsblog_nl_msg');
    if (email && msg) {
      msg.innerHTML = '<i class="fa-solid fa-circle-check"></i> Thank you! You have successfully subscribed to Vidhyut Saathi updates.';
      document.getElementById('vsblog_nl_email').value = '';
    }
  }
</script>

