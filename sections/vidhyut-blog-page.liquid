<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ============================================
     VIDHYUT SAATHI - ULTRA-LUCRATIVE LIGHT BLOG HUB
     Theme: Warm Cream #fff8ef | Cards #ffffff | Orange #ec5c0a | Green #007b3e | Slate #0f172a
  ============================================= */

  .vsblog-wrap {
    background: #fff8ef;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #0f172a;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    line-height: 1.6;
  }

  .vsblog-wrap *, .vsblog-wrap *::before, .vsblog-wrap *::after {
    box-sizing: border-box;
  }

  /* ─── LUCRATIVE HERO BANNER ─── */
  .vsblog-hero {
    position: relative;
    background: linear-gradient(135deg, #ffffff 0%, #fff3e6 40%, #fff8ef 100%);
    padding: clamp(60px, 8vw, 100px) 20px clamp(50px, 6vw, 80px) 20px;
    overflow: hidden;
    text-align: center;
    border-bottom: 2px solid rgba(236, 92, 10, 0.12);
  }

  .vsblog-hero-orbs::before {
    content: '';
    position: absolute;
    top: -120px;
    left: -120px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.14) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-hero-orbs::after {
    content: '';
    position: absolute;
    bottom: -140px;
    right: -120px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vsblog-hero-circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.14;
    pointer-events: none;
  }

  .vsblog-hero-content {
    position: relative;
    z-index: 2;
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vsblog-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1.5px solid #ec5c0a;
    color: #ec5c0a;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding: 7px 22px;
    border-radius: 50px;
    margin-bottom: 22px;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.12);
  }

  .vsblog-hero h1 {
    font-size: clamp(30px, 5.5vw, 56px);
    font-weight: 900;
    color: #0f172a;
    line-height: 1.16;
    margin: 0 0 18px 0;
    letter-spacing: -0.8px;
  }

  .vsblog-hero h1 span {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsblog-hero-desc {
    color: #475569;
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.65;
    max-width: 700px;
    margin: 0 0 28px 0;
  }

  /* Breadcrumb */
  .vsblog-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    padding: 8px 20px;
    border-radius: 50px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 14px rgba(0,0,0,0.03);
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
  }

  .vsblog-breadcrumb a {
    color: #475569;
    text-decoration: none;
    transition: color 0.2s;
  }

  .vsblog-breadcrumb a:hover { color: #ec5c0a; }
  .vsblog-breadcrumb .sep { color: #cbd5e1; }
  .vsblog-breadcrumb .cur { color: #ec5c0a; font-weight: 800; }

  /* ─── FLOATING STATS STRIP ─── */
  .vsblog-stats-strip {
    max-width: 1240px;
    margin: -32px auto 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 10;
  }

  .vsblog-stats-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1.5px solid rgba(236, 92, 10, 0.15);
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    align-items: center;
    overflow: hidden;
  }

  .vsblog-stat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 20px 24px;
    border-right: 1px solid #f1f5f9;
  }

  .vsblog-stat-item:last-child { border-right: none; }

  .vsblog-stat-icon {
    width: 44px;
    height: 44px;
    background: #fff0e5;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ec5c0a;
    font-size: 18px;
    flex-shrink: 0;
  }

  .vsblog-stat-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .vsblog-stat-text strong {
    color: #0f172a;
    font-size: 17px;
    font-weight: 900;
    line-height: 1.2;
  }

  .vsblog-stat-text span {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
  }

  /* ─── MAIN BODY ─── */
  .vsblog-body {
    max-width: 1280px;
    margin: 0 auto;
    padding: 50px 20px clamp(40px, 6vw, 80px) 20px;
  }

  /* ─── CATEGORY FILTER BAR & SEARCH ─── */
  .vsblog-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 44px;
    padding: 16px 24px;
    background: #ffffff;
    border-radius: 60px;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
  }

  .vsblog-filter-label {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .vsblog-filter-label i { color: #ec5c0a; }

  .vsblog-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .vsblog-cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 20px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .vsblog-cat-btn:hover,
  .vsblog-cat-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(236, 92, 10, 0.35);
  }

  .vsblog-search {
    display: flex;
    position: relative;
    min-width: 250px;
    flex-grow: 1;
    max-width: 320px;
  }

  .vsblog-search input {
    width: 100%;
    height: 44px;
    padding: 0 44px 0 20px;
    border: 1.5px solid #e2e8f0;
    border-radius: 50px;
    background: #f8fafc;
    font-size: 13px;
    font-family: inherit;
    color: #0f172a;
    outline: none;
    transition: all 0.25s ease;
  }

  .vsblog-search input:focus {
    background: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 0 0 3px rgba(236, 92, 10, 0.12);
  }

  .vsblog-search button {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #ec5c0a;
    cursor: pointer;
    font-size: 15px;
    padding: 0;
  }

  /* ─── FEATURED ARTICLE CARD ─── */
  .vsblog-featured { margin-bottom: 50px; }

  .vsblog-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #ec5c0a;
    margin-bottom: 20px;
  }

  .vsblog-section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.4), transparent);
  }

  .vsblog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.04);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .vsblog-feat-card { grid-template-columns: 1.15fr 1fr; }
  }

  .vsblog-feat-card:hover {
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.14);
    transform: translateY(-4px);
  }

  .vsblog-feat-img {
    position: relative;
    min-height: 320px;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .vsblog-feat-img { min-height: 440px; }
  }

  .vsblog-feat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .vsblog-feat-card:hover .vsblog-feat-img img {
    transform: scale(1.05);
  }

  .vsblog-feat-svg-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fff7ed 0%, #ffede0 100%);
  }

  .vsblog-feat-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #ec5c0a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 6px 16px;
    border-radius: 50px;
    z-index: 2;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.35);
  }

  .vsblog-feat-content {
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  .vsblog-cat-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #007b3e;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 14px;
    background: rgba(0, 123, 62, 0.08);
    padding: 6px 14px;
    border-radius: 8px;
    width: fit-content;
  }

  .vsblog-feat-content h2 {
    font-size: clamp(20px, 3.2vw, 30px);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    margin: 0 0 16px 0;
  }

  .vsblog-feat-content p {
    color: #64748b;
    line-height: 1.65;
    font-size: clamp(14px, 1.6vw, 15px);
    margin: 0 0 24px 0;
  }

  .vsblog-meta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }

  .vsblog-meta-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    font-weight: 600;
  }

  .vsblog-meta-chip i { color: #ec5c0a; }

  .vsblog-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 800;
    padding: 13px 28px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    width: fit-content;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.35);
  }

  .vsblog-read-btn:hover {
    transform: translateX(4px);
    box-shadow: 0 10px 28px rgba(236, 92, 10, 0.5);
  }

  /* ─── TWO-COL LAYOUT (GRID + SIDEBAR) ─── */
  .vsblog-two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: start;
  }

  @media (min-width: 1040px) {
    .vsblog-two-col { grid-template-columns: 1fr 340px; }
  }

  /* PERFECT EQUAL-HEIGHT ARTICLE GRID */
  .vsblog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
  }

  @media (min-width: 640px) {
    .vsblog-grid { grid-template-columns: 1fr 1fr; }
  }

  .vsblog-card {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    border: 1.5px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vsblog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.12);
    border-color: rgba(236, 92, 10, 0.3);
  }

  .vsblog-card-img {
    position: relative;
    height: 200px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .vsblog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vsblog-card:hover .vsblog-card-img img {
    transform: scale(1.06);
  }

  .vsblog-thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsblog-card-cat-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #ffffff;
    color: #ec5c0a;
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 5px 14px;
    border-radius: 50px;
    z-index: 2;
    border: 1px solid rgba(236, 92, 10, 0.25);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
  }

  .vsblog-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .vsblog-card-title {
    font-size: 15.5px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.4;
    margin: 0 0 12px 0;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 44px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .vsblog-card-title:hover { color: #ec5c0a; }

  .vsblog-card-excerpt {
    font-size: 13.5px;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 20px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 64px;
    flex-grow: 1;
  }

  .vsblog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
    gap: 10px;
  }

  .vsblog-card-date {
    font-size: 12px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .vsblog-card-date i { color: #ec5c0a; }

  .vsblog-card-btn {
    font-size: 12.5px;
    font-weight: 800;
    color: #ec5c0a;
    background: #fff0e5;
    border: 1px solid rgba(236, 92, 10, 0.25);
    padding: 7px 16px;
    border-radius: 50px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
  }

  .vsblog-card-btn:hover {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.3);
  }

  /* ─── SIDEBAR WIDGETS ─── */
  .vsblog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 90px;
  }

  .vsblog-sidebar-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    border: 1.5px solid #f1f5f9;
  }

  .vsblog-sidebar-heading {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0 0 18px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .vsblog-sidebar-heading i { color: #ec5c0a; }

  .vsblog-sidebar-post {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid #f8fafc;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .vsblog-sidebar-post:last-child { border-bottom: none; padding-bottom: 0; }
  .vsblog-sidebar-post:hover { opacity: 0.75; }

  .vsblog-sidebar-post-num {
    width: 30px;
    height: 30px;
    background: #fff0e5;
    color: #ec5c0a;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .vsblog-sidebar-post-info h4 {
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px 0;
    line-height: 1.4;
  }

  .vsblog-sidebar-post-info span {
    font-size: 11.5px;
    color: #94a3b8;
  }

  .vsblog-tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .vsblog-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 50px;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
  }

  .vsblog-tag-pill:hover {
    background: #ec5c0a;
    border-color: #ec5c0a;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(236, 92, 10, 0.28);
  }

  /* SIDEBAR FRANCHISE CTA WIDGET */
  .vsblog-sidebar-cta {
    background: linear-gradient(135deg, #fff7ed 0%, #ffe8d6 100%);
    border-radius: 20px;
    padding: 28px 24px;
    text-align: center;
    border: 1.5px solid #ec5c0a;
    position: relative;
    overflow: hidden;
  }

  .vsblog-sidebar-cta::before {
    content: '';
    position: absolute;
    top: -30px;
    right: -30px;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.2) 0%, transparent 70%);
    border-radius: 50%;
  }

  .vsblog-sidebar-cta-icon {
    width: 56px;
    height: 56px;
    background: #ffffff;
    border: 1.5px solid #ec5c0a;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #ec5c0a;
    margin: 0 auto 16px auto;
    box-shadow: 0 6px 18px rgba(236, 92, 10, 0.18);
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta h3 {
    font-size: 17px;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 8px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta p {
    font-size: 13px;
    color: #475569;
    line-height: 1.55;
    margin: 0 0 22px 0;
    position: relative;
    z-index: 1;
  }

  .vsblog-sidebar-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 800;
    padding: 13px 24px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.4);
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .vsblog-sidebar-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(236, 92, 10, 0.55);
  }

  /* ─── NEWSLETTER SECTION ─── */
  .vsblog-newsletter {
    margin-top: 60px;
    background: linear-gradient(135deg, #ffffff 0%, #fff6ec 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.2);
    border-radius: 24px;
    padding: clamp(40px, 6vw, 70px) 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.04);
  }

  .vsblog-newsletter-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 100%);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    color: #ffffff;
    margin: 0 auto 20px auto;
    box-shadow: 0 8px 24px rgba(236, 92, 10, 0.35);
  }

