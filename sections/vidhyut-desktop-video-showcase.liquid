{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap');

  /* ===========================================================================
     SECTION 14: VIDHYUT DESKTOP VIDEO SHOWCASE (DESKTOP ONLY)
     EXACT 1:1 RECREATION OF REFERENCE SCREENSHOT LAYOUT
     =========================================================================== */
  .vs-desktop-video-section {
    display: block !important;
    padding: 60px 0 80px 0 !important;
    background: #FFFFFF !important;
    position: relative !important;
    overflow: hidden !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
  }

  /* Hide on Mobile */
  @media screen and (max-width: 768px) {
    .vs-desktop-video-section {
      display: none !important;
    }
  }

  .vs-desktop-video-container {
    max-width: 1300px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    position: relative !important;
  }

  .vs-video-main-wrapper {
    position: relative !important;
    width: 100% !important;
  }

  /* 2-COLUMN TOP GRID */
  .vs-video-top-grid {
    display: grid !important;
    grid-template-columns: 1.08fr 0.92fr !important;
    gap: 40px !important;
    align-items: center !important;
    position: relative !important;
  }

  /* LEFT COLUMN: VIDEO THUMBNAIL CARD */
  .vs-video-thumb-card {
    position: relative !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    aspect-ratio: 16 / 10.5 !important;
    background: #0F172A !important;
    cursor: pointer !important;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08) !important;
  }

  .vs-video-thumb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.6s ease !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-img {
    transform: scale(1.04) !important;
  }

  .vs-video-thumb-overlay {
    position: absolute !important;
    inset: 0 !important;
    background: rgba(15, 23, 42, 0.1) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background 0.3s ease !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-overlay {
    background: rgba(15, 23, 42, 0.2) !important;
  }

  /* BLUE CIRCULAR PLAY BUTTON */
  .vs-play-btn-circle {
    width: 68px !important;
    height: 68px !important;
    border-radius: 50% !important;
    background: #0084FF !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 8px 25px rgba(0, 132, 255, 0.45) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    padding-left: 4px !important;
  }

  .vs-video-thumb-card:hover .vs-play-btn-circle {
    transform: scale(1.15) !important;
    box-shadow: 0 12px 35px rgba(0, 132, 255, 0.6) !important;
  }

  /* RIGHT COLUMN: CONTENT */
  .vs-video-content-col {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    position: relative !important;
    padding-left: 10px !important;
  }

  /* Background Watermark Graphic */
  .vs-watermark-bg {
    position: absolute !important;
    right: -40px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 380px !important;
    opacity: 0.05 !important;
    pointer-events: none !important;
    z-index: 0 !important;
  }

  .vs-content-inner {
    position: relative !important;
    z-index: 2 !important;
  }

  .vs-script-subtitle {
    font-family: 'Caveat', cursive !important;
    font-size: 1.75rem !important;
    color: #0084FF !important;
    margin-bottom: 4px !important;
    line-height: 1.2 !important;
    letter-spacing: 0.5px !important;
  }

  .vs-video-main-heading {
    font-size: clamp(1.8rem, 2.5vw, 2.3rem) !important;
    font-weight: 800 !important;
    color: #1E293B !important;
    line-height: 1.25 !important;
    margin: 0 0 24px 0 !important;
    letter-spacing: -0.5px !important;
  }

  .vs-video-main-heading span {
    color: #0084FF !important;
  }

  .vs-video-feature-row {
    display: flex !important;
    align-items: flex-start !important;
    gap: 16px !important;
    margin-bottom: 28px !important;
  }

  .vs-feature-icon-svg {
    width: 44px !important;
    height: 44px !important;
    min-width: 44px !important;
    color: #334155 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-top: 2px !important;
  }

  .vs-feature-text-block {
    flex: 1 !important;
  }

  .vs-feature-title {
    margin: 0 0 6px 0 !important;
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    color: #1E293B !important;
    line-height: 1.3 !important;
  }

  .vs-feature-desc {
    margin: 0 !important;
    font-size: 0.85rem !important;
    color: #64748B !important;
    line-height: 1.55 !important;
  }

  .vs-video-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 13px 26px !important;
    background: #0084FF !important;
    color: #FFFFFF !important;
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    box-shadow: 0 6px 20px rgba(0, 132, 255, 0.3) !important;
    transition: all 0.3s ease !important;
    width: fit-content !important;
  }

  .vs-video-cta-btn:hover {
    background: #0073E6 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 25px rgba(0, 132, 255, 0.45) !important;
    color: #FFFFFF !important;
  }

  /* 6 FLOATING CARDS (OVERLAPPING BOTH COLUMNS EXACTLY AS IN SCREENSHOT) */
  .vs-floating-cards-row {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    gap: 16px !important;
    width: 100% !important;
    margin-top: -65px !important;
    position: relative !important;
    z-index: 10 !important;
  }

  .vs-nav-card-item {
    background: #FFFFFF !important;
    border-radius: 14px !important;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.02) !important;
    border: 1px solid rgba(241, 245, 249, 0.9) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    aspect-ratio: 1 / 1 !important;
    padding: 14px 8px !important;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    cursor: pointer !important;
  }

  .vs-nav-card-item:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12) !important;
  }

  .vs-card-icon-art {
    width: 52px !important;
    height: 52px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 8px !important;
    transition: transform 0.3s ease !important;
  }

  .vs-nav-card-item:hover .vs-card-icon-art {
    transform: scale(1.1) !important;
  }

  .vs-card-icon-art svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .vs-card-label {
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    text-align: center !important;
    line-height: 1.2 !important;
    margin: 0 !important;
    letter-spacing: -0.2px !important;
  }

  /* VIDEO MODAL POPUP */
  .vs-video-modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 23, 42, 0.88) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 99999 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
    opacity: 0 !important;
    transition: opacity 0.3s ease !important;
  }

  .vs-video-modal-overlay.active {
    display: flex !important;
    opacity: 1 !important;
  }

  .vs-video-modal-content {
    position: relative !important;
    width: 90vw !important;
    max-width: 960px !important;
    height: 540px !important;
    max-height: 82vh !important;
    aspect-ratio: 16 / 9 !important;
    background: #000000 !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.75) !important;
    border: 2px solid rgba(255, 255, 255, 0.15) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .vs-video-modal-close {
    position: absolute !important;
    top: 15px !important;
    right: 20px !important;
    color: #FFFFFF !important;
    font-size: 2.2rem !important;
    cursor: pointer !important;
    background: rgba(15, 23, 42, 0.7) !important;
    border-radius: 50% !important;
    width: 42px !important;
    height: 42px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    line-height: 1 !important;
    transition: transform 0.2s ease, color 0.2s ease !important;
    z-index: 10 !important;
  }

  .vs-video-modal-close:hover {
    transform: scale(1.15) !important;
    color: #0084FF !important;
    background: rgba(15, 23, 42, 0.9) !important;
  }

  .vs-video-modal-iframe {
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    display: block !important;
  }

  .vs-video-modal-video {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    background: #000000 !important;
  }
{%- endstyle -%}

<!-- SECTION 14: VIDHYUT DESKTOP VIDEO SHOWCASE -->
<section class="vs-desktop-video-section" id="vsDesktopVideoSection">
  <div class="vs-desktop-video-container">

    <div class="vs-video-main-wrapper">
      
      <!-- Determine Video URL (Supports Gallery MP4 file, Direct MP4 URL, or YouTube URL) -->
      {%- assign active_video_target = section.settings.video_url -%}
      {%- if section.settings.custom_video_file != blank -%}
        {%- assign active_video_target = section.settings.custom_video_file.sources[0].url -%}
      {%- elsif section.settings.custom_video_url != blank -%}
        {%- assign active_video_target = section.settings.custom_video_url -%}
      {%- endif -%}

      <!-- 2-COLUMN TOP GRID -->
      <div class="vs-video-top-grid">
        
        <!-- LEFT COLUMN: VIDEO THUMBNAIL -->
        <div class="vs-video-thumb-card" onclick="vsOpenVideoModal('{{ active_video_target | escape }}')">
          {%- if section.settings.thumbnail_image != blank -%}
            <img src="{{ section.settings.thumbnail_image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- else -%}
            <img src="{{ 'hero-advisor-calculator.jpg' | asset_url }}" alt="Vidhyut Saathi Technology Showcase" class="vs-video-thumb-img" loading="lazy">
          {%- endif -%}
          
          <div class="vs-video-thumb-overlay">
            <div class="vs-play-btn-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: CONTENT -->
        <div class="vs-video-content-col">
          <!-- Subtle Watermark -->
          <svg class="vs-watermark-bg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>

          <div class="vs-content-inner">
            <div class="vs-script-subtitle">{{ section.settings.script_subtitle | default: "Among The All" }}</div>
            <h2 class="vs-video-main-heading">
              {{ section.settings.heading | default: "Choose Your Favorite Plan" }}
            </h2>

            <!-- FEATURE ROW -->
            <div class="vs-video-feature-row">
              <div class="vs-feature-icon-svg">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
              <div class="vs-feature-text-block">
                <h4 class="vs-feature-title">{{ section.settings.feature_title | default: "We Suggest You The Best Energy Collection" }}</h4>
                <p class="vs-feature-desc">{{ section.settings.feature_desc | default: "Vidhyut Saathi is specialized in electricity load optimization & 20-30% power saving solutions for over 500+ commercial & residential clients across India." }}</p>
              </div>
            </div>

            <!-- ACTION BUTTON -->
            <a href="{{ section.settings.button_link | default: '/pages/get-franchise' }}" class="vs-video-cta-btn">
              <span>{{ section.settings.button_text | default: "Book A Plan" }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- 6 FLOATING CARDS (OVERLAPPING BOTH COLUMNS EXACTLY AS IN SCREENSHOT) -->
      <div class="vs-floating-cards-row">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.card_link | default: '#' }}" class="vs-nav-card-item" {{ block.shopify_attributes }}>
            <div class="vs-card-icon-art" style="color: {{ block.settings.card_color | default: '#0284C7' }};">
              {{ block.settings.card_icon_svg | default: '' }}
            </div>
            <h4 class="vs-card-label" style="color: {{ block.settings.card_color | default: '#0284C7' }};">{{ block.settings.card_title | default: 'Plan' }}</h4>
          </a>
        {%- else -%}
          <!-- Default 6 Cards with exact colorful line-art icons as screenshot -->
          
          <!-- Card 1: Mountain / Residential (Blue) -->
          <a href="/pages/residential" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #0284C7;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #0284C7;">Hill Station</h4>
          </a>

          <!-- Card 2: Pilgrim / Commercial (Pink/Red) -->
          <a href="/pages/commercial" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #E11D48;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="7" r="3"></circle>
                <path d="M6 21v-4a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v4"></path>
                <path d="M19 8l2 2-2 2"></path>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #E11D48;">Pilgrims</h4>
          </a>

          <!-- Card 3: Beach / Industrial (Cyan) -->
          <a href="/pages/industrial" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #06B6D4;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3"></circle>
                <path d="M12 18a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v8a6 6 0 0 0 6 6z"></path>
                <path d="M2 20c2-1 4 0 6 0s4-1 6 0 4-1 6 0"></path>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #06B6D4;">Beach</h4>
          </a>

          <!-- Card 4: National Park / Franchise (Orange) -->
          <a href="/pages/get-franchise" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #F97316;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 22 22 22 12 2"></polygon>
                <line x1="12" y1="18" x2="12" y2="22"></line>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #F97316;">National Park</h4>
          </a>

          <!-- Card 5: Desert / ISO Certified (Indigo) -->
          <a href="/pages/iso-certification" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #4F46E5;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2c2 3 6 8 6 12a6 6 0 0 1-12 0c0-4 4-9 6-12z"></path>
                <line x1="4" y1="22" x2="20" y2="22"></line>
                <line x1="6" y1="19" x2="18" y2="19"></line>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #4F46E5;">Desert</h4>
          </a>

          <!-- Card 6: International / Support (Sky Blue) -->
          <a href="/pages/contact" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #0EA5E9;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #0EA5E9;">International</h4>
          </a>
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

<!-- VIDEO MODAL POPUP CONTAINER -->
<div class="vs-video-modal-overlay" id="vsVideoModal" onclick="if(event.target === this) vsCloseVideoModal();">
  <div class="vs-video-modal-content">
    <button type="button" class="vs-video-modal-close" onclick="vsCloseVideoModal()">&times;</button>
    <iframe id="vsVideoModalIframe" class="vs-video-modal-iframe" allow="autoplay; encrypted-media" allowfullscreen style="display: none;"></iframe>
    <video id="vsVideoModalVideo" class="vs-video-modal-video" controls playsinline style="display: none; width: 100%; height: 100%; object-fit: contain;"></video>
  </div>
</div>

<script>
  function vsOpenVideoModal(rawUrl) {
    const modal = document.getElementById('vsVideoModal');
    const iframe = document.getElementById('vsVideoModalIframe');
    const html5Video = document.getElementById('vsVideoModalVideo');
    
    let targetUrl = rawUrl || 'https://www.youtube.com/embed/eNPX8I7iRV8';

    // Check if URL is an MP4/WebM/MOV video file or Shopify CDN video link
    const isDirectVideoFile = targetUrl.match(/\.(mp4|webm|mov|ogg)(\?.*)?$/i) || targetUrl.includes('cdn.shopify.com/videos') || targetUrl.includes('cdn.shopify.com/files');

    if (isDirectVideoFile) {
      iframe.style.display = 'none';
      iframe.src = '';
      html5Video.style.display = 'block';
      html5Video.src = targetUrl;
      html5Video.play();
    } else {
      html5Video.style.display = 'none';
      html5Video.pause();
      html5Video.src = '';
      iframe.style.display = 'block';

      let videoId = '';
      if (targetUrl.includes('/shorts/')) {
        const parts = targetUrl.split('/shorts/');
        if (parts[1]) videoId = parts[1].split('?')[0].split('&')[0];
      } else if (targetUrl.includes('youtu.be/')) {
        const parts = targetUrl.split('youtu.be/');
        if (parts[1]) videoId = parts[1].split('?')[0].split('&')[0];
      } else if (targetUrl.includes('v=')) {
        const queryPart = targetUrl.split('?')[1] || '';
        const params = new URLSearchParams(queryPart);
        videoId = params.get('v') || '';
      } else if (targetUrl.includes('/embed/')) {
        const parts = targetUrl.split('/embed/');
        if (parts[1]) videoId = parts[1].split('?')[0].split('&')[0];
      }

      if (videoId) {
        targetUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&enablejsapi=1&rel=0';
      } else if (targetUrl.includes('embed/')) {
        targetUrl = targetUrl.includes('?') ? targetUrl + '&autoplay=1' : targetUrl + '?autoplay=1';
      }

      iframe.src = targetUrl;
    }

    modal.classList.add('active');
  }

  function vsCloseVideoModal() {
    const modal = document.getElementById('vsVideoModal');
    const iframe = document.getElementById('vsVideoModalIframe');
    const html5Video = document.getElementById('vsVideoModalVideo');

    iframe.src = '';
    iframe.style.display = 'none';
    html5Video.pause();
    html5Video.src = '';
    html5Video.style.display = 'none';
    
    modal.classList.remove('active');
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      vsCloseVideoModal();
    }
  });
</script>

{% schema %}
{
  "name": "Desktop Video Showcase 14",
  "settings": [
    {
      "type": "text",
      "id": "script_subtitle",
      "label": "Script Subtitle (Cursive)",
      "default": "Among The All"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Choose Your Favorite Tour"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image",
      "label": "Video Thumbnail Photo"
    },
    {
      "type": "video",
      "id": "custom_video_file",
      "label": "Upload Custom Video (MP4 / Phone Gallery Video)"
    },
    {
      "type": "text",
      "id": "custom_video_url",
      "label": "Or Paste Direct MP4 / Video File Link"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Or Paste YouTube Video Link",
      "default": "https://www.youtube.com/embed/eNPX8I7iRV8"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "Feature Box Title",
