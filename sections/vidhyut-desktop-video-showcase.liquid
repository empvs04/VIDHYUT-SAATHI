{%- style -%}
  /* ===========================================================================
     SECTION 14: VIDHYUT DESKTOP VIDEO SHOWCASE (DESKTOP ONLY)
     =========================================================================== */
  .vs-desktop-video-section {
    display: block !important;
    padding: 70px 0 60px 0 !important;
    background: linear-gradient(180deg, #FFFDF8 0%, #FAF8F2 100%) !important;
    position: relative !important;
    overflow: hidden !important;
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif !important;
  }

  /* Hide on Mobile */
  @media screen and (max-width: 768px) {
    .vs-desktop-video-section {
      display: none !important;
    }
  }

  .vs-desktop-video-container {
    max-width: 1320px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    position: relative !important;
    z-index: 2 !important;
  }

  /* 2-COLUMN MAIN FLEX GRID */
  .vs-desktop-video-main-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 48px !important;
    align-items: center !important;
    margin-bottom: 50px !important;
  }

  /* LEFT COLUMN: VIDEO PLAYER THUMBNAIL CARD */
  .vs-video-thumb-card {
    position: relative !important;
    border-radius: 28px !important;
    overflow: hidden !important;
    box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12), 0 4px 20px rgba(236, 92, 10, 0.08) !important;
    border: 3px solid #FFFFFF !important;
    aspect-ratio: 16 / 10 !important;
    background: #0F172A !important;
    cursor: pointer !important;
  }

  .vs-video-thumb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.6s ease !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-img {
    transform: scale(1.04) !important;
  }

  /* Overlay Dark Gradient */
  .vs-video-thumb-overlay {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.1) 0%, rgba(15, 23, 42, 0.45) 100%) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 2 !important;
  }

  /* Pulsing Play Button */
  .vs-play-btn-circle {
    width: 84px !important;
    height: 84px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.8rem !important;
    box-shadow: 0 12px 35px rgba(236, 92, 10, 0.5) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    position: relative !important;
    padding-left: 5px !important;
  }

  .vs-play-btn-circle::before {
    content: '' !important;
    position: absolute !important;
    inset: -12px !important;
    border-radius: 50% !important;
    background: rgba(236, 92, 10, 0.35) !important;
    animation: vsPlayPulse 2s infinite !important;
    z-index: -1 !important;
  }

  @keyframes vsPlayPulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.15); opacity: 0.3; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }

  .vs-video-thumb-card:hover .vs-play-btn-circle {
    transform: scale(1.12) !important;
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.65) !important;
  }

  /* RIGHT COLUMN CONTENT */
  .vs-video-content-col {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }

  .vs-video-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 6px 16px !important;
    background: #FFF3EB !important;
    border: 1px solid rgba(236, 92, 10, 0.3) !important;
    color: #EC5C0A !important;
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    letter-spacing: 1px !important;
    text-transform: uppercase !important;
    border-radius: 30px !important;
    margin-bottom: 16px !important;
    width: fit-content !important;
  }

  .vs-video-main-heading {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem) !important;
    font-weight: 900 !important;
    color: #0F172A !important;
    line-height: 1.22 !important;
    margin: 0 0 20px 0 !important;
    letter-spacing: -0.5px !important;
  }

  .vs-video-main-heading span {
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  .vs-video-feature-box {
    display: flex !important;
    align-items: flex-start !important;
    gap: 16px !important;
    background: #FFFFFF !important;
    border: 1.5px solid #F1F5F9 !important;
    border-radius: 20px !important;
    padding: 20px 22px !important;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04) !important;
    margin-bottom: 24px !important;
  }

  .vs-feature-icon-box {
    width: 52px !important;
    height: 52px !important;
    min-width: 52px !important;
    border-radius: 16px !important;
    background: linear-gradient(135deg, #FFF3EB 0%, #FFE2D1 100%) !important;
    color: #EC5C0A !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 1.4rem !important;
  }

  .vs-feature-details h4 {
    margin: 0 0 6px 0 !important;
    font-size: 1.05rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
  }

  .vs-feature-details p {
    margin: 0 !important;
    font-size: 0.88rem !important;
    color: #64748B !important;
    line-height: 1.55 !important;
  }

  .vs-video-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    padding: 16px 32px !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.5px !important;
    border-radius: 14px !important;
    text-decoration: none !important;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.35) !important;
    transition: all 0.35s ease !important;
    width: fit-content !important;
  }

  .vs-video-cta-btn:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 18px 38px rgba(236, 92, 10, 0.48) !important;
    color: #FFFFFF !important;
  }

  /* BOTTOM CARDS ROW (6 LUCRATIVE CARDS) */
  .vs-video-cards-row {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    gap: 16px !important;
    width: 100% !important;
  }

  .vs-bottom-nav-card {
    background: #FFFFFF !important;
    border: 1.5px solid rgba(236, 92, 10, 0.18) !important;
    border-top: 4px solid #EC5C0A !important;
    border-radius: 20px !important;
    padding: 22px 14px !important;
    text-align: center !important;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.05) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    text-decoration: none !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .vs-bottom-nav-card:hover {
    transform: translateY(-6px) !important;
    border-color: #EC5C0A !important;
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.18) !important;
  }

  .vs-card-nav-icon {
    font-size: 2rem !important;
    margin-bottom: 10px !important;
    display: block !important;
  }

  .vs-card-nav-title {
    font-size: 0.88rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    margin: 0 !important;
    line-height: 1.25 !important;
  }

  /* VIDEO MODAL POPUP */
  .vs-video-modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 23, 42, 0.88) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 99999 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
  }

  .vs-video-modal-overlay.active {
    display: flex !important;
  }

  .vs-video-modal-content {
    position: relative !important;
    width: 100% !important;
    max-width: 900px !important;
    aspect-ratio: 16 / 9 !important;
    background: #000000 !important;
    border-radius: 24px !important;
    overflow: hidden !important;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.6) !important;
  }

  .vs-video-modal-close {
    position: absolute !important;
    top: -45px !important;
    right: 0 !important;
    color: #FFFFFF !important;
    font-size: 2rem !important;
    cursor: pointer !important;
    background: none !important;
    border: none !important;
    line-height: 1 !important;
  }

  .vs-video-modal-iframe {
    width: 100% !important;
    height: 100% !important;
    border: none !important;
  }
{%- endstyle -%}

<!-- SECTION 14: VIDHYUT DESKTOP VIDEO SHOWCASE -->
<section class="vs-desktop-video-section" id="vsDesktopVideoSection">
  <div class="vs-desktop-video-container">

    <!-- 2-COLUMN MAIN GRID -->
    <div class="vs-desktop-video-main-grid">
      
      <!-- LEFT COLUMN: THUMBNAIL WITH PLAY BUTTON -->
      <div class="vs-video-thumb-card" onclick="vsOpenVideoModal('{{ section.settings.video_url }}')">
        {%- if section.settings.thumbnail_image != blank -%}
          <img src="{{ section.settings.thumbnail_image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="vs-video-thumb-img" loading="lazy">
        {%- else -%}
          <img src="{{ 'hero-advisor-calculator.jpg' | asset_url }}" alt="Vidhyut Saathi Technology Showcase" class="vs-video-thumb-img" loading="lazy">
        {%- endif -%}
        
        <div class="vs-video-thumb-overlay">
          <div class="vs-play-btn-circle">
            ▶
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: CONTENT & DETAILS -->
      <div class="vs-video-content-col">
        <span class="vs-video-badge">⚡ {{ section.settings.badge_text | default: "AMONG THE BEST" }}</span>
        <h2 class="vs-video-main-heading">
          {{ section.settings.heading | default: "Choose Your <span>Favorite Energy Plan</span>" }}
        </h2>

        <!-- FEATURE BOX -->
        <div class="vs-video-feature-box">
          <div class="vs-feature-icon-box">🖼️</div>
          <div class="vs-feature-details">
            <h4>{{ section.settings.feature_title | default: "We Suggest You The Best Energy Collection" }}</h4>
            <p>{{ section.settings.feature_desc | default: "Vidhyut Saathi Energy Savers Private Limited is specialized in electricity load optimization & 20-30% power saving solutions for over 500+ commercial & residential clients across India." }}</p>
          </div>
        </div>

        <!-- ACTION BUTTON -->
        <a href="{{ section.settings.button_link | default: '/pages/get-franchise' }}" class="vs-video-cta-btn">
          <span>{{ section.settings.button_text | default: "Book Free Consultation" }}</span> &rarr;
        </a>
      </div>

    </div> <!-- Closing vs-desktop-video-main-grid -->

    <!-- BOTTOM CARDS ROW (6 CARDS) -->
    <div class="vs-video-cards-row">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.card_link | default: '#' }}" class="vs-bottom-nav-card" {{ block.shopify_attributes }}>
          <span class="vs-card-nav-icon">{{ block.settings.card_icon | default: '🏔️' }}</span>
          <h4 class="vs-card-nav-title">{{ block.settings.card_title | default: 'Category' }}</h4>
        </a>
      {%- else -%}
        <!-- Default Fallback Cards if none added in Customizer -->
        <a href="/pages/residential" class="vs-bottom-nav-card">
          <span class="vs-card-nav-icon">🏡</span>
          <h4 class="vs-card-nav-title">Residential</h4>
        </a>
        <a href="/pages/commercial" class="vs-bottom-nav-card">
          <span class="vs-card-nav-icon">🏢</span>
          <h4 class="vs-card-nav-title">Commercial</h4>
        </a>
        <a href="/pages/industrial" class="vs-bottom-nav-card">
          <span class="vs-card-nav-icon">🏭</span>
          <h4 class="vs-card-nav-title">Industrial</h4>
        </a>
        <a href="/pages/get-franchise" class="vs-bottom-nav-card">
          <span class="vs-card-nav-icon">🤝</span>
          <h4 class="vs-card-nav-title">Franchise</h4>
        </a>
        <a href="/pages/iso-certification" class="vs-bottom-nav-card">
          <span class="vs-card-nav-icon">🛡️</span>
          <h4 class="vs-card-nav-title">ISO Certified</h4>
        </a>
        <a href="/pages/contact" class="vs-bottom-nav-card">
          <span class="vs-card-nav-icon">📞</span>
          <h4 class="vs-card-nav-title">24/7 Support</h4>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

<!-- VIDEO MODAL POPUP CONTAINER -->
<div class="vs-video-modal-overlay" id="vsVideoModal">
  <div class="vs-video-modal-content">
    <button type="button" class="vs-video-modal-close" onclick="vsCloseVideoModal()">&times;</button>
    <iframe id="vsVideoModalIframe" class="vs-video-modal-iframe" allow="autoplay; encrypted-media" allowfullscreen></iframe>
  </div>
</div>

<script>
  function vsOpenVideoModal(videoUrl) {
    const modal = document.getElementById('vsVideoModal');
    const iframe = document.getElementById('vsVideoModalIframe');
    
    let embedUrl = videoUrl || 'https://www.youtube.com/embed/eNPX8I7iRV8?autoplay=1';
    if (embedUrl.includes('watch?v=')) {
      embedUrl = embedUrl.replace('watch?v=', 'embed/') + '?autoplay=1';
    } else if (!embedUrl.includes('embed') && !embedUrl.includes('autoplay')) {
      embedUrl += '?autoplay=1';
    }

    iframe.src = embedUrl;
    modal.classList.add('active');
  }

  function vsCloseVideoModal() {
    const modal = document.getElementById('vsVideoModal');
    const iframe = document.getElementById('vsVideoModalIframe');
    iframe.src = '';
    modal.classList.remove('active');
  }
</script>

{% schema %}
{
  "name": "Desktop Video Showcase 14",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "AMONG THE BEST"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (HTML Supported)",
      "default": "Choose Your <span>Favorite Energy Plan</span>"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image",
      "label": "Video Thumbnail Photo"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube / Video URL",
      "default": "https://www.youtube.com/embed/eNPX8I7iRV8"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "Feature Box Title",
      "default": "We Suggest You The Best Energy Collection"
    },
    {
      "type": "textarea",
      "id": "feature_desc",
      "label": "Feature Box Description",
      "default": "Vidhyut Saathi Energy Savers Private Limited is specialized in electricity load optimization & 20-30% power saving solutions for over 500+ clients across India."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Book Free Consultation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "nav_card",
      "name": "Bottom Nav Card",
      "settings": [
        {
          "type": "text",
          "id": "card_icon",
          "label": "Card Emoji / Icon",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title",
          "default": "Residential"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Desktop Video Showcase 14",
      "blocks": [
        { "type": "nav_card", "settings": { "card_icon": "🏡", "card_title": "Residential" } },
        { "type": "nav_card", "settings": { "card_icon": "🏢", "card_title": "Commercial" } },
        { "type": "nav_card", "settings": { "card_icon": "🏭", "card_title": "Industrial" } },
        { "type": "nav_card", "settings": { "card_icon": "🤝", "card_title": "Franchise" } },
        { "type": "nav_card", "settings": { "card_icon": "🛡️", "card_title": "ISO Certified" } },
        { "type": "nav_card", "settings": { "card_icon": "📞", "card_title": "24/7 Support" } }
      ]
    }
  ]
}
{% endschema %}
