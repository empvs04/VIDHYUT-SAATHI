          "default": "A short description of the team member's role and expertise."
        },
        {
          "type": "url",
          "id": "social_url",
          "label": "Profile/Social URL (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Team Layout",
      "blocks": []
    }
  ]
}
{% endschema %}
