{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --team-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --team-secondary: #007b3e;
    --team-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --team-text-dark: #1a1a1a;
    --team-text-light: #4a4a4a;
    --team-radius: 16px;
    --team-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    --team-shadow-hover: 0 20px 40px rgba(236, 92, 10, 0.15);
  }
  
  .our-team-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--team-text-dark);
    background-color: var(--team-bg);
    overflow: hidden;
  }

  /* --- Typography --- */
  .team-section-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--team-text-dark);
  }
  .team-section-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--team-text-light);
  }
  
  /* --- Section 1: Our Team Hero Banner --- */
  .team-page-hero {
    position: relative;
    width: 100%;
    min-height: 480px;
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-position: center 25% !important;
    background-color: #090e1a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 70px 20px;
    box-sizing: border-box;
    image-rendering: -webkit-optimize-contrast;
    -webkit-backface-visibility: hidden;
  }

  .team-page-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(9, 14, 26, 0.75) 0%, rgba(9, 14, 26, 0.88) 100%);
    z-index: 1;
  }

  /* Moving Background Marquee Text */
  @keyframes teamMarqueeMove {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .team-marquee-track {
    position: absolute;
    top: 50%;
    left: 0;
    width: 200%;
    transform: translateY(-50%);
    z-index: 2;
    pointer-events: none;
    opacity: 0.22;
    overflow: hidden;
  }
  .team-marquee-content {
    display: inline-block;
    white-space: nowrap;
    font-size: clamp(55px, 9.5vw, 140px);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    background: linear-gradient(90deg, #ec5c0a, #ff9a00, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: teamMarqueeMove 20s linear infinite;
  }

  .team-hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .team-hero-inner h1.title {
    font-size: clamp(32px, 5.5vw, 58px);
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 22px;
    line-height: 1.25;
    text-shadow: 0 4px 20px rgba(0,0,0,0.6);
    letter-spacing: -0.5px;
  }

  .team-hero-inner .breadcumb--con {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .team-hero-inner .breadcrumb {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 10px 28px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.4);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    list-style: none;
    margin: 0 auto;
  }

  .team-hero-inner .breadcrumb-item {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .team-hero-inner .breadcrumb-item a {
    color: #ffcc00;
    text-decoration: none;
    font-weight: 800;
    transition: color 0.3s ease;
  }
  .team-hero-inner .breadcrumb-item a:hover {
    color: #00ff75;
  }

  .team-hero-inner .breadcrumb-item.active {
    color: #ffffff;
    font-weight: 700;
  }

  .team-hero-inner .breadcrumb-item + .breadcrumb-item::before {
    content: '/';
    color: rgba(255, 255, 255, 0.4);
    padding-right: 12px;
  }

  @media screen and (max-width: 768px) {
    .team-page-hero {
      min-height: 320px !important;
      padding: 45px 16px !important;
      background-size: cover !important;
      background-position: center 15% !important;
    }
    .team-marquee-content {
      font-size: clamp(32px, 8vw, 48px) !important;
      opacity: 0.28 !important;
    }
    .team-hero-inner h1.title {
      font-size: clamp(26px, 6.5vw, 38px) !important;
      font-weight: 900 !important;
      -webkit-text-stroke: 0.5px #0b1120 !important;
      margin-bottom: 16px !important;
    }
    .team-hero-inner .breadcrumb {
      padding: 8px 20px !important;
    }
  }
  /* --- Section 2: Vidhyut Saathi Team Overview --- */
  .team-sec2-section {
    padding: clamp(60px, 8vw, 100px) 20px;
    background: #ffffff;
    position: relative;
  }
  .team-sec2-container {
    max-width: 1240px;
    margin: 0 auto;
  }
  .team-sec2-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .team-sec2-col-text {
    flex: 1 1 500px;
  }
  .team-sec2-col-img {
    flex: 1 1 450px;
    display: flex;
    justify-content: center;
  }

  /* Gradient Badge */
  .dream-dots {
    display: inline-block;
    margin-bottom: 16px;
  }
  .gradient-text.animate-charcter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(90deg, #ec5c0a 0%, #ff9a00 50%, #007b3e 100%);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 7px 18px;
    border-radius: 50px;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.25);
  }

  /* Heading & Text */
  .sec2-team-title {
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 900;
    color: #0b1120;
    line-height: 1.25;
    margin-bottom: 22px;
    letter-spacing: -0.5px;
  }
  .sec2-team-text {
    font-size: 1.02rem;
    line-height: 1.8;
    color: #334155;
    margin-bottom: 18px;
    text-align: justify;
  }

  /* 3D Image Frame */
  .welcome-meter {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
    border: 3px solid #ffffff;
    outline: 2px solid rgba(236, 92, 10, 0.2);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    background: #090e1a;
  }
  .welcome-meter:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 25px 50px rgba(236, 92, 10, 0.2);
  }
  .team-avatar-img {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }

  /* --- Section 3: Meet Our Awesome Team Grid --- */
  .team-sec3-section {
    padding: clamp(60px, 8vw, 100px) 20px;
    background: #fff8ef;
    position: relative;
  }
  .team-sec3-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  .team-sec3-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .team-sec3-header small {
    display: inline-block;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .team-sec3-header h2 {
    font-size: clamp(28px, 3.8vw, 46px);
    font-weight: 900;
    color: #0b1120;
    letter-spacing: -0.5px;
    line-height: 1.25;
  }

  .team-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  @media screen and (max-width: 1100px) {
    .team-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media screen and (max-width: 768px) {
    .team-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .team-sec3-header h2 {
      font-size: clamp(24px, 6vw, 32px) !important;
      font-weight: 900 !important;
      -webkit-text-stroke: 0.5px #0b1120 !important;
    }
  }
  @media screen and (max-width: 480px) {
    .team-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  /* Single Card Styling */
  .single-card {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0,0,0,0.06);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    display: flex;
    flex-direction: column;
  }
  .single-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(236, 92, 10, 0.15);
    border-color: rgba(236, 92, 10, 0.3);
  }

  .single-card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
    background: #f8fafc;
  }
  .single-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s ease;
  }
  .single-card:hover .single-card-image img {
    transform: scale(1.06);
  }

  /* Social Overlay List */
  .single-card-social {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    opacity: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    padding: 6px 12px;
    margin: 0;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 30px;
    transition: all 0.3s ease;
    z-index: 2;
  }
  .single-card:hover .single-card-social {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .single-card-social li a {
    color: #ffffff;
    font-size: 0.85rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.25s ease;
    background: rgba(255,255,255,0.12);
  }
  .single-card-social li a:hover {
    background: #ec5c0a;
    color: #ffffff;
    transform: scale(1.15);
  }

  /* Content */
  .single-card-content {
    padding: 16px 14px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .single-card-content h3 {
    font-size: 1.08rem;
    font-weight: 800;
    color: #0b1120;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .single-card-content p {
    font-size: 0.86rem;
    font-weight: 700;
    color: #ec5c0a;
    margin: 0;
    line-height: 1.4;
  }
{%- endstyle -%}

<div class="our-team-wrapper">
  
