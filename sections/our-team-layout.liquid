{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --team-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --team-secondary: #007b3e;
    --team-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --team-text-dark: #1a1a1a;
    --team-text-light: #4a4a4a;
    --team-radius: 16px;
    --team-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    --team-shadow-hover: 0 20px 40px rgba(236, 92, 10, 0.15);
  }
  
  .our-team-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--team-text-dark);
    background-color: var(--team-bg);
    overflow: hidden;
  }

  /* --- Typography --- */
  .team-section-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--team-text-dark);
  }
  .team-section-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--team-text-light);
  }
  
  /* --- Section 1: Our Team Hero Banner --- */
  .team-page-hero {
    position: relative;
    width: 100%;
    min-height: 480px;
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-position: center 25% !important;
    background-color: #090e1a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 70px 20px;
    box-sizing: border-box;
    image-rendering: -webkit-optimize-contrast;
    -webkit-backface-visibility: hidden;
  }

  .team-page-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(9, 14, 26, 0.75) 0%, rgba(9, 14, 26, 0.88) 100%);
    z-index: 1;
  }

  /* Moving Background Marquee Text */
  @keyframes teamMarqueeMove {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .team-marquee-track {
    position: absolute;
    top: 50%;
    left: 0;
    width: 200%;
    transform: translateY(-50%);
    z-index: 2;
    pointer-events: none;
    opacity: 0.22;
    overflow: hidden;
  }
  .team-marquee-content {
    display: inline-block;
    white-space: nowrap;
    font-size: clamp(55px, 9.5vw, 140px);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    background: linear-gradient(90deg, #ec5c0a, #ff9a00, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: teamMarqueeMove 20s linear infinite;
  }

  .team-hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .team-hero-inner h1.title {
    font-size: clamp(32px, 5.5vw, 58px);
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 22px;
    line-height: 1.25;
    text-shadow: 0 4px 20px rgba(0,0,0,0.6);
    letter-spacing: -0.5px;
  }

  .team-hero-inner .breadcumb--con {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .team-hero-inner .breadcrumb {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 10px 28px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.4);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    list-style: none;
    margin: 0 auto;
  }

  .team-hero-inner .breadcrumb-item {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .team-hero-inner .breadcrumb-item a {
    color: #ffcc00;
    text-decoration: none;
    font-weight: 800;
    transition: color 0.3s ease;
  }
  .team-hero-inner .breadcrumb-item a:hover {
    color: #00ff75;
  }

  .team-hero-inner .breadcrumb-item.active {
    color: #ffffff;
    font-weight: 700;
  }

  .team-hero-inner .breadcrumb-item + .breadcrumb-item::before {
    content: '/';
    color: rgba(255, 255, 255, 0.4);
    padding-right: 12px;
  }

  @media screen and (max-width: 768px) {
    .team-page-hero {
      min-height: 320px !important;
      padding: 45px 16px !important;
      background-size: cover !important;
      background-position: center 15% !important;
    }
    .team-marquee-content {
      font-size: clamp(32px, 8vw, 48px) !important;
      opacity: 0.28 !important;
    }
    .team-hero-inner h1.title {
      font-size: clamp(26px, 6.5vw, 38px) !important;
      font-weight: 900 !important;
      -webkit-text-stroke: 0.5px #0b1120 !important;
      margin-bottom: 16px !important;
    }
    .team-hero-inner .breadcrumb {
      padding: 8px 20px !important;
    }
  }
  /* --- Section 2: Vidhyut Saathi Team Overview --- */
  .team-sec2-section {
    padding: clamp(60px, 8vw, 100px) 20px;
    background: #ffffff;
    position: relative;
  }
  .team-sec2-container {
    max-width: 1240px;
    margin: 0 auto;
  }
  .team-sec2-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .team-sec2-col-text {
    flex: 1 1 500px;
  }
  .team-sec2-col-img {
    flex: 1 1 450px;
    display: flex;
    justify-content: center;
  }

  /* Gradient Badge */
  .dream-dots {
    display: inline-block;
    margin-bottom: 16px;
  }
  .gradient-text.animate-charcter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(90deg, #ec5c0a 0%, #ff9a00 50%, #007b3e 100%);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 7px 18px;
    border-radius: 50px;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.25);
  }

  /* Heading & Text */
  .sec2-team-title {
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 900;
    color: #0b1120;
    line-height: 1.25;
    margin-bottom: 22px;
    letter-spacing: -0.5px;
  }
  .sec2-team-text {
    font-size: 1.02rem;
    line-height: 1.8;
    color: #334155;
    margin-bottom: 18px;
    text-align: justify;
  }

  /* 3D Image Frame */
  .welcome-meter {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
    border: 3px solid #ffffff;
    outline: 2px solid rgba(236, 92, 10, 0.2);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    background: #090e1a;
  }
  .welcome-meter:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 25px 50px rgba(236, 92, 10, 0.2);
  }
  .team-avatar-img {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }

  @media screen and (max-width: 768px) {
    .team-sec2-row {
      flex-direction: column;
      gap: 30px;
    }
    .sec2-team-title {
      font-size: clamp(24px, 6vw, 32px) !important;
      font-weight: 900 !important;
      -webkit-text-stroke: 0.5px #0b1120 !important;
      text-align: center !important;
    }
    .dream-dots {
      display: flex;
      justify-content: center;
    }
    .sec2-team-text {
      font-size: 0.96rem !important;
      line-height: 1.7 !important;
      text-align: left !important;
    }
  }
{%- endstyle -%}

<div class="our-team-wrapper">
  
  <!-- Hero Section (Section 1: Our Team Showcase) -->
  {%- assign team_hero_bg_url = 'vidhyut-saathi-team-bg.jpg' | asset_url -%}

  <section class="team-page-hero" style="background-image: url('{{ team_hero_bg_url }}');">
    
    <!-- Moving Background Marquee Text -->
    <div class="team-marquee-track">
      <div class="team-marquee-content">Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team</div>
    </div>

    <div class="team-hero-inner">
      <div class="row h-100 align-items-center">
        <div class="col-12 text-center">
          <nav aria-label="breadcrumb" class="breadcumb--con text-center">
            <h1 class="w-text title wow fadeInUp" data-wow-delay="0.2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">
              Our Vidhyut Saathi Team
            </h1>
            <ol class="breadcrumb justify-content-center wow fadeInUp" data-wow-delay="0.4s" style="visibility: visible; animation-delay: 0.4s; animation-name: fadeInUp;">
              <li class="breadcrumb-item"><a href="/">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Team</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>

  </section>

  <!-- Section 2: Vidhyut Saathi Team Overview -->
  <section class="team-sec2-section">
    <div class="team-sec2-container">
      <div class="team-sec2-row">
        
        <!-- Text Side -->
        <div class="team-sec2-col-text heading-primary-sub">
          <div class="who-we-contant heading-primary-sub">
            
            <div class="dream-dots text-left fadeInUp" data-wow-delay="0.2s">
              <span class="gradient-text blue animate-charcter">⚡ VIDHYUT SAATHI TEAM</span>
            </div>

            <h4 class="sec2-team-title fadeInUp" data-wow-delay="0.3s">Vidhyut Saathi Team</h4>

            <p class="sec2-team-text fadeInUp" data-wow-delay="0.4s">
              Our expert team of Vidhyut Saathi dedicatedly done its work to help you get an amazing power saving card. They are rigorously investing their time, combining it with experience to create an exposure for many people who wants to foster this awesome idea of saving energy, money and nature. Our team has completed various training programs to implement the card and to help people switch towards energy saving products.
            </p>

            <p class="sec2-team-text fadeInUp" data-wow-delay="0.4s">
              As India is playing a very important role worldwide in saving power and fuel. Similarly, Vidhyut Saathi is also a positive contribution by our team to the power saving agenda of our nation. We are providing a certified and safe product and trying to convey our efforts for your comfort.
            </p>

          </div>
        </div>

        <!-- Image Side -->
        <div class="team-sec2-col-img heading-primary-main">
          <div class="welcome-meter heading-primary-main">
            {%- assign team_avatar_url = 'vidhyut-saathi-team-bg.jpg' | asset_url -%}
            <img src="{{ team_avatar_url }}" class="avatar team-avatar-img" decoding="async" loading="lazy" width="1000" height="1000" alt="Vidhyut Saathi Team">
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="team-intro">
    <h2 class="team-section-heading">{{ section.settings.intro_heading }}</h2>
    <div class="team-intro-text">
      {{ section.settings.intro_text }}
    </div>
  </section>

  <!-- Dynamic Team Grid -->
  <section class="team-members">
    {%- if section.blocks.size > 0 -%}
      <div class="team-grid">
        {%- for block in section.blocks -%}
          <div class="team-card" {{ block.shopify_attributes }}>
            <div class="team-image-box">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400, height: 440, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="team-info">
              <h3 class="team-name">{{ block.settings.name }}</h3>
              <p class="team-role">{{ block.settings.role }}</p>
              {%- if block.settings.bio != blank -%}
                <p class="team-bio">{{ block.settings.bio }}</p>
              {%- endif -%}
              {%- if block.settings.social_url != blank -%}
                <div class="team-social">
                  <a href="{{ block.settings.social_url }}" target="_blank" rel="noopener noreferrer">
                    View Profile <span>→</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="text-align: center; padding: 40px; color: var(--team-text-light); background: #ffffff; border-radius: var(--team-radius);">
        <p>Your team members will appear here. Add blocks in the Shopify Theme Editor.</p>
      </div>
    {%- endif -%}
  </section>

  <!-- What We Bring Section -->
  <section class="team-bring">
    <div class="bring-container">
      <h2 class="team-section-heading" style="text-align: center;">{{ section.settings.bring_heading }}</h2>
      <div class="bring-grid">
        <div class="bring-card">
          <div class="bring-icon">🏭</div>
          <h3>{{ section.settings.bring_1 }}</h3>
        </div>
        <div class="bring-card">
          <div class="bring-icon">⚙️</div>
          <h3>{{ section.settings.bring_2 }}</h3>
        </div>
        <div class="bring-card">
          <div class="bring-icon">📈</div>
          <h3>{{ section.settings.bring_3 }}</h3>
        </div>
        <div class="bring-card">
          <div class="bring-icon">🤝</div>
          <h3>{{ section.settings.bring_4 }}</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="team-cta">
    <div class="team-cta-content">
      <h2 class="team-section-heading">{{ section.settings.cta_heading }}</h2>
      <p class="team-section-subheading">{{ section.settings.cta_text }}</p>
      <a href="{{ section.settings.cta_link }}" class="team-btn">{{ section.settings.cta_btn_text }}</a>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Our Team Layout",
  "settings": [
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#ec5c0a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff8ef"
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Our Team"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "The people behind our vision, innovation and growth"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Company/Team Image"
    },
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Heading",
      "default": "Meet the Team Behind Vidhyut Saathi"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Introduction Text",
      "default": "<p>Behind Vidhyut Saathi Energy Savers Pvt. Ltd. is a dynamic team of industry experts, engineers, business strategists, and customer success professionals committed to driving sustainable growth. Our team works closely with every franchise partner, providing comprehensive training, technical expertise, sales support, and strategic marketing assistance to ensure long-term business success. We don't just supply products—we build profitable partnerships backed by innovation, transparency, and continuous guidance. With a customer-first approach and a passion for excellence, our professionals are dedicated to helping entrepreneurs expand confidently while delivering high-quality energy-saving solutions that create lasting value for homes, businesses, industries, and institutions across India.</p>"
    },
    {
      "type": "header",
      "content": "What We Bring Cards"
    },
    {
      "type": "text",
      "id": "bring_heading",
      "label": "Section Heading",
      "default": "What We Bring"
    },
    {
      "type": "text",
      "id": "bring_1",
      "label": "Card 1 Title",
      "default": "Industry Expertise"
    },
    {
      "type": "text",
      "id": "bring_2",
      "label": "Card 2 Title",
      "default": "Technical Excellence"
    },
    {
      "type": "text",
      "id": "bring_3",
      "label": "Card 3 Title",
      "default": "Business Strategy"
    },
    {
      "type": "text",
      "id": "bring_4",
      "label": "Card 4 Title",
      "default": "Customer Success"
    },
    {
      "type": "header",
      "content": "CTA Section"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Building Success Together"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Supporting Text",
      "default": "Partner with our team for continuous innovation, support, and long-term growth in the energy sector."
    },
    {
      "type": "text",
      "id": "cta_btn_text",
      "label": "Button Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Member Photo",
          "info": "Recommended: Square or portrait image."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Member Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Designation",
          "default": "Designation"
        },
        {
