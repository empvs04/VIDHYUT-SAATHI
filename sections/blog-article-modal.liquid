  function vsFilterArticles(catName, btnElem) {
    if (btnElem) {
      document.querySelectorAll('#vsblog_category_container .vsblog-cat-btn').forEach(function(b) {
        b.classList.remove('active');
      });
      btnElem.classList.add('active');
    }
    
    var cards = document.querySelectorAll('#vsblog_article_grid .vsblog-card');
    cards.forEach(function(card) {
      var cardCat = card.getAttribute('data-category');
      if (catName === 'all' || cardCat === catName) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function vsSearchArticles() {
    var searchInput = document.getElementById('vsblog_search_input');
    if (!searchInput) return;
    var searchVal = searchInput.value.toLowerCase();
    var cards = document.querySelectorAll('#vsblog_article_grid .vsblog-card');
    
    cards.forEach(function(card) {
      var title = (card.getAttribute('data-title') || '').toLowerCase();
      var cat = (card.getAttribute('data-category') || '').toLowerCase();
      if (title.indexOf(searchVal) !== -1 || cat.indexOf(searchVal) !== -1) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function vsOpenArticleModal(index) {
    var article = VS_ARTICLES[index] || VS_ARTICLES[0];
    var titleElem = document.getElementById('vsmodal_header_title');
    var catElem = document.getElementById('vsmodal_cat');
    var dateElem = document.getElementById('vsmodal_date');
    var authorElem = document.getElementById('vsmodal_author');
    var readTimeElem = document.getElementById('vsmodal_readtime');
    var htmlElem = document.getElementById('vsmodal_full_html');
    var topImgWrap = document.getElementById('vsmodal_top_img_wrap');
    var topImg = document.getElementById('vsmodal_top_img');

    var headerWrap = document.getElementById('vsmodal_header_wrap');
    if (titleElem) titleElem.innerText = article.title;
    if (headerWrap) {
      if (index === 0) {
        headerWrap.style.display = 'none';
      } else {
        headerWrap.style.display = 'block';
      }
    }
    if (catElem) catElem.innerHTML = '<i class="fa-solid fa-bolt"></i> ' + article.category;
    if (dateElem) dateElem.innerText = article.date;
    if (authorElem) authorElem.innerText = article.author;
    if (readTimeElem) readTimeElem.innerText = article.readTime;
    if (htmlElem) htmlElem.innerHTML = article.html;
    
    // Top Featured Image handling
    var customImg = document.getElementById('vsblog_featured_custom_img') || document.querySelector('.vsblog-feat-img img');
    if (index === 0 && customImg && customImg.src && customImg.src.indexOf('svg') === -1) {
      if (topImg && topImgWrap) {
        topImg.src = customImg.src;
        topImgWrap.style.display = 'block';
      }
    } else if (article.image) {
      if (topImg && topImgWrap) {
        topImg.src = article.image;
        topImgWrap.style.display = 'block';
      }
    } else {
      if (topImgWrap) {
        topImgWrap.style.display = 'none';
      }
    }
    
    var overlay = document.getElementById('vsblog_modal_overlay');
    if (overlay) {
      overlay.scrollTop = 0;
      overlay.classList.add('active');
    }
    var prog = document.getElementById('vs_reader_progress');
    if (prog) prog.style.width = '0%';
    document.body.style.overflow = 'hidden';
  }

  function vsCloseArticleModal(e) {
    var overlay = document.getElementById('vsblog_modal_overlay');
    if (overlay) overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  function vsShareCurrentArticle() {
    var title = document.getElementById('vsmodal_header_title') ? document.getElementById('vsmodal_header_title').innerText : 'Vidhyut Saathi Article';
    var shareBtn = document.querySelector('.vs-reader-share-btn');
    var shareText = document.querySelector('.vs-share-btn-text');
    
    if (navigator.share) {
      navigator.share({
        title: title,
        text: 'Check out this energy saving guide from Vidhyut Saathi: ' + title,
        url: window.location.href
      }).catch(function() {});
    } else if (navigator.clipboard) {
      navigator.clipboard.writeText(window.location.href).then(function() {
        if (shareText) {
          var original = shareText.innerText;
          shareText.innerText = 'Link Copied!';
          setTimeout(function() {
            shareText.innerText = original;
          }, 2000);
        }
      });
    }
  }

  // Reading progress tracking on full-page scroll
  document.addEventListener('DOMContentLoaded', function() {
    var overlay = document.getElementById('vsblog_modal_overlay');
    var progressLine = document.getElementById('vs_reader_progress');
    if (overlay && progressLine) {
      overlay.addEventListener('scroll', function() {
        var scrollH = overlay.scrollHeight - overlay.clientHeight;
        if (scrollH > 0) {
          var pct = (overlay.scrollTop / scrollH) * 100;
          progressLine.style.width = Math.min(100, Math.max(0, pct)) + '%';
        }
      }, { passive: true });
    }
  });

  function vsSubscribeNewsletter(e) {
    if (e && e.preventDefault) e.preventDefault();
    var emailInput = document.getElementById('vsblog_nl_email');
    var msg = document.getElementById('vsblog_nl_msg');
    if (emailInput && msg) {
      var email = emailInput.value;
      if (email) {
        msg.innerHTML = '<i class="fa-solid fa-circle-check"></i> Thank you! You have successfully subscribed to Vidhyut Saathi updates.';
        emailInput.value = '';
      }
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      vsCloseArticleModal();
    }
  });
</script>

