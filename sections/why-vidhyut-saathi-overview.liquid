{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 2: PERFECTLY ALIGNED & CENTERED SECTORS
     ========================================================================== */

  .wvs-sec2-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background-color: #ffffff;
    padding: clamp(50px, 6vw, 90px) 20px;
    overflow: hidden;
    color: #0b2545;
  }

  .wvs-sec2-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- 1. EQUAL HEIGHT SPLIT ROW --- */
  .wvs-split-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    margin-bottom: 60px;
    min-height: 480px;
  }

  /* Left Side Column */
  .wvs-split-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    height: 100%;
  }

  .wvs-sec2-badge {
    display: inline-block;
    padding: 6px 18px;
    background: #eedbc5;
    color: #8c5d26;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 6px;
    margin-bottom: 20px;
  }

  .wvs-sec2-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(34px, 4.2vw, 56px);
    font-weight: 800;
    line-height: 1.18;
    color: #0f2c4a;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }

  .wvs-sec2-title span {
    color: #ec5c0a;
  }

  .wvs-sec2-desc {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    color: #4a5568;
    margin-bottom: 24px;
  }

  .wvs-sec2-highlight {
    background: #f8fafc;
    border-left: 4px solid #007b3e;
    border-radius: 0 12px 12px 0;
    padding: 14px 18px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #2d3748;
    margin-bottom: 28px;
  }

  .wvs-sec2-highlight strong {
    color: #007b3e;
  }

  .wvs-sec2-action {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .wvs-action-arrow {
    position: absolute;
    left: -40px;
    top: -20px;
    width: 36px;
    height: 36px;
    pointer-events: none;
  }

  .wvs-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 34px;
    background: #091d34;
    color: #eedbc5;
    font-size: 1rem;
    font-weight: 800;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(9, 29, 52, 0.2);
    transition: all 0.3s ease;
  }

  .wvs-btn-primary:hover {
    background: #ec5c0a;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.3);
  }

  /* Right Side Column (Matching Height & Centered Character) */
  .wvs-split-right {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    height: 100%;
    min-height: 460px;
  }

  .wvs-petals-bg {
    position: absolute;
    width: 380px;
    height: 380px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .wvs-p1 {
    position: absolute;
    width: 190px;
    height: 190px;
    background: #0b2545;
    border-radius: 0 90px 0 90px;
    top: 10px;
    left: 30px;
    transform: rotate(-15deg);
  }

  .wvs-p2 {
    position: absolute;
    width: 180px;
    height: 180px;
    background: #eedbc5;
    border-radius: 90px 0 90px 0;
    bottom: 20px;
    right: 20px;
    transform: rotate(20deg);
  }

  .wvs-p3 {
    position: absolute;
    width: 160px;
    height: 160px;
    background: #d8f3dc;
    border-radius: 0 90px 0 90px;
    bottom: 30px;
    left: 10px;
    transform: rotate(45deg);
    opacity: 0.85;
  }

  .wvs-char-box {
    position: relative;
    z-index: 2;
    max-width: 360px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .wvs-char-img {
    width: 100%;
    max-height: 440px;
    object-fit: contain;
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.15));
  }

  .wvs-float-badge-1 {
    position: absolute;
    top: 30px;
    right: -10px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(236, 92, 10, 0.25);
    border-radius: 12px;
    padding: 8px 16px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0b2545;
  }

  .wvs-float-badge-2 {
    position: absolute;
    bottom: 40px;
    left: -15px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 123, 62, 0.25);
    border-radius: 12px;
    padding: 8px 16px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #0b2545;
  }

  /* --- 2. CENTERED ELECTRICITY CONSUMPTION SECTORS SHOWCASE --- */
  .wvs-sectors-centerpiece {
    background: linear-gradient(135deg, #fffbf5 0%, #ffffff 50%, #f0fdf4 100%);
    border: 2px solid rgba(236, 92, 10, 0.15);
    border-radius: 28px;
    padding: clamp(30px, 4vw, 50px) 24px;
    margin-bottom: 50px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
  }

  .wvs-center-head {
    max-width: 700px;
    margin: 0 auto 36px auto;
  }

  .wvs-center-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: rgba(236, 92, 10, 0.1);
    border: 1px solid rgba(236, 92, 10, 0.3);
    border-radius: 50px;
    color: #ec5c0a;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .wvs-center-title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 10px;
  }

  .wvs-center-subtitle {
    font-size: 1.05rem;
    color: #64748b;
    margin: 0;
  }

  .wvs-center-sectors-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
  }

  .wvs-center-sector-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    padding: 22px 10px;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .wvs-center-sector-card:hover {
    transform: translateY(-8px);
    border-color: #ec5c0a;
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.18);
    background: #fff7ed;
  }

  .wvs-center-sector-card i {
    font-size: 2.2rem;
    color: #ec5c0a;
    margin-bottom: 12px;
    display: inline-block;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .wvs-center-sector-card:hover i {
    transform: scale(1.15);
    color: #007b3e;
  }

  .wvs-center-sector-card h5 {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }

  /* --- 3. 4 PILLARS & TAGLINE STRIP --- */
  .wvs-pillars-bar {
    background: #091d34;
    border-radius: 24px;
    padding: 30px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
    color: #ffffff;
    margin-bottom: 30px;
    box-shadow: 0 12px 35px rgba(9, 29, 52, 0.25);
  }

  .wvs-pillar-box h6 {
    font-size: 1.1rem;
    font-weight: 900;
    color: #ffcc00;
    margin: 0 0 6px 0;
    letter-spacing: 1px;
  }

  .wvs-pillar-box p {
    font-size: 0.88rem;
    color: #cbd5e1;
    margin: 0;
    font-weight: 600;
  }

  .wvs-tagline-banner {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 45%, #007b3e 100%);
    border-radius: 20px;
    padding: 24px 30px;
    text-align: center;
    color: #ffffff;
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 900;
    letter-spacing: 1.5px;
    box-shadow: 0 12px 35px rgba(236, 92, 10, 0.25);
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 991px) {
    .wvs-split-row {
      grid-template-columns: 1fr;
      text-align: center;
      min-height: auto;
    }
    .wvs-split-left {
      align-items: center;
    }
    .wvs-sec2-action {
      justify-content: center;
    }
    .wvs-action-arrow {
      display: none;
    }
    .wvs-pillars-bar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wvs-pillars-bar {
      grid-template-columns: 1fr;
    }
    .wvs-petals-bg {
      width: 300px;
      height: 300px;
    }
    .wvs-float-badge-1, .wvs-float-badge-2 {
      display: none;
    }
  }
{%- endstyle -%}

<div class="wvs-sec2-wrapper">
  <div class="wvs-sec2-container">
    <!-- 1. EQUAL HEIGHT SPLIT HERO ROW -->
    <div class="wvs-split-row">
      <!-- LEFT COLUMN -->
      <div class="wvs-split-left">
        <div class="wvs-sec2-badge">
          {{ section.settings.badge_text | default: "WHY VIDHYUT SAATHI" }}
        </div>

        <h2 class="wvs-sec2-title">
          {{ section.settings.heading_main | default: "Electricity is everywhere. Opportunity is unlimited." }}
        </h2>

        <p class="wvs-sec2-desc">
          {{ section.settings.description | default: "Everywhere electricity is consumed, there is an opportunity to introduce smarter energy-saving solutions. Vidhyut Saathi brings together an innovative Electric Saver Card, a growing national brand and a structured district-level franchise business model to help ambitious entrepreneurs build and grow their own local market." }}
        </p>

        <div class="wvs-sec2-highlight">
          With product support, branding, marketing assistance, training and business guidance, you get more than a franchise—you get an <strong>ecosystem designed to help you build your market.</strong>
        </div>

        <div class="wvs-sec2-action">
          <svg class="wvs-action-arrow" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 15 Q 25 35, 40 25 M 32 18 L 40 25 L 35 32" stroke="#4a5568" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>

          <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="wvs-btn-primary">
            <span>Get Started</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <!-- RIGHT COLUMN (CONTAINED & CENTERED) -->
      <div class="wvs-split-right">
        <!-- Abstract Petal Shapes Backdrop -->
        <div class="wvs-petals-bg">
          <div class="wvs-p1"></div>
          <div class="wvs-p2"></div>
          <div class="wvs-p3"></div>
        </div>

        <!-- Floating Badges -->
        <div class="wvs-float-badge-1">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Product + Brand</span>
        </div>

        <div class="wvs-float-badge-2">
          <i class="fa-solid fa-chart-line"></i>
          <span>Market + Support</span>
        </div>

        <!-- Character Image -->
        <div class="wvs-char-box">
          <img 
            src="{{ 'indian_entrepreneur.jpg' | asset_url }}" 
            alt="Vidhyut Saathi Business Partner" 
            class="wvs-char-img"
            loading="lazy"
          >
        </div>
      </div>
    </div>

    <!-- 2. CENTERED ELECTRICITY CONSUMPTION SECTORS SHOWCASE -->
    <div class="wvs-sectors-centerpiece">
      <div class="wvs-center-head">
        <div class="wvs-center-badge">
          <i class="fa-solid fa-bolt"></i>
          <span>HIGH SAVINGS DEMAND</span>
        </div>
        <h3 class="wvs-center-title">7 Electricity Consumption Sectors</h3>
        <p class="wvs-center-subtitle">
          Every place that consumes electricity represents a high-potential customer market for Vidhyut Saathi.
        </p>
      </div>

      <div class="wvs-center-sectors-grid">
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-house-chimney"></i>
          <h5>Homes</h5>
        </div>
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-store"></i>
          <h5>Shops</h5>
        </div>
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-building"></i>
          <h5>Offices</h5>
        </div>
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-industry"></i>
          <h5>Factories</h5>
        </div>
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-hotel"></i>
          <h5>Hotels</h5>
        </div>
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-hospital"></i>
          <h5>Hospitals</h5>
        </div>
        <div class="wvs-center-sector-card">
          <i class="fa-solid fa-school"></i>
          <h5>Institutions</h5>
        </div>
      </div>
    </div>

    <!-- 3. 4-PILLAR ECOSYSTEM BAR -->
    <div class="wvs-pillars-bar">
      <div class="wvs-pillar-box">
        <h6>📦 PRODUCT</h6>
        <p>Innovative Electric Saver Card</p>
      </div>
      <div class="wvs-pillar-box">
        <h6>🏷️ BRAND</h6>
        <p>Growing National Energy Brand</p>
      </div>
      <div class="wvs-pillar-box">
        <h6>📊 MARKET</h6>
        <p>District-Level Business Model</p>
      </div>
      <div class="wvs-pillar-box">
        <h6>🤝 SUPPORT</h6>
        <p>Training, Marketing & Guidance</p>
      </div>
    </div>

    <!-- 4. TAGLINE BANNER -->
    <div class="wvs-tagline-banner">
      YOUR DISTRICT. YOUR BUSINESS. YOUR OPPORTUNITY.
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Section 2",
  "tag": "section",
  "class": "section-why-vidhyut-sec2",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "WHY VIDHYUT SAATHI"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Main Heading",
      "default": "Electricity is everywhere. Opportunity is unlimited."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Everywhere electricity is consumed, there is an opportunity to introduce smarter energy-saving solutions. Vidhyut Saathi brings together an innovative Electric Saver Card, a growing national brand and a structured district-level franchise business model to help ambitious entrepreneurs build and grow their own local market."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Section 2"
    }
  ]
}
{% endschema %}
