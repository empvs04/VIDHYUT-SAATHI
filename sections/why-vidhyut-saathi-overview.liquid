{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 2: LUCRATIVE SPLIT LAYOUT (MATCHING REFERENCE)
     ========================================================================== */

  .wvs-ref-section {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background-color: #ffffff;
    padding: clamp(60px, 8vw, 110px) 20px;
    overflow: hidden;
    color: #0b2545;
  }

  /* Background Outline Leaf Vectors */
  .wvs-ref-bg-vector-left {
    position: absolute;
    top: 5%;
    left: -40px;
    width: 280px;
    height: 280px;
    opacity: 0.12;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-ref-bg-vector-bottom {
    position: absolute;
    bottom: -30px;
    left: 10%;
    width: 320px;
    height: 320px;
    opacity: 0.08;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-ref-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  /* --- LEFT COLUMN: CONTENT --- */
  .wvs-ref-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Top Badge Pill */
  .wvs-ref-badge {
    display: inline-block;
    padding: 6px 18px;
    background: #eedbc5;
    color: #8c5d26;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 6px;
    margin-bottom: 22px;
  }

  /* Large Main Title */
  .wvs-ref-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(38px, 4.8vw, 64px);
    font-weight: 800;
    line-height: 1.15;
    color: #0f2c4a;
    margin-bottom: 24px;
    letter-spacing: -0.5px;
  }

  .wvs-ref-title span {
    color: #ec5c0a;
  }

  /* Subtitle & Paragraph Content */
  .wvs-ref-description {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.65;
    color: #4a5568;
    margin-bottom: 28px;
    max-width: 540px;
  }

  .wvs-ref-highlight-text {
    background: #f8fafc;
    border-left: 4px solid #007b3e;
    border-radius: 0 12px 12px 0;
    padding: 16px 20px;
    font-size: 0.98rem;
    line-height: 1.6;
    color: #2d3748;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }

  .wvs-ref-highlight-text strong {
    color: #007b3e;
  }

  /* Sector Chips Grid (7 Places) */
  .wvs-ref-sectors-label {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #a0aec0;
    margin-bottom: 12px;
  }

  .wvs-ref-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .wvs-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #edf2f7;
    border-radius: 50px;
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #2d3748;
    transition: all 0.2s ease;
  }

  .wvs-chip:hover {
    background: #ec5c0a;
    color: #ffffff;
  }

  .wvs-chip i {
    font-size: 0.85rem;
    color: #ec5c0a;
  }

  .wvs-chip:hover i {
    color: #ffffff;
  }

  /* Action Area with Hand-drawn Doodle Arrow */
  .wvs-ref-action-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .wvs-doodle-arrow {
    position: absolute;
    left: -45px;
    top: -25px;
    width: 42px;
    height: 42px;
    pointer-events: none;
  }

  .wvs-ref-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 36px;
    background: #091d34;
    color: #eedbc5;
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(9, 29, 52, 0.25);
    transition: all 0.3s ease;
  }

  .wvs-ref-btn:hover {
    background: #ec5c0a;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(236, 92, 10, 0.3);
  }

  /* --- RIGHT COLUMN: CHARACTER & ABSTRACT PETAL BACKDROP --- */
  .wvs-ref-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 520px;
  }

  /* Abstract Petal Graphics Backdrop */
  .wvs-petals-backdrop {
    position: absolute;
    width: 460px;
    height: 460px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  /* Individual Stylized Leaves matching the screenshot */
  .wvs-petal-1 {
    position: absolute;
    width: 220px;
    height: 220px;
    background: #0b2545;
    border-radius: 0 100px 0 100px;
    top: 15px;
    left: 40px;
    transform: rotate(-15deg);
  }

  .wvs-petal-2 {
    position: absolute;
    width: 210px;
    height: 210px;
    background: #eedbc5;
    border-radius: 100px 0 100px 0;
    bottom: 25px;
    right: 20px;
    transform: rotate(20deg);
  }

  .wvs-petal-3 {
    position: absolute;
    width: 190px;
    height: 190px;
    background: #d8f3dc;
    border-radius: 0 100px 0 100px;
    bottom: 40px;
    left: 10px;
    transform: rotate(45deg);
    opacity: 0.85;
  }

  .wvs-petal-4 {
    position: absolute;
    width: 180px;
    height: 180px;
    background: #f7fafc;
    border-radius: 100px 0 100px 0;
    top: 30px;
    right: 30px;
    transform: rotate(-30deg);
  }

  /* Character Image Frame */
  .wvs-character-frame {
    position: relative;
    z-index: 2;
    max-width: 420px;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .wvs-character-img {
    width: 100%;
    max-width: 380px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.15));
    transition: transform 0.4s ease;
  }

  .wvs-character-frame:hover .wvs-character-img {
    transform: scale(1.02);
  }

  /* Floating 4-Pillar Glass Cards around Character */
  .wvs-floating-badge {
    position: absolute;
    z-index: 3;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 14px;
    padding: 10px 18px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    font-weight: 800;
    color: #0b2545;
  }

  .wvs-badge-top-right {
    top: 40px;
    right: -10px;
    animation: wvs-float-slow 4s ease-in-out infinite;
  }

  .wvs-badge-bottom-left {
    bottom: 50px;
    left: -20px;
    animation: wvs-float-slow 4s ease-in-out infinite 2s;
  }

  .wvs-floating-badge i {
    color: #ec5c0a;
    font-size: 1.1rem;
  }

  @keyframes wvs-float-slow {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }

  /* Bottom 4 Pillars Bar */
  .wvs-ref-pillars-bar {
    grid-column: 1 / -1;
    margin-top: 20px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px 30px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
  }

  .wvs-pillar-box h6 {
    font-size: 1.05rem;
    font-weight: 900;
    color: #0b2545;
    margin: 0 0 4px 0;
    letter-spacing: 1px;
  }

  .wvs-pillar-box p {
    font-size: 0.85rem;
    color: #718096;
    margin: 0;
    font-weight: 600;
  }

  /* Tagline Strip */
  .wvs-ref-tagline-strip {
    grid-column: 1 / -1;
    background: linear-gradient(90deg, #0b2545 0%, #007b3e 50%, #ec5c0a 100%);
    border-radius: 16px;
    padding: 20px 30px;
    text-align: center;
    color: #ffffff;
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 900;
    letter-spacing: 1.5px;
    box-shadow: 0 10px 30px rgba(11, 37, 69, 0.2);
  }

  /* Responsive Layout */
  @media (max-width: 991px) {
    .wvs-ref-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .wvs-ref-left {
      align-items: center;
    }
    .wvs-ref-description {
      max-width: 100%;
    }
    .wvs-ref-chips {
      justify-content: center;
    }
    .wvs-ref-action-wrap {
      justify-content: center;
    }
    .wvs-doodle-arrow {
      display: none;
    }
    .wvs-ref-pillars-bar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .wvs-ref-pillars-bar {
      grid-template-columns: 1fr;
    }
    .wvs-petals-backdrop {
      width: 320px;
      height: 320px;
    }
    .wvs-badge-top-right, .wvs-badge-bottom-left {
      display: none;
    }
  }
{%- endstyle -%}

<div class="wvs-ref-section">
  <!-- Background Vector Leaf Outlines -->
  <svg class="wvs-ref-bg-vector-left" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M100 10C50 10 10 50 10 100C10 150 50 190 100 190C150 190 190 150 190 100C190 50 150 10 100 10Z" stroke="#ec5c0a" stroke-width="2" stroke-dasharray="4 4"/>
  </svg>

  <div class="wvs-ref-container">
    <!-- LEFT COLUMN: CONTENT -->
    <div class="wvs-ref-left">
      <!-- Badge Pill -->
      <div class="wvs-ref-badge">
        {{ section.settings.badge_text | default: "WHY VIDHYUT SAATHI" }}
      </div>

      <!-- Main Title -->
      <h2 class="wvs-ref-title">
        {{ section.settings.heading_main | default: "Electricity is everywhere. Opportunity is unlimited." }}
      </h2>

      <!-- Description Paragraph -->
      <p class="wvs-ref-description">
        {{ section.settings.description | default: "Homes. Shops. Offices. Factories. Hotels. Hospitals. Institutions. Everywhere electricity is consumed, there is an opportunity to introduce smarter energy-saving solutions. Vidhyut Saathi is building that opportunity — one district at a time." }}
      </p>

      <!-- Highlight Card -->
      <div class="wvs-ref-highlight-text">
        Vidhyut Saathi brings together an <strong>innovative Electric Saver Card</strong>, a growing national brand and a structured district-level franchise business model to help ambitious entrepreneurs build and grow their own local market.
      </div>

      <!-- Sector Chips -->
      <div class="wvs-ref-sectors-label">Electricity Consumption Sectors</div>
      <div class="wvs-ref-chips">
        <span class="wvs-chip"><i class="fa-solid fa-house"></i> Homes</span>
        <span class="wvs-chip"><i class="fa-solid fa-store"></i> Shops</span>
        <span class="wvs-chip"><i class="fa-solid fa-building"></i> Offices</span>
        <span class="wvs-chip"><i class="fa-solid fa-industry"></i> Factories</span>
        <span class="wvs-chip"><i class="fa-solid fa-hotel"></i> Hotels</span>
        <span class="wvs-chip"><i class="fa-solid fa-hospital"></i> Hospitals</span>
        <span class="wvs-chip"><i class="fa-solid fa-school"></i> Institutions</span>
      </div>

      <!-- Action Button with Hand-drawn Doodle Arrow -->
      <div class="wvs-ref-action-wrap">
        <!-- SVG Hand-drawn Arrow -->
        <svg class="wvs-doodle-arrow" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 15 Q 25 35, 40 25 M 32 18 L 40 25 L 35 32" stroke="#4a5568" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

        <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="wvs-ref-btn">
          <span>Get Started</span>
        </a>
      </div>
    </div>

    <!-- RIGHT COLUMN: CHARACTER & ABSTRACT PETAL BACKDROP -->
    <div class="wvs-ref-right">
      <!-- Multi-Colored Petals Backdrop -->
      <div class="wvs-petals-backdrop">
        <div class="wvs-petal-1"></div>
        <div class="wvs-petal-2"></div>
        <div class="wvs-petal-3"></div>
        <div class="wvs-petal-4"></div>
      </div>

      <!-- Floating Feature Badges -->
      <div class="wvs-floating-badge wvs-badge-top-right">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Product + Brand</span>
      </div>

      <div class="wvs-floating-badge wvs-badge-bottom-left">
        <i class="fa-solid fa-chart-line"></i>
        <span>Market + Support</span>
      </div>

      <!-- Character Image -->
      <div class="wvs-character-frame">
        <img 
          src="{{ 'indian_entrepreneur.jpg' | asset_url }}" 
          alt="Vidhyut Saathi Entrepreneur" 
          class="wvs-character-img"
          loading="lazy"
        >
      </div>
    </div>

    <!-- 4 PILLARS BAR BELOW -->
    <div class="wvs-ref-pillars-bar">
      <div class="wvs-pillar-box">
        <h6>📦 PRODUCT</h6>
        <p>Innovative Electric Saver Card</p>
      </div>
      <div class="wvs-pillar-box">
        <h6>🏷️ BRAND</h6>
        <p>Growing National Energy Brand</p>
      </div>
      <div class="wvs-pillar-box">
        <h6>📊 MARKET</h6>
        <p>District-Level Business Model</p>
      </div>
      <div class="wvs-pillar-box">
        <h6>🤝 SUPPORT</h6>
        <p>Training, Marketing & Guidance</p>
      </div>
    </div>

    <!-- TAGLINE STRIP -->
    <div class="wvs-ref-tagline-strip">
      YOUR DISTRICT. YOUR BUSINESS. YOUR OPPORTUNITY.
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Section 2",
  "tag": "section",
  "class": "section-why-vidhyut-ref-overview",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "WHY VIDHYUT SAATHI"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Main Heading",
      "default": "Electricity is everywhere. Opportunity is unlimited."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Homes. Shops. Offices. Factories. Hotels. Hospitals. Institutions. Everywhere electricity is consumed, there is an opportunity to introduce smarter energy-saving solutions. Vidhyut Saathi is building that opportunity — one district at a time."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Section 2"
    }
  ]
}
{% endschema %}
