{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 2: PERFECTLY ALIGNED & CENTERED SECTORS
     ========================================================================== */

  .wvs-sec2-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background-color: #ffffff;
    padding: clamp(50px, 6vw, 90px) 20px;
    overflow: hidden;
    color: #0b2545;
  }

  .wvs-sec2-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- 1. EQUAL HEIGHT SPLIT ROW --- */
  .wvs-split-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    margin-bottom: 60px;
    min-height: 480px;
  }

  /* Left Side Column */
  .wvs-split-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    height: 100%;
  }

  .wvs-sec2-badge {
    display: inline-block;
    padding: 6px 18px;
    background: #FFF7ED;
    border: 1px solid #F17022;
    color: #F17022;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 6px;
    margin-bottom: 20px;
  }

  .wvs-sec2-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 800;
    line-height: 1.25;
    color: #231F20;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
  }

  .wvs-sec2-title .wvs-line-1 {
    display: block;
    white-space: nowrap;
    color: #111111;
    font-weight: 900;
    letter-spacing: -0.5px;
  }

  .wvs-sec2-title .wvs-line-2 {
    display: block;
    white-space: nowrap;
    color: #F17022;
    font-weight: 900;
    letter-spacing: -0.5px;
  }

  .wvs-text-orange {
    color: #F17022;
    font-weight: 800;
  }

  .wvs-text-green {
    color: #009A44;
    font-weight: 800;
  }

  .wvs-num-highlight {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: #F17022;
    color: #ffffff;
    border-radius: 50%;
    font-weight: 800;
    font-size: 1.2rem;
    box-shadow: 0 6px 18px rgba(241, 112, 34, 0.25);
    margin-right: 10px;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .wvs-sec2-desc {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    color: #231F20;
    margin-bottom: 24px;
  }

  .wvs-sec2-highlight {
    background: #f8fafc;
    border-left: 4px solid #009A44;
    border-radius: 0 12px 12px 0;
    padding: 14px 18px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #231F20;
    margin-bottom: 28px;
  }

  .wvs-sec2-highlight strong {
    color: #009A44;
  }

  .wvs-sec2-action {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .wvs-action-arrow {
    position: absolute;
    left: -40px;
    top: -20px;
    width: 36px;
    height: 36px;
    pointer-events: none;
  }

  .wvs-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 36px;
    background: linear-gradient(135deg, #009A44 0%, #00b853 100%);
    border: 2px solid #FDBA00;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 900;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 12px 35px rgba(0, 154, 68, 0.35);
    transition: all 0.35s ease;
  }

  .wvs-btn-primary span {
    color: #ffffff;
  }

  .wvs-btn-primary:hover {
    background: linear-gradient(135deg, #00b853 0%, #25D300 100%);
    border-color: #ffffff;
    color: #ffffff;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 18px 45px rgba(37, 211, 0, 0.4);
  }

  /* Right Side Column */
  .wvs-split-right {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    height: 100%;
    min-height: 460px;
  }

  .wvs-petals-bg {
    position: absolute;
    width: 380px;
    height: 380px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .wvs-p1 {
    position: absolute;
    width: 190px;
    height: 190px;
    background: #009A44;
    border-radius: 0 90px 0 90px;
    top: 10px;
    left: 30px;
    transform: rotate(-15deg);
    opacity: 0.85;
  }

  .wvs-p2 {
    position: absolute;
    width: 180px;
    height: 180px;
    background: #F17022;
    border-radius: 90px 0 90px 0;
    bottom: 20px;
    right: 20px;
    transform: rotate(20deg);
    opacity: 0.85;
  }

  .wvs-p3 {
    position: absolute;
    width: 160px;
    height: 160px;
    background: #FDBA00;
    border-radius: 0 90px 0 90px;
    bottom: 30px;
    left: 10px;
    transform: rotate(45deg);
    opacity: 0.85;
  }

  .wvs-char-box {
    position: relative;
    z-index: 2;
    max-width: 360px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .wvs-char-img {
    width: 100%;
    max-height: 440px;
    object-fit: contain;
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.15));
  }

  .wvs-float-badge-1 {
    position: absolute;
    top: 30px;
    right: -10px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #F17022;
    border-radius: 12px;
    padding: 8px 16px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #231F20;
  }

  .wvs-float-badge-2 {
    position: absolute;
    bottom: 40px;
    left: -15px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #009A44;
    border-radius: 12px;
    padding: 8px 16px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #231F20;
  }

  /* --- 2. ELECTRICITY CONSUMPTION SECTORS SHOWCASE (2-COLUMN WITH POINTING LADY) --- */
  .wvs-sectors-centerpiece {
    background: #ffffff;
    border: 2.5px solid #F17022;
    border-radius: 32px;
    padding: clamp(24px, 3.5vw, 42px);
    margin-bottom: 50px;
    box-shadow: 0 18px 45px rgba(241, 112, 34, 0.12);
  }

  .wvs-sectors-split-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    align-items: center;
  }

  .wvs-sectors-lady-col {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .wvs-lady-popout-wrap {
    position: relative;
    width: 100%;
    max-width: 320px;
    height: 420px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  /* Radial Ambient Glow backdrop behind presenter woman */
  .wvs-lady-popout-wrap::before {
    content: '';
    position: absolute;
    bottom: 10px;
    width: 90%;
    height: 75%;
    background: radial-gradient(circle at 50% 50%, rgba(241, 112, 34, 0.25) 0%, rgba(0, 154, 68, 0.18) 55%, transparent 80%);
    border-radius: 50%;
    filter: blur(28px);
    z-index: 0;
    pointer-events: none;
  }

  .wvs-lady-desktop-only {
    display: block !important;
  }
  .wvs-lady-mobile-only {
    display: none !important;
  }
  .wvs-lady-desktop-only-inline {
    display: inline-block !important;
  }
  .wvs-lady-mobile-only-inline {
    display: none !important;
  }

  .wvs-lady-real-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    display: block;
    filter: drop-shadow(0 18px 30px rgba(15, 23, 42, 0.22));
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), filter 0.4s ease;
  }

  .wvs-lady-popout-wrap:hover .wvs-lady-real-img {
    transform: scale(1.05) translateY(-8px);
    filter: drop-shadow(0 25px 40px rgba(241, 112, 34, 0.35));
  }

  .wvs-lady-floating-pill {
    position: absolute;
    bottom: 8px;
    z-index: 3;
    background: linear-gradient(135deg, #F17022 0%, #ec5c0a 100%);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 900;
    padding: 9px 20px;
    border-radius: 50px;
    box-shadow: 0 8px 22px rgba(241, 112, 34, 0.45);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.8px;
    border: 2.5px solid #ffffff;
    transition: transform 0.3s ease;
  }

  .wvs-lady-popout-wrap:hover .wvs-lady-floating-pill {
    transform: translateY(-4px);
  }

  .wvs-sectors-content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .wvs-sectors-content-col .wvs-center-head {
    margin-left: 0;
    margin-right: 0;
    text-align: left;
    max-width: 100%;
    margin-bottom: 24px;
  }

  .wvs-center-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: #FFF7ED;
    border: 1px solid #F17022;
    border-radius: 50px;
    color: #F17022;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .wvs-center-title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 900;
    color: #231F20;
    margin-bottom: 10px;
  }

  .wvs-center-subtitle {
    font-size: 1.05rem;
    color: #475569;
    margin: 0;
  }

  .wvs-center-sectors-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
  }

  @media (max-width: 1200px) {
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 991px) {
    .wvs-sectors-split-row {
      grid-template-columns: 1fr;
    }
    .wvs-sectors-lady-col {
      order: 1;
    }
    .wvs-sectors-content-col {
      order: 2;
      text-align: center;
    }
    .wvs-sectors-content-col .wvs-center-head {
      text-align: center;
    }
    .wvs-lady-img-card {
      height: 320px;
    }
    .wvs-pillars-bar {
      display: none !important;
    }
    body .wvs-mobile-4pillars-stack,
    .wvs-mobile-4pillars-stack {
      display: flex !important;
      flex-direction: column;
      gap: 14px;
      width: 100%;
      margin-bottom: 25px;
    }
    .wvs-m-pillar-card {
      background: linear-gradient(135deg, #ffffff 0%, #f7fdf9 100%);
      border: 2px solid #86efac;
      border-radius: 24px;
      padding: 16px 14px;
      display: grid;
      grid-template-columns: 74px 1fr;
      gap: 12px;
      align-items: center;
      box-shadow: 0 10px 30px rgba(0, 154, 68, 0.12), 0 0 15px rgba(241, 112, 34, 0.05);
      position: relative;
      overflow: hidden;
    }
    .wvs-m-pillar-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 6px;
      background: linear-gradient(180deg, #009A44 0%, #F17022 100%);
      border-radius: 24px 0 0 24px;
    }
    .wvs-m-pillar-left {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .wvs-m-pillar-circle {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
      border: 2.5px solid #009A44;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: #009A44;
      box-shadow: 0 6px 18px rgba(0, 154, 68, 0.2), inset 0 2px 4px rgba(255, 255, 255, 0.8);
    }
    .wvs-m-pillar-right {
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    .wvs-m-pillar-head {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 2px;
    }
    .wvs-m-num-tag {
      background: linear-gradient(135deg, #009A44 0%, #007b3e 100%);
      color: #ffffff;
      font-size: 0.76rem;
      font-weight: 900;
      padding: 3px 8px;
      border-radius: 8px;
      letter-spacing: 0.5px;
      box-shadow: 0 3px 8px rgba(0, 154, 68, 0.3);
    }
    .wvs-m-pillar-head h4 {
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 900;
      color: #004d25;
      margin: 0;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .wvs-m-divider {
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, #F17022 0%, rgba(241, 112, 34, 0.15) 100%);
      margin: 3px 0 5px 0;
      border-radius: 2px;
    }
    .wvs-m-pillar-right h5 {
      font-size: 0.94rem;
      font-weight: 900;
      color: #0f172a;
      margin: 0 0 2px 0;
      line-height: 1.3;
    }
    .wvs-m-pillar-right p {
      font-size: 0.78rem;
      font-weight: 600;
      color: #64748b;
      margin: 0;
      line-height: 1.3;
    }
  }

  @media (max-width: 576px) {
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .wvs-center-sector-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 20px;
    padding: 22px 10px;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .wvs-center-sector-card:hover {
    transform: translateY(-8px);
    border-color: #F17022;
    box-shadow: 0 14px 30px rgba(241, 112, 34, 0.18);
    background: #fff7ed;
  }

  .wvs-center-sector-card i {
    font-size: 2.2rem;
    color: #F17022;
    margin-bottom: 12px;
    display: inline-block;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .wvs-center-sector-card:hover i {
    transform: scale(1.15) rotate(-5deg);
    color: #009A44;
  }

  .wvs-center-sector-card h5 {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 0.98rem;
    font-weight: 800;
    color: #231F20;
    margin: 0;
  }

  .wvs-mobile-4pillars-stack {
    display: none !important;
  }

  /* --- 3. 4 PILLARS & TAGLINE STRIP --- */
  .wvs-pillars-bar {
    background: linear-gradient(135deg, #009A44 0%, #007b3e 50%, #00b853 100%);
    border: 2.5px solid #FDBA00;
    border-radius: 28px;
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    text-align: center;
    color: #ffffff;
    margin-bottom: 30px;
    box-shadow: 0 20px 50px rgba(0, 154, 68, 0.3), 0 0 25px rgba(253, 186, 0, 0.25);
  }

  .wvs-pillar-box {
    background: rgba(255, 255, 255, 0.1);
    border: 1.5px solid rgba(253, 186, 0, 0.4);
    border-radius: 20px;
    padding: 20px 14px;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .wvs-pillar-box:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #FDBA00;
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  .wvs-pillar-box h6 {
    font-size: 1.15rem;
    font-weight: 900;
    color: #FDBA00;
    margin: 0 0 8px 0;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .wvs-pillar-box p {
    font-size: 0.92rem;
    color: #ffffff;
    margin: 0;
    font-weight: 700;
    line-height: 1.4;
  }

  .wvs-tagline-banner {
    background: linear-gradient(135deg, #F17022 0%, #FB5900 45%, #009A44 100%);
    border-radius: 20px;
    padding: 24px 30px;
    text-align: center;
    color: #ffffff;
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 900;
    letter-spacing: 1.5px;
    box-shadow: 0 12px 35px rgba(241, 112, 34, 0.25);
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 991px) {
    .wvs-sec2-wrapper {
      padding: clamp(35px, 5vw, 60px) 15px;
    }
    .wvs-split-row {
      grid-template-columns: 1fr;
      text-align: center;
      min-height: auto;
      margin-bottom: 40px;
      gap: 30px;
    }
    .wvs-split-left {
      align-items: center;
      order: 2;
    }
    .wvs-split-right {
      order: 1;
      min-height: 320px;
    }
    .wvs-lady-desktop-only,
    .wvs-lady-desktop-only-inline {
      display: none !important;
    }
    .wvs-lady-mobile-only {
      display: block !important;
    }
    .wvs-lady-mobile-only-inline {
      display: inline-block !important;
    }
    .wvs-sec2-title {
      font-size: clamp(22px, 5.5vw, 36px);
      font-weight: 900;
    }
    .wvs-sec2-title .wvs-line-1,
    .wvs-sec2-title .wvs-line-2 {
      font-weight: 900;
      letter-spacing: -0.3px;
    }
    .wvs-sec2-desc {
      font-size: 0.95rem;
    }
    .wvs-sec2-highlight {
      text-align: left;
      font-size: 0.9rem;
      padding: 12px 14px;
    }
    .wvs-sec2-action {
      justify-content: center;
      width: 100%;
    }
    .wvs-btn-primary {
      width: 100%;
      max-width: 280px;
    }
    .wvs-action-arrow {
      display: none;
    }
    .wvs-split-right {
      min-height: 320px;
    }
    .wvs-char-img {
      max-height: 340px;
    }
    .wvs-pillars-bar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .wvs-center-sector-card {
      padding: 16px 8px;
    }
    .wvs-center-sector-card h5 {
      font-weight: 600;
      font-size: 0.88rem;
    }
    .wvs-center-sector-card i {
      font-size: 1.8rem;
      margin-bottom: 8px;
    }
    .wvs-center-sector-card:last-child:nth-child(3n+1) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(33.333% - 7px);
    }
    /* Mobile: 100% straight left-aligned icon starting line for 4 Pillars Cards */
    .wvs-pillars-bar {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 16px 14px;
    }
    .wvs-pillar-box {
      align-items: flex-start;
      text-align: left;
      padding: 16px 20px;
      box-sizing: border-box;
      width: 100%;
    }
    .wvs-pillar-box h6 {
      justify-content: flex-start;
      text-align: left;
      width: 100%;
      margin-bottom: 6px;
    }
    .wvs-pillar-box h6 i {
      width: 26px;
      text-align: center;
      flex-shrink: 0;
      display: inline-block;
    }
    .wvs-pillar-box p {
      text-align: left;
      padding-left: 34px;
      box-sizing: border-box;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .wvs-sec2-title .wvs-line {
      white-space: normal;
      display: inline;
    }
    .wvs-center-sectors-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .wvs-center-sector-card:last-child:nth-child(2n+1) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - 4px);
    }
    .wvs-pillars-bar {
      grid-template-columns: 1fr;
      padding: 20px 14px;
      gap: 16px;
    }
    .wvs-petals-bg {
      width: 260px;
      height: 260px;
    }
    .wvs-char-img {
      max-height: 290px;
    }
    .wvs-float-badge-1, .wvs-float-badge-2 {
      display: none;
    }
    .wvs-tagline-banner {
      font-size: 1rem;
      padding: 18px 14px;
