{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 2: MARKET OPPORTUNITY & ECOSYSTEM (VIBRANT)
     ========================================================================== */

  .wvs-overview-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    background: #fcf8f2;
    padding: clamp(50px, 7vw, 90px) 20px;
    color: #1e293b;
    position: relative;
  }

  .wvs-overview-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Electricity Presence Section Box */
  .wvs-presence-box {
    background: #ffffff;
    border: 2px solid rgba(236, 92, 10, 0.2);
    border-radius: 24px;
    padding: clamp(24px, 4vw, 40px);
    margin-bottom: 50px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.05);
  }

  .wvs-presence-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .wvs-presence-header i {
    font-size: 2.2rem;
    color: #ec5c0a;
    background: rgba(236, 92, 10, 0.1);
    padding: 12px;
    border-radius: 16px;
  }

  .wvs-presence-header h3 {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 900;
    color: #0f172a;
    margin: 0;
  }

  /* 7 Sectors Grid */
  .wvs-sectors-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 14px;
    margin-bottom: 30px;
  }

  .wvs-sector-card {
    background: #fffbf5;
    border: 1.5px solid #ffe8cc;
    border-radius: 18px;
    padding: 20px 10px;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
  }

  .wvs-sector-card:hover {
    transform: translateY(-6px);
    background: #ffffff;
    border-color: #ec5c0a;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.18);
  }

  .wvs-sector-card i {
    font-size: 2rem;
    color: #ec5c0a;
    margin-bottom: 10px;
    display: block;
    transition: transform 0.3s ease;
  }

  .wvs-sector-card:hover i {
    transform: scale(1.15);
    color: #007b3e;
  }

  .wvs-sector-card span {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
  }

  /* Opportunity Callout Banner */
  .wvs-opp-callout {
    background: linear-gradient(135deg, #fff7ed 0%, #f0fdf4 100%);
    border-left: 5px solid #ec5c0a;
    border-radius: 0 20px 20px 0;
    padding: 24px 30px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
  }

  .wvs-opp-callout p {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #334155;
    margin: 0 0 10px 0;
  }

  .wvs-opp-callout p strong {
    color: #ec5c0a;
  }

  .wvs-opp-district {
    font-size: 1.2rem;
    font-weight: 900;
    color: #007b3e;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* 2-Column Ecosystem Cards */
  .wvs-eco-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-bottom: 50px;
  }

  .wvs-eco-box {
    background: #ffffff;
    border: 2px solid rgba(0, 123, 62, 0.15);
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .wvs-eco-box::top-bar {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
  }

  .wvs-eco-box:hover {
    transform: translateY(-5px);
    border-color: #ec5c0a;
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.12);
  }

  .wvs-eco-icon-badge {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1.5px solid #fdba74;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #ec5c0a;
    margin-bottom: 22px;
  }

  .wvs-eco-box h4 {
    font-size: 1.4rem;
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 14px;
  }

  .wvs-eco-box p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
  }

  /* 4 Pillars Section */
  .wvs-pillars-section {
    margin-bottom: 50px;
    text-align: center;
  }

  .wvs-pillars-badge {
    display: inline-block;
    padding: 8px 22px;
    background: #fff7ed;
    border: 1.5px solid #fdba74;
    border-radius: 50px;
    color: #ec5c0a;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .wvs-pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .wvs-pillar-item {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 22px;
    padding: 28px 18px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .wvs-pillar-item:hover {
    transform: translateY(-8px);
    border-color: #007b3e;
    box-shadow: 0 16px 40px rgba(0, 123, 62, 0.15);
  }

  .wvs-pillar-num {
    font-size: 0.85rem;
    font-weight: 900;
    color: #cbd5e1;
    position: absolute;
    top: 14px;
    right: 18px;
  }

  .wvs-pillar-item i {
    font-size: 2.4rem;
    color: #ec5c0a;
    margin-bottom: 14px;
    display: inline-block;
  }

  .wvs-pillar-item h5 {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: 1px;
    color: #0f172a;
    margin-bottom: 6px;
  }

  .wvs-pillar-item p {
    font-size: 0.9rem;
    font-weight: 600;
    color: #64748b;
    margin: 0;
  }

  /* Tagline Bottom Action Banner */
  .wvs-action-banner {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 45%, #007b3e 100%);
    border-radius: 28px;
    padding: 40px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.3);
    color: #ffffff;
  }

  .wvs-action-text h4 {
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 900;
    letter-spacing: 1px;
    color: #ffffff;
    margin: 0 0 8px 0;
    text-transform: uppercase;
  }

  .wvs-action-text p {
    font-size: 1.05rem;
    color: #fef0db;
    margin: 0;
    font-weight: 600;
  }

  .wvs-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 36px;
    background: #ffffff;
    color: #0f172a;
    font-size: 1.05rem;
    font-weight: 900;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .wvs-action-btn:hover {
    background: #ffcc00;
    color: #000000;
    transform: scale(1.06);
    box-shadow: 0 15px 35px rgba(255, 204, 0, 0.4);
  }

  /* Responsive Queries */
  @media (max-width: 1024px) {
    .wvs-sectors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .wvs-pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .wvs-sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wvs-eco-row {
      grid-template-columns: 1fr;
    }
    .wvs-action-banner {
      flex-direction: column;
      text-align: center;
      padding: 30px 24px;
    }
    .wvs-action-btn {
      width: 100%;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="wvs-overview-wrapper">
  <div class="wvs-overview-container">
    <!-- Electricity Presence Box -->
    <div class="wvs-presence-box">
      <div class="wvs-presence-header">
        <i class="fa-solid fa-bolt-lightning"></i>
        <h3>Electricity is Everywhere</h3>
      </div>

      <!-- 7 Places Grid -->
      <div class="wvs-sectors-grid">
        <div class="wvs-sector-card">
          <i class="fa-solid fa-house-chimney"></i>
          <span>Homes</span>
        </div>
        <div class="wvs-sector-card">
          <i class="fa-solid fa-store"></i>
          <span>Shops</span>
        </div>
        <div class="wvs-sector-card">
          <i class="fa-solid fa-building"></i>
          <span>Offices</span>
        </div>
        <div class="wvs-sector-card">
          <i class="fa-solid fa-industry"></i>
          <span>Factories</span>
        </div>
        <div class="wvs-sector-card">
          <i class="fa-solid fa-hotel"></i>
          <span>Hotels</span>
        </div>
        <div class="wvs-sector-card">
          <i class="fa-solid fa-hospital"></i>
          <span>Hospitals</span>
        </div>
        <div class="wvs-sector-card">
          <i class="fa-solid fa-school"></i>
          <span>Institutions</span>
        </div>
      </div>

      <!-- Opportunity Callout -->
      <div class="wvs-opp-callout">
        <p>
          Everywhere electricity is consumed, there is an opportunity to introduce <strong>smarter energy-saving solutions.</strong>
        </p>
        <div class="wvs-opp-district">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Vidhyut Saathi is building that opportunity — one district at a time.</span>
        </div>
      </div>
    </div>

    <!-- 2 Ecosystem Cards -->
    <div class="wvs-eco-row">
      <div class="wvs-eco-box">
        <div class="wvs-eco-icon-badge">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4>National Brand & District Model</h4>
        <p>
          Vidhyut Saathi brings together an innovative Electric Saver Card, a growing national brand and a structured district-level franchise business model to help ambitious entrepreneurs build and grow their own local market.
        </p>
      </div>

      <div class="wvs-eco-box">
        <div class="wvs-eco-icon-badge">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <h4>Complete Business Ecosystem</h4>
        <p>
          With product support, branding, marketing assistance, training and business guidance, you get more than a franchise—you get an ecosystem designed to help you move from starting a business to building a market.
        </p>
      </div>
    </div>

    <!-- 4 Core Pillars -->
    <div class="wvs-pillars-section">
      <div class="wvs-pillars-badge">PRODUCT + BRAND + MARKET + SUPPORT</div>
      <div class="wvs-pillars-grid">
        <div class="wvs-pillar-item">
          <span class="wvs-pillar-num">01</span>
          <i class="fa-solid fa-microchip"></i>
          <h5>PRODUCT</h5>
          <p>Innovative Electric Saver Card</p>
        </div>

        <div class="wvs-pillar-item">
          <span class="wvs-pillar-num">02</span>
          <i class="fa-solid fa-award"></i>
          <h5>BRAND</h5>
          <p>Growing National Energy Brand</p>
        </div>

        <div class="wvs-pillar-item">
          <span class="wvs-pillar-num">03</span>
          <i class="fa-solid fa-globe"></i>
          <h5>MARKET</h5>
          <p>District-Level Business Model</p>
        </div>

        <div class="wvs-pillar-item">
          <span class="wvs-pillar-num">04</span>
          <i class="fa-solid fa-handshake-angle"></i>
          <h5>SUPPORT</h5>
          <p>Training, Marketing & Guidance</p>
        </div>
      </div>
    </div>

    <!-- Bottom Tagline Action Banner -->
    <div class="wvs-action-banner">
      <div class="wvs-action-text">
        <h4>YOUR DISTRICT. YOUR BUSINESS. YOUR OPPORTUNITY.</h4>
        <p>Start building your local energy-saving franchise market with Vidhyut Saathi today.</p>
      </div>
      <a href="{{ section.settings.cta_url | default: '/pages/contact' }}" class="wvs-action-btn">
        <span>Apply For District Franchise</span>
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Overview",
  "tag": "section",
  "class": "section-why-vidhyut-overview",
  "settings": [
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Overview"
    }
  ]
}
{% endschema %}
