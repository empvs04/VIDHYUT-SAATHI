<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .vs-why-sec-{{ section.id }} {
    --ink: #2A2118;
    --white: #FFFFFF;
    --orange-50: #FFF4EB;
    --orange-100: #FFE4CC;
    --saffron: #FF7A1A;
    --leaf: #0F8B3D;
    --gold: #D4900F;
    --line: rgba(42,33,24,0.1);
    
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    font-family: 'Inter', sans-serif !important;
    color: var(--ink) !important;
    background: linear-gradient(135deg, var(--white) 0%, var(--orange-50) 55%, var(--orange-100) 100%) !important;
    padding: {{ section.settings.padding_top_desk | default: 80 }}px 24px {{ section.settings.padding_bottom_desk | default: 80 }}px 24px !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .vs-why-sec-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  .vs-why-sec-{{ section.id }} .section-inner {
    max-width: 1360px !important;
    margin: 0 auto !important;
    padding: 0 32px !important;
    display: grid !important;
    grid-template-columns: 1.05fr 0.95fr !important;
    gap: 70px !important;
    align-items: center !important;
  }

  /* ---------- LEFT ---------- */
  .vs-why-sec-{{ section.id }} .left {
    max-width: 580px !important;
    padding-right: 8px !important;
  }

  .vs-why-sec-{{ section.id }} .eyebrow {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    font-weight: 600 !important;
    font-size: 13px !important;
    color: var(--leaf) !important;
    margin-bottom: 14px !important;
    letter-spacing: 0.02em !important;
  }

  .vs-why-sec-{{ section.id }} .eyebrow .rule {
    width: 30px !important;
    height: 2px !important;
    background: linear-gradient(90deg, var(--saffron), var(--leaf)) !important;
    border-radius: 999px !important;
    flex-shrink: 0 !important;
  }

  .vs-why-sec-{{ section.id }} h2.section-title {
    font-family: 'Sora', sans-serif !important;
    font-weight: 800 !important;
    font-size: clamp(28px, 3.5vw, 42px) !important;
    line-height: 1.1 !important;
    letter-spacing: -0.015em !important;
    margin: 0 0 14px 0 !important;
    color: var(--ink) !important;
  }

  .vs-why-sec-{{ section.id }} h2.section-title .accent {
    color: var(--saffron) !important;
  }

  .vs-why-sec-{{ section.id }} .lede {
    font-size: 15.5px !important;
    line-height: 1.55 !important;
    color: rgba(42,33,24,0.68) !important;
    max-width: 48ch !important;
    margin: 0 !important;
  }

  .vs-why-sec-{{ section.id }} .pillars {
    margin-top: 32px !important;
  }

  .vs-why-sec-{{ section.id }} .pillar {
    display: grid !important;
    grid-template-columns: 54px 1fr !important;
    gap: 22px !important;
    padding: 18px 0 !important;
    border-bottom: 1px solid var(--line) !important;
    align-items: flex-start !important;
  }

  .vs-why-sec-{{ section.id }} .pillar:first-child {
    padding-top: 0 !important;
  }

  .vs-why-sec-{{ section.id }} .pillar:last-child {
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }

  .vs-why-sec-{{ section.id }} .pillar-icon {
    width: 54px !important;
    height: 54px !important;
    border-radius: 14px !important;
    background: var(--white) !important;
    box-shadow: 0 8px 18px -6px rgba(255,122,26,0.35), 0 0 0 1px var(--orange-100) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 22px !important;
    flex-shrink: 0 !important;
    margin-top: 2px !important;
  }

  .vs-why-sec-{{ section.id }} .pillar-icon.saffron { color: var(--saffron) !important; }
  .vs-why-sec-{{ section.id }} .pillar-icon.gold { color: var(--gold) !important; }
  .vs-why-sec-{{ section.id }} .pillar-icon.leaf { color: var(--leaf) !important; }

  .vs-why-sec-{{ section.id }} .pillar h3 {
    font-family: 'Sora', sans-serif !important;
    font-size: 19px !important;
    font-weight: 700 !important;
    line-height: 1.32 !important;
    margin: 0 0 6px 0 !important;
    letter-spacing: -0.005em !important;
    color: var(--ink) !important;
  }

  .vs-why-sec-{{ section.id }} .pillar p {
    font-size: 14px !important;
    line-height: 1.55 !important;
    color: rgba(42,33,24,0.62) !important;
    max-width: 44ch !important;
    margin: 0 !important;
  }

  .vs-why-sec-{{ section.id }} .cta-strip {
    margin-top: 28px !important;
    display: flex !important;
    align-items: center !important;
    gap: 18px !important;
    flex-wrap: wrap !important;
  }

  .vs-why-sec-{{ section.id }} .btn-primary {
    background: linear-gradient(100deg, var(--saffron), var(--gold)) !important;
    color: var(--white) !important;
    font-family: 'Sora', sans-serif !important;
    font-weight: 700 !important;
    font-size: 14.5px !important;
    padding: 14px 28px !important;
    border-radius: 11px !important;
    text-decoration: none !important;
    box-shadow: 0 14px 26px -10px rgba(255,122,26,0.5) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
  }

  .vs-why-sec-{{ section.id }} .btn-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 18px 30px -8px rgba(255,122,26,0.65) !important;
  }

  .vs-why-sec-{{ section.id }} .cta-note {
    font-size: 12.5px !important;
    color: rgba(42,33,24,0.55) !important;
    font-weight: 500 !important;
  }

  /* ---------- RIGHT COLUMN & FLOATING TILT ANIMATION ---------- */
  .vs-why-sec-{{ section.id }} .right {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    width: 100% !important;
  }

  @keyframes vsFloatAndTilt {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-9px) rotate(-1.5deg);
    }
    50% {
      transform: translateY(-18px) rotate(0deg);
    }
    75% {
      transform: translateY(-9px) rotate(1.5deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  .vs-why-sec-{{ section.id }} .vs-floating-girl-card {
    position: relative !important;
    width: 100% !important;
    max-width: 440px !important;
    animation: vsFloatAndTilt 5s ease-in-out infinite !important;
    transform-origin: center center !important;
    will-change: transform !important;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
  }

  .vs-why-sec-{{ section.id }} .vs-floating-girl-card:hover {
    animation-play-state: paused !important;
    transform: translateY(-12px) scale(1.02) rotate(1deg) !important;
  }

  .vs-why-sec-{{ section.id }} .vs-girl-photo-box {
    position: relative !important;
    width: 100% !important;
    border-radius: 28px !important;
    overflow: hidden !important;
    background: linear-gradient(180deg, #FFFFFF 0%, #FFF5EB 100%) !important;
    border: 2px solid rgba(255, 122, 26, 0.18) !important;
    box-shadow: 0 20px 48px -12px rgba(42, 33, 24, 0.18), 0 0 30px rgba(255, 122, 26, 0.12) !important;
  }

  .vs-why-sec-{{ section.id }} .vs-girl-img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 3.8 / 4.8 !important;
    object-fit: cover !important;
    object-position: top center !important;
    display: block !important;
    border-radius: 26px !important;
  }

  .vs-why-sec-{{ section.id }} .glow-1 {
    position: absolute !important;
    top: -40px !important;
    right: -20px !important;
    width: 280px !important;
    height: 280px !important;
    border-radius: 50% !important;
    background: radial-gradient(circle, rgba(255,122,26,0.25), transparent 70%) !important;
    z-index: 0 !important;
    pointer-events: none !important;
  }

  .vs-why-sec-{{ section.id }} .glow-2 {
    position: absolute !important;
    bottom: -60px !important;
    left: -40px !important;
    width: 260px !important;
    height: 260px !important;
    border-radius: 50% !important;
    background: radial-gradient(circle, rgba(15,139,61,0.18), transparent 70%) !important;
    z-index: 0 !important;
    pointer-events: none !important;
  }

  .vs-why-sec-{{ section.id }} .badge {
    position: absolute !important;
    top: 14px !important;
    left: 14px !important;
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(8px) !important;
    color: var(--ink) !important;
    font-family: 'Sora', sans-serif !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    padding: 8px 15px !important;
    border-radius: 999px !important;
    box-shadow: 0 6px 18px rgba(42,33,24,0.16) !important;
    border: 1px solid rgba(255, 122, 26, 0.2) !important;
    z-index: 3 !important;
  }

  .vs-why-sec-{{ section.id }} .seal {
    position: absolute !important;
    top: 14px !important;
    right: 14px !important;
    width: 64px !important;
    height: 64px !important;
    border-radius: 50% !important;
    background: #FFFFFF !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    box-shadow: 0 8px 20px rgba(42,33,24,0.18) !important;
    border: 2px dashed var(--leaf) !important;
    z-index: 3 !important;
  }

  .vs-why-sec-{{ section.id }} .seal .top {
    font-family: 'Sora', sans-serif !important;
    font-size: 13.5px !important;
    font-weight: 800 !important;
    color: var(--leaf) !important;
    line-height: 1 !important;
  }

  .vs-why-sec-{{ section.id }} .seal .bot {
    font-size: 7px !important;
    letter-spacing: 0.04em !important;
    color: rgba(42,33,24,0.6) !important;
    margin-top: 3px !important;
    font-weight: 800 !important;
  }

  .vs-why-sec-{{ section.id }} .stat-card {
    position: absolute !important;
    bottom: 12px !important;
    left: 12px !important;
    right: 12px !important;
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(12px) !important;
    border-radius: 18px !important;
    padding: 14px 18px !important;
    display: flex !important;
    justify-content: space-between !important;
    box-shadow: 0 12px 28px -8px rgba(42,33,24,0.22) !important;
    border: 1px solid rgba(255, 122, 26, 0.2) !important;
    z-index: 3 !important;
  }

  .vs-why-sec-{{ section.id }} .stat {
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
    text-align: center !important;
  }

  .vs-why-sec-{{ section.id }} .stat .val {
    font-family: 'Sora', sans-serif !important;
    font-weight: 800 !important;
    font-size: 18px !important;
    color: var(--saffron) !important;
  }

  .vs-why-sec-{{ section.id }} .stat .lbl {
    font-size: 10px !important;
    color: rgba(42,33,24,0.6) !important;
    font-weight: 700 !important;
  }

  /* ---------- RESPONSIVE BREAKPOINTS ---------- */
  @media (max-width: 991px) {
    .vs-why-sec-{{ section.id }} {
      padding: {{ section.settings.padding_top_mob | default: 50 }}px 16px {{ section.settings.padding_bottom_mob | default: 50 }}px 16px !important;
    }
    .vs-why-sec-{{ section.id }} .section-inner {
      grid-template-columns: 1fr !important;
      gap: 48px !important;
      padding: 0 !important;
    }
    .vs-why-sec-{{ section.id }} .left {
      max-width: 100% !important;
      padding-right: 0 !important;
    }
    .vs-why-sec-{{ section.id }} .right {
      max-width: 420px !important;
      margin: 0 auto !important;
    }
  }

  @media (max-width: 480px) {
    .vs-why-sec-{{ section.id }} h2.section-title {
      font-size: 27px !important;
    }
    .vs-why-sec-{{ section.id }} .lede {
      font-size: 14px !important;
    }
    .vs-why-sec-{{ section.id }} .pillar {
      grid-template-columns: 46px 1fr !important;
      gap: 14px !important;
      padding: 14px 0 !important;
    }
    .vs-why-sec-{{ section.id }} .pillar-icon {
      width: 46px !important;
      height: 46px !important;
      font-size: 18px !important;
      border-radius: 11px !important;
    }
    .vs-why-sec-{{ section.id }} .pillar h3 {
      font-size: 16.5px !important;
    }
    .vs-why-sec-{{ section.id }} .pillar p {
      font-size: 13px !important;
    }
    .vs-why-sec-{{ section.id }} .cta-strip {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 12px !important;
    }
    .vs-why-sec-{{ section.id }} .btn-primary {
      width: 100% !important;
      text-align: center !important;
      justify-content: center !important;
    }
    .vs-why-sec-{{ section.id }} .cta-note {
      text-align: center !important;
    }
  }
</style>

<div class="vs-why-sec-{{ section.id }}">
  <div class="section-inner">

    <!-- LEFT COLUMN -->
    <div class="left">
      {% if section.settings.eyebrow_text != blank %}
        <div class="eyebrow">
          <span class="rule"></span>
          {{ section.settings.eyebrow_text }}
        </div>
      {% endif %}

      <h2 class="section-title">
        {{ section.settings.heading_prefix | default: "Why choose" }}
        <span class="accent">{{ section.settings.heading_accent | default: "Vidhyut Saathi?" }}</span>
      </h2>

      {% if section.settings.lede_text != blank %}
        <p class="lede">{{ section.settings.lede_text }}</p>
      {% endif %}

      <div class="pillars">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="pillar" {{ block.shopify_attributes }}>
              <div class="pillar-icon {{ block.settings.icon_theme }}">
                {{ block.settings.icon_symbol }}
              </div>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="pillar">
            <div class="pillar-icon saffron">⬡</div>
            <div>
              <h3>Based on US-German nano technology</h3>
              <p>Advanced US-German nano technology designed for optimized electricity efficiency, stable performance and smarter energy management.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="pillar-icon gold">⚡</div>
            <div>
              <h3>Made with terahertz chip & 20,000+ negative ions</h3>
              <p>Built with advanced terahertz chip technology and 20,000+ negative ions for smart energy optimization and efficient electrical performance.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="pillar-icon leaf">✓</div>
            <div>
              <h3>100% legal & ISO certified</h3>
              <p>Completely legal, reliable and designed to follow quality standards for safe and trusted usage.</p>
            </div>
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_text != blank %}
        <div class="cta-strip">
          <a href="{{ section.settings.button_link | default: '/pages/get-franchise' }}" class="btn-primary">
            {{ section.settings.button_text }}
          </a>
          {% if section.settings.cta_note != blank %}
            <span class="cta-note">{{ section.settings.cta_note }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- RIGHT COLUMN (GIRL WITH VIDHYUT SAATHI CARD & UP-DOWN TILT FLOATING ANIMATION) -->
    <div class="right">
      <div class="vs-floating-girl-card">
        <div class="glow-1"></div>
        <div class="glow-2"></div>
        
        {% if section.settings.badge_text != blank %}
          <div class="badge">{{ section.settings.badge_text }}</div>
        {% endif %}

        <div class="seal">
          <span class="top">{{ section.settings.seal_top | default: "ISO" }}</span>
          <span class="bot">{{ section.settings.seal_bot | default: "CERTIFIED" }}</span>
        </div>

        <div class="vs-girl-photo-box">
          {% if section.settings.custom_girl_image != blank %}
            <img 
              src="{{ section.settings.custom_girl_image | image_url: width: 1000 }}" 
              alt="{{ section.settings.heading_prefix }} {{ section.settings.heading_accent }}" 
              class="vs-girl-img" 
              loading="lazy"
            >
          {% else %}
            <img 
              src="{{ 'vidhyut-girl-with-real-card.jpg' | asset_url }}" 
              alt="Vidhyut Saathi Power Saving Card Holder" 
              class="vs-girl-img" 
              loading="lazy"
              onerror="this.onerror=null; this.src='{{ 'vidhyut-girl-card-hero.jpg' | asset_url }}';"
            >
          {% endif %}
        </div>

        <div class="stat-card">
          <div class="stat">
            <span class="val">{{ section.settings.stat1_val | default: "ISO" }}</span>
            <span class="lbl">{{ section.settings.stat1_lbl | default: "Certified" }}</span>
          </div>
          <div class="stat">
            <span class="val">{{ section.settings.stat2_val | default: "20K+" }}</span>
            <span class="lbl">{{ section.settings.stat2_lbl | default: "Negative Ions" }}</span>
          </div>
          <div class="stat">
            <span class="val">{{ section.settings.stat3_val | default: "100%" }}</span>
            <span class="lbl">{{ section.settings.stat3_lbl | default: "Legal" }}</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Vidhyut Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "India's Premium Energy-Tech Innovation"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "Why choose"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Highlight (Accent)",
      "default": "Vidhyut Saathi?"
    },
    {
      "type": "textarea",
      "id": "lede_text",
      "label": "Lede / Description Text",
      "default": "Precision engineering, certified quality, and technology built to deliver — this is what sets our devices apart."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore the technology"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "CTA Note Text",
      "default": "Trusted across India's energy-tech network"
    },
    {
      "type": "header",
      "content": "Right Photo & Badges"
    },
    {
      "type": "image_picker",
      "id": "custom_girl_image",
      "label": "Custom Girl / Product Image",
      "info": "Upload custom image or leave blank to use the Vidhyut Saathi card girl photo"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "⚡ Smart Energy Device"
    },
    {
      "type": "text",
      "id": "seal_top",
      "label": "Seal Top Text",
      "default": "ISO"
    },
    {
      "type": "text",
      "id": "seal_bot",
      "label": "Seal Bottom Text",
      "default": "CERTIFIED"
    },
    {
      "type": "header",
      "content": "Floating Stat Card"
    },
    {
      "type": "text",
      "id": "stat1_val",
      "label": "Stat 1 Value",
      "default": "ISO"
    },
    {
      "type": "text",
      "id": "stat1_lbl",
      "label": "Stat 1 Label",
      "default": "Certified"
    },
    {
      "type": "text",
      "id": "stat2_val",
      "label": "Stat 2 Value",
      "default": "20K+"
    },
    {
      "type": "text",
      "id": "stat2_lbl",
      "label": "Stat 2 Label",
      "default": "Negative Ions"
    },
    {
      "type": "text",
      "id": "stat3_val",
      "label": "Stat 3 Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat3_lbl",
      "label": "Stat 3 Label",
      "default": "Legal"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "label": "Desktop Padding Top",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desk",
      "label": "Desktop Padding Bottom",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Mobile Padding Top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "label": "Mobile Padding Bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "pillar_item",
      "name": "Pillar Item",
      "settings": [
        {
          "type": "select",
          "id": "icon_theme",
          "label": "Icon Color Theme",
          "options": [
            { "value": "saffron", "label": "Saffron Orange" },
            { "value": "gold", "label": "Gold / Terahertz" },
            { "value": "leaf", "label": "Leaf Green" }
          ],
          "default": "saffron"
        },
        {
          "type": "text",
          "id": "icon_symbol",
          "label": "Icon Symbol / Emoji",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Advanced Energy Innovation"
        },
        {
          "type": "textarea",
