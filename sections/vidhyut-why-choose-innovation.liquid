<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800;900&family=Nunito:wght@400;600;700;800&family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .vs-why-sec-{{ section.id }} {
    --ink: #222222;
    --white: #FFFFFF;
    --orange-50: #FFF8EF;
    --orange-100: #FFE4CC;
    --saffron: #F7941D;
    --leaf: #3EAD47;
    --gold: #D4900F;
    --line: rgba(42,33,24,0.1);
    
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    font-family: 'Nunito', 'Inter', sans-serif !important;
    color: var(--ink) !important;
    background: radial-gradient(circle at top right, rgba(247,148,29,0.06), transparent 45%), linear-gradient(180deg, #FAFAF7 0%, #FFFFFF 100%) !important;
    padding: {{ section.settings.padding_top_desk | default: 70 }}px 20px {{ section.settings.padding_bottom_desk | default: 70 }}px 20px !important;
    position: relative !important;
    overflow: hidden !important;
    margin: 0 auto !important;
  }

  .vs-why-sec-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  /* ── STANDARD 1200PX CENTERED CONTAINER ── */
  .vs-why-sec-{{ section.id }} .container {
    max-width: 1200px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    position: relative !important;
    z-index: 2 !important;
    display: grid !important;
    grid-template-columns: 1.1fr 0.9fr !important;
    gap: 48px !important;
    align-items: center !important;
    justify-content: space-between !important;
  }

  /* ---------- LEFT COLUMN ---------- */
  .vs-why-sec-{{ section.id }} .left {
    max-width: 580px !important;
    width: 100% !important;
    margin-right: auto !important;
  }

  .vs-why-sec-{{ section.id }} .eyebrow {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    font-weight: 700 !important;
    font-size: 13.5px !important;
    color: var(--leaf) !important;
    margin-bottom: 12px !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
  }

  .vs-why-sec-{{ section.id }} .eyebrow .rule {
    width: 28px !important;
    height: 3px !important;
    background: linear-gradient(90deg, #F7941D, #3EAD47) !important;
    border-radius: 999px !important;
    flex-shrink: 0 !important;
  }

  .vs-why-sec-{{ section.id }} h2.section-title {
    font-family: 'Baloo 2', 'Sora', sans-serif !important;
    font-weight: 900 !important;
    font-size: clamp(30px, 3.8vw, 44px) !important;
    line-height: 1.15 !important;
    letter-spacing: -0.5px !important;
    margin: 0 0 12px 0 !important;
    color: #1A1A1A !important;
    text-transform: uppercase !important;
  }

  .vs-why-sec-{{ section.id }} h2.section-title .accent {
    background: linear-gradient(90deg, #E07810 0%, #F7941D 55%, #FDB44B 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    filter: drop-shadow(0 4px 12px rgba(247,148,29,.18)) !important;
  }

  .vs-why-sec-{{ section.id }} .lede {
    font-size: 16px !important;
    line-height: 1.55 !important;
    color: #555555 !important;
    max-width: 52ch !important;
    margin: 0 !important;
    font-weight: 600 !important;
  }

  .vs-why-sec-{{ section.id }} .pillars {
    margin-top: 28px !important;
  }

  .vs-why-sec-{{ section.id }} .pillar {
    display: grid !important;
    grid-template-columns: 52px 1fr !important;
    gap: 18px !important;
    padding: 16px 0 !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07) !important;
    align-items: flex-start !important;
  }

  .vs-why-sec-{{ section.id }} .pillar:first-child {
    padding-top: 0 !important;
  }

  .vs-why-sec-{{ section.id }} .pillar:last-child {
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }

  .vs-why-sec-{{ section.id }} .pillar-icon {
    width: 52px !important;
    height: 52px !important;
    border-radius: 14px !important;
    background: #FFFFFF !important;
    box-shadow: 0 8px 20px -4px rgba(247,148,29,0.22), 0 0 0 1.5px rgba(247,148,29,0.15) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 22px !important;
    flex-shrink: 0 !important;
    margin-top: 2px !important;
  }

  .vs-why-sec-{{ section.id }} .pillar-icon.saffron { 
    color: #F7941D !important; 
    background: linear-gradient(135deg, #FFF8EF, #FFFFFF) !important;
  }
  .vs-why-sec-{{ section.id }} .pillar-icon.gold { 
    color: #D4900F !important; 
    background: linear-gradient(135deg, #FFFDEB, #FFFFFF) !important;
  }
  .vs-why-sec-{{ section.id }} .pillar-icon.leaf { 
    color: #3EAD47 !important; 
    background: linear-gradient(135deg, #F0FAF1, #FFFFFF) !important;
    box-shadow: 0 8px 20px -4px rgba(62,173,71,0.22), 0 0 0 1.5px rgba(62,173,71,0.18) !important;
  }

  .vs-why-sec-{{ section.id }} .pillar h3 {
    font-family: 'Baloo 2', 'Sora', sans-serif !important;
    font-size: 19px !important;
    font-weight: 800 !important;
    line-height: 1.3 !important;
    margin: 0 0 4px 0 !important;
    letter-spacing: -0.2px !important;
    color: #222222 !important;
  }

  .vs-why-sec-{{ section.id }} .pillar p {
    font-size: 14px !important;
    line-height: 1.55 !important;
    color: #666666 !important;
    max-width: 48ch !important;
    margin: 0 !important;
    font-weight: 600 !important;
  }

  .vs-why-sec-{{ section.id }} .cta-strip {
    margin-top: 26px !important;
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    flex-wrap: wrap !important;
  }

  .vs-why-sec-{{ section.id }} .btn-primary {
    background: linear-gradient(90deg, #F7941D 0%, #FF7A1A 100%) !important;
    color: #FFFFFF !important;
    font-family: 'Baloo 2', sans-serif !important;
    font-weight: 800 !important;
    font-size: 16px !important;
    letter-spacing: 0.3px !important;
    padding: 14px 30px !important;
    border-radius: 999px !important;
    text-decoration: none !important;
    box-shadow: 0 10px 26px -6px rgba(247,148,29,0.45) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease !important;
  }

  .vs-why-sec-{{ section.id }} .btn-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 14px 30px -4px rgba(247,148,29,0.6) !important;
  }

  .vs-why-sec-{{ section.id }} .cta-note {
    font-size: 13px !important;
    color: #777777 !important;
    font-weight: 700 !important;
  }

  /* ---------- RIGHT COLUMN & FLOATING TILT ANIMATION ---------- */
  .vs-why-sec-{{ section.id }} .right {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    width: 100% !important;
    margin-left: auto !important;
  }

  @keyframes vsFloatAndTilt {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-10px) rotate(-1.8deg);
    }
    50% {
      transform: translateY(-20px) rotate(0deg);
    }
    75% {
      transform: translateY(-10px) rotate(1.8deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  .vs-why-sec-{{ section.id }} .vs-floating-girl-wrapper {
    position: relative !important;
    width: 100% !important;
    max-width: 420px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    animation: vsFloatAndTilt 5s ease-in-out infinite !important;
    transform-origin: center center !important;
    will-change: transform !important;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
  }

  .vs-why-sec-{{ section.id }} .vs-floating-girl-wrapper:hover {
    animation-play-state: paused !important;
    transform: translateY(-14px) scale(1.03) rotate(1.5deg) !important;
  }

  .vs-why-sec-{{ section.id }} .vs-girl-cutout-img {
    width: 100% !important;
    max-width: 400px !important;
    height: auto !important;
    display: block !important;
    filter: drop-shadow(0 20px 32px rgba(42, 33, 24, 0.14)) drop-shadow(0 0 35px rgba(247, 148, 29, 0.14)) !important;
    user-select: none !important;
    pointer-events: auto !important;
  }

  .vs-why-sec-{{ section.id }} .glow-1 {
    position: absolute !important;
    top: -20px !important;
    right: -10px !important;
    width: 320px !important;
    height: 320px !important;
    border-radius: 50% !important;
    background: radial-gradient(circle, rgba(247,148,29,0.20), transparent 70%) !important;
    z-index: 0 !important;
    pointer-events: none !important;
  }

  .vs-why-sec-{{ section.id }} .glow-2 {
    position: absolute !important;
    bottom: -30px !important;
    left: -20px !important;
    width: 300px !important;
    height: 300px !important;
    border-radius: 50% !important;
    background: radial-gradient(circle, rgba(62,173,71,0.16), transparent 70%) !important;
    z-index: 0 !important;
    pointer-events: none !important;
  }

  /* ---------- RESPONSIVE BREAKPOINTS ---------- */
  @media (max-width: 991px) {
    .vs-why-sec-{{ section.id }} {
      padding: {{ section.settings.padding_top_mob | default: 45 }}px 16px {{ section.settings.padding_bottom_mob | default: 45 }}px 16px !important;
    }
    .vs-why-sec-{{ section.id }} .container {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
      padding-left: 10px !important;
      padding-right: 10px !important;
    }
    .vs-why-sec-{{ section.id }} .left {
      max-width: 100% !important;
      text-align: left !important;
    }
    .vs-why-sec-{{ section.id }} .right {
      max-width: 360px !important;
      margin: 0 auto !important;
    }
    .vs-why-sec-{{ section.id }} .vs-girl-cutout-img {
      max-width: 340px !important;
    }
  }

  @media (max-width: 480px) {
    .vs-why-sec-{{ section.id }} h2.section-title {
      font-size: 26px !important;
    }
    .vs-why-sec-{{ section.id }} .lede {
      font-size: 14px !important;
    }
    .vs-why-sec-{{ section.id }} .pillar {
      grid-template-columns: 46px 1fr !important;
      gap: 14px !important;
      padding: 12px 0 !important;
    }
    .vs-why-sec-{{ section.id }} .pillar-icon {
      width: 46px !important;
      height: 46px !important;
      font-size: 18px !important;
      border-radius: 12px !important;
    }
    .vs-why-sec-{{ section.id }} .pillar h3 {
      font-size: 16.5px !important;
    }
    .vs-why-sec-{{ section.id }} .pillar p {
      font-size: 13px !important;
    }
    .vs-why-sec-{{ section.id }} .cta-strip {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
    }
    .vs-why-sec-{{ section.id }} .btn-primary {
      width: 100% !important;
      text-align: center !important;
      justify-content: center !important;
    }
    .vs-why-sec-{{ section.id }} .cta-note {
      text-align: center !important;
    }
  }
</style>

<div class="vs-why-sec-{{ section.id }}">
  <div class="container">

    <!-- LEFT COLUMN -->
    <div class="left">
      {% if section.settings.eyebrow_text != blank %}
        <div class="eyebrow">
          <span class="rule"></span>
          {{ section.settings.eyebrow_text }}
        </div>
      {% endif %}

      <h2 class="section-title">
        {{ section.settings.heading_prefix | default: "Why choose" }}
        <span class="accent">{{ section.settings.heading_accent | default: "Vidhyut Saathi?" }}</span>
      </h2>

      {% if section.settings.lede_text != blank %}
        <p class="lede">{{ section.settings.lede_text }}</p>
      {% endif %}

      <div class="pillars">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="pillar" {{ block.shopify_attributes }}>
              <div class="pillar-icon {{ block.settings.icon_theme }}">
                {{ block.settings.icon_symbol }}
              </div>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="pillar">
            <div class="pillar-icon saffron">⬡</div>
            <div>
              <h3>Based on US-German nano technology</h3>
              <p>Advanced US-German nano technology designed for optimized electricity efficiency, stable performance and smarter energy management.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="pillar-icon gold">⚡</div>
            <div>
              <h3>Made with terahertz chip & 20,000+ negative ions</h3>
              <p>Built with advanced terahertz chip technology and 20,000+ negative ions for smart energy optimization and efficient electrical performance.</p>
            </div>
          </div>
          <div class="pillar">
            <div class="pillar-icon leaf">✓</div>
            <div>
              <h3>100% legal & ISO certified</h3>
              <p>Completely legal, reliable and designed to follow quality standards for safe and trusted usage.</p>
            </div>
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_text != blank %}
        <div class="cta-strip">
          <a href="{{ section.settings.button_link | default: '/pages/get-franchise' }}" class="btn-primary">
            {{ section.settings.button_text }}
          </a>
          {% if section.settings.cta_note != blank %}
            <span class="cta-note">{{ section.settings.cta_note }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- RIGHT COLUMN (ONLY GIRL PHOTO WITH SINGLE VIDHYUT SAATHI CARD & UP-DOWN TILT FLOATING ANIMATION) -->
    <div class="right">
      <div class="vs-floating-girl-wrapper">
        <div class="glow-1"></div>
        <div class="glow-2"></div>
        
        {% if section.settings.custom_girl_image != blank %}
          <img 
            src="{{ section.settings.custom_girl_image | image_url: width: 1000 }}" 
            alt="{{ section.settings.heading_prefix }} {{ section.settings.heading_accent }}" 
            class="vs-girl-cutout-img" 
            loading="lazy"
          >
        {% else %}
          <img 
            src="{{ 'vidhyut-girl-single-card-cutout.png' | asset_url }}" 
            alt="Vidhyut Saathi Power Saving Card Holder" 
            class="vs-girl-cutout-img" 
            loading="lazy"
            onerror="this.onerror=null; this.src='{{ 'vidhyut-girl-transparent.png' | asset_url }}';"
          >
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Vidhyut Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "India's Premium Energy-Tech Innovation"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "Why choose"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Highlight (Accent)",
      "default": "Vidhyut Saathi?"
    },
    {
      "type": "textarea",
      "id": "lede_text",
      "label": "Lede / Description Text",
      "default": "Precision engineering, certified quality, and technology built to deliver — this is what sets our devices apart."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Explore the technology"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "CTA Note Text",
      "default": "Trusted across India's energy-tech network"
    },
    {
      "type": "header",
      "content": "Right Column Photo"
    },
    {
      "type": "image_picker",
      "id": "custom_girl_image",
      "label": "Custom Girl / Product Cutout Image",
      "info": "Upload custom cutout or leave blank to use default transparent girl holding Vidhyut card"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "label": "Desktop Padding Top",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom_desk",
      "label": "Desktop Padding Bottom",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Mobile Padding Top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "label": "Mobile Padding Bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "pillar_item",
      "name": "Pillar Item",
      "settings": [
        {
          "type": "select",
          "id": "icon_theme",
          "label": "Icon Color Theme",
          "options": [
            { "value": "saffron", "label": "Saffron Orange" },
            { "value": "gold", "label": "Gold / Terahertz" },
            { "value": "leaf", "label": "Leaf Green" }
          ],
          "default": "saffron"
        },
        {
          "type": "text",
          "id": "icon_symbol",
          "label": "Icon Symbol / Emoji",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Advanced Energy Innovation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Pillar Description",
          "default": "High-efficiency smart technology built to deliver maximum energy savings and safety."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vidhyut Why Choose Us",
      "blocks": [
        {
          "type": "pillar_item",
          "settings": {
            "icon_theme": "saffron",
            "icon_symbol": "⬡",
            "title": "Based on US-German nano technology",
            "text": "Advanced US-German nano technology designed for optimized electricity efficiency, stable performance and smarter energy management."
          }
        },
        {
          "type": "pillar_item",
          "settings": {
            "icon_theme": "gold",
            "icon_symbol": "⚡",
            "title": "Made with terahertz chip & 20,000+ negative ions",
            "text": "Built with advanced terahertz chip technology and 20,000+ negative ions for smart energy optimization and efficient electrical performance."
          }
        },
        {
          "type": "pillar_item",
          "settings": {
            "icon_theme": "leaf",
            "icon_symbol": "✓",
            "title": "100% legal & ISO certified",
            "text": "Completely legal, reliable and designed to follow quality standards for safe and trusted usage."
          }
        }
      ]
    }
  ]
}
{% endschema %}
