{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap');

  /* ===========================================================================
     SECTION 3: VIDHYUT EXPERT VIDEO SHOWCASE (DESKTOP ONLY)
     MINIMIZED FONTS, BULLET POINTS, FLUSH LEFT VIDEO & ELEGANT OVERLAP CARDS
     =========================================================================== */
  .vs-desktop-video-section {
    display: block !important;
    padding: 50px 0 80px 0 !important;
    background: #FFFFFF !important;
    position: relative !important;
    overflow: visible !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
  }

  /* Hide on Mobile */
  @media screen and (max-width: 768px) {
    .vs-desktop-video-section {
      display: none !important;
    }
  }

  .vs-desktop-video-container {
    max-width: 1140px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    position: relative !important;
  }

  .vs-video-main-wrapper {
    position: relative !important;
    width: 100% !important;
  }

  /* 2-COLUMN TOP GRID (FLUSH LEFT IMAGE) */
  .vs-video-top-grid {
    display: grid !important;
    grid-template-columns: 0.95fr 1.05fr !important;
    gap: 36px !important;
    align-items: center !important;
    position: relative !important;
    padding-bottom: 40px !important;
  }

  /* LEFT COLUMN: VIDEO THUMBNAIL CARD (ALIGN 100% FLUSH TO LEFT) */
  .vs-video-thumb-card {
    position: relative !important;
    border-radius: 16px !important;
    overflow: hidden !important;
    width: 100% !important;
    aspect-ratio: 16 / 10.2 !important;
    background: #0F172A !important;
    cursor: pointer !important;
    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.12), 0 4px 15px rgba(236, 92, 10, 0.08) !important;
    border: 2px solid #FFFFFF !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
  }

  .vs-video-thumb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-img {
    transform: scale(1.04) !important;
  }

  .vs-video-thumb-overlay {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.08) 0%, rgba(15, 23, 42, 0.3) 100%) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background 0.3s ease !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-overlay {
    background: rgba(15, 23, 42, 0.18) !important;
  }

  /* BRAND ORANGE PULSING CIRCULAR PLAY BUTTON */
  .vs-play-btn-circle {
    width: 58px !important;
    height: 58px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.5) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    padding-left: 3px !important;
    position: relative !important;
  }

  .vs-play-btn-circle::before {
    content: '' !important;
    position: absolute !important;
    inset: -7px !important;
    border-radius: 50% !important;
    background: rgba(236, 92, 10, 0.35) !important;
    animation: vsPulsePlay 2s infinite !important;
    z-index: -1 !important;
  }

  @keyframes vsPulsePlay {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.25); opacity: 0.15; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .vs-video-thumb-card:hover .vs-play-btn-circle {
    transform: scale(1.12) !important;
    box-shadow: 0 12px 35px rgba(236, 92, 10, 0.7) !important;
  }

  /* RIGHT COLUMN: COMPACT & MINIMIZED CONTENT */
  .vs-video-content-col {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    position: relative !important;
    padding: 0 !important;
  }

  .vs-script-subtitle {
    font-family: 'Caveat', cursive !important;
    font-size: 1.45rem !important;
    color: #EC5C0A !important;
    margin-bottom: 2px !important;
    line-height: 1.1 !important;
    letter-spacing: 0.5px !important;
    font-weight: 700 !important;
  }

  .vs-video-main-heading {
    font-size: 1.85rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    line-height: 1.2 !important;
    margin: 0 0 12px 0 !important;
    letter-spacing: -0.4px !important;
  }

  .vs-video-main-heading span {
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  /* SLEEK FEATURE SECTION WITH BULLET POINTS */
  .vs-video-feature-section {
    display: flex !important;
    align-items: flex-start !important;
    gap: 12px !important;
    margin-bottom: 14px !important;
    background: #FFF8F4 !important;
    border: 1px solid #FFE0D0 !important;
    padding: 12px 14px !important;
    border-radius: 12px !important;
  }

  .vs-feature-icon-box {
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #EC5C0A !important;
    background: #FFFFFF !important;
    border-radius: 8px !important;
    box-shadow: 0 3px 10px rgba(236, 92, 10, 0.12) !important;
  }

  .vs-feature-icon-box svg {
    width: 20px !important;
    height: 20px !important;
    display: block !important;
  }

  .vs-feature-text-block {
    flex: 1 !important;
  }

  .vs-feature-title {
    margin: 0 0 6px 0 !important;
    font-size: 0.88rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    line-height: 1.25 !important;
  }

  /* BULLET POINTS LIST FOR CONCISE CONTENT */
  .vs-feature-points-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
  }

  .vs-feature-point-item {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 0.78rem !important;
    color: #475569 !important;
    line-height: 1.3 !important;
  }

  .vs-point-bullet {
    width: 15px !important;
    height: 15px !important;
    min-width: 15px !important;
    border-radius: 50% !important;
    background: #FFF3EB !important;
    border: 1px solid #EC5C0A !important;
    color: #EC5C0A !important;
    font-size: 0.65rem !important;
    font-weight: 900 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* COMPACT ACTION BUTTON */
  .vs-video-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    padding: 9px 20px !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    border-radius: 7px !important;
    text-decoration: none !important;
    box-shadow: 0 5px 16px rgba(236, 92, 10, 0.35) !important;
    transition: all 0.3s ease !important;
    width: fit-content !important;
    margin-bottom: 10px !important;
  }

  .vs-video-cta-btn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 22px rgba(236, 92, 10, 0.5) !important;
    color: #FFFFFF !important;
  }

  /* 6 PROPORTIONATE CARDS (BALANCED OVERLAP -45px SO NO CONTENT IS COVERED) */
  .vs-floating-cards-row {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    gap: 14px !important;
    width: 100% !important;
    max-width: 1080px !important;
    margin: -45px auto 0 auto !important;
    position: relative !important;
    z-index: 25 !important;
  }

  .vs-nav-card-item {
    background: #FFFFFF !important;
    border-radius: 12px !important;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08), 0 2px 6px rgba(0, 0, 0, 0.02) !important;
    border: 1.5px solid rgba(241, 245, 249, 0.9) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    aspect-ratio: 1 / 1 !important;
    padding: 12px 6px 10px 6px !important;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    cursor: pointer !important;
  }

  .vs-nav-card-item:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 16px 35px rgba(236, 92, 10, 0.18) !important;
    border-color: #EC5C0A !important;
  }

  .vs-card-icon-art {
    width: 40px !important;
    height: 40px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 6px !important;
    transition: transform 0.3s ease !important;
  }

  .vs-nav-card-item:hover .vs-card-icon-art {
    transform: scale(1.1) !important;
  }

  .vs-card-icon-art svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .vs-card-label {
    font-size: 0.78rem !important;
    font-weight: 800 !important;
    text-align: center !important;
    line-height: 1.2 !important;
    margin: 0 !important;
    letter-spacing: -0.2px !important;
  }

  /* VIDEO MODAL POPUP */
  .vs-video-modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 23, 42, 0.88) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 99999 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
    opacity: 0 !important;
    transition: opacity 0.3s ease !important;
  }

  .vs-video-modal-overlay.active {
    display: flex !important;
    opacity: 1 !important;
  }

  .vs-video-modal-content {
    position: relative !important;
    width: 90vw !important;
    max-width: 960px !important;
    height: 540px !important;
    max-height: 82vh !important;
    aspect-ratio: 16 / 9 !important;
    background: #000000 !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.75), 0 0 40px rgba(236, 92, 10, 0.3) !important;
    border: 2px solid rgba(236, 92, 10, 0.4) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .vs-video-modal-close {
    position: absolute !important;
    top: 15px !important;
    right: 20px !important;
    color: #FFFFFF !important;
    font-size: 2.2rem !important;
    cursor: pointer !important;
    background: rgba(15, 23, 42, 0.7) !important;
    border-radius: 50% !important;
    width: 42px !important;
    height: 42px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    line-height: 1 !important;
    transition: transform 0.2s ease, color 0.2s ease !important;
    z-index: 10 !important;
  }

  .vs-video-modal-close:hover {
    transform: scale(1.15) !important;
    color: #FF9A00 !important;
    background: rgba(15, 23, 42, 0.9) !important;
  }

  .vs-video-modal-iframe {
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    display: block !important;
  }

  .vs-video-modal-video {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    background: #000000 !important;
  }
{%- endstyle -%}

<!-- SECTION 3: VIDHYUT EXPERT VIDEO SHOWCASE -->
<section class="vs-desktop-video-section" id="vsExpertVideoSection-{{ section.id }}">
  <div class="vs-desktop-video-container">

    <div class="vs-video-main-wrapper">
      
      <!-- Determine Video URL -->
      {%- assign active_video_target = section.settings.video_url -%}
      {%- if section.settings.custom_video_file != blank -%}
        {%- assign active_video_target = section.settings.custom_video_file.sources[0].url -%}
      {%- elsif section.settings.custom_video_url != blank -%}
        {%- assign active_video_target = section.settings.custom_video_url -%}
      {%- endif -%}

      <!-- 2-COLUMN TOP GRID -->
      <div class="vs-video-top-grid">
        
        <!-- LEFT COLUMN: VIDEO THUMBNAIL (100% FLUSH TO LEFT) -->
        <div class="vs-video-thumb-card" onclick="vsOpenVideoModal('{{ active_video_target | escape }}')">
          {%- if section.settings.thumbnail != blank -%}
            <img src="{{ section.settings.thumbnail | image_url: width: 1000 }}" alt="{{ section.settings.headline_text | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- elsif section.settings.thumbnail_image != blank -%}
            <img src="{{ section.settings.thumbnail_image | image_url: width: 1000 }}" alt="{{ section.settings.headline_text | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- else -%}
            <img src="{{ 'hero-advisor-calculator.jpg' | asset_url }}" alt="Vidhyut Saathi Technology Showcase" class="vs-video-thumb-img" loading="lazy">
          {%- endif -%}
          
          <div class="vs-video-thumb-overlay">
            <div class="vs-play-btn-circle">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>

