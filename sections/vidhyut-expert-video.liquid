{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap');

  /* ===========================================================================
     SECTION 4: VIDHYUT EXPERT VIDEO SHOWCASE
     COMMON / BASE STYLES
     =========================================================================== */
  .vs-desktop-video-section {
    position: relative !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
  }

  .vs-desktop-video-container {
    width: 100% !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  .vs-video-main-wrapper {
    position: relative !important;
    width: 100% !important;
  }

  .vs-video-thumb-card {
    position: relative !important;
    overflow: hidden !important;
    background: #0F172A !important;
    cursor: pointer !important;
    box-sizing: border-box !important;
  }

  .vs-video-thumb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-img {
    transform: scale(1.04) !important;
  }

  .vs-video-thumb-overlay {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.08) 0%, rgba(15, 23, 42, 0.32) 100%) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background 0.3s ease !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-overlay {
    background: rgba(15, 23, 42, 0.2) !important;
  }

  .vs-play-btn-circle {
    border-radius: 50% !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    padding-left: 4px !important;
    position: relative !important;
  }

  .vs-play-btn-circle::before {
    content: '' !important;
    position: absolute !important;
    inset: -8px !important;
    border-radius: 50% !important;
    background: rgba(236, 92, 10, 0.35) !important;
    animation: vsPulsePlay 2s infinite !important;
    z-index: -1 !important;
  }

  @keyframes vsPulsePlay {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.25); opacity: 0.15; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .vs-video-thumb-card:hover .vs-play-btn-circle {
    transform: scale(1.14) !important;
    box-shadow: 0 14px 40px rgba(236, 92, 10, 0.7) !important;
  }

  .vs-video-main-heading span {
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  .vs-video-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
    color: #FFFFFF !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.35) !important;
    transition: all 0.3s ease !important;
  }

  .vs-video-cta-btn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 28px rgba(236, 92, 10, 0.5) !important;
    color: #FFFFFF !important;
  }

  .vs-nav-card-item {
    background: #FFFFFF !important;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.1), 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    border: 1.5px solid rgba(241, 245, 249, 0.9) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    aspect-ratio: 1 / 1 !important;
    text-decoration: none !important;
    cursor: pointer !important;
  }

  .vs-card-icon-art {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: var(--card-color, #EC5C0A) !important;
  }

  .vs-card-icon-art svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
    stroke: currentColor !important;
    transition: stroke 0.35s ease, fill 0.35s ease !important;
  }

  /* VIDEO MODAL POPUP */
  .vs-video-modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 23, 42, 0.88) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 99999 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
    opacity: 0 !important;
    transition: opacity 0.3s ease !important;
  }

  .vs-video-modal-overlay.active {
    display: flex !important;
    opacity: 1 !important;
  }

  .vs-video-modal-content {
    position: relative !important;
    width: 90vw !important;
    max-width: 960px !important;
    height: 540px !important;
    max-height: 82vh !important;
    aspect-ratio: 16 / 9 !important;
    background: #000000 !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.75), 0 0 40px rgba(236, 92, 10, 0.3) !important;
    border: 2px solid rgba(236, 92, 10, 0.4) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .vs-video-modal-close {
    position: absolute !important;
    top: 15px !important;
    right: 20px !important;
    color: #FFFFFF !important;
    font-size: 2.2rem !important;
    cursor: pointer !important;
    background: rgba(15, 23, 42, 0.7) !important;
    border-radius: 50% !important;
    width: 42px !important;
    height: 42px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    line-height: 1 !important;
    transition: transform 0.2s ease, color 0.2s ease !important;
    z-index: 10 !important;
  }

  .vs-video-modal-close:hover {
    transform: scale(1.15) !important;
    color: #FF9A00 !important;
    background: rgba(15, 23, 42, 0.9) !important;
  }

  .vs-video-modal-iframe {
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    display: block !important;
  }

  .vs-video-modal-video {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    background: #000000 !important;
  }

  /* ===========================================================================
     DESKTOP VIEW (LOCKED & PRESERVED EXACTLY AS ORIGINALLY DESIGNED)
     =========================================================================== */
  @media screen and (min-width: 769px) {
    .vs-desktop-video-section {
      display: block !important;
      padding: 60px 0 70px 0 !important;
      background: linear-gradient(180deg, #FFFDF9 0%, #FAF6EE 50%, #FFFDF9 100%) !important;
      overflow: visible !important;
    }

    .vs-desktop-video-container {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 0 0 36px !important;
    }

    .vs-video-top-grid {
      display: grid !important;
      grid-template-columns: 0.95fr 1.05fr !important;
      gap: 46px !important;
      align-items: flex-start !important;
      position: relative !important;
      padding-bottom: 210px !important;
      width: 100% !important;
    }

    .vs-video-thumb-card {
      border-radius: 20px !important;
      width: 100% !important;
      max-width: 580px !important;
      height: 510px !important;
      box-shadow: 0 16px 45px rgba(15, 23, 42, 0.12), 0 4px 15px rgba(236, 92, 10, 0.08) !important;
      border: 3px solid #FFFFFF !important;
      margin-left: 18px !important;
    }

    .vs-play-btn-circle {
      width: 68px !important;
      height: 68px !important;
      box-shadow: 0 10px 30px rgba(236, 92, 10, 0.5) !important;
    }

    .vs-video-content-col {
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      position: relative !important;
      padding: 15px 40px 0 0 !important;
      max-width: 560px !important;
    }

    .vs-script-subtitle {
      font-family: 'Caveat', cursive !important;
      font-size: 1.75rem !important;
      color: #EC5C0A !important;
      margin-bottom: 2px !important;
      line-height: 1.15 !important;
      letter-spacing: 0.5px !important;
      font-weight: 700 !important;
    }

    .vs-video-main-heading {
      font-size: 2.15rem !important;
      font-weight: 800 !important;
      color: #0F172A !important;
      line-height: 1.25 !important;
      margin: 0 0 16px 0 !important;
      letter-spacing: -0.5px !important;
    }

    .vs-video-feature-section {
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      margin-bottom: 22px !important;
      max-width: 500px !important;
    }

    .vs-feature-title-row {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      margin-bottom: 10px !important;
    }

    .vs-feature-title {
      margin: 0 !important;
      font-size: 1.02rem !important;
      font-weight: 800 !important;
      color: #0F172A !important;
      line-height: 1.3 !important;
    }

    .vs-feature-points-list {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
    }

    .vs-feature-point-item {
      display: flex !important;
      align-items: flex-start !important;
      gap: 8px !important;
      font-size: 0.85rem !important;
      color: #475569 !important;
      line-height: 1.45 !important;
    }

    .vs-point-bullet {
      width: 18px !important;
      height: 18px !important;
      min-width: 18px !important;
      border-radius: 50% !important;
      background: #FFF3EB !important;
      border: 1px solid #EC5C0A !important;
      color: #EC5C0A !important;
      font-size: 0.7rem !important;
      font-weight: 900 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin-top: 1px !important;
    }

    .vs-video-cta-btn {
      padding: 12px 26px !important;
      font-size: 0.88rem !important;
      border-radius: 8px !important;
      width: fit-content !important;
    }

    .vs-floating-cards-row {
      display: grid !important;
      grid-template-columns: repeat(6, 1fr) !important;
      gap: 14px !important;
      width: 100% !important;
      max-width: 1080px !important;
      margin: -350px auto 0 auto !important;
      position: relative !important;
      z-index: 25 !important;
    }

    .vs-nav-card-item {
      border-radius: 14px !important;
      padding: 14px 6px 12px 6px !important;
      transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease, transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.35s ease !important;
    }

    .vs-nav-card-item:hover {
      background-color: var(--card-color, #EC5C0A) !important;
      border-color: var(--card-color, #EC5C0A) !important;
      transform: translateY(-8px) scale(1.03) !important;
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.22) !important;
      color: #FFFFFF !important;
    }

    .vs-card-icon-art {
      width: 42px !important;
      height: 42px !important;
      margin-bottom: 6px !important;
      transition: transform 0.35s ease, color 0.35s ease !important;
    }

    .vs-nav-card-item:hover .vs-card-icon-art {
      transform: scale(1.12) !important;
      color: #FFFFFF !important;
    }

    .vs-nav-card-item:hover .vs-card-icon-art svg {
      stroke: #FFFFFF !important;
    }

    .vs-nav-card-item:hover .vs-card-icon-art svg[fill]:not([fill="none"]) {
      fill: #FFFFFF !important;
    }

    .vs-card-label {
      font-size: 0.8rem !important;
      font-weight: 800 !important;
      text-align: center !important;
      line-height: 1.2 !important;
      margin: 0 !important;
      letter-spacing: -0.2px !important;
      transition: color 0.35s ease !important;
      color: var(--card-color, #EC5C0A) !important;
    }

    .vs-nav-card-item:hover .vs-card-label {
      color: #FFFFFF !important;
    }
  }

  /* ===========================================================================
     MOBILE VIEW (ULTRA-LUCATATIVE, TOUCH-FRIENDLY & CLEAN ALIGNMENT)
     =========================================================================== */
  @media screen and (max-width: 768px) {
    .vs-desktop-video-section {
      display: block !important;
      padding: 30px 0 34px 0 !important;
      background: linear-gradient(180deg, #FFFDF9 0%, #FAF4E8 50%, #FFFDF9 100%) !important;
      overflow: hidden !important;
    }

    .vs-desktop-video-container {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 auto !important;
      padding: 0 16px !important;
      box-sizing: border-box !important;
    }

    .vs-video-top-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 18px !important;
      padding-bottom: 0 !important;
      width: 100% !important;
    }

    /* Video Thumbnail Card on Mobile: 100% full width, 16/9 aspect ratio */
    .vs-video-thumb-card {
      width: 100% !important;
      max-width: 100% !important;
      height: 220px !important;
      margin: 0 !important;
      border-radius: 16px !important;
      border: 3px solid #FFFFFF !important;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12), 0 4px 12px rgba(236, 92, 10, 0.08) !important;
    }

    .vs-play-btn-circle {
      width: 56px !important;
      height: 56px !important;
      box-shadow: 0 8px 24px rgba(236, 92, 10, 0.55) !important;
    }

    .vs-play-btn-circle svg {
      width: 22px !important;
      height: 22px !important;
    }

    .vs-video-content-col {
      display: flex !important;
      flex-direction: column !important;
      padding: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      text-align: left !important;
    }

    .vs-script-subtitle {
      font-family: 'Caveat', cursive !important;
      font-size: 1.55rem !important;
      color: #EC5C0A !important;
      margin-bottom: 2px !important;
      line-height: 1.2 !important;
      font-weight: 700 !important;
    }

    .vs-video-main-heading {
      font-size: 1.65rem !important;
      font-weight: 900 !important;
      line-height: 1.25 !important;
      margin: 2px 0 14px 0 !important;
      letter-spacing: -0.4px !important;
      color: #0F172A !important;
    }

    /* Lucrative White Feature Card on Mobile */
    .vs-video-feature-section {
      background: #FFFFFF !important;
      border: 1.5px solid #F1E5D8 !important;
      border-radius: 16px !important;
      padding: 14px 14px !important;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04) !important;
      margin-bottom: 16px !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }

    .vs-feature-title-row {
      display: flex !important;
      align-items: flex-start !important;
      gap: 8px !important;
      margin-bottom: 10px !important;
    }

    .vs-feature-title {
      font-size: 0.96rem !important;
      font-weight: 800 !important;
      line-height: 1.35 !important;
      color: #0F172A !important;
      margin: 0 !important;
    }

    .vs-feature-points-list {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
    }

    .vs-feature-point-item {
      display: flex !important;
      align-items: flex-start !important;
      gap: 8px !important;
      font-size: 0.82rem !important;
      line-height: 1.42 !important;
      color: #334155 !important;
    }

    .vs-point-bullet {
      width: 18px !important;
      height: 18px !important;
      min-width: 18px !important;
      border-radius: 50% !important;
      background: linear-gradient(135deg, #FFF3EB 0%, #FFE6D5 100%) !important;
      border: 1px solid #EC5C0A !important;
      color: #EC5C0A !important;
      font-size: 0.7rem !important;
      font-weight: 900 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin-top: 1px !important;
    }

    /* Shiny Touch-Friendly Full-Width CTA Button */
    .vs-video-cta-btn {
      width: 100% !important;
      padding: 14px 20px !important;
      font-size: 0.94rem !important;
      font-weight: 800 !important;
      letter-spacing: 0.3px !important;
      border-radius: 12px !important;
      justify-content: center !important;
      background: linear-gradient(135deg, #EC5C0A 0%, #FF7A00 100%) !important;
      box-shadow: 0 8px 24px rgba(236, 92, 10, 0.35) !important;
      box-sizing: border-box !important;
    }

    /* Clean 3x2 Grid for Category Plans */
    .vs-floating-cards-row {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 8px !important;
      margin: 20px 0 0 0 !important;
      max-width: 100% !important;
      width: 100% !important;
      position: relative !important;
      z-index: 10 !important;
    }

    .vs-nav-card-item {
      background: #FFFFFF !important;
      border-radius: 14px !important;
      border: 1.5px solid #EAE2D8 !important;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05) !important;
      padding: 12px 4px 10px 4px !important;
      aspect-ratio: 1 / 1 !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
      box-sizing: border-box !important;
    }

    .vs-nav-card-item:active {
      transform: scale(0.95) !important;
      border-color: var(--card-color, #EC5C0A) !important;
      background: #FFF9F5 !important;
    }

    .vs-card-icon-art {
      width: 30px !important;
      height: 30px !important;
      margin-bottom: 4px !important;
      color: var(--card-color, #EC5C0A) !important;
    }

    .vs-card-label {
      font-size: 0.72rem !important;
      font-weight: 800 !important;
      line-height: 1.2 !important;
      text-align: center !important;
      color: var(--card-color, #EC5C0A) !important;
      margin: 0 !important;
    }

    .vs-video-modal-content {
      width: 95vw !important;
      height: auto !important;
      aspect-ratio: 16 / 9 !important;
      border-radius: 14px !important;
    }

    .vs-video-modal-close {
      top: 10px !important;
      right: 12px !important;
      width: 34px !important;
      height: 34px !important;
      font-size: 1.8rem !important;
    }
  }
{%- endstyle -%}

<!-- SECTION 3: VIDHYUT EXPERT VIDEO SHOWCASE -->
<section class="vs-desktop-video-section" id="vsExpertVideoSection-{{ section.id }}">
  <div class="vs-desktop-video-container">

    <div class="vs-video-main-wrapper">
      
      <!-- Determine Video URL -->
      {%- assign active_video_target = section.settings.video_url -%}
      {%- if section.settings.custom_video_file != blank -%}
        {%- assign active_video_target = section.settings.custom_video_file.sources[0].url -%}
      {%- elsif section.settings.custom_video_url != blank -%}
        {%- assign active_video_target = section.settings.custom_video_url -%}
      {%- endif -%}

      <!-- 2-COLUMN TOP GRID -->
      <div class="vs-video-top-grid">
        
        <!-- LEFT COLUMN: VIDEO THUMBNAIL (ROUNDED 510px TALL CARD) -->
        <div class="vs-video-thumb-card" onclick="vsOpenVideoModal('{{ active_video_target | escape }}')">
          {%- if section.settings.thumbnail != blank -%}
            <img src="{{ section.settings.thumbnail | image_url: width: 1000 }}" alt="{{ section.settings.headline_text | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- elsif section.settings.thumbnail_image != blank -%}
            <img src="{{ section.settings.thumbnail_image | image_url: width: 1000 }}" alt="{{ section.settings.headline_text | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- else -%}
            <img src="{{ 'hero-advisor-calculator.jpg' | asset_url }}" alt="Vidhyut Saathi Technology Showcase" class="vs-video-thumb-img" loading="lazy">
          {%- endif -%}
          
          <div class="vs-video-thumb-overlay">
            <div class="vs-play-btn-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: BRAND THEMED CONTENT -->
        <div class="vs-video-content-col">
          <div class="vs-script-subtitle">{{ section.settings.script_subtitle | default: "Smart Energy Tech" }}</div>
          <h2 class="vs-video-main-heading">
            Choose Your <span>Favorite Energy Plan</span>
          </h2>

          <!-- BORDERLESS FEATURE SECTION WITH POINTS -->
          <div class="vs-video-feature-section">
            <div class="vs-feature-title-row">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EC5C0A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              <h4 class="vs-feature-title">{{ section.settings.feature_title | default: "We Suggest You The Best Energy Optimization Solution" }}</h4>
            </div>

            <ul class="vs-feature-points-list">
              <li class="vs-feature-point-item">
                <span class="vs-point-bullet">✓</span>
                <span><strong>Vidhyut Saathi Energy Savers Pvt. Ltd.</strong></span>
              </li>
              <li class="vs-feature-point-item">
                <span class="vs-point-bullet">✓</span>
                <span>Specialized in electricity load optimization & <strong>20-30% power saving solutions</strong></span>
              </li>
              <li class="vs-feature-point-item">
                <span class="vs-point-bullet">✓</span>
                <span>Trusted by over <strong>500+ commercial & residential clients</strong> across India</span>
              </li>
            </ul>
          </div>

          <!-- BRAND ORANGE CTA BUTTON -->
