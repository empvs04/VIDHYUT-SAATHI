{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap');

  /* ===========================================================================
     SECTION 3: VIDHYUT EXPERT VIDEO SHOWCASE (DESKTOP ONLY)
     EXACT REPLICA DESIGN: 2-COLUMN SPLIT WITH 6 COMPACT OVERLAPPING 0.75:0.75 CARDS
     =========================================================================== */
  .vs-desktop-video-section {
    display: block !important;
    padding: 60px 0 90px 0 !important;
    background: #FFFFFF !important;
    position: relative !important;
    overflow: visible !important;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
  }

  /* Hide on Mobile */
  @media screen and (max-width: 768px) {
    .vs-desktop-video-section {
      display: none !important;
    }
  }

  .vs-desktop-video-container {
    max-width: 1140px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
    position: relative !important;
  }

  .vs-video-main-wrapper {
    position: relative !important;
    width: 100% !important;
  }

  /* 2-COLUMN TOP GRID (50/50 ALIGNED) */
  .vs-video-top-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 44px !important;
    align-items: center !important;
    position: relative !important;
    padding-bottom: 20px !important;
  }

  /* LEFT COLUMN: VIDEO THUMBNAIL CARD */
  .vs-video-thumb-card {
    position: relative !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    width: 100% !important;
    aspect-ratio: 16 / 10.5 !important;
    background: #0F172A !important;
    cursor: pointer !important;
    box-shadow: 0 16px 45px rgba(15, 23, 42, 0.12), 0 4px 15px rgba(0, 0, 0, 0.05) !important;
    border: 3px solid #FFFFFF !important;
  }

  .vs-video-thumb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-img {
    transform: scale(1.04) !important;
  }

  .vs-video-thumb-overlay {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.05) 0%, rgba(15, 23, 42, 0.25) 100%) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background 0.3s ease !important;
  }

  .vs-video-thumb-card:hover .vs-video-thumb-overlay {
    background: rgba(15, 23, 42, 0.15) !important;
  }

  /* VIBRANT BLUE CIRCULAR PLAY BUTTON */
  .vs-play-btn-circle {
    width: 64px !important;
    height: 64px !important;
    border-radius: 50% !important;
    background: #0284C7 !important;
    color: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 8px 25px rgba(2, 132, 199, 0.5) !important;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    padding-left: 4px !important;
    position: relative !important;
  }

  .vs-play-btn-circle::before {
    content: '' !important;
    position: absolute !important;
    inset: -8px !important;
    border-radius: 50% !important;
    background: rgba(2, 132, 199, 0.35) !important;
    animation: vsPulsePlay 2s infinite !important;
    z-index: -1 !important;
  }

  @keyframes vsPulsePlay {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.25); opacity: 0.15; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .vs-video-thumb-card:hover .vs-play-btn-circle {
    transform: scale(1.12) !important;
    box-shadow: 0 12px 35px rgba(2, 132, 199, 0.7) !important;
  }

  /* RIGHT COLUMN: CONTENT */
  .vs-video-content-col {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    position: relative !important;
    padding: 0 0 0 10px !important;
  }

  .vs-script-subtitle {
    font-family: 'Caveat', cursive !important;
    font-size: 1.85rem !important;
    color: #0284C7 !important;
    margin-bottom: 2px !important;
    line-height: 1.15 !important;
    letter-spacing: 0.5px !important;
    font-weight: 700 !important;
  }

  .vs-video-main-heading {
    font-size: 2.35rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    line-height: 1.2 !important;
    margin: 0 0 20px 0 !important;
    letter-spacing: -0.5px !important;
  }

  .vs-video-main-heading span {
    color: #0284C7 !important;
  }

  /* FEATURE SECTION WITH ICON ON LEFT & TEXT ON RIGHT */
  .vs-video-feature-section {
    display: flex !important;
    align-items: flex-start !important;
    gap: 16px !important;
    margin-bottom: 26px !important;
  }

  .vs-feature-icon-box {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #334155 !important;
    margin-top: 2px !important;
  }

  .vs-feature-icon-box svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .vs-feature-text-block {
    flex: 1 !important;
  }

  .vs-feature-title {
    margin: 0 0 6px 0 !important;
    font-size: 1.05rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    line-height: 1.3 !important;
  }

  .vs-feature-desc {
    margin: 0 !important;
    font-size: 0.86rem !important;
    color: #64748B !important;
    line-height: 1.55 !important;
  }

  /* ACTION BUTTON */
  .vs-video-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 12px 26px !important;
    background: #0284C7 !important;
    color: #FFFFFF !important;
    font-size: 0.88rem !important;
    font-weight: 700 !important;
    border-radius: 6px !important;
    text-decoration: none !important;
    box-shadow: 0 6px 20px rgba(2, 132, 199, 0.3) !important;
    transition: all 0.3s ease !important;
    width: fit-content !important;
  }

  .vs-video-cta-btn:hover {
    transform: translateY(-2px) !important;
    background: #0369A1 !important;
    box-shadow: 0 10px 25px rgba(2, 132, 199, 0.45) !important;
    color: #FFFFFF !important;
  }

  /* 6 PROPORTIONATE OVERLAPPING CARDS (0.75:0.75 COMPACT SQUARE SCALE) */
  .vs-floating-cards-row {
    display: grid !important;
    grid-template-columns: repeat(6, 1fr) !important;
    gap: 16px !important;
    width: 100% !important;
    max-width: 1060px !important;
    margin: -50px auto 0 auto !important;
    position: relative !important;
    z-index: 25 !important;
  }

  .vs-nav-card-item {
    background: #FFFFFF !important;
    border-radius: 14px !important;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08), 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    border: 1px solid rgba(226, 232, 240, 0.8) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    aspect-ratio: 1 / 1 !important;
    padding: 16px 8px 14px 8px !important;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    cursor: pointer !important;
  }

  .vs-nav-card-item:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14) !important;
    border-color: #CBD5E1 !important;
  }

  .vs-card-icon-art {
    width: 44px !important;
    height: 44px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 8px !important;
    transition: transform 0.3s ease !important;
  }

  .vs-nav-card-item:hover .vs-card-icon-art {
    transform: scale(1.12) !important;
  }

  .vs-card-icon-art svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .vs-card-label {
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    text-align: center !important;
    line-height: 1.2 !important;
    margin: 0 !important;
    letter-spacing: -0.2px !important;
  }

  /* VIDEO MODAL POPUP */
  .vs-video-modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(15, 23, 42, 0.88) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 99999 !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 20px !important;
    opacity: 0 !important;
    transition: opacity 0.3s ease !important;
  }

  .vs-video-modal-overlay.active {
    display: flex !important;
    opacity: 1 !important;
  }

  .vs-video-modal-content {
    position: relative !important;
    width: 90vw !important;
    max-width: 960px !important;
    height: 540px !important;
    max-height: 82vh !important;
    aspect-ratio: 16 / 9 !important;
    background: #000000 !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.75), 0 0 40px rgba(2, 132, 199, 0.3) !important;
    border: 2px solid rgba(2, 132, 199, 0.4) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .vs-video-modal-close {
    position: absolute !important;
    top: 15px !important;
    right: 20px !important;
    color: #FFFFFF !important;
    font-size: 2.2rem !important;
    cursor: pointer !important;
    background: rgba(15, 23, 42, 0.7) !important;
    border-radius: 50% !important;
    width: 42px !important;
    height: 42px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    line-height: 1 !important;
    transition: transform 0.2s ease, color 0.2s ease !important;
    z-index: 10 !important;
  }

  .vs-video-modal-close:hover {
    transform: scale(1.15) !important;
    color: #0284C7 !important;
    background: rgba(15, 23, 42, 0.9) !important;
  }

  .vs-video-modal-iframe {
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    display: block !important;
  }

  .vs-video-modal-video {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    background: #000000 !important;
  }
{%- endstyle -%}

<!-- SECTION 3: VIDHYUT EXPERT VIDEO SHOWCASE -->
<section class="vs-desktop-video-section" id="vsExpertVideoSection-{{ section.id }}">
  <div class="vs-desktop-video-container">

    <div class="vs-video-main-wrapper">
      
      <!-- Determine Video URL -->
      {%- assign active_video_target = section.settings.video_url -%}
      {%- if section.settings.custom_video_file != blank -%}
        {%- assign active_video_target = section.settings.custom_video_file.sources[0].url -%}
      {%- elsif section.settings.custom_video_url != blank -%}
        {%- assign active_video_target = section.settings.custom_video_url -%}
      {%- endif -%}

      <!-- 2-COLUMN TOP GRID -->
      <div class="vs-video-top-grid">
        
        <!-- LEFT COLUMN: VIDEO THUMBNAIL -->
        <div class="vs-video-thumb-card" onclick="vsOpenVideoModal('{{ active_video_target | escape }}')">
          {%- if section.settings.thumbnail != blank -%}
            <img src="{{ section.settings.thumbnail | image_url: width: 1000 }}" alt="{{ section.settings.headline_text | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- elsif section.settings.thumbnail_image != blank -%}
            <img src="{{ section.settings.thumbnail_image | image_url: width: 1000 }}" alt="{{ section.settings.headline_text | escape }}" class="vs-video-thumb-img" loading="lazy">
          {%- else -%}
            <img src="{{ 'hero-advisor-calculator.jpg' | asset_url }}" alt="Vidhyut Saathi Technology Showcase" class="vs-video-thumb-img" loading="lazy">
          {%- endif -%}
          
          <div class="vs-video-thumb-overlay">
            <div class="vs-play-btn-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: CONTENT -->
        <div class="vs-video-content-col">
          <div class="vs-script-subtitle">{{ section.settings.script_subtitle | default: "Smart Energy Tech" }}</div>
          <h2 class="vs-video-main-heading">
            {{ section.settings.headline_text | default: "Choose Your Favorite Energy Plan" }}
          </h2>

          <!-- FEATURE SECTION: ICON ON LEFT, TEXT ON RIGHT -->
          <div class="vs-video-feature-section">
            <div class="vs-feature-icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <div class="vs-feature-text-block">
              <h4 class="vs-feature-title">{{ section.settings.feature_title | default: "We Suggest You The Best Energy Optimization Solution" }}</h4>
              <p class="vs-feature-desc">{{ section.settings.feature_desc | default: "Vidhyut Saathi Energy Savers Private Limited is specialized in electricity load optimization & 20-30% power saving solutions for over 500+ commercial & residential clients across India." }}</p>
            </div>
          </div>

          <!-- ACTION BUTTON -->
          <a href="{{ section.settings.button_link | default: '/pages/get-franchise' }}" class="vs-video-cta-btn">
            <span>{{ section.settings.button_text | default: "Book Free Consultation" }}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

      </div>

      <!-- 6 COMPACT OVERLAPPING CARDS (0.75:0.75 SQUARE PROPORTION) -->
      <div class="vs-floating-cards-row">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.card_link | default: '#' }}" class="vs-nav-card-item" {{ block.shopify_attributes }}>
            <div class="vs-card-icon-art" style="color: {{ block.settings.card_color | default: '#0284C7' }};">
              {{ block.settings.card_icon_svg | default: '' }}
            </div>
            <h4 class="vs-card-label" style="color: {{ block.settings.card_color | default: '#0284C7' }};">{{ block.settings.card_title | default: 'Plan' }}</h4>
          </a>
        {%- else -%}
          <!-- Default 6 Cards matching the reference screenshot design -->
          
          <!-- Card 1: Mountain / Residential (Sky Blue) -->
          <a href="/pages/residential" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #0096FF;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 3l4 8 5-5 5 10H2L8 3z"></path>
                <path d="M4 14l2-3 2 3"></path>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #0096FF;">Residential</h4>
          </a>

          <!-- Card 2: Pilgrims / Commercial (Pink/Rose) -->
          <a href="/pages/commercial" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #FF3366;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="5" r="2"></circle>
                <path d="M10 22v-6l-2-2v-4l4-2 4 2v4l-2 2v6"></path>
                <path d="M18 10l2 2"></path>
