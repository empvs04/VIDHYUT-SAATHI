          <!-- Card 4: National Park / Franchise (Amber/Orange Tree) -->
          <a href="/pages/get-franchise" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #FF8C42;">
              <svg viewBox="0 0 24 24" fill="#FF8C42" stroke="none">
                <path d="M12 2L4 12h3v4H5l-3 4h8v2h4v-2h8l-3-4h-2v-4h3L12 2z"></path>
              </svg>
            </div>
            <h4 class="vs-card-label" style="color: #FF8C42;">Franchise</h4>
          </a>

          <!-- Card 5: Campfire / ISO Certified (Indigo/Blue) -->
          <a href="/pages/iso-certification" class="vs-nav-card-item">
            <div class="vs-card-icon-art" style="color: #5C6BC0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
