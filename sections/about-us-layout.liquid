{%- style -%}
  /* --- Base Variables & Reset --- */
  :root {
    --about-primary: #ec5c0a;
    --about-secondary: #007b3e;
    --about-bg: #fff8ef;
    --about-text-dark: #1a1a1a;
    --about-text-light: #555555;
    --about-radius: 20px;
    --about-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  
  .about-us-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--about-text-dark);
    background-color: var(--about-bg);
    overflow: hidden;
  }

  /* --- Premium 3D & Reveal Utilities --- */
  .reveal-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .tilt-element {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    will-change: transform;
    /* Added subtle shadow to enhance 3D pop */
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  }
  
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
  
  /* --- Responsive --- */
  @media screen and (max-width: 900px) {
    .page-header_title { font-size: 3rem !important; }
  }
  @media screen and (max-width: 600px) {
    .page-header_title { font-size: 2.2rem !important; }
  }
  
  /* --- Marquee CSS Animation --- */
  @keyframes scroll-right {
    0% { transform: translateX(-100%) translateY(-50%); }
    100% { transform: translateX(100%) translateY(-50%); }
  }
  .moving-text {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: max-content;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.8;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(80px, 12vw, 150px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-fill-color: transparent;
    animation: scroll-right 25s linear infinite;
  }
  
  /* --- Company Info Section --- */
  .company-info-section {
    padding: 80px 20px;
    background-color: #f9f9f9;
  }
  .company-info-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  .company-info-text .gradient-heading {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    background: linear-gradient(45deg, #0052cc, #00a3ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }
  .company-info-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 15px;
    text-align: justify;
  }
  .company-info-image-container {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  .company-info-image-container img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }
  .company-info-image-container:hover img {
    transform: scale(1.05);
  }
  
  @media screen and (max-width: 900px) {
    .company-info-container {
      grid-template-columns: 1fr;
    }
    .company-info-text .gradient-heading {
      font-size: 2rem;
    }
  }
{%- endstyle -%}

<div class="about-us-wrapper" style="position: relative;">
  
  <!-- Hero Section -->
  {%- assign hero_bg_url = blank -%}
  {%- if section.settings.hero_bg_image != blank -%}
    {%- assign hero_bg_url = section.settings.hero_bg_image | image_url: width: 2000 -%}
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'hero_background' and block.settings.image != blank -%}
      {%- assign hero_bg_url = block.settings.image | image_url: width: 2000 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if hero_bg_url != blank -%}
    <section class="about-hero page-header page-header_align_center" style="background-image: linear-gradient(rgba(26,26,26,0.65), rgba(51,51,51,0.65)), url('{{ hero_bg_url }}'); background-size: cover; background-repeat: no-repeat; background-attachment: scroll; background-position: center center; background-color: #1a1a1a; min-height: 500px; padding-top: 80px; padding-bottom: 80px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
  {%- else -%}
    <section class="about-hero page-header page-header_align_center" style="background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%); min-height: 500px; padding-top: 80px; padding-bottom: 80px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
  {%- endif -%}
  
    <!-- Moving Colorful Marquee Background (CSS Animation) -->
    <div class="moving-text">About Us &nbsp; &nbsp; &nbsp; &nbsp; About Us &nbsp; &nbsp; &nbsp; &nbsp; About Us &nbsp; &nbsp; &nbsp; &nbsp; About Us &nbsp; &nbsp; &nbsp; &nbsp; About Us</div>

    <div class="page-header_wrapper" style="width: 100%; text-align: center; position: relative; z-index: 2;">
      <h1 class="page-header_title" style="color: #ffffff; font-size: clamp(40px, 6vw, 60px); font-weight: 800; line-height: 1.2; margin-bottom: 15px;">About Vidhyut Saathi</h1>
      <div class="page-header_breadcrumbs" style="color: #ffffff; font-size: 16px; font-weight: 500;">
        <div class="breadcrumbs">
          <a href="/" class="home" style="color: var(--about-primary); text-decoration: none; transition: color 0.3s;">Home</a> 
          <span class="divider" style="margin: 0 10px; color: rgba(255,255,255,0.5);">/</span> 
          <span class="current">About Us</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About Company Section -->
  <section class="company-info-section">
    <div class="company-info-container">
      
      <!-- Text Side -->
      <div class="company-info-text">
        <h2 class="gradient-heading">About Vidhyut Saathi</h2>
        <p><b>Vidhyut Saathi Energy Savers Pvt Ltd</b> is a leading Indian startup working in energy saver cards. People these days are proactive in saving electric energy as electricity is also a basic source that we need to survive. Vidyut Saathi is one of the innovative products of this generation to lower your electricity bills.</p>
        <p>This card is designed on a unique US - German Nano-technology which is completely eco-friendly, certified and tested. It is made up of 20,000 negative ions which stops the leakage of electricity as a result it protects the ozone layer. It reduces 20% to 30% of your electricity bills just by application. There are no technical modifications required. Moreover, the usage of this card is 100% legal and we too are certified to distribute this technology.</p>
        <p>Without any maintenance cost, it is performing well at domestic as well as commercial platforms. In short, energy saving is now totally eco friendly, pocket friendly and most importantly ozone layer friendly.</p>
      </div>

      <!-- Image Side -->
      <div class="company-info-image">
        <div class="company-info-image-container tilt-element">
          {%- if section.settings.company_info_image != blank -%}
            {{ section.settings.company_info_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {%- else -%}
            <div style="background: #e0e0e0; width: 100%; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; color: #666; text-align: center; padding: 20px;">
              <p>Please upload an image in the Theme Editor<br>(Right Side About Image)</p>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "About Us Layout",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_bg_image",
      "label": "Hero 3D Background Image",
      "info": "Upload a 3D background image. It will have a parallax scroll effect."
    },
    {
      "type": "image_picker",
      "id": "company_info_image",
      "label": "Right Side About Image",
      "info": "Upload the image for the right side of the About Company section."
    }
  ],
  "blocks": [
    {
      "type": "hero_background",
      "name": "Top Header Photo (Hero)",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Top Header Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Layout"
    }
  ]
}
{% endschema %}
