<script>
  document.addEventListener('DOMContentLoaded', function() {
    // =========================================================================
    // SECTION 8: INTERACTIVE MOUSE SPOTLIGHT AURA
    // =========================================================================
    const sectionEl = document.getElementById('vswHowWeWork');
    const spotlightEl = document.getElementById('vswSpotlight');
    if (sectionEl && spotlightEl) {
      sectionEl.addEventListener('mousemove', function(e) {
        const rect = sectionEl.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        spotlightEl.style.left = x + 'px';
        spotlightEl.style.top = y + 'px';
      });
    }
    // =========================================================================
    // SECTION 8: HOW WE WORK STEPPER TABS HANDLER
    // =========================================================================
    const stepData = [
      {
        badge: "STEP 01 / 05 • ANALYSIS PHASE",
        stageTag: "⚡ LOAD AUDIT",
        title: "Analysis",
        desc: "We review and document your company’s needs, electrical load, and energy-saving requirements to determine optimal card capacity.",
        bullets: ["⚡ Electrical Load Audit", "📊 Energy-Saving Calculation", "🎯 Custom Capacity Plan"],
        svg: `<svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="256" cy="256" r="210" fill="url(#bulbGlowBg)" opacity="0.25"/><path d="M256 40C160 40 80 120 80 216C80 270 106 318 146 348C166 364 182 392 182 418V432C182 450 196 464 214 464H298C316 464 330 450 330 432V418C330 392 346 364 366 348C406 318 432 270 432 216C432 120 352 40 256 40Z" fill="url(#bulbGradMain)"/><path d="M256 464H214C196 464 182 478 182 496C182 505 189 512 198 512H314C323 512 330 505 330 496C330 478 316 464 298 464H256Z" fill="#D97706"/><circle cx="256" cy="216" r="75" fill="#FEF08A" opacity="0.9"/><path d="M256 90V130M256 302V342M130 216H90M422 216H382M167 127L139 99M373 333L345 305M167 305L139 333M373 99L345 127" stroke="#F59E0B" stroke-width="18" stroke-linecap="round"/><defs><radialGradient id="bulbGlowBg" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="transparent"/></radialGradient><linearGradient id="bulbGradMain" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#FBBF24"/><stop offset="100%" stop-color="#F59E0B"/></linearGradient></defs></svg>`
      },
      {
        badge: "STEP 02 / 05 • DOCUMENTATION PHASE",
        stageTag: "📜 GOVT COMPLIANCE",
        title: "Documentation",
        desc: "We determine the appropriate technology solutions, card sizing, and project methodologies that meet your company’s specific goals.",
        bullets: ["📜 ISO 9001:2015 Standards", "📋 Customized Sizing Spec", "🔒 Tech Solution Blueprint"],
        svg: `<svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="96" y="40" width="320" height="432" rx="28" fill="url(#docGradBg)" stroke="#2563EB" stroke-width="10"/><rect x="144" y="110" width="224" height="24" rx="12" fill="#3B82F6"/><rect x="144" y="170" width="224" height="18" rx="9" fill="#93C5FD"/><rect x="144" y="215" width="180" height="18" rx="9" fill="#93C5FD"/><rect x="144" y="260" width="140" height="18" rx="9" fill="#93C5FD"/><circle cx="340" cy="360" r="55" fill="url(#sealGradBg)"/><path d="M320 360L335 375L365 345" stroke="#FFFFFF" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="docGradBg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#FFFFFF"/><stop offset="100%" stop-color="#EFF6FF"/></linearGradient><linearGradient id="sealGradBg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#1D4ED8"/></linearGradient></defs></svg>`
      },
      {
        badge: "STEP 03 / 05 • CONFIRMATION PHASE",
        stageTag: "✅ POWER FLOW LOCKED",
        title: "Confirmation",
        desc: "Our technical team verifies power flow architecture, confirms compliance, and finalizes your energy saver order setup.",
        bullets: ["✅ Grid Architecture Verified", "⚙️ Compliance Double-Check", "🔒 Order Setup Finalized"],
        svg: `<svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="256" cy="256" r="200" fill="url(#shieldGlow)" opacity="0.2"/><path d="M256 48L400 112V240C400 340 338 424 256 464C174 424 112 340 112 240V112L256 48Z" fill="url(#shieldGrad)" stroke="#16A34A" stroke-width="12"/><path d="M200 256L240 296L312 208" stroke="#FFFFFF" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"/><defs><radialGradient id="shieldGlow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#22C55E"/><stop offset="100%" stop-color="transparent"/></radialGradient><linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4ADE80"/><stop offset="100%" stop-color="#16A34A"/></linearGradient></defs></svg>`
      },
      {
        badge: "STEP 04 / 05 • DISPATCHED PHASE",
        stageTag: "🚀 EXPRESS DISPATCH",
        title: "Dispatched",
        desc: "We utilize automated and quality testing frameworks to ensure high-quality, genuine Vidhyut Saathi cards are dispatched safely.",
        bullets: ["📦 Quality-Tested Batch", "🛡️ Tamper-Proof Packaging", "📍 Express GPS Tracked Delivery"],
        svg: `<svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M48 160H352V360H48V160Z" fill="url(#truckBodyGrad)" rx="20"/><path d="M352 210H432L472 270V360H352V210Z" fill="url(#truckCabGrad)" rx="10"/><circle cx="120" cy="380" r="42" fill="#1E293B" stroke="#F59E0B" stroke-width="8"/><circle cx="120" cy="380" r="18" fill="#FFFFFF"/><circle cx="390" cy="380" r="42" fill="#1E293B" stroke="#F59E0B" stroke-width="8"/><circle cx="390" cy="380" r="18" fill="#FFFFFF"/><path d="M120 230L200 230M80 270L240 270" stroke="#FBBF24" stroke-width="14" stroke-linecap="round"/><defs><linearGradient id="truckBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#D97706"/></linearGradient><linearGradient id="truckCabGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#1D4ED8"/></linearGradient></defs></svg>`
      },
      {
        badge: "STEP 05 / 05 • EARNING & SAVINGS PHASE",
        stageTag: "💰 20%-30% RETURN",
        title: "Earning",
        desc: "Enjoy immediate 20%-30% reduction on monthly power bills, long-term appliance protection, and franchise earning potential.",
        bullets: ["💰 20%-30% Monthly Bill Drop", "🛡️ Full Appliance Protection", "📈 Franchise Growth Returns"],
        svg: `<svg viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M96 280C96 180 168 100 256 100C344 100 416 180 416 280V410H96V280Z" fill="url(#chestGrad)" stroke="#B45309" stroke-width="10"/><rect x="76" y="240" width="360" height="45" rx="14" fill="#F59E0B"/><circle cx="256" cy="340" r="32" fill="#FEF08A" stroke="#B45309" stroke-width="6"/><path d="M256 40V100M180 60L210 110M332 60L302 110" stroke="#F59E0B" stroke-width="14" stroke-linecap="round"/><defs><linearGradient id="chestGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#FBBF24"/><stop offset="100%" stop-color="#D97706"/></linearGradient></defs></svg>`
      }
    ];

    const stepButtons = document.querySelectorAll('.vsw-step-item');
    const progressBar = document.getElementById('vswStepperProgress');
    const stepBadge = document.getElementById('vswStepBadge');
    const stepTitle = document.getElementById('vswStepTitle');
    const stepDesc = document.getElementById('vswStepDesc');
    const stepBullets = document.getElementById('vswStepBullets');
    const stageTag = document.getElementById('vswStageTag');
    const stepGraphic = document.getElementById('vswStepGraphic');
    const stepCard = document.getElementById('vswStepCard');

    let currentHwwStep = 0;
    let hwwInterval = null;

    function activateHwwStep(index) {
      currentHwwStep = index;
      stepButtons.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      const stepperNav = document.getElementById('vswStepperNav');
      if (stepperNav && window.innerWidth <= 768) {
        const activeBtn = stepButtons[index];
        if (activeBtn) {
          const navWidth = stepperNav.clientWidth;
          const btnLeft = activeBtn.offsetLeft;
          const btnWidth = activeBtn.clientWidth;
          const targetScroll = btnLeft - (navWidth / 2) + (btnWidth / 2);
          stepperNav.scrollTo({
            left: targetScroll,
            behavior: 'smooth'
          });
        }
      }

      let progressPct = (index / (stepData.length - 1)) * 100;
      if (index > 0 && index < stepData.length - 1) {
        progressPct += 4;
      }
      if (progressBar) progressBar.style.width = Math.min(100, progressPct) + '%';

      if (stepCard) {
        stepCard.style.opacity = '0.4';
        stepCard.style.transform = 'translateY(12px)';
      }

      setTimeout(() => {
        if (stepBadge) stepBadge.textContent = stepData[index].badge;
        if (stepTitle) stepTitle.textContent = stepData[index].title;
        if (stepDesc) stepDesc.textContent = stepData[index].desc;
        if (stageTag) stageTag.textContent = stepData[index].stageTag;
        if (stepGraphic) stepGraphic.innerHTML = stepData[index].svg;

        if (stepBullets && stepData[index].bullets) {
          stepBullets.innerHTML = stepData[index].bullets
            .map(b => {
              const parts = b.trim().split(' ');
              const icon = parts[0];
              const text = parts.slice(1).join(' ');
              return `<div class="vsw-bullet-item">
                        <span class="vsw-bullet-icon">${icon}</span>
                        <span class="vsw-bullet-text">${text}</span>
                      </div>`;
            })
            .join('');
        }

        if (stepCard) {
          stepCard.style.opacity = '1';
          stepCard.style.transform = 'translateY(0)';
        }
      }, 180);
    }

    function startHwwAutoTimer() {
      if (hwwInterval) clearInterval(hwwInterval);
      hwwInterval = setInterval(() => {
        const nextStep = (currentHwwStep + 1) % stepData.length;
        activateHwwStep(nextStep);
      }, 4500);
    }

    function resetHwwAutoTimer() {
      if (hwwInterval) clearInterval(hwwInterval);
      startHwwAutoTimer();
    }

    stepButtons.forEach((btn, index) => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        activateHwwStep(index);
        resetHwwAutoTimer();
      });
    });

    function stopHwwAutoTimer() {
      if (hwwInterval) clearInterval(hwwInterval);
    }

    const hwwSection = document.getElementById('vswHowWeWork');
    if ('IntersectionObserver' in window && hwwSection) {
      const hwwObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            activateHwwStep(currentHwwStep);
            startHwwAutoTimer();
          } else {
            stopHwwAutoTimer();
          }
        });
      }, {
        threshold: 0.15
      });
      hwwObserver.observe(hwwSection);
    } else {
      if (stepButtons.length > 0) {
        activateHwwStep(0);
        startHwwAutoTimer();
      }
    }
    const cardStage = document.getElementById('card5dStage');
    const cardGlare = document.getElementById('card5dGlare');

    if (cardStage) {
      cardStage.addEventListener('mousemove', function(e) {
        const rect = cardStage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -22;
        const rotateY = ((x - centerX) / centerX) * 22;

        cardStage.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.06, 1.06, 1.06)`;
        
        if (cardGlare) {
          cardGlare.style.opacity = '1';
          const glareX = (x / rect.width) * 100;
          const glareY = (y / rect.height) * 100;
          cardGlare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0) 70%)`;
        }
      });

      cardStage.addEventListener('mouseleave', function() {
        cardStage.style.transform = '';
        cardStage.style.transition = 'transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        if (cardGlare) {
          cardGlare.style.opacity = '0';
        }
      });

      cardStage.addEventListener('mouseenter', function() {
        cardStage.style.transition = 'transform 0.1s ease-out';
      });
    }

    // =========================================================================
    // Mobile-Only Viewport-Triggered Auto Sliders (Starts from Card 1 on Scroll)
    // For Section 3, Section 5, Section 6, and Section 7
    // =========================================================================
    function createMobileSlider(containerSelector, cardSelector, dotSelector) {
      const container = document.querySelector(containerSelector);
      const cards = document.querySelectorAll(cardSelector);
      const dots = document.querySelectorAll(dotSelector);
      if (!container || cards.length === 0) return;

      const parentSection = container.closest('section') || container;

      let currentIndex = 0;
      let autoInterval = null;
      let isVisibleInViewport = false;

      function isMobile() {
        return window.innerWidth <= 768;
      }

      function goToSlide(index, smooth = true) {
        if (!isMobile()) return;
        currentIndex = (index + cards.length) % cards.length;
        const slideWidth = container.clientWidth;
        container.scrollTo({
          left: slideWidth * currentIndex,
          behavior: smooth ? 'smooth' : 'auto'
        });
        updateDots(currentIndex);
      }

      function updateDots(index) {
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function startAutoSlide() {
        stopAutoSlide();
        if (isMobile() && isVisibleInViewport) {
          autoInterval = setInterval(function() {
            goToSlide(currentIndex + 1);
          }, 3000); // Auto rotate every 3 seconds
        }
      }

      function stopAutoSlide() {
        if (autoInterval) {
          clearInterval(autoInterval);
          autoInterval = null;
        }
      }

      // IntersectionObserver: Trigger 3s timer ONLY when section scrolls into mobile viewport
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              isVisibleInViewport = true;
              if (isMobile()) {
                goToSlide(0, false); // Always start from Card 1 when user reaches section
                startAutoSlide();
              }
            } else {
              isVisibleInViewport = false;
              stopAutoSlide(); // Pause when scrolled off-screen
            }
          });
        }, {
          threshold: 0.2
        });

        observer.observe(parentSection);
      } else {
        isVisibleInViewport = true;
        if (isMobile()) startAutoSlide();
      }

      dots.forEach((dot, index) => {
        dot.addEventListener('click', function() {
          goToSlide(index);
          startAutoSlide();
        });
      });

      container.addEventListener('touchstart', stopAutoSlide, { passive: true });
      container.addEventListener('touchend', function() {
        if (isVisibleInViewport) {
          setTimeout(startAutoSlide, 2000);
        }
      }, { passive: true });

      container.addEventListener('scroll', function() {
        if (!isMobile()) return;
        const slideWidth = container.clientWidth;
        if (slideWidth > 0) {
          const newIndex = Math.round(container.scrollLeft / slideWidth);
          if (newIndex !== currentIndex && newIndex >= 0 && newIndex < cards.length) {
            currentIndex = newIndex;
            updateDots(currentIndex);
          }
        }
      });

      window.addEventListener('resize', function() {
        if (isMobile()) {
          if (isVisibleInViewport) startAutoSlide();
        } else {
          stopAutoSlide();
        }
      });
    }

    createMobileSlider('.mv-container', '.mv-card', '.mv-dot');
    createMobileSlider('.services-container', '.service-card', '.services-dot');
    createMobileSlider('.trust-grid', '.trust-card', '.trust-dot');
    createMobileSlider('.team-grid', '.team-card', '.team-dot');
  });
</script>

