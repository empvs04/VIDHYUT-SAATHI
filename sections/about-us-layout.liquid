  .vsw-benefits-mesh-section {
    position: relative;
    padding: 100px 24px;
    background: linear-gradient(180deg, #FAFAF7 0%, #FFFDF8 50%, #FAF6EE 100%);
    color: #1A1A1A;
    overflow: hidden;
  }

  /* Animated Wave Lines Canvas Background */
  .vsw-wave-mesh-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.65;
  }

  .vsw-wave-line-svg {
    position: absolute;
    width: 200%;
    height: 100%;
    top: 0;
    left: -50%;
    animation: waveMeshFlow 16s linear infinite;
  }

  .vsw-wave-line-svg-2 {
    animation: waveMeshFlow 24s linear infinite reverse;
    opacity: 0.55;
  }

  @keyframes waveMeshFlow {
    0% { transform: translateX(0) scaleY(1); }
    50% { transform: translateX(-12%) scaleY(1.15); }
    100% { transform: translateX(0) scaleY(1); }
  }

  .vsw-benefits-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Left Content Block */
  .vsw-benefits-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vsw-benefits-badge {
    display: inline-flex;
