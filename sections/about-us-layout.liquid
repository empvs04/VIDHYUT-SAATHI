{%- style -%}
  /* --- Base Variables & Reset --- */
  :root {
    --about-primary: #ec5c0a;
    --about-secondary: #007b3e;
    --about-bg: #fff8ef;
    --about-text-dark: #1a1a1a;
    --about-text-light: #555555;
    --about-radius: 20px;
    --about-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  
  .about-us-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--about-text-dark);
    background-color: var(--about-bg);
    overflow: hidden;
  }

  /* --- Premium 3D & Reveal Utilities --- */
  .reveal-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .tilt-element {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    will-change: transform;
    /* Added subtle shadow to enhance 3D pop */
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  }
  
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  /* --- Hero Section --- */
  .about-hero {
    position: relative;
    padding: 100px 20px;
    text-align: center;
    background: linear-gradient(135deg, #fff8ef 0%, #ffe6d5 100%);
    overflow: hidden;
  }
  
  .about-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 60%;
    height: 150%;
    background: radial-gradient(circle, rgba(236,92,10,0.1) 0%, rgba(255,255,255,0) 70%);
    transform: rotate(30deg);
  }

  .about-hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .about-hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    color: var(--about-text-dark);
  }

  .about-hero-title span {
    color: var(--about-primary);
  }

  .about-hero-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--about-text-light);
    margin-bottom: 30px;
  }

  .about-hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .about-tag {
    background: white;
    color: var(--about-primary);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(236,92,10,0.15);
  }

  /* --- What We Do Section --- */
  .about-what-we-do {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-grid-content h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .about-grid-content p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--about-text-light);
    margin-bottom: 20px;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  
  .stat-box {
    background: white;
    padding: 30px 20px;
    border-radius: var(--about-radius);
    text-align: center;
    box-shadow: var(--about-shadow);
    border-bottom: 4px solid var(--about-primary);
    transition: transform 0.3s ease;
  }

  .stat-box:hover {
    transform: translateY(-5px);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--about-primary);
    margin-bottom: 10px;
  }
  
  .stat-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--about-text-dark);
  }

  /* --- Vision & Mission --- */
  .about-vision-mission {
    background: #ffffff;
    padding: 80px 20px;
  }
  
  .vm-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  
  .vm-card {
    background: var(--about-bg);
    padding: 50px 40px;
    border-radius: var(--about-radius);
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .vm-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: var(--about-primary);
  }
  
  .vm-card:nth-child(2)::before {
    background: var(--about-secondary);
  }
  
  .vm-icon {
    font-size: 3rem;
    margin-bottom: 20px;
    color: var(--about-primary);
  }
  
  .vm-card:nth-child(2) .vm-icon {
    color: var(--about-secondary);
  }

  .vm-card h3 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 20px;
  }
  
  .vm-card p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--about-text-light);
  }

  /* --- Who We Are --- */
  .about-who {
    padding: 100px 20px;
    text-align: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
    color: white;
  }
  
  .about-who-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .about-who h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 24px;
    color: white;
  }
  
  .about-who p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: #e0e0e0;
    margin-bottom: 20px;
  }

  .about-who-highlight {
    display: block;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--about-primary);
    margin-top: 30px;
    font-style: italic;
  }

  /* --- Responsive --- */
  @media screen and (max-width: 900px) {
    .about-hero-title { font-size: 2.5rem; }
    .about-grid, .vm-container { grid-template-columns: 1fr; }
    .about-grid-content { text-align: center; }
    .vm-card { padding: 40px 20px; }
  }
  @media screen and (max-width: 600px) {
    .about-hero-title { font-size: 2rem; }
    .about-hero-text { font-size: 1rem; }
    .stat-box { padding: 20px 10px; }
    .stat-value { font-size: 2rem; }
  }
{%- endstyle -%}

<div class="about-us-wrapper">
  
  <!-- Hero Section -->
  <section class="about-hero" style="background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);">
    <div class="page-header_wrapper"><div class="tpc-container"><div class="page-header_content"><div class="header__shape_1"></div>
    <marquee class="large-heading hidden-xs" direction="left" scrollamount="12" loop="infinite" style="font-size: 100px; font-weight: 800; color: rgba(255,255,255,0.05); position: absolute; top: 20%; left: 0; width: 100%; z-index: 1;">About Us</marquee>
    <div style="position: relative; z-index: 2;">
      <h1 class="page-header_title" style="color: #ffffff; font-size: 60px; line-height: 72px;">About Vidhyut Saathi</h1>
      <div class="page-header_breadcrumbs" style="color: #ffffff; font-size: 16px; line-height: 27px;"><div class="breadcrumbs"><a href="/" class="home" style="color: var(--about-primary); text-decoration: none;">Home</a> <span class="divider">/</span> <span class="current">About Us</span></div><!-- .breadcrumbs --></div>
    </div>
    </div></div></div>
  </section>

  <!-- What We Do -->
  <section class="about-what-we-do reveal-up">
    <div class="about-grid">
      <div class="about-grid-content">
        <h2 style="background: -webkit-linear-gradient(45deg, #ec5c0a, #ff9e5e); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">What We Do</h2>
        <p>At Vidhyut Saathi, we transform everyday electricity consumption into an opportunity for savings and growth. We help homes, shops, commercial establishments, and industries unlock the power of smarter energy utilization.</p>
        <p>But our impact doesn't stop there. We are creating a nationwide ecosystem where consumers can reduce expenses, and aspiring entrepreneurs can build profitable district-level ventures through our exclusive franchise network.</p>
        <p style="font-weight: 600; color: var(--about-primary); margin-top: 15px;">
          Less Wastage. More Savings. Greater Opportunities.
        </p>
      </div>
      <div class="about-stats">
        <div class="stat-box tilt-element">
          <div class="stat-value">20-30%</div>
          <div class="stat-label">Monthly Bill Savings</div>
        </div>
        <div class="stat-box tilt-element">
          <div class="stat-value">#1</div>
          <div class="stat-label">Energy Saver Card</div>
        </div>
        <div class="stat-box tilt-element" style="grid-column: span 2;">
          <div class="stat-value" style="font-size: 2rem;">Pan-India</div>
          <div class="stat-label">Exclusive Franchise Network</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="about-vision-mission">
    <div class="vm-container reveal-up">
      <div class="vm-card glass-card tilt-element">
        <div class="vm-icon">👁️</div>
        <h3 style="background: -webkit-linear-gradient(45deg, #007b3e, #00b359); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Our Vision</h3>
        <p>To create a future where every Indian family pays less for electricity, every entrepreneur has the opportunity to build wealth, and every unit of energy is used wisely for the benefit of our nation and future generations.</p>
        <p>We envision a future where advanced technology is accessible to every citizen, making smarter power consumption a standard that protects the environment and reduces economic strain on every family.</p>
      </div>
      <div class="vm-card glass-card tilt-element">
        <div class="vm-icon">🎯</div>
        <h3 style="background: -webkit-linear-gradient(45deg, #ec5c0a, #ff9e5e); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Our Mission</h3>
        <p>To help millions of Indians reduce their electricity expenses through innovative technology while creating life-changing business opportunities through our exclusive district franchise network.</p>
        <p>By saving electricity, creating entrepreneurs, generating employment, and promoting environmental awareness, we are committed to building a stronger, greener, and more self-reliant India.</p>
        <p style="font-weight: 600; margin-top: 10px;">Creating a legacy of savings, success, and sustainability for generations to come.</p>
      </div>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="about-who reveal-up">
    <div class="about-who-content tilt-element" style="background: rgba(0,0,0,0.5); padding: 40px; border-radius: 20px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
      <h2 style="background: -webkit-linear-gradient(45deg, #ffffff, #aaaaaa); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Who We Are</h2>
      <p>We are believers in a simple idea: <strong>when electricity is saved, everyone wins.</strong></p>
      <p>At Vidhyut Saathi, we don't measure success by products sold—we measure it by electricity saved, money retained by families, businesses created by entrepreneurs, and the positive difference we make in people's lives.</p>
      
      <span class="about-who-highlight">Empowering You. Powering India.</span>
    </div>
  </section>

  <!-- Dynamic Image Gallery -->
  {%- if section.blocks.size > 0 -%}
  <section style="padding: 80px 20px; max-width: 1200px; margin: 0 auto;" class="reveal-up">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' and block.settings.image != blank -%}
          <div class="tilt-element" style="border-radius: var(--about-radius); overflow: hidden; box-shadow: var(--about-shadow); border: 2px solid #fff;" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 800 | image_tag: style: 'width: 100%; height: 100%; object-fit: cover; display: block;', loading: 'lazy' }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  /* --- Reveal Animations on Scroll --- */
  const revealElements = document.querySelectorAll('.reveal-up');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  
  revealElements.forEach(el => revealObserver.observe(el));

  /* --- 3D Hover Tilt Effect --- */
  const tiltElements = document.querySelectorAll('.tilt-element');
  
  tiltElements.forEach(el => {
    el.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      // Calculate rotation (max 12 degrees)
      const rotateX = ((y - centerY) / centerY) * -12; 
      const rotateY = ((x - centerX) / centerX) * 12;
      
      // Apply 3D transform with slight scale up
      el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.03, 1.03, 1.03)`;
    });
    
    el.addEventListener('mouseleave', () => {
      // Snap back to 0 rotation with smooth transition
      el.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      el.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1)';
    });
    
    el.addEventListener('mouseenter', () => {
      // Fast transition when entering
      el.style.transition = 'transform 0.1s linear';
    });
  });
});
</script>

