    .card-float-badge-bottom { bottom: -12px; right: 0; font-size: 0.7rem; padding: 6px 12px; }
  }
  
  /* --- Upgraded Section 3: Mission, Vision & What We Do Grid --- */
  .mission-vision-section {
    padding: 70px 20px;
    background: radial-gradient(circle at top right, rgba(236,92,10,0.06) 0%, rgba(255,255,255,1) 50%, rgba(0,123,62,0.06) 100%);
    position: relative;
  }
  .mv-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: stretch; /* All 3 cards stretch to exact same height */
  }
  .mv-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    padding: 42px 34px;
    border-radius: 28px;
    box-shadow: 0 18px 45px rgba(0,0,0,0.04);
    border: 1px solid rgba(236,92,10,0.18);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    z-index: 1;
  }
  .mv-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 5px;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00, #007b3e);
    z-index: 2;
  }
  .mv-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 28px 60px rgba(236,92,10,0.14), 0 0 25px rgba(0,123,62,0.1);
    border-color: rgba(236,92,10,0.4);
  }
  .mv-icon {
    font-size: 2.2rem;
    margin-bottom: 20px;
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(236,92,10,0.12), rgba(0,123,62,0.12));
    border: 1px solid rgba(236,92,10,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px rgba(236,92,10,0.08);
    flex-shrink: 0;
  }
  .mv-card h2 {
    font-size: 1.7rem;
    font-weight: 900;
    margin-bottom: 14px;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mv-card p {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #555555;
    margin-bottom: 24px;
    flex-grow: 1;
  }
  .mv-badge {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.08), rgba(0, 123, 62, 0.08));
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 50px;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ec5c0a;
    width: fit-content;
  }
  @media screen and (max-width: 900px) {
    .mv-container {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .mv-card {
      padding: 32px 24px;
    }
  }

  /* --- Masterpiece Section: Who We Are Showcase --- */
  .who-we-are-section {
    padding: 75px 20px;
    background: radial-gradient(circle at 20% 50%, rgba(236,92,10,0.06) 0%, #ffffff 40%, rgba(0,123,62,0.06) 100%);
    position: relative;
    overflow: hidden;
  }
  .wwa-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: stretch; /* Left & Right Containers match exact equal height line */
  }
  
  /* Left Media Container */
  .wwa-image {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wwa-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 460px;
    max-height: 520px;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 123, 62, 0.16), 0 0 0 2px rgba(255, 204, 0, 0.4);
    border: 1px solid rgba(0, 123, 62, 0.3);
    background: #0f172a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wwa-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    border-radius: 28px;
  }
  .wwa-image-wrapper:hover img {
    transform: scale(1.06);
  }
  
  /* Left Overlay Glass Badges */
  .wwa-img-badge {
    position: absolute;
    padding: 8px 16px;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .wwa-img-badge-top {
    top: 18px;
    left: 18px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.95), rgba(15, 23, 42, 0.95));
  }
  .wwa-img-badge-bottom {
    bottom: 18px;
    right: 18px;
    background: linear-gradient(135deg, rgba(0, 123, 62, 0.95), rgba(15, 23, 42, 0.95));
  }

  /* Right Content Container */
  .wwa-content {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 123, 62, 0.2);
    border-radius: 28px;
    padding: 38px 34px;
    box-shadow: 0 20px 50px rgba(0, 123, 62, 0.07);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .wwa-subtitle {
