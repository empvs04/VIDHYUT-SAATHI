{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  /* --- Base Variables & Reset --- */
  :root {
    --about-primary: #ec5c0a;
    --about-secondary: #007b3e;
    --about-bg: #fffbf5;
    --about-text-dark: #1a1a1a;
    --about-text-light: #555555;
    --about-radius: 24px;
    --about-shadow: 0 15px 45px rgba(236, 92, 10, 0.08);
  }
  
  .about-us-wrapper {
    font-family: 'Outfit', 'Plus Jakarta Sans', 'Poppins', sans-serif;
    color: var(--about-text-dark);
    background-color: var(--about-bg);
    overflow: hidden;
  }

  /* --- Premium 3D & Reveal Utilities --- */
  .reveal-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .tilt-element {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    will-change: transform;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
  }
  
  /* --- Responsive --- */
  @media screen and (max-width: 900px) {
    .page-header_title { font-size: 3rem !important; }
  }
  @media screen and (max-width: 600px) {
    .page-header_title { font-size: 2.2rem !important; }
  }
  
  /* --- Marquee CSS Animation --- */
  @keyframes scroll-right {
    0% { transform: translateX(-100%) translateY(-50%); }
    100% { transform: translateX(100%) translateY(-50%); }
  }
  .moving-text {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: max-content;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.8;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(80px, 12vw, 150px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-fill-color: transparent;
    animation: scroll-right 25s linear infinite;
  }
  
  /* ==========================================================================
     Section 2: 5D Ultra-Futuristic Card Showcase & Responsive Container
     ========================================================================== */
  .company-info-section {
    padding: 70px 20px;
    background: radial-gradient(circle at 80% 20%, rgba(236, 92, 10, 0.08) 0%, rgba(255, 255, 255, 1) 45%, rgba(0, 123, 62, 0.08) 100%);
    position: relative;
  }

  .company-info-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: stretch; /* Both containers match exact same height line */
  }

  /* Left Text Container - Equal Height */
  .company-info-text {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 30px;
    padding: 38px 34px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.07);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .company-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.12), rgba(0, 123, 62, 0.12));
    border: 1px solid rgba(236, 92, 10, 0.3);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #ec5c0a;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
    width: fit-content;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.1);
  }

  .company-badge .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ec5c0a;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(236, 92, 10, 0.7);
    animation: pulse-ring 1.8s infinite;
  }

  .company-info-text .gradient-heading {
    font-size: clamp(26px, 2.9vw, 38px);
    font-weight: 900;
    line-height: 1.22;
    margin-bottom: 16px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    animation: color-shift 4s linear infinite;
  }

  .company-info-text p {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #444;
    margin-bottom: 16px;
  }

  .company-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 18px 0 24px 0;
  }

  .company-feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #ffffff;
    border: 1px solid rgba(236, 92, 10, 0.15);
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  .company-feature-item:hover {
    transform: translateY(-3px);
    border-color: #ec5c0a;
    box-shadow: 0 10px 22px rgba(236, 92, 10, 0.15);
  }

  .company-feature-icon {
    font-size: 1.3rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.15), rgba(0, 123, 62, 0.15));
    flex-shrink: 0;
  }

  .company-feature-text h4 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 2px 0;
  }

  .company-feature-text p {
    font-size: 0.78rem;
    color: #666;
    margin: 0 !important;
    line-height: 1.3 !important;
  }

  .company-cta-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: auto;
  }

  .company-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 30px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff !important;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .company-btn-primary:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.5);
    background: linear-gradient(135deg, #f1721b, #007b3e);
  }

  .company-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 26px;
    background: #ffffff;
    color: #007b3e !important;
    border: 2px solid #007b3e;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 8px 20px rgba(0, 123, 62, 0.1);
    transition: all 0.3s ease;
  }

  .company-btn-secondary:hover {
    background: #007b3e;
    color: #ffffff !important;
    transform: translateY(-3px);
    box-shadow: 0 12px 25px rgba(0, 123, 62, 0.25);
  }

  /* Right 5D Holographic Card Stage Container - Matching Left Height */
  .company-info-image {
    perspective: 1200px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    border: 1px solid rgba(255, 204, 0, 0.4);
    border-radius: 28px;
    padding: 28px 18px;
    box-shadow: 0 25px 60px rgba(10, 14, 26, 0.4), inset 0 0 30px rgba(0, 200, 255, 0.1);
  }

  /* Layer 1: Ambient 5D Pulsating Energy Ring Background */
  .company-info-image::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.4) 0%, rgba(0, 200, 255, 0.25) 45%, rgba(0, 0, 0, 0) 75%);
    filter: blur(45px);
    pointer-events: none;
    animation: energyPulse5D 4s ease-in-out infinite alternate;
  }

  @keyframes energyPulse5D {
    0% { transform: translate(-50%, -50%) scale(0.85); opacity: 0.6; }
    100% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  }

  /* Layer 2: 5D Card Floating Stage (Sleek Compact 450px Width) */
  .card-5d-stage {
    position: relative;
    width: 100%;
    max-width: 450px;
    margin: 0 auto;
    border-radius: 22px;
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out;
    will-change: transform;
    cursor: pointer;
    animation: floatCard5D 6s ease-in-out infinite alternate;
  }

  @keyframes floatCard5D {
    0% { transform: perspective(1000px) translateY(0px) rotateX(4deg) rotateY(-3deg); }
    50% { transform: perspective(1000px) translateY(-10px) rotateX(-2deg) rotateY(3deg); }
    100% { transform: perspective(1000px) translateY(-5px) rotateX(3deg) rotateY(-4deg); }
  }

  .card-5d-stage:hover {
    animation-play-state: paused;
  }

  /* Layer 3: Metallic Chamfered 3D Card Shell */
  .card-5d-wrapper {
    position: relative;
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7), 0 0 45px rgba(236, 92, 10, 0.35), 0 0 0 2px rgba(255, 204, 0, 0.5);
    transform-style: preserve-3d;
    transition: box-shadow 0.4s ease;
  }

  .card-5d-stage:hover .card-5d-wrapper {
    box-shadow: 0 45px 95px rgba(0, 0, 0, 0.85), 0 0 75px rgba(0, 200, 255, 0.5), 0 0 0 3px rgba(255, 204, 0, 0.9);
  }

  .card-5d-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 24px;
    transform: translateZ(15px);
    transition: transform 0.4s ease;
    object-fit: cover;
  }

  /* Layer 4: Interactive Holographic Glare & Foil Reflection */
  .card-5d-glare {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 24px;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    mix-blend-mode: overlay;
    transform: translateZ(35px);
  }

  /* Layer 5: Floating 3D Holographic Badges popping in Z-Space */
  .card-float-badge {
    position: absolute;
    padding: 8px 16px;
    background: rgba(9, 14, 26, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    z-index: 20;
    pointer-events: none;
    transform: translateZ(65px);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .card-float-badge-top {
    top: -16px;
    left: -12px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.95), rgba(9, 14, 26, 0.95));
  }

  .card-float-badge-bottom {
    bottom: -16px;
    right: -12px;
    background: linear-gradient(135deg, rgba(0, 123, 62, 0.95), rgba(9, 14, 26, 0.95));
  }

  .card-float-badge span.highlight {
    color: #ffcc00;
  }

  /* Tablet & Mobile Responsive Alignment */
  @media screen and (max-width: 900px) {
    .company-info-section { padding: 35px 16px; }
    .company-info-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .company-info-text { padding: 28px 20px; }
    .company-info-image { padding: 35px 20px; }
    .company-feature-grid { grid-template-columns: 1fr; }
    .card-float-badge-top { top: -12px; left: 0; font-size: 0.7rem; padding: 6px 12px; }
    .card-float-badge-bottom { bottom: -12px; right: 0; font-size: 0.7rem; padding: 6px 12px; }
  }

  @keyframes floatCard5D {
    0% { transform: perspective(1000px) translateY(0px) rotateX(4deg) rotateY(-3deg); }
    50% { transform: perspective(1000px) translateY(-10px) rotateX(-2deg) rotateY(3deg); }
    100% { transform: perspective(1000px) translateY(-5px) rotateX(3deg) rotateY(-4deg); }
  }

  .card-5d-stage:hover {
    animation-play-state: paused;
  }

