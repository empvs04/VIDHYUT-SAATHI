{%- style -%}
  /* --- Base Variables & Reset --- */
  :root {
    --about-primary: #ec5c0a;
    --about-secondary: #007b3e;
    --about-bg: #fff8ef;
    --about-text-dark: #1a1a1a;
    --about-text-light: #555555;
    --about-radius: 20px;
    --about-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  
  .about-us-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--about-text-dark);
    background-color: var(--about-bg);
    overflow: hidden;
  }

  /* --- Hero Section --- */
  .about-hero {
    position: relative;
    padding: 100px 20px;
    text-align: center;
    background: linear-gradient(135deg, #fff8ef 0%, #ffe6d5 100%);
    overflow: hidden;
  }
  
  .about-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 60%;
    height: 150%;
    background: radial-gradient(circle, rgba(236,92,10,0.1) 0%, rgba(255,255,255,0) 70%);
    transform: rotate(30deg);
  }

  .about-hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  @keyframes slideRight {
    0% { transform: translateX(-150%); }
    100% { transform: translateX(150%); }
  }

  .about-hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    color: var(--about-text-dark);
    white-space: nowrap;
    display: inline-block;
    animation: slideRight 15s linear infinite;
  }

  .about-hero-title span {
    color: var(--about-primary);
  }

  .about-hero-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--about-text-light);
    margin-bottom: 30px;
  }

  .about-hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .about-tag {
    background: white;
    color: var(--about-primary);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(236,92,10,0.15);
  }

  /* --- What We Do Section --- */
  .about-what-we-do {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-grid-content h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .about-grid-content p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--about-text-light);
    margin-bottom: 20px;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  
  .stat-box {
    background: white;
    padding: 30px 20px;
    border-radius: var(--about-radius);
    text-align: center;
    box-shadow: var(--about-shadow);
    border-bottom: 4px solid var(--about-primary);
    transition: transform 0.3s ease;
  }

  .stat-box:hover {
    transform: translateY(-5px);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--about-primary);
    margin-bottom: 10px;
  }
  
  .stat-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--about-text-dark);
  }

  /* --- Vision & Mission --- */
  .about-vision-mission {
    background: #ffffff;
    padding: 80px 20px;
  }
  
  .vm-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  
  .vm-card {
    background: var(--about-bg);
    padding: 50px 40px;
    border-radius: var(--about-radius);
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .vm-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: var(--about-primary);
  }
  
  .vm-card:nth-child(2)::before {
    background: var(--about-secondary);
  }
  
  .vm-icon {
    font-size: 3rem;
    margin-bottom: 20px;
    color: var(--about-primary);
  }
  
  .vm-card:nth-child(2) .vm-icon {
    color: var(--about-secondary);
  }

  .vm-card h3 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 20px;
  }
  
  .vm-card p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--about-text-light);
  }

  /* --- Who We Are --- */
  .about-who {
    padding: 100px 20px;
    text-align: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
    color: white;
  }
  
  .about-who-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .about-who h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 24px;
    color: white;
  }
  
  .about-who p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: #e0e0e0;
    margin-bottom: 20px;
  }

  .about-who-highlight {
    display: block;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--about-primary);
    margin-top: 30px;
    font-style: italic;
  }

  /* --- Responsive --- */
  @media screen and (max-width: 900px) {
    .about-hero-title { font-size: 2.5rem; }
    .about-grid, .vm-container { grid-template-columns: 1fr; }
    .about-grid-content { text-align: center; }
    .vm-card { padding: 40px 20px; }
  }
  @media screen and (max-width: 600px) {
    .about-hero-title { font-size: 2rem; }
    .about-hero-text { font-size: 1rem; }
    .stat-box { padding: 20px 10px; }
    .stat-value { font-size: 2rem; }
  }
{%- endstyle -%}

<div class="about-us-wrapper">
  
  <!-- Hero Section -->
  <section class="about-hero">
    <div class="about-hero-content">
      <h1 class="about-hero-title">Empowering India towards a <span>Greener & Stronger</span> Future</h1>
      <p class="about-hero-text">
        Vidhyut Saathi Energy Savers Pvt. Ltd. is more than a company—it is a mission to empower every Indian family to save money, every entrepreneur to build wealth, and every citizen to contribute towards a sustainable nation. Through our revolutionary Vidhyut Saathi Card, powered by Advanced US-German Nano Technology, we help homes and businesses save 20–30% on electricity bills.
      </p>
      <p class="about-hero-text">
        In a time of rising costs and environmental challenges, the money saved can be redirected towards your family's dreams and business growth.
      </p>
      
      <div class="about-hero-tags">
        <span class="about-tag">Save Electricity</span>
        <span class="about-tag">Save Money</span>
        <span class="about-tag">Protect Nature</span>
        <span class="about-tag">Empower India</span>
        <span class="about-tag">Build Your Future</span>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="about-what-we-do">
    <div class="about-grid">
      <div class="about-grid-content">
        <h2>What We Do</h2>
        <p>At Vidhyut Saathi, we transform everyday electricity consumption into an opportunity for savings and growth. We help homes, shops, commercial establishments, and industries unlock the power of smarter energy utilization.</p>
        <p>But our impact doesn't stop there. We are creating a nationwide ecosystem where consumers can reduce expenses, and aspiring entrepreneurs can build profitable district-level ventures through our exclusive franchise network.</p>
        <p style="font-weight: 600; color: var(--about-primary); margin-top: 15px;">
          Less Wastage. More Savings. Greater Opportunities.
        </p>
      </div>
      <div class="about-stats">
        <div class="stat-box">
          <div class="stat-value">20-30%</div>
          <div class="stat-label">Monthly Bill Savings</div>
        </div>
        <div class="stat-box">
          <div class="stat-value">#1</div>
          <div class="stat-label">Energy Saver Card</div>
        </div>
        <div class="stat-box" style="grid-column: span 2;">
          <div class="stat-value" style="font-size: 2rem;">Pan-India</div>
          <div class="stat-label">Exclusive Franchise Network</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="about-vision-mission">
    <div class="vm-container">
      <div class="vm-card">
        <div class="vm-icon">👁️</div>
        <h3>Our Vision</h3>
        <p>To create a future where every Indian family pays less for electricity, every entrepreneur has the opportunity to build wealth, and every unit of energy is used wisely for the benefit of our nation and future generations.</p>
        <p>We envision a future where advanced technology is accessible to every citizen, making smarter power consumption a standard that protects the environment and reduces economic strain on every family.</p>
      </div>
      <div class="vm-card">
        <div class="vm-icon">🎯</div>
        <h3>Our Mission</h3>
        <p>To help millions of Indians reduce their electricity expenses through innovative technology while creating life-changing business opportunities through our exclusive district franchise network.</p>
        <p>By saving electricity, creating entrepreneurs, generating employment, and promoting environmental awareness, we are committed to building a stronger, greener, and more self-reliant India.</p>
        <p style="font-weight: 600; margin-top: 10px;">Creating a legacy of savings, success, and sustainability for generations to come.</p>
      </div>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="about-who">
    <div class="about-who-content">
      <h2>Who We Are</h2>
      <p>We are believers in a simple idea: <strong>when electricity is saved, everyone wins.</strong></p>
      <p>At Vidhyut Saathi, we don't measure success by products sold—we measure it by electricity saved, money retained by families, businesses created by entrepreneurs, and the positive difference we make in people's lives.</p>
      
      <span class="about-who-highlight">Empowering You. Powering India.</span>
    </div>
  </section>

</div>

