  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cardStage = document.getElementById('card5dStage');
    const cardGlare = document.getElementById('card5dGlare');

    if (cardStage) {
      cardStage.addEventListener('mousemove', function(e) {
        const rect = cardStage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -22;
        const rotateY = ((x - centerX) / centerX) * 22;

        cardStage.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.06, 1.06, 1.06)`;
        
        if (cardGlare) {
          cardGlare.style.opacity = '1';
          const glareX = (x / rect.width) * 100;
          const glareY = (y / rect.height) * 100;
          cardGlare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0) 70%)`;
        }
      });

      cardStage.addEventListener('mouseleave', function() {
        cardStage.style.transform = '';
        cardStage.style.transition = 'transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        if (cardGlare) {
          cardGlare.style.opacity = '0';
        }
      });

      cardStage.addEventListener('mouseenter', function() {
        cardStage.style.transition = 'transform 0.1s ease-out';
      });
    }
  });
</script>

