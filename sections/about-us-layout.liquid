    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 50%, #007B3E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .vsw-benefits-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #475569;
    margin-bottom: 35px;
    max-width: 500px;
  }

  .vsw-benefits-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 34px;
    border-radius: 50px;
    background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%);
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.35s ease;
  }

  .vsw-benefits-cta-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 15px 40px rgba(236, 92, 10, 0.55);
    color: #FFFFFF;
  }

  /* Right Staggered Grid (Matching Screenshot Offset Cards) */
  .vsw-benefits-right-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .vsw-benefits-col-1 {
    display: flex;
    flex-direction: column;
    gap: 24px;
    transform: translateY(30px);
  }

  .vsw-benefits-col-2 {
    display: flex;
    flex-direction: column;
    gap: 24px;
    transform: translateY(-30px);
  }

  .vsw-mesh-card {
    background: linear-gradient(145deg, #FFFFFF 0%, #FFFCF8 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(236, 92, 10, 0.18);
    border-top: 4px solid #EC5C0A;
    border-radius: 20px;
    padding: 32px 24px;
    color: #1E293B;
    box-shadow: 0 15px 40px rgba(236, 92, 10, 0.09), 0 4px 15px rgba(0, 0, 0, 0.03);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }

  .vsw-mesh-card:hover {
    transform: translateY(-8px) scale(1.02);
    background: #FFFFFF;
    box-shadow: 0 25px 55px rgba(236, 92, 10, 0.2);
    border-color: #EC5C0A;
  }

  .vsw-mesh-icon-wrap {
