{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  /* --- Base Variables & Reset --- */
  :root {
    --about-primary: #ec5c0a;
    --about-secondary: #007b3e;
    --about-bg: #fffbf5;
    --about-text-dark: #1a1a1a;
    --about-text-light: #555555;
    --about-radius: 24px;
    --about-shadow: 0 15px 45px rgba(236, 92, 10, 0.08);
  }
  
  .about-us-wrapper {
    font-family: 'Outfit', 'Plus Jakarta Sans', 'Poppins', sans-serif;
    color: var(--about-text-dark);
    background-color: var(--about-bg);
    overflow: hidden;
  }

  /* --- Premium 3D & Reveal Utilities --- */
  .reveal-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .tilt-element {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    will-change: transform;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
  }
  
  /* --- Hero Showcase Section --- */
  .about-hero {
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-position: center 25% !important;
    background-color: #090e1a;
    min-height: 520px;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
    image-rendering: -webkit-optimize-contrast;
    -webkit-backface-visibility: hidden;
  }
  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 10px 26px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  
  /* --- Left to Right Moving Marquee Text --- */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .moving-text {
    position: absolute;
    top: 65px !important;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.45;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(38px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 16s linear infinite;
  }

  /* --- Responsive --- */
  @media screen and (max-width: 900px) {
    .page-header_title { font-size: 3rem !important; }
  }
  @media screen and (max-width: 768px) {
    .about-hero {
      min-height: 240px !important;
      height: auto !important;
      background-size: cover !important;
      background-position: center 15% !important;
      padding: 12px 10px !important;
    }
    .moving-text {
      top: 38px !important;
      font-size: 30px !important;
      opacity: 0.70 !important; /* Darker & bolder visibility on mobile */
      filter: drop-shadow(0px 2px 8px rgba(0,0,0,0.6));
    }
    .hero-breadcrumb-pill {
      padding: 6px 16px !important;
      font-size: 0.75rem !important;
      gap: 6px !important;
      margin-bottom: 4px !important;
    }
    .hero-breadcrumb-pill span,
    .hero-breadcrumb-pill a {
      font-size: 0.75rem !important;
    }
  }
  @media screen and (max-width: 600px) {
    .page-header_title { font-size: 2.2rem !important; }
  }
  
  /* --- Marquee CSS Animation --- */
  @keyframes scroll-right {
    0% { transform: translateX(-100%) translateY(-50%); }
    100% { transform: translateX(100%) translateY(-50%); }
  }
  .moving-text {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: max-content;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.8;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(80px, 12vw, 150px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-fill-color: transparent;
    animation: scroll-right 25s linear infinite;
  }
  
  /* ==========================================================================
     Section 2: 5D Ultra-Futuristic Card Showcase & Responsive Container
     ========================================================================== */
  .company-info-section {
    padding: 45px 20px;
    background: radial-gradient(circle at 80% 20%, rgba(236, 92, 10, 0.08) 0%, rgba(255, 255, 255, 1) 45%, rgba(0, 123, 62, 0.08) 100%);
    position: relative;
  }

  .company-info-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: stretch !important; /* Equal height containers on desktop */
  }

  /* Left Text Container - Equal Height */
  .company-info-text {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 30px;
    padding: 38px 34px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.07);
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    box-sizing: border-box;
  }

  .company-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.12), rgba(0, 123, 62, 0.12));
    border: 1px solid rgba(236, 92, 10, 0.3);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    color: #ec5c0a;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
    width: fit-content;
    white-space: nowrap !important;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.1);
  }

  .company-badge .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ec5c0a;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(236, 92, 10, 0.7);
    animation: pulse-ring 1.8s infinite;
  }

  @media screen and (max-width: 768px) {
    .company-badge {
      white-space: nowrap !important;
      font-size: clamp(0.65rem, 2.7vw, 0.8rem) !important;
      padding: 6px 12px !important;
      gap: 6px !important;
      max-width: 100% !important;
    }
  }

  /* Clean Fluid Heading Typography for Desktop & Mobile - Orange & Green Brand Theme */
  .sec2-heading-custom {
    font-size: clamp(22px, 2.3vw, 34px);
    font-weight: 600 !important;
    line-height: 1.35;
    margin-bottom: 18px;
    letter-spacing: -0.3px;
    display: block;
    text-align: left;
  }

  /* Base & Desktop Brand Color Styling */
  .sec2-line-orange1 {
    color: #ec5c0a !important;
    font-weight: 600 !important;
    display: inline;
  }

  .sec2-line-green {
    color: #007b3e !important;
    font-weight: 600 !important;
    display: inline;
  }

  .sec2-line-orange2 {
    color: #ec5c0a !important;
    font-weight: 600 !important;
    display: inline;
  }

  /* Mobile Specific Alignment: Line 1 = "Empowering India", Line 2 = "With Green Energy & Power Savings", Line 3 = "Across Nation" */
  @media screen and (max-width: 768px) {
    h2.sec2-heading-custom,
    .company-info-text h2.sec2-heading-custom {
      font-size: 1.35rem !important;
      line-height: 1.35 !important;
      margin-bottom: 16px !important;
      text-align: center !important;
      display: block !important;
    }

    .sec2-line-orange1 {
      display: block !important;
      color: #ec5c0a !important;
      font-weight: 700 !important;
      font-size: clamp(1.3rem, 5.2vw, 1.55rem) !important;
      text-align: center !important;
      margin-bottom: 3px !important;
    }

    .sec2-line-green {
      display: block !important;
      color: #007b3e !important;
      font-weight: 700 !important;
      font-size: clamp(1.15rem, 4.4vw, 1.35rem) !important;
      text-align: center !important;
      margin-bottom: 3px !important;
    }

    .sec2-line-orange2 {
      display: block !important;
      color: #ec5c0a !important;
      font-weight: 700 !important;
      font-size: clamp(1.15rem, 4.4vw, 1.35rem) !important;
      text-align: center !important;
    }

    /* Equal Height & Width Metric Cards on Mobile */
    .wwa-metrics-row {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 6px !important;
      align-items: stretch !important;
      width: 100% !important;
    }

    .wwa-metric-box {
      width: 100% !important;
      height: 100% !important;
      min-height: 84px !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      padding: 10px 2px !important;
      box-sizing: border-box !important;
      text-align: center !important;
    }

    .wwa-metric-box h4 {
      font-size: clamp(0.88rem, 3.4vw, 1.05rem) !important;
      white-space: nowrap !important;
      margin: 0 0 2px 0 !important;
      line-height: 1.1 !important;
    }

    .wwa-metric-box p {
      font-size: clamp(0.58rem, 2.3vw, 0.7rem) !important;
      line-height: 1.2 !important;
      margin: 0 !important;
      white-space: nowrap !important;
      text-align: center !important;
      letter-spacing: -0.2px !important;
    }

    /* Section 6 Trust Title Mobile Formatting */
    h2.trust-title,
    .trust-header h2.trust-title {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      gap: 3px !important;
      margin-bottom: 14px !important;
    }

    .trust-line1 {
      display: block !important;
      font-size: 0.92rem !important;
      font-weight: 800 !important;
      color: #475569 !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }

    .trust-line2 {
      display: block !important;
      font-size: clamp(1.45rem, 5.8vw, 1.85rem) !important;
      font-weight: 900 !important;
      background: linear-gradient(135deg, #ec5c0a 0%, #ff9a00 40%, #007b3e 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      letter-spacing: -0.3px !important;
      padding: 2px 0 !important;
    }

    .trust-line3 {
      display: block !important;
      font-size: clamp(1.15rem, 4.5vw, 1.35rem) !important;
      font-weight: 800 !important;
      color: #0f172a !important;
    }
  }

  .company-info-text .gradient-heading {
    font-size: clamp(26px, 2.9vw, 38px);
    font-weight: 900;
    line-height: 1.22;
    margin-bottom: 16px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    animation: color-shift 4s linear infinite;
  }

  .company-info-text p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: #334155;
    text-align: justify;
    text-justify: inter-word;
    margin-bottom: 14px;
  }
  .company-info-text p:last-of-type {
    margin-bottom: 0;
  }

  .company-bottom-banner {
    max-width: 1280px;
    margin: 32px auto 0 auto;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 30px;
    padding: 30px 34px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.07);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .company-tagline-pill {
    padding: 10px 24px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.08), rgba(0, 123, 62, 0.08));
    border: 1px solid rgba(236, 92, 10, 0.25);
    border-radius: 50px;
    font-weight: 800;
    font-size: 0.88rem;
    color: #ec5c0a;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    text-align: center;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.08);
  }

  .company-feature-grid-banner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    width: 100%;
  }

  .company-cta-group-center {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
  }

  .company-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 18px 0 24px 0;
  }

  .company-feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #ffffff;
    border: 1px solid rgba(236, 92, 10, 0.15);
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
  }

  .company-feature-item:hover {
    transform: translateY(-3px);
    border-color: #ec5c0a;
    box-shadow: 0 10px 22px rgba(236, 92, 10, 0.15);
  }

  .company-feature-icon {
    font-size: 1.3rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.15), rgba(0, 123, 62, 0.15));
    flex-shrink: 0;
  }

  .company-feature-text h4 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 2px 0;
  }

  .company-feature-text p {
    font-size: 0.78rem;
    color: #666;
    margin: 0 !important;
    line-height: 1.3 !important;
  }

  .company-cta-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: auto;
  }

  .company-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 30px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff !important;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .company-btn-primary:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.5);
    background: linear-gradient(135deg, #f1721b, #007b3e);
  }

  .company-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 26px;
    background: #ffffff;
    color: #007b3e !important;
    border: 2px solid #007b3e;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 8px 20px rgba(0, 123, 62, 0.1);
    transition: all 0.3s ease;
  }

  .company-btn-secondary:hover {
    background: #007b3e;
    color: #ffffff !important;
    transform: translateY(-3px);
    box-shadow: 0 12px 25px rgba(0, 123, 62, 0.25);
  }

  /* Right Card Container - Exact Matching White Glassmorphic Card Container as Left Text Div */
  .company-info-image {
    perspective: 1200px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 30px;
    padding: 24px 20px;
    box-shadow: 0 20px 50px rgba(236, 92, 10, 0.07);
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Layer 1: Background Glow Hidden */
  .company-info-image::before {
    display: none !important;
  }

  /* Layer 2: 5D Card Floating Stage (Nested Inside Matching Right Container) */
  .card-5d-stage {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    border-radius: 18px;
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out;
    will-change: transform;
    cursor: pointer;
    animation: floatCard5D 6s ease-in-out infinite alternate;
  }

  @keyframes floatCard5D {
    0% { transform: perspective(1000px) translateY(0px) rotateX(2deg) rotateY(-2deg); }
    50% { transform: perspective(1000px) translateY(-6px) rotateX(-2deg) rotateY(2deg); }
    100% { transform: perspective(1000px) translateY(-3px) rotateX(2deg) rotateY(-2deg); }
  }

  .card-5d-stage:hover {
    animation-play-state: paused;
  }

  /* Layer 3: Clean Metallic 3D Card Shell */
  .card-5d-wrapper {
    position: relative;
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: transparent !important;
    box-shadow: 0 14px 35px rgba(236, 92, 10, 0.22), 0 4px 15px rgba(0, 0, 0, 0.08);
    transform-style: preserve-3d;
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }

  .card-5d-stage:hover .card-5d-wrapper {
    box-shadow: 0 22px 50px rgba(236, 92, 10, 0.35), 0 6px 20px rgba(0, 123, 62, 0.18);
  }

  .card-5d-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
    transform: translateZ(15px);
    transition: transform 0.4s ease;
    object-fit: contain;
  }

  /* Layer 4: Interactive Holographic Glare & Foil Reflection */
  .card-5d-glare {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 24px;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    mix-blend-mode: overlay;
    transform: translateZ(35px);
  }

  /* Layer 5: Floating 3D Holographic Badges popping in Z-Space */
  .card-float-badge {
    position: absolute;
    padding: 8px 16px;
    background: rgba(9, 14, 26, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    z-index: 20;
    pointer-events: none;
    transform: translateZ(65px);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .card-float-badge-top {
    top: -16px;
    left: -12px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.95), rgba(9, 14, 26, 0.95));
  }

  .card-float-badge-bottom {
    bottom: -16px;
    right: -12px;
    background: linear-gradient(135deg, rgba(0, 123, 62, 0.95), rgba(9, 14, 26, 0.95));
  }

  .card-float-badge span.highlight {
    color: #ffcc00;
  }

  /* Tablet & Mobile Responsive Alignment */
  @media screen and (max-width: 900px) {
    .company-info-section { padding: 30px 14px; }
    .company-info-container {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .company-info-text {
      padding: 24px 18px;
      text-align: center;
      align-items: center;
    }
    .company-info-image {
      padding: 24px 14px;
      border-radius: 22px;
      width: 100%;
      box-sizing: border-box;
      overflow: visible;
    }
    .card-5d-stage {
      max-width: 100%;
      margin: 0 auto;
    }
    .company-bottom-banner {
      margin-top: 20px;
      padding: 20px 16px;
      border-radius: 22px;
      width: 100%;
      box-sizing: border-box;
    }
    .company-tagline-pill {
      font-size: 0.76rem;
      padding: 8px 12px;
      gap: 4px;
      line-height: 1.45;
      text-align: center;
      justify-content: center;
    }
    .company-feature-grid-banner {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .card-float-badge-top {
      top: -12px;
      left: 0;
      font-size: 0.68rem;
      padding: 5px 10px;
    }
    .card-float-badge-bottom {
      bottom: -12px;
      right: 0;
      font-size: 0.68rem;
      padding: 5px 10px;
    }
    
    /* Center Section 2 Buttons on Mobile */
    .company-cta-group,
    .company-cta-group-center {
      justify-content: center !important;
      width: 100% !important;
      gap: 12px !important;
      margin: 14px auto 0 auto !important;
      flex-direction: column !important;
    }
    .company-btn-primary,
    .company-btn-secondary {
      width: 100% !important;
      max-width: 100% !important;
      padding: 14px 20px !important;
      justify-content: center !important;
      text-align: center !important;
      box-sizing: border-box !important;
      margin: 0 auto !important;
    }
  }

  @media screen and (max-width: 550px) {
    .company-feature-grid-banner {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .company-feature-item {
