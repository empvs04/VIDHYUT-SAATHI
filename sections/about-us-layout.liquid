{%- style -%}
  /* --- Base Variables & Reset --- */
  :root {
    --about-primary: #ec5c0a;
    --about-secondary: #007b3e;
    --about-bg: #fff8ef;
    --about-text-dark: #1a1a1a;
    --about-text-light: #555555;
    --about-radius: 20px;
    --about-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  
  .about-us-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--about-text-dark);
    background-color: var(--about-bg);
    overflow: hidden;
  }

  /* --- Premium 3D & Reveal Utilities --- */
  .reveal-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .tilt-element {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    will-change: transform;
    /* Added subtle shadow to enhance 3D pop */
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  }
  
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
  
  /* --- Responsive --- */
  @media screen and (max-width: 900px) {
    .page-header_title { font-size: 3rem !important; }
  }
  @media screen and (max-width: 600px) {
    .page-header_title { font-size: 2.2rem !important; }
  }
  
  /* --- Marquee CSS Animation --- */
  @keyframes scroll-right {
    0% { transform: translateX(-100%) translateY(-50%); }
    100% { transform: translateX(100%) translateY(-50%); }
  }
  .moving-text {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: max-content;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.8;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(80px, 12vw, 150px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-fill-color: transparent;
    animation: scroll-right 25s linear infinite;
  }
  
  /* --- Company Info Section --- */
  .company-info-section {
    padding: 80px 20px;
    background-color: #f9f9f9;
  }
  .company-info-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  /* --- Animated Text Gradient --- */
  @keyframes color-shift {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }
  .company-info-text .gradient-heading {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    animation: color-shift 4s linear infinite;
  }
  .company-info-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 15px;
    text-align: justify;
  }
  .company-info-image-container {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  .company-info-image-container img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }
  .company-info-image-container:hover img {
    transform: scale(1.05);
  }
  
  @media screen and (max-width: 900px) {
    .company-info-container {
      grid-template-columns: 1fr;
    }
    .company-info-text .gradient-heading {
      font-size: 2rem;
    }
    .mv-container {
      grid-template-columns: 1fr;
    }
  }
  
  /* --- Mission Vision Section --- */
  .mission-vision-section {
    padding: 100px 20px;
    background: radial-gradient(circle at top right, rgba(236,92,10,0.05) 0%, rgba(255,255,255,1) 40%, rgba(0,123,62,0.05) 100%);
    position: relative;
  }
  .mv-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .mv-card {
    background: linear-gradient(145deg, #ffffff, #fdfdfd);
    padding: 50px 40px;
    border-radius: 24px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.06);
    border: 1px solid rgba(236,92,10,0.1);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  
  .mv-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    z-index: 2;
  }

  .mv-card:hover {
    transform: translateY(-15px);
    box-shadow: 0 25px 50px rgba(0,123,62,0.12);
    border-color: rgba(0,123,62,0.3);
  }

  .mv-icon {
    font-size: 3rem;
    margin-bottom: 25px;
    background: linear-gradient(135deg, #ec5c0a, #007b3e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .mv-card h2 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 20px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .mv-card p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
    text-align: justify;
  }

  /* --- Who We Are Section --- */
  .who-we-are-section {
    padding: 100px 20px;
    background: #ffffff;
  }
  .wwa-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .wwa-image-wrapper {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 50px rgba(0,0,0,0.1);
  }
  .wwa-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }
  .wwa-image-wrapper:hover img {
    transform: scale(1.05);
  }
  .wwa-image-wrapper:hover img {
    transform: scale(1.05);
  }
  .wwa-subtitle {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 15px;
    display: inline-block;
    padding: 6px 16px;
    background: rgba(0,123,62,0.1);
    border-radius: 30px;
    color: #007b3e;
  }
  .wwa-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 25px;
    color: #1a1a1a;
  }
  .wwa-title span {
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .wwa-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 30px;
  }
  .wwa-bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    border-top: 1px solid #eee;
    padding-top: 30px;
  }
  .wwa-ceo {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .wwa-ceo img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #007b3e;
  }
  .wwa-ceo-info h4 {
    margin: 0 0 5px 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #1a1a1a;
  }
  .wwa-ceo-info span {
    font-size: 0.9rem;
    color: #ec5c0a;
    font-weight: 600;
    display: block;
  }
  .wwa-features {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wwa-features li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    color: #333;
  }
  .wwa-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    color: white;
    background: linear-gradient(135deg, #ec5c0a, #007b3e);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
  }

  /* --- Services 3-Column Light Section --- */
  .services-section {
    padding: 100px 20px;
    background: #f9f9f9;
    color: #1a1a1a;
    position: relative;
    overflow: hidden;
  }
  .services-section::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%; right: -50%; bottom: -50%;
    background: radial-gradient(circle, rgba(0,123,62,0.05) 0%, transparent 60%);
    pointer-events: none;
  }
  .services-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    position: relative;
    z-index: 2;
  }
  .service-card {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 60px 40px;
    border-radius: 30px;
    text-align: center;
    position: relative;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  .service-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 30px;
    box-shadow: inset 0 0 0 2px transparent;
    transition: all 0.5s ease;
    pointer-events: none;
  }
  
  .service-card:hover {
    transform: translateY(-15px);
    background: #ffffff;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }
  .service-card:nth-child(1):hover::after { box-shadow: inset 0 0 0 2px rgba(236,92,10,0.5); }
  .service-card:nth-child(2):hover::after { box-shadow: inset 0 0 0 2px rgba(0,123,62,0.5); }
  .service-card:nth-child(3):hover::after { box-shadow: inset 0 0 0 2px rgba(0,163,255,0.5); }
  
  .service-icon-wrapper {
    width: 120px;
    height: 120px;
    margin: 0 auto 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    position: relative;
    background: linear-gradient(135deg, rgba(236,92,10,0.1), rgba(0,123,62,0.1));
    border: 1px solid rgba(0,0,0,0.05);
  }
  .service-icon-wrapper img {
    width: 60%;
    height: auto;
    object-fit: contain;
  }
  
  .service-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: #1a1a1a;
    letter-spacing: 1px;
  }
  .service-card p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #555;
  }

  @media screen and (max-width: 900px) {
    .wwa-container { grid-template-columns: 1fr; }
    .wwa-bottom-row { grid-template-columns: 1fr; }
    .services-container { grid-template-columns: 1fr; }
  }

  /* --- Section 6: Trust & Live Achievements Showcase (Brand Color Match) --- */
  .trust-achievements-section {
    width: 100%;
    box-sizing: border-box;
    padding: 100px 20px;
    background: linear-gradient(180deg, #fefae0 0%, #fff8ef 50%, #ffffff 100%);
    color: #1a1a1a;
    position: relative;
    overflow: hidden;
    z-index: 1;
    clear: both;
  }
  .trust-achievements-section::before {
    content: '';
    position: absolute;
    top: -20%; left: -10%; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(236,92,10,0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }
  .trust-achievements-section::after {
    content: '';
    position: absolute;
    bottom: -20%; right: -10%; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(0,123,62,0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .trust-achievements-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
  }

  /* Badge & Section Header */
  .trust-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 900px;
    margin: 0 auto 60px auto;
  }
  .trust-top-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(236, 92, 10, 0.08);
    border: 1px solid rgba(236, 92, 10, 0.3);
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 0.92rem;
    font-weight: 700;
    color: #d94e00;
    letter-spacing: 0.5px;
    margin: 0 auto 25px auto;
    box-shadow: 0 4px 15px rgba(236, 92, 10, 0.1);
    text-align: center;
  }
  .trust-top-badge .pulse-dot {
    width: 10px;
    height: 10px;
    background-color: #007b3e;
    border-radius: 50%;
    box-shadow: 0 0 10px #007b3e;
    animation: blink-dot 1.5s infinite;
  }
  @keyframes blink-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .trust-title {
    font-size: clamp(32px, 5vw, 50px);
    font-weight: 900;
    line-height: 1.25;
    margin-bottom: 20px;
    color: #1a1a1a;
    letter-spacing: -0.5px;
  }
  .trust-title .highlight-gradient {
    background: linear-gradient(90deg, #ec5c0a, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: color-shift 4s linear infinite;
  }
  .trust-subtitle {
    font-size: 1.15rem;
    color: #4a5568;
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* 4-Card Grid */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
    margin-bottom: 50px;
  }

  .trust-card {
    background: #ffffff;
    border: 1px solid rgba(236, 92, 10, 0.15);
    border-radius: 24px;
    padding: 40px 28px;
    text-align: center;
    position: relative;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  .trust-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 5px;
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    transition: all 0.3s ease;
  }
  .trust-card:hover {
    transform: translateY(-12px);
    border-color: rgba(0, 123, 62, 0.4);
    box-shadow: 0 20px 40px rgba(0, 123, 62, 0.12), 0 0 25px rgba(236, 92, 10, 0.08);
  }

  .trust-icon-box {
    width: 70px;
    height: 70px;
    margin: 0 auto 22px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(236,92,10,0.1), rgba(0,123,62,0.1));
    border: 1px solid rgba(236,92,10,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    box-shadow: 0 6px 15px rgba(0,0,0,0.04);
  }
  .trust-number {
    font-size: clamp(2.2rem, 3vw, 2.8rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 10px;
    color: #1a1a1a;
    font-family: 'Poppins', sans-serif;
  }
  .trust-number span {
    color: #ec5c0a;
  }
  .trust-card-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1a1a1a;
    margin-bottom: 12px;
  }
  .trust-card-desc {
    font-size: 0.95rem;
    color: #555555;
    line-height: 1.6;
  }

  /* Live Customer Growing Ticker Bar */
  .trust-live-bar {
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.08), rgba(0, 123, 62, 0.08));
    border: 1px solid rgba(0, 123, 62, 0.2);
    border-radius: 20px;
    padding: 20px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.03);
  }
  .trust-live-info {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .trust-live-badge {
    background: #007b3e;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 6px 16px;
    border-radius: 30px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 4px 12px rgba(0, 123, 62, 0.25);
  }
  .trust-live-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: #2d3748;
  }
  .trust-live-text span {
    color: #ec5c0a;
    font-weight: 800;
  }
  .trust-features-pills {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .trust-pill {
    background: #ffffff;
    border: 1px solid rgba(236, 92, 10, 0.2);
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }

  @media screen and (max-width: 1024px) {
    .trust-grid { grid-template-columns: repeat(2, 1fr); }
  }
  /* --- Section 7: Our Awesome Team Showcase --- */
  .our-team-section {
    width: 100%;
    box-sizing: border-box;
    padding: 100px 20px;
    background: linear-gradient(180deg, #ffffff 0%, #fef8f3 50%, #fff4ea 100%);
    position: relative;
    overflow: hidden;
    z-index: 1;
    clear: both;
  }
  .our-team-section::before {
    content: '';
    position: absolute;
    top: 10%; right: -5%; width: 450px; height: 450px;
    background: radial-gradient(circle, rgba(236,92,10,0.1) 0%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
  }

  .our-team-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .our-team-header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 60px auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .our-team-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(0, 123, 62, 0.08);
    border: 1px solid rgba(0, 123, 62, 0.25);
    padding: 8px 22px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #007b3e;
    letter-spacing: 1px;
    margin-bottom: 20px;
    box-shadow: 0 4px 12px rgba(0, 123, 62, 0.08);
  }
  .our-team-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 18px;
    color: #1a1a1a;
  }
  .our-team-title span {
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .our-team-subtitle {
    font-size: 1.1rem;
    color: #555555;
    line-height: 1.7;
  }

  /* Team Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .team-card {
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(0,0,0,0.06);
    border: 1px solid rgba(236, 92, 10, 0.12);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  .team-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 50px rgba(236, 92, 10, 0.15);
    border-color: rgba(236, 92, 10, 0.4);
  }

  .team-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1.1;
    overflow: hidden;
    background: linear-gradient(135deg, #fceade, #e8f5e9);
  }
  .team-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .team-card:hover .team-img-wrapper img {
    transform: scale(1.08);
  }

  .team-role-tag {
    position: absolute;
    bottom: 15px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(236, 92, 10, 0.25);
    padding: 6px 18px;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ec5c0a;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    white-space: nowrap;
  }

  .team-info {
