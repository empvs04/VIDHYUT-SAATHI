  .vsw-mesh-icon-amber { background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%); color: #FFFFFF; }

  .vsw-mesh-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0F172A;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .vsw-mesh-card-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748B;
  }

  /* MOBILE RESPONSIVE (NEAT 2x2 COMPACT GRID WITH VISIBLE WAVE MESH) */
