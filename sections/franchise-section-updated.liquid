  overflow: hidden;
  position: relative;
  color: #111;
  box-sizing: border-box;
}
.vs-section-{{ section.id }} * {
  box-sizing: border-box;
}
.vs-section-{{ section.id }}:before {
  content: "";
  position: absolute;
  top: -120px;
  right: -120px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,170,0,.14), transparent 70%);
  filter: blur(10px);
}
.vs-section-{{ section.id }} .container {
  max-width: 1180px;
  margin: auto;
  position: relative;
  z-index: 2;
}

/* HEADER */
.vs-section-{{ section.id }} .heading {
  text-align: center;
  margin-bottom: 44px;
  position: relative;
}
.vs-section-{{ section.id }} .heading h1 {
  margin: 0;
  text-transform: uppercase;
  line-height: .96;
  position: relative;
}
.vs-section-{{ section.id }} .heading .top,
.vs-section-{{ section.id }} .heading .bottom {
  display: block;
  font-weight: 900;
  white-space: nowrap;
  background: linear-gradient(90deg, #ff9200, #ffbc00, #d5a100);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 10px 18px rgba(255,170,0,.18));
  animation: floatText 4s ease-in-out infinite;
}
.vs-section-{{ section.id }} .heading .top {
  font-size: 12.5vw;
  letter-spacing: -1.5px;
}
.vs-section-{{ section.id }} .heading .bottom {
  font-size: 10.2vw;
  margin-top: 4px;
  letter-spacing: -1px;
  animation-delay: .3s;
}

@media (min-width: 769px) {
  .vs-section-{{ section.id }} .heading .top {
    font-size: 52px !important;
    letter-spacing: -1px !important;
  }
  .vs-section-{{ section.id }} .heading .bottom {
    font-size: 44px !important;
    letter-spacing: -0.8px !important;
  }
  .vs-section-{{ section.id }} .heading p {
    font-size: 18px !important;
    max-width: 750px !important;
    margin: 16px auto 0 !important;
  }
}
.vs-section-{{ section.id }} .heading h1:after {
  content: "";
  position: absolute;
  left: -30%;
  top: 0;
  width: 28%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent);
  transform: skewX(-20deg);
  animation: shine 5s linear infinite;
}
.vs-section-{{ section.id }} .heading-glow {
  width: 150px;
  height: 6px;
  border-radius: 999px;
  margin: 16px auto 0;
  background: linear-gradient(90deg, #ff9d00, #ffc400, #1eb759);
  box-shadow: 0 0 18px rgba(255,170,0,.35);
  animation: pulse 2.5s ease-in-out infinite;
}
.vs-section-{{ section.id }} .heading p {
  margin: 16px auto 0;
  color: #666;
  font-size: 14px;
  line-height: 1.7;
  max-width: 300px;
}

/* EFFECTS */
@keyframes floatText {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}
@keyframes shine {
  0% { left: -30%; }
  100% { left: 130%; }
}
@keyframes pulse {
  0%, 100% { transform: scaleX(1); opacity: .9; }
  50% { transform: scaleX(1.08); opacity: 1; }
}

