{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 3: PRODUCT, MARKET & TECH (POINTS 01, 02, 03)
     ========================================================================== */

  .wvs-sec3-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background-color: #faf8f5;
    padding: clamp(60px, 8vw, 110px) 20px;
    color: #0b2545;
    overflow: hidden;
    border-top: 1px solid #edf2f7;
  }

  .wvs-sec3-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- 1. CENTERED TOP HEADER (MATCHING SCREENSHOT STYLE) --- */
  .wvs-sec3-top-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 60px auto;
  }

  .wvs-sec3-badge {
    display: inline-block;
    padding: 6px 18px;
    background: #eedbc5;
    color: #8c5d26;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 6px;
    margin-bottom: 20px;
  }

  .wvs-sec3-main-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(34px, 4.5vw, 56px);
    font-weight: 800;
    line-height: 1.18;
    color: #0f2c4a;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  .wvs-sec3-subhead {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
    color: #ec5c0a;
    font-weight: 800;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .wvs-sec3-intro-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #4a5568;
    margin: 0;
  }

  /* --- POINT 01: SPLIT PRODUCT SHOWCASE WITH 8D FLOATING CARD --- */
  .wvs-p1-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    margin-bottom: 90px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 28px;
    padding: clamp(30px, 5vw, 50px);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.04);
  }

  .wvs-p1-left h3 {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: #0f2c4a;
    line-height: 1.25;
    margin-bottom: 16px;
  }

  .wvs-p1-left p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #4a5568;
    margin-bottom: 24px;
  }

  /* Spec Badges Row */
  .wvs-specs-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wvs-spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff7ed;
    border: 1.5px solid #fdba74;
    border-radius: 50px;
    padding: 10px 18px;
    font-size: 0.9rem;
    font-weight: 800;
    color: #ec5c0a;
  }

  .wvs-p1-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .wvs-8d-card-frame {
    position: relative;
    width: 100%;
    max-width: 460px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(11, 37, 69, 0.25);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .wvs-8d-card-frame:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 30px 60px rgba(236, 92, 10, 0.3);
  }

  .wvs-8d-card-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .wvs-8d-badge-top {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(9, 29, 52, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid #ffcc00;
    border-radius: 50px;
    padding: 6px 14px;
    color: #ffcc00;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .wvs-8d-badge-bottom {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(0, 123, 62, 0.9);
    backdrop-filter: blur(8px);
    border-radius: 50px;
    padding: 6px 14px;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
  }

  /* --- POINT 02: WHY THE PRODUCT MATTERS (SPLIT ALTERNATING) --- */
  .wvs-p2-section {
    margin-bottom: 90px;
  }

  .wvs-p2-head {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 40px auto;
  }

  .wvs-p2-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .wvs-p2-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 24px;
    padding: 32px;
    transition: all 0.3s ease;
  }

  .wvs-p2-card:hover {
    transform: translateY(-5px);
    border-color: #ec5c0a;
    box-shadow: 0 15px 35px rgba(236, 92, 10, 0.12);
  }

  .wvs-p2-icon {
    font-size: 2rem;
    color: #ec5c0a;
    margin-bottom: 16px;
  }

  .wvs-p2-card h4 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f2c4a;
    margin-bottom: 10px;
  }

  .wvs-p2-card p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: #4a5568;
    margin: 0;
  }

  .wvs-p2-callout {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #091d34 0%, #007b3e 100%);
    border-radius: 20px;
    padding: 30px clamp(20px, 4vw, 40px);
    color: #ffffff;
    text-align: center;
    box-shadow: 0 15px 40px rgba(9, 29, 52, 0.2);
  }

  .wvs-p2-callout p {
    font-size: clamp(16px, 2vw, 21px);
    font-weight: 700;
    line-height: 1.6;
    margin: 0;
    color: #f1f5f9;
  }

  .wvs-p2-callout p strong {
    color: #ffcc00;
  }

  /* --- POINT 03: WHAT MAKES THE CARD DIFFERENT? (6 TECH CARDS) --- */
  .wvs-p3-section {
    text-align: center;
  }

  .wvs-p3-head {
    max-width: 820px;
    margin: 0 auto 45px auto;
  }

  .wvs-p3-head h3 {
    font-size: clamp(26px, 3.5vw, 42px);
    font-weight: 800;
    color: #0f2c4a;
    margin-bottom: 12px;
  }

  .wvs-p3-head p {
    font-size: 1.05rem;
    color: #4a5568;
    margin: 0;
  }

  .wvs-p3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .wvs-tech-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 22px;
    padding: 30px 22px;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.02);
  }

  .wvs-tech-card:hover {
    transform: translateY(-6px);
    border-color: #007b3e;
    box-shadow: 0 16px 40px rgba(0, 123, 62, 0.15);
  }

  .wvs-tech-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #007b3e;
    margin-bottom: 18px;
  }

  .wvs-tech-card h5 {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f2c4a;
    margin-bottom: 8px;
  }

  .wvs-tech-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  /* Responsive Rules */
  @media (max-width: 991px) {
    .wvs-p1-row {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .wvs-p1-left {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .wvs-specs-row {
      justify-content: center;
    }
    .wvs-p2-grid {
      grid-template-columns: 1fr;
    }
    .wvs-p3-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .wvs-p3-grid {
      grid-template-columns: 1fr;
    }
    .wvs-specs-row {
      flex-direction: column;
      width: 100%;
    }
    .wvs-spec-pill {
      width: 100%;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="wvs-sec3-wrapper">
  <div class="wvs-sec3-container">
    <!-- 1. TOP CENTERED HEADER (MATCHING SCREENSHOT) -->
    <div class="wvs-sec3-top-header">
      <div class="wvs-sec3-badge">
        {{ section.settings.badge_text | default: "01 — THE PRODUCT THAT POWERS THE BUSINESS" }}
      </div>

      <h2 class="wvs-sec3-main-title">
        {{ section.settings.main_title | default: "Meet The Vidhyut Saathi Electric Saver Card" }}
      </h2>

      <div class="wvs-sec3-subhead">
        MAKE EVERY UNIT OF ELECTRICITY COUNT
      </div>

      <p class="wvs-sec3-intro-text">
        At the heart of the Vidhyut Saathi business is a powerful flagship electric energy-saving product, developed around advanced technology and designed for use across multiple electricity-consuming sectors.
      </p>
    </div>

    <!-- POINT 01: SPLIT PRODUCT SHOWCASE WITH 8D FLOATING CARD -->
    <div class="wvs-p1-row">
      <!-- LEFT CONTENT -->
      <div class="wvs-p1-left">
        <h3>Simple To Install. Easy To Demonstrate. Built For Long-Term Use.</h3>
        <p>
          Designed for hassle-free installation near the MCB without complicated wiring or any changes to the existing electrical setup. It allows entrepreneurs to easily demonstrate savings to customers.
        </p>

        <!-- Spec Pills -->
        <div class="wvs-specs-row">
          <div class="wvs-spec-pill">
            <i class="fa-solid fa-hourglass-half"></i>
            <span>10 Years Long Life</span>
          </div>
          <div class="wvs-spec-pill">
            <i class="fa-solid fa-certificate"></i>
            <span>3 Years Warranty</span>
          </div>
          <div class="wvs-spec-pill">
            <i class="fa-solid fa-wrench"></i>
            <span>Zero Maintenance</span>
          </div>
        </div>
      </div>

      <!-- RIGHT 8D CARD DISPLAY -->
      <div class="wvs-p1-right">
        <div class="wvs-8d-card-frame">
          <span class="wvs-8d-badge-top">⚡ Save 20%-30%</span>
          <span class="wvs-8d-badge-bottom">🛡️ ISO-Certified</span>
          <img 
            src="{{ 'vidhyut_card_3d_render.jpg' | asset_url }}" 
            alt="Vidhyut Saathi 8D 3D Card Render" 
            class="wvs-8d-card-img"
            loading="lazy"
          >
        </div>
      </div>
    </div>

    <!-- POINT 02: WHY THE PRODUCT MATTERS -->
    <div class="wvs-p2-section">
      <div class="wvs-p2-head">
        <div class="wvs-sec3-badge">02 — WHY THE PRODUCT MATTERS</div>
        <h3 class="wvs-sec3-main-title">Electricity is Not a One-Time Expense.<br>It's a Monthly Expense.</h3>
      </div>

      <div class="wvs-p2-grid">
        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-house-user"></i></div>
          <h4>For Homes & Small Shops</h4>
          <p>Electricity is a recurring monthly bill that impacts household and operating budgets every 30 days.</p>
        </div>

        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-industry"></i></div>
          <h4>For Factories & Plants</h4>
          <p>Electricity is a direct production cost that directly affects profit margins and manufacturing overheads.</p>
        </div>

        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-hotel"></i></div>
          <h4>For Hotels & Hospitals</h4>
          <p>Electricity is a continuous 24/7 operating overhead required to maintain essential customer services.</p>
        </div>

        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-chart-line"></i></div>
          <h4>Existing Market Demand</h4>
          <p>The market isn't created by the product alone—the market already exists wherever electricity is consumed.</p>
        </div>

        <div class="wvs-p2-callout">
          <p>Vidhyut Saathi gives entrepreneurs an opportunity to take an <strong>energy-saving solution into that existing market.</strong></p>
        </div>
      </div>
    </div>

    <!-- POINT 03: WHAT MAKES THE CARD DIFFERENT? -->
    <div class="wvs-p3-section">
      <div class="wvs-p3-head">
        <div class="wvs-sec3-badge">03 — WHAT MAKES THE CARD DIFFERENT?</div>
        <h3>Advanced Technology. Simple Installation. Long-Term Value.</h3>
        <p>
          Based on US–German Nano Technology and features an advanced Terahertz Chip with 20,000+ Negative Ions designed to support smarter electricity usage.
        </p>
      </div>

      <div class="wvs-p3-grid">
        <div class="wvs-tech-card">
          <div class="wvs-tech-icon"><i class="fa-solid fa-bolt"></i></div>
          <h5>Smart Energy Efficiency</h5>
          <p>Supporting smarter and more efficient electricity usage across all appliances.</p>
        </div>

        <div class="wvs-tech-card">
          <div class="wvs-tech-icon"><i class="fa-solid fa-sack-dollar"></i></div>
          <h5>Electricity Savings</h5>
          <p>Designed to help reduce unnecessary electricity consumption and monthly expenses.</p>
        </div>

        <div class="wvs-tech-card">
          <div class="wvs-tech-icon"><i class="fa-solid fa-plug"></i></div>
          <h5>Easy MCB Installation</h5>
          <p>Simple installation near the MCB without complicated wiring or modifications.</p>
        </div>

        <div class="wvs-tech-card">
          <div class="wvs-tech-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
          <h5>Zero Regular Maintenance</h5>
          <p>Designed for completely hassle-free, long-term operational use.</p>
        </div>

        <div class="wvs-tech-card">
          <div class="wvs-tech-icon"><i class="fa-solid fa-hourglass-start"></i></div>
          <h5>10-Year Product Life</h5>
          <p>10-year long product life ensuring continuous long-term value for customers.</p>
        </div>

        <div class="wvs-tech-card">
          <div class="wvs-tech-icon"><i class="fa-solid fa-leaf"></i></div>
          <h5>Responsible Energy</h5>
          <p>Promotes smarter and more responsible energy consumption for a sustainable future.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Section 3",
  "tag": "section",
  "class": "section-why-vidhyut-product-sec3",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "01 — THE PRODUCT THAT POWERS THE BUSINESS"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Meet The Vidhyut Saathi Electric Saver Card"
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Section 3"
    }
  ]
}
{% endschema %}
