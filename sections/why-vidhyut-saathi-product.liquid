{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 3: PRODUCT, MARKET & TECH (LUCRATIVE STYLING)
     ========================================================================== */

  .wvs-sec3-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background: radial-gradient(circle at 50% 10%, #ffffff 0%, #fdfbf7 50%, #f7f3eb 100%);
    padding: clamp(60px, 8vw, 110px) 20px;
    color: #0b2545;
    overflow: hidden;
    border-top: 1px solid #edf2f7;
  }

  /* Vibrant Ambient Background Orbs */
  .wvs-sec3-orb-1 {
    position: absolute;
    top: -120px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-sec3-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-sec3-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- 1. CENTERED TOP HEADER --- */
  .wvs-sec3-top-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 60px auto;
  }

  .wvs-sec3-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1.5px solid #fdba74;
    color: #ec5c0a;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 22px;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.1);
  }

  .wvs-sec3-main-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(34px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1.18;
    color: #0f2c4a;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  .wvs-sec3-subhead {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
    color: #ec5c0a;
    font-weight: 900;
    margin-bottom: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .wvs-sec3-intro-text {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #4a5568;
    margin: 0;
  }

  /* --- POINT 01: SPLIT PRODUCT SHOWCASE WITH 8D FLOATING CARD --- */
  .wvs-p1-row {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    margin-bottom: 90px;
    background: linear-gradient(145deg, #ffffff 0%, #fffdfa 100%);
    border: 2px solid rgba(236, 92, 10, 0.18);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 56px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
  }

  .wvs-p1-left h3 {
    font-size: clamp(24px, 3.2vw, 38px);
    font-weight: 900;
    color: #0f2c4a;
    line-height: 1.22;
    margin-bottom: 18px;
  }

  .wvs-p1-left p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4a5568;
    margin-bottom: 28px;
  }

  /* Spec Badges Row with Gradient Borders */
  .wvs-specs-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wvs-spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(#ffffff, #ffffff) padding-box, linear-gradient(135deg, #ec5c0a 0%, #ffcc00 50%, #007b3e 100%) border-box;
    border: 2px solid transparent;
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.1);
    transition: transform 0.3s ease;
  }

  .wvs-spec-pill:hover {
    transform: translateY(-3px);
  }

  .wvs-spec-pill i {
    color: #ec5c0a;
    font-size: 1rem;
  }

  .wvs-p1-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Animated Spinning Conic-Gradient Border Container (Home Page 3D Card Styling) */
  .wvs-8d-card-frame {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 480px;
    border-radius: 24px;
    background-color: #0b1528;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35), inset 0 0 40px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    perspective: 2000px;
    z-index: 1;
  }

  .wvs-8d-card-frame::before {
    content: '';
    position: absolute;
    width: 170%;
    height: 170%;
    background: conic-gradient(from 0deg, transparent 65%, #ec5c0a 80%, #ffcc00 90%, #007b3e 100%);
    animation: wvs-spin-border 4s linear infinite;
    z-index: 1;
  }

  .wvs-8d-card-frame::after {
    content: '';
    position: absolute;
    inset: 4px;
    background-color: #ffffff;
    border-radius: 20px;
    z-index: 2;
  }

  @keyframes wvs-spin-border {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .wvs-8d-card-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    background: #090e1a;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .wvs-8d-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px;
    transform: scale(1.05);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wvs-8d-card-frame:hover .wvs-8d-card-img {
    transform: scale(1.09);
  }

  .wvs-8d-badge-top {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 4;
    background: rgba(9, 29, 52, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid #ffcc00;
    border-radius: 50px;
    padding: 8px 16px;
    color: #ffcc00;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .wvs-8d-badge-bottom {
    position: absolute;
    bottom: 16px;
    left: 16px;
    z-index: 4;
    background: rgba(0, 123, 62, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 50px;
    padding: 8px 16px;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  /* --- POINT 02: WHY THE PRODUCT MATTERS (LUCRATIVE CARDS) --- */
  .wvs-p2-section {
    margin-bottom: 90px;
  }

  .wvs-p2-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 45px auto;
  }

  .wvs-p2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .wvs-p2-card {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 24px;
    padding: 36px 30px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .wvs-p2-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00, #007b3e);
  }

  .wvs-p2-card:hover {
    transform: translateY(-6px);
    border-color: #ec5c0a;
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.14);
  }

  .wvs-p2-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fdba74;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #ec5c0a;
    margin-bottom: 20px;
  }

  .wvs-p2-card h4 {
    font-size: 1.3rem;
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 12px;
  }

  .wvs-p2-card p {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .wvs-p2-callout {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #091d34 0%, #007b3e 60%, #ec5c0a 100%);
    border-radius: 26px;
    padding: 36px clamp(24px, 4vw, 48px);
    color: #ffffff;
    text-align: center;
    box-shadow: 0 20px 50px rgba(9, 29, 52, 0.3);
    position: relative;
    overflow: hidden;
  }

  .wvs-p2-callout p {
    font-size: clamp(17px, 2.2vw, 22px);
    font-weight: 800;
    line-height: 1.6;
    margin: 0;
    color: #ffffff;
  }

  .wvs-p2-callout p strong {
    color: #ffcc00;
  }

  /* --- POINT 03: WHAT MAKES THE CARD DIFFERENT? (6 TECH CARDS) --- */
  .wvs-p3-section {
    text-align: center;
  }

  .wvs-p3-head {
    max-width: 840px;
    margin: 0 auto 50px auto;
  }

  .wvs-p3-head h3 {
    font-size: clamp(28px, 3.8vw, 46px);
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 14px;
  }

  .wvs-p3-head p {
    font-size: 1.08rem;
    color: #4a5568;
    margin: 0;
  }

  .wvs-p3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .wvs-tech-card {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 24px;
    padding: 34px 24px;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .wvs-tech-card:hover {
    transform: translateY(-8px);
    border-color: #007b3e;
    box-shadow: 0 20px 48px rgba(0, 123, 62, 0.18);
    background: #f0fdf4;
  }

  .wvs-tech-num {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 0.85rem;
    font-weight: 900;
    color: #cbd5e1;
  }

  .wvs-tech-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 1.5px solid #86efac;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: #007b3e;
    margin-bottom: 20px;
  }

  .wvs-tech-card h5 {
    font-size: 1.2rem;
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 10px;
  }

  .wvs-tech-card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #64748b;
    margin: 0;
  }

  /* Mobile Responsive Enhancements */
  @media (max-width: 991px) {
    .wvs-p1-row {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .wvs-p1-left {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .wvs-specs-row {
      justify-content: center;
    }
    .wvs-p2-grid {
      grid-template-columns: 1fr;
    }
    .wvs-p3-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .wvs-p3-grid {
      grid-template-columns: 1fr;
    }
    .wvs-specs-row {
      flex-direction: column;
      width: 100%;
    }
    .wvs-spec-pill {
      width: 100%;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div class="wvs-sec3-wrapper">
  <!-- Background Glow Orbs -->
  <div class="wvs-sec3-orb-1"></div>
  <div class="wvs-sec3-orb-2"></div>

  <div class="wvs-sec3-container">
    <!-- 1. TOP CENTERED HEADER -->
    <div class="wvs-sec3-top-header">
      <div class="wvs-sec3-badge">
        <i class="fa-solid fa-microchip"></i>
        <span>{{ section.settings.badge_text | default: "01 — THE PRODUCT THAT POWERS THE BUSINESS" }}</span>
      </div>

      <h2 class="wvs-sec3-main-title">
        {{ section.settings.main_title | default: "Meet The Vidhyut Saathi Electric Saver Card" }}
      </h2>

      <div class="wvs-sec3-subhead">
        MAKE EVERY UNIT OF ELECTRICITY COUNT
      </div>

      <p class="wvs-sec3-intro-text">
        At the heart of the Vidhyut Saathi business is a powerful flagship electric energy-saving product, developed around advanced technology and designed for use across multiple electricity-consuming sectors.
      </p>
    </div>

    <!-- POINT 01: SPLIT PRODUCT SHOWCASE WITH 8D FLOATING CARD -->
    <div class="wvs-p1-row">
      <!-- LEFT CONTENT -->
      <div class="wvs-p1-left">
        <h3>Simple To Install. Easy To Demonstrate. Built For Long-Term Use.</h3>
        <p>
          Designed for hassle-free installation near the MCB without complicated wiring or any changes to the existing electrical setup. It allows entrepreneurs to easily demonstrate savings to customers.
        </p>

        <!-- Spec Pills -->
        <div class="wvs-specs-row">
          <div class="wvs-spec-pill">
            <i class="fa-solid fa-hourglass-half"></i>
            <span>10 Years Long Life</span>
          </div>
          <div class="wvs-spec-pill">
            <i class="fa-solid fa-certificate"></i>
            <span>3 Years Warranty</span>
          </div>
          <div class="wvs-spec-pill">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <span>Zero Maintenance</span>
          </div>
        </div>
      </div>

      <!-- RIGHT 8D CARD DISPLAY -->
      <div class="wvs-p1-right">
        <div class="wvs-8d-card-frame">
          <span class="wvs-8d-badge-top">⚡ Save 20%-30%</span>
          <span class="wvs-8d-badge-bottom">🛡️ ISO-Certified</span>
          <div class="wvs-8d-card-inner">
            {%- if section.settings.card_custom_image != blank -%}
              {{ section.settings.card_custom_image | image_url: width: 800 | image_tag: class: 'wvs-8d-card-img', loading: 'lazy' }}
            {%- else -%}
              <img 
                src="{{ 'vidhyut_card_3d_render.jpg' | asset_url }}" 
                alt="Vidhyut Saathi 8D 3D Card Render" 
                class="wvs-8d-card-img"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <!-- POINT 02: WHY THE PRODUCT MATTERS -->
    <div class="wvs-p2-section">
      <div class="wvs-p2-head">
        <div class="wvs-sec3-badge">
          <i class="fa-solid fa-chart-line"></i>
          <span>02 — WHY THE PRODUCT MATTERS</span>
        </div>
        <h3 class="wvs-sec3-main-title">Electricity is Not a One-Time Expense.<br>It's a Monthly Expense.</h3>
      </div>

      <div class="wvs-p2-grid">
        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-house-user"></i></div>
          <h4>For Homes & Small Shops</h4>
          <p>Electricity is a recurring monthly bill that impacts household and operating budgets every 30 days.</p>
        </div>

        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-industry"></i></div>
          <h4>For Factories & Plants</h4>
          <p>Electricity is a direct production cost that directly affects profit margins and manufacturing overheads.</p>
        </div>

        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-hotel"></i></div>
          <h4>For Hotels & Hospitals</h4>
          <p>Electricity is a continuous 24/7 operating overhead required to maintain essential customer services.</p>
        </div>

        <div class="wvs-p2-card">
          <div class="wvs-p2-icon"><i class="fa-solid fa-globe"></i></div>
          <h4>Existing Market Demand</h4>
          <p>The market isn't created by the product alone—the market already exists wherever electricity is consumed.</p>
        </div>

        <div class="wvs-p2-callout">
          <p>Vidhyut Saathi gives entrepreneurs an opportunity to take an <strong>energy-saving solution into that existing market.</strong></p>
        </div>
      </div>
    </div>

    <!-- POINT 03: WHAT MAKES THE CARD DIFFERENT? -->
    <div class="wvs-p3-section">
      <div class="wvs-p3-head">
        <div class="wvs-sec3-badge">
          <i class="fa-solid fa-award"></i>
          <span>03 — WHAT MAKES THE CARD DIFFERENT?</span>
        </div>
        <h3>Advanced Technology. Simple Installation. Long-Term Value.</h3>
        <p>
          Based on US–German Nano Technology and features an advanced Terahertz Chip with 20,000+ Negative Ions designed to support smarter electricity usage.
        </p>
      </div>

      <div class="wvs-p3-grid">
        <div class="wvs-tech-card">
          <span class="wvs-tech-num">01</span>
          <div class="wvs-tech-icon"><i class="fa-solid fa-bolt"></i></div>
          <h5>Smart Energy Efficiency</h5>
          <p>Supporting smarter and more efficient electricity usage across all appliances.</p>
        </div>

        <div class="wvs-tech-card">
          <span class="wvs-tech-num">02</span>
          <div class="wvs-tech-icon"><i class="fa-solid fa-sack-dollar"></i></div>
          <h5>Electricity Savings</h5>
          <p>Designed to help reduce unnecessary electricity consumption and monthly expenses.</p>
        </div>

        <div class="wvs-tech-card">
          <span class="wvs-tech-num">03</span>
          <div class="wvs-tech-icon"><i class="fa-solid fa-plug"></i></div>
          <h5>Easy MCB Installation</h5>
          <p>Simple installation near the MCB without complicated wiring or modifications.</p>
        </div>

        <div class="wvs-tech-card">
          <span class="wvs-tech-num">04</span>
          <div class="wvs-tech-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
          <h5>Zero Regular Maintenance</h5>
          <p>Designed for completely hassle-free, long-term operational use.</p>
        </div>

        <div class="wvs-tech-card">
          <span class="wvs-tech-num">05</span>
          <div class="wvs-tech-icon"><i class="fa-solid fa-hourglass-start"></i></div>
          <h5>10-Year Product Life</h5>
          <p>10-year long product life ensuring continuous long-term value for customers.</p>
        </div>

        <div class="wvs-tech-card">
          <span class="wvs-tech-num">06</span>
          <div class="wvs-tech-icon"><i class="fa-solid fa-leaf"></i></div>
          <h5>Responsible Energy</h5>
          <p>Promotes smarter and more responsible energy consumption for a sustainable future.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Vidhyut Section 3",
  "tag": "section",
  "class": "section-why-vidhyut-product-sec3",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "01 — THE PRODUCT THAT POWERS THE BUSINESS"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Meet The Vidhyut Saathi Electric Saver Card"
    },
    {
      "type": "image_picker",
      "id": "card_custom_image",
      "label": "Custom Product / Card Image"
    }
  ],
  "presets": [
    {
      "name": "Why Vidhyut Section 3"
    }
  ]
}
{% endschema %}
