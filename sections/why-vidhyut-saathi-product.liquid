<script>
  (function() {
    function initMobileAutoSlider(gridSelector, cardSelector, dotsSelector) {
      const grid = document.querySelector(gridSelector);
      const cards = document.querySelectorAll(cardSelector);
      const dotsContainer = document.querySelector(dotsSelector);

      if (!grid || cards.length === 0 || !dotsContainer) return;

      dotsContainer.innerHTML = '';
      cards.forEach(function(_, index) {
        const dot = document.createElement('span');
        dot.className = 'wvs-dot' + (index === 0 ? ' active' : '');
        dot.addEventListener('click', function() {
          scrollToSlide(index);
        });
        dotsContainer.appendChild(dot);
      });

      const dots = dotsContainer.querySelectorAll('.wvs-dot');
      let currentIndex = 0;
      let intervalId = null;
      let isSectionVisible = false;

      function scrollToSlide(index) {
        if (index >= cards.length) index = 0;
        if (index < 0) index = cards.length - 1;
        currentIndex = index;
        const targetCard = cards[currentIndex];
        if (targetCard) {
          const scrollLeft = targetCard.offsetLeft - (grid.clientWidth - targetCard.clientWidth) / 2;
          grid.scrollTo({ left: scrollLeft, behavior: 'smooth' });
        }
        updateDots();
      }

      function updateDots() {
        dots.forEach(function(dot, i) {
          if (i === currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function startAutoPlay() {
        if (window.innerWidth <= 768 && isSectionVisible && !intervalId) {
          intervalId = setInterval(function() {
            scrollToSlide(currentIndex + 1);
          }, 3000);
        }
      }

      function stopAutoPlay() {
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
      }

      // Intersection Observer to trigger 3-second timer ONLY when section is scrolled into view
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              isSectionVisible = true;
              startAutoPlay();
            } else {
              isSectionVisible = false;
              stopAutoPlay();
            }
          });
        }, { threshold: 0.2 });

        observer.observe(grid);
      } else {
        isSectionVisible = true;
        startAutoPlay();
      }

      grid.addEventListener('scroll', function() {
        if (window.innerWidth > 768) return;
        const gridCenter = grid.scrollLeft + grid.clientWidth / 2;
        cards.forEach(function(card, idx) {
          const cardCenter = card.offsetLeft + card.clientWidth / 2;
          if (Math.abs(gridCenter - cardCenter) < card.clientWidth / 2) {
            currentIndex = idx;
            updateDots();
          }
        });
      });

      grid.addEventListener('touchstart', stopAutoPlay);
      grid.addEventListener('touchend', function() {
        if (isSectionVisible) startAutoPlay();
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 768) {
          stopAutoPlay();
        } else if (isSectionVisible) {
          startAutoPlay();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initMobileAutoSlider('.wvs-p2-grid', '.wvs-p2-card', '.wvs-slider-dots-p2');
        initMobileAutoSlider('.wvs-p3-grid', '.wvs-tech-card', '.wvs-slider-dots-p3');
      });
    } else {
      initMobileAutoSlider('.wvs-p2-grid', '.wvs-p2-card', '.wvs-slider-dots-p2');
      initMobileAutoSlider('.wvs-p3-grid', '.wvs-tech-card', '.wvs-slider-dots-p3');
    }
  })();
</script>

