{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 3: PRODUCT, MARKET & TECH (LUCRATIVE STYLING)
     ========================================================================== */

  .wvs-sec3-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background: radial-gradient(circle at 50% 10%, #ffffff 0%, #fdfbf7 50%, #f7f3eb 100%);
    padding: clamp(60px, 8vw, 110px) 20px;
    color: #0b2545;
    overflow: hidden;
    border-top: 1px solid #edf2f7;
  }

  /* Vibrant Ambient Background Orbs */
  .wvs-sec3-orb-1 {
    position: absolute;
    top: -120px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-sec3-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-sec3-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- 1. CENTERED TOP HEADER --- */
  .wvs-sec3-top-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 60px auto;
  }

  .wvs-sec3-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: #FFF7ED;
    border: 1.5px solid #F17022;
    color: #F17022;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 22px;
    box-shadow: 0 6px 20px rgba(241, 112, 34, 0.1);
  }

  .wvs-sec3-main-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(34px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1.18;
    color: #231F20;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  /* Lucrative Heading Accent Classes */
  .wvs-text-orange {
    color: #F17022;
    font-weight: 900;
  }

  .wvs-text-green {
    color: #009A44;
    font-weight: 900;
  }

  /* Clean Bold 3-Tier Headline Hierarchy */
  .wvs-h4-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    margin-bottom: 22px;
    line-height: 1.2;
  }

  .wvs-h4-part-1 {
    display: block;
    white-space: nowrap;
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 900;
    color: #111111;
    letter-spacing: -0.6px;
    margin-bottom: 8px;
    line-height: 1.15;
  }

  .wvs-h4-part-2 {
    display: block;
    white-space: nowrap;
    font-size: clamp(24px, 3.0vw, 40px);
    font-weight: 900;
    color: #F17022;
    letter-spacing: -0.4px;
    margin-bottom: 8px;
    line-height: 1.18;
  }

  .wvs-h4-part-3 {
    display: block;
    white-space: nowrap;
    font-size: clamp(20px, 2.5vw, 34px);
    font-weight: 900;
    color: #009A44;
    letter-spacing: -0.2px;
    line-height: 1.18;
  }

  /* ============================================================
     POINT 02 — PROFESSIONAL ELECTRICITY POLE FLANKED HEADER
     ============================================================ */

  .wvs-p2-head {
    text-align: center;
    max-width: 100%;
    margin: 0 auto 50px auto;
    width: 100%;
  }

  /* Full-width scene: 100% mathematically centered grid with equal left & right tower columns */
  .wvs-p2-header-wrapper {
    display: grid;
    grid-template-columns: clamp(100px, 13vw, 175px) 1fr clamp(100px, 13vw, 175px);
    align-items: center;
    justify-content: center;
    justify-items: center;
    gap: clamp(14px, 2.2vw, 30px);
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 28px auto 0 auto;
    box-sizing: border-box;
    /* Horizontal wires connecting the tops of both poles across the wide gap */
    background:
      linear-gradient(90deg, transparent 0%, rgba(241, 112, 34, 0.5) 15%, rgba(241, 112, 34, 0.5) 85%, transparent 100%) 0 28% / 100% 1.5px no-repeat,
      linear-gradient(90deg, transparent 0%, rgba(0, 154, 68, 0.4) 12%, rgba(0, 154, 68, 0.4) 88%, transparent 100%) 0 38% / 100% 1.5px no-repeat,
      linear-gradient(90deg, transparent 0%, rgba(253, 186, 0, 0.4) 18%, rgba(253, 186, 0, 0.4) 82%, transparent 100%) 0 48% / 100% 1.5px no-repeat;
  }

  /* --- POLE COLUMN (shared left & right - 100% symmetrical) --- */
  .wvs-tower-pole-col {
    position: relative;
    width: 100%;
    height: clamp(240px, 26vw, 380px);
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    border: 1.5px solid rgba(241, 112, 34, 0.25);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    box-sizing: border-radius;
  }

  .wvs-tower-pole-col-left {
    border-radius: 24px;
  }

  .wvs-tower-pole-col-right {
    border-radius: 24px;
  }

  .wvs-tower-real-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
    border-radius: inherit;
    filter: saturate(1.1) contrast(1.05);
    transition: transform 0.6s ease, filter 0.6s ease;
  }

  .wvs-tower-pole-col:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 45px rgba(241, 112, 34, 0.2);
  }

  .wvs-tower-pole-col:hover .wvs-tower-real-img {
    transform: scale(1.04);
    filter: saturate(1.25) contrast(1.1);
  }

  /* --- CENTRE TEXT COLUMN (HERO CARD SHELL - PERFECTLY CENTERED) --- */
  .wvs-p2-header-center {
    text-align: center;
    padding: 6px 0;
    position: relative;
    z-index: 5;
    width: 100%;
    box-sizing: border-box;
  }

  .wvs-p2-hero-card {
    background: radial-gradient(circle at 50% 0%, #FFFFFF 0%, #FFFDF9 60%, #FFF7ED 100%);
    border: 2.5px solid #F17022;
    border-radius: 28px;
    padding: clamp(24px, 2.8vw, 36px) clamp(16px, 2.4vw, 32px);
    box-shadow: 0 22px 55px rgba(241, 112, 34, 0.18), 0 0 0 4px rgba(0, 154, 68, 0.08);
    position: relative;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    box-sizing: border-box;
  }

  .wvs-p2-hero-card:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 28px 65px rgba(241, 112, 34, 0.25), 0 0 0 6px rgba(0, 154, 68, 0.14);
    border-color: #FB5900;
  }

  /* Top Decorative Glowing Energy Strip */
  .wvs-p2-hero-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, #009A44 0%, #25D300 30%, #F17022 65%, #FDBA00 100%);
  }

  .wvs-p2-mini-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 18px;
    background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
    border: 1.5px solid #F17022;
    color: #F17022;
    font-size: clamp(0.72rem, 1.2vw, 0.84rem);
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 18px;
    white-space: nowrap;
    box-shadow: 0 4px 15px rgba(241, 112, 34, 0.12);
  }

  .wvs-p2-mini-tag i {
    color: #FDBA00;
    font-size: 0.95em;
  }

  .wvs-p2-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    margin: 0;
  }

  .wvs-p2-line-main {
    display: block;
    white-space: nowrap;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(16px, 2.2vw, 30px);
    font-weight: 900;
    color: #231F20;
    letter-spacing: -0.4px;
    line-height: 1.25;
    margin-bottom: 18px;
    text-transform: uppercase;
  }

  .wvs-p2-line-main .wvs-highlight-orange-box {
    color: #F17022;
    background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
    padding: 4px 14px;
    border-radius: 12px;
    border: 2px solid #F17022;
    display: inline-block;
    box-shadow: 0 6px 18px rgba(241, 112, 34, 0.15);
    letter-spacing: -0.2px;
  }

  .wvs-p2-pill-highlight {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 34px;
    background: linear-gradient(135deg, #009A44 0%, #00b853 100%);
    border: 2.5px solid #FDBA00;
    color: #ffffff;
    border-radius: 50px;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(14px, 1.8vw, 21px);
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 14px 38px rgba(0, 154, 68, 0.35), 0 0 20px rgba(253, 186, 0, 0.25);
    transition: all 0.35s ease;
    white-space: nowrap;
  }

  .wvs-p2-pill-highlight i {
    color: #FDBA00;
    font-size: 1.2em;
    flex-shrink: 0;
  }

  .wvs-p2-pill-highlight span {
    color: #FDBA00;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .wvs-p2-pill-highlight:hover {
    transform: translateY(-3px) scale(1.03);
    background: linear-gradient(135deg, #00b853 0%, #25D300 100%);
    border-color: #ffffff;
    box-shadow: 0 18px 48px rgba(37, 211, 0, 0.4), 0 0 25px rgba(253, 186, 0, 0.4);
  }

  .wvs-p2-pill-highlight i {
    color: #FDBA00;
    font-size: 1.15em;
    flex-shrink: 0;
  }

  .wvs-p2-pill-highlight span {
    color: #FDBA00;
  }

  .wvs-p2-pill-highlight:hover {
    transform: translateY(-3px) scale(1.03);
    background: #008239;
    box-shadow: 0 18px 45px rgba(0, 154, 68, 0.45);
  }
  /* Clean Centered 3-Tier Headline Hierarchy */
  .wvs-p3-title {
    text-align: center;
    margin-bottom: 20px;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
  }

  .wvs-p3-part-1 {
    display: block;
    font-size: clamp(28px, 3.6vw, 46px);
    font-weight: 900;
    color: #111111;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .wvs-p3-part-2 {
    display: block;
    font-size: clamp(24px, 3.0vw, 40px);
    font-weight: 900;
    color: #009A44;
    letter-spacing: -0.3px;
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .wvs-p3-part-3 {
    display: block;
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 900;
    color: #F17022;
    letter-spacing: -0.2px;
    line-height: 1.2;
  } }

  .wvs-sec3-subhead {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
    color: #ec5c0a;
    font-weight: 900;
    margin-bottom: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .wvs-sec3-intro-text {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #4a5568;
    margin: 0;
  }

  /* --- POINT 01: SPLIT PRODUCT SHOWCASE WITH 8D FLOATING CARD --- */
  .wvs-p1-row {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    margin-bottom: 90px;
    background: linear-gradient(145deg, #ffffff 0%, #fffdfa 100%);
    border: 2px solid rgba(236, 92, 10, 0.18);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 56px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
  }

  .wvs-p1-left h3 {
    font-size: clamp(24px, 3.2vw, 38px);
    font-weight: 900;
    color: #0f2c4a;
    line-height: 1.22;
    margin-bottom: 18px;
  }

  .wvs-p1-left p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4a5568;
    margin-bottom: 28px;
  }

  /* Spec Badges Row with Gradient Borders */
  .wvs-specs-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wvs-spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(#ffffff, #ffffff) padding-box, linear-gradient(135deg, #ec5c0a 0%, #ffcc00 50%, #007b3e 100%) border-box;
    border: 2px solid transparent;
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.1);
    transition: transform 0.3s ease;
  }

  .wvs-spec-pill:hover {
    transform: translateY(-3px);
  }

  .wvs-spec-pill i {
    color: #ec5c0a;
    font-size: 1rem;
  }

  .wvs-p1-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Vibrant Radial Ambient Glow Backdrop Behind Card */
  .wvs-p1-right::before {
    content: '';
    position: absolute;
    width: 110%;
    height: 110%;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.22) 0%, rgba(0, 123, 62, 0.16) 45%, transparent 75%);
    border-radius: 50%;
    filter: blur(35px);
    z-index: 0;
    pointer-events: none;
  }

  /* Animated Spinning Conic-Gradient Border Container (Home Page 3D Card Styling) */
  .wvs-8d-card-frame {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1.52 / 1;
    height: auto;
    border-radius: 22px;
    background-color: #ffffff;
    box-shadow: 0 25px 60px rgba(9, 29, 52, 0.12), 0 0 35px rgba(236, 92, 10, 0.2);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
    perspective: 2000px;
    z-index: 1;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .wvs-8d-card-frame:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 35px 80px rgba(236, 92, 10, 0.3), 0 0 45px rgba(0, 123, 62, 0.25);
  }

  .wvs-8d-card-frame::before {
    content: '';
    position: absolute;
    width: 180%;
    height: 180%;
    background: conic-gradient(from 0deg, transparent 65%, #ec5c0a 80%, #ffcc00 90%, #007b3e 100%);
    animation: wvs-spin-border 4s linear infinite;
    z-index: 1;
  }

  .wvs-8d-card-frame::after {
    content: '';
    position: absolute;
    inset: 3px;
    background-color: #ffffff;
    border-radius: 19px;
    z-index: 2;
  }

  @keyframes wvs-spin-border {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .wvs-8d-card-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    border-radius: 19px;
    background: linear-gradient(135deg, #ffffff 0%, #f4f8fc 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  /* Glass Sheen Light Reflection Overlay */
  .wvs-card-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(125deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.08) 35%, transparent 65%);
    z-index: 4;
    pointer-events: none;
  }

  /* 3D Continuous Floating & 360 Gyro Motion Animation */
  @keyframes wvs-card-360-float {
    0% {
      transform: perspective(1000px) rotateY(0deg) rotateX(4deg) translateY(0px) scale(1.01);
    }
    25% {
      transform: perspective(1000px) rotateY(10deg) rotateX(-5deg) translateY(-8px) scale(1.02);
    }
    50% {
      transform: perspective(1000px) rotateY(0deg) rotateX(6deg) translateY(0px) scale(1.01);
    }
    75% {
      transform: perspective(1000px) rotateY(-10deg) rotateX(-4deg) translateY(8px) scale(1.02);
    }
    100% {
      transform: perspective(1000px) rotateY(0deg) rotateX(4deg) translateY(0px) scale(1.01);
    }
  }

  .wvs-8d-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 19px;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    filter: contrast(1.04) brightness(1.02);
    animation: wvs-card-360-float 7s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .wvs-8d-card-frame:hover .wvs-8d-card-img {
    animation-play-state: paused;
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) scale(1.04);
  }

  /* --- POINT 02: WHY THE PRODUCT MATTERS (LUCRATIVE CARDS) --- */
  .wvs-p2-section {
    margin-bottom: 90px;
  }

  .wvs-p2-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 45px auto;
  }

  .wvs-p2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .wvs-p2-card {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 24px;
    padding: 36px 30px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .wvs-p2-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00, #007b3e);
  }

  .wvs-p2-card:hover {
    transform: translateY(-6px);
    border-color: #ec5c0a;
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.14);
  }

  .wvs-p2-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fdba74;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #ec5c0a;
    margin-bottom: 20px;
  }

  .wvs-p2-card h4 {
    font-size: 1.3rem;
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 12px;
  }

  .wvs-p2-card p {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .wvs-p2-callout {
    grid-column: 1 / -1;
    background: #009A44;
    border: 2.5px solid #F17022;
    border-radius: 26px;
    padding: 36px clamp(24px, 4vw, 48px);
    color: #ffffff;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 154, 68, 0.25);
    position: relative;
    overflow: hidden;
  }

  .wvs-p2-callout p {
    font-size: clamp(17px, 2.2vw, 22px);
    font-weight: 800;
    line-height: 1.6;
    margin: 0;
    color: #ffffff;
  }

  .wvs-p2-callout p strong {
    color: #ffcc00;
  }

  /* --- POINT 03: WHAT MAKES THE CARD DIFFERENT? (6 TECH CARDS) --- */
  .wvs-p3-section {
    text-align: center;
  }

  .wvs-p3-head {
    max-width: 840px;
    margin: 0 auto 50px auto;
  }

  .wvs-p3-head h3 {
    font-size: clamp(28px, 3.8vw, 46px);
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 14px;
  }

  .wvs-p3-head p {
    font-size: 1.08rem;
    color: #4a5568;
    margin: 0;
  }

  .wvs-p3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .wvs-tech-card {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 24px;
    padding: 34px 24px;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .wvs-tech-card:hover {
    transform: translateY(-8px);
    border-color: #007b3e;
    box-shadow: 0 20px 48px rgba(0, 123, 62, 0.18);
    background: #f0fdf4;
  }

  .wvs-tech-num {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 0.85rem;
    font-weight: 900;
    color: #cbd5e1;
  }

  .wvs-tech-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 1.5px solid #86efac;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: #007b3e;
    margin-bottom: 20px;
  }

  .wvs-tech-card h5 {
    font-size: 1.2rem;
    font-weight: 900;
    color: #0f2c4a;
