{%- style -%}
  /* ==========================================================================
     WHY VIDHYUT SAATHI - SECTION 3: PRODUCT, MARKET & TECH (LUCRATIVE STYLING)
     ========================================================================== */

  .wvs-sec3-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    position: relative;
    background: radial-gradient(circle at 50% 10%, #ffffff 0%, #fdfbf7 50%, #f7f3eb 100%);
    padding: clamp(60px, 8vw, 110px) 20px;
    color: #0b2545;
    overflow: hidden;
    border-top: 1px solid #edf2f7;
  }

  /* Vibrant Ambient Background Orbs */
  .wvs-sec3-orb-1 {
    position: absolute;
    top: -120px;
    left: -100px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-sec3-orb-2 {
    position: absolute;
    bottom: -150px;
    right: -100px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .wvs-sec3-container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* --- 1. CENTERED TOP HEADER --- */
  .wvs-sec3-top-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 60px auto;
  }

  .wvs-sec3-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1.5px solid #fdba74;
    color: #ec5c0a;
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    border-radius: 50px;
    margin-bottom: 22px;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.1);
  }

  .wvs-sec3-main-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(34px, 4.5vw, 56px);
    font-weight: 900;
    line-height: 1.18;
    color: #0f2c4a;
    margin-bottom: 18px;
    letter-spacing: -0.5px;
  }

  /* Lucrative Heading Accent Classes */
  .wvs-text-orange {
    color: #ec5c0a;
    font-weight: 900;
  }

  .wvs-text-green {
    color: #007b3e;
    font-weight: 900;
  }

  /* Lucrative 3-Tier Typographic Gradient Hierarchy */
  .wvs-h4-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    margin-bottom: 22px;
    line-height: 1.2;
  }

  .wvs-h4-part-1 {
    display: block;
    white-space: nowrap;
    font-size: clamp(30px, 3.8vw, 50px);
    font-weight: 900;
    background: linear-gradient(135deg, #091d34 0%, #0f2c4a 50%, #0284c7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.8px;
    margin-bottom: 10px;
    line-height: 1.15;
    filter: drop-shadow(0 4px 12px rgba(9, 29, 52, 0.1));
  }

  .wvs-h4-part-2 {
    display: block;
    white-space: nowrap;
    font-size: clamp(24px, 3.0vw, 40px);
    font-weight: 900;
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7b00 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
    line-height: 1.18;
    filter: drop-shadow(0 4px 14px rgba(236, 92, 10, 0.2));
  }

  .wvs-h4-part-3 {
    display: block;
    white-space: nowrap;
    font-size: clamp(20px, 2.4vw, 32px);
    font-weight: 900;
    background: linear-gradient(135deg, #007b3e 0%, #059669 50%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.3px;
    line-height: 1.18;
    filter: drop-shadow(0 4px 12px rgba(0, 123, 62, 0.15));
  }

  /* Point 02 Real Electricity Transmission Tower Photos Header Wrapper */
  .wvs-p2-head {
    text-align: center;
    max-width: 1100px;
    margin: 0 auto 45px auto;
    width: 100%;
  }

  .wvs-p2-header-wrapper {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    justify-items: center;
    gap: clamp(16px, 3vw, 40px);
    position: relative;
    margin-top: 20px;
    width: 100%;
  }

  .wvs-tower-photo-box {
    position: relative;
    width: clamp(65px, 6.5vw, 95px);
    height: clamp(65px, 6.5vw, 95px);
    border-radius: 20px;
    padding: 3px;
    background: linear-gradient(135deg, #091d34 0%, #ec5c0a 100%);
    box-shadow: 0 10px 25px rgba(9, 29, 52, 0.2), 0 0 15px rgba(236, 92, 10, 0.2);
    flex-shrink: 0;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .wvs-tower-photo-box:hover {
    transform: translateY(-5px) scale(1.04);
    box-shadow: 0 15px 35px rgba(236, 92, 10, 0.35);
  }

  .wvs-tower-real-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 17px;
    display: block;
    image-rendering: -webkit-optimize-contrast;
  }

  .wvs-tower-photo-glow {
    position: absolute;
    inset: -4px;
    border-radius: 24px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.45) 0%, rgba(255, 204, 0, 0.4) 100%);
    filter: blur(8px);
    z-index: -1;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .wvs-tower-photo-box:hover .wvs-tower-photo-glow {
    opacity: 1;
  }

  .wvs-p2-header-center {
    flex: 1;
    text-align: center;
  }

  .wvs-p2-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    margin: 0;
  }

  .wvs-p2-line-main {
    display: block;
    white-space: nowrap;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(18px, 2.5vw, 35px);
    font-weight: 900;
    color: #0f2c4a;
    letter-spacing: -0.5px;
    line-height: 1.25;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .wvs-p2-pill-highlight {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 28px;
    background: linear-gradient(135deg, #091d34 0%, #0b2545 100%);
    border: 2px solid #ec5c0a;
    color: #ffffff;
    border-radius: 50px;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(15px, 2.0vw, 22px);
    font-weight: 900;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    box-shadow: 0 10px 30px rgba(9, 29, 52, 0.3);
    transition: all 0.3s ease;
  }

  .wvs-p2-pill-highlight span {
    color: #ffcc00;
  }

  .wvs-p2-pill-highlight:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 15px 40px rgba(236, 92, 10, 0.35);
  }

  .wvs-p3-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(24px, 3.5vw, 42px);
    font-weight: 900;
    line-height: 1.25;
    color: #0f2c4a;
    margin-bottom: 14px;
  }

  .wvs-h6-part-1 {
    color: #0f2c4a;
    font-weight: 900;
  }
  .wvs-h6-part-3 {
    color: #007b3e;
    font-weight: 900;
  }

  .wvs-sec3-subhead {
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
    color: #ec5c0a;
    font-weight: 900;
    margin-bottom: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .wvs-sec3-intro-text {
    font-size: 1.08rem;
    line-height: 1.7;
    color: #4a5568;
    margin: 0;
  }

  /* --- POINT 01: SPLIT PRODUCT SHOWCASE WITH 8D FLOATING CARD --- */
  .wvs-p1-row {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    align-items: center;
    gap: clamp(30px, 5vw, 60px);
    margin-bottom: 90px;
    background: linear-gradient(145deg, #ffffff 0%, #fffdfa 100%);
    border: 2px solid rgba(236, 92, 10, 0.18);
    border-radius: 32px;
    padding: clamp(32px, 5vw, 56px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
  }

  .wvs-p1-left h3 {
    font-size: clamp(24px, 3.2vw, 38px);
    font-weight: 900;
    color: #0f2c4a;
    line-height: 1.22;
    margin-bottom: 18px;
  }

  .wvs-p1-left p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4a5568;
    margin-bottom: 28px;
  }

  /* Spec Badges Row with Gradient Borders */
  .wvs-specs-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wvs-spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(#ffffff, #ffffff) padding-box, linear-gradient(135deg, #ec5c0a 0%, #ffcc00 50%, #007b3e 100%) border-box;
    border: 2px solid transparent;
    border-radius: 50px;
    padding: 10px 20px;
    font-size: 0.92rem;
    font-weight: 800;
    color: #0f172a;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.1);
    transition: transform 0.3s ease;
  }

  .wvs-spec-pill:hover {
    transform: translateY(-3px);
  }

  .wvs-spec-pill i {
    color: #ec5c0a;
    font-size: 1rem;
  }

  .wvs-p1-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Vibrant Radial Ambient Glow Backdrop Behind Card */
  .wvs-p1-right::before {
    content: '';
    position: absolute;
    width: 110%;
    height: 110%;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.22) 0%, rgba(0, 123, 62, 0.16) 45%, transparent 75%);
    border-radius: 50%;
    filter: blur(35px);
    z-index: 0;
    pointer-events: none;
  }

  /* Animated Spinning Conic-Gradient Border Container (Home Page 3D Card Styling) */
  .wvs-8d-card-frame {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1.52 / 1;
    height: auto;
    border-radius: 22px;
    background-color: #0b1528;
    box-shadow: 0 25px 60px rgba(9, 29, 52, 0.4), 0 0 35px rgba(236, 92, 10, 0.25);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
    perspective: 2000px;
    z-index: 1;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .wvs-8d-card-frame:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 35px 80px rgba(236, 92, 10, 0.35), 0 0 45px rgba(0, 123, 62, 0.3);
  }

  .wvs-8d-card-frame::before {
    content: '';
    position: absolute;
    width: 180%;
    height: 180%;
    background: conic-gradient(from 0deg, transparent 65%, #ec5c0a 80%, #ffcc00 90%, #007b3e 100%);
    animation: wvs-spin-border 4s linear infinite;
    z-index: 1;
  }

  .wvs-8d-card-frame::after {
    content: '';
    position: absolute;
    inset: 3px;
    background-color: #ffffff;
    border-radius: 19px;
    z-index: 2;
  }

  @keyframes wvs-spin-border {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .wvs-8d-card-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    border-radius: 19px;
    background: radial-gradient(circle at 50% 50%, #0e1c31 0%, #040812 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  /* Glass Sheen Light Reflection Overlay */
  .wvs-card-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(125deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.04) 35%, transparent 65%);
    z-index: 4;
    pointer-events: none;
  }

  /* 3D Continuous Floating & 360 Gyro Motion Animation */
  @keyframes wvs-card-360-float {
    0% {
      transform: perspective(1000px) rotateY(0deg) rotateX(4deg) translateY(0px) scale(1.01);
    }
    25% {
      transform: perspective(1000px) rotateY(10deg) rotateX(-5deg) translateY(-8px) scale(1.02);
    }
    50% {
      transform: perspective(1000px) rotateY(0deg) rotateX(6deg) translateY(0px) scale(1.01);
    }
    75% {
      transform: perspective(1000px) rotateY(-10deg) rotateX(-4deg) translateY(8px) scale(1.02);
    }
    100% {
      transform: perspective(1000px) rotateY(0deg) rotateX(4deg) translateY(0px) scale(1.01);
    }
  }

  .wvs-8d-card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 19px;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    filter: contrast(1.04) brightness(1.02);
    animation: wvs-card-360-float 7s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .wvs-8d-card-frame:hover .wvs-8d-card-img {
    animation-play-state: paused;
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg) scale(1.04);
  }

  /* --- POINT 02: WHY THE PRODUCT MATTERS (LUCRATIVE CARDS) --- */
  .wvs-p2-section {
    margin-bottom: 90px;
  }

  .wvs-p2-head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 45px auto;
  }

  .wvs-p2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .wvs-p2-card {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 24px;
    padding: 36px 30px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .wvs-p2-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #ec5c0a, #ffcc00, #007b3e);
  }

  .wvs-p2-card:hover {
    transform: translateY(-6px);
    border-color: #ec5c0a;
    box-shadow: 0 18px 45px rgba(236, 92, 10, 0.14);
  }

  .wvs-p2-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fdba74;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #ec5c0a;
    margin-bottom: 20px;
  }

  .wvs-p2-card h4 {
    font-size: 1.3rem;
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 12px;
  }

  .wvs-p2-card p {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .wvs-p2-callout {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #091d34 0%, #007b3e 60%, #ec5c0a 100%);
    border-radius: 26px;
    padding: 36px clamp(24px, 4vw, 48px);
    color: #ffffff;
    text-align: center;
    box-shadow: 0 20px 50px rgba(9, 29, 52, 0.3);
    position: relative;
    overflow: hidden;
  }

  .wvs-p2-callout p {
    font-size: clamp(17px, 2.2vw, 22px);
    font-weight: 800;
    line-height: 1.6;
    margin: 0;
    color: #ffffff;
  }

  .wvs-p2-callout p strong {
    color: #ffcc00;
  }

  /* --- POINT 03: WHAT MAKES THE CARD DIFFERENT? (6 TECH CARDS) --- */
  .wvs-p3-section {
    text-align: center;
  }

  .wvs-p3-head {
    max-width: 840px;
    margin: 0 auto 50px auto;
  }

  .wvs-p3-head h3 {
    font-size: clamp(28px, 3.8vw, 46px);
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 14px;
  }

  .wvs-p3-head p {
    font-size: 1.08rem;
    color: #4a5568;
    margin: 0;
  }

  .wvs-p3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .wvs-tech-card {
    background: #ffffff;
    border: 2px solid #f1f5f9;
    border-radius: 24px;
    padding: 34px 24px;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.03);
    position: relative;
  }

  .wvs-tech-card:hover {
    transform: translateY(-8px);
    border-color: #007b3e;
    box-shadow: 0 20px 48px rgba(0, 123, 62, 0.18);
    background: #f0fdf4;
  }

  .wvs-tech-num {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 0.85rem;
    font-weight: 900;
    color: #cbd5e1;
  }

  .wvs-tech-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 1.5px solid #86efac;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: #007b3e;
    margin-bottom: 20px;
  }

  .wvs-tech-card h5 {
    font-size: 1.2rem;
    font-weight: 900;
    color: #0f2c4a;
    margin-bottom: 10px;
  }

  .wvs-tech-card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #64748b;
    margin: 0;
  }

  /* Slider Dots Styling for Mobile */
  .wvs-slider-dots-p2, .wvs-slider-dots-p3 {
    display: none;
  }

  /* Mobile Responsive & Auto-Slider Enhancements */
  @media (max-width: 991px) {
    .wvs-sec3-wrapper {
      padding: clamp(35px, 5vw, 60px) 14px;
    }
    .wvs-sec3-top-header {
      margin-bottom: 40px;
    }
    .wvs-p1-row {
      grid-template-columns: 1fr;
      text-align: center;
      padding: clamp(24px, 4vw, 40px) 16px;
      margin-bottom: 50px;
    }
    .wvs-p1-left {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .wvs-h4-part-1, .wvs-h4-part-2, .wvs-h4-part-3 {
      white-space: normal;
      font-size: clamp(19px, 4.5vw, 26px);
    }
    .wvs-specs-row {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .wvs-8d-card-frame {
      max-width: 100%;
    }
    .wvs-8d-badge-top, .wvs-8d-badge-bottom {
      padding: 5px 12px;
      font-size: 0.78rem;
    }
    .wvs-p2-header-wrapper {
      grid-template-columns: auto 1fr auto;
      gap: 8px;
    }
    .wvs-tower-photo-box {
      width: clamp(44px, 11vw, 64px);
      height: clamp(44px, 11vw, 64px);
      border-radius: 14px;
      padding: 2px;
    }
    .wvs-tower-real-img {
      border-radius: 12px;
    }
    .wvs-p2-line-main {
      white-space: normal;
      font-size: clamp(15px, 4.0vw, 22px);
      line-height: 1.3;
      margin-bottom: 8px;
    }
    .wvs-p2-pill-highlight {
      padding: 8px 16px;
      font-size: clamp(11px, 2.8vw, 15px);
      gap: 6px;
      border-width: 1.5px;
    }
    .wvs-p2-card {
      padding: 24px 18px;
    }
    .wvs-p2-callout {
      padding: 24px 16px;
    }
    .wvs-tech-card {
      padding: 24px 18px;
    }

    /* Slider 1 & 2: Point 02 & Point 03 Full-Width Clean Mobile Sliders */
    .wvs-p2-grid, .wvs-p3-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      gap: 0;
      padding: 10px 0 20px 0;
      margin-bottom: 10px;
      scrollbar-width: none;
      width: 100%;
    }
    .wvs-p2-grid::-webkit-scrollbar, .wvs-p3-grid::-webkit-scrollbar {
      display: none;
    }
    .wvs-p2-card, .wvs-tech-card {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      box-sizing: border-box;
      scroll-snap-align: start;
      margin: 0;
    }

    /* Active Pagination Dots */
    .wvs-slider-dots-p2, .wvs-slider-dots-p3 {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
      margin-bottom: 30px;
    }
    .wvs-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #cbd5e1;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .wvs-dot.active {
      width: 26px;
      border-radius: 20px;
      background: #ec5c0a;
    }
  }

  @media (max-width: 480px) {
    .wvs-sec3-badge {
      font-size: 0.78rem;
