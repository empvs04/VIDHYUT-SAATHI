  .vsinst-sec8-pill.c2-card::before { background: linear-gradient(90deg, #ec5c0a, #f97316); }
  .vsinst-sec8-pill.c3-card::before { background: linear-gradient(90deg, #7c3aed, #a855f7); }
  .vsinst-sec8-pill.c4-card::before { background: linear-gradient(90deg, #008744, #10b981); }

