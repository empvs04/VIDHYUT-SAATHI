        transform: scale(1.22) translateY(-4px); 
        filter: drop-shadow(0 0 10px #EC5C0A) drop-shadow(0 0 18px #FF9A00);
      }
    }

    @keyframes pinPulseRing {
      0% { transform: scale(0.3); opacity: 1; }
      100% { transform: scale(2.6); opacity: 0; }
    }

