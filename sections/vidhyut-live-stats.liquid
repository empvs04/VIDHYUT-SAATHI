<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  #shopify-section-{{ section.id }} {
    --bg-white: {{ section.settings.bg_color }};
    --navy: {{ section.settings.text_color_main }};
    --gold-main: {{ section.settings.accent_color }};
    --grid-bg: {{ section.settings.grid_bg_color }};
    --grid-border: {{ section.settings.grid_border_color }};
    --text-muted: {{ section.settings.text_color_muted }};
    --marquee-bg: {{ section.settings.marquee_bg_color }};
    --marquee-text: {{ section.settings.marquee_text_color }};
    --marquee-dot: {{ section.settings.marquee_dot_color }};
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  /* --- LUCRATIVE GLASSMORPHIC SECTION WRAPPER --- */
  #shopify-section-{{ section.id }} .network-section-clean {
    position: relative;
    background: linear-gradient(135deg, #0B132B 0%, #1C2541 50%, #0B132B 100%);
    color: #FFFFFF;      
    padding: {{ section.settings.padding_top }}px 0 0 0; 
    text-align: center;
    overflow: hidden;
  }

  /* Ambient Radial Glow Background Accents */
  #shopify-section-{{ section.id }} .network-section-clean::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(236, 92, 10, 0.25) 0%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .network-content-wrapper {
    position: relative;
    z-index: 2;
    padding: 0 20px 60px 20px;
    max-width: 1140px;
    margin: 0 auto;
  }

  /* --- LUCRATIVE BADGE & TITLE --- */
  #shopify-section-{{ section.id }} .network-subtitle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 22px;
    border-radius: 50px;
    background: rgba(236, 92, 10, 0.12);
    border: 1.5px solid rgba(236, 92, 10, 0.45);
    color: #FF9A00;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 22px;
    text-transform: uppercase;
    box-shadow: 0 0 20px rgba(236, 92, 10, 0.2);
  }
  
  #shopify-section-{{ section.id }} .network-title {
    font-size: 3.2rem;
    font-weight: 900;
    margin-bottom: 50px;
    line-height: 1.2;
    color: #FFFFFF;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .net-text { 
    color: #FFFFFF;
    font-weight: 800;
  }
  
  #shopify-section-{{ section.id }} .net-number { 
    display: inline-block;
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    margin: 0 8px;
    background: linear-gradient(135deg, #FF9A00 0%, #EC5C0A 50%, #FF5500 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 8px 22px rgba(236, 92, 10, 0.45));
  }

  /* --- 3D STATS CARDS GRID --- */
  #shopify-section-{{ section.id }} .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 20px;
  }
  
  #shopify-section-{{ section.id }} .stat-item {
    background: rgba(255, 255, 255, 0.05); 
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(236, 92, 10, 0.28);
    border-top: 5px solid #EC5C0A;
    padding: 36px 24px;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }
  
  #shopify-section-{{ section.id }} .stat-item:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: #EC5C0A;
    box-shadow: 0 28px 55px rgba(236, 92, 10, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  #shopify-section-{{ section.id }} .stat-icon { 
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.25) 0%, rgba(255, 154, 0, 0.1) 100%);
    border: 1.5px solid rgba(236, 92, 10, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem; 
    color: #FF9A00; 
    margin-bottom: 18px; 
    box-shadow: 0 8px 20px rgba(236, 92, 10, 0.2);
  }
  
  #shopify-section-{{ section.id }} .stat-num { 
    font-size: 3rem; 
    font-weight: 900; 
    display: inline-block; 
    color: #10B981; 
    line-height: 1; 
    font-variant-numeric: tabular-nums; 
    font-feature-settings: "tnum";
    margin-bottom: 8px;
    filter: drop-shadow(0 4px 15px rgba(16, 185, 129, 0.3));
  }
  
  #shopify-section-{{ section.id }} .stat-label { 
    font-size: 0.88rem; 
    color: #CBD5E1; 
    font-weight: 800; 
    text-transform: uppercase; 
    letter-spacing: 1px;
  }

  /* --- MARQUEE STRIP (DARK GRADIENT ACCENT) --- */
  #shopify-section-{{ section.id }} .network-marquee-strip {
    background: #070D1E; 
    color: #FFFFFF;
    padding: 16px 0;
    overflow: hidden;
    position: relative;
    border-top: 2px solid rgba(236, 92, 10, 0.4); 
    display: flex;
    white-space: nowrap;
    z-index: 2;
  }
  
  #shopify-section-{{ section.id }} .marquee-track {
    display: flex;
    width: fit-content;
    animation: scrollNetwork-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .marquee-content {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }
  
  #shopify-section-{{ section.id }} .marquee-item {
    display: flex;
    align-items: center;
    font-weight: 800;
    font-size: 0.88rem;
    margin-right: 60px; 
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #E2E8F0;
  }

  #shopify-section-{{ section.id }} .live-dot {
    display: inline-block;
    width: 9px; 
    height: 9px;
    background: #10B981; 
    border-radius: 50%;
    margin-right: 10px;
    box-shadow: 0 0 10px #10B981;
    animation: blink-{{ section.id }} 1.5s infinite;
  }

  @keyframes blink-{{ section.id }} { 
    0% { opacity: 1; transform: scale(1); } 
    50% { opacity: 0.4; transform: scale(0.8); } 
    100% { opacity: 1; transform: scale(1); } 
  }
  
  @keyframes scrollNetwork-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* --- MOBILE FIXES (100% ORIGINAL CLEAN LIGHT MOBILE THEME) --- */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .network-section-clean { 
      background: var(--bg-white, #ffffff) !important;
      color: #0f172a !important;
      padding-top: 25px !important; 
    }
    #shopify-section-{{ section.id }} .network-section-clean::before {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .network-content-wrapper {
      padding: 0 14px 35px 14px !important;
    }
    
    #shopify-section-{{ section.id }} .network-subtitle {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 6px !important;
      padding: 6px 16px !important;
      border-radius: 50px !important;
      background: linear-gradient(135deg, #FFF3EB 0%, #FFE8D6 100%) !important;
      border: 1.5px solid rgba(236, 92, 10, 0.4) !important;
      color: #EC5C0A !important;
      font-size: 0.76rem !important;
      font-weight: 800 !important;
      letter-spacing: 0.8px !important;
      margin: 0 auto 16px auto !important;
      box-shadow: 0 4px 15px rgba(236, 92, 10, 0.12) !important;
    }

    #shopify-section-{{ section.id }} .network-title { 
      font-size: 1.6rem !important; 
      margin-bottom: 25px !important; 
      display: flex !important;
      flex-direction: column !important; 
      align-items: center !important;
      justify-content: center !important;
      gap: 2px !important; 
      line-height: 1.25 !important;
      color: #0f172a !important;
      text-align: center !important;
    }

    #shopify-section-{{ section.id }} .net-text {
      display: block !important;
      font-size: 1.5rem !important;
      font-weight: 800 !important;
      color: #007B3E !important;
    }

    #shopify-section-{{ section.id }} .net-number {
      display: block !important;
      font-size: 3.4rem !important; 
      background: linear-gradient(135deg, #EC5C0A 0%, #FF9A00 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      font-weight: 900 !important;
      line-height: 1.05 !important;
      margin: 4px 0 !important;
      min-height: auto !important;
      filter: drop-shadow(0 4px 12px rgba(236, 92, 10, 0.25)) !important;
    }
    
    #shopify-section-{{ section.id }} .stats-grid { 
      grid-template-columns: repeat(3, 1fr) !important; 
      gap: 8px !important; 
      align-items: stretch !important;
    }
    
    #shopify-section-{{ section.id }} .stat-item { 
      background: linear-gradient(145deg, #FFFFFF 0%, #FFFCF8 100%) !important;
      border: 1.5px solid rgba(236, 92, 10, 0.25) !important;
      border-top: 4px solid #EC5C0A !important;
      border-radius: 16px !important;
      padding: 16px 6px 14px 6px !important; 
      display: flex !important; 
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      text-align: center !important; 
      box-shadow: 0 10px 25px rgba(236, 92, 10, 0.08) !important;
      height: 100% !important;
      min-height: 135px !important;
    }
    
    #shopify-section-{{ section.id }} .stat-icon { 
      width: auto !important;
      height: auto !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      font-size: 1.6rem !important; 
      color: #EC5C0A !important;
      margin-bottom: 6px !important; 
      filter: drop-shadow(0 4px 10px rgba(236, 92, 10, 0.3)) !important;
    }
    
    #shopify-section-{{ section.id }} .stat-num { 
      font-size: 1.5rem !important; 
      font-weight: 900 !important;
      color: #007B3E !important;
      margin-bottom: 4px !important;
      line-height: 1 !important;
      filter: none !important;
    }
    
    #shopify-section-{{ section.id }} .stat-label { 
      font-size: 0.64rem !important; 
      font-weight: 800 !important;
      color: #475569 !important;
      line-height: 1.25 !important; 
      text-transform: uppercase !important;
      letter-spacing: 0.2px !important;
    }
    
    #shopify-section-{{ section.id }} .marquee-item { 
      margin-right: 35px !important; 
      font-size: 0.78rem !important; 
    }
  }
</style>

<div class="network-section-clean" id="network-{{ section.id }}">
  <div class="network-content-wrapper">
    <h5 class="network-subtitle">{{ section.settings.subtitle }}</h5>
    
    <h2 class="network-title">
      <span class="net-text">{{ section.settings.title_part_1 }}</span>
      <span class="net-number"><span class="counter" data-target="{{ section.settings.main_counter_target }}">0</span></span>
      <span class="net-text">{{ section.settings.title_part_2 }}</span>
    </h2>
    
    <div class="stats-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat_item' -%}
          <div class="stat-item" {{ block.shopify_attributes }}>
            <div class="stat-icon"><i class="{{ block.settings.icon_class }}"></i></div>
            <div class="stat-num counter" data-target="{{ block.settings.target_number }}">0</div>
            <div class="stat-label">{{ block.settings.label }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="network-marquee-strip">
    <div class="marquee-track">
      <div class="marquee-content">
        {%- for block in section.blocks -%}
          {%- if block.type == 'marquee_order' -%}
            <span class="marquee-item" {{ block.shopify_attributes }}>
              <span class="live-dot"></span> {{ block.settings.order_text }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      
      <div class="marquee-content" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.type == 'marquee_order' -%}
            <span class="marquee-item">
              <span class="live-dot"></span> {{ block.settings.order_text }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Scope query selector to this specific section to prevent conflicts
    const stats = document.querySelectorAll('#network-{{ section.id }} .counter');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = +entry.target.getAttribute('data-target');
          if (!target) return; // Prevent errors if target is missing
          
          const duration = 2000; 
          const increment = target / (duration / 16); 
          
          let current = 0;
          
          const updateCount = () => {
            current += increment;
            
            if (current < target) {
              entry.target.innerText = Math.ceil(current) + "+";
              requestAnimationFrame(updateCount);
            } else {
              entry.target.innerText = target + "+";
            }
          };
          
          updateCount();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    stats.forEach(stat => observer.observe(stat));
  });
</script>

