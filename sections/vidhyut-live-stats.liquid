    #shopify-section-{{ section.id }} .vs-map-live-pin.pin-3 { top: 72%; left: 37%; animation-delay: 1.0s !important; }
    #shopify-section-{{ section.id }} .vs-map-live-pin.pin-4 { top: 39%; left: 50%; animation-delay: 1.5s !important; }
    #shopify-section-{{ section.id }} .vs-map-live-pin.pin-5 { top: 48%; left: 63%; animation-delay: 2.0s !important; }
    #shopify-section-{{ section.id }} .vs-map-live-pin.pin-6 { top: 46%; left: 27%; animation-delay: 2.5s !important; }

    #shopify-section-{{ section.id }} .ping-dot {
