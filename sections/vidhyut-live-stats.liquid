      height: 100% !important;
      min-height: 135px !important;
    }
    
    #shopify-section-{{ section.id }} .stat-icon { 
      width: auto !important;
      height: auto !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      font-size: 1.6rem !important; 
      color: #EC5C0A !important;
      margin-bottom: 6px !important; 
      filter: drop-shadow(0 4px 10px rgba(236, 92, 10, 0.3)) !important;
    }
    
    #shopify-section-{{ section.id }} .stat-num { 
      font-size: 1.5rem !important; 
      font-weight: 900 !important;
      color: #007B3E !important;
      margin-bottom: 4px !important;
      line-height: 1 !important;
      filter: none !important;
    }
    
    #shopify-section-{{ section.id }} .stat-label { 
      font-size: 0.64rem !important; 
      font-weight: 800 !important;
      color: #475569 !important;
      line-height: 1.25 !important; 
      text-transform: uppercase !important;
      letter-spacing: 0.2px !important;
    }
    
    #shopify-section-{{ section.id }} .marquee-item { 
      margin-right: 35px !important; 
      font-size: 0.78rem !important; 
    }
  }
</style>

<div class="network-section-clean" id="network-{{ section.id }}">
  <div class="network-content-wrapper">
    
    <!-- CENTERED SUBHEADER BADGE AT TOP -->
    <div class="vs-subtitle-center-wrap">
      <h5 class="network-subtitle">{{ section.settings.subtitle }}</h5>
    </div>

    <div class="vs-stats-desktop-flex">
      
      <!-- LEFT COLUMN: TITLE COUNTER + TEASER + 3 STAT CARDS + CTA (DESKTOP) -->
      <div class="vs-stats-left-col">
        <h2 class="network-title">
