      align-items: stretch !important;
    }
    
    #shopify-section-{{ section.id }} .stat-item { 
      background: linear-gradient(145deg, #FFFFFF 0%, #FFFCF8 100%) !important;
      border: 1.5px solid rgba(236, 92, 10, 0.25) !important;
      border-top: 4px solid #EC5C0A !important;
      border-radius: 16px !important;
      padding: 16px 6px 14px 6px !important; 
      display: flex !important; 
      flex-direction: column !important;
      align-items: center !important;
