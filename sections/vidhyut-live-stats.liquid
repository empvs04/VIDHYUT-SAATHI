  /* --- FULLSCREEN LIGHTBOX MODAL STYLING --- */
  .vs-map-modal {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.3s ease !important;
  }

  .vs-map-modal.active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .vs-map-modal-overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: rgba(15, 23, 42, 0.88) !important;
    backdrop-filter: blur(10px) !important;
  }

  .vs-map-modal-content {
    position: relative !important;
    z-index: 2 !important;
    max-width: 90vw !important;
    max-height: 90vh !important;
    background: #FFFFFF !important;
    border-radius: 24px !important;
    padding: 24px !important;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5) !important;
    border: 2.5px solid #EC5C0A !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
  }

  .vs-map-modal-header {
    font-size: 1.1rem !important;
    font-weight: 800 !important;
    color: #0F172A !important;
    margin-bottom: 16px !important;
    letter-spacing: 0.5px !important;
  }

  .vs-map-modal-img {
    max-width: 82vw !important;
    max-height: 75vh !important;
    object-fit: contain !important;
    border-radius: 16px !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
  }

  .vs-map-modal-close {
    position: absolute !important;
    top: 14px !important;
    right: 18px !important;
    background: #FFF3EB !important;
    color: #EC5C0A !important;
    border: 1.5px solid rgba(236, 92, 10, 0.3) !important;
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    font-size: 1.4rem !important;
    line-height: 1 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s ease !important;
  }

  .vs-map-modal-close:hover {
    background: #EC5C0A !important;
    color: #FFFFFF !important;
  }
  
  #shopify-section-{{ section.id }} .marquee-track {
    display: flex;
    width: fit-content;
    animation: scrollNetwork-{{ section.id }} {{ section.settings.marquee_speed }}s linear infinite;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .marquee-content {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }
  
  #shopify-section-{{ section.id }} .marquee-item {
    display: flex;
    align-items: center;
    font-weight: 800;
    font-size: 0.88rem;
    margin-right: 60px; 
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #E2E8F0;
  }

  #shopify-section-{{ section.id }} .live-dot {
    display: inline-block;
    width: 9px; 
    height: 9px;
    background: #10B981; 
    border-radius: 50%;
    margin-right: 10px;
    box-shadow: 0 0 10px #10B981;
    animation: blink-{{ section.id }} 1.5s infinite;
  }

  @keyframes blink-{{ section.id }} { 
    0% { opacity: 1; transform: scale(1); } 
    50% { opacity: 0.4; transform: scale(0.8); } 
    100% { opacity: 1; transform: scale(1); } 
  }
  
  @keyframes scrollNetwork-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

