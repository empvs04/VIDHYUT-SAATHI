<script>
  var vsinstThreePhase = true;

  function vsinstSetPhase(isThree) {
    vsinstThreePhase = isThree;
    var btnSingle = document.getElementById('vsinst_btn_single');
    var btnThree = document.getElementById('vsinst_btn_three');
    if (isThree) {
      btnThree.classList.add('active');
      btnSingle.classList.remove('active');
    } else {
      btnSingle.classList.add('active');
      btnThree.classList.remove('active');
    }
    vsinstSync();
  }

  function vsinstSync(source) {
    var kwSlider = document.getElementById('vsinst_kw_slider');
    var kwNum = document.getElementById('vsinst_kw_num');
    var billNum = document.getElementById('vsinst_bill_num');

    var kw = parseInt(kwNum.value) || 50;
    var bill = parseInt(billNum.value) || 50000;

    if (source === 'slider') {
      kw = parseInt(kwSlider.value) || 10;
      kwNum.value = kw;
      bill = kw * 1000;
      billNum.value = bill;
    } else if (source === 'kw') {
      kw = Math.max(1, kw);
      kwSlider.value = Math.min(kw, 400);
      bill = kw * 1000;
      billNum.value = bill;
    } else if (source === 'bill') {
      bill = Math.max(1000, bill);
      kw = Math.max(1, Math.round(bill / 1000));
      kwNum.value = kw;
      kwSlider.value = Math.min(kw, 400);
    }

    document.getElementById('vsinst_kw_badge').innerText = kw + ' KW';
    document.getElementById('vsinst_bill_badge').innerText = '₹' + bill.toLocaleString('en-IN');

    // Institutional calculation: 1 card per 5 KW (+1 for 3-Phase substation balancing)
    var baseCards = Math.max(1, Math.ceil(kw / 5));
    if (vsinstThreePhase) {
      baseCards = baseCards + 1;
    }
    document.getElementById('vsinst_card_num').innerText = baseCards;

    // Monthly Savings (20% - 30%)
    var minSave = Math.round(bill * 0.20);
    var maxSave = Math.round(bill * 0.30);
    document.getElementById('vsinst_savings_range').innerText = '₹' + minSave.toLocaleString('en-IN') + ' – ₹' + maxSave.toLocaleString('en-IN') + ' / mo';
  }

  function filterInst(cat, btn) {
    var buttons = document.querySelectorAll('.inst-filter-btn');
    buttons.forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');

    var cards = document.querySelectorAll('.inst-card');
    cards.forEach(function(card) {
      if (cat === 'all' || card.getAttribute('data-category') === cat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function openInstLightbox(imgUrl, title, caption) {
    var container = document.getElementById('inst_lightbox_img_container');
    if (imgUrl && imgUrl.trim() !== '') {
      container.innerHTML = '<img src="' + imgUrl + '" alt="' + title + '" style="max-height:420px; width:100%; object-fit:contain;">';
    } else {
      container.innerHTML = '<div style="padding:60px 20px; text-align:center; color:#e0e7ff;"><i class="fa-solid fa-bolt" style="font-size:48px; color:#ffd700; margin-bottom:14px; display:block;"></i><strong>' + title + '</strong><p style="margin:8px 0 0 0; font-size:13px; color:#c7d2fe;">3-Phase Institutional Substation Connection Active</p></div>';
    }
    document.getElementById('inst_lightbox_title').innerText = title;
    document.getElementById('inst_lightbox_desc').innerText = caption;
    document.getElementById('inst_lightbox').classList.add('active');
  }

  function closeInstLightbox() {
    document.getElementById('inst_lightbox').classList.remove('active');
  }

  /* ══ MOBILE 5-SECOND CASE STUDIES AUTO-SLIDER ══ */
  (function() {
    var track = document.getElementById('vsinstCaseTrack');
    var wrap = document.getElementById('vsinstCaseSliderWrap');
    var dots = document.querySelectorAll('#vsinstCaseDots .vs-slider-dot');
    if (!track || !wrap) return;

    var currentIdx = 0;
    var totalSlides = dots.length || 3;
    var timer = null;
    var isMobile = function() { return window.innerWidth < 768; };

    window.vsinstGoSlide = function(idx) {
      if (!isMobile()) return;
      currentIdx = (idx + totalSlides) % totalSlides;
      track.style.transform = 'translateX(-' + (currentIdx * 100) + '%)';
      dots.forEach(function(dot, i) {
        dot.classList.toggle('active', i === currentIdx);
      });
    };

    function startAutoSlide() {
      stopAutoSlide();
      if (!isMobile()) return;
      timer = setInterval(function() {
        if (isMobile()) {
          window.vsinstGoSlide(currentIdx + 1);
        }
      }, 5000);
    }

    function stopAutoSlide() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            startAutoSlide();
          } else {
            stopAutoSlide();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(wrap);
    } else {
      startAutoSlide();
    }

    var startX = 0;
    var deltaX = 0;
    wrap.addEventListener('touchstart', function(e) {
      if (!isMobile()) return;
      stopAutoSlide();
      startX = e.touches[0].clientX;
      deltaX = 0;
    }, { passive: true });

    wrap.addEventListener('touchmove', function(e) {
      if (!isMobile()) return;
      deltaX = e.touches[0].clientX - startX;
    }, { passive: true });

    wrap.addEventListener('touchend', function() {
      if (!isMobile()) return;
      if (deltaX < -40) {
        window.vsinstGoSlide(currentIdx + 1);
      } else if (deltaX > 40) {
        window.vsinstGoSlide(currentIdx - 1);
      }
      startAutoSlide();
    }, { passive: true });

    window.addEventListener('resize', function() {
      if (!isMobile()) {
        track.style.transform = '';
        stopAutoSlide();
      } else if (!timer) {
        startAutoSlide();
      }
    });
  })();
</script>


